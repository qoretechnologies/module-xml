# minimum required Qore version
%requires qore >= 2.0

%requires Util

%requires(reexport) DataProvider
%requires FileLocationHandler
%requires(reexport) xml

%modern

module SaxDataProvider {
    version = "1.11";
    desc = "Qore data provider API for XML data streaming";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        # register the data provider factories
        DataProvider::registerFactory(new SaxDataProviderFactory());
        DataProvider::registerFactory(new SaxWriteDataProviderFactory());

        # register the data provider application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": SaxDataProvider::AppName,
            "display_name": "XML Document Files",
            "short_desc": "Read and write XML document data",
            "desc": "Provides read and write access to **XML document files** using SAX "
                "(Simple API for XML) streaming.\n\n"
                "Use this app when you need to:\n"
                "- Parse large XML files efficiently using streaming\n"
                "- Extract records from XML elements matching a specific tag name\n"
                "- Generate XML output from record data for data exchange\n\n"
                "Supports optional XSD schema validation and configurable character encoding.",
            "logo": XmlLogo,
            "logo_file_name": "xml-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::Documents, DataProvider::AppGroup::DataTransformation,),
        });

        # register read actions
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": SaxDataProvider::AppName,
            "path": "/",
            "action": "read",
            "subtype": "saxread",
            "display_name": "Read XML File",
            "short_desc": "Read XML records from a file location",
            "desc": "Read XML records from a file location using SAX streaming.\n\n"
                "Each XML element matching the `element_name` is iterated as a separate record.\n\n"
                "**Key Options**\n"
                "- `location`: the file location to read from (required)\n"
                "- `element_name`: the XML element name to iterate (required)\n"
                "- `encoding`: character encoding\n"
                "- `xsd`: optional XSD schema for validation\n",
            "action_code": DPAT_FIND,
            "cls": "SaxDataProvider::SaxDataProvider",
            "output_type": AbstractDataProviderTypeMap."auto",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                SaxDataProvider::ConstructorOptions{"location", "element_name",}, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                SaxDataProvider::ConstructorOptions - ("location", "stream", "element_name"), {
                    "loc": "constructor",
                }
            ),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": SaxDataProvider::AppName,
            "path": "/",
            "action": "read-data",
            "subtype": "saxread",
            "display_name": "Read XML Stream",
            "short_desc": "Read XML records from an input stream",
            "desc": "Read XML records from an input stream using SAX streaming.\n\n"
                "Each XML element matching the `element_name` is iterated as a separate record.\n\n"
                "**Key Options**\n"
                "- `stream`: the input stream to read from (required)\n"
                "- `element_name`: the XML element name to iterate (required)\n"
                "- `encoding`: character encoding\n"
                "- `xsd`: optional XSD schema for validation\n",
            "action_code": DPAT_FIND,
            "cls": "SaxDataProvider::SaxDataProvider",
            "output_type": AbstractDataProviderTypeMap."auto",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                SaxDataProvider::ConstructorOptions{"stream", "element_name",}, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                SaxDataProvider::ConstructorOptions - ("location", "stream", "element_name"), {
                    "loc": "constructor",
                }
            ),
        });

        # register write actions
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": SaxDataProvider::AppName,
            "path": "/",
            "action": "write",
            "subtype": "saxwrite",
            "display_name": "Write XML File",
            "short_desc": "Write XML records to a file location",
            "desc": "Write XML records to a file as elements under a root element.\n\n"
                "Records are accumulated and written when `commit()` is called or the provider "
                "is destroyed.\n\n"
                "**Key Options**\n"
                "- `path`: the output file location (required)\n"
                "- `root_element_name`: the root XML element name (default: `records`)\n"
                "- `element_name`: the record element name (default: `record`)\n"
                "- `encoding`: character encoding (default: `UTF-8`)\n",
            "action_code": DPAT_CREATE,
            "cls": "SaxDataProvider::SaxWriteDataProvider",
            "output_type": AbstractDataProviderTypeMap."auto",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                SaxWriteDataProvider::ConstructorOptions{"path",}, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                SaxWriteDataProvider::ConstructorOptions - ("path", "stream"), {
                    "loc": "constructor",
                }
            ),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": SaxDataProvider::AppName,
            "path": "/",
            "action": "write-data",
            "subtype": "saxwrite",
            "display_name": "Write XML Stream",
            "short_desc": "Write XML records to an output stream",
            "desc": "Write XML records to an output stream as elements under a root element.\n\n"
                "Records are accumulated and written when `commit()` is called or the provider "
                "is destroyed.\n\n"
                "**Key Options**\n"
                "- `stream`: the output stream to write to (required)\n"
                "- `root_element_name`: the root XML element name (default: `records`)\n"
                "- `element_name`: the record element name (default: `record`)\n"
                "- `encoding`: character encoding (default: `UTF-8`)\n",
            "action_code": DPAT_CREATE,
            "cls": "SaxDataProvider::SaxWriteDataProvider",
            "output_type": AbstractDataProviderTypeMap."auto",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                SaxWriteDataProvider::ConstructorOptions{"stream",}, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                SaxWriteDataProvider::ConstructorOptions - ("path", "stream"), {
                    "loc": "constructor",
                }
            ),
        });
    };
}

/** @mainpage SaxDataProvider Module

    @tableofcontents

    @section saxdataproviderintro Introduction to the SaxDataProvider Module

    The %SaxDataProvider module provides functionality for processing XML data efficiently.

    To use this module, use \c "%requires SaxDataProvider" in your code.

    All the public symbols in the module are defined in the SaxDataProvider namespace

    Currently the module provides the following classes:
    - @ref SaxDataProvider::SaxDataProvider "SaxDataProvider": a data provider for reading and searching CSV files
    - @ref SaxDataProvider::SaxDataProviderFactory "SaxDataProviderFactory": a data provider factory for reading and searching CSV files

    @section saxdataprovider_relnotes Release Notes

    @subsection saxdataprovider_v1_0 Version 1.0
    - initial version of module
*/

#! The main namespace for the SaxDataProvider module
public namespace SaxDataProvider {
    #! Application name
    public const AppName = "XmlDocument";

    #! XML logo for the application
    public const XmlLogo = File::readTextFile(get_script_dir() + "/xml-logo.svg");
}
