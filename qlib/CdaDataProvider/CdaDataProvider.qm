%requires qore >= 2.0
%modern

%requires(reexport) DataProvider
%requires(reexport) xml
%requires Util

module CdaDataProvider {
    version = "1.0";
    desc = "user module providing a data provider API for CDA XML documents";
    author = "Qore Technologies <info@qoretechnologies.com>";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
        DataProvider::registerFactory(new CdaDataProviderFactory());

        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": CdaDataProvider::AppName,
            "display_name": "CDA Documents",
            "short_desc": "Parse and validate HL7 CDA XML documents",
            "desc": "Provides a DataProvider API for **HL7 CDA / HL7 v3 XML** documents.\n\n"
                "Use this app when you need to:\n"
                "- Parse synthetic or production CDA XML into Qore data structures\n"
                "- Extract CDA header metadata and body section summaries\n"
                "- Validate CDA XML against an XSD supplied by the deployment\n\n"
                "The module does not bundle HL7 CDA schema packages. Pass `xsd_path` to use a "
                "local schema tree; file-based validation uses `XmlDoc::validateSchemaFile()` "
                "so relative `xsd:include` and `xsd:import` references resolve through libxml2.",
            "groups": (DataProvider::AppGroup::Documents, DataProvider::AppGroup::DataTransformation,),
            "logo": Priv::CdaLogo,
            "logo_file_name": "cda-logo.svg",
            "logo_mime_type": MimeTypeSvg,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CdaDataProvider::AppName,
            "path": "/parse-document",
            "action": "parse-cda-document",
            "subtype": CdaDataProvider::CdaDataProvider::FactoryName,
            "display_name": "Parse CDA Document",
            "short_desc": "Parse CDA XML and extract metadata and sections",
            "desc": "Parse a CDA XML document and return the parsed XML hash, CDA header "
                "metadata, and section summaries. Enable `validate` and pass `xsd_path` or "
                "`xsd` to validate before extraction.",
            "action_code": DPAT_API,
            "cls": "CdaDataProvider::CdaParseDocumentDataProvider",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                CdaParseDocumentRequestDataType::Fields{"xml",}, {
                    "required": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                CdaParseDocumentRequestDataType::Fields{"validate", "xsd_path",}, {
                    "preselected": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                CdaParseDocumentRequestDataType::Fields{"xsd",}, {}
            ),
            "output_type": CdaParseDocumentDataProvider::ResponseType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CdaDataProvider::AppName,
            "path": "/validate-document",
            "action": "validate-cda-document",
            "subtype": CdaDataProvider::CdaDataProvider::FactoryName,
            "display_name": "Validate CDA Document",
            "short_desc": "Validate CDA XML with XSD",
            "desc": "Validate a CDA XML document using `xsd_path`, `xsd`, or the provider's "
                "configured schema. File-based validation resolves relative schema imports.",
            "action_code": DPAT_API,
            "cls": "CdaDataProvider::CdaValidateDocumentDataProvider",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                CdaValidateDocumentRequestDataType::Fields{"xml",}, {
                    "required": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                CdaValidateDocumentRequestDataType::Fields{"xsd_path",}, {
                    "preselected": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                CdaValidateDocumentRequestDataType::Fields{"xsd",}, {}
            ),
            "output_type": CdaValidateDocumentDataProvider::ResponseType,
        });
    };
}

/** @mainpage CdaDataProvider Module

    @tableofcontents

    @section cdadataproviderintro Introduction to the CdaDataProvider Module

    The %CdaDataProvider module provides a @ref dataproviderintro "data provider"
    API for HL7 CDA / HL7 v3 XML documents. It parses CDA XML, optionally validates
    the document with XSD through the xml module, and returns document metadata and
    body section summaries for downstream processing.

    The module intentionally does not bundle HL7 CDA schema packages. CDA schema
    licensing and deployment profile choices vary, so validation uses a caller-
    supplied \c xsd_path or inline \c xsd. Prefer \c xsd_path for real CDA schema
    trees because @ref Qore::Xml::XmlDoc::validateSchemaFile() resolves relative
    \c xsd:include and \c xsd:import references through libxml2.

    @section cdadataproviderexamples Examples

    @subsection cdadataproviderexampleparse Parse and Extract CDA Metadata

    @code{.py}
%requires CdaDataProvider

CdaDataProvider::CdaDataProvider provider({
    "xsd_path": "/opt/cda/schema/CDA.xsd",
    "validate": True,
});

hash<auto> result = provider.getChildProvider("parse-document").doRequest({
    "xml": cda_xml,
});

printf("Document title: %s\n", result.metadata.title);
foreach hash<auto> section in (result.sections) {
    printf("%03d %s: %s\n", section.index, section.title, section.text);
}
    @endcode

    @subsection cdadataproviderexamplevalidate Validate Only

    @code{.py}
hash<auto> validation = provider.getChildProvider("validate-document").doRequest({
    "xml": cda_xml,
});
printf("CDA valid: %y\n", validation.valid);
    @endcode

    @section cdadataprovider_relnotes Release Notes

    @subsection cdadataprovider_v1_0 CdaDataProvider v1.0
    - initial CDA XML data provider module
    - XSD validation using inline schemas or file-based schemas with import/include resolution
    - CDA document metadata and section extraction
*/

#! contains all public definitions in the CdaDataProvider module
public namespace CdaDataProvider {
    #! Application name
    public const AppName = "CDA";
}

#! private namespace for module-internal constants
namespace Priv {
    #! CDA app logo
    const CdaLogo = File::readTextFile(get_script_dir() + "/cda-logo.svg");
}
