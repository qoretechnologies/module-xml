%requires qore >= 2.0
%modern

%requires(reexport) DataProvider
%requires(reexport) WSDL
%requires(reexport) xml

module CargoXmlDataProvider {
    version = "1.0";
    desc = "user module providing a data provider API for cargo XML message standards";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        DataProvider::registerFactory(new CargoXmlDataProviderFactory());
    };
}

/** @mainpage CargoXmlDataProvider Module

    @tableofcontents

    @section cargoxmldataproviderintro Introduction to the CargoXmlDataProvider Module

    The %CargoXmlDataProvider module provides a @ref dataproviderintro "data provider" API for
    cargo XML message standards (UN/CEFACT Cross-Industry messages, IATA Cargo-XML, and any
    other XSD-defined message family) so that B2B logistics integrations can validate, parse,
    and serialize messages with a uniform Qore API.

    The module ships with the UN/CEFACT D25A Cross-Industry message schemas under
    \c qlib/CargoXmlDataProvider/schemas/uncefact-D25A/ as a working baseline. Users with
    access to the IATA Cargo-XML toolkit (or any other XSD package) override the
    \c schema_dir constructor option to point at their own XSDs.

    @subsection cargoxmldp_messages Message discovery

    On construction the provider walks the schema directory (default
    \c data/standard/), parses each \c .xsd file lightly to extract its
    \c targetNamespace and any top-level \c xsd:element declarations, and
    registers each \c {namespace}/element as a child message data provider.

    @subsection cargoxmldp_validation Validation

    Validation uses libxml2 via @ref Qore::Xml::XmlDoc::validateSchemaFile()
    so multi-file XSD imports resolve relative to the message file. This is
    required for real-world packages like UN/CEFACT, where each message
    schema imports a tree of shared types and codelists.

    @section cargoxmldp_relnotes Release Notes

    @subsection cargoxmldp_v1_0 CargoXmlDataProvider v1.0
    - initial release of the module
*/

#! contains all public definitions in the CargoXmlDataProvider module
public namespace CargoXmlDataProvider {
    #! the application name for cargo XML
    public const AppName = "CargoXml";
}
