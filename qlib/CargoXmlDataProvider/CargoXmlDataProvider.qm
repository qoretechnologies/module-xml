%requires qore >= 2.0
%modern

%requires(reexport) DataProvider
%requires(reexport) WSDL
%requires(reexport) xml

module CargoXmlDataProvider {
    version = "1.0";
    desc = "user module providing a data provider API for cargo XML message standards";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        DataProvider::registerFactory(new CargoXmlDataProviderFactory());

        # register the app
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": CargoXmlDataProvider::AppName,
            "presentation_source_locale": "en",
            "display_name": "Cargo XML",
            "short_desc": "Validate, parse, and build cargo XML messages for B2B logistics",
            "desc": "Provides integration with **cargo XML message standards** for B2B "
                "logistics integrations.\n\n"
                "Use this app when you need to:\n"
                "- Validate inbound cargo XML messages from trading partners against their XSD\n"
                "- Parse cargo XML messages into Qore data structures for downstream processing\n"
                "- Build outbound cargo XML messages from Qore data structures and validate "
                "them before sending\n\n"
                "The app ships with the **UN/CEFACT D25A** Cross-Industry message family (Despatch "
                "Advice, Invoice, Order, Remittance Advice, Supply Instruction, etc.) bundled, so "
                "no external assets are required for those messages. To use **IATA Cargo-XML** "
                "(`FWB`, `FHL`, `FFM`, etc.) for air-cargo messaging, obtain the toolkit from IATA "
                "and override the `schema_dir` constructor option to point at the extracted XSDs.\n\n"
                "Validation uses libxml2 with file-based schema parsing so multi-file `xsd:import` "
                "trees (typical of UN/CEFACT and IATA packages) resolve correctly without manual "
                "preprocessing.",
            "groups": (DataProvider::AppGroup::Shipping, DataProvider::AppGroup::ApiIntegration,),
            "logo": Priv::CargoXmlLogo,
            "logo_file_name": "cargo-xml-logo.svg",
            "logo_mime_type": MimeTypeSvg,
        });

        # register the parse action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CargoXmlDataProvider::AppName,
            "path": "/parse-message",
            "action": "parse-cargo-xml-message",
            "display_name": "Parse a Cargo XML Message",
            "short_desc": "Parse and validate a cargo XML message",
            "desc": "Parse a cargo XML message and (optionally) validate it against its XSD "
                "schema. Pick the message type from the dropdown; the list is discovered from "
                "the schema directory configured on the data provider.\n\n"
                "When `validate` is `True` (default), validation runs against the message's XSD "
                "with all multi-file `xsd:import` references resolved by libxml2. Validation "
                "failure throws `XSD-ERROR` with a libxml2 diagnostic and no parse output is "
                "returned.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                CargoXmlParseMessageRequestDataType::Fields{"message_qname", "xml",}, {
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                CargoXmlParseMessageRequestDataType::Fields{"validate",}, {
                    "preselected": True,
                },
            ),
            "output_type": CargoXmlParseMessageDataProvider::ResponseType,
        });

        # register the build action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": CargoXmlDataProvider::AppName,
            "path": "/build-message",
            "action": "build-cargo-xml-message",
            "display_name": "Build a Cargo XML Message",
            "short_desc": "Serialize a hash to a cargo XML message and validate it",
            "desc": "Serialize a Qore hash to a cargo XML message and (optionally) validate "
                "the generated XML against its XSD before returning. Pick the message type "
                "from the dropdown.\n\n"
                "The `data` payload is the hash representation of the message: the top-level "
                "key is the message's qualified element name with the appropriate `xmlns` "
                "declarations on `^attributes^`. Nested elements appear as nested keys; "
                "attributes go under `^attributes^`; text content goes under `^value^`.\n\n"
                "When `validate` is `True` (default) and the generated XML fails validation, "
                "an `XSD-ERROR` is thrown and the XML is not returned.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                CargoXmlBuildMessageRequestDataType::Fields{"message_qname", "data",}, {
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                CargoXmlBuildMessageRequestDataType::Fields{"validate",}, {
                    "preselected": True,
                },
            ),
            "output_type": CargoXmlBuildMessageDataProvider::ResponseType,
        });
    };
}

/** @mainpage CargoXmlDataProvider Module

    @tableofcontents

    @section cargoxmldataproviderintro Introduction to the CargoXmlDataProvider Module

    The %CargoXmlDataProvider module provides a @ref dataproviderintro "data provider" API for
    cargo XML message standards (UN/CEFACT Cross-Industry messages, IATA Cargo-XML, and any
    other XSD-defined message family) so that B2B logistics integrations can validate, parse,
    and serialize messages with a uniform Qore API.

    The module ships with the UN/CEFACT D25A Cross-Industry message schemas under
    \c qlib/CargoXmlDataProvider/schemas/uncefact-D25A/ as a working baseline. Users with
    access to the IATA Cargo-XML toolkit (or any other XSD package) override the
    \c schema_dir constructor option to point at their own XSDs.

    @section cargoxmldp_iata UN/CEFACT vs. IATA Cargo-XML

    \b Important: the bundled schemas are the UN/CEFACT Cross-Industry family (\c CIInvoice,
    \c CIDespatchAdvice, \c CIOrder, \c CIRemittanceAdvice, etc.) — \b not the IATA Cargo-XML
    toolkit (\c FWB, \c FHL, \c FFM, \c XFFM, \c XFWB, \c XFHL, \c FSU, etc.) used by airlines,
    ground handlers, and freight forwarders for air cargo messaging.

    Although IATA Cargo-XML is technically derived from UN/CEFACT NDR (Naming and Design Rules)
    and reuses some core components, the actual message schemas are IATA-specific and licensed
    separately. To use this provider with IATA Cargo-XML, obtain the toolkit from IATA, extract
    it locally, and pass the directory via the \c schema_dir constructor option:

    @code{.py}
        CargoXmlDataProvider dp({
            "schema_dir": "/opt/iata-cargo-xml-toolkit-3.6/schemas",
            "schema_subdir": "",  # the IATA layout differs from UN/CEFACT's data/standard
        });
    @endcode

    The provider's discovery, validation, parse, and build operations work identically against
    either schema family because they are driven entirely by the XSDs.

    @subsection cargoxmldp_messages Message discovery

    On construction the provider walks the schema directory (default
    \c data/standard/), parses each \c .xsd file lightly to extract its
    \c targetNamespace and any top-level \c xsd:element declarations, and
    registers each \c {namespace}/element as a child message data provider.

    @subsection cargoxmldp_validation Validation

    Validation uses libxml2 via @ref Qore::Xml::XmlDoc::validateSchemaFile()
    so multi-file XSD imports resolve relative to the message file. This is
    required for real-world packages like UN/CEFACT, where each message
    schema imports a tree of shared types and codelists.

    @section cargoxmldp_relnotes Release Notes

    @subsection cargoxmldp_v1_0 CargoXmlDataProvider v1.0
    - initial release of the module
*/

#! contains all public definitions in the CargoXmlDataProvider module
public namespace CargoXmlDataProvider {
    #! the application name for cargo XML
    public const AppName = "CargoXml";
}

#! private namespace for module-internal constants
namespace Priv {
    const CargoXmlLogo = File::readTextFile(get_script_dir() + "/cargo-xml-logo.svg");
}
