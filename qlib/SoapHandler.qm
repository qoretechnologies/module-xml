# make sure we have the required qore version
%requires qore >= 1.0

# requires XML functionality
%requires xml

# requires the WSDL module
%requires WSDL

# need mime definitions
%requires Mime >= 1.1

# need definitions from the HttpServerUtil
%requires HttpServerUtil >= 0.3.11

# need Util functions
%requires Util

%modern

module SoapHandler {
    version = "0.3.4";
    desc = "SoapHandler module";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
}

/** @mainpage SoapHandler Module

    @tableofcontents

    @section soaphandlerintro Introduction to the SoapHandler Module

    This module implements server-side support for the <a href="http://en.wikipedia.org/wiki/SOAP">SOAP protocol</a> for serialization/deserialization of message data.

    This module provides the @ref SoapHandler::SoapHandler "SoapHandler" class which can be used to provide an RPC handler for the HttpServer class provided by the HttpServer module.

    @par Request actions
    SOAP callbacks receive \c cx.soap_action with the decoded request action, or NOTHING when absent.
    SOAP 1.1 uses the SOAPAction HTTP header; SOAP 1.2 uses the normalized XML root's media-type action.
    Actions retain their URI spelling. Absent or empty SOAP 1.1 actions allow unambiguous Body routing;
    an explicit nonempty action must match the selected binding when that binding declares an action.
    SOAP 1.2 ignores the legacy SOAPAction header.
    Several operations can share one action (SOAP 1.1 section 6.1.1; WS-I Basic Profile R2710 requires only
    distinct wire signatures). An action selects the operation when it is unique in the request's route
    scope; otherwise the Body element selects it. Registration rejects operations that share both an action
    and a request element, or an action and an empty body, in one route scope.

    @par Encoding faults
    A request decoding error whose argument is a WSDL::SoapFaultOptions hash selects the SOAP 1.2 fault code and
    subcodes, as SOAP 1.2 Encoding's \c enc:MissingID and \c enc:DuplicateID subcodes of \c env:Sender (HTTP 400)
    and \c env:DataEncodingUnknown (HTTP 500) require. SOAP 1.1 has no subcodes and returns a Client fault.

    @par Declared header-processing errors
    A body callback or registered header processor can select a WSDL headerfault without placing its value in the body's fault detail:
    @code{.py}
    throw SOAP_HEADER_FAULT, "Session expired", <SoapHeaderFaultInfo>{
        "message": "{urn:session}SessionExpired", "part": "problem", "value": 401};
    @endcode
    The selected headerfault must be declared under an input header of the selected binding. The
    optional request_header field selects output declarations for applications processing response
    headers. For body callbacks, a named application fault whose name is SOAP-HEADER-FAULT retains
    the ordinary fault path. Header processors always select the header-fault path. A header failure
    stops body conversion and dispatch; operation identity may still be resolved for its binding.
    Unexpected application/output failures use Server/Receiver with HTTP 500. Input conversion failures
    use Client/Sender (HTTP 500 for SOAP 1.1, HTTP 400 for SOAP 1.2). Interruption exceptions propagate.
    Clients retain the ordinary SOAP-SERVER-FAULT-RESPONSE exception contract; use the operation's
    deserializeHeaderFault() or deserializeXmlHeaderFault() with the retained response XML for typed
    or lexical header error data.

    @section soaphandler_relnotes SoapHandler Release History

    @subsection soaphandler_0_3_4 SoapHandler 0.3.4
    - a SOAP 1.2 request for an unknown procedure returns the \c rpc:ProcedureNotPresent subcode when the handler
      serves SOAP 1.2 RPC Representation operations
    - request decoding errors that carry WSDL::SoapFaultOptions return their SOAP 1.2 code and subcodes, such as
      \c env:Sender with \c enc:MissingID or \c env:DataEncodingUnknown; SOAP 1.1 keeps its Client code
    - operations sharing a SOAP action, such as the SOAPBuilders interop contract's 31 operations, register
      on one route and dispatch by Body element; previously registration failed without a route path, and
      with one every request carrying the action reached the first registered operation
    - added addSoapResponseResource() for explicitly safe SOAP 1.2 GET resources; exact routes support
      mount paths, queries, service removal and existing output/fault serialization
    - empty root HTTP route registration no longer confuses a missing match with an existing root route
    - SOAP transport preflight returns plain HTTP 400 for malformed MIME metadata and 415 for unsupported
      media or charset; unsupported resource methods return 405 with the actual allowed method list
    - malformed encoded request bytes retain their protocol error without a secondary logging exception
    - action routing decodes quoted SOAP 1.1 headers and SOAP 1.2 multipart root parameters, exposes
      \c cx.soap_action, and rejects malformed actions or mismatches before application dispatch
    - SOAP one-way operations return an empty HTTP 202 acknowledgment on success; processing failures
      still return SOAP faults, and the acknowledgment alone does not promise application delivery
    - header processing reparses its generated XML as UTF-8 independently of the request's wire charset,
      preserving native and retained values for UTF-16 and other supported encodings
    - registered header processors can return declared header faults before body conversion or dispatch,
      including when operation routing uses the Body element; mandatory-header preflight retains priority
    - unexpected application, header processor and output serialization failures generate Server/Receiver
      faults with HTTP 500; cancellation and program interruption propagate unchanged
    - fault diagnostics support missing and structured exception values, and render XML-invalid characters
      as visible Unicode escapes while preserving ordinary Unicode text
    - Explicit SoapProcessingNode capabilities and roles apply before application callbacks; unknown targeted
      mandatory headers produce MustUnderstand faults with SOAP 1.2 NotUnderstood QNames. Application decoding
      sees targeted headers, and callback context retains every original block and processor result
    - SOAP protocol validation runs before callbacks; version mismatches generate VersionMismatch faults with
      supported-envelope metadata, and SOAP 1.2 fault reasons carry xml:lang
    - HTTP routes resolve operation references against port endpoints, preserve encoded template literals, and
      apply explicit path overrides consistently to matching and decoding; multi-port registration validates before publication
    - native and retained XML calls preserve WSDL attachment parts independently of SOAP body/header values
    - HTTP multipart callbacks preserve nested MIME entity trees and recursive representation choices
    - SOAP multipart requests share MIME parameter parsing and decode binary XML roots before routing
      or passing retained XML to callbacks
    - HTTP MIME registrations accept explicit request/response format selectors for overlapping representations;
      unambiguous Content-Type matching selects automatically without changing shared binding metadata
    - bare scalar and empty document bodies dispatch without invented SOAP actions; ambiguous empty-body
      routes reject explicitly and normal service removal restores unique dispatch
    - HTTP URL-replacement routes match complete templates and decode raw paths once, including mounted handlers
    - HTTP route registration uses the write lock, and removeService() removes both static and replacement routes
    - http:urlEncoded POST operations decode typed form bodies instead of reading query parameters
    - HTTP-only WSDL bindings serialize successful responses without requiring a SOAP version
    - callbacks can throw WSDL::SOAP_HEADER_FAULT with WSDL::SoapHeaderFaultInfo to return a declared
      header-processing error in Header with a generic Fault in Body; named application faults retain precedence
    - added explicit \c preserve_types registration to retain native type selections for callbacks;
      portable type wrappers can be returned directly, including after Serializable reconstruction
    - added an explicit \c xml_values method-registration option to pass retained request XML parts and
      headers to callbacks; native callback arguments remain the default
    - synchronized the handler Version constant with the module version
    - preserve parsed XML names while inspecting operation-routing metadata, so schema decoding receives
      the original namespace scopes and no routing-only fields
    - added @@assert() statements for precondition checking in key methods
    - fixed content-type parsing regex to correctly extract the action parameter while preserving
      other parameters like charset

    @subsection soaphandler_0_3_3 SoapHandler 0.3.3
    - fixed malformed error string construction in SOAP message parsing exception handler
    - synchronized Version constant with module version
    - added message size limit support with \c max_message_size constructor option and
      @ref SoapHandler::SoapHandler::setMaxMessageSize() "setMaxMessageSize()" /
      @ref SoapHandler::SoapHandler::getMaxMessageSize() "getMaxMessageSize()" methods
    - improved error messages with better context information

    @subsection soaphandler_0_3_2 SoapHandler 0.3.2
    - fixed bugs where invalid XML messages were returned with some SOAP fault responses
      (<a href="https://github.com/qorelanguage/qore/issues/4441">issue 4441</a>)
    - fixed errors propagating XSD types in WSDLs to data providers
      (<a href="https://github.com/qorelanguage/qore/issues/4436">issue 4436</a>)

    @subsection soaphandler_0_3_1 SoapHandler 0.3.1
    - fixed a type error processing messages on listeners with no "hostname" socket info value
      (<a href="https://github.com/qorelanguage/qore/issues/4307">issue 4307</a>)

    @subsection soaphandler_0_3 SoapHandler 0.3
    - do not run SOAP operations in the SoapHandler lock
      (<a href="https://github.com/qorelanguage/qore/issues/4178">issue 4178</a>)

    @subsection soaphandler_0_2_7 SoapHandler 0.2.7
    - fixed a bug where HTTP request headers were not reported correctly in log callbacks
      (<a href="https://github.com/qorelanguage/qore/issues/2874">issue 2874</a>)
    - fixed a bug where duplicate \c soapAction values would cause an invalid error
      to be thrown even if there were unique paths for each operation
      (<a href="https://github.com/qorelanguage/qore/issues/2871">issue 2871</a>)

    @subsection soaphandler_0_2_6 SoapHandler 0.2.6
    - <b>Compatibility Warnings</b>
      - Because the SoapHandler module now supports HTTP bindings, it will only return
        WSDLs from GET requests if the URI path includes <tt>?wsdl</tt> at the end of the string
    - reimplemented operation to support multiple SOAP bindings, SOAP operations can be assigned to multiple bindings
    - HTTP binding support
    - implemented supoprt for handling SOAP faults based on the exception \c err string (must correspond to the fault name)
      (<a href="https://github.com/qorelanguage/qore/issues/2804">issue 2804</a>)

    @subsection soaphandler_0_2_5 SoapHandler 0.2.5
    - added support for matching requests with soap action values
    - added the err_func argument so SOAP response serialization errors can be logged at the source
    - added support for debugging (verbose exception info/logging)
    - fixes to service creation and GET WSDL handling
    - Content-type in exceptional cases follows Soap version
    - added support for logging content of SOAP messages

    @subsection soaphandler_0_2_4 SoapHandler 0.2.4
    - updated to a user module

    @subsection soaphandler_0_2_3 SoapHandler 0.2.3
    - return correct soap fault structure according to request

    @subsection soaphandler_0_2_2 SoapHandler 0.2.2
    - soap 1.2 improvements

    @subsection soaphandler_0_2_1 SoapHandler 0.2.1
    - matched to new WSDL and HttpServer implementation

    @subsection soaphandler_0_2_0 SoapHandler 0.2.0
    - better WSDL support

    @subsection soaphandler_0_1_0 SoapHandler 0.1.0
    - initial WSDL-based SOAP support (still incomplete)
*/

#! main SoapHandler namespace
public namespace SoapHandler {
    #! SoapHandler implementation; to be registered as a request handler in the HttpServer class
    public class SoapHandler inherits public AbstractHttpRequestHandler {
        #! version of the SoapHandler implementation
        const Version = "0.3.4";

        #! @cond nodoc
        private {
            # method mappings: method name -> method hash
            hash<auto> methods;

            # reverse mappings for methods: unique_id -> method -> True
            hash<string, hash<string, bool>> rmethods;

            # URI path -> method name -> method mappings
            hash<string, hash> uri_methods;

            # reverse URI path method mappings: unique_id -> URI path -> method name -> true
            hash<string, hash<string, hash<string, bool>>> ruri_methods;

            # service name -> WebService objects
            hash<string, WebService> wsh;

            # reverse mapping to remove wsh mappings; unique_id -> path -> True
            hash<string, hash<string, bool>> rwsh;

            # operation name -> WebService object
            hash<string, WebService> owsh;

            # reverse operation mappings; unique_id -> op name -> true
            hash<string, hash<string, bool>> rowsh;

            # lookup URI path -> WebService object
            hash<string, WebService> wsph;

            # reverse URI path lookups: unique_id -> URI path -> true
            hash<string, hash<string, bool>> rwsph;

            # URI path -> SOAP Action -> registration identity -> method mappings
            hash<string, hash<string, hash<string, hash<auto>>>> uri_sam;

            # reverse URI path -> SOAP Action mappings: unique_id -> URI path -> SOAPAction -> true
            hash<string, hash<string, hash<string, bool>>> ruri_sam;

            # soapaction map: action -> registration identity -> method
            hash<string, hash<string, hash<auto>>> sam;

            # reverse mapping: unique_id -> soapaction -> True
            hash<string, hash<string, bool>> rsam;

            int loglevel;

            # if True then verbose exception info will be logged
            bool debug;

            # a closure/call reference to get the log message and/or process arguments in incoming requests
            *code getLogMessage;

            # optional maximum message size in bytes; if set, messages larger than this will be rejected
            *int max_message_size;

            # Immutable header capabilities and roles; per-request results live in cx.soap_processing.
            SoapProcessingNode soap_node;

            # for atomicity when adding / removing methods
            RWLock rwl();

            # path TreeMap for each HTTP method
            hash<string, TreeMap> mapMethodPathToOperation;

            # HTTP verb -> replacement or fixed-query URI template -> method
            hash<string, hash<string, hash<auto>>> httpTemplateMethods;

            # soapaction -> method -> binding
        }
        #! @endcond

        #! creates the handler with the given method list
        /** @param auth an authentication object (use new AbstractAuthenticator() for no authentication)
            @param n_getLogMessage an optional closure or call reference to be called when an incoming request is
            received; if this is set then it will be called with the following arguments: a context hash (see
            HttpServer::AbstractHttpRequestHandler::handleRequest() for a description of the context hash), the method
            definition as passed in the methods argument to this constructor, and a reference to the arguments in this
            call
            @param dbg this parameter is set to @ref Qore::True "True", then additional information will be logged
            when errors occur
            @param n_soap_node optional ultimate-receiver header processing configuration; defaults to a node with
            no application capabilities. Unknown targeted mandatory headers produce MustUnderstand faults before
            any processor or application callback. Callbacks receive original headers and processor results in
            \c cx.soap_processing; WSDL decoding receives only targeted headers. Intermediaries use
            SoapProcessingNode directly instead of invoking application body operations.
            @throw SOAP-HANDLER-ERROR an intermediary node was supplied
            @param n_max_message_size optional maximum message size in bytes; if set, messages larger than this
            will be rejected with a 413 Payload Too Large response (recommended: 1048576 for 1MB, 10485760 for 10MB)
         */
        constructor(AbstractAuthenticator auth, *code n_getLogMessage, bool dbg = False, *int n_max_message_size,
                *SoapProcessingNode n_soap_node)
                : AbstractHttpRequestHandler(auth) {
            soap_node = n_soap_node ?? new SoapProcessingNode();
            if (!soap_node.isUltimateReceiver()) {
                throw "SOAP-HANDLER-ERROR", "SoapHandler requires an ultimate-receiver SoapProcessingNode";
            }
            getLogMessage = n_getLogMessage;
            debug = dbg;
            max_message_size = n_max_message_size;
        }

        #! adds a method to the handler dynamically
        /** @param ws the WebService object for the method
            @param op the WSOperation object for the web service operation the method corresponds to
            @param func a call reference, a closure, or a string function name to call with the deserialized
            arguments to the method; the return value will be serialized to SOAP according to the WSDL and sent back
            to the caller
            @param help optional help text for the method
            @param logopt log options which can be used by a custom logger (see the \a getLogMessage parameter in the
            constructor)
            @param cmark an optional "context marker" for the method
            @param path for SOAP, an optional service name; for HTTP, an explicit URI template relative to the
            handler mount, overriding port-address resolution for this registration
            @param err_func a call reference, a closure, or a string function name to call with error information if
            an exception is thrown with SOAP data
            @param altpath an alternate path for the service / WSDL
            @param binding SOAP binding name, leave empty to use the first assigned binding
            @param unique_id the unique ID for the backend service implementation for all operations on this WSDL;
            necessary for any removeService() call
            @param xml_values True to pass a WSDL::SoapXmlMessageInfo containing retained XML parts and headers
            to the callback; the default passes native values. The callback can return XML values using the
            explicit \c ^body^ and \c ^headers^ maps. Requires element-based literal SOAP.
            @param preserve_types True to pass selected native types as portable \c ^type^ / \c ^val^ wrappers;
            the default preserves native callback shapes. Cannot be combined with \c xml_values.
            @param request_mime_format optional format identifier or recursive request MIME selection tree
            @param response_mime_format optional format identifier or recursive response MIME selection tree
            @throw SOAP-SERVER-ADDMETHOD-PARAMETER-ERROR invalid callback or conflicting representation choices
            @throw SOAP-MESSAGE-ERROR an explicit MIME selector is unavailable
            @throw SOAP-PATH-ERROR an HTTP route is already registered
            @throw WSDL-ERROR a resolved replacement template no longer represents every input part
            @note HTTP routes resolve against each matching WSDL port address using Qore's RFC 3986 API.
            Matching and decoding share an immutable registration-local template. Unicode literals are URI encoded;
            saved and source operations are not modified. A supplied path or a binding without ports uses the
            handler mount root. Root-relative client operations replace the endpoint path, including any mount.
            @par Example
            Register xml:invoice as the response format when returning schema-bound invoice values from a
            contract that also offers an opaque invoice document.
         */
        addMethod(WebService ws, WSOperation op, auto func, *string help, *int logopt, auto cmark, *string path,
                auto err_func, *string altpath, *string binding, *string unique_id, bool xml_values = False,
                bool preserve_types = False, *WsdlMimeSelection request_mime_format, *WsdlMimeSelection response_mime_format) {
            @assert(ws, "WebService object is required");
            @assert(op, "WSOperation object is required");
            if (xml_values && preserve_types) {
                throw "SOAP-SERVER-ADDMETHOD-PARAMETER-ERROR",
                    "xml_values and preserve_types select different callback representations";
            }
            if (!func.callp() && func.typeCode() != NT_STRING) {
                throw "SOAP-SERVER-ADDMETHOD-PARAMETER-ERROR", sprintf("second argument is not a function name or "
                    "callable value type (got: %y)", func);
            }
            if (exists request_mime_format || exists response_mime_format) {
                OperationalBinding selected = op.getBinding(binding);
                if (!(selected instanceof HttpBinding) || xml_values) {
                    throw "SOAP-SERVER-ADDMETHOD-PARAMETER-ERROR",
                        "MIME selectors require an HTTP binding with native callback values";
                }
                foreach hash<auto> choice in (("direction":"input", "value":request_mime_format),
                        ("direction":"output", "value":response_mime_format)) {
                    if (exists choice.value) {
                        *BindingMessageDescription message = selected{choice.direction};
                        if (!message) {
                            throw "SOAP-SERVER-ADDMETHOD-PARAMETER-ERROR", "no message for the MIME selector";
                        }
                        message.validateMimeSelection(choice.value);
                    }
                }
            }
            addMethodInternal(ws, {
                "operation" : op,
                "name"      : op.name,
                "binding"   : binding,
                "function"  : func,
                "err_func"  : err_func,
                "help"      : help,
                "logopt"    : logopt,
                "cmark"     : cmark,
                "path"      : path,
                "altpath"   : altpath,
                "unique_id" : unique_id,
                "xml_values": xml_values,
                "preserve_types": preserve_types,
                "request_mime_format": request_mime_format,
                "response_mime_format": response_mime_format,
            });
            #printf("methods=%N\n", methods);
        }

        #! registers an explicitly safe HTTP GET resource producing a SOAP 1.2 response
        /** @param path absolute resource path relative to the handler mount, without query or fragment
            @param operation supplies output and fault declarations; its input is not decoded or invoked
            @param provider retrieves the resource from HTTP context and returns a native or retained output value
            @param binding selects a SOAP 1.2 binding with an output declaration
            @param unique_id optional service identifier for removeService()
            @throw SOAP-SERVER-ADDMETHOD-PARAMETER-ERROR the selected binding lacks SOAP 1.2 output
            @throw SOAP-PATH-ERROR invalid or duplicate path; overlapping HTTP templates reject during dispatch
            @note This implements the SOAP-response MEP. The provider is responsible for safe retrieval semantics.
            Requests must have no entity body. HTTP context includes the raw path/query and headers. Ordinary
            SOAP invocation routes remain POST; GET ?wsdl retains its metadata meaning where a WSDL is registered.
            Registration and removal are synchronized; the provider runs outside the registry lock.
            @par Example
            @code{.py}
handler.addSoapResponseResource("/invoices/71", service.getBindingOperation("Soap12", "GetInvoice"),
    auto sub(hash<auto> cx) { return {"body": invoice}; }, "Soap12", "invoices");
            @endcode
        */
        addSoapResponseResource(string path, WSOperation operation, code<auto(hash<auto>)> provider,
                *string binding, *string unique_id) {
            OperationalBinding selected = operation.getBinding(binding);
            if (!(selected instanceof SoapBinding) || !selected.isSoap12() || !selected.output) {
                throw "SOAP-SERVER-ADDMETHOD-PARAMETER-ERROR",
                    "SOAP response resources require a SOAP 1.2 binding with an output message";
            }
            if (!path.startsWith("/") || path.startsWith("//") || path.contains("?") || path.contains("#")) {
                throw "SOAP-PATH-ERROR", "a SOAP response resource requires an absolute path without query or fragment";
            }
            path = ltrim(parse_url(resolve_url("http://soap.invalid/", path,
                RESOLVE_URL_STRICT | RESOLVE_URL_ENCODE)).path, "/");
            hash<auto> method = {"name":operation.name, "operation":operation, "function":provider,
                "binding":binding, "path":path, "unique_id":unique_id, "exactMatch":True, "soap_response":True};
            rwl.writeLock();
            on_exit rwl.writeUnlock();
            *hash<auto> previous = exists mapMethodPathToOperation.GET
                ? mapMethodPathToOperation.GET.get(path) : NOTHING;
            if (httpTemplateMethods.GET.hasKey(path) || (previous && previous.path == path)) {
                throw "SOAP-PATH-ERROR", sprintf("GET resource %Y is already registered", path);
            }
            if (!mapMethodPathToOperation.GET) { mapMethodPathToOperation.GET = new TreeMap(); }
            mapMethodPathToOperation.GET.put(path, method);
        }

        #! turns on or off debugging; when debugging is enabled more verbose error messages are reported
        setDebug(bool dbg = True) {
            debug = dbg;
        }

        #! returns the current status of the debug flag
        bool getDebug() {
            return debug;
        }

        #! sets the maximum message size in bytes
        /** @param size the maximum message size in bytes; if @ref nothing, no limit is enforced

            Messages exceeding this size will be rejected with a 413 Payload Too Large response.
         */
        setMaxMessageSize(*int size) {
            max_message_size = size;
        }

        #! returns the current maximum message size setting
        /** @return the maximum message size in bytes, or @ref nothing if no limit is set
         */
        *int getMaxMessageSize() {
            return max_message_size;
        }

        #! call to remove the given service
        /** @param unique_id must correspond to the \a unique_id in any addMethod() calls
        */
        removeService(string unique_id) {
            rwl.writeLock();
            on_exit rwl.writeUnlock();

            # remove URI path -> method mappings
            foreach hash<auto> h in (ruri_methods{unique_id}.pairIterator()) {
                map remove uri_methods{h.key}{$1}, keys h.value;
                if (!uri_methods{h.key}) {
                    remove uri_methods{h.key};
                }
            }
            remove ruri_methods{unique_id};

            # remove method link mappings
            map delete methods.$1, keys rmethods{unique_id};
            delete rmethods{unique_id};

            # remove service operational mappings for service
            map remove owsh{$1}, keys rowsh{unique_id};
            remove rowsh{unique_id};

            # remove operation path mappings for service
            map remove wsh{$1}, keys rwsh{unique_id};
            remove rwsh{unique_id};

            # remove URI path mappings for service
            map remove wsph{$1}, keys rwsph{unique_id};
            remove rwsph{unique_id};

            # remove URI path -> SOAPAction mappings for service; other services can share an action
            foreach hash<auto> h in (ruri_sam{unique_id}.pairIterator()) {
                foreach string sa in (keys h.value) {
                    map remove uri_sam{h.key}{sa}{$1}, keys uri_sam{h.key}{sa},
                        uri_sam{h.key}{sa}{$1}.unique_id == unique_id;
                    if (!uri_sam{h.key}{sa}) {
                        remove uri_sam{h.key}{sa};
                    }
                }
                if (!uri_sam{h.key}) {
                    remove uri_sam{h.key};
                }
            }
            remove ruri_sam{unique_id};

            # remove SOAPAction mappings for service
            foreach string sa in (keys rsam{unique_id}) {
                map remove sam{sa}{$1}, keys sam{sa}, sam{sa}{$1}.unique_id == unique_id;
                if (!sam{sa}) {
                    remove sam{sa};
                }
            }
            remove rsam{unique_id};

            foreach TreeMap paths in (mapMethodPathToOperation.iterator()) {
                foreach hash<auto> entry in (paths.getAll().pairIterator()) {
                    if (entry.value.unique_id == unique_id) {
                        paths.take(entry.key);
                    }
                }
            }
            foreach string verb in (keys httpTemplateMethods) {
                foreach string path in (keys httpTemplateMethods{verb}) {
                    if (httpTemplateMethods{verb}{path}.unique_id == unique_id) {
                        remove httpTemplateMethods{verb}{path};
                    }
                }
            }
        }

        #! @cond nodoc
        # don't reimplement this method; fix/enhance it in the module
        final private addMethodInternal(WebService ws, hash<auto> method) {
            @assert(ws, "WebService object is required");
            @assert(method.operation, "method.operation is required");
            OperationalBinding binding = method.operation.getBinding(method.binding);

            if (binding instanceof SoapBinding) {
                SoapBinding sb = binding;

                # issue #2783: use the URI path for the service if possible
                if (!method.altpath && method.path) {
                    try {
                        # assume that "path" is the name of the service
                        hash<auto> svch = ws.getService(method.path);
                        if (svch.port) {
                            # if we have a simple path with no directory separators and no scheme, then the value will
                            # be in the "host" field after parse_url()
                            hash<auto> h = parse_url(svch.port.firstValue().address);
                            method.altpath = h.path ?? h.host;
                        }
                    } catch () {
                        # ignore all exceptions
                    }
                }

                # issue #2783: remove any leading slash from altpath
                if (method.altpath =~ /^\//) {
                    method.altpath = method.altpath.substr(1);
                }

                #printf("DEBUG: method: %y\n", method - "operation");
                # soap binding
                *string sa = sb.soapAction;
                if (sa) {
                    method.soap_action = sa;
                }

                rwl.writeLock();
                on_exit rwl.writeUnlock();

                # verify if the operation mapping can be added first; operations can share an action when the
                # Body identifies them (SOAP 1.1 section 6.1.1, WS-I Basic Profile R2710)
                string identity = method.operation.uniqueHash() + ":" + sb.getName();
                if (sa) {
                    # the Body element names that select this operation among others sharing its action
                    method.request_names = map {$1: True}, method.operation.getTopLevelRequestNames();
                    *hash<string, hash<auto>> sharing = method.altpath ? uri_sam{method.altpath}{sa} : sam{sa};
                    foreach hash<auto> other in ((sharing ?? {}).iterator()) {
                        if (other.operation == method.operation) {
                            continue;
                        }
                        *list<auto> common = select keys method.request_names, other.request_names{$1};
                        if (common || (!method.request_names && !other.request_names)) {
                            throw "SOAPACTION-ERROR", sprintf("cannot register soapAction %y for operation %y because "
                                "operation %y shares it and %s; neither the action nor the Body identifies the "
                                "operation", sa, method.operation.name, other.operation.name,
                                common ? sprintf("the request element %y", common[0]) : "an empty Body");
                        }
                    }
                }
                if (method.altpath && wsph{method.altpath} && wsph{method.altpath} != ws) {
                    # find conflicting ID
                    string conflicting_id;
                    foreach hash<auto> i in (rwsph.pairIterator()) {
                        if (i.value{method.altpath}) {
                            conflicting_id = i.key;
                            break;
                        }
                    }
                    throw "SOAP-PATH-ERROR", sprintf("URI path %y is already bound to another WebService with unique "
                        "ID %y; remove the existing WebService before binding another service to the same URI path",
                        method.altpath, conflicting_id);
                }

                # add SOAPAction mapping if possible
                if (sa) {
                    if (!sam{sa}{identity}) {
                        # add mapping from SOAPAction to method
                        sam{sa}{identity} = method;

                        # add path / soapaction mapping for service removal
                        if (method.unique_id) {
                            rsam{method.unique_id}{sa} = True;
                        }
                    }

                    # add URI path -> SOAPAction mappings if possible
                    if (method.altpath && !uri_sam{method.altpath}{sa}{identity}) {
                        uri_sam{method.altpath}{sa}{identity} = method;
                        #printf("DEBUG: added SA mapping %y -> %y -> method\n", method.altpath, sa);

                        # add reverse mappings for removal
                        if (method.unique_id) {
                            ruri_sam{method.unique_id}{method.altpath}{sa} = True;
                        }
                    }
                }

                # add URI path mapping if possible
                if (method.altpath && !wsph{method.altpath}) {
                    wsph{method.altpath} = ws;

                    if (method.unique_id) {
                        # add reverse lookup for service removal
                        rwsph{method.unique_id}{method.altpath} = True;
                    }
                }

                # add operation path mapping if possible
                if (method.path && !wsh{method.path}) {
                    # add link to WebService object
                    wsh{method.path} = ws;

                    # add reverse mapping for service removal
                    if (method.unique_id) {
                        rwsh{method.unique_id}{method.path} = True;
                    }
                }

                # map operation names to WebService objects
                foreach hash<OperationInfo> oph in (ws.listOperations()) {
                    if (!owsh{oph.operation.name}) {
                        owsh{oph.operation.name} = ws;

                        if (method.unique_id) {
                            rowsh{method.unique_id}{oph.operation.name} = True;
                        }
                    }
                }

                #printf("DEBUG: operation request names: %y\n", method.operation.getTopLevelRequestNames());

                # add request name mappings
                foreach string rn in (method.operation.getTopLevelRequestNames()) {
                    #printf("DEBUG: rn: %y methods: %y\n", rn, keys methods);
                    if (!methods{rn}) {
                        methods{rn} = method;

                        if (method.unique_id) {
                            rmethods{method.unique_id}{rn} = True;
                        }
                    }

                    #printf("DEBUG: method.altpath: %y rn: %y uri_methods: %y uri_methods{%y}: %y\n", method.altpath,
                    #    rn, keys uri_methods, method.altpath, keys uri_methods{method.altpath});
                    if (method.altpath && !uri_methods{method.altpath}{rn}) {
                        uri_methods{method.altpath}{rn} = method;

                        #printf("DEBUG: added URL mapping %y -> %s -> method\n", method.altpath, rn);

                        if (method.unique_id) {
                            ruri_methods{method.unique_id}{method.altpath}{rn} = True;
                        }
                    }
                }

                # add mapping for method name
                if (!methods{method.name}) {
                    methods{method.name} = method;

                    if (method.unique_id) {
                        rmethods{method.unique_id}{method.name} = True;
                    }
                }

                if (method.altpath && !uri_methods{method.altpath}{method.name}) {
                    uri_methods{method.altpath}{method.name} = method;
                    #printf("DEBUG: added URL mapping %y -> %s -> method\n", method.altpath, method.name);

                    if (method.unique_id) {
                        ruri_methods{method.unique_id}{method.altpath}{method.name} = True;
                    }
                }
            } else if (binding instanceof HttpBinding) {
                HttpBinding hb = binding;
                # Resolve and compile all routes before publishing any registration.
                hash<string, hash<auto>> routes = makeHttpRoutes(ws, method, hb);
                rwl.writeLock();
                on_exit rwl.writeUnlock();
                foreach hash<auto> route in (routes.iterator()) {
                    *hash<auto> previous = exists mapMethodPathToOperation{hb.httpMethod}
                        ? mapMethodPathToOperation{hb.httpMethod}.get(route.path) : NOTHING;
                    if (httpTemplateMethods{hb.httpMethod}.hasKey(route.path)
                            || (previous && previous.path == route.path)) {
                        throw "SOAP-PATH-ERROR", sprintf("HTTP URI template %Y is already registered", route.path);
                    }
                }
                if (!mapMethodPathToOperation{hb.httpMethod}) {
                    mapMethodPathToOperation{hb.httpMethod} = new TreeMap();
                }
                foreach hash<auto> route in (routes.iterator()) {
                    if (exists hb.input.urlReplacement || route.path.contains("?")) {
                        httpTemplateMethods{hb.httpMethod}{route.path} = route;
                    } else {
                        mapMethodPathToOperation{hb.httpMethod}.put(route.path, route);
                    }
                }
            } else if (!exists binding) {
                throw "SOAPACTION-ERROR", sprintf("cannot register operation %y because it has no binding",
                    method.operation.name);
            } else {
                throw "SOAPACTION-ERROR", sprintf("cannot register operation %y because it has unsupported "
                    "binding: %y", method.operation.name, binding.className());
            }
            #printf("DEBUG: SoapHandler::addMethodInternal() %N %N\n", method.name, method.path);
        }

        private hash<string, hash<auto>> makeHttpRoutes(WebService ws, hash<auto> method, HttpBinding binding) {
            hash<string, bool> bases();
            if (!exists method.path) {
                foreach hash<ServiceInfo> service in (ws.listServices()) {
                    foreach hash<auto> port in (service.port.iterator()) {
                        if (port.binding.getComponentKey() == binding.name) {
                            bases{port.address} = True;
                        }
                    }
                }
            }
            # Explicit paths and bindings without ports are relative to the handler's mount root.
            # This URI is only a parsing context; no connection is made to it.
            if (!bases) { bases{"http://localhost/"} = True; }
            hash<string, hash<auto>> result();
            foreach string base in (keys bases) {
                string reference = method.path ?? binding.location;
                hash<string, string> patterns();
                string marker;
                bool generated_query = !reference && binding.input.urlEncoded && binding.httpMethod != "POST"
                    && boolean(method.operation.input.pmap);
                if (exists binding.input.urlReplacement) {
                    # Protect Unicode part names from URI encoding while preserving literal parentheses.
                    marker = "qore-wsdl-replacement-";
                    while (reference.contains(marker) || base.contains(marker)) { marker += "x"; }
                    BindingMessageDescription template = binding.input.copy();
                    template.setUrlReplacement(reference, method.operation.input);
                    reference = "";
                    foreach string token in (keys template.urlReplacement) {
                        if (token.startsWith("string")) {
                            reference += template.urlReplacement{token};
                        } else {
                            string key = marker + patterns.size() + "-end";
                            patterns{key} = "(" + template.urlReplacement{token} + ")";
                            reference += key;
                        }
                    }
                } else if (generated_query) {
                    # Generated GET parameters replace a base query even with an empty operation reference.
                    reference = "?";
                }
                string path = parse_url(resolve_url(base, reference,
                    RESOLVE_URL_ENCODE | RESOLVE_URL_NO_FRAGMENT)).path;
                if (generated_query) { path = path.substr(0, path.size() - 1); }
                if (patterns) {
                    list<string> pieces = split(marker, path);
                    path = shift pieces;
                    foreach string piece in (pieces) {
                        int end = index(piece, "-end") + 4;
                        string key = marker + piece.substr(0, end);
                        @assert(patterns.hasKey(key));
                        path += patterns{key} + piece.substr(end);
                    }
                }
                HttpBinding route = binding.copy();
                route.location = path;
                if (exists binding.input.urlReplacement) {
                    route.input = binding.input.copy();
                    route.input.setUrlReplacement(path, method.operation.input);
                }
                string key = ltrim(path, "/");
                result{key} = method + {"path":key, "http_binding":route,
                    "parseUrlOnly":(binding.input.urlEncoded && binding.httpMethod != "POST")
                        || exists binding.input.urlReplacement,
                    "exactMatch":!exists binding.input.urlReplacement};
            }
            return result;
        }

        private *hash<auto> help(hash<auto> cx) {
            hash<auto> h;

            rwl.readLock();
            on_exit rwl.readUnlock();

            foreach string cmd in (keys methods) {
                h{cmd}.description = methods{cmd}.help;
                if (methods{cmd}.params)
                    h{cmd}.params = methods{cmd}.params;
            }
            return h;
        }

        # don't reimplement this method; fix/enhance it in the module
        final private log(hash<auto> cx, string str, ...) {
            string msg = "SOAP ";
            if (exists cx.user)
                msg += sprintf("user %s ", cx.user);
            msg += sprintf("from %s: ", cx."peer-info".address_desc);
            msg += vsprintf(str, argv);

            if (cx.logfunc) {
                call_function_args(cx.logfunc, msg);
            }
        }

        /** Method is to be overriden to implement custom logging HTTP messages handled by this object.
            @param cx the HTTP request context supplied by the server
            @param msg information about message to be logged. There are keys 'reason' with value 'request', 'response'
            or 'error', 'header' (HTTP header, in casew ) and 'body' containing XML data in readable form, i.e.
            uncompressed and in case of multipart message only the related part is passed. The method is executed
            before the message is sent or after it has been received.  This method must not throw exceptions.

            @par Example:
            @code{.py}
private nothing msglog(hash<auto> cx, hash<auto> msg) {
    log(sprintf("%s:\n%s\n", msg.reason, msg.body));
}
            @endcode

            @since %SoapHandler 0.2.5
        */
        private nothing msglog(hash<auto> cx, hash<auto> msg) {
            # implement functionality in descendant class
        }

        #! SOAP fault codes for SOAP 1.2
        /** @see https://www.w3.org/TR/soap12/ Section 5.4.6
        */
        public const SoapFaultSender = "Sender";          #! Client/sender fault
        public const SoapFaultReceiver = "Receiver";      #! Server/receiver fault
        public const SoapFaultVersionMismatch = "VersionMismatch";  #! SOAP version mismatch
        public const SoapFaultMustUnderstand = "MustUnderstand";    #! Header not understood
        public const SoapFaultDataEncodingUnknown = "DataEncodingUnknown";  #! Unknown encoding

        # don't reimplement this method; fix/enhance it in the module
        private hash<auto> makeSoapFaultResponse(hash<auto> cx, string errLog, bool soap12, auto err, auto desc,
                *bool fmt, *hash<auto> protocol, string default_code = SoapFaultSender) {
            if (err == "SOAP-VERSION-MISMATCH") {
                return makeSoapFaultResponseWithCode(cx, errLog, protocol.soap12 ?? soap12, err, desc,
                    SoapFaultVersionMismatch, fmt, protocol.supported_soap12);
            }
            if (err == "SOAP-MUST-UNDERSTAND") {
                return makeSoapFaultResponseWithCode(cx, errLog, soap12, err, desc, SoapFaultMustUnderstand,
                    fmt, NOTHING, protocol.headers);
            }
            # Decoding errors can select a SOAP 1.2 code and subcodes, such as enc:MissingID
            if (protocol instanceof hash<SoapFaultOptions>) {
                hash<SoapFaultOptions> options = cast<hash<SoapFaultOptions>>(protocol);
                string code = options.code && options.code.getNamespaceUri() == SOAP_12_ENV
                    && inlist(options.code.getLocalName(), (SoapFaultSender, SoapFaultReceiver,
                        SoapFaultDataEncodingUnknown)) ? options.code.getLocalName() : default_code;
                return makeSoapFaultResponseWithCode(cx, errLog, soap12, err, desc, code, fmt, NOTHING, NOTHING,
                    options.subcodes);
            }
            return makeSoapFaultResponseWithCode(cx, errLog, soap12, err, desc, default_code, fmt);
        }

        # Exceptions can carry non-string diagnostics and characters outside XML's character repertoire.
        # Preserve valid diagnostic text; render unrepresentable Unicode points as visible escapes.
        private static string faultDiagnostic(auto value, bool description = False) {
            string text = !exists value && description ? "no description provided"
                : value.typeCode() == NT_STRING ? value : sprintf("%Y", value);
            string result = "";
            foreach char character in (text.iterator()) {
                int point = character.ord();
                result += point == 9 || point == 10 || point == 13
                    || (point >= 0x20 && point <= 0xD7FF) || (point >= 0xE000 && point <= 0xFFFD)
                    || (point >= 0x10000 && point <= 0x10FFFF)
                    ? character.toString() : sprintf("\\u{%04X}", point);
            }
            return result;
        }

        #! Creates a SOAP fault response with proper HTTP status code based on fault type
        /** @param cx context passed from HttpServer
            @param errLog error log message
            @param soap12 if True, use SOAP 1.2 format; otherwise SOAP 1.1
            @param err error code/name
            @param desc error description
            @param faultCode SOAP fault code: "Sender", "Receiver", "VersionMismatch", "MustUnderstand", or
                "DataEncodingUnknown"
            @param fmt if True, add XML formatting
            @param supported_soap12 known supported version for a VersionMismatch Upgrade header
            @param not_understood original unknown mandatory headers for SOAP 1.2 NotUnderstood metadata
            @param subcodes SOAP 1.2 subcodes in outermost-to-innermost order; SOAP 1.1 has none

            @return hash with HTTP response info including:
            - \c code: HTTP status code (400 for Sender faults, 500 for Receiver/server faults)
            - \c errlog: error log message
            - \c body: XML body
            - \c hdr: HTTP headers

            @see https://www.w3.org/TR/2007/REC-soap12-part2-20070427/#soapinhttp for HTTP binding spec
        */
        private hash<auto> makeSoapFaultResponseWithCode(hash<auto> cx, string errLog, bool soap12, auto err,
                auto desc, string faultCode, *bool fmt, *bool supported_soap12,
                *list<hash<SoapNodeHeader>> not_understood, *list<XsdQNameValue> subcodes) {
            string reason = faultDiagnostic(err) + ": " + faultDiagnostic(desc, True);
            # do not use hash<auto> here; types must be stripped
            hash o;

            # Determine HTTP status code based on fault type per SOAP 1.2 HTTP binding spec
            # - Sender faults: 400 (Bad Request)
            # - Receiver/VersionMismatch/MustUnderstand/DataEncodingUnknown: 500 (Internal Server Error)
            int httpCode;
            if (soap12) {
                httpCode = (faultCode == SoapFaultSender) ? 400 : 500;
            } else {
                # SOAP 1.1 traditionally uses 500 for all faults
                httpCode = 500;
            }

            if (soap12) {
                o = ENVELOPE_12_NS;
                o."soapenv:Envelope"."soapenv:Body" = {
                    "soapenv:Fault": {
                        "soapenv:Code": {
                            "soapenv:Value": "soapenv:" + faultCode,
                        },
                        "soapenv:Reason": {
                            "soapenv:Text": {"^attributes^":{"xml:lang":"en"},"^value^":reason},
                        },
                    },
                };
                # optional Node, Role, Detail, see https://www.w3.org/TR/soap12/, 5.4 Fault
                if (subcodes) {
                    *hash<auto> subcode;
                    hash<auto> declarations();
                    for (int i = subcodes.size() - 1; i >= 0; --i) {
                        string uri = subcodes[i].getNamespaceUri();
                        string prefix = "sc" + i;
                        declarations{"xmlns:" + prefix} = uri;
                        subcode = {"soapenv:Value": prefix + ":" + subcodes[i].getLocalName()}
                            + (exists subcode ? {"soapenv:Subcode": subcode} : {});
                    }
                    o."soapenv:Envelope"."soapenv:Body"."soapenv:Fault"."soapenv:Code"."soapenv:Subcode" = subcode;
                    o."soapenv:Envelope"."^attributes^" += declarations;
                }
            } else {
                # SOAP 1.1 uses Client/Server instead of Sender/Receiver and has no DataEncodingUnknown code
                string soap11Code = faultCode == SoapFaultSender || faultCode == SoapFaultDataEncodingUnknown ? "Client"
                    : faultCode == SoapFaultReceiver ? "Server" : faultCode;
                o = ENVELOPE_11_NS;
                o."soapenv:Envelope"."soapenv:Body" = {
                    "soapenv:Fault": {
                        "faultcode": "soapenv:" + soap11Code,
                        "faultstring": reason,
                    },
                };
                # optional faultActor, see https://www.w3.org/TR/2000/NOTE-SOAP-20000508/ 4.4 SOAP fault
            }

            if (faultCode == SoapFaultVersionMismatch && exists supported_soap12) {
                auto fault_body = remove o."soapenv:Envelope"."soapenv:Body";
                o."soapenv:Envelope"."soapenv:Header" = {"upgrade:Upgrade": {
                    "^attributes^":{"xmlns:upgrade":SOAP_12_ENV},
                    "upgrade:SupportedEnvelope":{"^attributes^":{
                        "xmlns:supported":supported_soap12 ? SOAP_12_ENV : SOAP_11_ENV,
                        "qname":"supported:Envelope"}},
                }};
                o."soapenv:Envelope"."soapenv:Body" = fault_body;
            }

            if (soap12 && faultCode == SoapFaultMustUnderstand && not_understood) {
                list<hash<auto>> blocks();
                foreach hash<SoapNodeHeader> header in (not_understood) {
                    string prefix = header.xml.getNamespaceUri() == "http://www.w3.org/XML/1998/namespace"
                        ? "xml" : "unknown";
                    blocks += {"^attributes^":{"xmlns:" + prefix:header.xml.getNamespaceUri(),
                        "qname":prefix + ":" + header.xml.getLocalName()}};
                }
                auto fault_body = remove o."soapenv:Envelope"."soapenv:Body";
                o."soapenv:Envelope"."soapenv:Header" = {"soapenv:NotUnderstood":blocks};
                o."soapenv:Envelope"."soapenv:Body" = fault_body;
            }

            hash<auto> msg = {
                "code": httpCode,
                "errlog": errLog,
                "body": make_xml(o, fmt ? XGF_ADD_FORMATTING: 0),
                "hdr": {
                    "Content-Type": WSDLLib::getSoapMimeType12(soap12),
                },
            };
            msglog(cx, {'reason': 'error', 'code': httpCode, 'header': msg.hdr, 'body': msg.body});
            return msg;
        }

        # Body callbacks and header processors share the same selected-binding fault path.
        private hash<auto> makeDeclaredFaultResponse(hash<auto> cx, hash<auto> method, bool soap12,
                hash<ExceptionInfo> error, *hash<auto> header, bool from_header_processor = False) {
            cx.cmark = method.cmark;
            cx.function = method.function;
            cx.operation = method.operation;
            try {
                hash<auto> response = from_header_processor || !method.operation.hasFault(error.err)
                    ? method.operation.serializeHeaderFault(error.arg, error.desc ?? "no description provided", method.binding)
                    : method.operation.serializeFault(error.err, error.desc ?? "no description provided", error.arg,
                        header, NOTHING, NOTHING, NOTHING, NOTHING, method.binding);
                response.code = soap12 ? 400 : 500;
                msglog(cx, {"reason":"error","code":response.code,"header":response.hdr,"body":response.body});
                return response;
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err == "PROGRAM-INTERRUPTED" || ex.err == "THREAD-CANCELLED") { rethrow; }
                if (method.err_func) { call_function(method.err_func, cx, ex); }
                rethrow;
            }
        }

        # don't reimplement this method; fix/enhance it in the module
        final private *hash<auto> callOperation(hash<auto> cx, auto args, hash<auto> method, bool reqsoap12,
                *string xml_body) {
            @assert(method.name, "method.name is required");
            # NOTE: internal methods have no operation definition and can take no parameters
            hash<auto> h;
            if (method.internal) {
                h.body = call_object_method(self, method.function);
                return h;
            }

            # add context marker, if any
            cx.cmark = method.cmark;
            cx.function = method.function;
            cx.operation = method.operation;

            try {
                if (method.soap_response) {
                    @assert(reqsoap12);
                    args = NOTHING;
                } else if (method.parseUrlOnly) {
                    args = method.http_binding.deserializeRequestPath(method.operation, method.http_request_path);
                } else if (method.xml_values) {
                    if (!exists xml_body) {
                        throw "SOAP-DESERIALIZATION-ERROR", "retained XML decoding requires a SOAP XML message";
                    }
                    args = method.operation.deserializeXmlRequest(xml_body, method.binding, args."^mime-parts^");
                } else {
                    args = method.operation.deserializeRequest(args, method.binding, method.preserve_types ?? False,
                        method.request_mime_format);
                }
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err == "PROGRAM-INTERRUPTED" || ex.err == "THREAD-CANCELLED") { rethrow; }
                if (method.err_func) {
                    hash<auto> nex = ex;
                    nex.desc = sprintf("error deserializing incoming SOAP request: %s", ex.desc);
                    call_function(method.err_func, cx, nex);
                }
                string str = debug
                    ? get_exception_string(ex)
                    : sprintf("%s: %s: %s", get_ex_pos(ex), ex.err, ex.desc);
                return makeSoapFaultResponse(cx, str, reqsoap12, ex.err, ex.desc, NOTHING,
                    inlist(ex.err, ("SOAP-VERSION-MISMATCH", "SOAP-MUST-UNDERSTAND"))
                        || ex.arg instanceof hash<SoapFaultOptions> ? ex.arg : NOTHING);
            }

            if ((method.logopt & HttpServer::LP_LEVELMASK) <= loglevel && exists cx.logfunc) {
                string msg = sprintf("SOAP call from %s: %s", cx."peer-info".address_desc, method.name);

                if (method.logopt & HttpServer::LP_LOGPARAMS) {
                    msg += sprintf("(");
                    int i = 0;
                    foreach auto arg in (args) {
                        if (inlist(i++, method.maskargs))
                            msg += "<masked>, ";
                        else if (arg.typeCode() == NT_HASH && elements arg) {
                            msg += "(";
                            foreach string k in (keys arg) {
                                if (k == method.maskkey)
                                    msg += sprintf("%s=<masked>, ", k);
                                else
                                    msg += sprintf("%s=%n, ", k, arg{k});
                            }
                            splice msg, -2, 2;
                            msg += "), ";
                        } else
                            msg += sprintf("%n, ", arg);
                    }
                    # remove the last two characters from the string if any were added
                    if (i)
                        splice msg, -2, 2;
                    msg += ")";
                }

                SoapHandler::log(cx, msg);
            }
            auto rv;

            try {
                rv = dispatchSoapOperationCall(method, cx, args);
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err == "PROGRAM-INTERRUPTED" || ex.err == "THREAD-CANCELLED") { rethrow; }
                # issue #2804: see if the exception error code is a valid fault for the operation
                #printf("err: %y has fault: %y\n", ex.err, method.operation.hasFault(ex.err));
                if (ex.err.typeCode() == NT_STRING && (method.operation.hasFault(ex.err) || ex.err == SOAP_HEADER_FAULT)) {
                    return makeDeclaredFaultResponse(cx, method, reqsoap12, ex, remove rv."^header^");
                }
                rethrow;
            }

            # if there is an output message, then serialize the response
            if (method.operation.output) {
                try {
                    auto header = remove rv."^header^";
                    *bool response_soap12 = method.operation.getBinding(method.binding) instanceof SoapBinding
                        ? reqsoap12 : NOTHING;
                    h += method.operation.serializeResponse(rv, header, NOTHING, NOTHING, response_soap12, NOTHING,
                        method.binding, NOTHING, method.response_mime_format);
                    msglog(cx, ('reason': 'response', 'code': 200, 'header': h.hdr, 'body': h.body));
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err == "PROGRAM-INTERRUPTED" || ex.err == "THREAD-CANCELLED") { rethrow; }
                    if (method.err_func) { call_function(method.err_func, cx, ex); }
                    rethrow;
                }
            } else if (method.operation.getBinding(method.binding) instanceof SoapBinding) {
                # Empty one-way acknowledgments use 202 (required by SOAP 1.2 Part 2 Table 19,
                # and a preferred SOAP 1.1 one-way status in WS-I Basic Profile 1.2).
                h.code = 202;
                msglog(cx, {"reason":"response","code":h.code,"header":h.hdr,"body":h.body});
            }
            #log(cx, "body=%N", h.body);

            return h;
        }

        # True if a registered operation uses the SOAP 1.2 RPC Representation
        private bool servesSoap12Rpc() {
            rwl.readLock();
            on_exit rwl.readUnlock();
            foreach hash<auto> method in (methods.iterator()) {
                *OperationalBinding binding = method.operation.getBinding(method.binding);
                if (binding instanceof SoapBinding && cast<SoapBinding>(binding).usesSoap12RpcRepresentation()) {
                    return True;
                }
            }
            return False;
        }

        #! Dispatches the SOAP operation call and returns the result for validation and serialization
        private auto dispatchSoapOperationCall(hash<auto> method, hash<auto> cx, auto args) {
            if (args.typeCode() == NT_LIST) {
                unshift args, cx;
            } else if (exists args) {
                args = (cx, args);
            } else {
                args = cx;
            }

            if (method.internal) {
                return call_object_method_args(self, method.function, args);
            }
            return call_function_args(method.function, args);
        }

        private *hash<auto> matchMethod(TreeMap tm, string path, reference unmatched) {
            *hash<auto> method = tm.get(path);
            if (method) {
                if (method.exactMatch) {
                    # TreeMap matches path components and strips a separator from
                    # its unmatched suffix. Check the actual URI for exact routing.
                    if (path != method.path && !path.startsWith(method.path + "?")) {
                        return NOTHING;
                    }
                }
                unmatched = substr(path, method.path.length());
            }
            return method;
        }

        private string getHttpBindingPath(hash<auto> cx) {
            string path = ltrim(cx.raw_path ?? cx.url.path, "/");
            string root = encode_url(ltrim(cx.root_path ?? "", "/"));
            if (root && path.equalPartialPath(root)) {
                path = ltrim(path.substr(root.size()), "/");
            }
            return path;
        }

        # Identify the route's version before parsing an unrecognized envelope namespace.
        # This is independent of request actions and never selects an application operation.
        private *bool getSoapVersionForRoute(string path, *string alt_path) {
            rwl.readLock();
            on_exit rwl.readUnlock();
            *bool version;
            foreach hash<auto> candidate in ((uri_methods{path} ?? uri_methods{alt_path} ?? methods).iterator()) {
                OperationalBinding binding = candidate.operation.getBinding(candidate.binding);
                if (binding instanceof SoapBinding) {
                    bool current = binding.isSoap12();
                    if (exists version && version != current) { return NOTHING; }
                    version = current;
                }
            }
            return version;
        }

        # Accepted methods belong to the selected resource, including explicitly registered HTTP bindings.
        private list<string> getAllowedMethods(hash<auto> cx, string path, *string alt_path) {
            hash<string, bool> allowed();
            string full_path = ltrim(cx.raw_path ?? cx.url.path, "/");
            string relative_path = getHttpBindingPath(cx);
            rwl.readLock();
            on_exit rwl.readUnlock();
            foreach hash<auto> candidate in ((uri_methods{path} ?? uri_methods{alt_path} ?? methods).iterator()) {
                if (candidate.operation.getBinding(candidate.binding) instanceof SoapBinding) {
                    allowed.POST = True;
                    break;
                }
            }
            foreach string verb in (keys mapMethodPathToOperation) {
                *string args;
                TreeMap routes = mapMethodPathToOperation{verb};
                if (matchMethod(routes, full_path, \args) || matchMethod(routes, relative_path, \args)) {
                    allowed{verb} = True;
                }
            }
            foreach string verb in (keys httpTemplateMethods) {
                foreach hash<auto> candidate in (httpTemplateMethods{verb}.iterator()) {
                    if (candidate.http_binding.matchesRequestPath(full_path)
                            || candidate.http_binding.matchesRequestPath(relative_path)) {
                        allowed{verb} = True;
                        break;
                    }
                }
            }
            return sort(keys allowed);
        }

        private static hash<auto> makeMediaErrorResponse(hash<ExceptionInfo> error) {
            return {"code":error.err == "SOAP-MEDIA-TYPE-ERROR" ? 415 : 400,
                "hdr":{"Content-Type":"text/plain;charset=UTF-8"},
                "body":sprintf("%s: %s", error.err, error.desc)};
        }

        # method called by HttpServer
        # don't reimplement this method; fix/enhance it in the module
        final hash<auto> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
            cx.http_header = hdr;
            cx.http_body = body;

            # check message size limit if configured
            if (max_message_size && body) {
                int body_size = body.size();
                if (body_size > max_message_size) {
                    SoapHandler::log(cx, "SOAP request rejected: message size %d exceeds maximum %d bytes", body_size,
                        max_message_size);
                    return {
                        "code": 413,
                        "body": sprintf("Payload Too Large: message size %d exceeds maximum allowed size of %d bytes",
                            body_size, max_message_size),
                    };
                }
            }

            *hash<auto> method;

            bool reqsoap12 = False; # set to True if soap 1.2 envelope is used in request

            *string path = cx.url.path;

            # remove leading / in path, if any
            path =~ s/^\///;

            *string alt_path;
            # issue #2783 respect URI paths when matching
            if (cx.root_path && path.equalPartialPath(cx.root_path)) {
                alt_path = path.substr(cx.root_path.size());
                # remove leading / in path, if any
                alt_path =~ s/^\///;
            }
            #printf("DEBUG: path: %y alt: %y root: %y hdr.method: %y\n", path, alt_path, cx.root_path, hdr.method);

            if (!method) {
                # SOAP action is not explicitly specified, e.g. HTTP binding, try get it from path
                # issue #4187: do not run SOAP operation calls in the lock
                *string args;
                {
                    rwl.readLock();
                    on_exit rwl.readUnlock();

                    if (exists mapMethodPathToOperation{hdr.method}) {
                        TreeMap tm = mapMethodPathToOperation{hdr.method};
                        string raw_path = ltrim(cx.raw_path ?? cx.url.path, "/");
                        method = matchMethod(tm, raw_path, \args);
                        if (!method) {
                            raw_path = getHttpBindingPath(cx);
                            method = matchMethod(tm, raw_path, \args);
                        }
                        if (method) {
                            method.http_request_path = raw_path;
                        }
                    }
                    if (!method || method.soap_response) {
                        string full_path = ltrim(cx.raw_path ?? cx.url.path, "/");
                        string relative_path = getHttpBindingPath(cx);
                        foreach hash<auto> candidate in (httpTemplateMethods{hdr.method}.iterator()) {
                            *string matched = candidate.http_binding.matchesRequestPath(full_path) ? full_path
                                : candidate.http_binding.matchesRequestPath(relative_path) ? relative_path : NOTHING;
                            if (exists matched) {
                                if (method) {
                                    throw "SOAP-PATH-ERROR", sprintf("ambiguous HTTP URI template path %Y", full_path);
                                }
                                method = candidate;
                                method.http_request_path = matched;
                            }
                        }
                    }
                }
                if (method.soap_response && !(path =~ /\?wsdl/i)) {
                    if (body) {
                        return {"code":400, "hdr":{"Content-Type":"text/plain;charset=UTF-8"},
                            "body":"SOAP response retrieval requires an empty HTTP request body"};
                    }
                    cx.soap_response = True;
                    try {
                        msglog(cx, {"reason":"request", "method":"GET", "path":path, "header":hdr});
                        return {"code":200} + callOperation(cx, NOTHING, method, True);
                    } catch (hash<ExceptionInfo> ex) {
                        if (ex.err == "PROGRAM-INTERRUPTED" || ex.err == "THREAD-CANCELLED") { rethrow; }
                        string str = debug ? get_exception_string(ex)
                            : sprintf("exception in %s: %s: %s", get_ex_pos(ex), ex.err, ex.desc);
                        return makeSoapFaultResponse(cx, str, True, ex.err, ex.desc, NOTHING, NOTHING,
                            SoapFaultReceiver);
                    }
                }
                if (method && method.parseUrlOnly) {
                    try {
                        # we need to log the request
                        msglog(cx, {'reason': 'request', 'method': hdr.method, 'path': path});
                        #printf("DEBUG: context: %N\nargs: %N\n", cx, args);
                        return {
                            "code": 200,
                         } + callOperation(cx, args, method, reqsoap12);
                    } catch (hash<ExceptionInfo> ex) {
                        if (ex.err == "PROGRAM-INTERRUPTED" || ex.err == "THREAD-CANCELLED") { rethrow; }
                        string str = debug
                            ? get_exception_string(ex)
                            : sprintf("exception in %s: %s: %s", get_ex_pos(ex), ex.err, ex.desc);
                        return makeSoapFaultResponse(cx, str, reqsoap12, ex.err, ex.desc, NOTHING,
                            inlist(ex.err, ("SOAP-VERSION-MISMATCH", "SOAP-MUST-UNDERSTAND")) ? ex.arg : NOTHING,
                            SoapFaultReceiver);
                    }
                }
            }

            # service the WSDL with properly-formatted GET requests
            if (hdr.method == "GET" && path =~ /\?wsdl/i) {
                # path has not been resolved to an operation, so try an heuristic to match a service
                # remove query args if present
                path =~ s/\?.*$//;

                #printf("DEBUG: PATH=%N (%n %n)\n", path, exists wsh{path}, keys wsh);

                rwl.readLock();
                on_exit rwl.readUnlock();

                *WebService ws = tryMatch(path);
                if (!ws && alt_path) {
                    ws = tryMatch(alt_path);
                }
                if (!ws) {
                    # try a match with the last component of the path, if any
                    path =~ s/.*\///g;
                    if (path)
                        ws = tryMatch(path);
                }

                if (!ws) {
                    return {
                        "code": 501,
                        "body": sprintf("invalid HTTP GET: no WebService object for path %y; known paths / services: "
                            "%y; known operations: %y; known alt paths: %y", path, wsh.keys(), owsh.keys(),
                            wsph.keys()),
                    };
                }

                # get URL for service
                # note that "socket-info".hostname is not returned for UNIX sockets
                string host;
                hash<auto> sih = cx."socket-info";
                if (sih.family == AF_UNIX) {
                    host = sprintf("socket=%s", encode_url(sih.address, True));
                } else {
                    # issue #4307: hostname is not always set, address is
                    host = sih.hostname ?? sih.address;
                    if (host == "::" || host == "0.0.0.0") {
                        host = gethostname();
                    }
                }

                string base_url = sprintf("http%s://%s", cx.ssl ? "s" : "", host);
                if (sih.port) {
                    int port = sih.port;
                    if (cx.ssl) {
                        if (port != 443)
                            base_url += ":" + port;
                    } else if (port != 80)
                        base_url += ":" + port;
                }
                if (cx.root_path) {
                    base_url += "/" + cx.root_path;
                }

                return {
                    "code": 200,
                    "body": ws.getWSDL(base_url),
                    "hdr": {"Content-Type": "text/xml"},
                };
            }

            if (!method) {
                list<string> allowed = getAllowedMethods(cx, path, alt_path);
                if (allowed && !inlist(hdr.method, allowed)) {
                    return {"code":405, "hdr":{"Allow":allowed.join(", "), "Content-Type":"text/plain;charset=UTF-8"},
                        "body":sprintf("method %s is not allowed for this resource", hdr.method)};
                }
            }

            if (method || hdr.method == "POST") {
                # still chance to get method from xml element in case of SoapBinding (i.e.POST), we need parse message
                # now
                auto args;
                *string xml_body;
                *hash<ExceptionInfo> header_fault;
                bool processor_failure = False;
                try {
                    *string ct = hdr."_qore_orig_content_type";
                    # Action dispatch uses normalized root metadata and the validated envelope version.
                    # Body dispatch uses its actual element name, never the last URI segment of an action.
                    *string element;
                    *string soap_action;
                    # the operations sharing the request's action; the Body selects among them
                    *hash<string, hash<auto>> shared;
                    *OperationalBinding selected_binding = method ? method.operation.getBinding(method.binding) : NOTHING;
                    bool soap_envelope = !selected_binding || selected_binding instanceof SoapBinding;
                    bool mime_content = False;
                    if (selected_binding instanceof HttpBinding && selected_binding.input) {
                        *string format = selected_binding.input.resolveMimeFormat(ct, method.request_mime_format);
                        if (method.request_mime_format.typeCode() == NT_HASH) { method.request_mime_format.format = format; }
                        else { method.request_mime_format = format; }
                        mime_content = selected_binding.input.isMimeContent(format);
                    }
                    hash<auto> msg;
                    try {
                        msg = WSDLLib::parseMultiPartSOAPMessage(hdr + ("body" : body), mime_content, soap_envelope);
                    } catch (hash<ExceptionInfo> ex) {
                        if (soap_envelope && inlist(ex.err, ("SOAP-MESSAGE-ERROR", "SOAP-MEDIA-TYPE-ERROR"))) {
                            return makeMediaErrorResponse(ex);
                        }
                        rethrow;
                    }
                    msglog(cx, ('reason': 'request', 'header': hdr, 'method': hdr.method, 'body': msg.body));
                    *bool expected_version = selected_binding instanceof SoapBinding ? selected_binding.isSoap12()
                        : soap_envelope ? getSoapVersionForRoute(path, alt_path) : NOTHING;
                    reqsoap12 = expected_version ?? WSDLLib::isSOAPMessage12(msg);
                    args = WSDLLib::parseSOAPMessage(msg, mime_content, soap_envelope);
                    if (soap_envelope) {
                        reqsoap12 = WSDLLib::validateSOAPEnvelope(args, expected_version, False, True);
                        try {
                            WSDLLib::validateSOAPMediaType(msg, reqsoap12);
                        } catch (hash<ExceptionInfo> ex) {
                            if (ex.err == "SOAP-MEDIA-TYPE-ERROR") { return makeMediaErrorResponse(ex); }
                            rethrow;
                        }
                        soap_action = WSDLLib::getSOAPAction(msg, reqsoap12, hdr.soapaction);
                        if (!method && soap_action) {
                            {
                                rwl.readLock();
                                on_exit rwl.readUnlock();
                                *hash<string, hash<auto>> candidates = uri_sam{path}{soap_action}
                                    ?? uri_sam{alt_path}{soap_action} ?? sam{soap_action};
                                # an action shared by several operations leaves the selection to the Body
                                if (candidates.size() == 1) {
                                    method = candidates.firstValue();
                                } else {
                                    shared = candidates;
                                }
                            }
                            if (method) {
                                selected_binding = method.operation.getBinding(method.binding);
                                expected_version = selected_binding.isSoap12();
                                WSDLLib::validateSOAPEnvelope(args, expected_version, False, True);
                            }
                        }
                        *string base_uri = hdr.host ? resolve_url((cx.ssl ? "https://" : "http://") + hdr.host + "/",
                            cx.raw_path ?? hdr.path ?? cx.url.path, RESOLVE_URL_STRICT | RESOLVE_URL_ENCODE) : NOTHING;
                        # Native HTTP contexts can be legacy untyped hashes, which strip nested hashdecls on assignment.
                        # Construct a typed context before adding the public typed processing result.
                        hash<auto> typed_cx();
                        typed_cx += cx;
                        cx = typed_cx;
                        cx.soap_action = soap_action;
                        try {
                            cx.soap_processing = soap_node.processMessage(WSDLLib::getXmlMessageText(msg), cx,
                                base_uri, expected_version);
                            xml_body = cx.soap_processing.application_message.getXml();
                            # Node output is UTF-8 XML, independent of the original HTTP/MIME root charset.
                            args = WSDLLib::parseSOAPMessage(msg + {"body":xml_body,
                                "content-type":"application/xml;charset=UTF-8"}, False, True);
                        } catch (hash<ExceptionInfo> ex) {
                            if (ex.err == "PROGRAM-INTERRUPTED" || ex.err == "THREAD-CANCELLED") { rethrow; }
                            if (ex.err == SOAP_HEADER_FAULT) {
                                # Keep the failure while resolving only the operation identity. Body schema
                                # conversion and application dispatch must not run after a header failure.
                                header_fault = ex;
                            } else {
                                processor_failure = !inlist(ex.err, ("SOAP-DESERIALIZATION-ERROR",
                                    "SOAP-VERSION-MISMATCH", "SOAP-MUST-UNDERSTAND", "PARSE-XML-EXCEPTION",
                                    "XML-CONTEXT-ERROR", "WSDL-NAMESPACE-ERROR", "XML-READER-ERROR"));
                                rethrow;
                            }
                        }
                    }
                    if (!mime_content && (WSDLLib::isSOAPMessage(msg) || WSDLLib::isMtomMessage(msg))) {
                        # Inspect routing and envelope metadata on a copy; preserve the original XML names
                        # and content for the selected binding's schema validation.
                        hash<auto> routing_args = args;
                        WSDL::XsdBase::removeNS(\routing_args);
                        WSDL::XsdBase::removeNS(\routing_args.Envelope);

                        if (!method) {
                            # get SOAP operation name from top XML element
                            if (!exists element && exists routing_args.Envelope.Body
                                && routing_args.Envelope.Body.typeCode() == NT_HASH ) {
                                foreach string k in (keys routing_args.Envelope.Body) {
                                    auto v = routing_args.Envelope.Body{k};
                                    # A bare scalar or nil element is also an operation root.
                                    if (k == "multiRef" || k.startsWith("^")
                                        || (k == "ns" && v.typeCode() == NT_STRING)) {
                                        continue;
                                    }
                                    # Handle both prefixed (tns:getInfo) and unprefixed (getInfo)
                                    # element names for default namespace support
                                    *string matched = (k =~ x/.*:(.*)/)[0];
                                    element = matched ?? k;
                                    break;
                                }
                            }
                            if (element) {
                                rwl.readLock();
                                on_exit rwl.readUnlock();

                                #printf("DEBUG: path: %y alt_path: %y element: %y um: %y urm: %y m: %y\n", path,
                                #   alt_path, element, exists uri_methods{path}{element},
                                #   exists uri_methods{alt_path}{element}, exists methods{element});
                                foreach hash<auto> candidate in ((shared ?? {}).iterator()) {
                                    if (candidate.request_names{element}) {
                                        method = candidate;
                                        break;
                                    }
                                }
                                # issue #2783: respect UTI paths when matching; an element outside the shared
                                # action's operations selects its own operation for the action check below
                                if (!method) {
                                    method = uri_methods{path}{element}
                                        ?? uri_methods{alt_path}{element}
                                        ?? methods{element};
                                }
                            } else if (routing_args.Envelope.hasKey("Body")) {
                                # A zero-part document message has no element from which to dispatch.
                                # Select only a unique registered empty-body operation in this route scope.
                                rwl.readLock();
                                on_exit rwl.readUnlock();
                                hash<string, bool> seen();
                                foreach hash<auto> candidate in ((shared ?? uri_methods{path}
                                        ?? uri_methods{alt_path} ?? methods).iterator()) {
                                    OperationalBinding binding = candidate.operation.getBinding(candidate.binding);
                                    if (!(binding instanceof SoapBinding) || !binding.docstyle
                                            || !binding.input || !candidate.operation.input
                                            || (binding.input.getBodyPartNames(candidate.operation.input)
                                                ?? keys candidate.operation.input.pmap)) {
                                        continue;
                                    }
                                    string identity = candidate.operation.uniqueHash() + ":" + binding.getName();
                                    if (seen{identity}) {
                                        continue;
                                    }
                                    seen{identity} = True;
                                    if (method) {
                                        throw "SOAP-CALL-ERROR", "ambiguous empty SOAP body; select an operation "
                                            "with a bound action or a distinct handler route";
                                    }
                                    method = candidate;
                                }
                            }
                        }

                        if (!method) {
                            # SOAP 1.2 Part 2 section 4.4: an RPC receiver may name the missing procedure
                            throw "SOAP-CALL-ERROR", sprintf("no operation call found in message (SOAP body "
                                "args: %y)", keys routing_args.Envelope.Body), reqsoap12 && servesSoap12Rpc()
                                ? <SoapFaultOptions>{"subcodes": (new XsdQNameValue(SOAP_12_RPC,
                                    "ProcedureNotPresent"),)} : NOTHING;
                        }
                        if (soap_action && method.soap_action && soap_action != method.soap_action) {
                            throw "SOAP-CALL-ERROR", sprintf("action %Y does not match operation %Y action %Y",
                                soap_action, method.operation.name, method.soap_action);
                        }
                        if (method.xml_values && !exists xml_body) {
                            xml_body = WSDLLib::getXmlMessageText(msg);
                        }
                        #printf("DEBUG element: %y methods: %y args: %y\n", element, methods.keys(), args);
                    }
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err == "PROGRAM-INTERRUPTED" || ex.err == "THREAD-CANCELLED") { rethrow; }
                    SoapHandler::log(cx, "exception parsing SOAP message (%d bytes): %s: %s",
                        body.size(), ex.err, ex.desc);
                    string str = debug
                        ? get_exception_string(ex)
                        : sprintf("%s: %s: %s", get_ex_pos(ex), ex.err, ex.desc);
                    return makeSoapFaultResponse(cx, str, reqsoap12, ex.err, ex.desc, NOTHING,
                        inlist(ex.err, ("SOAP-VERSION-MISMATCH", "SOAP-MUST-UNDERSTAND"))
                            || ex.arg instanceof hash<SoapFaultOptions> ? ex.arg : NOTHING,
                        processor_failure ? SoapFaultReceiver : SoapFaultSender);
                }

                if (method) {
                    try {
                        if (header_fault) {
                            # Routing may discover the binding after header processing; enforce its version
                            # without converting the failed request's application payload.
                            WSDLLib::validateSOAPEnvelope(args, method.operation.getBinding(method.binding).isSoap12());
                            return makeDeclaredFaultResponse(cx, method, reqsoap12, header_fault, NOTHING, True);
                        }
                        return {"code": 200} + callOperation(cx, args, method, reqsoap12, xml_body);
                    } catch (hash<ExceptionInfo> ex) {
                        if (ex.err == "PROGRAM-INTERRUPTED" || ex.err == "THREAD-CANCELLED") { rethrow; }
                        string str = debug
                            ? get_exception_string(ex)
                            : sprintf("exception in %s: %s: %s", get_ex_pos(ex), ex.err, ex.desc);
                        return makeSoapFaultResponse(cx, str, reqsoap12, ex.err, ex.desc, NOTHING,
                            inlist(ex.err, ("SOAP-VERSION-MISMATCH", "SOAP-MUST-UNDERSTAND")) ? ex.arg : NOTHING,
                            SoapFaultReceiver);
                    }
                }
            }

            return {
                "code" : 501,
                "body" : sprintf("don't know how to handle request with method %y", hdr.method),
            };
        }

        private *WebService tryMatch(string path) {
            # issue #2783: we have to try the top-level service path match first, then operation paths
            return wsph{path} ?? owsh{path} ?? wsh{path};
        }
        #! @endcond
    }
}
