# minimum qore version
%requires qore >= 2.0
%requires xml
%requires Util >= 3.0
%requires Logger
%requires HttpClientIo
%requires(reexport) ConnectionProvider >= 1.4

%modern

module XmlRpcClientIo {
    version = "1.0";
    desc = "Pure-Qore XML-RPC client module with async I/O via HttpClientIo";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("xmlrpcio", XmlRpcIoConnection::ConnectionScheme);
        ConnectionSchemeCache::registerScheme("xmlrpcios", XmlRpcIoConnection::ConnectionScheme);
    };
}

/** @mainpage XmlRpcClientIo Module

    @tableofcontents

    @section xmlrpcclientiointro XmlRpcClientIo Module Introduction

    The %XmlRpcClientIo module provides a pure-Qore XML-RPC client implementation using async I/O
    via \c HttpClientIo::HttpClientConnectionManager with automatic protocol negotiation
    (HTTP/3 &rarr; HTTP/2 &rarr; HTTP/1.1) and connection pooling.

    This module is the async I/O replacement for the native C++
    \c XmlRpcClient class, providing the same XML-RPC call API
    but with modern async networking.

    To use this module, use \c "%requires XmlRpcClientIo" in your code.

    All the public symbols in the module are defined in the XmlRpcClientIo namespace.

    The module provides the following classes:
    - @ref XmlRpcClientIo::XmlRpcClientIo "XmlRpcClientIo" - the main XML-RPC client class
    - @ref XmlRpcClientIo::XmlRpcIoConnection "XmlRpcIoConnection" - connection provider for the
      ConnectionProvider framework

    @subsection xmlrpcclientio_features Features

    - Full XML-RPC protocol support
    - Async I/O via \c HttpClientIo::HttpClientConnectionManager with automatic
      protocol negotiation (HTTP/3 &rarr; HTTP/2 &rarr; HTTP/1.1) and connection pooling
    - API-compatible with the native \c XmlRpcClient class
    - Debug info variants for all call methods
    - ConnectionProvider integration with \c xmlrpcio:// and \c xmlrpcios:// URL schemes

    @subsection xmlrpcclientio_urls Endpoint URLs

    Both constructor forms select a fixed endpoint with @ref Util::get_http_endpoint_url(). An existing
    URL path, including an explicit <tt>/</tt>, wins over \c default_path. When the URL has no path,
    \c default_path supplies it (default: <tt>RPC2</tt>); <tt>custom</tt> and <tt>/custom</tt> both
    select <tt>/custom</tt>, and an empty default selects <tt>/</tt>. A query or fragment alone is not
    a path: <tt>http://rpc.example.com?tenant=west#help</tt> selects <tt>/RPC2?tenant=west</tt>.

    The query is preserved, including an empty <tt>?</tt>, duplicate parameters, and percent escapes.
    Fragments are removed. Existing internal/trailing slashes and dot segments are preserved; unsafe
    characters are percent-encoded once. The fallback is always a path on the same authority, never a
    URI reference or URL; query, fragment, NUL, and URI scheme syntax in it are rejected even when the
    URL already has a path. These rules apply after mapping the documented RPC scheme aliases to HTTP(S).

    \c getUrl() returns the selected endpoint URL, including the query and without the fragment. It can
    contain credentials: use \c Qore::get_safe_url() for display. These rules describe the Io clients;
    the native synchronous RPC clients retain their existing URL behavior.

    @subsection xmlrpcclientio_usage Usage Example

    @code{.py}
%modern
%requires XmlRpcClientIo

XmlRpcClientIo client("http://localhost:8080/RPC2");
hash<auto> result = client.call("system.listMethods");
if (result.fault) {
    printf("error: %s\n", result.fault.faultString);
} else {
    printf("result: %Y\n", result.params);
}
client.close();
    @endcode

    @section xmlrpcclientio_relnotes Release History
    - added source-owned connection option catalogs in all twelve standard locales; unchanged inherited
      presentation keeps its original producer identity, including HTTP/REST options and allowed values

    See @subpage xmlrpcclientioreleasenotes.
*/

/** @page xmlrpcclientioreleasenotes XmlRpcClientIo Release Notes

    @tableofcontents

    @section xmlrpcclientio_v1_0 XmlRpcClientIo v1.0
    - initial release
*/

#! the XmlRpcClientIo namespace holds all public definitions in the XmlRpcClientIo module
public namespace XmlRpcClientIo {
    #! Default URL path
    public const DefaultXmlRpcPath = "RPC2";
}
