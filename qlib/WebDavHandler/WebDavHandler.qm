# minimum required Qore version
%requires qore >= 2.0

module WebDavHandler {
    version = "1.3";
    desc = "User module for WebDAV server-side protocol support";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
}

%modern

%requires Logger
%requires HttpServerUtil
%requires xml
%requires json
%requires RestClient
%requires Util
%requires FsUtil
%try-module uuid
%define NO_UUID
%endtry

/** @mainpage WebDavHandler Module

    @tableofcontents

    @section webdavhandlerintro WebDavHandler Module Introduction

    This module provides a WebDAV server (RFC 4918) as request handlers for the Qore \c HttpServer module.  The
    handlers implement WebDAV compliance classes 1 and 2 and advertise them with the \c "DAV: 1,2" response header of \c OPTIONS requests.

    Main features:
    - file-system based WebDAV service with @ref WebDavHandler::FsWebDavHandler "FsWebDavHandler": \c GET,
      \c HEAD, \c PUT, \c POST, \c DELETE, \c MKCOL, \c COPY, \c MOVE, \c PROPFIND, \c PROPPATCH, \c LOCK
      and \c UNLOCK
    - dead properties stored by a property handler: in memory with
      @ref WebDavHandler::InMemoryWebDavPropertyHandler "InMemoryWebDavPropertyHandler" (the default) or in a
      file with @ref WebDavHandler::FileWebDavPropertyHandler "FileWebDavPropertyHandler"
    - exclusive and shared write locks, which are enforced: a request that changes a locked resource without
      submitting the lock token fails with status 423 and a \c DAV:lock-token-submitted error
    - evaluation of the \c If header (RFC 4918 section 10.4) with
      @ref WebDavHandler::WebDavIfHeader "WebDavIfHeader"; a false header fails with status 412
    - buffered \c PUT and \c POST text bodies retain their original character encoding when stored as files
    - \c PUT and \c POST request bodies over HTTP/1.1, HTTP/2 and HTTP/3; large and chunked bodies are streamed
      to the target over HTTP/2 and HTTP/3 (HttpServer buffers HTTP/1.1 bodies), and a body exceeding the
      server's maximum request body size fails with status 413, one that stops arriving with status 408

    @ref WebDavHandler::FsWebDavHandler "FsWebDavHandler" passes all five suites of the \c litmus WebDAV
    compliance test: basic (16/16), copymove (13/13), props (33/33), locks (40/40) and http (4/4).

    Classes provided by this module:
    - @ref WebDavHandler::AbstractWebDavHandler "AbstractWebDavHandler"
    - @ref WebDavHandler::AbstractWebDavLockHandler "AbstractWebDavLockHandler"
    - @ref WebDavHandler::AbstractWebDavPropertyHandler "AbstractWebDavPropertyHandler"
    - @ref WebDavHandler::DummyWebDavHandler "DummyWebDavHandler"
    - @ref WebDavHandler::FileWebDavPropertyHandler "FileWebDavPropertyHandler"
    - @ref WebDavHandler::FsWebDavHandler "FsWebDavHandler"
    - @ref WebDavHandler::InMemoryWebDavLockHandler "InMemoryWebDavLockHandler"
    - @ref WebDavHandler::InMemoryWebDavPropertyHandler "InMemoryWebDavPropertyHandler"
    - @ref WebDavHandler::WebDavHandlerProxy "WebDavHandlerProxy"
    - @ref WebDavHandler::WebDavIfHeader "WebDavIfHeader"

    @note @ref WebDavHandler::FsWebDavHandler "FsWebDavHandler" keeps its locks in an
    @ref WebDavHandler::InMemoryWebDavLockHandler "InMemoryWebDavLockHandler", so locks are lost when the server
    restarts.

    @section webdavhandler_example WebDavHandler Example

    @code{.py}
%modern

%requires HttpServer
%requires FsUtil
%requires WebDavHandler

%exec-class Main

class Server inherits HttpServer {
    private {
        int verbose;
        int port;
    }

    constructor(WebDavHandler::AbstractWebDavHandler handler, int verbose = 0) : HttpServer(\log(), \log(), True) {
        self.verbose = verbose;
        setHandler("webdavhandler", "/", NOTHING, handler);
        setDefaultHandler("webdavhandler", handler);

        map addHttpMethod($1), handler.getHttpMethods();

        port = addListener(<HttpListenerOptionInfo>{"service": 0}).port;
    }

    # logger for http server
    log(string str) {
        if (verbose > 2) {
            printf("%Y: %s\n", now_us(), vsprintf(str, argv));
        }
    }

    int getPort() {
        return port;
    }
}

class Main {
    constructor() {
        TmpDir tmp("tempdir-");

        WebDavHandler::FsWebDavHandler handler(tmp.path);

        Server srv(handler);

        printf("Using tmp path: %s; listening on port %d\n", tmp.path, srv.getPort());

        # wait forever - break with ctrl-C
        while (True) {
            sleep(99999999);
        }
    }
}
    @endcode

    @section webdavhandlerrelnotes Release Notes

    See @subpage webdavhandlerreleasenotes.
*/

/** @page webdavhandlerreleasenotes WebDavHandler Release Notes

    @tableofcontents

    @section webdavhandler_v1_3 WebDavHandler v1.3

    - XML responses declare their UTF-8 charset consistently with the XML declaration;
      PROPFIND and PROPPATCH multistatus responses also declare their XML media type,
      including proxy collection listings, so clients such as neon 0.37 parse them
      without relying on content sniffing
    - WebDavHandlerProxy inherits concrete defaults for unhandled operations so it
      can be instantiated, and its collection listings declare the DAV namespace
      used by child response elements. Mounted requests use the child's full
      dispatcher to derive filesystem paths and enforce its authentication and
      lock preconditions; configure each child with its complete public mount path.
    - buffered PUT and POST requests preserve uploaded bytes when the HTTP request body is decoded as text;
      text in a non-default encoding was previously transcoded while writing the file
    - @ref WebDavHandler::FsWebDavHandler "FsWebDavHandler" enforces RFC 4918 write locks and passes all five
      suites of the \c litmus WebDAV compliance test (basic, copymove, props, locks and http), which CI now runs:
      - the \c If header (RFC 4918 section 10.4) is parsed and evaluated for every method (new
        @ref WebDavHandler::WebDavIfHeader "WebDavIfHeader"): untagged and tagged lists, \c Not, lock tokens and
        entity tags; a false header fails with status 412 and a malformed one with 400
      - PUT, POST, PROPPATCH, MKCOL, DELETE, MOVE and the destination of COPY require the tokens of the locks that
        apply, including depth infinity locks of ancestors, the locks of a collection whose membership changes and
        the locks of members of a deleted or replaced collection; otherwise they fail with status 423 and a
        \c DAV:lock-token-submitted error; a lock on a copied source does not prevent the copy
      - lock refreshes and UNLOCK accept any resource within the scope of the lock, not only the lock root
        (RFC 4918 sections 9.10.2 and 9.11)
      - lock discovery reports the requested URL as the lock root (RFC 4918 section 14.12) instead of the
        server's file path, in the new \c href field of
        @ref WebDavHandler::WebDavLockInfo "WebDavLockInfo"
      - LOCK accepts the empty \c exclusive, \c shared and \c write elements of a request body; they were rejected
        with status 400
      - new abstract @ref WebDavHandler::AbstractWebDavLockHandler::getLocksInTree() "getLocksInTree()" and new
        @ref WebDavHandler::AbstractWebDavHandler::checkPreconditions() "checkPreconditions()" hook
    - COPY honors \c Depth: a \c "0" copy of a collection creates the collection without its members
      (RFC 4918 section 9.8.3; the value \c "0" was treated as absent), other values than \c "0" and
      \c "infinity" fail with status 400, and MOVE accepts \c "Depth: infinity" (it compared against
      \c "infinite")
    - COPY and MOVE return 201 for a new destination and 204 for a replaced one (RFC 4918 section 9.8.5); they
      returned 201 only with \c "Overwrite: F"
    - copying or moving to the root collection fails with status 403; it was never refused
    - entity tags are quoted strings built from the inode, size and modification time (the device number was used
      instead of the inode, and the tags were not quoted); \c If header entity tags are compared with the weak
      comparison function (RFC 9110 section 8.8.3.2)
    - PROPPATCH multistatus responses name the request URL instead of the server's file path
    - Fixed property copy/move for resources with no stored properties in memory and file-backed handlers;
      stale target properties are cleared without assigning NOTHING to a typed map
    - Same-resource property moves preserve their existing values; file-backed saves use an exclusive lock
      for the file and dirty state
    - <b>Automatic body streaming for `PUT` and `POST`.</b>
      @ref WebDavHandler::AbstractWebDavHandler "AbstractWebDavHandler" overrides
      @ref HttpServer::AbstractHttpRequestHandler::wantsBodyStreaming() "wantsBodyStreaming()"
      to opt in to incremental body delivery whenever a `PUT` or `POST` request is
      `Transfer-Encoding: chunked` or has a `Content-Length` greater than
      @ref WebDavHandler::AbstractWebDavHandler::BodyStreamingThreshold
      "BodyStreamingThreshold" (default `4 MB`). Smaller / fixed-size bodies stay buffered.
      Tunable per-instance via @ref WebDavHandler::AbstractWebDavHandler::setBodyStreamingThreshold()
      "setBodyStreamingThreshold()" — set to `0` to stream every `PUT`/`POST` body regardless
      of size.
    - New static helper
      @ref WebDavHandler::AbstractWebDavHandler::streamBodyToOutputStream()
      "streamBodyToOutputStream(cx, hdr, out, timeout)" wraps the protocol-specific async
      body readers (HTTP/2 `register_body_queue` queue drain, HTTP/3
      @ref Qore::Socket::readQuicStreamDataBlock() "Socket::readQuicStreamDataBlock" loop) so handler subclasses
      don't need to touch protocol-specific APIs.
    - @ref WebDavHandler::FsWebDavHandler "FsWebDavHandler" `PUT` and `POST` handlers now
      branch on whether the framework buffered the body: if so they write it directly,
      otherwise they stream it into a temp file (\c "<path>.webdav-upload") via the new
      helper and \c rename it into place atomically on success. A mid-upload failure leaves
      no partial file at the target.
    - <b>Note</b>: HTTP/1.1 request bodies are framework-buffered regardless of
      `wantsBodyStreaming()`; the streaming branch engages only on HTTP/2 and HTTP/3.
    - Fixed streamed `PUT` and `POST` requests over HTTP/2, which always failed:
      @ref WebDavHandler::AbstractWebDavHandler::streamBodyToOutputStream() "streamBodyToOutputStream()"
      registered the HTTP/2 body queue with the wrong closure signature
    - streamed bodies follow the HttpServer body limits:
      @ref WebDavHandler::AbstractWebDavHandler::streamBodyToOutputStream() "streamBodyToOutputStream()"
      raises the `HTTP-BODY-TOO-LARGE` error that ends a body exceeding the maximum request body size (an error
      record in the HTTP/2 queue, an exception from HTTP/3 reads, or the streamed total exceeding
      \c cx."header-info".max_request_body_size) and cancels an abandoned HTTP/2 read; the new
      @ref WebDavHandler::AbstractWebDavHandler::getBodyReadErrorResponse() "getBodyReadErrorResponse()"
      maps such errors to `413 Content Too Large` or `408 Request Timeout`, which
      @ref WebDavHandler::FsWebDavHandler "FsWebDavHandler" `PUT` and `POST` now return, removing the
      partial upload
    - Fixed a bug where @ref WebDavHandler::FsWebDavHandler "FsWebDavHandler" returned
      \c "500 Internal Server Error" for every \c PROPFIND request targeting a regular file; the
      resource hash literal narrowed to \c "hash<string, *string>" for non-directories, so setting
      the integer \c "DAV:getcontentlength" property failed with a \c RUNTIME-TYPE-ERROR

    @section webdavhandler_v1_2 WebDavHandler v1.2
    - <b>Migrated to the async-only `HttpServer` 1.6 handler model.</b> Asynchronous socket
      I/O is the preferred native way of performing socket I/O in Qore now, and HttpServer
      1.6 dispatches all requests through `HttpServerAsyncIo`. The handler signature is
      now the modern 3-arg `handleRequest(cx, hdr, body)`; all per-method dispatchers
      (`handleGet`, `handlePut`, `handlePropfind`, etc.) and their `*Impl` overrides drop
      the `Socket` parameter. Streaming GETs use the
      @ref HttpServer::HttpResponseInfo::chunked_body "HttpResponseInfo.chunked_body" field to
      hand a `FileInputStream` to the framework, which drives the chunked send. The
      previous direct-Socket calls (`s.sendHTTPResponseWithCallback`,
      `s.readHTTPChunkedBodyToOutputStream`, `getMessageBody(s, ...)`) are no longer
      needed — the framework buffers request bodies for non-streaming handlers and drives
      streamed responses on the handler's behalf. The `stream` flag on the
      `AbstractHttpRequestHandler` base is set to `False` (handlers do not currently
      implement the `AbstractStreamRequest` path; see future-work note below).
    - (Originally listed as future work; delivered in @ref webdavhandler_v1_3 "v1.3":
      automatic body streaming for `PUT` and `POST`.)

    @section webdavhandler_v1_1 WebDavHandler v1.1
    - added DAV Class 2 locking support (LOCK/UNLOCK methods)
    - added @ref WebDavHandler::AbstractWebDavLockHandler "AbstractWebDavLockHandler" interface
    - added @ref WebDavHandler::InMemoryWebDavLockHandler "InMemoryWebDavLockHandler" implementation
    - added @ref WebDavHandler::FileWebDavPropertyHandler "FileWebDavPropertyHandler" for persistent properties
    - fixed PROPFIND depth=infinity recursion bug
    - fixed PUT method to use proper semantics (idempotent, returns 201/204)

    @section webdavhandler_v1_0 WebDavHandler v1.0
    - initial release
*/

#! Main public WebDavHandler namespace
public namespace WebDavHandler {
#! WebDavHandler namespace value
public const DavNs = "DAV:";
}
