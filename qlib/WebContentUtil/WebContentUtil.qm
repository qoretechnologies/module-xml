%modern

%requires HttpClientIo
%requires Util
# xml provides parse_html() (the libxml2-backed lenient HTML parser) which
# HtmlExtractor uses for DOM-based content stripping, link extraction,
# rel="nofollow" filtering, and <link rel="canonical"> discovery.
%requires xml

module WebContentUtil {
    version = "1.0";
    desc = "Web crawling, HTML text extraction, text chunking, and URL normalization";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
    init = sub () {
    };
}

/** @mainpage WebContentUtil Module

    @tableofcontents

    @section webcontentutilintro Introduction

    The %WebContentUtil module provides reusable utilities for web content processing:

    - @ref WebContentUtil::WebCrawler "WebCrawler" - Parallel BFS web crawler built on
      @ref httpclientiointro "HttpClientIo" with HTTP/2 and HTTP/3 multiplexing, automatic
      protocol auto-selection via Alt-Svc, redirect following, rate limiting, and auto-throttle
      on 429/503 responses
    - @ref WebContentUtil::LocalDocReader "LocalDocReader" - Recursive local directory reader
      with file type filtering and directory exclusion
    - @ref WebContentUtil::HtmlExtractor "HtmlExtractor" - HTML to plain text extraction with
      element stripping
    - @ref WebContentUtil::TextChunker "TextChunker" - Text chunking with token estimation and
      configurable overlap
    - @ref WebContentUtil::UrlNormalizer "UrlNormalizer" - URL normalization for deduplication
      and consistent storage
    - @ref WebContentUtil::SitemapParser "SitemapParser" - sitemaps.org-compliant
      \c sitemap.xml and sitemap-index parser with recursive sub-sitemap support

    @section webcontentutil_usage Usage

    @code{.py}
%modern
%requires WebContentUtil

# Crawl a documentation site
list<hash<auto>> pages = WebCrawler::crawl("https://docs.example.com/", {
    "max_depth": 3,
    "max_pages": 500,
    "concurrency": 10,
});

# Read local HTML docs
list<hash<auto>> local_pages = LocalDocReader::read("/var/www/docs/");

# Extract text from HTML
string text = HtmlExtractor::extractText(html);

# Chunk text for embeddings
list<hash<auto>> chunks = TextChunker::chunk(text, "https://docs.example.com/page", "Page Title");

# Normalize a URL for dedup
string normalized = UrlNormalizer::normalize("https://example.com/path/../other/");
    @endcode

    @section webcontentutil_relnotes Release Notes

    @subsection webcontentutil_v1_0 WebContentUtil v1.0
    - initial release
*/

