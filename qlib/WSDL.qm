#! a numeric field whose finite choices use XSD value equality
/** Numeric field choices retain their schema spellings for display while accepting equivalent values.
    The field's provider validates all type facets independently, including lexical patterns.
    IEEE choices compare at the declared precision; NaN matches NaN and both zero signs share one choice.
    @par Example
    An amount enumerated as \c +001.2300 accepts \c 1.23 without changing the supplied spelling.
    @since %WSDL 0.5.8
*/
public class XsdNumericDataField inherits QoreDataField {
    private {
        string builtin;
    }

    private static hash<auto> withoutChoices(hash<auto> info) {
        remove info.allowed_values;
        remove info.element_allowed_values;
        return info;
    }

    #! constructs a numeric field with exact finite choices
    /** @param info the ordinary QoreDataField field properties
        @param builtin the numeric XSD builtin used for value comparison
        @throw XSD-SIMPLETYPE-ERROR invalid numeric choice text
    */
    constructor(hash<auto> info, string builtin) : QoreDataField(XsdNumericDataField::withoutChoices(info)) {
        if (!XsdNumericFacetHelper::isType(builtin)) {
            throw "XSD-SIMPLETYPE-ERROR", sprintf("invalid numeric field builtin %Y", builtin);
        }
        self.builtin = builtin;
        if (exists info.allowed_values) {
            setAllowedValues(info.allowed_values, info.allowed_values_creatable);
        }
        if (exists info.element_allowed_values) {
            setElementAllowedValues(info.element_allowed_values, info.element_allowed_values_creatable);
        }
    }

    #! sets numeric choices without applying this restriction's lexical patterns to facet declarations
    /** @param choices numeric values or AllowedValueInfo entries
        @param creatable whether this field permits values outside its finite choices
        @return this field
        @throw XSD-SIMPLETYPE-ERROR invalid numeric choice text
        @note The provider still enforces its own schema enumeration, even if creatable is True.
    */
    AbstractDataField setAllowedValues(list<auto> choices, *bool creatable) {
        list<hash<AllowedValueInfo>> resolved = resolveChoices(choices);
        hash<string, bool> value_map = map {valueKey($1.value): True}, resolved;
        allowed_values = resolved;
        allowed_values_map = value_map;
        allowed_values_creatable = creatable ?? False;
        return self;
    }

    #! sets exact numeric choices for repeated elements
    /** @param choices numeric values or AllowedValueInfo entries for each element
        @param creatable whether element values outside these choices are permitted
        @return this field
        @throw XSD-SIMPLETYPE-ERROR invalid numeric choice text
    */
    AbstractDataField setElementAllowedValues(list<auto> choices, *bool creatable) {
        list<hash<AllowedValueInfo>> resolved = resolveChoices(choices);
        hash<string, bool> value_map = map {valueKey($1.value): True}, resolved;
        element_allowed_values = resolved;
        element_allowed_values_map = value_map;
        element_allowed_values_creatable = creatable ?? False;
        return self;
    }

    private static list<hash<AllowedValueInfo>> resolveChoices(list<auto> choices) {
        list<hash<AllowedValueInfo>> resolved();
        foreach auto choice in (choices) {
            hash<AllowedValueInfo> entry = choice.typeCode() == NT_HASH
                ? new hash<AllowedValueInfo>(choice)
                : <AllowedValueInfo>{"value": choice, "display_name": string(choice)};
            resolved += entry;
        }
        return resolved;
    }

    private string valueKey(auto value) {
