        string lexical = value instanceof XsdBinaryValue ? cast<XsdBinaryValue>(value).getLexicalValue()
            : value.typeCode() == NT_STRING ? value : result.lexical ?? string(value);
        lexical = XsdSimpleType::normalizeWhiteSpace(lexical, result.white_space ?? "preserve");
        if (patterns) {
            bool matched = False;
            foreach XsdPatternConstraint pattern in (patterns) {
                if (XsdPatternConstraintHelper::matches(lexical, pattern)) {
                    matched = True;
                    break;
                }
            }
            if (!matched) {
                rejectValue(value);
            }
            result.value = result.identity && XsdBinaryLexicalHelper::isType(result.identity.family)
                ? new XsdBinaryValue(result.identity.family, lexical) : lexical;
            result.lexical = lexical;
        }
        if (enumeration) {
            foreach string allowed in (enumeration) {
                @assert(types.size() == 1 && types[0] instanceof UnionDataType);
                hash<XsdUnionTrialResult> candidate = cast<UnionDataType>(types[0]).trialValue(allowed);
                if (result.identity && candidate.identity
                        ? XsdUnionValueHelper::same(result.identity, candidate.identity) : lexical === allowed) {
                    return;
                }
            }
            rejectValue(value);
        }
    }

    private auto preserveValue(auto input, hash<XsdUnionTrialResult> result) {
        if (!result.identity || (input.typeCode() != NT_STRING && input.typeCode() != NT_LIST)
                || (result.value.typeCode() == NT_STRING && result.value === input)) {
            return result.value;
        }
        try {
            hash<XsdUnionTrialResult> encoded = trialValue(result.value);
            if (exists encoded.lexical) {
                hash<XsdUnionTrialResult> observed = trialValue(encoded.lexical);
                if (observed.identity && XsdUnionValueHelper::same(result.identity, observed.identity)) {
                    return result.value;
                }
            }
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "RUNTIME-TYPE-ERROR" && ex.err != "MISSING-VALUE-ERROR" && ex.err != "FIELD-VALUE-ERROR") {
                rethrow;
            }
        }
        return result.identity.family == "list" && result.value.typeCode() == NT_LIST
            ? XsdUnionValueHelper::listInput(input, "RUNTIME-TYPE-ERROR") : input;
    }

    #! returns a comparison key for a finite choice in the underlying union value space
    /** @param value a native or lexical choice
        @return a key retaining primitive family and exact value
        @throw RUNTIME-TYPE-ERROR no underlying union member accepts the choice
        @throw XSD-SIMPLETYPE-ERROR cyclic union metadata
        @note This union's outer pattern and enumeration restrictions are checked by acceptsValue().
    */
    string valueKey(auto value) {
        UnionDataType base = self;
        hash<string, bool> visited();
        while (base.patterns || base.enumeration) {
            string key = base.uniqueHash();
            if (visited{key}) {
                throw "XSD-SIMPLETYPE-ERROR", "cyclic union restriction metadata";
            }
            visited{key} = True;
            if (base.types.size() != 1 || !(base.types[0] instanceof UnionDataType)) {
                throw "XSD-SIMPLETYPE-ERROR", "union restriction requires a union base";
            }
            base = cast<UnionDataType>(base.types[0]);
        }
        hash<XsdUnionTrialResult> result = base.trialValue(value);
        if (result.identity) {
            return XsdUnionValueHelper::key(result.identity);
        }
        return result.value.type() + ":" + string(result.value);
    }

    private static rejectValue(auto value) {
        throw "RUNTIME-TYPE-ERROR", sprintf("no union type member accepts value %Y of type %Y", value, value.type());
    }

    #! returns whether a value must be supplied
    /** @return True for mandatory providers */
    bool isMandatory() {
        return !optional;
    }

    #! returns whether omission is accepted
    /** @return True for optional providers */
    bool isOrNothingType() {
        return optional;
    }

    #! creates an optional variant retaining all member constraints
    /** @return the optional provider */
    AbstractDataProviderType getOrNothingType() {
        UnionDataType result = self.copy();
        result.optional = True;
        return result;
    }

    #! creates a mandatory variant retaining all member constraints
    /** @return the mandatory provider */
    AbstractDataProviderType getMandatoryType() {
        UnionDataType result = self.copy();
        result.optional = False;
        return result;
    }
}

# Postorder nodes have only earlier children; no input-controlled recursive calls or cyclic graphs.
enum XsdRegexNodeKind {
    XRN_EMPTY = 0, XRN_CHARACTER = 1, XRN_SEQUENCE = 2, XRN_ALTERNATIVE = 3, XRN_REPEAT = 4,
    XRN_SET_UNION = 5, XRN_SET_NOT = 6, XRN_SET_DIFFERENCE = 7,
}
hashdecl XsdRegexNode {
    XsdRegexNodeKind kind;
    list<int> children();
    *string pattern;
    *string literal;
    string low = "1";
    *string high = "1";
    bool nullable = False;
}
# Thompson fragments use two states per grammar node; numeric bounds are never expanded.
hashdecl XsdRegexState {
    int atom = -1;
    list<int> next();
}
hashdecl XsdRegexFrontier {
    list<int> states();
    bool accepted = False;
}
class XsdRegexAutomaton {
    public {
        list<hash<XsdRegexState>> states();
        int start;
        int end;
    }
    static *XsdRegexAutomaton compile(list<hash<XsdRegexNode>> nodes, int root) {
        foreach hash<XsdRegexNode> node in (nodes) {
            if (node.kind == XRN_REPEAT && ((node.low != "0" && node.low != "1")
                    || (exists node.high && node.high != "0" && node.high != "1"))) {
                return;
            }
        }
        return new XsdRegexAutomaton(nodes, root);
    }
    private constructor(list<hash<XsdRegexNode>> nodes, int root) {
        start = 2 * root;
        end = start + 1;
        foreach hash<XsdRegexNode> node in (nodes) {
            int first = states.size();
            int last = first + 1;
            push states, <XsdRegexState>{};
            push states, <XsdRegexState>{};
            switch (node.kind) {
                case XRN_CHARACTER:
                case XRN_SET_UNION:
                case XRN_SET_NOT:
                case XRN_SET_DIFFERENCE:
                    states[first].atom = first / 2;
                    states[first].next = (last,);
                    break;
                case XRN_EMPTY:
                    states[first].next = (last,);
                    break;
                case XRN_ALTERNATIVE:
                    foreach int child in (node.children) {
                        push states[first].next, 2 * child;
                        push states[2 * child + 1].next, last;
                    }
                    break;
                case XRN_SEQUENCE:
                    int previous = first;
                    foreach int child in (node.children) {
                        push states[previous].next, 2 * child;
                        previous = 2 * child + 1;
                    }
                    push states[previous].next, last;
                    break;
                case XRN_REPEAT:
                    int child = 2 * node.children[0];
                    if (node.high != "0") {
                        push states[first].next, child;
                        push states[child + 1].next, last;
                        if (!exists node.high) {
                            push states[child + 1].next, child;
                        }
                    }
                    if (node.low == "0") {
                        push states[first].next, last;
                    }
                    break;
            }
        }
    }
    hash<XsdRegexFrontier> closure(list<int> seeds) {
        hash<XsdRegexFrontier> result();
        hash<string, bool> seen();
        while (seeds) {
            int state = pop seeds;
            string key = state.toString();
            if (seen.hasKey(key)) {
                continue;
            }
            seen{key} = True;
            if (state == end) {
                result.accepted = True;
            } else if (states[state].atom >= 0) {
                push result.states, state;
            } else {
                seeds += states[state].next;
            }
        }
        result.states = sort(result.states);
        return result;
    }
}

class XsdRegexMatchFrame {
    public {
        int node;
        int start;
        int child = 0;
        int index = 0;
        int count = 0;
        int low = 0;
        int high = 0;
        bool initialized = False;
        list<int> frontier();
        list<int> next();
        hash<string, bool> next_seen();
        list<int> result();
        hash<string, bool> result_seen();
        hash<string, bool> visited();
    }
    constructor(int node, int start) {
        self.node = node;
        self.start = start;
    }
    addResult(list<int> points) {
        foreach int point in (points) {
            string key = point.toString();
            if (!result_seen.hasKey(key)) {
                result_seen{key} = True;
                push result, point;
            }
        }
    }
    addNext(list<int> points, bool prune, int start) {
        foreach int point in (points) {
            string key = point.toString();
            if ((prune && (point == start || visited.hasKey(key))) || next_seen.hasKey(key)) {
                continue;
            }
            next_seen{key} = True;
            if (prune) {
                visited{key} = True;
            }
            push next, point;
        }
    }
    advance() {
        frontier = next;
        next = ();
        next_seen = {};
        index = 0;
    }
}
class XsdRegexSetFrame {
    public {
        int node;
        int index = 0;
    }
    constructor(int node) {
        self.node = node;
    }
}

class XsdRegexMatcher {
    private {
        list<hash<XsdRegexNode>> nodes;
        list<string> chars;
        list<int> widths();
        hash<string, list<int>> cache();
        hash<string, bool> predicate_cache();
    }
    constructor(list<hash<XsdRegexNode>> nodes, string text) {
        self.nodes = nodes;
        chars = text.splitChars();
        int limit = chars.size() + 1;
        foreach hash<XsdRegexNode> node in (nodes) {
            int width;
            switch (node.kind) {
                case XRN_EMPTY: width = 0; break;
                case XRN_CHARACTER:
                case XRN_SET_UNION:
                case XRN_SET_NOT:
                case XRN_SET_DIFFERENCE:
                    width = 1;
                    break;
                case XRN_SEQUENCE:
                    width = 0;
                    foreach int child in (node.children) {
                        width = widths[child] > limit - width ? limit : width + widths[child];
                    }
                    break;
                case XRN_ALTERNATIVE:
                    width = limit;
                    foreach int child in (node.children) {
                        width = min(width, widths[child]);
                    }
                    break;
                case XRN_REPEAT:
                    int child_width = widths[node.children[0]];
                    width = child_width ? bounded(node.low, limit / child_width + 1) : 0;
                    width = width && child_width > limit / width ? limit : width * child_width;
                    break;
            }
            push widths, width;
        }
    }
    private bool character(int root, string value) {
        string root_key = root.toString() + ":" + value;
        if (predicate_cache.hasKey(root_key)) {
            return predicate_cache{root_key};
        }
        list<XsdRegexSetFrame> work = (new XsdRegexSetFrame(root),);
        while (work) {
            XsdRegexSetFrame frame = work[-1];
            hash<XsdRegexNode> node = nodes[frame.node];
            string key = frame.node.toString() + ":" + value;
            if (node.kind == XRN_CHARACTER) {
                predicate_cache{key} = regex(value, "\\A(?:" + node.pattern + ")\\z");
                pop work;
                continue;
            }
            @assert(frame.index < node.children.size());
            int child = node.children[frame.index];
            string child_key = child.toString() + ":" + value;
            if (!predicate_cache.hasKey(child_key)) {
                push work, new XsdRegexSetFrame(child);
                continue;
            }
            bool accepted = predicate_cache{child_key};
            if (node.kind == XRN_SET_UNION) {
                if (accepted || ++frame.index == node.children.size()) {
                    predicate_cache{key} = accepted;
                    pop work;
                }
            } else if (node.kind == XRN_SET_NOT) {
                predicate_cache{key} = !accepted;
                pop work;
            } else {
                @assert(node.kind == XRN_SET_DIFFERENCE);
                if (!frame.index && accepted) {
                    ++frame.index;
                } else {
                    predicate_cache{key} = frame.index ? !accepted : False;
                    pop work;
                }
            }
        }
        return predicate_cache{root.toString() + ":" + value};
    }

    #! returns a flat, nonempty sequence of single-character predicates without expanding repetitions
    private *list<int> simpleCharacters(int root) {
        hash<XsdRegexNode> node = nodes[root];
        if (node.kind == XRN_CHARACTER || node.kind == XRN_SET_UNION || node.kind == XRN_SET_NOT
                || node.kind == XRN_SET_DIFFERENCE) {
            return (root,);
        }
        if (node.kind != XRN_SEQUENCE) {
            return;
        }
        foreach int child in (node.children) {
            XsdRegexNodeKind kind = nodes[child].kind;
            if (kind != XRN_CHARACTER && kind != XRN_SET_UNION && kind != XRN_SET_NOT
                    && kind != XRN_SET_DIFFERENCE) {
                return;
            }
        }
        return node.children;
    }

    #! scans literal/character-set groups without allocating a memo entry and frame per input character
    private list<int> simpleRepeat(list<int> atoms, int start, int low, int high) {
        list<int> result = low ? () : (start,);
        for (int count = 1; count <= high; ++count) {
            foreach int atom in (atoms) {
                @assert(start < chars.size());
                if (!character(atom, chars[start])) {
                    return result;
                }
                ++start;
            }
            if (count >= low) {
                push result, start;
            }
        }
        return result;
    }

    private static int bounded(string digits, int limit) {
        digits =~ s/^0+//;
        if (!digits) {
            return 0;
        }
        string bound = limit.toString();
        return digits.length() > bound.length() || (digits.length() == bound.length() && (digits <=> bound) > 0)
            ? limit : digits.toInt();
    }
    private bool matchesAutomaton(XsdRegexAutomaton automaton) {
        list<hash<XsdRegexFrontier>> frontiers = (automaton.closure((automaton.start,)),);
        hash<string, int> sets = {
            (frontiers[0].accepted ? "1:" : "0:") + frontiers[0].states.join(","): 0,
        };
        hash<string, int> transitions();
        int current = 0;
        # Cache only transitions reached by this input. Immutable grammar state is shared;
        # frontiers, character results and cancellation state remain local to the call.
        foreach string value in (chars) {
            string key = current.toString() + ":" + value;
            if (!transitions.hasKey(key)) {
                list<int> seeds();
                foreach int state in (frontiers[current].states) {
                    if (character(automaton.states[state].atom, value)) {
                        seeds += automaton.states[state].next;
                    }
                }
                hash<XsdRegexFrontier> next = automaton.closure(seeds);
                string signature = (next.accepted ? "1:" : "0:") + next.states.join(",");
                if (!sets.hasKey(signature)) {
                    sets{signature} = frontiers.size();
                    push frontiers, next;
                }
                transitions{key} = sets{signature};
            }
            current = transitions{key};
        }
        return frontiers[current].accepted;
    }

    bool matches(int root, *XsdRegexAutomaton automaton) {
        if (automaton) {
            return matchesAutomaton(automaton);
        }
        list<XsdRegexMatchFrame> work = (new XsdRegexMatchFrame(root, 0),);
        while (work) {
            XsdRegexMatchFrame frame = work[-1];
            hash<XsdRegexNode> node = nodes[frame.node];
            string key = sprintf("%d:%d", frame.node, frame.start);
            if (!frame.initialized) {
                if (widths[frame.node] > chars.size() - frame.start) {
                    cache{key} = ();
                    pop work;
                    continue;
                }
                if (node.kind == XRN_EMPTY || node.kind == XRN_CHARACTER || node.kind == XRN_SET_UNION
                        || node.kind == XRN_SET_NOT || node.kind == XRN_SET_DIFFERENCE) {
                    cache{key} = node.kind == XRN_EMPTY ? (frame.start,)
                        : frame.start < chars.size() && character(frame.node, chars[frame.start])
                            ? (frame.start + 1,) : ();
                    pop work;
                    continue;
                }
                frame.frontier = (frame.start,);
                frame.initialized = True;
                if (node.kind == XRN_REPEAT) {
                    int child = node.children[0];
                    int maximum = (chars.size() - frame.start) / max(widths[child], 1);
                    # Empty matches can pad the minimum count. Only positive-progress iterations matter,
                    # and an earlier visit to the same offset dominates later visits for a nullable atom.
                    frame.low = nodes[child].nullable ? 0 : bounded(node.low, maximum + 1);
                    frame.high = exists node.high ? bounded(node.high, maximum) : maximum;
                    frame.visited{frame.start.toString()} = True;
                    if (!frame.low) {
                        frame.addResult((frame.start,));
                    }
                    if (frame.low > frame.high) {
                        cache{key} = ();
                        pop work;
                        continue;
                    }
                    *list<int> atoms = simpleCharacters(child);
                    if (atoms) {
                        cache{key} = simpleRepeat(atoms, frame.start, frame.low, frame.high);
                        pop work;
                        continue;
                    }
                }
            }
            if (node.kind == XRN_ALTERNATIVE) {
                if (frame.child == node.children.size()) {
                    cache{key} = frame.result;
                    pop work;
                    continue;
                }
                int child = node.children[frame.child];
                string child_key = sprintf("%d:%d", child, frame.start);
                if (!cache.hasKey(child_key)) {
                    push work, new XsdRegexMatchFrame(child, frame.start);
                    continue;
                }
                frame.addResult(cache{child_key});
                ++frame.child;
                continue;
            }
            if ((node.kind == XRN_SEQUENCE && frame.child == node.children.size())
                    || (node.kind == XRN_REPEAT && (frame.count == frame.high || !frame.frontier))) {
                cache{key} = node.kind == XRN_SEQUENCE ? frame.frontier : frame.result;
                pop work;
                continue;
            }
            if (frame.index == frame.frontier.size()) {
                frame.advance();
                if (node.kind == XRN_SEQUENCE) {
                    ++frame.child;
                } else {
                    ++frame.count;
                    if (frame.count >= frame.low) {
                        frame.addResult(frame.frontier);
                    }
                }
                continue;
            }
            int child = node.children[node.kind == XRN_REPEAT ? 0 : frame.child];
            int start = frame.frontier[frame.index];
            string child_key = sprintf("%d:%d", child, start);
            if (!cache.hasKey(child_key)) {
                push work, new XsdRegexMatchFrame(child, start);
                continue;
            }
            # Once the lower bound is satisfied, an earlier visit leaves at least as much
            # remaining count budget as a later visit to the same offset. Before that point,
            # preserve distinct count states: attainable counts can have gaps.
            frame.addNext(cache{child_key}, node.kind == XRN_REPEAT
                && (nodes[child].nullable || frame.count + 1 >= frame.low), start);
            ++frame.index;
        }
        foreach int end in (cache{sprintf("%d:0", root)}) {
            if (end == chars.size()) {
                return True;
            }
        }
        return False;
    }
}

class XsdRegexParseFrame {
    public {
        list<int> pieces();
        list<int> branches();
    }
}

class XsdRegexProgram {
    private {
        list<hash<XsdRegexNode>> nodes();
        list<XsdRegexParseFrame> frames = (new XsdRegexParseFrame(),);
        int root;
        *string repeated_literal;
        *XsdRegexAutomaton automaton;
    }

    int makeCharacter(string pattern, *string literal = NOTHING) {
        push nodes, <XsdRegexNode>{"kind": XRN_CHARACTER, "pattern": pattern, "literal": literal};
        return nodes.size() - 1;
    }

    int makeSet(list<int> children, bool negative) {
        @assert(children);
        int result;
        if (children.size() == 1) {
            result = children[0];
        } else {
            push nodes, <XsdRegexNode>{"kind": XRN_SET_UNION, "children": children};
            result = nodes.size() - 1;
        }
        if (negative) {
            push nodes, <XsdRegexNode>{"kind": XRN_SET_NOT, "children": (result,)};
            result = nodes.size() - 1;
        }
        return result;
    }

    int makeDifference(int base, int excluded) {
        push nodes, <XsdRegexNode>{"kind": XRN_SET_DIFFERENCE, "children": (base, excluded)};
        return nodes.size() - 1;
    }

    appendAtom(int node) {
        @assert(node >= 0 && node < nodes.size());
        push frames[-1].pieces, node;
    }

    character(string pattern, *string literal = NOTHING) {
        appendAtom(makeCharacter(pattern, literal));
    }

    open() {
        push frames, new XsdRegexParseFrame();
    }

    branch() {
        XsdRegexParseFrame frame = frames[-1];
        push frame.branches, group(XRN_SEQUENCE, frame.pieces);
        frame.pieces = ();
    }

    close() {
        @assert(frames.size() > 1);
        branch();
        XsdRegexParseFrame frame = pop frames;
        appendAtom(group(XRN_ALTERNATIVE, frame.branches));
    }

    repeat(string low, *string high) {
        XsdRegexParseFrame frame = frames[-1];
        @assert(frame.pieces);
        int child = pop frame.pieces;
        low = XsdIntegerLexicalHelper::canonical(low);
        if (exists high) {
            high = XsdIntegerLexicalHelper::canonical(high);
        }
        # Pure closure identities hold for every language, including nullable atoms.
        # General bounded counts are deliberately retained: their attainable totals may have gaps.
        if (!exists high && (low == "0" || low == "1") && nodes[child].kind == XRN_REPEAT
                && !exists nodes[child].high && (nodes[child].low == "0" || nodes[child].low == "1")) {
            low = low == "0" || nodes[child].low == "0" ? "0" : "1";
            child = nodes[child].children[0];
        }
        push nodes, <XsdRegexNode>{"kind": XRN_REPEAT, "children": (child,), "low": low, "high": high,
            "nullable": low == "0" || nodes[child].nullable};
        push frame.pieces, nodes.size() - 1;
    }

    finish() {
        @assert(frames.size() == 1);
        branch();
        root = group(XRN_ALTERNATIVE, frames[0].branches);
        frames = ();
        automaton = XsdRegexAutomaton::compile(nodes, root);
        if (nodes[root].kind == XRN_REPEAT) {
            hash<XsdRegexNode> atom = nodes[nodes[root].children[0]];
            if (atom.kind == XRN_CHARACTER) {
                repeated_literal = atom.literal;
            } else if (atom.kind == XRN_SEQUENCE) {
                list<string> parts();
                foreach int child in (atom.children) {
                    if (!exists nodes[child].literal) {
                        return;
                    }
                    push parts, nodes[child].literal;
                }
                repeated_literal = parts.join("");
            }
        }
    }

    bool matches(string value) {
        @assert(!frames && nodes);
        if (repeated_literal) {
            int width = repeated_literal.length();
            if (value.length() % width) {
                return False;
            }
            # The input bounds the allocation; declared decimal counts never reach strmul().
            int count = value.length() / width;
            string digits = count.toString();
            hash<XsdRegexNode> repeat = nodes[root];
            if (XsdIntegerLexicalHelper::compare(digits, repeat.low) < 0
                    || (exists repeat.high && XsdIntegerLexicalHelper::compare(digits, repeat.high) > 0)) {
                return False;
            }
            # Compare bounded UTF-8 byte segments: Unicode substrings would repeatedly rescan prefixes.
            # The loop is also a cancellation point, including for an empty accepted input.
            binary input = convert_encoding(value, "UTF-8").toBinary();
            string literal = convert_encoding(repeated_literal, "UTF-8");
            int chunk = max(1, 65536 / literal.size());
            int offset = 0;
            while (True) {
                int repetitions = min(count, chunk);
                binary expected = strmul(literal, repetitions).toBinary();
                if (input.substr(offset, expected.size()) != expected) {
                    return False;
                }
                count -= repetitions;
                offset += expected.size();
                if (!count) {
                    return True;
                }
            }
        }
        XsdRegexMatcher matcher(nodes, value);
        return matcher.matches(root, automaton);
    }

    private int group(XsdRegexNodeKind kind, list<int> children) {
        if (children.size() == 1) {
            return children[0];
        }
        if (!children) {
            push nodes, <XsdRegexNode>{"kind": XRN_EMPTY, "nullable": True};
            return nodes.size() - 1;
        }
        bool nullable = kind == XRN_SEQUENCE;
        foreach int child in (children) {
            nullable = kind == XRN_SEQUENCE ? nullable && nodes[child].nullable : nullable || nodes[child].nullable;
        }
        push nodes, <XsdRegexNode>{"kind": kind, "children": children, "nullable": nullable};
        return nodes.size() - 1;
    }
}

#! an immutable XSD pattern retaining structural repetition counts
/** The serialized representation contains the original XSD source. Transient grammar nodes are rebuilt
    and validated on reconstruction. Each match uses independent state and observes Qore cancellation.

    @par Example
    A fixed-width import record can require 65536 lowercase characters with \c "[a-z]{65536}".
    This class validates that length without expanding the repetition into compiled regex instructions.

    @note Repetition counts remain exact decimal strings. Matching work is bounded by the input and parsed
    expression, including nullable atoms. Ambiguous expressions can require polynomial endpoint sets;
    application sandbox deadlines still apply. No state is shared between concurrent match calls.
    @since %WSDL 0.5.8
*/
public final class XsdCompiledPattern inherits Serializable {
    private {
        string source;
        transient XsdRegexProgram program;
    }

    #! constructs a structural XSD pattern
    /** @param source an XSD 1.0 regular expression
        @throw XSD-REGEX-ERROR the expression has invalid XSD syntax
    */
    constructor(string source) {
        initialize(source);
    }

    private initialize(string source) {
        XsdRegexProgram parsed();
        XsdRegexParser::parse(source, parsed);
        self.source = source;
        program = parsed;
    }

    private:internal deserializeMembers(hash<auto> members) {
        if (members.source.typeCode() != NT_STRING) {
            throw "DESERIALIZATION-ERROR", "a compiled XSD pattern requires its original source string";
        }
        try {
            initialize(members.source);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "XSD-REGEX-ERROR") {
                rethrow;
            }
            throw "DESERIALIZATION-ERROR", sprintf("invalid serialized XSD pattern: %s", ex.desc);
        }
    }

    #! tests whether the complete input matches this XSD expression
    /** @param value XML lexical text after the datatype's whitespace processing
        @return True if the complete input belongs to the pattern's language
        @throw PROGRAM-INTERRUPTED the associated program has been interrupted
    */
    bool matches(string value) {
        return program.matches(value);
    }

    #! returns the original XSD expression
    /** @return the original source, without conversion to PCRE */
    string getSource() {
        return source;
    }
}

#! a legacy PCRE expression or an immutable structural XSD pattern
/** Existing serialized PCRE strings remain accepted.
    @since %WSDL 0.5.8
*/
public typedef XsdPatternConstraint = union<string, XsdCompiledPattern>;

class XsdPatternConstraintHelper {
    static XsdPatternConstraint compile(string source) {
        return new XsdCompiledPattern(source);
    }

    static bool matches(string text, XsdPatternConstraint constraint) {
        return constraint instanceof XsdCompiledPattern ? constraint.matches(text) : regex(text, string(constraint));
    }
}

class XsdRegexParser inherits XsdRegexHelper {
    #! validates XSD grammar and optionally emits structural nodes alongside the PCRE translation
    static string parse(string source, *XsdRegexProgram program = NOTHING) {
        list<string> xsd = source.splitChars();
        list<string> pieces();
        int i = 0;
        int groups = 0;
        bool can_quantify = False;
        while (i < xsd.size()) {
            string c = xsd[i];
            switch (c) {
                case "\\":
                    string escaped = XsdRegexHelper::escapeToPcre(xsd, \i);
                    push pieces, escaped;
                    if (program) {
                        program.character(escaped);
                    }
                    can_quantify = True;
                    break;
                case "[":
                    push pieces, XsdRegexHelper::classToPcre(xsd, \i, program);
                    can_quantify = True;
                    break;
                case "(":
                    ++groups;
                    ++i;
                    push pieces, "(?:";
                    if (program) {
                        program.open();
                    }
                    can_quantify = False;
                    break;
                case ")":
                    if (!groups) {
                        throw "XSD-REGEX-ERROR", "unmatched closing parenthesis";
                    }
                    --groups;
                    ++i;
                    push pieces, ")";
                    if (program) {
                        program.close();
                    }
                    can_quantify = True;
                    break;
                case "|":
                    ++i;
                    push pieces, "|";
                    if (program) {
                        program.branch();
                    }
                    can_quantify = False;
                    break;
                case "?":
                case "*":
                case "+":
                case "{": {
                    if (!can_quantify) {
                        throw "XSD-REGEX-ERROR", "a quantifier requires an unquantified atom";
                    }
                    if (c == "{") {
                        int end = i + 1;
                        list<string> count_chars();
                        while (end < xsd.size() && xsd[end] != "}") {
                            push count_chars, xsd[end++];
                        }
                        if (end == xsd.size()) {
                            throw "XSD-REGEX-ERROR", "unterminated quantifier";
                        }
                        string counts = count_chars.join("");
                        if (!regex(counts, '\A[0-9]+(?:,[0-9]*)?\z')) {
                            throw "XSD-REGEX-ERROR", "invalid XSD quantifier";
                        }
                        list<string> bounds = counts.split(",");
                        if (bounds.size() == 2 && bounds[1].length()
                                && XsdIntegerLexicalHelper::compare(XsdIntegerLexicalHelper::canonical(bounds[0]),
                                    XsdIntegerLexicalHelper::canonical(bounds[1])) > 0) {
                            throw "XSD-REGEX-ERROR", "quantifier minimum exceeds maximum";
                        }
                        push pieces, "{" + counts + "}";
                        if (program) {
                            # split() drops a trailing empty field; retain the distinction between {n} and {n,}.
                            int comma = index(counts, ",");
                            *string maximum = comma < 0 ? bounds[0] : counts.substr(comma + 1);
                            program.repeat(bounds[0], maximum.length() ? maximum : NOTHING);
                        }
                        i = end + 1;
                    } else {
                        push pieces, c;
                        if (program) {
                            program.repeat(c == "+" ? "1" : "0", c == "?" ? "1" : NOTHING);
                        }
                        ++i;
                    }
                    can_quantify = False;
                    break;
                }
                case "]":
                case "}":
                    throw "XSD-REGEX-ERROR", "unescaped closing metacharacter";
                case ".":
                    push pieces, "[^\\n\\r]";
                    if (program) {
                        program.character("[^\\n\\r]");
                    }
                    ++i;
                    can_quantify = True;
                    break;
                case "^":
                case "$":
                    push pieces, "\\" + c;
                    if (program) {
                        program.character("\\" + c, c);
                    }
                    ++i;
                    can_quantify = True;
                    break;
                default:
                    push pieces, c;
                    if (program) {
                        program.character(c, c);
                    }
                    ++i;
                    can_quantify = True;
                    break;
            }
        }
        if (groups) {
            throw "XSD-REGEX-ERROR", "unterminated parenthesized expression";
        }
        if (program) {
            program.finish();
        }
        return pieces.join("");
    }

}

#! helper class for XSD regular expressions
/** The XSD regular expression language (XSD 1.0 part 2 appendix F) is not PCRE, which is what %Qore uses:
    - \c "^" and \c "$" are ordinary characters in XSD; a pattern always has to match the entire value
    - XSD has the multi-character escapes \c "\i", \c "\I", \c "\c", and \c "\C" for XML name characters,
      which PCRE does not have
    - XSD character classes support subtraction (ex: \c "[a-z-[aeiou]]"), which PCRE does not support
    - \c "\s", \c "\w", and \c "\d" denote different character sets in the two languages; \c "\s" does not
      include form feed or vertical tab in XSD, while \c "\w" and \c "\d" are not limited to ASCII

    This class converts XSD regular expressions to the equivalent PCRE expressions, and generates sample values
    matching them.

    @note Unicode block names in \c "\p{IsXxx}" escapes are translated to explicit character ranges.

    @since %WSDL 0.5.8
*/
public class XsdRegexHelper {
    public {
        #! XML 1.0 Second Edition name starts used by the XSD "\i" escape
        const NameStartChars = XsdNameLexicalHelper::NameStartChars;
        #! XML 1.0 Second Edition name characters used by the XSD "\c" escape
        const NameChars = XsdNameLexicalHelper::NameChars;
        #! the characters denoted by the XSD "\s" escape; PCRE also includes form feed and vertical tab
        const SpaceChars = " \\t\\n\\r";
        #! the character categories excluded by the XSD "\w" escape
        const NonWordCategories = "\\p{P}\\p{Z}\\p{C}";

    #! Unicode block ranges for the XSD \c "\p{IsXxx}" escapes, keyed by normalized block name
    /** generated from the Unicode character database (Blocks.txt); block names are compared ignoring
        case, whitespace, hyphens, and underscores, as the Unicode character database specifies
    */
    const UnicodeBlocks = {
        # Basic Latin
        "basiclatin":                                  '\x{0000}-\x{007F}',
