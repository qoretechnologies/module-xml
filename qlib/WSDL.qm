        @param creatable whether choices outside this field's finite list are permitted
        @return this field
        @throw RUNTIME-TYPE-ERROR a choice is outside the base union
        @note The provider's schema enumeration remains enforced when creatable is True.
    */
    AbstractDataField setAllowedValues(list<auto> choices, *bool creatable) {
        list<hash<AllowedValueInfo>> resolved = resolveChoices(choices);
        hash<string, bool> values = map {comparison.valueKey($1.value): True}, resolved;
        allowed_values = resolved;
        allowed_values_map = values;
        allowed_values_creatable = creatable ?? False;
        return self;
    }

    #! sets finite choices for repeated union elements
    /** @param choices native values or AllowedValueInfo entries for individual elements
        @param creatable whether element values outside these choices are permitted
        @return this field
        @throw RUNTIME-TYPE-ERROR a choice is outside the base union
    */
    AbstractDataField setElementAllowedValues(list<auto> choices, *bool creatable) {
        list<hash<AllowedValueInfo>> resolved = resolveChoices(choices);
        hash<string, bool> values = map {comparison.valueKey($1.value): True}, resolved;
        element_allowed_values = resolved;
        element_allowed_values_map = values;
        element_allowed_values_creatable = creatable ?? False;
        return self;
    }

    private static list<hash<AllowedValueInfo>> resolveChoices(list<auto> choices) {
        return map $1.typeCode() == NT_HASH ? new hash<AllowedValueInfo>($1)
            : <AllowedValueInfo>{"value": $1, "display_name": XsdDataFieldHelper::display($1)}, choices;
    }

    #! validates the union and compares finite choices in its value space
    /** @param value a native value or XML lexical spelling
        @return the validated value, retaining its spelling when required
        @throw FIELD-VALUE-ERROR the value is outside the finite choices
        @throw RUNTIME-TYPE-ERROR the underlying type rejects the value
        @throw MISSING-VALUE-ERROR a required value is absent
    */
    auto acceptsValue(auto value) {
        if (!exists value && exists (auto default_value = getDefaultValue())) {
            value = default_value;
        }
        on_error rethrow $1.err, sprintf("%s (while setting field %Y)", $1.desc, getName()), $1.arg;
        value = getType().acceptsValue(value);
        if (exists value && allowed_values && !allowed_values_creatable
                && !allowed_values_map{comparison.valueKey(value)}) {
            throw "FIELD-VALUE-ERROR", sprintf("field %Y does not accept union value %Y", getName(), value);
        }
        if (exists value && element_allowed_values && !element_allowed_values_creatable) {
            foreach auto item in (value) {
                if (!element_allowed_values_map{comparison.valueKey(item)}) {
                    throw "FIELD-VALUE-ERROR", sprintf("field %Y does not accept union element %Y", getName(), item);
                }
            }
        }
        return value;
    }
}

class XsdDataFieldHelper {
    static string display(auto value) {
        return value.typeCode() == NT_LIST ? (map displayScalar($1), value).join(" ") : displayScalar(value);
    }

    private static string displayScalar(auto value) {
        if (value instanceof XsdBinaryValue) {
            return cast<XsdBinaryValue>(value).getLexicalValue();
        }
        return value.typeCode() == NT_BINARY ? make_hex_string(value) : string(value);
    }

    static QoreDataField create(XsdElement element, hash<auto> info) {
        if (element.maxOccurs != 1 && exists info.allowed_values) {
            info.element_allowed_values = remove info.allowed_values;
        }
        return create(element.type, info);
    }

    static QoreDataField create(XsdAbstractType schema, hash<auto> info) {
        if (schema instanceof XsdComplexType) {
            XsdComplexType complex = cast<XsdComplexType>(schema);
            if (!complex.attrs && complex.simpleType) {
                schema = complex.simpleType;
            }
        }
        *hash<XsdListItemInfo> list_item = XsdListValueHelper::describeList(schema);
        if (list_item) {
            return new XsdListDataField(info, list_item);
        }
        XsdAbstractType original = schema;
        while (schema instanceof XsdSimpleType && cast<XsdSimpleType>(schema).type) {
            schema = cast<XsdSimpleType>(schema).type;
        }
        if (schema instanceof XsdSimpleType && cast<XsdSimpleType>(schema).unionTypes) {
            return new XsdUnionDataField(info, cast<UnionDataType>(original.getDataProviderType()));
        }
        if (schema instanceof XsdBaseType && XsdNumericFacetHelper::isType(schema.name)) {
            return new XsdNumericDataField(info, schema.name);
        }
        if (schema instanceof XsdBaseType && XsdCalendarLexicalHelper::isType(schema.name)) {
            return new XsdCalendarDataField(info, schema.name);
        }
        if (schema instanceof XsdBaseType && schema.name == "duration") {
            return new XsdDurationDataField(info);
        }
        if (schema instanceof XsdBaseType && XsdBinaryLexicalHelper::isType(schema.name)) {
            return new XsdBinaryDataField(info, schema.name);
        }
        if (schema instanceof XsdBaseType && schema.name == "boolean") {
            return new XsdBooleanDataField(info);
        }
        return new QoreDataField(info);
    }
}

#! class for XSD base types
public class XsdBaseType inherits WSDL::XsdAbstractType {
    public {
        #! recognized builtin type names, including the module's legacy binary transport type
        /** @since %WSDL 0.5.8 */
        const BuiltinTypes = {
            "anyType": True, "anySimpleType": True, "string": True, "boolean": True, "decimal": True,
            "float": True, "double": True, "duration": True, "dateTime": True, "time": True, "date": True,
            "gYearMonth": True, "gYear": True, "gMonthDay": True, "gDay": True, "gMonth": True,
            "hexBinary": True, "base64Binary": True, "anyURI": True, "QName": True, "NOTATION": True,
            "normalizedString": True, "token": True, "language": True, "NMTOKEN": True, "NMTOKENS": True,
            "Name": True, "NCName": True, "ID": True, "IDREF": True, "IDREFS": True, "ENTITY": True,
            "ENTITIES": True, "integer": True, "nonPositiveInteger": True, "negativeInteger": True,
            "long": True, "int": True, "short": True, "byte": True, "nonNegativeInteger": True,
            "unsignedLong": True, "unsignedInt": True, "unsignedShort": True, "unsignedByte": True,
            "positiveInteger": True, "binary": True,
        };

        #! the built-in types whose \c whiteSpace value is not \c "collapse"
        /** XSD 1.0 part 2: \c xs:string has \c whiteSpace \c "preserve" and \c xs:normalizedString has
            \c "replace"; every other built-in atomic type has \c "collapse", as does \c xs:token and all the
            types derived from it

            @since %WSDL 0.5.8
        */
        const WhiteSpaceMap = {
            "string": "preserve",
            "anyType": "preserve",
            "anySimpleType": "preserve",
            "normalizedString": "replace",
        };
    }

    #! constructs a builtin scalar type with independent input and output prefix handling
    /** @param t the builtin local type name
        @param nsc the input/output namespace registry
        @param ns an explicit input prefix, or the canonical builtin prefix xsd
        @throw WSDL-NAMESPACE-ERROR an explicit input prefix cannot be resolved
        @note The canonical xsd spelling does not require an input declaration.
    */
    constructor(string t, Namespaces nsc, string ns = "xsd") : XsdAbstractType(t, "", nsc) {
        # Builtin identity/output prefixes do not require an input declaration spelled "xsd".
        self.ns = ns;
        ons = ns == "xsd" ? nsc.getOutputNamespacePrefix(XSD_NS) : nsc.translateOutputNamespacePrefix(ns);
    }

    #! returns the \c whiteSpace processing that applies to this built-in type
    /** @since %WSDL 0.5.8
    */
    string getWhiteSpace() {
        return XsdBaseType::WhiteSpaceMap{name} ?? "collapse";
    }

    #! serializes a value using the lexical representation of this built-in XSD type
    /** @param nsc the output namespace registry
        @param val the native or lexical input
        @param omitType omit the explicit XML type attribute
        @return the serialized scalar or its XML value/attribute hash
        @throw SOAP-SERIALIZATION-ERROR the value cannot be converted to this builtin
    */
    auto serializeValue(Namespaces nsc, auto val, *softbool omitType) {
        *hash<auto> comments;
        if (val.typeCode() == NT_HASH) {
            if (name == "anySimpleType" && val.hasKey("^attributes^")) {
                throw SOAP_SERIALIZATION_ERROR, "anySimpleType cannot contain attributes";
            }
            foreach string k in (keys val) {
                if (k =~ /^\^comment/) {
                    comments{k} = val{k};
                }
            }
            val = name == "anyType" ? val."^value^" : XsdScalarTextHelper::value(val, SOAP_SERIALIZATION_ERROR);
        }
        # issue #5411: apply "whiteSpace" processing to the lexical value
        if (val.typeCode() == NT_STRING && !XsdBinaryLexicalHelper::isType(name)) {
            val = XsdSimpleType::normalizeWhiteSpace(val, getWhiteSpace());
        }
        *string type;
        # set type according to Qore type if xsd type is anyType
        if (name == "anyType") {
            # we have to specify the type in this case
            omitType = False;
            type = any_type_map{val.type()};
            if (!type)
                throw SOAP_SERIALIZATION_ERROR, sprintf("cannot serialize xsd type anyType from Qore type %y", val.type());
        } else {
            type = name;
        }
        if (XsdIntegerLexicalHelper::Types{type}) {
            string lexical = XsdIntegerLexicalHelper::lexical(type, val, SOAP_SERIALIZATION_ERROR);
            if (val.typeCode() != NT_INT) {
                val = lexical;
            }
        }
        if (XsdBuiltinListHelper::isType(type)) {
            val = XsdBuiltinListHelper::lexical(type, val, SOAP_SERIALIZATION_ERROR);
        } else if (XsdNameLexicalHelper::isType(type)) {
            val = XsdNameLexicalHelper::lexical(type, val, SOAP_SERIALIZATION_ERROR);
        }
        if (XsdCalendarLexicalHelper::isType(type)) {
            val = XsdCalendarLexicalHelper::lexical(type, val, SOAP_SERIALIZATION_ERROR);
        }
        switch (type) {
            case "anySimpleType": {
                if (exists val && !val.strp()) {
                    throw SOAP_SERIALIZATION_ERROR, sprintf("type anySimpleType requires a scalar value, got %Y",
                        val.type());
                }
                val = string(val);
                break;
            }
            case "date":
                break;

            case "dateTime":
                val = convertDate(val, SOAP_SERIALIZATION_ERROR).format("IF");
                break;

            case "boolean":
                val = XsdBooleanLexicalHelper::decode(val, SOAP_SERIALIZATION_ERROR) ? "true" : "false";
                break;

            case "time":
                val = format_date("HH:mm:SS.ms", convertDate(val, SOAP_SERIALIZATION_ERROR));
                break;

            case "base64Binary":
            case "hexBinary":
                val = XsdBinaryLexicalHelper::encode(type, val, SOAP_SERIALIZATION_ERROR);
                break;

            case "binary":
                # used for HTTP binding only
                val = binary(val);
                break;

            case "token":
                if (!val.strp()) {
                    throw SOAP_SERIALIZATION_ERROR, sprintf("type %y only accepts values that are convertible to strings; type %y supplied", type, val.type());
                }
                val = XsdSimpleType::normalizeWhiteSpace(val.toString(), "collapse");
                break;

            case "normalizedString":
                if (!val.strp()) {
                    throw SOAP_SERIALIZATION_ERROR, sprintf("type %y only accepts values that are convertible to strings; type %y supplied", type, val.type());
                }
                val = XsdSimpleType::normalizeWhiteSpace(val.toString(), "replace");
                break;

            case "string":
            case "anyURI":
            case "language":
            case "Name":
            case "NCName":
            case "QName":
            case "NMTOKEN":
            case "NMTOKENS":
            case "ID":
            case "IDREF":
            case "IDREFS":
            case "ENTITY":
            case "ENTITIES":
            case "integer":
            case "long":
            case "int":
            case "short":
            case "byte":
            case "unsignedLong":
            case "unsignedInt":
            case "unsignedShort":
            case "unsignedByte":
            case "positiveInteger":
            case "negativeInteger":
            case "nonPositiveInteger":
            case "nonNegativeInteger":
                # pass through without transformation
                break;

            case "decimal":
                val = XsdDecimalLexicalHelper::lexical(val, SOAP_SERIALIZATION_ERROR);
                break;

            case "float":
            case "double":
                val = XsdIeeeLexicalHelper::lexical(type, val, SOAP_SERIALIZATION_ERROR);
                break;

            case "duration":
                val = XsdDurationLexicalHelper::lexical(val, SOAP_SERIALIZATION_ERROR);
                break;

            case "gYear":
            case "gYearMonth":
            case "gMonthDay":
            case "gMonth":
            case "gDay":
                break;

            default:
                throw SOAP_SERIALIZATION_ERROR, sprintf("don't know how to serialize type %y", type);
        }

        #printf("DEBUG: FORCE: type: %y, nstype: %y, val: %y\n", type, nstype, val);
        if (omitType) {
            if (comments) {
                return comments + (
                    "^value^": val
                );
            } else
                return val;
        } else {
            return comments + {
                "^attributes^": (
                    "xsi:type": sprintf("%s:%s", ons, type),
                ),
                "^value^": val,
            };
        }
    }

    #! converts a builtin lexical value to its public native representation
    /** @param en the containing element name
        @param tmap the resolved type map
        @param mrh the multireference value map
        @param val the scalar input or its XML value/attribute hash
        @return the converted builtin value
        @throw SOAP-DESERIALIZATION-ERROR the value cannot be converted to this builtin
    */
    auto deserializeValue(string en, hash<string, XsdAbstractType> tmap, *hash<auto> mrh, auto val) {
        string type;
        if (val.typeCode() == NT_HASH) {
            if (name != "anyType") {
                XsdBase::validateSimpleAttributes(val."^attributes^", name);
            }
            if (val."^attributes^"."xsi:type") {
                type = val."^attributes^"."xsi:type";
                string t = (type =~ x/[^:]+:([^:]+)/)[0];
                if (exists t) {
                    type = t;
                }

                if (name != "anyType" && type != name) {
                    throw SOAP_DESERIALIZATION_ERROR, sprintf("expecting base type %y, got %y", name, val."^attributes^"."xsi:type");
                }
            } else {
                type = name;
            }
            val = type == "anyType" ? val."^value^" : XsdScalarTextHelper::value(val, SOAP_DESERIALIZATION_ERROR);
        } else {
            type = name;
        }

        # issue #5411: apply "whiteSpace" processing to the lexical value
        if (val.typeCode() == NT_STRING) {
            val = XsdSimpleType::normalizeWhiteSpace(val, XsdBaseType::WhiteSpaceMap{type} ?? "collapse");
        }
        if (XsdIntegerLexicalHelper::Types{type}) {
            return XsdIntegerLexicalHelper::decode(type,
                XsdIntegerLexicalHelper::lexical(type, val, SOAP_DESERIALIZATION_ERROR));
        }
        if (XsdBuiltinListHelper::isType(type)) {
            return XsdBuiltinListHelper::lexical(type, val, SOAP_DESERIALIZATION_ERROR);
        }
        if (XsdNameLexicalHelper::isType(type)) {
            return XsdNameLexicalHelper::lexical(type, val, SOAP_DESERIALIZATION_ERROR);
        }
        if (XsdCalendarLexicalHelper::isType(type)) {
            return XsdCalendarLexicalHelper::decode(type, val, SOAP_DESERIALIZATION_ERROR);
        }

        switch (type) {
            case "anySimpleType":
            case "string":
            case "token":
            case "normalizedString":
            case "anyURI":
            case "language":
            case "Name":
            case "NCName":
            case "QName":
            case "NMTOKEN":
            case "NMTOKENS":
            case "ID":
            case "IDREF":
            case "IDREFS":
            case "ENTITY":
            case "ENTITIES":
                if (exists val && !val.strp()) {
                    throw SOAP_DESERIALIZATION_ERROR, sprintf("type %y does not accept values of type %y (val: %y)", type, val.type(), val);
                }
                return nsc.opt_empty_string_is_nothing ? val : string(val);

            case "dateTime":
                return convertDate(val, SOAP_DESERIALIZATION_ERROR);

            case "time":
                return convertDate("1970-01-01T" + val, SOAP_DESERIALIZATION_ERROR);

            case "boolean":
                return XsdBooleanLexicalHelper::decode(val, SOAP_DESERIALIZATION_ERROR);

            case "decimal":
                return XsdDecimalLexicalHelper::decode(
                    XsdDecimalLexicalHelper::lexical(val, SOAP_DESERIALIZATION_ERROR));

            case "base64Binary":
            case "hexBinary":
                return XsdBinaryLexicalHelper::decode(type, val, SOAP_DESERIALIZATION_ERROR);

            case "binary":
                # used for HTTP binding only
                if (val.typeCode() == NT_BINARY) {
                    return val;
                } else {
                    return val.empty() ? binary() : binary(val);
                }

            case "float":
            case "double":
                return XsdIeeeLexicalHelper::decode(type, val, SOAP_DESERIALIZATION_ERROR);

            case "duration":
                return XsdDurationLexicalHelper::lexical(val, SOAP_DESERIALIZATION_ERROR);

            default: {
                if (name == "anyType")  {
                    *XsdAbstractType t = tmap_try_get(tmap, type);
                    if (t) {
                        return t.deserializeValue(en, tmap, mrh, val);
                    }
                }
                throw SOAP_DESERIALIZATION_ERROR, sprintf("don't know how to handle type %y", name);
            }
        }
    }

    private static date convertDate(auto value, string error) {
        try {
            return date(value);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "INVALID-DATE") {
                rethrow error, ex.desc, ex.arg;
            }
            rethrow;
        }
    }

    #! maps scalar types without dedicated validators to their soft provider equivalents
    /** Integer, boolean and IEEE providers validate their XML lexical spaces before conversion.
        Other scalar providers use soft equivalents to accept convertible input values.
    */
    const SoftTypeMap = {
        "int": SoftIntType,
        "float": SoftFloatType,
        "date": SoftDateType,
        "string": SoftStringType,
    };

    #! returns the data provider type used to accept values for this XSD type
    /** @return a validating scalar provider or the scalar's soft provider equivalent
        @note Integer providers preserve exact values outside signed 64-bit range as strings.
        Decimal providers preserve high precision and noncanonical lexical forms as strings.
        IEEE providers validate complete lexical input and round at the declared float/double precision.
        Duration providers retain exact XML text and validate relative-date conversion without losing microseconds.
        Text providers apply the builtin whitespace rule; builtin token lists require at least one item.
    */
    AbstractDataProviderType getDataProviderType() {
        # XSD booleans need a type that parses string values according to the XSD boolean lexical space; a plain
        # "softbool" would convert the string "false" to True
        if (name == "boolean") {
            return XsdBooleanType;
        }
        if (name == "decimal") {
            return new XsdDecimalDataType();
        }
        if (name == "duration") {
            return new XsdDurationDataType();
        }
        if (XsdBinaryLexicalHelper::isType(name)) {
            return new XsdBinaryDataType(name);
        }
        if (XsdIntegerLexicalHelper::Types{name}) {
            return new XsdIntegerDataType(name);
        }
        if (XsdIeeeLexicalHelper::isType(name)) {
            return new XsdIeeeDataType(name);
        }
        if (XsdCalendarLexicalHelper::isType(name)) {
            return new XsdCalendarDataType(name);
        }
        if (XsdBuiltinListHelper::isType(name)) {
            return new XsdSizedRestrictionDataType(<XsdSizedFacetInfo>{
                "name": name, "kind": "tokens", "white_space": "collapse", "min_length": 1,
                "name_type": name,
            }, AbstractDataProviderType::get(SoftStringType));
        }
        Type type = getDataProviderBaseType();
        if (type == StringType && name != "anySimpleType") {
            return new XsdSizedRestrictionDataType(<XsdSizedFacetInfo>{
                "name": name, "kind": "string", "white_space": getWhiteSpace(),
                "name_type": XsdNameLexicalHelper::isType(name) ? name : NOTHING,
            }, AbstractDataProviderType::get(SoftStringType));
        }
        return AbstractDataProviderType::get(SoftTypeMap{type.getName()} ?? type);
    }

    #! returns the %Qore type closest to the XSD type
    /** @return the legacy closest native type; it does not describe every lossless output alternative
        @note Use @ref WSDL::XsdBaseType::getDataProviderType() "XsdBaseType::getDataProviderType()" for the
        validated conversion contract. Calendar date providers can also return strings for missing timezones
        or years outside the native range, and scalar providers enforce XSD syntax before native conversion.
    */
    Type getDataProviderBaseType() {
        switch (name) {
            case "byte":
            case "short":
            case "int":
            case "integer":
            case "long":
            case "unsignedByte":
            case "unsignedShort":
            case "unsignedInt":
            case "unsignedLong":
            case "negativeInteger":
            case "nonNegativeInteger":
            case "nonPositiveInteger":
            case "positiveInteger":
                return IntType;

            case "decimal":
            case "float":
            case "double":
                return FloatType;

            case "date":
            case "dateTime":
            case "time":
                return DateType;

            case "boolean":
                return BoolType;

            case "string":
            case "token":
            case "normalizedString":
            case "anyURI":
            case "language":
            case "Name":
            case "NCName":
            case "QName":
            case "NMTOKEN":
            case "NMTOKENS":
            case "ID":
            case "IDREF":
            case "IDREFS":
            case "ENTITY":
            case "ENTITIES":
            case "duration":
            case "gYear":
            case "gYearMonth":
            case "gMonthDay":
            case "gMonth":
            case "gDay":
                return StringType;

            case "base64Binary":
                return Base64BinaryType;

            case "hexBinary":
                return HexBinaryType;

            case "binary":
                return BinaryType;
        }

        # for anyType or any unknown type
        return AbstractDataProviderType::anyType;
    }
}

#! class for XSD array types; supports single and multi-dimensional arrays
public class XsdArrayType inherits WSDL::XsdAbstractType {
    private {
        bool finalized;
    }

    public {
        *hash<auto> typeinfo;
        XsdAbstractType elementType;

        #! number of dimensions for multi-dimensional arrays (1 = single dimension)
        int dimensions = 1;
    }

    constructor(string t, string ns, string arrayType, Namespaces nsc, XsdLateResolverHelper unresolved) : XsdAbstractType(t, ns, nsc) {
        # Parse array dimensions - handles both [] and [,] notation
        # SOAP 1.1 Section 5.4.2 supports:
        # - Single dimension: type[] or type[n]
        # - Multi-dimension: type[,] or type[n,m] (comma-separated)
        # - Nested arrays: type[][] (multiple bracket pairs)

        # Count dimensions from bracket notation using extract mode (x//)
        # Handle comma-separated dimensions first (e.g., [,] = 2D, [n,m] = 2D)
        # Note: use + not * to only match brackets with actual content
        *list<*string> match = (arrayType =~ x/\[([,\d]+)\]$/);
        if (match) {
            *string dimSpec = match[0];
            # Count commas + 1 for comma-separated dimensions (e.g., [,] = 2D, [,,] = 3D)
            # Use regex_subst to remove commas and calculate count from length difference
            string noCommas = regex_subst(dimSpec, ",", "", RE_Global);
            int commaCount = dimSpec.length() - noCommas.length();
            dimensions = commaCount + 1;
            # Remove the bracket suffix
            arrayType =~ s/\[([,\d]+)\]$//;
        }

        # Handle empty bracket pairs (e.g., type[][] = 2D, type[] = 1D)
        # Count all [] pairs and set dimensions to that count
        int bracketCount = 0;
        while (arrayType =~ /\[\]$/) {
            bracketCount++;
            arrayType =~ s/\[\]$//;
        }
        if (bracketCount > 0) {
            dimensions = bracketCount;
        }

        if (!nsc.doType(arrayType, \typeinfo, \elementType)) {
            unresolved.add(self);
        } else {
            finalized = True;
        }
    }

    AbstractDataProviderType getDataProviderType() {
        # Build nested list type for multi-dimensional arrays
        AbstractDataProviderType innerType = elementType.getDataProviderType();
        for (int i = 0; i < dimensions; i++) {
            innerType = new ListDataType(innerType);
        }
        return innerType;
    }

    finalize(hash<string, XsdAbstractType> tmap, Namespaces nsc, *hash<string, XsdGroup> groupMap,
            *hash<string, XsdAttributeGroup> attrGroupMap, *XsdLateResolverHelper unresolved) {
        if (finalized) {
            return;
        }
        finalized = True;
        on_error finalized = False;

        XsdAbstractType t = elementType ?? tmap_get(tmap, type_qname(typeinfo.uri, typeinfo.val));
        if (t instanceof XsdComplexType) {
            cast<XsdComplexType>(t).finalize(tmap, nsc, groupMap, attrGroupMap, unresolved);
        } else if (t instanceof XsdArrayType) {
            cast<XsdArrayType>(t).finalize(tmap, nsc, groupMap, attrGroupMap, unresolved);
        }
        elementType = t;
    }

    auto serializeValue(Namespaces nsc, auto val, *softbool omitType) {
        switch (name) {
            case "binary": {
                int t = val.typeCode();
                if (t === NT_STRING) {
                    val = binary(val);
                } else if (t !== NT_BINARY) {
                    throw SOAP_SERIALIZATION_ERROR, sprintf("cannot serialize type %y from type %y; requires "
                        "string or binary", name, t);
                }
                return val;
            }

            default: {
                # this must be an untyped hash
                hash rv;
                if (!omitType) {
                    # Build arrayType attribute with proper dimension notation
                    string dimSuffix = dimensions > 1
                        ? "[" + strmul(",", dimensions - 1) + "]"
                        : "[]";
                    rv."^attributes^" = {"soapenc:arrayType": elementType.getNameWithNS() + dimSuffix};
                }
                if (val.typeCode() == NT_HASH && val.size() == 1) {
                    rv += {
                        "soapenc:" + val.firstKey(): map serializeElement(nsc, $1, omitType, dimensions),
                            val.firstValue(),
                    };
                } else {
                    rv += {
                        "^value^": (map serializeElement(nsc, $1, omitType, dimensions), val),
                    };
                }
                return rv;
            }
        }
    }

    #! Serialize a single element, handling nested dimensions for multi-dimensional arrays
    private auto serializeElement(Namespaces nsc, auto val, *softbool omitType, int remainingDims) {
        if (remainingDims > 1 && val.typeCode() == NT_LIST) {
            # For multi-dimensional arrays, recursively serialize nested lists
            return map serializeElement(nsc, $1, omitType, remainingDims - 1), val;
        }
        return elementType.serializeValue(nsc, val, omitType);
    }

    auto deserializeValue(string en, hash<string, XsdAbstractType> tmap, *hash<auto> mrh, auto val) {
        switch (name) {
            case "binary": {
                if (val.typeCode() != NT_BINARY) {
                    throw SOAP_DESERIALIZATION_ERROR, sprintf("cannot deserialize type %y from type %y; requires "
                        "binary", name, val.typeName());
                }
                return val;
            }

            default: {
                # remove any namespace marker from value
                *string ns = remove val.".ns";
                softint attr = val.hasKey("^attributes^");
                if (val.typeCode() == NT_HASH) {
                    # Handle ^value^ key specially - return deserialized content directly
                    if (val.hasKey("^value^")) {
                        return map deserializeElement(en, tmap, mrh, $1, dimensions), val."^value^";
                    }
                    # For other single-key hashes, preserve the element name
                    if (val.size() == (1 + attr)) {
                        string ename = (map $1, keys val, $1 != "^attributes^")[0];
                        return {ename: (map deserializeElement(en, tmap, mrh, $1, dimensions), val{ename})};
                    }
                }
                return map deserializeElement(en, tmap, mrh, $1, dimensions), val;
            }
        }
    }

    #! Deserialize a single element, handling nested dimensions for multi-dimensional arrays
    private auto deserializeElement(string en, hash<string, XsdAbstractType> tmap, *hash<auto> mrh, auto val,
            int remainingDims) {
        if (remainingDims > 1 && val.typeCode() == NT_LIST) {
            # For multi-dimensional arrays, recursively deserialize nested lists
            return map deserializeElement(en, tmap, mrh, $1, remainingDims - 1), val;
        }
        return elementType.deserializeValue(en, tmap, mrh, val);
    }
}

#! XSD typed data class
public class XsdTypedData inherits WSDL::XsdNamedData {
    public {
        *hash<auto> typeinfo;
        XsdAbstractType type;
    }

    constructor(reference e) : XsdNamedData(\e) {
    }
}

#! XSD attribute class
public class XsdAttribute inherits WSDL::XsdTypedData {
    public {
        string use = "optional";

        #! expanded name of a referenced global attribute, captured at the declaration
        /** @since %WSDL 0.5.8 */
        *hash<auto> refInfo;

        #! namespace URI of the attribute declaration; empty for an unqualified attribute
        /** @since %WSDL 0.5.8 */
        string namespaceUri = "";

        #! original default lexical form, if supplied or inherited from a referenced declaration
        /** @since %WSDL 0.5.8 */
        *string defaultLexical;
        #! original fixed lexical form, if supplied or inherited from a referenced declaration
        /** @since %WSDL 0.5.8 */
        *string fixedLexical;

        const AllowedUseValues = {
            "optional": True,
            "required": True,
            "prohibited": True,
        };
    }

    private {
        auto constraintValue;
        bool constraints_resolved = False;
    }

    #! constructs an attribute declaration or reference
    /** @param attr the parsed XML attribute declaration
        @param nsc its declaration namespace context
        @param n_type an already resolved type, if supplied
        @param unresolved the schema's late resolution queue
        @param global_attribute True for a schema-level declaration
        @throw WSDL-ERROR contradictory declaration or non-simple attribute type
        @throw WSDL-NAMESPACE-ERROR invalid or unresolved QName prefix
        @throw XSD-ATTRIBUTE-ERROR invalid use value
    */
    constructor(hash<auto> attr, Namespaces nsc, *XsdAbstractType n_type, XsdLateResolverHelper unresolved,
            bool global_attribute = False) : XsdTypedData(\attr) {
        NamespacePrefixHelper declaration(nsc, attr."^attributes^");
        *hash<auto> aa = attr."^attributes^";
        if (exists aa.use) {
            if (!AllowedUseValues{aa.use}) {
                throw "XSD-ATTRIBUTE-ERROR", sprintf("attribute %Y: use %Y is unrecognized; recognized values: %Y",
                    name, aa.use, keys AllowedUseValues);
            }
            use = aa.use;
        }
        if ((!aa.name && !aa.ref) || (exists aa.name && exists aa.ref)
                || (aa.ref && (exists aa.type || exists aa.form || attr.hasKey("simpleType")))
                || (exists aa.type && attr.hasKey("simpleType"))
                || (exists aa.default && exists aa.fixed)
                || (exists aa.default && use != "optional")
                || (global_attribute && (aa.ref || exists aa.use || exists aa.form))
                || (exists aa.form && aa.form != "qualified" && aa.form != "unqualified")
                || (select keys attr, $1 != "^attributes^" && $1 != "ns" && $1 != "annotation"
                    && $1 != "simpleType")
                || (attr.hasKey("simpleType") && attr.simpleType.typeCode() != NT_HASH)) {
            throw WSDL_ERROR, sprintf("invalid or contradictory attribute declaration %Y", aa);
        }
        if (global_attribute || (aa.form ?? nsc.attribute_form_default) == "qualified") {
            namespaceUri = nsc.getTargetNamespaceUri() ?? "";
        }
        if (aa.name) {
            nsc.validateDeclarationName(aa.name);
        }
        defaultLexical = aa.default;
        fixedLexical = aa.fixed;
        if (aa.ref) {
            refInfo = nsc.getTypeHash(aa.ref);
            name = refInfo.val;
            namespaceUri = refInfo.uri;
            unresolved.add(self);
        } else {
            if (n_type) {
                type = n_type;
            } else if (exists aa.type) {
                nsc.doType(aa.type, \typeinfo, \type);
            } else if (attr.hasKey("simpleType")) {
                type = new XsdSimpleType(attr.simpleType, nsc, unresolved, False,
                    sprintf("simpleType for attribute %Y", name));
            } else {
                type = nsc.getBaseType("anySimpleType");
            }
            if (type) {
                validateType();
            } else {
                unresolved.add(self);
            }
        }
        if (exists defaultLexical || exists fixedLexical) {
            unresolved.add(self);
        }
    }

    #! verifies that the resolved attribute type is simple
    /** @throw WSDL-ERROR the attribute has no type or a complex type
        @since %WSDL 0.5.8
    */
    validateType() {
        if (!(type instanceof XsdSimpleType)
                && (!(type instanceof XsdBaseType) || type.name == "anyType")) {
            throw WSDL_ERROR, sprintf("attribute %Y requires a resolved simple type, got %Y", name,
                type ? type.name : NOTHING);
        }
    }

    #! initializes typed value constraints after resolving the attribute's simple type
    /** @param declaration a referenced global attribute declaration, if any
        @throw WSDL-ERROR an invalid constraint value or inconsistent fixed override
        @since %WSDL 0.5.8
    */
    resolveConstraints(*XsdAttribute declaration) {
        if (constraints_resolved) {
            return;
        }
        *string own_default = defaultLexical;
        *string own_fixed = fixedLexical;
        if (!exists defaultLexical && !exists fixedLexical && declaration) {
            defaultLexical = declaration.defaultLexical;
            fixedLexical = declaration.fixedLexical;
        }
        if (hasValueConstraint()) {
            if (XsdTypeDerivationHelper::isIdDerived(type)) {
                throw WSDL_ERROR, sprintf("ID-derived attribute %Y cannot have a default or fixed constraint", name);
            }
            try {
                constraintValue = type.deserializeValue(name, new hash<string, XsdAbstractType>(), NOTHING,
                    fixedLexical ?? defaultLexical);
            } catch (hash<ExceptionInfo> ex) {
                throw WSDL_ERROR, sprintf("invalid value constraint for attribute %Y: %s: %s", name, ex.err, ex.desc);
            }
        }
        if (declaration && exists declaration.fixedLexical
                && (exists own_default || (exists own_fixed
                    && !XsdScalarValueHelper::equal(type, constraintValue, declaration.getDefaultValue())))) {
            throw WSDL_ERROR, sprintf("attribute %Y cannot override its declaration's fixed value", name);
        }
        constraints_resolved = True;
    }

    #! returns whether this attribute has a default or fixed constraint
    /** @return True if either constraint is present, including an empty string
        @since %WSDL 0.5.8
    */
    bool hasValueConstraint() {
        return exists defaultLexical || exists fixedLexical;
    }

    #! returns the typed value supplied for an absent optional attribute
    /** @return the default/fixed value, or NOTHING when there is no constraint
        @since %WSDL 0.5.8
    */
    auto getDefaultValue() {
        return constraintValue;
    }

    #! returns the output XML name for this attribute's namespace and local name
    /** @param nsc the output namespace registry
        @return an unqualified local name or an allocated prefix and local name
        @since %WSDL 0.5.8
    */
    string getXmlName(Namespaces nsc) {
        return namespaceUri ? nsc.getOutputNamespacePrefix(namespaceUri) + ":" + name : name;
    }

    #! merges attribute uses without losing colliding local names
    /** @param inherited existing attribute uses
        @param added one or more maps of attribute uses to incorporate
        @param override_existing True when derivation supplies a replacement use
        @return uses keyed by local name where unique, and by expanded name for every colliding local name
        @throw WSDL-ERROR duplicate expanded attribute uses outside derivation
        @since %WSDL 0.5.8
    */
    static hash<string, XsdAttribute> mergeMaps(hash<string, XsdAttribute> inherited,
            softlist<hash<string, XsdAttribute>> added, bool override_existing = False) {
        hash<string, XsdAttribute> expanded();
        hash<string, int> counts();
        foreach XsdAttribute attr in (inherited.iterator()) {
            expanded{type_qname(attr.namespaceUri, attr.name)} = attr;
            ++counts{attr.name};
        }
        foreach hash<string, XsdAttribute> attributes in (added) {
            foreach XsdAttribute attr in (attributes.iterator()) {
                string identity = type_qname(attr.namespaceUri, attr.name);
                if (expanded.hasKey(identity)) {
                    if (!override_existing) {
                        throw WSDL_ERROR, sprintf("duplicate attribute use %Y", identity);
                    }
                } else {
                    ++counts{attr.name};
                }
                expanded{identity} = attr;
            }
        }
        hash<string, XsdAttribute> result();
        foreach string identity in (keys expanded) {
            XsdAttribute attr = expanded{identity};
            result{counts{attr.name} == 1 ? attr.name : identity} = attr;
        }
        return result;
    }

    #! parses an attribute lexical value and checks its fixed constraint
    /** @param val the XML attribute value
        @return the typed attribute value
        @throw SOAP-DESERIALIZATION-ERROR an invalid value or fixed-value mismatch
    */
    auto getValue(string val) {
        auto result = type.deserializeValue(name, new hash<string, XsdAbstractType>(), NOTHING, val);
        checkFixedValue(result, SOAP_DESERIALIZATION_ERROR);
        return result;
    }

    private checkFixedValue(auto value, string error) {
        if (exists fixedLexical && !XsdScalarValueHelper::equal(type, value, constraintValue)) {
            throw error, sprintf("attribute %Y must have fixed value %Y, got %Y", name, constraintValue, value);
        }
    }

    #! returns the attribute value serialized according to the attribute's type
    /** attribute values must be converted like element values; otherwise dates, booleans, and binary values are
        written to the XML message in Qore's default string representation instead of in their XSD representation

        @param nsc the namespace container for the message being serialized
        @param val the attribute value to serialize

        @return the serialized attribute value

        @since %WSDL 0.5.8
    */
    auto serializeAttributeValue(Namespaces nsc, auto val) {
        auto serialized = type.serializeValue(nsc, val, True);
        if (exists fixedLexical) {
            auto lexical = serialized.typeCode() == NT_HASH ? serialized."^value^" : serialized;
            auto typed = type.deserializeValue(name, new hash<string, XsdAbstractType>(), NOTHING, string(lexical));
            checkFixedValue(typed, SOAP_SERIALIZATION_ERROR);
        }
        return serialized;
    }
}

# Internal field indexing shared by element groups and complex types.
class XsdElementFieldHelper {
    # Reindex maps during schema construction before selecting compatible public field names.
    static hash<string, XsdElement> getExpandedMap(hash<string, XsdElement> element_map) {
        hash<string, XsdElement> result();
        foreach XsdElement element in (element_map.iterator()) {
            result{element.getExpandedName()} = element;
        }
        return result;
    }

    static hash<string, string> getFieldNames(softlist<hash<string, XsdElement>> maps) {
        hash<string, string> identities();
        hash<string, int> counts();
        foreach hash<string, XsdElement> element_map in (maps) {
            foreach XsdElement element in (element_map.iterator()) {
                string identity = element.getExpandedName();
                if (!identities.hasKey(identity)) {
                    identities{identity} = element.name;
                    ++counts{element.name};
                }
            }
        }
        hash<string, string> result();
        foreach string identity in (keys identities) {
            string name = identities{identity};
            result{identity} = counts{name} == 1 ? name : identity;
        }
        return result;
    }

    static hash<string, XsdElement> getFieldMap(hash<string, XsdElement> element_map,
            hash<string, string> fields) {
        hash<string, XsdElement> result();
        foreach XsdElement element in (element_map.iterator()) {
            string identity = element.getExpandedName();
            @assert(fields.hasKey(identity));
            result{fields{identity}} = element;
        }
        return result;
    }
}

# Internal construction check over declarations retained before flat field maps merge.
class XsdElementConsistencyHelper {
    static merge(reference<hash<string, XsdElement>> declarations, softlist<XsdElement> additions) {
        foreach XsdElement element in (additions) {
            string identity = element.getExpandedName();
            *XsdElement previous = declarations{identity};
            if (previous && previous != element && !(previous.ref && element.ref)
                    && !(previous.type.hasRealName() && element.type.hasRealName()
                        && previous.type == element.type)) {
                throw WSDL_ERROR, sprintf("conflicting type definitions for element %Y in one content model",
                    identity);
            }
            if (!previous) {
                declarations{identity} = element;
            }
        }
    }

    static bool isAbsent(*hash<auto> data) {
        *hash<auto> attributes = data."^attributes^";
        return XsdEmptiabilityHelper::zeroOccurs(attributes.minOccurs)
            && XsdEmptiabilityHelper::zeroOccurs(attributes.maxOccurs);
    }
}

#! XSD element class
public class XsdElement inherits WSDL::XsdTypedData {
    public {
        int minOccurs = 1;
        int maxOccurs = 1;
        bool nillable = False;
        # the resolved namespace URI for any reference
        *string ref_ns;
        # the source name for any reference
        *string ref;
        bool usedocns;
    }

    private {
        bool has_value_constraint = False;
    }

    #! constructs an element declaration or a reference to a global element
    /** @param e parsed element declaration
        @param nsc declaration namespace context
        @param n_type resolved type for an internal synthetic element, if supplied
        @param unresolved the schema construction resolver
        @param n_usedocns default local element qualification
        @param global_element True for a schema-level declaration
        @throw WSDL-ERROR contradictory declarations or properties invalid in this context
        @throw WSDL-NAMESPACE-ERROR malformed or unbound QName
        @throw XSD-SIMPLETYPE-ERROR an invalid inline simple type
        @throw XSD-ELEMENT-ERROR inconsistent occurrence limits
    */
    constructor(hash<auto> e, Namespaces nsc, *XsdAbstractType n_type, XsdLateResolverHelper unresolved,
            bool n_usedocns, bool global_element = False) : XsdTypedData(\e) {
        NamespacePrefixHelper declaration(nsc, e."^attributes^");
        usedocns = n_usedocns;
        if (!ns) {
            ns = nsc.getTargetNamespaceUri() ?? "";
        }
        if (n_type) {
            type = n_type;
            return;
        }
        *hash<auto> a = e."^attributes^";
        int type_declarations = int(exists a.type) + int(e.hasKey("simpleType")) + int(e.hasKey("complexType"));
        if ((exists a.name) == (exists a.ref) || type_declarations > 1
                || (exists a.default && exists a.fixed)
                || (exists a.form && a.form != "qualified" && a.form != "unqualified")
                || (global_element && (exists a.ref || exists a.form || exists a.minOccurs || exists a.maxOccurs))
                || (!global_element && (exists a.abstract || exists a.final || exists a.substitutionGroup))
                || (exists a.ref && (type_declarations || exists a.form || exists a.nillable || exists a.default
                    || exists a.fixed || exists a.block || e.hasKey("key") || e.hasKey("keyref") || e.hasKey("unique")))) {
            throw WSDL_ERROR, sprintf("invalid or contradictory element declaration %Y", a);
        }
        foreach string kind in ("simpleType", "complexType") {
            if (e.hasKey(kind) && ((exists e{kind} && e{kind}.typeCode() != NT_HASH)
                    || exists e{kind}."^attributes^".name)) {
                throw WSDL_ERROR, sprintf("element %Y requires one anonymous %s declaration", name, kind);
            }
        }
        if (exists a.form) {
            usedocns = a.form == "qualified";
        }
        if (exists a.name) {
            nsc.validateDeclarationName(a.name);
        }
        if (exists a.minOccurs) {
            minOccurs = int(a.minOccurs);
        }
        if (exists a.maxOccurs) {
            maxOccurs = a.maxOccurs == "unbounded" ? -1 : int(a.maxOccurs);
        }
        if (maxOccurs != -1 && minOccurs > maxOccurs) {
            throw "XSD-ELEMENT-ERROR", sprintf("minOccurs (%d) > maxOccurs (%d) for element %s", minOccurs, maxOccurs,
                name);
        }
        foreach string property in ("nillable", "abstract") {
            if (!exists a{property}) {
                continue;
            }
            string value = trim(a{property});
            if (value != "true" && value != "false" && value != "1" && value != "0") {
                throw WSDL_ERROR, sprintf("invalid %s value %Y for element %Y", property, value, name);
            }
            if (property == "nillable") {
                nillable = value == "true" || value == "1";
            }
        }
        has_value_constraint = exists a.default || exists a.fixed;
        on_success {
            if (has_value_constraint) {
                unresolved.addConstrainedElement(self);
            }
        }
        if (exists a.type) {
            if (!nsc.doType(a.type, \typeinfo, \type)) {
                unresolved.add(self);
            }
        } else if (e.hasKey("simpleType")) {
            type = new XsdSimpleType(e.simpleType ?? {}, nsc, unresolved, usedocns, sprintf("simpleType for element %Y", name));
        } else if (e.hasKey("complexType")) {
            type = new XsdComplexType(e.complexType, nsc, unresolved, usedocns, sprintf("complexType for element %Y", name));
            if (!type.isRequired() && !exists a.minOccurs) {
                minOccurs = 0;
            }
            if (type.isNillable() && !exists a.nillable) {
                nillable = True;
            }
        } else if (exists a.ref) {
            hash<auto> identity = nsc.getTypeHash(a.ref);
            ref = identity.val;
            name = ref;
            ref_ns = identity.uri;
            usedocns = boolean(ref_ns);
            unresolved.add(self);
        } else {
            type = nsc.getBaseType("anyType");
        }
    }

    #! checks whether a resolved element type permits a value constraint
    /** @throw WSDL-ERROR an ID-derived element type or simple content has a default/fixed constraint
        @note Called after complex and simple type finalization.
        @since %WSDL 0.5.8
    */
    validateValueConstraintType() {
        if (!has_value_constraint) {
            return;
        }
        *XsdAbstractType content = type instanceof XsdComplexType ? cast<XsdComplexType>(type).simpleType : type;
        if (content && XsdTypeDerivationHelper::isIdDerived(content)) {
            throw WSDL_ERROR, sprintf("ID-derived element %Y cannot have a default or fixed constraint", name);
        }
    }

    AbstractDataProviderType getDataProviderType() {
        AbstractDataProviderType rv = type.getDataProviderType();
        if (maxOccurs != 1 && (type.hasNativeListValue() || (!(rv instanceof ListDataType) && !rv.isList()))) {
           rv = new SoftListDataType(rv.getName(), rv, False, NOTHING, rv.getTags());
        }
        if (!minOccurs || nillable) {
            rv = rv.getOrNothingType();
        }
        return rv;
    }

    *list<auto> getAllowedValues() {
        return type.getAllowedValues();
    }

    #! returns finite choices for the complete provider value
    /** @return the declared type's complete-value choices */
    *list<auto> getDataProviderAllowedValues() {
        return type.getDataProviderAllowedValues();
    }

    assimilate(WSDL::XsdElement other) {
        map self{$1.key} = $1.value, other.pairIterator(), !exists self{$1.key};
        # we have to use the namespace of the referenced element
        ns = other.ns;
    }

    bool isRequired() {
        return minOccurs > 0;
    }

    bool isNillable() {
        return nillable;
    }

    #! returns the expanded XML name required by this element declaration
    /** @return the namespace/local identity, using an empty namespace for unqualified local elements
        @since %WSDL 0.5.8
    */
    string getExpandedName() {
        return type_qname(ref ? ref_ns : (usedocns ? ns : ""), name);
    }

    #! returns the XML output name for this element declaration
    /** @param namespaces the output namespace registry
        @return the declared local name, qualified with an output prefix when its namespace is nonempty
        @since %WSDL 0.5.8
    */
    string getXmlName(Namespaces namespaces) {
        *string uri = ref ? ref_ns : (usedocns ? ns : "");
        return uri ? namespaces.getOutputNamespacePrefix(uri) + ":" + name : name;
    }

    #! validates a retained XML element using the existing decode and encode constraints
    /** @param value a complete XML element document
        @param nsc namespace context for validating the corresponding native serialization
        @param tmap the resolved schema type map
        @return the validated native value; the retained XML is not modified
        @throw SOAP-SERIALIZATION-ERROR wrong expanded root, forbidden DOCTYPE or rejected schema content
        @note Checks both conversion paths: serialization can enforce constraints that decoding does not.
        General scalar, particle and dynamic-type validation follows the same rules as native values.
        @since %WSDL 0.5.8
    */
    auto validateXmlValue(XsdXmlValue value, Namespaces nsc, hash<string, XsdAbstractType> tmap) {
        if (value.getExpandedName() != getExpandedName()) {
            throw SOAP_SERIALIZATION_ERROR, sprintf("XML value root %Y does not match element %Y",
                value.getExpandedName(), getExpandedName());
        }
        XmlReader reader = value.getReader();
        while (reader.read()) {
            if (reader.nodeType() == XML_NODE_TYPE_DOCUMENT_TYPE) {
                throw SOAP_SERIALIZATION_ERROR, "a retained SOAP element cannot contain a DOCTYPE";
            }
            if (reader.nodeType() == XML_NODE_TYPE_ELEMENT) {
                break;
            }
        }
        try {
            # Comments do not participate in XSD content-model validation. Keep them in the carrier's
            # public view, while using the same comment-free parser projection as native SOAP decoding.
            hash<auto> expanded = XsdBase::expandElementNamespaces(parse_xml(value.getXml(), XPF_PRESERVE_ORDER));
            auto native_value = deserializeValue(tmap, NOTHING, expanded{getExpandedName()}, True);
            # Validation must not publish output-prefix allocations to the shared schema registry.
            Namespaces validation_namespaces = nsc.copy();
            serializeValue(validation_namespaces, native_value, True, name, name);
            return native_value;
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "PROGRAM-INTERRUPTED" || ex.err == "THREAD-CANCELLED") {
                rethrow;
            }
            throw SOAP_SERIALIZATION_ERROR, sprintf("XML value for element %Y failed validation: %s: %s",
                getExpandedName(), ex.err, ex.desc);
        }
    }

    auto serializeValue(Namespaces nsc, auto h, *softbool omitType, string key, string typename) {
        if (h."^type^" && h."^type^" instanceof XsdAbstractType && h.hasKey("^val^")) {
            XsdAbstractType ntype = cast<XsdAbstractType>(h."^type^");
            ntype.checkExtends(type, name);
            return serializeAsIntern(nsc, ntype, h."^val^", omitType, key, name);
        }

        return serializeAsIntern(nsc, type, h, omitType, key, typename);
    }

    private auto serializeAsIntern(Namespaces nsc, XsdAbstractType type, auto h, *softbool omitType, string key, string typename) {
        #printf("DEBUG: XsdElement::serializeAsIntern() name: %y (with type: %y) h: %y key: %y typename: %y (%y) minOccurs: %y nillable: %y (%y %y)\n", name, ((!omitType || type != self.type) && type.hasRealName()), h, key, typename, type.getName(), minOccurs, nillable, !exists h, !minOccurs);

        int tc = h.typeCode();
        # Don't unwrap single-element lists for XSD list types (they need the list value)
        bool is_list_type = type.hasNativeListValue() && maxOccurs == 1;
        if (tc == NT_LIST && h.size() == 1 && !type.hasNativeListValue()) {
            h = h[0];
            tc = h.typeCode();
        }

        # For list types, empty lists are valid values (serialize to empty element content)
        # For non-list types, empty lists with minOccurs=0 can be skipped
        if (!exists h || (tc == NT_LIST && h.empty() && !is_list_type)) {
            if (!minOccurs)
                return;

            if (nillable || type.isNillable()) {
                hash<auto> rh = ("xsi:nil": "true");
                if ((!omitType || type != self.type) && type.hasRealName())
                    rh += ("xsi:type": type.getNameWithNS());
                return ("^attributes^": rh);
            }

            if (!type.isRequired())
                return;

            if (!type.requiresValue())
                return ("^value^": NOTHING);

            throw SOAP_SERIALIZATION_ERROR, sprintf("missing element %y value for %s::%s (minOccurs: %d, type %y)", name, typename, key, minOccurs, type.getName());
        }

        # NOTE: pf must be an untyped hash
        hash pf;
        if ((!omitType || type != self.type) && type.hasRealName())
            pf = ("^attributes^": ("xsi:type": !usedocns ? type.getName() : type.getNameWithNS()));

        if (tc == NT_LIST) {
            # For list types (XsdSimpleType with listItemType), the list value is passed
            # directly to the type's serialize() which handles it as a space-separated value
            if (is_list_type) {
                # Let the list type handle the list value directly
                auto rv = type.serializeValue(nsc, h, omitType);
                if (!pf) {
                    return rv;
                }
                if (rv.typeCode() != NT_HASH) {
                    pf."^value^" = rv;
                    return pf;
                }
                return pf + rv;
            }

            int len = h.size();
            if (maxOccurs == 1 && len > 1) {
                throw SOAP_SERIALIZATION_ERROR, sprintf("cannot serialize element %y of type %y from a list<auto> with %d elements because maxOccurs = 1", name, type.getName(), len);
            }
            if (len > maxOccurs && maxOccurs > 0) {
                throw SOAP_SERIALIZATION_ERROR, sprintf("list<auto> for element %y of type %y has %d element%s, but maxOccurs = %d", name, type.getName(), elements h, elements h == 1 ? "" : "s", maxOccurs);
            }
            if (len < minOccurs) {
                throw SOAP_SERIALIZATION_ERROR, sprintf("list<auto> for element %y of type %y has %d element%s, but minOccurs = %d", name, type.getName(), elements h, elements h == 1 ? "" : "s", minOccurs);
            }

            list<auto> l = ();
            foreach auto e in (h) {
                l += (pf + type.serializeValue(nsc, e, omitType));
            }
            return l;
        }
        if (minOccurs > 1)
            throw SOAP_SERIALIZATION_ERROR, sprintf("only one element passed to element %y of type %y, but minOccurs = %d", name, type.getName(), minOccurs);

        #printf("DEBUG: element %y type %s: %y omitType: %y h: %y\n", name, type.className(), type.name, omitType, h);
        # issue #2899: combine return value in a hash if necessary
        auto rv = type.serializeValue(nsc, h, omitType);
        if (!pf) {
            return rv;
        }
        if (rv.typeCode() != NT_HASH) {
            pf."^value^" = rv;
        } else {
            foreach hash hh in (rv.pairIterator()) {
                pf{hh.key} += hh.value;
            }
        }
        return pf;
    }

    auto deserializeValue(hash<string, XsdAbstractType> tmap, *hash<auto> mrh, auto val, bool present) {
        #printf("XsdElement::deserialize() name: %y type: %y (nillable: %y) val: %y present: %y\n", name, type.getName(), type.isNillable(), val, present);
        *hash<auto> a = val."^attributes^";
        if (a)
            WSDL::XsdBase::removeNS(\a);

        if ((!exists val && !present) || a.nil == "true") {
            if (nillable || type.isNillable() || !minOccurs)
                return;
            throw SOAP_DESERIALIZATION_ERROR, sprintf("NOTHING passed for element %y type %y, but nillable=False and minOccurs: %d", name, type.getName(), minOccurs);
        }

        if (val.typeCode() == NT_LIST) {
            int el = elements val;
            if (maxOccurs != -1 && el > maxOccurs)
                throw SOAP_DESERIALIZATION_ERROR, sprintf("error deserializing element %y, maxOccurs: %d but list<auto> is %d elements long", name, maxOccurs, el);
            if (el < minOccurs)
                throw SOAP_DESERIALIZATION_ERROR, sprintf("error deserializing element %y, minOccurs: %d but list<auto> is %d elements long", name, minOccurs, el);

            return map type.deserializeValue(name, tmap, mrh, getValue(mrh, $1)), val;
        }

        if (minOccurs > 1)
            throw SOAP_DESERIALIZATION_ERROR, sprintf("single value passed for element %y, but minOccurs: %d", name, minOccurs);

        return type.deserializeValue(name, tmap, mrh, getValue(mrh, val));
    }
}

#! explicit provider type for a retained XML element
/** Native schema/provider field types remain unchanged. This opt-in type validates and returns an
    immutable XsdXmlValue, retaining its lexical text, namespaces and ordered XML.

    @par Example
    An invoice connector can accept a complete XML invoice without converting its retained quantity
    spelling or namespace-qualified extension fields into flat provider fields.

    @since %WSDL 0.5.8
*/
public class XsdXmlValueDataType inherits QoreDataType {
    private {
        XsdSchema schema_owner;
        string element_namespace;
        string element_name;
        transient XsdElement element;
        transient Namespaces namespaces;
        transient hash<string, XsdAbstractType> types;
    }

    #! constructs an explicit XML provider type for a global element
    /** @param schema the schema containing the global declaration
        @param namespace_uri the global element namespace, or an empty string
        @param local_name the global element's local name
        @throw WSDL-ERROR the global element does not exist
        @note Retains validation state strongly. Serializable reconstruction uses the schema's saved
        source documents instead of serializing internal component metadata.
    */
    constructor(XsdSchema schema, string namespace_uri, string local_name)
            : QoreDataType(ObjectType, NOTHING, NOTHING, NOTHING,
                <NameDescInfo>{"name": "XML " + local_name, "display_name": "XML " + local_name,
                 "short_desc": "Complete XML element with retained values and namespace context",
                 "desc": "Accepts a complete XML element as `XsdXmlValue`, preserving lexical values, namespace "
                    "bindings and ordered content after schema checks."}) {
        schema_owner = schema;
        element_namespace = namespace_uri;
        element_name = local_name;
        initValidation();
    }

    private:internal deserializeMembers(hash<auto> members) {
        if (!(members.schema_owner instanceof XsdSchema) || members.element_namespace.typeCode() != NT_STRING
                || members.element_name.typeCode() != NT_STRING) {
            throw "DESERIALIZATION-ERROR", "an XML provider type requires a schema and an expanded element name";
        }
        schema_owner = members.schema_owner;
        element_namespace = members.element_namespace;
        element_name = members.element_name;
        initValidation();
    }

    private initValidation() {
        *XsdElement declaration = schema_owner.getElement(element_namespace, element_name);
        if (!declaration) {
            throw WSDL_ERROR, sprintf("no global element declaration %Y", type_qname(element_namespace, element_name));
        }
        element = declaration;
        namespaces = schema_owner.nsc;
        types = schema_owner.getTypeMap();
    }

    #! validates and retains an explicit XML value
    /** @param value the retained XML element
        @return the same immutable XsdXmlValue after validation, or NOTHING for an omitted optional value
        @throw RUNTIME-TYPE-ERROR the supplied value is not XsdXmlValue
        @throw SOAP-SERIALIZATION-ERROR wrong root or rejected XML/schema content
    */
    auto acceptsValue(auto value) {
        # Honor optional/mandatory copies and their base metadata before checking the XML carrier.
        value = QoreDataType::acceptsValue(value);
        if (!exists value) {
            return;
        }
        if (!(value instanceof XsdXmlValue)) {
            throw "RUNTIME-TYPE-ERROR", sprintf("XML element %Y requires XsdXmlValue; got %s",
                element.getExpandedName(), value.type());
        }
        element.validateXmlValue(value, namespaces, types);
        return value;
    }
}

#! provider type enforcing attribute-use presence independently of the scalar type
/** Attribute uses can be required even when their scalar representation accepts NOTHING, for example
    \c anySimpleType or a union. This type preserves the scalar conversion while enforcing that requirement.

    @since %WSDL 0.5.8

    @par Example
    A required invoice currency attribute remains mandatory even when its schema omits an explicit type.
    Optional boolean attributes keep XSD boolean conversion, so the string \c "false" remains false.
*/
public class XsdAttributeDataType inherits QoreDataType {
    private {
        AbstractDataProviderType value_type;
        bool required;
    }

    #! wraps a scalar provider type with the attribute use's requiredness
    /** @param value_type provider type used to convert supplied values
        @param required whether the attribute use requires a supplied value
    */
    constructor(AbstractDataProviderType value_type, bool required)
            : QoreDataType(required ? (value_type.getValueType() ?? AutoType)
                : (value_type.getValueType() ?? AutoType).getOrNothingType()) {
        self.value_type = value_type;
        self.required = required;
    }

    #! returns whether the attribute must be supplied
    /** @return the requiredness of the attribute use */
    bool isMandatory() {
        return required;
    }

    #! returns whether the attribute can be omitted
    /** @return True for optional attribute uses */
    bool isOrNothingType() {
        return !required;
    }

    #! converts a supplied value after checking attribute presence
    /** @param value the caller's attribute value
        @return the converted value, or NOTHING for an omitted optional attribute
        @throw MISSING-VALUE-ERROR a required attribute was omitted
        @throw RUNTIME-TYPE-ERROR the scalar provider type rejects the value
    */
    auto acceptsValue(auto value) {
        if (!exists value) {
            if (required) {
                throw "MISSING-VALUE-ERROR", "A required XML attribute must be supplied";
            }
            return;
        }
        return value_type.acceptsValue(value);
    }

    #! returns an optional equivalent without modifying this type
    /** @return an equivalent type accepting omitted values */
    AbstractDataProviderType getOrNothingType() {
        return required ? new XsdAttributeDataType(value_type, False) : self;
    }

    #! returns a mandatory equivalent without modifying this type
    /** @return an equivalent type requiring a supplied value */
    AbstractDataProviderType getMandatoryType() {
        return required ? self : new XsdAttributeDataType(value_type, True);
    }

    #! returns the item type for list-valued attributes
    /** @return the scalar provider's element type, or NOTHING */
    *AbstractDataProviderType getElementType() {
        return value_type.getElementType();
    }
}

#! provider type for the scalar and structured representations of attributed simple content
/** Scalar inputs keep their scalar representation when all attributes are optional. Hash inputs use
    \c ^value^ and \c ^attributes^ and are validated as that structure without a scalar fallback.

    @since %WSDL 0.5.8
*/
public class XsdSimpleContentDataType inherits AbstractDataProviderType {
    private {
        string name;
        QoreDataField value_field;
        HashDataType structured_type;
        bool allow_scalar;
        bool optional;
    }

    #! constructs the two supported representations of attributed simple content
    /** @param name schema type name
        @param value_field scalar field with its conversion and finite choices
        @param structured_type fields for the existing structured representation
        @param allow_scalar whether scalar inputs can omit all attributes
        @param optional whether the complete value may be omitted
    */
    constructor(string name, QoreDataField value_field, HashDataType structured_type, bool allow_scalar,
            bool optional = False) {
        self.name = name;
        self.value_field = value_field;
        self.structured_type = structured_type;
        self.allow_scalar = allow_scalar;
        self.optional = optional;
    }

    #! returns the schema type name
    /** @return the name supplied at construction */
    string getName() {
        return name;
    }

    #! returns the Qore representation shared by the supported alternatives
    /** @return AutoType when scalar inputs are supported; otherwise the appropriate hash type */
    *Type getValueType() {
        return allow_scalar ? AutoType : (optional ? AutoHashOrNothingType : AutoHashType);
    }

    #! returns whether the complete value must be supplied
    /** @return False only for an optional variant */
    bool isMandatory() {
        return !optional;
    }

    #! returns whether the complete value may be omitted
    /** @return True only for an optional variant */
    bool isOrNothingType() {
        return optional;
    }

    #! returns no outer list element type
    /** @return NOTHING; list-valued simple content is described by the scalar field */
    *AbstractDataProviderType getElementType() {
        return;
    }

    #! returns the fields of the structured representation
    /** @return the ^value^ and ^attributes^ fields */
    *hash<string, AbstractDataField> getFields() {
        return structured_type.getFields();
    }

    #! returns the input type names for the supported alternatives
    /** @param simple request simplified type names
        @return accepted scalar/hash type names and optionality
    */
    hash<string, bool> getAcceptTypeHash(*bool simple) {
        hash<string, bool> rv = structured_type.getAcceptTypeHash(simple);
        if (allow_scalar) {
            rv += value_field.getType().getAcceptTypeHash(simple);
        }
        if (optional) {
            rv.nothing = True;
        } else {
            delete rv.nothing;
        }
        return rv;
    }

    #! returns the output type names for the supported alternatives
    /** @param simple request simplified type names
        @return returned scalar/hash type names and optionality
    */
    hash<string, bool> getReturnTypeHash(*bool simple) {
        hash<string, bool> rv = structured_type.getReturnTypeHash(simple);
        if (allow_scalar) {
            rv += value_field.getType().getReturnTypeHash(simple);
        }
        if (optional) {
            rv.nothing = True;
        } else {
            delete rv.nothing;
        }
        return rv;
    }

    #! converts the selected representation without changing its shape
    /** @param value a scalar or a hash with a ^value^ member and optional ^attributes^
        @return the converted scalar, converted hash, or NOTHING for an omitted optional value
        @throw MISSING-VALUE-ERROR a required value or attribute container is omitted
        @throw RUNTIME-TYPE-ERROR invalid structured fields or scalar conversion
        @throw FIELD-VALUE-ERROR the scalar value violates its finite choices
    */
    auto acceptsValue(auto value) {
        if (!exists value) {
            if (optional) {
                return;
            }
            throw "MISSING-VALUE-ERROR", sprintf("Simple-content value %Y must be supplied", name);
        }
        if (value.typeCode() == NT_HASH) {
            if (!value.hasKey("^value^")) {
                throw "MISSING-VALUE-ERROR", sprintf("Structured simple content %Y requires a ^value^ field", name);
            }
            return structured_type.acceptsValue(value);
        }
        if (!allow_scalar) {
            throw "MISSING-VALUE-ERROR", sprintf("Simple content %Y requires an ^attributes^ field", name);
        }
        return value_field.acceptsValue(value);
    }

    #! returns an optional equivalent without weakening requirements of a supplied hash
    /** @return an optional variant sharing the field definitions */
    AbstractDataProviderType getOrNothingType() {
        return optional ? self : new XsdSimpleContentDataType(name, value_field, structured_type, allow_scalar, True);
    }

    #! returns a mandatory equivalent without changing the source type
    /** @return a mandatory variant sharing the field definitions */
    AbstractDataProviderType getMandatoryType() {
        return optional ? new XsdSimpleContentDataType(name, value_field, structured_type, allow_scalar) : self;
    }
}

# Per-thread traversal state exists only for the dynamic extent of one union operation.
# Nested calls with different values use independent state and restore their caller's context.
hashdecl XsdUnionTrialResult {
    bool accepted;
    auto value;
    *hash<XsdUnionValueIdentity> identity;
    *string lexical;
    # The selected leaf member controls normalization before union-owned patterns.
    *string white_space;
    bool owner = False;
}

class XsdUnionTrialContext {
    public {
        auto input;
        hash<string, bool> active();
        hash<string, hash<XsdUnionTrialResult>> results();
    }
    constructor(auto input) {
        self.input = input;
    }
}

class XsdUnionInputHelper {
    static bool sameInput(auto left, auto right) {
        if (left.typeCode() != right.typeCode()) {
            return False;
        }
        switch (left.typeCode()) {
            case NT_NUMBER:
                if (left.prec() != right.prec()) {
                    return False;
                }
                # fall through: NaN is a stable input, and signed zero retains its lexical distinction
            case NT_FLOAT:
                if (left.nanp() || right.nanp()) {
                    return left.nanp() && right.nanp();
                }
                return left === right && (left != 0 || left.toStringRoundTrip() == right.toStringRoundTrip());
            case NT_LIST:
                if (left.size() != right.size()) {
                    return False;
                }
                foreach auto item in (left) {
                    if (!sameInput(item, right[$#])) {
                        return False;
                    }
                }
                return True;
            case NT_HASH:
                if (left.size() != right.size()) {
                    return False;
                }
                foreach string key in (keys left) {
                    if (!right.hasKey(key) || !sameInput(left{key}, right{key})) {
                        return False;
                    }
                }
                return True;
            case NT_DATE:
                return left === right && left.toString() == right.toString();
        }
        return left === right;
    }
}

hashdecl XsdUnionValueIdentity {
    string family;
    auto value;
}

#! Builtin value metadata retained by a union provider
/** Contains the builtin spelling rules and corresponding provider without retaining the source schema.
    Builtin NMTOKENS, IDREFS and ENTITIES use this descriptor for their text representation and ordered list identity.
    @since %WSDL 0.5.8
*/
public hashdecl XsdUnionAtomicInfo {
    #! Builtin local name
    string builtin;
    #! Effective XML whitespace rule
    string white_space;
    #! Whether an inherited pattern requires the accepted spelling
    bool preserve_lexical;
    #! Member provider identity, absent for schema-only value comparisons
    *AbstractDataProviderType provider;
}

#! List member value metadata retained by a union provider
/** Describes each atomic item's primitive value without retaining the source schema.
    @since %WSDL 0.5.8
*/
public hashdecl XsdUnionListInfo {
    #! Primitive conversion and restrictions when the item type is atomic
    *hash<XsdUnionAtomicInfo> item;
    #! Whether each item selects a member of an atomic union; excludes \c item metadata
    bool union_items = False;
    #! Member provider identity, absent for schema-only value comparisons
    *AbstractDataProviderType provider;
}

# Retain the actual item's selected value; a second conversion could call custom
# validators again or choose a different member after native conversion.
class XsdSchemaUnionItemCapture {
    public {
        XsdAbstractType target;
        *hash<XsdUnionValueIdentity> identity;
    }
    constructor(XsdAbstractType target) {
        self.target = target;
    }
}

class XsdProviderUnionItemCapture {
    public {
        AbstractDataProviderType target;
        list<hash<XsdUnionTrialResult>> items();
        int depth = 0;
    }
    constructor(AbstractDataProviderType target) {
        self.target = target;
    }
}

thread_local *XsdSchemaUnionItemCapture SchemaUnionItemCapture;
thread_local *XsdSchemaUnionItemCapture SchemaUnionListCapture;
thread_local *XsdProviderUnionItemCapture ProviderUnionItemCapture;

# Value comparison is separate from native input identity. Integer and decimal
# members share a value space; boolean and string values remain distinct from it.
class XsdUnionValueHelper {
    const StringFamily = {"string": True, "normalizedString": True, "token": True, "language": True,
        "Name": True, "NCName": True, "NMTOKEN": True, "ID": True, "IDREF": True, "ENTITY": True};

    static bool supports(string builtin) {
        return XsdNumericFacetHelper::isType(builtin) || builtin == "boolean" || builtin == "duration" || builtin == "hexBinary"
            || builtin == "base64Binary" || StringFamily{builtin} || XsdBuiltinListHelper::isType(builtin)
            || XsdCalendarLexicalHelper::isType(builtin);
    }

    # Returns exact identities for the scalar families with completed value rules.
    # Other kinds are described by their own datatype conversion paths.
    static *hash<XsdUnionValueIdentity> atomicIdentity(XsdAbstractType member, auto input, auto converted,
            string error) {
        *hash<XsdUnionAtomicInfo> info = describeAtomic(member);
        return info ? atomicIdentity(info, input, converted, error) : NOTHING;
    }

    static auto serializeInput(XsdAbstractType member, auto input) {
        if (input.typeCode() == NT_STRING) {
            *hash<XsdUnionAtomicInfo> info = describeAtomic(member);
            if (info && XsdBinaryLexicalHelper::isType(info.builtin)) {
                # Union strings retain XML lexical values for member reselection.
                # Explicitly distinguish them from atomic binary serializer raw strings.
                string lexical = XsdBinaryLexicalHelper::lexical(info.builtin, input, SOAP_SERIALIZATION_ERROR);
                return new XsdBinaryValue(info.builtin, lexical);
            }
        }
        return input;
    }

    static *XsdSimpleType listType(XsdAbstractType member) {
        hash<string, bool> visited();
        while (member instanceof XsdSimpleType) {
            if (Class::getClass(member).getPathName() != "WSDL::XsdSimpleType") {
                return;
            }
            string key = member.uniqueHash();
            if (visited{key}) {
                throw "XSD-SIMPLETYPE-ERROR", "cyclic union list member metadata";
            }
            visited{key} = True;
            XsdSimpleType simple = cast<XsdSimpleType>(member);
            if (simple.listItemType) {
                return simple;
            }
            if (!simple.type) {
                return;
            }
            member = simple.type;
        }
    }

    static *hash<XsdUnionListInfo> describeList(XsdAbstractType member, *AbstractDataProviderType provider) {
        *XsdSimpleType list = listType(member);
        if (!list) {
            return;
        }
        if (schemaUnionItem(list.listItemType)) {
            return <XsdUnionListInfo>{"union_items": True, "provider": provider};
        }
        *hash<XsdUnionAtomicInfo> item = describeAtomic(list.listItemType,
            provider ? provider.getElementType() : NOTHING);
        return item ? <XsdUnionListInfo>{"item": item, "provider": provider} : NOTHING;
    }

    static bool schemaUnionItem(XsdAbstractType item) {
        hash<string, bool> visited();
        while (item instanceof XsdSimpleType) {
            if (Class::getClass(item).getPathName() != "WSDL::XsdSimpleType") {
                return False;
            }
            string key = item.uniqueHash();
            if (visited{key}) {
                throw "XSD-SIMPLETYPE-ERROR", "cyclic list item union metadata";
            }
            visited{key} = True;
            XsdSimpleType simple = cast<XsdSimpleType>(item);
            if (simple.unionTypes) {
                return True;
            }
            if (!simple.type) {
                return False;
            }
            item = simple.type;
        }
        return False;
    }

    static auto listInput(auto value, string error, *hash<XsdUnionListInfo> info) {
        value = XsdScalarTextHelper::value(value, error);
        if (info && value.typeCode() == NT_LIST) {
            foreach auto item in (value) {
                if (!exists item) {
                    throw error, "an XSD list cannot contain an omitted item";
                }
                if (info.item && item.typeCode() == NT_STRING) {
                    XsdListValueHelper::checkToken(XsdSimpleType::normalizeWhiteSpace(item, info.item.white_space),
                        error);
                }
            }
        }
        return value.typeCode() == NT_STRING ? XsdListValueHelper::tokens(value) : value;
    }

    static hash<XsdUnionValueIdentity> listIdentity(hash<XsdUnionListInfo> info, auto input, auto converted,
            string error) {
        input = listInput(input, error);
        if (input.typeCode() != NT_LIST) {
            input = exists input ? (input,) : ();
        }
        converted = listInput(converted, error);
        list<string> values();
        foreach auto item in (input) {
            hash<XsdUnionValueIdentity> identity = atomicIdentity(info.item, item,
                converted.typeCode() == NT_LIST ? converted[$#] : converted, error);
            push values, key(identity);
        }
        return <XsdUnionValueIdentity>{"family": "list", "value": values};
    }

    static *hash<XsdUnionValueIdentity> schemaListIdentity(hash<XsdUnionListInfo> info, XsdAbstractType member,
            auto input, auto converted, string error, hash<string, hash<XsdUnionValueIdentity>> identities) {
        if (info.union_items) {
            *XsdSimpleType list = listType(member);
            @assert(list);
            return identities{list.uniqueHash()};
        }
        return listIdentity(info, input, converted, error);
    }

    static string listLexical(hash<XsdUnionListInfo> info, list<auto> converted) {
        list<string> tokens();
        foreach auto item in (converted) {
            string token = item.typeCode() == NT_STRING
                ? XsdSimpleType::normalizeWhiteSpace(item, info.item.white_space) : lexical(info.item, item);
            XsdListValueHelper::checkToken(token, "RUNTIME-TYPE-ERROR");
            push tokens, token;
        }
        return tokens.join(" ");
    }

    static *hash<XsdUnionValueIdentity> capturedIdentity(list<*hash<XsdUnionValueIdentity>> identities) {
        list<string> values();
        foreach *hash<XsdUnionValueIdentity> identity in (identities) {
            if (!identity) {
                return;
            }
            push values, key(identity);
        }
        return <XsdUnionValueIdentity>{"family": "list", "value": values};
    }

    static hash<XsdUnionTrialResult> capturedList(list<hash<XsdUnionTrialResult>> items, auto converted) {
        if (converted.typeCode() != NT_LIST || items.size() != converted.size()) {
            throw "RUNTIME-TYPE-ERROR", "a union list must produce one atomic conversion per item";
        }
        list<string> tokens();
        bool known_lexical = True;
        foreach hash<XsdUnionTrialResult> item in (items) {
            if (!exists item.value || (!item.value.strp() && item.value.typeCode() != NT_BINARY
                    && !(item.value instanceof XsdBinaryValue))) {
                throw "RUNTIME-TYPE-ERROR", "a list item union must produce an atomic value";
            }
            *string token = item.value.typeCode() == NT_STRING ? item.value : item.lexical;
            if (exists token) {
                XsdListValueHelper::checkToken(token, "RUNTIME-TYPE-ERROR");
                push tokens, token;
            } else {
                known_lexical = False;
            }
        }
        return <XsdUnionTrialResult>{"accepted": True, "value": converted,
