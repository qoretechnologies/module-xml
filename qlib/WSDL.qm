            # parse xs:attributeGroup definitions
            foreach hash<auto> ag in (schema.attributeGroup) {
                XsdAttributeGroup attrGrp(ag, nsc, unresolved);
                string qualifiedName = type_qname(attrGrp.nsUri, attrGrp.name);
                if (attrGroupMap{qualifiedName}) {
                    throw WSDL_ERROR, sprintf("%s: attributeGroup %y declared twice", nph.getDesc(), qualifiedName);
                }
                attrGroupMap{qualifiedName} = attrGrp;
                if (!attrGrp.nsUri) {
                    attrGroupMap{attrGrp.name} = attrGrp;
                }
            }
            # make element map
            foreach hash<auto> el in (schema.element) {
                XsdElement element(el, nsc, NOTHING, unresolved, usedocns, True);
                # Global element names always belong to the target namespace; elementFormDefault
                # was passed to the constructor for local declarations in an anonymous type.
                element.usedocns = boolean(element.ns);

                if (emap{element.ns}{element.name}) {
                    throw WSDL_ERROR, sprintf("%s: element %y declared twice in namespace %y", nph.getDesc(), element.name, element.ns);
                }
                emap{element.ns}{element.name} = element;
                #printf("DEBUG: added element %s -> %s\n", element.ns, element.name);
            }
        }

        if (resolver) {
            return;
        }
        finalizeTypes(unresolved);
    }

    private finalizeTypes(XsdLateResolverHelper unresolved) {
        on_exit {
            resolving_simple = {};
            resolved_simple = {};
            valid_list_items = {};
            union_definitions = {};
        }
        # Resolve only after every document has contributed its declarations, allowing dependency cycles.
        nsc.setNotations(notationMap);
        list<XsdElement> global_declarations = resolveElementDeclarations();
        map resolveType($1), unresolved.getList();
        unresolved.clearResolved();

        # Undefined/cyclic groups are errors even when no complex type references them.
        map $1.resolveNestedGroups(groupMap), groupMap.iterator();
        map $1.resolveNestedGroups(attrGroupMap, nsc), attrGroupMap.iterator();

        # finalize complex types with group resolution
        map cast<XsdComplexType>($1).finalize(tmap, nsc, groupMap, attrGroupMap, unresolved), tmap.iterator(), $1 instanceof XsdComplexType;

        # finalize array types
        map cast<XsdArrayType>($1).finalize(tmap, nsc, groupMap, attrGroupMap, unresolved), tmap.iterator(), $1 instanceof XsdArrayType;

        map (map cast<XsdComplexType>($1.type).finalize(tmap, nsc, groupMap, attrGroupMap, unresolved), $1.iterator(), $1.type instanceof XsdComplexType), emap.iterator();

        # Nested anonymous simple-content types are not necessarily entries in tmap or emap.
        map cast<XsdComplexType>($1).finalize(tmap, nsc, groupMap, attrGroupMap, unresolved), unresolved.getList(),
            $1 instanceof XsdComplexType;

        map resolveType($1), unresolved.getList();
        unresolved.validateNotationUses();
        unresolved.validateElementConstraints();
        resolveElementSubstitutionGroups(global_declarations);
        # Membership can change existing content models during an incremental addition.
        validateSubstitutionParticles(global_declarations);
        unresolved.publishIdentityConstraints(nsc);
        nsc.setGlobalAttributes(attributeMap);
        nsc.setGlobalElements(emap, tmap);
    }
}

#! main class representing a parsed WSDL file
/** This is the main class for handling SOAP communication and is based on a WSDL file

The document root must be WSDL 1.1 definitions. Named declarations use XML NCNames; duplicate messages,
port types, bindings and services reject instead of overwriting earlier components. Parts and ports have
separate name scopes in each owner. Empty port types and services remain available through lookup and reports.
Component references use their declaration's namespace context and must identify the required component kind.
An unprefixed reference uses the default namespace; targetNamespace is not an implicit default.

@par Thread Safety
This class is designed to be thread-safe for read operations once constructed. Multiple threads
can safely use the same WebService object for SOAP serialization and deserialization operations.
However, the class should not be modified after construction in a multi-threaded context.

@par Usage Example
@code{.py}
WebService ws(wsdl_string, {"def_path": "/path/to/schemas"});
# Get all available operations
list<string> ops = ws.listOperations();
# Serialize a SOAP request
hash<auto> msg = ws.serializeRequest(op_name, args);
@endcode
*/
public class WebService inherits WSDL::XsdSchema {
    public {
        #! the WSDL string
        string wsdl;

        #! a cryptographic hash for the WSDL source
        string wsdl_hash;

        #! the name of the WebService
        /** @since %WSDL 0.5
        */
        string name;

        #! cached digest of the retained WSDL and schema source graph
        /** @since %WSDL 0.5
        */
        string hash_str;

        #! list of services in this WSDL
        transient list<string> wsdl_services();

        #! a hash of element names to XsdElement objects for top-level document-style bindings
        transient hash<string, XsdElement> idocmap();

        #! hash of messages names to messages
        transient hash<string, WSMessage> messages();

        #! hash of port names to port type information hashes
        transient hash<string, hash<PortTypeInfo>> portType();
    }

    private {
        hash<string, string> wsdl_dependencies();
        transient hash<string, string> component_keys();

        # service definitions; name -> service info hash
        hash<string, hash<WSDL::ServiceInfo>> services();

        # service bindings; name -> Binding
        hash<string, Binding> binding();
    }

    #! creates the WebService object
    /** @param str the XML string representing the WSDL
        @param opts an optional hash of options with the following possible keys:
        - \c "compat_allow_any_header": allow any SOAP header to be sent without checking the WSDL
        - \c "compat_empty_string_is_nothing": deserialize empty strings to \c NOTHING instead of an empty string
        - \c "document_location": full URI of the containing document; file and URL loaders set this automatically
        - \c "resource_locations": flat hash mapping requested and redirect-hop URIs to final retrieval URIs;
          retained with source bytes for offline reconstruction
        - \c "def_path": the default path to use when retrieving referenced XSDs
        - \c "try_import": a callback for WSDL and XSD references whose resolved locations have no scheme;
          takes the original reference string from the importing document and returns its XML source
          bytes. Saved dependencies and asynchronous cache entries take precedence over the callback
        - \c "http_client": a HTTPClient object for retrieving data from import commands
        - \c "http_headers": a hash of optional HTTP header info to use when retrieving data from import commands
        - \c "xsd_cache": resolved WSDL or schema locations mapped to cached XML source for async parsing
        - \c "async_only": if @ref True then external imports must be satisfied by \c "xsd_cache" and no blocking
          I/O is performed

        @since 0.3.7 added the \c "compat_empty_string_is_nothing" and \c "compat_allow_any_header" options for backwards compatibility
    */
    constructor(string str, *hash<auto> opts) {
        doInit(str, opts);
    }

    #! returns the name of the service
    /** @return the name of the service

        @since %WSDL 0.5
    */
    string getName() {
        return name;
    }

    #! returns a fingerprint of the retained WSDL and schema sources
    /** @return a SHA-256 fingerprint including imported source locations and bytes, redirect aliases and added schemas
        @note Root-only services without aliases retain their original SHA-256 source digest. This is a source fingerprint;
        different compatibility options can interpret the same sources differently.
        @par Example
        @code{.py}
        bool dependencies_changed = previous.getHash() != current.getHash();
        @endcode

        @since %WSDL 0.5
    */
    synchronized string getHash() {
        if (!hash_str) {
            string root_hash = digest("sha256", wsdl).toHex();
            if (!wsdl_dependencies && !schema_dependencies && !schema_sources && !resource_locations) {
                hash_str = root_hash;
            } else {
                list<string> pieces = (root_hash,);
                foreach string key in (sort(keys wsdl_dependencies)) {
                    push pieces, sprintf("wsdl:%Y:%s", key, wsdl_dependencies{key}.toSHA512());
                }
                foreach string key in (sort(keys schema_dependencies)) {
                    push pieces, sprintf("xsd:%Y:%s", key, schema_dependencies{key}.toSHA512());
                }
                foreach string key in (sort(keys resource_locations)) {
                    push pieces, sprintf("alias:%Y:%Y", key, resource_locations{key});
                }
                foreach hash<XsdSourceInfo> source in (schema_sources) {
                    push pieces, sprintf("added:%Y:%Y:%s", source.base, source.location, source.xml.toSHA512());
                }
                hash_str = digest("sha256", join("", pieces)).toHex();
            }
        }
        return hash_str;
    }

    #! returns an operation, searching port types in declaration order
    /** @param opname a unique XML operation name or an overloaded key from getOperationNames()
        @return the matching operation from the first applicable port type
        @throw WSDL-OPERATION-ERROR the operation is unknown or the bare name is ambiguous within that port type
        @par Example
        Select a partner lookup with getOperation("lookup(ById,ResultId)").
    */
    WSDL::WSOperation getOperation(string opname) {
        @assert(opname, "operation name is required");
        foreach hash<PortTypeInfo> pt in (portType.iterator()) {
            *WSOperation op = WsdlOperationLookup::find(pt, opname);
            if (op) {
                return op;
            }
        }
        throw "WSDL-OPERATION-ERROR", sprintf("cannot retrieve operation %y; known operations: %y", opname,
            (foldl $1 + $2, (map $1.operations.keys(), portType.iterator())));
    }

    #! returns operation lookup keys in declaration order
    /** @return unique XML names and name(input,output) keys for overloaded declarations
        @note Input/output slots use effective WSDL labels; an absent message has an empty slot.
    */
    softlist<string> getOperationNames() {
        return foldl $1 + $2, (map keys $1.operations, portType.iterator());
    }

    #! returns the given operation for a particular port type
    /** @param ptname a unique local name or expanded name in \c "{namespace}local" form
        @param opname a unique operation name or an overloaded name(input,output) key within the port type
        @return the operation declaration
        @throw WSDL-OPERATION-ERROR the port type or operation is unknown, or the bare name is ambiguous
    */
    WSDL::WSOperation getPortTypeOperation(string ptname, string opname) {
        @assert(ptname, "port type name is required");
        @assert(opname, "operation name is required");
        ptname = component_keys{"portType:" + ptname} ?? ptname;
        if (!portType{ptname}) {
            throw "WSDL-OPERATION-ERROR", sprintf("port %y is not a defined port; known ports: %y", ptname, portType.keys());
        }
        *WSOperation op = WsdlOperationLookup::find(portType{ptname}, opname);
        if (op) {
            return op;
        }
        throw "WSDL-OPERATION-ERROR", sprintf("operation %y is not known in port %y; known operations: %y", opname, ptname, portType{ptname}.operations.keys());
    }

    #! returns an operation declared by the selected binding
    /** @param bname a binding component key or expanded name; NOTHING retains global operation lookup
        @param opname an operation name or an overloaded name(input,output) key in the binding's port type
        @return the operation after verifying its association with the selected binding
        @throw WSDL-BINDING-ERROR the binding is unknown or does not bind the operation
        @throw WSDL-OPERATION-ERROR the operation is unknown, or multiple bound overloads match the bare name
        @note Binding membership is applied before deciding whether a bare overloaded name is ambiguous.
        @par Example
        @code{.py}
            WSOperation submit = service.getBindingOperation("OrdersSoap", "submit");
        @endcode
    */
    WSDL::WSOperation getBindingOperation(*string bname, string opname) {
        @assert(opname, "operation name is required");
        if (!exists bname) {
            return getOperation(opname);
        } else {
            WSDL::Binding b = getBinding(bname);
            @assert(b, "binding %y must exist", bname);
            hash<PortTypeInfo> pt = portType{b.getPort()};
            if (!pt.operations.hasKey(opname) && !pt.operation_candidates.hasKey(opname)) {
                throw "WSDL-OPERATION-ERROR", sprintf("operation %Y is unknown in port type %Y", opname, b.getPort());
            }
            *WSOperation op = WsdlOperationLookup::find(pt, opname, NOTHING, NOTHING, b.getComponentKey());
            if (!op) {
                throw "WSDL-BINDING-ERROR", sprintf("binding %Y does not bind operation %Y", bname, opname);
            }
            return op;
        }
    }

    #! returns a list of hashes giving supported operation names for each port in the WSDL
    /** @return a list of hashes giving supported operation names for each port in the WSDL; each hash<auto> has the following keys:
        - \c "port": the name of the port defining the operation
        - \c "operation": the @ref WSDL::WSOperation object for the operation
     */
    list<hash<OperationInfo>> listOperations() {
        list<hash<OperationInfo>> l();
        foreach hash<auto> ph in (portType.pairIterator()) {
            foreach WSOperation op in (ph.value.operations.iterator()) {
                l += cast<hash<OperationInfo>>((
                    "port": ph.key,
                    "operation": op,
                ));
            }
        }
        return l;
    }

    #! return a @ref WSDL::Binding object describing the requested binding
    /** @param name a unique local binding name or expanded name in \c "{namespace}local" form

        @return a @ref WSDL::Binding object

        @throw WSDL-BINDING-ERROR unknown binding
     */
    WSDL::Binding getBinding(string name) {
        *Binding b = binding{component_keys{"binding:" + name} ?? name};
        if (!b)
            throw "WSDL-BINDING-ERROR", sprintf("binding %y is not a known binding; known bindings: %y", name, binding.keys());
        return b;
    }

    #! returns a list of services defined in the WSDL
    /** @return a list of hashes of services defined in the WSDL; each hash<auto> has the following keys:
        - \c "name": the name of the service
        - \c "port": a hash of port information; the keys are port names and the values have the following keys:
          - \c "address": the location of the port
          - \c "binding": the binding of the port
     */
    list<hash<WSDL::ServiceInfo>> listServices() {
        return map cast<hash<WSDL::ServiceInfo>>($1), services.iterator();
        #return cast<list<hash<WSDL::ServiceInfo>>>(services.values());
    }

    #! returns a hash describing the requested service
    /** @param name a unique local service name or expanded name in \c "{namespace}local" form
        @return a hash describing the service with the following keys:
        - \c "name": the name of the service
        - \c "port": a hash of port information; where each hash<auto> is keyed by port name and the values have the following keys:
          - \c "address": the location of the port
          - \c "binding": the binding of the port

        @throw WSDL-SERVICE-ERROR the service is not known
     */
    hash<WSDL::ServiceInfo> getService(string name) {
        *hash<WSDL::ServiceInfo> h = services{component_keys{"service:" + name} ?? name};
        if (!h)
            throw "WSDL-SERVICE-ERROR", sprintf("service %y is not a known service; known services: %y", name, services.keys());
        return h;
    }

    #! returns a message by its component name
    /** @param name a unique local name or expanded name in \c "{namespace}local" form
        @return the corresponding message declaration
        @throw WSDL-MESSAGE-ERROR the name is unknown or its local name is ambiguous
        @par Example
        @code{.py}
        WSMessage request = service.getMessage("{urn:orders}OrderRequest");
        @endcode
        @since %WSDL 0.5.8
    */
    WSMessage getMessage(string name) {
        *WSMessage message = messages{component_keys{"message:" + name} ?? name};
        if (!message) {
            throw "WSDL-MESSAGE-ERROR", sprintf("message %Y is not a known message; known messages: %Y",
                name, keys messages);
        }
        return message;
    }

    private parseMessages(*softlist<auto> message, WsdlComponentRegistry registry) {
        # parse messages
        foreach hash<auto> m in (message) {
            WSMessage msg(m, emap, tmap, nsc);
            foreach string arg in (keys msg.args) {
                #printf("DEBUG: WebService::parseMessages(): %y: %y\n", arg, msg);
                #printf("DEBUG: WebService::parseMessages(): %y: %y\n", arg, msg.args{arg}.type);
                if (exists msg.args{arg}.type && !(msg.args{arg}.type instanceof XsdData))
                    msg.args{arg}.type = resolveType(msg.args{arg}.type);
            }
            messages{registry.key("message", nsc.getTargetNamespaceUri(), msg.name)} = msg;
        }
    }

    private parseService(*softlist<auto> svcs, WsdlComponentRegistry registry) {
        foreach hash<auto> svc in (svcs) {
            NamespacePrefixHelper service_scope(nsc, svc."^attributes^");
            WSDL::XsdBase::removeNS(\svc);
            string svcname = registry.key("service", nsc.getTargetNamespaceUri(), svc."^attributes^".name);
            # Empty services are valid named components too.
            services{svcname} = <ServiceInfo>{"name": svcname, "port": {}};
            foreach hash<auto> port in (svc.port) {
                NamespacePrefixHelper port_scope(nsc, port."^attributes^");
                WSDL::XsdBase::removeNS(\port);
                hash<auto> pa = port."^attributes^";
                string name = pa.name;

                if (!pa.binding)
                    throw WSDL_ERROR, sprintf("service %y port %y has no binding", svcname, name);
                string bind = registry.resolve("binding", pa.binding, nsc);
                if (!bind)
                    throw WSDL_ERROR, sprintf("cannot parse service %y port %y binding: %y", svcname, name, pa.binding);

                if (!binding{bind})
                    throw WSDL_ERROR, sprintf("service %y port %y refers to non-existant binding %y; known bindings: %y", svcname, name, bind, binding.keys());

                # add the port to the service
                services{svcname}.port{name} = pa + (
                    "address": port.address."^attributes^".location,
                    "binding": binding{bind},
                );
            }
        }
    }

    private parsePortType(*softlist<auto> data, WsdlComponentRegistry registry) {
        # setup list of services defined in this WSDL
        foreach hash<auto> port in (data) {
            NamespacePrefixHelper port_scope(nsc, port."^attributes^");
            WSDL::XsdBase::removeNS(\port);
            #printf("DEBUG: portType: %y\n", port);
            string name = registry.key("portType", nsc.getTargetNamespaceUri(), port."^attributes^".name);
            wsdl_services += name;
            portType{name} = <PortTypeInfo>{"operations": {}};
            hash<string, int> counts();
            foreach hash<auto> p in (port.operation) {
                ++counts{p."^attributes^".name};
            }
            hash<string, bool> signatures();
            foreach hash<auto> p in (port.operation) {
                WSOperation op(p, nsc, messages, registry, counts{p."^attributes^".name} > 1);
                string signature = op.getSignatureKey();
                if (signatures{signature}) {
                    throw WSDL_ERROR, sprintf("duplicate operation signature %Y in port type %Y", signature, name);
                }
                signatures{signature} = True;
                push portType{name}.operation_candidates{op.name}, op;
                portType{name}.operations{op.getSelectionKey()} = op;
            }
        }
    }

    private parseBinding(*softlist<auto> bindings, WsdlComponentRegistry registry) {
        foreach hash<auto> data in (bindings) {
            WSDL::Binding b(data, nsc, \portType, \idocmap, messages, registry);
            binding{b.getComponentKey()} = b;
        }
    }

    #! returns True if the WSDL declares at least one SOAP 1.2 binding
    /** @return True when an actual binding uses the SOAP 1.2 WSDL extension
        @note An unused SOAP 1.2 namespace declaration does not imply a SOAP 1.2 service.
    */
    bool isSoap12() {
        foreach Binding item in (binding.iterator()) {
            if (item.isSoap12()) {
                return True;
            }
        }
        return False;
    }

    #! returns the XML string for the WSDL
    /** @return the XML string for the WSDL
    */
    string getWSDL() {
        return wsdl;
    }

    #! returns a cryptographic hash for the WSDL source
    /** @return a cryptographic hash for the WSDL source
    */
    string getWSDLHash() {
        return wsdl_hash;
    }

    #! returns the XML string for the WSDL, adjusting the URLs for binding locations depending on the caller
    /** @param base_url the url to be prepended before the service name;
                        it must include all the handler prefixes (like \c /SOAP)
                        to produce valid URL
        @return the XML string for the WSDL
     */
    string getWSDL(string base_url) {
        string wstr = wsdl;

        foreach hash<WSDL::ServiceInfo> sh in (services.iterator()) {
            foreach hash<auto> ph in (sh.port.iterator()) {
                wstr = replace(wstr, ph.address, base_url + "/" + sh.name);
            }
        }

        return wstr;
    }

    private string getOperationParams(WSMessage msg) {
        return sprintf("%s(%s)", msg.name, (foldl $1 + "," + $2, (keys msg.args)));
    }

    #! prepare a WebService report enumerating the services and operations of the WSDL, outputs to the output stream given as the first argument
    /** @param stream the output stream for the report data
        @param wsdl_name name of the WSDL, typically a file name

        @note The human-readable report is written to the supplied stream.
    */
    getReport(StringOutputStream stream, *string wsdl_name) {
        StreamWriter w(stream);
        w.printf("wsdl: %s\n", wsdl_name);
        foreach hash<WSDL::ServiceInfo> svc in (listServices()) {
            w.printf("  service: %s\n", svc.name);
            foreach string port in (keys svc.port) {
                w.printf("    port: %s\n", port);
                w.printf("      binding: %s\n", svc.port{port}.binding.name);
                w.printf("      address: %s\n", svc.port{port}.address);
                hash<auto> pt = portType{svc.port{port}.binding.getPort()};
                w.printf("      operations:\n");
                foreach string name in (keys pt.operations) {
                    WSOperation op = pt.operations{name};
                    w.printf("        %s\n", name);
                    if (op.input) {
                        w.printf("          input: %s\n", getOperationParams(op.input));
                    }
                    if (op.output) {
                        w.printf("          output: %s\n", getOperationParams(op.output));
                    }
                }
            }
        }
    }

    #! prepare a WebService report enumerating the services and operations of the WSDL
    /** @param wsdl_name name of the WSDL, typically a file name

        @return human readable text report
    */
    string getReport(*string wsdl_name) {
        StringOutputStream stream();
        getReport(stream, wsdl_name);
        return stream.getData();
    }

    #! supports the constructor and deserialization
    /** @since %WSDL 0.4
    */
    private Namespaces documentNamespaces(hash<auto> attributes, Namespaces original) {
        Namespaces document_nsc(attributes, original);
        document_nsc.opt_empty_string_is_nothing = original.opt_empty_string_is_nothing;
        document_nsc.opt_allow_any_header = original.opt_allow_any_header;
        return document_nsc;
    }

    private hash<WsdlFetchedDocument> fetchWsdlDependency(string location, string reference) {
        string requested = WSDLLib::normalizeLocation(location, "file", NOTHING);
        string key = resource_locations{requested} ?? requested;
        string source;
        if (key == document_location) {
            source = wsdl;
        } else if (exists wsdl_dependencies{key}) {
            source = wsdl_dependencies{key};
        } else if (opts.xsd_cache && exists opts.xsd_cache{key}) {
            source = opts.xsd_cache{key};
        } else if (opts.xsd_cache && exists opts.xsd_cache{requested}) {
            source = opts.xsd_cache{requested};
        } else if (opts.async_only) {
            throw "WSDL-ASYNC-IMPORT", sprintf("missing async WSDL import %Y", key), key;
        } else if (try_import && WsdlFileLocation::isFile(location) && !WSDLLib::hasScheme(reference)) {
            source = call_function(try_import, reference);
        } else {
            *string effective;
            hash<string, string> aliases();
            source = WSDLLib::getFileFromURL(location, "file",
                opts.http_client instanceof HTTPClient ? opts.http_client : NOTHING, opts.http_headers,
                True, NOTHING, NOTHING, \effective, \aliases);
            resource_locations += aliases;
            if (effective && effective != requested) {
                resource_locations{requested} = effective;
                key = effective;
            }
        }
        validateSchemaGrammar(source);
        if ((key == document_location && source != wsdl)
                || (exists wsdl_dependencies{key} && wsdl_dependencies{key} != source)) {
            throw WSDL_ERROR, sprintf("conflicting source bytes for WSDL resource %Y", key);
        }
        if (key != document_location) {
            wsdl_dependencies{key} = source;
        }
        return <WsdlFetchedDocument>{"source": source, "location": key};
    }

    private:internal doInit(string str, *hash<auto> opts) {
        validateSchemaGrammar(str);
        initOptions(opts);
        wsdl = str;
        list<hash<WsdlDocumentInfo>> documents = WsdlDocumentCatalog::load(str, document_location, def_path,
            \fetchWsdlDependency(), resource_locations);
        WsdlComponentRegistry registry(documents);
        component_keys = registry.getKeys();
        foreach hash<WsdlDocumentInfo> document in (documents) {
            validateSchemaGrammar(document.source);
            if (document.schema) {
                # WSDL and XSD imports share the same retained resource bytes.
                @assert(document.resource_key, "an imported schema requires a resource key");
                schema_dependencies{document.resource_key} = document.source;
            }
        }
        hash_str = "";
        wsdl_hash = str.toSHA512();
        hash<auto> root = documents[0].data.definitions;
        name = root.service."^attributes^".name ?? "unnamed-soap-service";
        nsc = new Namespaces(root."^attributes^");
        nsc.opt_empty_string_is_nothing = opts.compat_empty_string_is_nothing
            || global_compat_empty_string_is_nothing;
        nsc.opt_allow_any_header = opts.compat_allow_any_header || global_compat_allow_any_header;
        XsdLateResolverHelper resolver();
        foreach hash<WsdlDocumentInfo> document in (documents) {
            *hash<auto> types = document.schema ? document.data : document.data.definitions.types;
            if (!exists types) {
                continue;
            }
            if (document.schema) {
                string identity = sprintf("%Y:%Y", document.resource_key, document.declarations.target_namespace);
                if (import_map{identity}) {
                    continue;
                }
                import_map{identity} = True;
            }
            Namespaces original = nsc;
            if (document.schema || document.source != str) {
                nsc = documentNamespaces(document.schema ? document.data.schema."^attributes^"
                    : document.data.definitions."^attributes^", original);
            }
            *string original_base = def_path;
            *string original_location = document_location;
            def_path = document.base;
            document_location = document.location;
            on_exit {
                nsc = original;
                def_path = original_base;
                document_location = original_location;
            }
            parseTypes(types, opts.http_client instanceof HTTPClient ? opts.http_client : NOTHING,
                opts.http_headers, resolver);
            if (nsc !== original) {
                original.merge(nsc);
            }
        }
        finalizeTypes(resolver);
        foreach string kind in ("message", "portType", "binding", "service") {
            foreach hash<WsdlDocumentInfo> document in (documents) {
                if (document.schema || !exists document.data.definitions{kind}) {
                    continue;
                }
                Namespaces original = nsc;
                if (document.source != str) {
                    nsc = documentNamespaces(document.data.definitions."^attributes^", original);
                }
                on_exit nsc = original;
                switch (kind) {
                    case "message": parseMessages(document.data.definitions.message, registry); break;
                    case "portType": parsePortType(document.data.definitions.portType, registry); break;
                    case "binding": parseBinding(document.data.definitions.binding, registry); break;
                    case "service": parseService(document.data.definitions.service, registry); break;
                }
            }
        }
    }

    #! adds a schema while keeping message type lookup current
    /** @param xsd an XSD document extending this service's declarations
        @throw XSD-ERROR the XML root is not an XSD schema
        @throw WSDL-ERROR invalid declarations or references
        @note The base schema update is atomic; message maps are refreshed only after it succeeds.
        @since %WSDL 0.5.8
    */
    addSchemaString(string xsd) {
        XsdSchema::addSchemaString(xsd);
        hash_str = "";
        foreach WSMessage message in (messages.iterator()) {
            message.tmap = getTypeMap();
        }
    }

    #! can be used to create a WebService object from a hash created with serialize()
    /** @return a WebService object from the argument hash created with serialize()
    */
    private:internal deserializeMembers(hash<auto> members) {
        # initialize empty transient members
        wsdl_services = ();
        idocmap = {};
        emap = {};
        messages = {};
        tmap = {};
        portType = {};

        wsdl_dependencies = members.wsdl_dependencies ?? {};
        # Options now belong to XsdSchema and have already been restored by its hook.
        # Accept locally stored options from older WebService serializations as well.
        doInit(members.wsdl, members.opts ?? opts);
        restoreSchemaSources();
    }
}

class XsdSampleBudget {
    private { int maximum; }
    public {
        int remaining;
        hash<string, bool> active_types();
    }

    constructor(int maximum) {
        self.maximum = maximum;
        remaining = maximum;
    }

    consume(int count) {
        @assert(count >= 0);
        if (count > remaining) {
            throw "XSD-SAMPLE-ERROR", "generated example exceeds the max_elements budget";
        }
        remaining -= count;
    }

    # Check the converted XML data too: a public override may supply an entire
    # subtree without calling the built-in generator for its children. Scalar
    # list datatypes have already become lexical text at this boundary.
    checkOutput(auto value) {
        list<auto> pending();
        push pending, value;
        int available = maximum;
        while (pending) {
            auto node = pop pending;
            if (node.typeCode() == NT_LIST && node) {
                if (node.size() > available - pending.size()) {
                    throw "XSD-SAMPLE-ERROR", "generated example exceeds the max_elements budget";
                }
                foreach auto item in (node) {
                    push pending, item;
                }
                continue;
            }
            if (!available) {
                throw "XSD-SAMPLE-ERROR", "generated example exceeds the max_elements budget";
            }
            --available;
            if (node.typeCode() != NT_HASH) {
                continue;
            }
            foreach string key in (keys node) {
                if (key.startsWith("^xml^")) {
                    string xml = node{key} instanceof XsdQNameXmlFragment ? node{key}.getXml() : node{key};
                    XmlReader reader(xml);
                    while (reader.read()) {
                        if (reader.nodeType() == XML_NODE_TYPE_ELEMENT) {
                            if (available <= pending.size()) {
                                throw "XSD-SAMPLE-ERROR", "generated example exceeds the max_elements budget";
                            }
                            --available;
                        }
                    }
                } else if (!key.startsWith("^")) {
                    if (available <= pending.size()) {
                        throw "XSD-SAMPLE-ERROR", "generated example exceeds the max_elements budget";
                    }
                    push pending, node{key};
                }
            }
        }
    }
}

class XsdSampleCallContext {
    public {
        WSMessageHelper helper;
        *XsdElement element;
        XsdSampleBudget budget;
        bool one_occurrence;
        bool consumed = False;
    }

    constructor(WSMessageHelper helper, *XsdElement element, XsdSampleBudget budget, bool one_occurrence = False) {
        self.helper = helper;
        self.element = element;
        self.budget = budget;
        self.one_occurrence = one_occurrence;
    }

    static bool consume(WSMessageHelper helper, XsdElement element) {
        if (!SampleCallContext || SampleCallContext.consumed || SampleCallContext.helper !== helper
                || SampleCallContext.element !== element) {
            return False;
        }
        SampleCallContext.consumed = True;
        return True;
    }
}

thread_local *XsdSampleCallContext SampleCallContext;

#! helper class implementing sample message generation
/** This is the class for generating sample SOAP messages based on a WSDL file.

    @par Example
    For a parsed catalog service with a string product-code request, generate a native request example:
    @code
    WSOperation lookup = catalog.getBindingOperation("Soap", "lookup");
    WSMessageHelper examples(catalog);
    auto sample = examples.getMessage(lookup.input);
    printf("Catalog request: %Y\n", sample);
    @endcode

    @note A helper constructed with a WebService retains it until the helper is released.
    Generation checks the candidate with the existing schema instance conversion. If bounded generation
    cannot produce a valid candidate, provide a suitable example explicitly. The choices option produces
    explanatory alternatives; retained XML generation still performs its XML checks.
*/
public class WSMessageHelper {
    private {
        *WebService ws;
        hash<auto> opts;
    }

    const DefaultOpts = (
        "comments": False,
        "choices": False,
        "max_items": 3,
        "max_elements": 10000,
    );

    #! creates the WebService object
    /** @param ws the object representing the WSDL
        @param opts an optional hash of options with the following possible keys:
        - \c "comments": (bool) generate comments as values with ^comment^ key, default: False
        - \c "choices": (bool) generate explanatory alternatives as sub hashes ^choices^ key, default: False;
          these descriptions are not complete serializable instances
        - \c "max_items" (int): maximum nonempty repetitions of each particle, default: 3
        - \c "max_elements" (int): maximum generated elements per message part, including its root; default: 10000
        @throw WSDL-HELPER-ERROR an unknown option or a repetition/element limit that is not a positive integer
        @note Instance examples check their converted output size, including values supplied by public overrides.
    **/
    constructor(WebService ws, *hash<auto> opts) {
        self.ws = ws;
        initOptions(opts);
    }

    private constructor(*hash<auto> opts) {
        initOptions(opts);
    }

    #! generates a bounded native example for a detached schema type
    /** @param type the resolved type and its declaration context
        @param opts the same sample options as the WebService constructor
        @return a value checked against the receiving type
        @throw XSD-SAMPLE-ERROR the bounded candidate cannot satisfy the type
        @throw WSDL-HELPER-ERROR invalid generation options
        @par Example
        Generate a shipment record, including assessable required partner extensions, from a resolved
        schema type with WSMessageHelper::getTypeExample(type, {"max_items": 2, "max_elements": 100}).
        @since %WSDL 0.5.8
    */
    static auto getTypeExample(XsdAbstractType type, *hash<auto> opts) {
        WSMessageHelper helper(opts);
        return helper.getTypeMessage(type);
    }

    private initOptions(*hash<auto> opts) {
        *hash<auto> h = opts;
        map remove h{$1}, keys DefaultOpts;
        if (h) {
           throw "WSDL-HELPER-ERROR", sprintf("unknown options %y (known values: %y)", keys h, keys DefaultOpts);
        }
        self.opts = DefaultOpts + opts;
        if (self.opts.max_items.typeCode() != NT_INT || self.opts.max_items < 1) {
           throw "WSDL-HELPER-ERROR", sprintf("invalid 'max_items' value %y (condition: >=1)", self.opts.max_items);
        }
        if (self.opts.max_elements.typeCode() != NT_INT || self.opts.max_elements < 1) {
            throw "WSDL-HELPER-ERROR", sprintf("invalid 'max_elements' value %Y (positive integer required)",
                self.opts.max_elements);
        }
    }

    private hash<auto> getTypeInfo(XsdBaseType t) {
        hash res = {
            'xtype': t.name,
        };
        switch (t.name) {
            case "string":
            case "normalizedString":
            case "token":
            case "language":
            case "Name":
            case "NCName":
            case "QName":
            case "NOTATION":
            case "NMTOKEN":
            case "NMTOKENS":
            case "ID":
            case "IDREF":
            case "IDREFS":
            case "ENTITY":
            case "ENTITIES":
                res += {
                    "type": "string",
                    "value": "abc",
                };
                break;
            # note: the XSD type is "anyURI"; "anyUri" is accepted as well for backwards compatibility
            case "anyUri":
            case "anyURI":
                res += {
                    "type": "string",
                    "value": "http://www.qore.com",
                };
                break;
            case "anyType":
            case "anySimpleType":
                res += {
                    "type": "string",
                    "value": "abc",
                };
                break;
            case "byte":
            case "int":
            case "integer":
            case "long":
            case "negativeInteger":
            case "nonNegativeInteger":
            case "positiveInteger":
            case "nonPositiveInteger":
            case "short":
            case "unsignedLong":
            case "unsignedInt":
            case "unsignedShort":
            case "unsignedByte":
                res += {
                    "type": "int",
                    "value": t.name == "negativeInteger" || t.name == "nonPositiveInteger" ? -123 : 123,
                };
                break;
            case "boolean":
                res += {
                    "type": "bool",
                    "value": True,
                };
                break;
            case "base64Binary":
            case "hexBinary":
                res += {
                    "type": "binary",
                    "value": <0feba023ffdca62910>,
                };
                break;
            case "decimal":
                res += {
                    "type": "number",
                    "value": 123.456,
                };
                break;
            case "float":
            case "double":
                res += {
                    "type": "float",
                    "value": XsdIeeeLexicalHelper::decode(t.name, "123.456", "XSD-SAMPLE-ERROR"),
                };
                break;
            case "date":
                res += {
                    "type": "date",
                    "value": XsdCalendarLexicalHelper::decode("date", XsdCalendarLexicalHelper::Samples.date,
                        "XSD-SAMPLE-ERROR"),
                };
                break;
            case "gYear":
            case "gYearMonth":
            case "gMonthDay":
            case "gMonth":
            case "gDay":
                res += {"type": "string", "value": XsdCalendarLexicalHelper::Samples{t.name}};
                break;
            case "dateTime":
                res += {
                    "type": "date",
                    "value": 2015-01-31T10:20:30+01:00,
                };
                break;
            case "time":
                res += {
                    "type": "date",
                    "value": 10:20:30Z,
                };
                break;
            case "duration":
                res += {
                    "type": "date",
                    "value": P5Y2M10DT15H,   # TODO
                };
                break;
            case "binary":
                res += {
                    "type": "binary",
                    "value": <abcd>,
                };
                break;
            default:
                res += {
                    "type": t.name,
                    "value": sprintf("unknown type %y", t.name),
                };
                break;
        }
        return res;
    }

    private hash<auto> getTypeInfo(XsdSimpleType t) {
        hash<auto> res;
        if (t.type) {
            res = getTypeInfo(t.type);
            res.xtype = t.name;
            if (t.enumValues) {
                switch (res.type) {
                case "string":
                    res.value = (keys t.enumValues)[0];
                    break;
                case "int":
                    res.value = sprintf("%s", (keys t.enumValues)[0]);
                    break;
                default:
                    res.value = sprintf("%s", (keys t.enumValues)[0]);
                }
                res.comment = sprintf("Enum: %s",  (keys t.enumValues).join(','));
                if (res.type == "int" || res.type == "number" || res.type == "float" || res.type == "string"
                        || res.type == "list" || res.type == "binary" || res.type == "date") {
                    res.value = t.getSampleValue(res.value);
                }
            } else {
                # issue #5411: generate a value satisfying the type's constraining facets; otherwise the generated
                # example message cannot be serialized, as the placeholder value for the base type does not
                # normally satisfy them
                auto sample = t.getSampleValue(res.value);
                if (exists sample) {
                    res.value = sample;
                    *list<string> pl = XsdSimpleType::getPatterns(t);
                    if (pl) {
                        res.comment = sprintf("Pattern: %s", pl.join(" | "));
                    }
                }
            }
        } else if (t.listItemType) {
            res = getTypeInfo(t.listItemType);
            res.xtype = t.name;
            res.type = "list";
            res.value = (res.value,);
        } else if (t.unionTypes) {
            # union types have no single base type; use the first member type for the example value
            res = getTypeInfo(t.unionTypes[0]);
            res.xtype = t.name;
        } else {
            res.xtype = t.name;
        }
        return res;
    }

    private hash<auto> getTypeInfo(XsdComplexType t) {
        hash<auto> res;
        if (t.elementmap || (t.getParticle() && !t.array) || (t.hasMixedContent() && !t.array)) {
            res.type = "hash";
        } else if (t.simpleType) {
            res = getTypeInfo(t.simpleType);
        }
        res.attrs = exists t.attrs;
        return res;
    }

    private hash<auto> getFieldMessage(string field, XsdElement elem, *softlist<auto> comments,
            bool one_occurrence = False) {
        # Preserve nested public-method overrides. Only this intended child call
        # defers validation to the root; reentrant calls receive their own check.
        *XsdSampleCallContext previous = SampleCallContext;
        on_exit SampleCallContext = previous;
        SampleCallContext = new XsdSampleCallContext(self, elem, previous.budget, one_occurrence);
        return {field: getMessage(elem, comments){elem.name}};
    }

    #! generates a native example for an element declaration
    /** @param elem the element declaration
        @param comments optional explanatory comments
        @return the native example keyed by the element name
        @throw XSD-SAMPLE-ERROR bounded generation cannot construct a candidate or its instance checks fail
        @note With the choices option, the result describes all alternatives and is not a serializable instance.
    */
    hash<auto> getMessage(XsdElement elem, *softlist<auto> comments) {
        bool nested = XsdSampleCallContext::consume(self, elem);
        *XsdSampleCallContext previous = SampleCallContext;
        on_exit SampleCallContext = previous;
        if (!nested) {
            SampleCallContext = new XsdSampleCallContext(self, elem, new XsdSampleBudget(opts.max_elements));
            SampleCallContext.consumed = True;
        }
        XsdElement selected = elem;
        if (!nested && !opts.choices && elem.isAbstract()) {
            list<string> names = XsdElementFieldHelper::getPreferredInstanceNames(elem);
            if (!names) {
                throw "XSD-SAMPLE-ERROR", sprintf("element %Y has no concrete instance declaration", elem.getExpandedName());
            }
            selected = elem.getInstanceDeclaration(names[0]);
        }
        auto example = buildElementMessage(selected, comments, nested && SampleCallContext.one_occurrence){selected.name};
        hash<auto> result = {elem.name: XsdElementValueHelper::retain(elem, selected, example)};
        if (!nested && !opts.choices) {
            Namespaces namespaces = elem.type.nsc.copy();
            XsdQNameOutputScope output_scope(namespaces);
            try {
                auto converted = selected.serializeValue(namespaces, example, True, elem.name, "generated example");
                SampleCallContext.budget.checkOutput(converted);
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err == SOAP_SERIALIZATION_ERROR) {
                    rethrow "XSD-SAMPLE-ERROR", sprintf("cannot construct a valid instance example for element %Y: %s",
                        elem.getExpandedName(), ex.desc), ex.arg;
                }
                rethrow;
            }
        }
        return result;
    }

    private auto getTypeMessage(XsdAbstractType type) {
        *XsdSampleCallContext previous = SampleCallContext;
        on_exit SampleCallContext = previous;
        SampleCallContext = new XsdSampleCallContext(self, NOTHING, new XsdSampleBudget(opts.max_elements));
        SampleCallContext.consumed = True;
        SampleCallContext.budget.consume(1);
        auto value = buildTypeValue(type);
        if (!opts.choices) {
            Namespaces namespaces = type.nsc.copy();
            XsdQNameOutputScope output_scope(namespaces);
            try {
                auto converted = XsdDocumentValueHelper::serializeValue(type, namespaces, value, True);
                SampleCallContext.budget.checkOutput(converted);
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err == SOAP_SERIALIZATION_ERROR) {
                    rethrow "XSD-SAMPLE-ERROR", sprintf("cannot construct a valid instance example for type %Y: %s",
                        type.getName(), ex.desc), ex.arg;
                }
                rethrow;
            }
        }
        return value;
    }

    private hash<auto> buildElementMessage(XsdElement elem, *softlist<auto> comments,
            bool one_occurrence = False) {
        if (!one_occurrence) {
            if (opts.comments) {
                if (elem.minOccurs == 0) {
                    comments += "optional";
                }
                if (elem.minOccurs > 1) {
                    comments += sprintf("minOccurs:%d", elem.minOccurs);
                }
                if (elem.maxOccurs > 1 || elem.maxOccurs < 0) {
                    comments += sprintf("maxOccurs:%d", elem.maxOccurs);
                }
            }
        }
        int count = one_occurrence ? 1 : elem.maxOccurs;
        if (count == -1 || count > opts.max_items) {
            count = opts.max_items;
        }
        if (!one_occurrence) {
            SampleCallContext.budget.consume(count);
        }
        if (count != 1) {
            list<auto> result();
            for (int index = 0; index < count; ++index) {
                *softlist<auto> item_comments = comments;
                if (comments) {
                    item_comments = (sprintf("#%d", index + 1),) + comments;
                }
                push result, buildTypeValue(elem.type, item_comments);
            }
            return {elem.name: result};
        }
        return {elem.name: buildTypeValue(elem.type, comments)};
    }

    private hash<auto> buildParticleValue(XsdComplexType type, bool empty) {
        XsdParticle particle = type.getParticle();
        *hash<string, hash<XsdParticleOccurrenceRange>> ranges = particle.getElementOccurrenceRanges();
        hash<string, XsdElement> declarations = XsdElementFieldHelper::getParticleDeclarations(particle, ranges);
        hash<string, string> fields = XsdElementFieldHelper::getFieldNames(declarations);
        list<string> names = empty ? new list<string>()
            : particle.getSampleElementNames(opts.max_items, SampleCallContext.budget.remaining);
        *list<XsdParticle> initial_positions = particle.attributeElementNames(names);
        @assert(exists initial_positions);
        hash<string, int> counts();
        for (int index = 0; index < names.size(); ++index) {
            string identity = names[index];
            if (initial_positions[index].getKind() == XsdParticleKind::Any) {
                # A fresh element can always be assessed through the builtin string
                # type. Avoid a global declaration imposing unrelated constraints.
                string candidate = identity;
                int suffix = 0;
                while (declarations.hasKey(candidate) || type.nsc.getGlobalElement(candidate)) {
                    candidate = identity + (++suffix).toString();
                }
                identity = candidate;
                fields{identity} = identity;
            }
            ++counts{identity};
        }
        # Select the same schedule as native serialization before generating any
        # declaration-specific value. A flat record does not retain interleaving.
        names = ();
        foreach string identity in (keys ranges) {
            for (int index = 0; index < counts{identity}; ++index) {
                push names, identity;
            }
        }
        foreach string identity in (keys counts) {
            if (!ranges.hasKey(identity)) {
                for (int index = 0; index < counts{identity}; ++index) {
                    push names, identity;
                }
            }
        }
        *list<string> ordered = particle.orderElementNames(names);
        @assert(exists ordered);
        *list<XsdParticle> positions = particle.attributeElementNames(ordered);
        @assert(exists positions);
        SampleCallContext.budget.consume(ordered.size());
        hash<string, list<auto>> values();
        for (int index = 0; index < positions.size(); ++index) {
            string identity = ordered[index];
            if (positions[index].getKind() == XsdParticleKind::Any) {
                auto sample = positions[index].getWildcard().processing == XsdWildcardProcessing::Strict
                    ? {"^type^":new XsdQNameValue(XSD_NS, "string"), "^val^":"sample"} : "sample";
                if (!values.hasKey(identity)) {
                    values{identity} = new list<auto>();
                }
                push values{identity}, sample;
                continue;
            }
            @assert(positions[index].getKind() == XsdParticleKind::Element);
            *list<string> comments;
            if (opts.comments) {
                comments = ();
                if (ranges{identity}.minimum == "0") {
                    push comments, "optional";
                } else if (ranges{identity}.minimum != "1") {
                    push comments, "minOccurs:" + ranges{identity}.minimum;
                }
                if (ranges{identity}.maximum != "1") {
                    push comments, "maxOccurs:" + (ranges{identity}.maximum ?? "unbounded");
                }
                if (counts{identity} > 1) {
                    push comments, sprintf("#%d", values{identity}.size() + 1);
                }
            }
            if (!values.hasKey(identity)) {
                values{identity} = new list<auto>();
            }
            *XsdElement declaration = positions[index].getElement().getInstanceDeclaration(identity);
            @assert(declaration);
            push values{identity}, getFieldMessage(fields{identity}, declaration, comments,
                True){fields{identity}};
        }
        hash<auto> result();
        if (type.hasMixedContent()) {
            # Mixed native records retain the selected schedule. A later occurrence
            # gets its own key, including when the child value is itself an XSD list.
            hash<string, int> offsets();
            foreach string identity in (ordered) {
                int offset = offsets{identity}++;
                string field = fields{identity} + (offset ? "^" + offset.toString() : "");
                result{field} = values{identity}[offset];
            }
            return result;
        }
        foreach string identity in (keys values) {
            bool single = ranges.hasKey(identity) ? ranges{identity}.maximum == "1" : counts{identity} == 1;
            result{fields{identity}} = single ? values{identity}[0] : values{identity};
        }
        return result;
    }

    private auto buildTypeValue(XsdAbstractType type, *softlist<auto> comments) {
        hash<auto> vi = getTypeInfo(type);
        auto val;
        *XsdComplexType complex = type instanceof XsdComplexType ? type : NOTHING;
        bool named = complex && complex.getParticle() && !opts.choices && !complex.array;
        string key = complex ? complex.uniqueHash() : "";
        bool recursive = key && SampleCallContext.budget.active_types{key};
        if (recursive && (!named || !complex.getParticle().matchesElementNames(()))) {
            throw "XSD-SAMPLE-ERROR", sprintf("cannot construct a finite recursive example for type %Y", type.name);
        }
        if (key && !recursive) {
            SampleCallContext.budget.active_types{key} = True;
        }
        on_exit {
            if (key && !recursive) {
                delete SampleCallContext.budget.active_types{key};
            }
        }
        if (named) {
            val = buildParticleValue(complex, recursive);
        } else if (vi.type) {
            if (vi.type == 'hash') {
                val = {};
                if (type instanceof XsdComplexType) {
                    XsdComplexType ct = cast<XsdComplexType>(type);
                    if (ct.isChoice()) {
                        # the complexType is a choice itself; only one of its members may be serialized
                        if (opts.choices) {
                            hash<auto> ch;
                            foreach string name2 in (keys ct.elementmap) {
                                ch += getFieldMessage(name2, ct.elementmap{name2},
                                    opts.comments ? sprintf("choice[%d]", $# + 1) : NOTHING);
                            }
                            val."^choices1^" = ch;
                        } else if (ct.elementmap) {
                            val += getFieldMessage(ct.elementmap.firstKey(), ct.elementmap.firstValue(),
                                opts.comments ? sprintf("choice[1/%d]", ct.elementmap.size()) : NOTHING);
                        }
                    } else {
                        foreach string name2 in (keys ct.elementmap) {
                            val += getFieldMessage(name2, ct.elementmap{name2});
                        }
                    }
                    foreach hash<ChoiceInfo> choice in (ct.choices) {
                        if (opts.choices) {
                            hash<auto> ch;
                            int j = 1;
                            foreach string name2 in (keys choice.elementmap) {
                                ch += getFieldMessage(name2, choice.elementmap{name2},
                                    opts.comments ? sprintf("choice[%d]", j) : NOTHING);
                                j++;
                            }
                            val{sprintf("^choices%d^", $#+1)} = ch;
                        } else {
                            val += getFieldMessage(choice.elementmap.firstKey(), choice.elementmap.firstValue(),
                                opts.comments ? sprintf("choice[1/%d]", ct.choices.size()) : NOTHING);
                        }
                    }
                }
            } else {
                if (opts.comments && vi.comment) {
                    comments += vi.comment;
                }
                val = vi.value;
            }
        }

        auto v;
        if (comments || vi.attrs) {
            v = hash();
            if (comments) {
                v{'^comment^'} = comments.join(';');
            }
            if (vi.attrs) {
                foreach string name2 in (keys cast<XsdComplexType>(type).attrs) {
                    XsdAttribute attr = cast<XsdComplexType>(type).attrs{name2};
                    if (attr.hasValueConstraint()) {
                        v{'^attributes^'}{name2} = attr.getDefaultValue();
                        continue;
                    }
                    hash<auto> vi2 = getTypeInfo(attr.type);
                    if (vi2.type) {
                        v{'^attributes^'}{name2} = vi2.value;
                    }
                }
            }
            if (exists val) {
                if (vi.type == 'hash') {
                    v += val;
                } else {
                    v{'^value^'} = val;
                }
            }
        } else {
            v = val;
        }
        return v;
    }

    #! prepare sample message
    /** @param name message name

        @return a hash representing message
        @throw MESSAGE-ERROR the name does not identify a known element
        @throw XSD-SAMPLE-ERROR the generated candidate fails the element's schema instance requirements
    */
    hash<auto> getMessage(string name) {
        *XsdElement e = ws.idocmap{name};
        if (!e) {
            throw "MESSAGE-ERROR", sprintf("cannot map message %Y to a known element; known elements: %Y",
                name, ws.idocmap.keys());
        }
        return getMessage(e);
    }

    #! generates validated retained XML examples keyed by WSDL part name
    /** @param msg the message containing element-based parts
        @return one immutable XML value for each part
        @throw MESSAGE-ERROR a part is type-based rather than element-based
        @throw XSD-SAMPLE-ERROR a native generated candidate fails schema instance requirements
        @throw SOAP-SERIALIZATION-ERROR generated XML content fails existing schema checks
        @note Ordinary getMessage() calls keep their native representations. The returned values can
        be used with element-based literal SOAP bindings and explicit XML provider types.
        @since %WSDL 0.5.8
    */
    hash<string, XsdXmlValue> getXmlMessage(WSMessage msg) {
        hash<string, XsdXmlValue> result();
        Namespaces namespaces = ws.nsc.copy();
        XsdQNameOutputScope output_scope(namespaces);
        foreach string part in (keys msg.pmap) {
            hash<ArgInfo> arg = msg.args{msg.pmap{part}};
            if (!arg.element) {
                throw "MESSAGE-ERROR", sprintf("part %Y requires an element declaration for a retained XML example", part);
            }
            XsdElement element = arg.element;
            auto example = getMessage(element){element.name};
            element = XsdElementValueHelper::select(element, \example);
            auto serialized = element.serializeValue(namespaces, example, True, part, msg.name);
            hash<auto> content();
            if (serialized.typeCode() == NT_HASH) {
                content += serialized;
            } else {
                content."^value^" = serialized;
            }
            string root = element.getXmlName(namespaces);
            content."^attributes^" += namespaces.getOutputNamespaceHash(NOTHING);
            if (element.getExpandedName() == type_qname("", element.name)) {
                content."^attributes^".xmlns = "";
            }
            XsdQNameXmlOutputHelper output();
            XsdXmlValue value(make_xml(output.prepare({root: content})));
            element.validateXmlValue(value, namespaces, ws.getTypeMap());
            result{part} = value;
        }
        return result;
    }

    #! prepare sample message
    /** @param msg WSMessage object

        @return the existing single-part sample, or a hash keyed by every part name for a multipart message
        @throw XSD-SAMPLE-ERROR a generated candidate fails its part's schema instance requirements
        @note The choices option produces explanatory alternatives instead of a complete instance.
    */
    auto getMessage(WSMessage msg) {
        if (msg.pmap.size() > 1) {
            hash<auto> result();
            foreach string part in (keys msg.pmap) {
                hash<ArgInfo> arg = msg.args{msg.pmap{part}};
                result{part} = arg.element ? getMessage(arg.element){arg.element.name} : getTypeMessage(arg.type);
            }
            return result;
        }
        auto t = msg.args.firstValue();
        if (t.element) {
            return getMessage(t.element);
        }
        if (t.type) {
            return getTypeMessage(t.type);
        }
    }
}
}
