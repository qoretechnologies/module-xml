        "ornamentaldingbats":                          '\x{1F650}-\x{1F67F}',
        # Transport and Map Symbols
        "transportandmapsymbols":                      '\x{1F680}-\x{1F6FF}',
        # Alchemical Symbols
        "alchemicalsymbols":                           '\x{1F700}-\x{1F77F}',
        # Geometric Shapes Extended
        "geometricshapesextended":                     '\x{1F780}-\x{1F7FF}',
        # Supplemental Arrows-C
        "supplementalarrowsc":                         '\x{1F800}-\x{1F8FF}',
        # Supplemental Symbols and Pictographs
        "supplementalsymbolsandpictographs":           '\x{1F900}-\x{1F9FF}',
        # Chess Symbols
        "chesssymbols":                                '\x{1FA00}-\x{1FA6F}',
        # Symbols and Pictographs Extended-A
        "symbolsandpictographsextendeda":              '\x{1FA70}-\x{1FAFF}',
        # Symbols for Legacy Computing
        "symbolsforlegacycomputing":                   '\x{1FB00}-\x{1FBFF}',
        # CJK Unified Ideographs Extension B
        "cjkunifiedideographsextensionb":              '\x{20000}-\x{2A6DF}',
        # CJK Unified Ideographs Extension C
        "cjkunifiedideographsextensionc":              '\x{2A700}-\x{2B73F}',
        # CJK Unified Ideographs Extension D
        "cjkunifiedideographsextensiond":              '\x{2B740}-\x{2B81F}',
        # CJK Unified Ideographs Extension E
        "cjkunifiedideographsextensione":              '\x{2B820}-\x{2CEAF}',
        # CJK Unified Ideographs Extension F
        "cjkunifiedideographsextensionf":              '\x{2CEB0}-\x{2EBEF}',
        # CJK Compatibility Ideographs Supplement
        "cjkcompatibilityideographssupplement":        '\x{2F800}-\x{2FA1F}',
        # CJK Unified Ideographs Extension G
        "cjkunifiedideographsextensiong":              '\x{30000}-\x{3134F}',
        # Tags
        "tags":                                        '\x{E0000}-\x{E007F}',
        # Variation Selectors Supplement
        "variationselectorssupplement":                '\x{E0100}-\x{E01EF}',
        # Supplementary Private Use Area-A
        "supplementaryprivateuseareaa":                '\x{F0000}-\x{FFFFF}',
        # Supplementary Private Use Area-B
        "supplementaryprivateuseareab":                '\x{100000}-\x{10FFFF}',

        # the XSD block names come from Unicode 3.1; these blocks have been renamed since
        "greek":                                       '\x{0370}-\x{03FF}',
        "combiningmarksforsymbols":                    '\x{20D0}-\x{20FF}',
        "privateuse":                                  '\x{E000}-\x{F8FF}',
        "cyrillicsupplementary":                       '\x{0500}-\x{052F}',
    };
    }

    #! returns the PCRE character range for an XSD \c "\p{IsXxx}" block name, if it is known
    /** @param prop the property name from the escape, ex: \c "IsBasicLatin"

        @return the corresponding character range (ex: \c "\x{0000}-\x{007F}"), or \c NOTHING if \a prop does
        not name a Unicode block

        @since %WSDL 0.5.8
    */
    static *string getBlockRange(string prop) {
        if (prop !~ /^Is/) {
            return;
        }
        # block names are compared ignoring case, whitespace, hyphens, and underscores
        string key = prop.substr(2).lwr();
        key =~ s/[[:space:]_-]//g;
        return XsdRegexHelper::UnicodeBlocks{key};
    }

    #! the maximum length of a generated sample value
    const MaxSampleLength = 256;

    #! the maximum nesting depth accepted when generating a sample value
    const MaxSampleDepth = 32;

    #! characters tried in order when looking for one accepted by a character class
    const SampleChars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
        + " -_.:+@!$#%&*/=?,;'<>()[]{}|~^\"\\\t\n\r";

    #! returns a bounded sample matching the given XSD pattern, or \c NOTHING if none can be generated
    /** Generation selects the first alternation branch and searches a fixed character alphabet for classes.
        If no candidate can be constructed within the depth and length limits, or if the pattern is invalid,
        \c NOTHING is returned. The caller must validate any alternative default against the complete type.

        @param xsd the XSD regular expression to generate a value for
        @param min_reps minimum repetitions to use for optional pattern components

        @return a value matching \a xsd, or \c NOTHING if none could be generated
        @note Unexpected errors and cancellation propagate to the caller.
    */
    static *string getSampleValue(string xsd, int min_reps = 0) {
        int i = 0;
        string rv;
        XsdPatternConstraint constraint;
        try {
            constraint = XsdPatternConstraintHelper::compile(xsd);
            rv = XsdRegexHelper::sampleAlternation(xsd, \i, 0, min_reps);
            # the whole pattern must have been consumed
            if (i < xsd.length()) {
                return;
            }
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "XSD-REGEX-SAMPLE-ERROR" && ex.err != "XSD-REGEX-ERROR") {
                rethrow;
            }
            return;
        }
        # never return a value that does not match the pattern it was generated from
        try {
            return XsdPatternConstraintHelper::matches(rv, constraint) ? rv : NOTHING;
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "XSD-REGEX-ERROR" && ex.err != "REGEX-ERROR" && ex.err != "REGEX-COMPILATION-ERROR") {
                rethrow;
            }
            return;
        }
    }

    #! generates a sample for an alternation; the first branch is used
    private static string sampleAlternation(string xsd, reference<int> i, int depth, int min_reps) {
        if (depth > XsdRegexHelper::MaxSampleDepth) {
            throw "XSD-REGEX-SAMPLE-ERROR", "expression nested too deeply";
        }
        string rv = XsdRegexHelper::sampleSequence(xsd, \i, depth, min_reps);
        # parse and discard the remaining branches
        while (i < xsd.length() && xsd[i] == "|") {
            ++i;
            XsdRegexHelper::sampleSequence(xsd, \i, depth, min_reps);
        }
        return rv;
    }

    #! generates a sample for a sequence of pieces
    private static string sampleSequence(string xsd, reference<int> i, int depth, int min_reps) {
        string rv = "";
        while (i < xsd.length()) {
            string c = xsd[i];
            if (c == "|" || c == ")") {
                break;
            }
            int before = i;
            rv += XsdRegexHelper::samplePiece(xsd, \i, depth, min_reps);
            if (i == before) {
                throw "XSD-REGEX-SAMPLE-ERROR", sprintf("no progress parsing %y at offset %d", xsd, i);
            }
            if (rv.length() > XsdRegexHelper::MaxSampleLength) {
                throw "XSD-REGEX-SAMPLE-ERROR", "sample value too long";
            }
        }
        return rv;
    }

    #! generates a sample for an atom and its quantifier, repeating the atom the minimum number of times
    private static string samplePiece(string xsd, reference<int> i, int depth, int min_reps) {
        string atom = XsdRegexHelper::sampleAtom(xsd, \i, depth, min_reps);
        int min = 1;
        # the upper bound of the quantifier, if it has one
        *int max = 1;
        if (i < xsd.length()) {
            switch (xsd[i]) {
                case "?":
                    min = 0;
                    ++i;
                    break;

                case "*":
                    min = 0;
                    delete max;
                    ++i;
                    break;

                case "+":
                    delete max;
                    ++i;
                    break;

                case "{": {
                    int close = index(xsd, "}", i);
                    if (close < 0) {
                        throw "XSD-REGEX-SAMPLE-ERROR", "unterminated quantifier";
                    }
                    string body = xsd.substr(i + 1, close - i - 1);
                    *string mn = (body =~ x/^([0-9]+)/)[0];
                    if (!exists mn) {
                        throw "XSD-REGEX-SAMPLE-ERROR", "unsupported quantifier";
                    }
                    min = sampleCount(mn);
                    if (body !~ /,/) {
                        max = min;
                    } else {
                        *string mx = (body =~ x/,\s*([0-9]+)$/)[0];
                        if (exists mx) {
                            max = sampleCount(mx);
                        } else {
                            delete max;
                        }
                    }
                    i = close + 1;
                    break;
                }
            }
        }
        # repeat the atom more often when a longer value is required, but never more than the quantifier allows
        int reps = min_reps > min ? min_reps : min;
        if (exists max && reps > max) {
            reps = max;
        }
        if (!atom.length()) {
            return "";
        }
        if (reps > XsdRegexHelper::MaxSampleLength / atom.length()) {
            throw "XSD-REGEX-SAMPLE-ERROR", "sample value too long";
        }
        string rv = "";
        for (int j = 0; j < reps; ++j) {
            rv += atom;
        }
        return rv;
    }

    #! bounds sample work before converting an arbitrary-size repetition count to a native integer
    private static int sampleCount(string count) {
        string canonical = XsdIntegerLexicalHelper::canonical(count);
        int limit = MaxSampleLength + 1;
        return XsdIntegerLexicalHelper::compare(canonical, limit.toString()) > 0 ? limit : canonical.toInt();
    }

    #! generates a sample for a single atom
    private static string sampleAtom(string xsd, reference<int> i, int depth, int min_reps) {
        switch (xsd[i]) {
            case "(": {
                ++i;
                string rv = XsdRegexHelper::sampleAlternation(xsd, \i, depth + 1, min_reps);
                if (i >= xsd.length() || xsd[i] != ")") {
                    throw "XSD-REGEX-SAMPLE-ERROR", "unterminated group";
                }
                ++i;
                return rv;
            }

            case "[":
                return XsdRegexHelper::sampleClass(xsd, \i);

            case "\\":
                return XsdRegexHelper::sampleEscape(xsd, \i);

            case ".":
                ++i;
                return "a";
        }
        string c = xsd[i];
        ++i;
        return c;
    }

    #! generates a sample character for an escape sequence
    private static string sampleEscape(string xsd, reference<int> i) {
        if (i + 1 >= xsd.length()) {
            throw "XSD-REGEX-SAMPLE-ERROR", "trailing backslash";
        }
        string e = xsd[i + 1];
        i += 2;
        switch (e) {
            case "d": return "0";
            case "w":
            case "i":
            case "c": return "a";
            case "s": return " ";
            case "n": return "\n";
            case "r": return "\r";
            case "t": return "\t";
            # the complement escapes: a character that is in none of the corresponding sets
            case "D":
            case "S": return "a";
            case "W":
            case "I":
            case "C": return "!";
            case "p":
            case "P": {
                *string prop = XsdRegexHelper::readProperty(xsd.splitChars(), \i);
                if (!exists prop) {
                    throw "XSD-REGEX-SAMPLE-ERROR", "unsupported property escape";
                }
                if (e == "P") {
                    return "!";
                }
                *string range = XsdRegexHelper::getBlockRange(prop);
                if (exists range) {
                    return XsdRegexHelper::sampleForPattern("[" + range + "]")
                        ?? XsdRegexHelper::firstCharOfRange(range);
                }
                return XsdRegexHelper::sampleForPattern(sprintf("\\p{%s}", prop))
                    ?? (prop =~ /^N/ ? "0" : "a");
            }
        }
        return e;
    }

    #! generates a sample character accepted by a character class
    private static string sampleClass(string xsd, reference<int> i) {
        int start = i;
        # convert the class first, so that negation and character class subtraction are handled
        string pcre = XsdRegexHelper::classToPcre(xsd.splitChars(), \i);
        *string ch = XsdRegexHelper::sampleForPattern(pcre);
        if (exists ch) {
            return ch;
        }
        throw "XSD-REGEX-SAMPLE-ERROR", sprintf("no sample character for character class %y",
            xsd.substr(start, i - start));
    }

    #! returns the first of @ref SampleChars accepted by the given PCRE expression, if any
    private static *string sampleForPattern(string pcre) {
        for (int j = 0; j < XsdRegexHelper::SampleChars.length(); ++j) {
            string ch = XsdRegexHelper::SampleChars[j];
            try {
                if (regex(ch, "^(?:" + pcre + ")$")) {
                    return ch;
                }
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "REGEX-ERROR" && ex.err != "REGEX-COMPILATION-ERROR") {
                    rethrow;
                }
                # An expression that cannot be compiled cannot produce a sample.
                return;
            }
        }
    }

    #! returns the character at the start of a character range such as \c "\x{0370}-\x{03FF}"
    private static string firstCharOfRange(string range) {
        *string cp = (range =~ x/^\\x\{([0-9A-Fa-f]+)\}/)[0];
        if (!exists cp) {
            throw "XSD-REGEX-SAMPLE-ERROR", sprintf("cannot derive a sample from range %y", range);
        }
        # note that chr() operates on bytes, while <int>::toUnicode() returns the character for a code point
        return cp.toInt(16).toUnicode();
    }

    #! converts an XSD regular expression to the equivalent PCRE expression
    /** @param xsd an XSD 1.0 pattern
        @return the translated expression, without implicit whole-value anchors
        @throw XSD-REGEX-ERROR the pattern does not satisfy the XSD grammar or names an unknown Unicode block

        @par Example
        The product-code pattern \c "[a-z-[aeiou]]+" accepts lowercase consonants; the returned expression
        implements character-class subtraction using single-character lookahead assertions.

        @note The caller must add whole-value anchors and compile the expression. PCRE's compilation and
        matching resource limits still apply independently of XSD syntax validation.
    */
    static string toPcre(string xsd) {
        return XsdRegexParser::parse(xsd);
    }

    #! the single-character escapes allowed by XSD 1.0 Appendix F, production 24
    const SingleEscapes = {"n": "\n", "r": "\r", "t": "\t", "\\": "\\", "|": "|", ".": ".",
        "-": "-", "^": "^", "?": "?", "*": "*", "+": "+", "{": "{", "}": "}", "(": "(", ")": ")",
        "[": "[", "]": "]"};

    #! converts one escape to a complete single-character expression
    private static string escapeToPcre(list<string> xsd, reference<int> i) {
        if (i + 1 >= xsd.size()) {
            throw "XSD-REGEX-ERROR", "trailing backslash";
        }
        string e = xsd[i + 1];
        i += 2;
        if (SingleEscapes.hasKey(e)) {
            return sprintf("\\x{%X}", SingleEscapes{e}.getUnicode());
        }
        switch (e) {
            case "i": return "[" + NameStartChars + "]";
            case "I": return "[^" + NameStartChars + "]";
            case "c": return "[" + NameChars + "]";
            case "C": return "[^" + NameChars + "]";
            case "s": return "[" + SpaceChars + "]";
            case "S": return "[^" + SpaceChars + "]";
            case "d": return "\\p{Nd}";
            case "D": return "\\P{Nd}";
            case "w": return "[^" + NonWordCategories + "]";
            case "W": return "[" + NonWordCategories + "]";
            case "p":
            case "P": {
                *string prop = readProperty(xsd, \i);
                if (!exists prop) {
                    throw "XSD-REGEX-ERROR", "a property escape requires a braced property name";
                }
                if (regex(prop, '\A(?:L[ultmo]?|M[nce]?|N[dlo]?|P[cdseifo]?|Z[slp]?|S[mcko]?|C[cfon]?)\z')) {
                    return sprintf("\\%s{%s}", e, prop);
                }
                if (!regex(prop, '\AIs[A-Za-z0-9-]+\z')) {
                    throw "XSD-REGEX-ERROR", sprintf("invalid XSD character property %Y", prop);
                }
                *string range = getBlockRange(prop);
                if (!exists range) {
                    throw "XSD-REGEX-ERROR", sprintf("unknown XSD Unicode block %Y", prop);
                }
                return "[" + (e == "P" ? "^" : "") + range + "]";
            }
        }
        throw "XSD-REGEX-ERROR", sprintf("invalid XSD escape %Y", e);
    }

    #! reads the \c "{...}" property name of a \c "\p" or \c "\P" escape; \a i is advanced past it
    private static *string readProperty(list<string> xsd, reference<int> i) {
        if (i >= xsd.size() || xsd[i] != "{") {
            return;
        }
        int close = i + 1;
        list<string> name();
        while (close < xsd.size() && xsd[close] != "}") {
            push name, xsd[close++];
        }
        if (close == xsd.size()) {
            return;
        }
        i = close + 1;
        return name.join("");
    }

    #! combines a positive or negative group of single-character expressions
    private static string characterGroup(list<string> terms, bool negative) {
        if (!terms) {
            throw "XSD-REGEX-ERROR", "an XSD character group must not be empty";
        }
        string group = terms.size() == 1 ? terms[0] : "(?:" + terms.join("|") + ")";
        return negative ? "(?:(?!" + group + ")[\\s\\S])" : group;
    }

    #! parses a literal character or a single-character escape used as a range endpoint
    private static int rangeCharacter(list<string> xsd, reference<int> i) {
        if (i >= xsd.size()) {
            throw "XSD-REGEX-ERROR", "missing character range endpoint";
        }
        string value = xsd[i];
        if (value == "\\") {
            if (i + 1 >= xsd.size() || !SingleEscapes.hasKey(xsd[i + 1])) {
                throw "XSD-REGEX-ERROR", "a range endpoint must be one character";
            }
            value = SingleEscapes{xsd[i + 1]};
            i += 2;
        } else {
            if (value == "[" || value == "]" || value == "-") {
                throw "XSD-REGEX-ERROR", "invalid unescaped character range endpoint";
            }
            ++i;
        }
        return value.getUnicode();
    }

    #! converts XSD character classes with iterative, linear-size subtraction assembly
    private static string classToPcre(list<string> xsd, reference<int> i, *XsdRegexProgram program = NOTHING) {
        list<string> parents();
        list<int> parent_sets();
        while (True) {
            @assert(i < xsd.size() && xsd[i] == "[");
            ++i;
            bool negative = i < xsd.size() && xsd[i] == "^";
            if (negative) {
                ++i;
            }
            list<string> terms();
            list<int> set_terms();
            bool subtract = False;
            while (i < xsd.size() && xsd[i] != "]") {
                string c = xsd[i];
                if (c == "-" && i + 1 < xsd.size() && xsd[i + 1] == "[") {
                    push parents, characterGroup(terms, negative);
                    if (program) {
                        push parent_sets, program.makeSet(set_terms, negative);
                    }
                    ++i;
                    subtract = True;
                    break;
                }
                if (c == "-") {
                    bool last = i + 1 < xsd.size() && (xsd[i + 1] == "]"
                        || (i + 2 < xsd.size() && xsd[i + 1] == "-" && xsd[i + 2] == "["));
                    if (terms && !last) {
                        throw "XSD-REGEX-ERROR", "an unescaped hyphen must start or end a positive character group";
                    }
                    push terms, "\\x{2D}";
                    if (program) {
                        push set_terms, program.makeCharacter(terms[-1]);
                    }
                    ++i;
                    continue;
                }
                if (c == "\\" && i + 1 < xsd.size() && !SingleEscapes.hasKey(xsd[i + 1])) {
                    string escaped = escapeToPcre(xsd, \i);
                    push terms, escaped;
                    if (program) {
                        push set_terms, program.makeCharacter(escaped);
                    }
                    continue;
                }
                int start = rangeCharacter(xsd, \i);
                bool range = i + 1 < xsd.size() && xsd[i] == "-" && xsd[i + 1] != "["
                    && xsd[i + 1] != "]"
                    && !(i + 2 < xsd.size() && xsd[i + 1] == "-" && xsd[i + 2] == "[");
                if (range) {
                    ++i;
                    int end = rangeCharacter(xsd, \i);
                    if (start > end) {
                        throw "XSD-REGEX-ERROR", "character range end precedes its start";
                    }
                    push terms, sprintf("[\\x{%X}-\\x{%X}]", start, end);
                    if (program) {
                        push set_terms, program.makeCharacter(terms[-1]);
                    }
                } else {
                    push terms, sprintf("\\x{%X}", start);
                    if (program) {
                        push set_terms, program.makeCharacter(terms[-1]);
                    }
                }
            }
            if (subtract) {
                continue;
            }
            if (i >= xsd.size()) {
                throw "XSD-REGEX-ERROR", "unterminated character class";
            }
            ++i;
            string leaf = characterGroup(terms, negative);
            int set_root;
            if (program) {
                set_root = program.makeSet(set_terms, negative);
            }
            list<string> pieces();
            foreach string parent in (parents) {
                push pieces, "(?:(?!";
            }
            push pieces, leaf;
            for (int parent = parents.size() - 1; parent >= 0; --parent) {
                if (i >= xsd.size() || xsd[i] != "]") {
                    throw "XSD-REGEX-ERROR", "subtraction must end its enclosing character class";
                }
                ++i;
                push pieces, ")" + parents[parent] + ")";
                if (program) {
                    set_root = program.makeDifference(parent_sets[parent], set_root);
                }
            }
            if (program) {
                program.appendAtom(set_root);
            }
            return pieces.join("");
        }
    }

}

#! a literal's namespace identity, captured before its declaration scope is restored
hashdecl XsdQNameDeclarationLiteral {
    string original;
    hash<string, string> namespaces;
    string lexical;
    *string namespace_uri;
}

#! Validate facet declarations before constructing their value-space constraints.
class XsdFacetDeclarationHelper {
    const Names = {"minInclusive": True, "maxInclusive": True, "minExclusive": True, "maxExclusive": True,
        "length": True, "minLength": True, "maxLength": True, "totalDigits": True, "fractionDigits": True,
        "whiteSpace": True, "pattern": True, "enumeration": True};

    static hash<string, bool> validate(hash<auto> restriction, Namespaces nsc,
            reference<*list<hash<XsdQNameDeclarationLiteral>>> literals) {
        hash<string, bool> fixed();
        foreach string facet in (keys restriction) {
            if (facet == "annotation" || facet == "simpleType" || facet == "ns" || facet == "^attributes^") {
                continue;
            }
            if (!Names{facet}) {
                throw "XSD-SIMPLETYPE-ERROR", sprintf("unexpected simple restriction child %Y", facet);
            }
            auto raw = restriction{facet};
            if (raw.typeCode() == NT_LIST && facet != "pattern" && facet != "enumeration") {
                throw "XSD-SIMPLETYPE-ERROR", sprintf("facet %Y must occur at most once per restriction", facet);
            }
            foreach auto node in (raw ?? (NOTHING,)) {
                if (node.typeCode() != NT_HASH || !exists node."^attributes^".value
                        || node."^attributes^".value.typeCode() != NT_STRING) {
                    throw "XSD-SIMPLETYPE-ERROR", sprintf("facet %Y requires a lexical value attribute", facet);
                }
                hash<auto> attributes = node."^attributes^";
                NamespacePrefixHelper scope(nsc, attributes);
                foreach string key in (keys attributes) {
                    if (key == "value" || key == "id" || key == "xmlns" || key.startsWith("xmlns:")) {
                        continue;
                    }
                    if (key == "fixed" && facet != "pattern" && facet != "enumeration") {
                        fixed{facet} = XsdBooleanLexicalHelper::decode(attributes.fixed, "XSD-SIMPLETYPE-ERROR");
                        continue;
                    }
                    if (key.find(":") >= 0) {
                        string prefix = key.substr(0, key.find(":"));
                        if (nsc.getInputNamespaceUri(prefix) != XSD_NS) {
                            continue;
                        }
                    }
                    throw "XSD-SIMPLETYPE-ERROR", sprintf("unexpected attribute %Y on facet %Y", key, facet);
                }
                hash<auto> content = node;
                WSDL::XsdBase::removeNS(\content);
                foreach string key in (keys content) {
                    if (key == "^attributes^" || key == "ns") {
                        continue;
                    }
                    if (key == "annotation" && content{key}.typeCode() != NT_LIST) {
                        continue;
                    }
                    throw "XSD-SIMPLETYPE-ERROR", sprintf("unexpected content %Y in facet %Y", key, facet);
                }
                if (facet == "whiteSpace") {
                    string value = XsdSimpleType::normalizeWhiteSpace(attributes.value, "collapse");
                    if (value != "preserve" && value != "replace" && value != "collapse") {
                        throw "XSD-SIMPLETYPE-ERROR", sprintf("invalid whiteSpace facet %Y", attributes.value);
                    }
                }
                if (facet == "enumeration") {
                    # The base may be resolved later. Retain every literal, including equal
                    # spellings with different bindings, without copying complete namespace maps.
                    string lexical = XsdSimpleType::normalizeWhiteSpace(attributes.value, "collapse");
                    int colon = lexical.find(":");
                    string prefix = colon < 0 ? "" : lexical.substr(0, colon);
                    *string uri = prefix == "xml" ? "http://www.w3.org/XML/1998/namespace"
                        : prefix ? nsc.getInputNamespaceState().input{prefix} : (nsc.getDefaultNs() ?? "");
                    push literals, <XsdQNameDeclarationLiteral>{"lexical": lexical, "namespace_uri": uri,
                        "original": attributes.value, "namespaces": XsdQNameContextHelper::capture(attributes.value, nsc)};
                }
            }
        }
        return fixed;
    }
}

enum XsdFacetGrammarKind {
    XFG_OTHER = 0,
    XFG_SIMPLE_TYPE = 1,
    XFG_SIMPLE_CONTENT = 2,
    XFG_RESTRICTION = 3,
    XFG_FACET = 4,
}

hashdecl XsdFacetGrammarFrame {
    XsdFacetGrammarKind kind = XFG_OTHER;
    bool ignored = False;
    bool simple_content = False;
    bool annotation = False;
    bool inline_type = False;
    bool facets = False;
    bool attributes = False;
    bool any_attribute = False;
}

hashdecl XsdAnnotationGrammarFrame {
    string name;
    bool annotation = False;
    bool content = False;
}

#! Validate annotation markup and declaration IDs before the XML tree is grouped by child name.
class XsdAnnotationGrammarHelper {
    private {
        hash<string, bool> ids;
        hash<string, hash<XsdAnnotationGrammarFrame>> frames;
        int annotation_depth = -1;
        int payload_depth = -1;
    }

    consume(XmlReader reader) {
        int depth = reader.depth();
        int kind = reader.nodeType();
        if (payload_depth >= 0) {
            if (kind == XML_NODE_TYPE_END_ELEMENT && depth == payload_depth) {
                payload_depth = -1;
            }
            return;
        }
        if (kind == XML_NODE_TYPE_END_ELEMENT) {
            remove frames{string(depth)};
            if (depth == annotation_depth) {
                annotation_depth = -1;
            }
            return;
        }
        if (kind != XML_NODE_TYPE_ELEMENT) {
            if (annotation_depth >= 0 && (kind == XML_NODE_TYPE_TEXT || kind == XML_NODE_TYPE_CDATA
                    || kind == XML_NODE_TYPE_SIGNIFICANT_WHITESPACE)
                    && XsdSimpleType::normalizeWhiteSpace(reader.value() ?? "", "collapse")) {
                throw WSDL_ERROR, "annotation cannot contain character data outside appinfo or documentation";
            }
            return;
        }
        string local = reader.localName();
        bool xsd = reader.namespaceUri() == XSD_NS;
        if (annotation_depth >= 0) {
            if (!xsd || (local != "appinfo" && local != "documentation")) {
                throw WSDL_ERROR, "annotation content must be XSD appinfo or documentation";
            }
            attributes(reader, local);
            payload_depth = reader.isEmptyElement() ? -1 : depth;
            return;
        }
        if (!xsd) {
            return;
        }
        *hash<XsdAnnotationGrammarFrame> parent = frames{string(depth - 1)};
        if (parent) {
            if (local == "annotation") {
                if (parent.name != "schema" && parent.name != "redefine"
                        && (parent.annotation || parent.content)) {
                    throw WSDL_ERROR, "annotation must occur once before other schema component content";
                }
                parent.annotation = True;
            } else {
                parent.content = True;
            }
            frames{string(depth - 1)} = parent;
        }
        if (!reader.isEmptyElement()) {
            frames{string(depth)} = <XsdAnnotationGrammarFrame>{"name": local};
        }
        if (local == "appinfo" || local == "documentation") {
            throw WSDL_ERROR, sprintf("XSD %s must be a direct annotation child", local);
        }
        if (local == "annotation") {
            attributes(reader, local);
            annotation_depth = reader.isEmptyElement() ? -1 : depth;
        }
        if (reader.moveToAttribute("id")) {
            on_exit reader.moveToElement();
            string id = XsdNameLexicalHelper::lexical("ID", reader.value(), WSDL_ERROR);
            if (ids{id}) {
                throw WSDL_ERROR, sprintf("duplicate schema declaration ID %Y", id);
            }
            ids{id} = True;
        }
    }

    private static attributes(XmlReader reader, string element) {
        if (!reader.moveToFirstAttribute()) {
            return;
        }
        on_exit reader.moveToElement();
        do {
            *string uri = reader.namespaceUri();
            string local = reader.localName();
            if (uri && uri != XSD_NS) {
                if (element == "documentation" && uri == "http://www.w3.org/XML/1998/namespace"
                        && local == "lang") {
                    string language = XsdTextLexicalHelper::lexical("language", reader.value(), WSDL_ERROR);
                }
                continue;
            }
            if (!uri && element == "annotation" && local == "id") {
                continue;
            }
            if (!uri && element != "annotation" && local == "source") {
                try {
                    string normalized = normalize_xsd_uri(reader.value() ?? "");
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err != "XSD-URI-LEXICAL-ERROR") {
                        rethrow;
                    }
                    throw WSDL_ERROR, ex.desc;
                }
                continue;
            }
            throw WSDL_ERROR, sprintf("unexpected attribute {%s}%s on XSD %s", uri ?? "", local, element);
        } while (reader.moveToNextAttribute());
    }
}

#! An XSD identity-constraint category
/** @since %WSDL 0.5.8 */
public enum XsdIdentityCategory : string {
    #! Every selected row supplies a distinct complete key
    Key = "key",
    #! Complete selected rows have distinct values
    Unique = "unique",
    #! Complete selected rows reference a key or unique definition
    KeyRef = "keyref",
}

#! An axis in the restricted XSD identity XPath language
/** @since %WSDL 0.5.8 */
public enum XsdIdentityAxis : string {
    #! The context element itself
    Self = "self",
    #! Direct child elements
    Child = "child",
    #! Attributes of the context element
    Attribute = "attribute",
}

#! One namespace-expanded identity XPath step
/** @since %WSDL 0.5.8 */
public hashdecl XsdIdentityStepInfo {
    #! The selected axis
    XsdIdentityAxis axis;
    #! Namespace URI, empty for unqualified names, or NOTHING for any namespace
    *string namespace_uri;
    #! Local name, or NOTHING for a wildcard or self step
    *string local_name;
}

#! One alternative of a restricted identity XPath
/** @since %WSDL 0.5.8 */
public hashdecl XsdIdentityPathInfo {
    #! Whether the path begins with descendant-or-self selection
    bool descendants = False;
    #! Ordered steps, including explicit self steps
    list<hash<XsdIdentityStepInfo>> steps;
}

#! Lexical identity XPath with declaration-owned prefix bindings
/** Unqualified name tests always select no-namespace names. The XML default
    namespace does not participate. Only referenced prefixes are retained.
    @since %WSDL 0.5.8
*/
public hashdecl XsdIdentityPathSource {
    #! Original selector or field attribute text
    string expression;
    #! Prefix-to-URI mappings used by qualified name tests
    hash<string, string> namespaces;
}

#! Portable identity-constraint component metadata
/** All fields contain values, without schema, element or registry backlinks.
    @since %WSDL 0.5.8
*/
public hashdecl XsdIdentityConstraintInfo {
    #! Schema target namespace, or an empty string
    string namespace_uri;
    #! Declared NCName
    string local_name;
    #! Key, unique, or keyref
    XsdIdentityCategory category;
    #! Selector expression and its own prefix context
    hash<XsdIdentityPathSource> selector;
    #! Ordered field expressions and their separate prefix contexts
    list<hash<XsdIdentityPathSource>> fields;
    #! Referenced component namespace for a keyref, including an empty no-namespace URI
    *string refer_namespace_uri;
    #! Referenced component local name for a keyref
    *string refer_local_name;
}

class XsdIdentityPathHelper {
    static list<hash<XsdIdentityPathInfo>> compile(string text, bool field,
            code<*string(string)> lookup, reference<hash<string, string>> bindings, string error) {
        list<hash<XsdIdentityPathInfo>> result();
        text = XsdSimpleType::normalizeWhiteSpace(text, "collapse");
        if (!text || text.endsWith("|")) {
            throw error, "an identity XPath requires a nonempty path in every union arm";
        }
        foreach string path in (text.split("|")) {
            path = XsdSimpleType::normalizeWhiteSpace(path, "collapse");
            bool descendants = path =~ /\A\. *\/\//;
            path =~ s/\A\. *\/\/ *//;
            if (!path || path.endsWith("/")) {
                throw error, "an identity XPath requires a nonempty path in every union arm";
            }
            list<hash<XsdIdentityStepInfo>> compiled();
            list<string> steps = path.split("/");
            foreach string step in (steps) {
                step = XsdSimpleType::normalizeWhiteSpace(step, "collapse");
                if (step == ".") {
                    compiled += <XsdIdentityStepInfo>{"axis": XsdIdentityAxis::Self};
                    continue;
                }
                bool attribute = step.startsWith("@");
                if (attribute) {
                    step = XsdSimpleType::normalizeWhiteSpace(step.substr(1), "collapse");
                } else if (step =~ /\Aattribute *::/) {
                    attribute = True;
                    step =~ s/\Aattribute *:: *//;
                } else {
                    step =~ s/\Achild *:: *//;
                }
                if (attribute && (!field || $# != steps.size() - 1)) {
                    throw error, "only an identity field's final step can select an attribute";
                }
                hash<XsdIdentityStepInfo> item = <XsdIdentityStepInfo>{
                    "axis": attribute ? XsdIdentityAxis::Attribute : XsdIdentityAxis::Child};
                if (step != "*") {
                    list<string> names = step.split(":");
                    if (names.size() == 2 && names[1] == "*") {
                        string prefix = XsdNameLexicalHelper::lexical("NCName", names[0], error);
                        if (prefix != names[0]) {
                            throw error, "whitespace cannot split an identity XPath name test";
                        }
                    } else {
                        string name = XsdNameLexicalHelper::lexical("QName", step, error);
                        if (name != step) {
                            throw error, "whitespace cannot split an identity XPath name test";
                        }
                        item.local_name = names[-1];
                    }
                    item.namespace_uri = "";
                    if (names.size() == 2) {
                        *string uri = lookup(names[0]);
                        if (!uri) {
                            throw error, sprintf("unbound identity XPath prefix %Y", names[0]);
                        }
                        bindings{names[0]} = uri;
                        item.namespace_uri = uri;
                    }
                }
                compiled += item;
            }
            result += <XsdIdentityPathInfo>{"descendants": descendants, "steps": compiled};
        }
        return result;
    }

    static hash<XsdIdentityPathSource> source(auto input, bool field,
            reference<list<hash<XsdIdentityPathInfo>>> paths, string error) {
        if (input.typeCode() != NT_HASH || input.size() != 2
                || input.expression.typeCode() != NT_STRING || input.namespaces.typeCode() != NT_HASH) {
            throw error, "an identity path requires expression text and a namespace map";
        }
        hash<string, string> retained();
        code<*string(string)> lookup = *string sub (string prefix) {
            auto uri = input.namespaces{prefix};
            if (prefix == "xml" && !exists uri) {
                return "http://www.w3.org/XML/1998/namespace";
            }
            if (exists uri && uri.typeCode() != NT_STRING) {
                throw error, "identity XPath namespace URIs must be strings";
            }
            return uri;
        };
        paths = compile(input.expression, field, lookup, \retained, error);
        # Validate reserved bindings and XML characters only for prefixes that are used.
        hash<string, string> checked = XsdQNameValueHelper::bindings(retained, error);
        return <XsdIdentityPathSource>{"expression": input.expression, "namespaces": retained};
    }
}

#! An immutable compiled XSD identity-constraint declaration
/** Retains declaration-owned paths and component names independently of a schema.
    Compiles declaration metadata; this object does not assess instance values.
    @par Example
    Inspect a catalog element's \c productCode definition and its ordered field
    paths before publishing an integration schema.
    @since %WSDL 0.5.8
*/
public final class XsdIdentityConstraint inherits Serializable {
    private {
        hash<XsdIdentityConstraintInfo> info;
        transient list<hash<XsdIdentityPathInfo>> selector_paths;
        transient list<list<hash<XsdIdentityPathInfo>>> field_paths;
    }
    #! Validates and compiles portable declaration metadata
    /** @param info expanded component names and declaration-scoped selector/fields
        @throw XSD-IDENTITY-CONSTRAINT-ERROR invalid metadata, paths or name bindings
    */
    constructor(hash<XsdIdentityConstraintInfo> info) {
        initialize(info, "XSD-IDENTITY-CONSTRAINT-ERROR");
    }
    private initialize(auto input, string error) {
        if (input.typeCode() != NT_HASH || input.namespace_uri.typeCode() != NT_STRING
                || input.local_name.typeCode() != NT_STRING || input.fields.typeCode() != NT_LIST
                || !input.fields || (input.category != "key" && input.category != "unique" && input.category != "keyref")) {
            throw error, "invalid identity-constraint metadata";
        }
        const hash<string, bool> members = {"namespace_uri": True, "local_name": True,
            "category": True, "selector": True, "fields": True,
            "refer_namespace_uri": True, "refer_local_name": True};
        foreach string key in (keys input) {
            if (!members{key}) {
                throw error, sprintf("unexpected identity-constraint member %Y", key);
            }
        }
        string name = XsdNameLexicalHelper::lexical("NCName", input.local_name, error);
        if (name != input.local_name) {
            throw error, "identity-constraint names must be normalized";
        }
        if (input.namespace_uri =~ /[^\x{9}\x{A}\x{D}\x{20}-\x{D7FF}\x{E000}-\x{FFFD}\x{10000}-\x{10FFFF}]/) {
            throw error, "identity-constraint namespaces require XML character text";
        }
        bool keyref = input.category == "keyref";
        if (keyref != exists input.refer_namespace_uri || keyref != exists input.refer_local_name) {
            throw error, "only keyrefs require a referenced component name";
        }
        if (keyref) {
            if (input.refer_namespace_uri.typeCode() != NT_STRING || input.refer_local_name.typeCode() != NT_STRING
                    || input.refer_namespace_uri =~ /[^\x{9}\x{A}\x{D}\x{20}-\x{D7FF}\x{E000}-\x{FFFD}\x{10000}-\x{10FFFF}]/) {
                throw error, "invalid referenced identity-constraint name";
            }
            string local = XsdNameLexicalHelper::lexical("NCName", input.refer_local_name, error);
            if (local != input.refer_local_name) {
                throw error, "referenced identity-constraint names must be normalized";
            }
        }
        list<hash<XsdIdentityPathInfo>> selector();
        hash<XsdIdentityPathSource> selector_source = XsdIdentityPathHelper::source(input.selector, False,
            \selector, error);
        list<hash<XsdIdentityPathSource>> fields();
        list<list<hash<XsdIdentityPathInfo>>> compiled_fields();
        foreach auto field in (input.fields) {
            list<hash<XsdIdentityPathInfo>> compiled();
            fields += XsdIdentityPathHelper::source(field, True, \compiled, error);
            compiled_fields += (compiled,);
        }
        info = <XsdIdentityConstraintInfo>{"namespace_uri": input.namespace_uri, "local_name": name,
            "category": input.category == "key" ? XsdIdentityCategory::Key
                : input.category == "unique" ? XsdIdentityCategory::Unique : XsdIdentityCategory::KeyRef,
            "selector": selector_source, "fields": fields,
            "refer_namespace_uri": input.refer_namespace_uri, "refer_local_name": input.refer_local_name};
        selector_paths = selector;
        field_paths = compiled_fields;
    }
    private:internal deserializeMembers(hash<auto> members) {
        if (members.size() != 1 || !members.hasKey("info")) {
            throw "DESERIALIZATION-ERROR", "an identity constraint requires its portable metadata";
        }
        initialize(members.info, "DESERIALIZATION-ERROR");
    }
    #! Returns the complete portable declaration
    /** @return value-semantic metadata without schema or registry backlinks */
    hash<XsdIdentityConstraintInfo> getInfo() {
        return info;
    }
    #! Returns the declaration's schema-wide expanded name
    /** @return the component name in \c {namespace}local form */
    string getExpandedName() {
        return type_qname(info.namespace_uri, info.local_name);
    }
    #! Returns the declaration category
    /** @return key, unique or keyref */
    XsdIdentityCategory getCategory() {
        return info.category;
    }
    #! Returns the referenced component name
    /** @return an expanded name for keyref, or NOTHING for key/unique */
    *string getReferencedName() {
        return info.category == XsdIdentityCategory::KeyRef
            ? type_qname(info.refer_namespace_uri, info.refer_local_name) : NOTHING;
    }
    #! Returns compiled selector alternatives
    /** @return ordered, namespace-expanded paths with value semantics */
    list<hash<XsdIdentityPathInfo>> getSelectorPaths() {
        return selector_paths;
    }
    #! Returns compiled alternatives for each field
    /** @return one ordered path list per field, in declaration order */
    list<list<hash<XsdIdentityPathInfo>>> getFieldPaths() {
        return field_paths;
    }
}

#! Schema-wide identity-constraint definitions retained by detached graphs
/** Publishes complete declaration sets before concurrent reads. Its serialized
    representation contains flat metadata, so graph restoration does not depend
    on the order in which referenced objects run their deserialize hooks.
    @par Example
    Resolve a saved order schema's line-item keyref to its declared unique key.
    @since %WSDL 0.5.8
*/
public class XsdIdentityConstraintRegistry inherits Serializable {
    private {
        transient hash<string, XsdIdentityConstraint> definitions();
    }
    private:internal hash<auto> serializeMembers(*hash<auto> members) {
        hash<string, hash<XsdIdentityConstraintInfo>> descriptions();
        foreach string key in (keys definitions) {
            descriptions{key} = definitions{key}.getInfo();
        }
        return {"definitions": descriptions};
    }
    private:internal deserializeMembers(hash<auto> members) {
        if (members.size() != 1 || members.definitions.typeCode() != NT_HASH) {
            throw "DESERIALIZATION-ERROR", "an identity registry requires its definition map";
        }
        hash<string, XsdIdentityConstraint> restored();
        foreach string key in (keys members.definitions) {
            try {
                restored{key} = new XsdIdentityConstraint(members.definitions{key});
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "XSD-IDENTITY-CONSTRAINT-ERROR" && ex.err != "RUNTIME-TYPE-ERROR"
                        && ex.err != "RUNTIME-OVERLOAD-ERROR" && ex.err != "HASHDECL-KEY-ERROR") {
                    rethrow;
                }
                throw "DESERIALIZATION-ERROR", ex.desc;
            }
        }
        validate(restored, "DESERIALIZATION-ERROR");
        definitions = restored;
    }
    private static validate(hash<string, XsdIdentityConstraint> candidates, string error) {
        foreach string key in (keys candidates) {
            XsdIdentityConstraint definition = candidates{key};
            if (definition.getExpandedName() != key) {
                throw error, "identity registry key does not match its component name";
            }
            *string ref = definition.getReferencedName();
            if (exists ref) {
                *XsdIdentityConstraint target = candidates{ref};
                if (!target || target.getCategory() == XsdIdentityCategory::KeyRef) {
                    throw error, sprintf("keyref %Y must reference a declared key or unique component %Y", key, ref);
                }
                if (definition.getFieldPaths().size() != target.getFieldPaths().size()) {
                    throw error, sprintf("keyref %Y and target %Y must have the same field count", key, ref);
                }
            }
        }
    }
    #! Validates and publishes a complete declaration map
    /** @param candidates immutable definitions indexed by expanded name
        @throw WSDL-ERROR inconsistent names, unresolved keyrefs or incompatible field counts
        @note This construction operation must precede concurrent reads.
    */
    replace(hash<string, XsdIdentityConstraint> candidates) {
        validate(candidates, WSDL_ERROR);
        definitions = candidates;
    }
    #! Returns all resolved definitions
    /** @return a value-semantic map of immutable declaration objects */
    hash<string, XsdIdentityConstraint> getDefinitions() {
        return definitions;
    }
    #! Looks up one definition
    /** @param name component name in \c {namespace}local form
        @return the definition, or NOTHING when absent
    */
    *XsdIdentityConstraint get(string name) {
        return definitions{name};
    }
}

class XsdIdentityDeclarationHelper {
    static hash<XsdIdentityPathSource> path(hash<auto> node, Namespaces nsc) {
        NamespacePrefixHelper scope(nsc, node."^attributes^");
        return <XsdIdentityPathSource>{"expression": node."^attributes^".xpath,
            "namespaces": nsc.getInputNamespaceState().input};
    }
    static XsdIdentityConstraint parse(string category, hash<auto> node, Namespaces nsc) {
        XsdBase::removeNS(\node);
        NamespacePrefixHelper scope(nsc, node."^attributes^");
        hash<auto> attrs = node."^attributes^";
        list<hash<XsdIdentityPathSource>> fields();
        foreach hash<auto> field in (node.field) {
            fields += path(field, nsc);
        }
        hash<XsdIdentityConstraintInfo> info = <XsdIdentityConstraintInfo>{
            "namespace_uri": nsc.getTargetNamespaceUri() ?? "",
            "local_name": XsdNameLexicalHelper::lexical("NCName", attrs.name, WSDL_ERROR),
            "category": category == "key" ? XsdIdentityCategory::Key
                : category == "unique" ? XsdIdentityCategory::Unique : XsdIdentityCategory::KeyRef,
            "selector": path(node.selector, nsc), "fields": fields};
        if (category == "keyref") {
            hash<auto> ref = nsc.getTypeHash(attrs.refer);
            info.refer_namespace_uri = ref.uri;
            info.refer_local_name = ref.val;
        }
        try {
            return new XsdIdentityConstraint(info);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "XSD-IDENTITY-CONSTRAINT-ERROR") {
                rethrow;
            }
            throw WSDL_ERROR, ex.desc;
        }
    }
}

hashdecl XsdIdentityGrammarFrame {
    string name = "";
    bool ignored = False;
    bool constraint = False;
    bool selector = False;
    int fields = 0;
}

#! Check identity declaration content while selector/field order is still available.
class XsdIdentityGrammarHelper {
    private {
        hash<string, hash<XsdIdentityGrammarFrame>> frames;
    }

    private static bool identity(string local) {
        return local == "key" || local == "unique" || local == "keyref";
    }

    private static finish(hash<XsdIdentityGrammarFrame> frame) {
        if (identity(frame.name) && (!frame.selector || !frame.fields)) {
            throw WSDL_ERROR, "an identity constraint requires one selector followed by one or more fields";
        }
    }

    consume(XmlReader reader) {
        int depth = reader.depth();
        int kind = reader.nodeType();
        string key = string(depth);
        if (kind == XML_NODE_TYPE_END_ELEMENT) {
            *hash<XsdIdentityGrammarFrame> frame = remove frames{key};
            if (frame && !frame.ignored) {
                finish(frame);
            }
            return;
        }
        *hash<XsdIdentityGrammarFrame> parent = frames{string(depth - 1)};
        if (kind != XML_NODE_TYPE_ELEMENT) {
            if (parent && !parent.ignored && (identity(parent.name)
                    || parent.name == "selector" || parent.name == "field")
                    && (kind == XML_NODE_TYPE_TEXT || kind == XML_NODE_TYPE_CDATA
                        || kind == XML_NODE_TYPE_SIGNIFICANT_WHITESPACE)
                    && XsdSimpleType::normalizeWhiteSpace(reader.value() ?? "", "collapse")) {
                throw WSDL_ERROR, "identity declarations cannot contain character data";
            }
            return;
        }
        bool xsd = reader.namespaceUri() == XSD_NS;
        string local = reader.localName();
        hash<XsdIdentityGrammarFrame> current = <XsdIdentityGrammarFrame>{
            "name": xsd ? local : "", "ignored": parent.ignored ?? False};
        if (!current.ignored) {
            if (parent && identity(parent.name)) {
                if (xsd && local == "annotation" && !parent.selector && !parent.fields) {
                    # Annotation cardinality and its own attributes are checked by the annotation helper.
                } else if (xsd && local == "selector" && !parent.selector && !parent.fields) {
                    parent.selector = True;
                } else if (xsd && local == "field" && parent.selector) {
                    ++parent.fields;
                } else {
                    throw WSDL_ERROR, "identity content requires an optional annotation, one selector, then fields";
                }
                frames{string(depth - 1)} = parent;
            } else if (parent && (parent.name == "selector" || parent.name == "field")) {
                if (!xsd || local != "annotation") {
                    throw WSDL_ERROR, "a selector or field permits only an optional annotation";
                }
            } else if (xsd && (local == "selector" || local == "field")) {
                throw WSDL_ERROR, "a selector or field must be a direct identity-constraint child";
            }
            if (xsd && identity(local)) {
                if (!parent || parent.name != "element") {
                    throw WSDL_ERROR, "an identity constraint must be a direct element-declaration child";
                }
                parent.constraint = True;
                frames{string(depth - 1)} = parent;
            } else if (parent && parent.name == "element" && parent.constraint) {
                throw WSDL_ERROR, "identity constraints must follow the element's type declaration";
            }
            if (xsd && (identity(local) || local == "selector" || local == "field")) {
                attributes(reader, local);
            }
            if (xsd && local == "annotation") {
                current.ignored = True;
            }
        }
        if (reader.isEmptyElement()) {
            if (!current.ignored) {
                finish(current);
            }
        } else {
            frames{key} = current;
        }
    }

    private static attributes(XmlReader reader, string element) {
        hash<string, string> values();
        if (reader.moveToFirstAttribute()) {
            on_exit reader.moveToElement();
            do {
                string uri = reader.namespaceUri() ?? "";
                string local = reader.localName();
                if (uri && uri != XSD_NS) {
                    continue;
                }
                if (uri || (local != "id" && !(identity(element) && local == "name")
                        && !(element == "keyref" && local == "refer")
                        && !((element == "selector" || element == "field") && local == "xpath"))) {
                    throw WSDL_ERROR, sprintf("unexpected attribute {%s}%s on identity declaration %s",
                        uri, local, element);
                }
                values{local} = reader.value() ?? "";
            } while (reader.moveToNextAttribute());
        }
        if (identity(element)) {
            string name = XsdNameLexicalHelper::lexical("NCName", values.name, WSDL_ERROR);
            if (element == "keyref") {
                string refer = XsdNameLexicalHelper::lexical("QName", values.refer, WSDL_ERROR);
                list<string> parts = refer.split(":");
                if (parts.size() == 2 && !reader.lookupNamespace(parts[0])) {
                    throw WSDL_ERROR, sprintf("unbound keyref prefix %Y", parts[0]);
                }
            }
        } else {
            if (!values.hasKey("xpath")) {
                throw WSDL_ERROR, sprintf("identity %s requires xpath", element);
            }
            xpath(values.xpath, element == "field", reader);
        }
    }

    private static xpath(string text, bool field, XmlReader reader) {
        hash<string, string> bindings();
        code<*string(string)> lookup = *string sub (string prefix) {
            return reader.lookupNamespace(prefix);
        };
        list<hash<XsdIdentityPathInfo>> paths = XsdIdentityPathHelper::compile(text, field, lookup,
            \bindings, WSDL_ERROR);
    }

}

#! Check the ordered XML representation before parseTypes merges namespace-qualified child names.
class XsdFacetGrammarHelper {
    private {
        hash<string, hash<XsdFacetGrammarFrame>> frames;
    }

    consume(XmlReader reader) {
        int depth = reader.depth();
        string key = string(depth);
        if (reader.nodeType() == XML_NODE_TYPE_END_ELEMENT) {
            remove frames{key};
            return;
        }
        *hash<XsdFacetGrammarFrame> parent = frames{string(depth - 1)};
        if (reader.nodeType() != XML_NODE_TYPE_ELEMENT) {
            if (parent && (parent.kind == XFG_RESTRICTION || parent.kind == XFG_FACET)
                    && (reader.nodeType() == XML_NODE_TYPE_TEXT || reader.nodeType() == XML_NODE_TYPE_CDATA
                        || reader.nodeType() == XML_NODE_TYPE_SIGNIFICANT_WHITESPACE)
                    && XsdSimpleType::normalizeWhiteSpace(reader.value() ?? "", "collapse").val()) {
                throw "XSD-SIMPLETYPE-ERROR", "facet and restriction declarations cannot contain character data";
            }
            return;
        }
        string local = reader.localName();
        bool xsd = reader.namespaceUri() == XSD_NS;
        hash<XsdFacetGrammarFrame> current();
        current.ignored = parent.ignored || (xsd && local == "annotation");
        if (parent && (parent.kind == XFG_SIMPLE_TYPE || parent.kind == XFG_SIMPLE_CONTENT)) {
            string error = parent.kind == XFG_SIMPLE_CONTENT ? WSDL_ERROR : "XSD-SIMPLETYPE-ERROR";
            if (!xsd) {
                throw error, sprintf("unexpected simple type derivation {%s}%s",
                    reader.namespaceUri() ?? "", local);
            }
            if (local == "annotation" && !parent.annotation && !parent.facets) {
                parent.annotation = True;
            } else if (!parent.facets && (local == "restriction"
                    || (parent.kind == XFG_SIMPLE_TYPE && (local == "list" || local == "union"))
                    || (parent.kind == XFG_SIMPLE_CONTENT && local == "extension"))) {
                parent.facets = True;
                if (local == "restriction") {
                    current.kind = XFG_RESTRICTION;
                    current.simple_content = parent.kind == XFG_SIMPLE_CONTENT;
                }
            } else {
                throw error, "simple type content requires an optional annotation then one derivation";
            }
            frames{string(depth - 1)} = parent;
        } else if (parent && (parent.kind == XFG_RESTRICTION || parent.kind == XFG_FACET)) {
            if (!xsd) {
                throw "XSD-SIMPLETYPE-ERROR", sprintf("unexpected restriction content {%s}%s",
                    reader.namespaceUri() ?? "", local);
            }
            if (local == "annotation") {
                if (parent.annotation || parent.inline_type || parent.facets || parent.attributes) {
                    throw "XSD-SIMPLETYPE-ERROR", "annotation must occur once, before other restriction content";
                }
                parent.annotation = True;
            } else if (parent.kind == XFG_FACET) {
                throw "XSD-SIMPLETYPE-ERROR", sprintf("unexpected facet child %Y", local);
            } else if (local == "simpleType") {
                if (parent.inline_type || parent.facets || parent.attributes) {
                    throw "XSD-SIMPLETYPE-ERROR", "inline simpleType must precede restriction facets";
                }
                parent.inline_type = True;
                current.kind = XFG_SIMPLE_TYPE;
            } else if (XsdFacetDeclarationHelper::Names{local}) {
                if (parent.attributes) {
                    throw "XSD-SIMPLETYPE-ERROR", "restriction facets must precede attributes";
                }
                parent.facets = True;
                current.kind = XFG_FACET;
                validateAttributes(reader, local);
            } else if (parent.simple_content
                    && (local == "attribute" || local == "attributeGroup" || local == "anyAttribute")) {
                if (parent.any_attribute) {
                    throw "XSD-SIMPLETYPE-ERROR", "anyAttribute must be the last restriction child";
                }
                parent.attributes = True;
                parent.any_attribute = local == "anyAttribute";
            } else {
                throw "XSD-SIMPLETYPE-ERROR", sprintf("unexpected restriction child %Y", local);
            }
            frames{string(depth - 1)} = parent;
        } else if (!current.ignored && xsd) {
            if (local == "simpleType") {
                current.kind = XFG_SIMPLE_TYPE;
            } else if (local == "simpleContent") {
                current.kind = XFG_SIMPLE_CONTENT;
            }
        }
        if (!reader.isEmptyElement()) {
            frames{key} = current;
        }
    }

    private static validateAttributes(XmlReader reader, string facet) {
        if (!reader.moveToFirstAttribute()) {
            return;
        }
        on_exit reader.moveToElement();
        do {
            *string uri = reader.namespaceUri();
            string name = reader.localName();
            if (uri) {
                if (uri != XSD_NS) {
                    continue;
                }
            } else if (name == "value" || name == "id"
                    || (name == "fixed" && facet != "pattern" && facet != "enumeration")) {
                continue;
            }
            throw "XSD-SIMPLETYPE-ERROR", sprintf("unexpected attribute {%s}%s on facet %Y", uri ?? "", name, facet);
        } while (reader.moveToNextAttribute());
    }
}

#! XSD simple type class
public class XsdSimpleType inherits WSDL::XsdAbstractType {
    private {
        hash<string, bool> fixedFacets;
        transient *list<hash<XsdQNameDeclarationLiteral>> pendingQNameEnumeration;
        *hash<string, hash<string, bool>> qnameEnumValues;
        *list<XsdQNameValue> qnameEnumeration;
        *list<XsdScopedLexicalValue> scopedUnionEnumeration;
        *hash<string, bool> stringEnumValues;
        *hash<XsdListItemInfo> listItemValueInfo;
        *list<list<auto>> listEnumValues;
        *hash<string, bool> listEnumKeys;
        const StringKinds = {"string": True, "normalizedString": True, "token": True, "language": True,
            "Name": True, "NCName": True, "NMTOKEN": True, "ID": True, "IDREF": True, "ENTITY": True,
            "anyURI": True};
    }

    public {
        hash<auto> enumValues;
        hash<auto> typeinfo;
        list<hash<auto>> union;
        list<XsdAbstractType> unionTypes;
        XsdAbstractType type;
        AbstractDataProviderType dataType;
        bool usedocns;

        #! XSD restriction facets
        #! Pattern facets declared in this restriction
        /** a value matching any one of them is valid (XSD 1.0 part 2 4.3.4.3)
        */
        *list<string> patterns;
        #! compiled \c pattern facets, matched against the whole value
        /** New constraints use immutable XsdCompiledPattern objects retaining the original XSD source.
            Older serialized anchored PCRE strings remain readable. Compilation happens once per restriction.

            @since %WSDL 0.5.8
        */
        *list<XsdPatternConstraint> pcre_patterns;
        #! String length facets
        *XsdFacetCount minLength;
        *XsdFacetCount maxLength;
        *XsdFacetCount length;
        #! Numeric range facets
        *auto minInclusive;
        *auto maxInclusive;
        *auto minExclusive;
        *auto maxExclusive;
        #! Numeric precision facets, retaining a decimal string beyond the native integer range
        /** @since %WSDL 0.5.8 uses XsdFacetCount to avoid bounded conversion */
        *XsdFacetCount totalDigits;
        #! maximum fractional digits, with exact arbitrary-size count representation
        /** @since %WSDL 0.5.8 uses XsdFacetCount to avoid bounded conversion */
        *XsdFacetCount fractionDigits;
        #! WhiteSpace facet
        *string whiteSpace;

        #! List type support
        *XsdAbstractType listItemType;
        *hash<auto> listItemTypeInfo;
    }

    #! constructs a simple type from its schema declaration
    /** @param st the parsed simpleType declaration
        @param nsc the declaration namespace context
        @param unresolved the schema's late resolution queue
        @param n_usedocns the schema's element form policy
        @param desc_name descriptive name for an anonymous declaration
        @param resolved_base already resolved simple content to restrict, when the XML base denotes a complex type
        @throw XSD-SIMPLETYPE-ERROR malformed restriction or non-simple resolved base
        @throw WSDL-ERROR invalid final controls, or forbidden block/abstract attributes
        @throw WSDL-NAMESPACE-ERROR invalid or unresolved base QName prefix
        @since %WSDL 0.5.8 supports resolved_base for simple-content restrictions
    */
    constructor(hash<auto> st, Namespaces nsc, XsdLateResolverHelper unresolved, bool n_usedocns, *string desc_name,
            *XsdAbstractType resolved_base)
            : XsdAbstractType(\st, nsc, desc_name,
                resolved_base ? new hash<string, bool>() : XsdDerivationControlHelper::forType(st."^attributes^", nsc, True)) {
        unresolved.addNotationDefinition(self);
        NamespacePrefixHelper declaration(nsc, st."^attributes^");
        if (exists st."^attributes^".block || exists st."^attributes^".abstract) {
            throw WSDL_ERROR, "simpleType cannot declare block or abstract";
        }
        usedocns = n_usedocns;
        #any a = st."^attributes^";
        delete st."^attributes^";

        WSDL::XsdBase::removeNS(\st);

        int alternatives = int(st.hasKey("restriction")) + int(st.hasKey("union")) + int(st.hasKey("list"));
        if (alternatives != 1) {
            throw "XSD-SIMPLETYPE-ERROR", sprintf("simpleType %Y requires exactly one restriction, list, or union", name);
        }
        if (st.hasKey("restriction")) {
            hash<auto> r = st.restriction ?? {};
            NamespacePrefixHelper restriction_scope(nsc, r."^attributes^");
            WSDL::XsdBase::removeNS(\r);

            *string base = r."^attributes^".base;
            if (exists base && r.hasKey("simpleType")) {
                throw "XSD-SIMPLETYPE-ERROR", "restriction cannot combine base and an inline simpleType";
            }
            if (!base && !resolved_base && !r.hasKey("simpleType")) {
                throw "XSD-SIMPLETYPE-ERROR", sprintf("missing 'base' attribute in simpleType %y restriction", name);
            }

            if (resolved_base) {
                if (!(resolved_base instanceof XsdSimpleType)
                        && (!(resolved_base instanceof XsdBaseType) || resolved_base.name == "anyType")) {
                    throw "XSD-SIMPLETYPE-ERROR", "resolved restriction base must be a simple type";
                }
                type = resolved_base;
            } else if (r.hasKey("simpleType")) {
                type = new XsdSimpleType(r.simpleType ?? {}, nsc, unresolved, n_usedocns);
            } else {
                nsc.doType(base, \typeinfo, \type);
            }

            WSDL::XsdBase::removeNS(\r);

            fixedFacets = XsdFacetDeclarationHelper::validate(r, nsc, \pendingQNameEnumeration);

            # Parse enumeration facet
            if (r.enumeration) {
                enumValues = map {$1."^attributes^".value: True}, r.enumeration;
            }

            # Parse pattern facets (multiple patterns allowed; they are combined with "|")
            if (r.pattern) {
                # Handle both single pattern (hash) and multiple patterns (list)
                if (r.pattern.typeCode() == NT_LIST) {
                    patterns = map $1."^attributes^".value, r.pattern;
                } else {
                    patterns = (r.pattern."^attributes^".value,);
                }
                # Compile the original XSD source once, independently of PCRE repetition/backtracking limits.
                if (patterns) {
                    try {
                        pcre_patterns = map XsdPatternConstraintHelper::compile($1), patterns;
                    } catch (hash<ExceptionInfo> ex) {
                        if (ex.err != "REGEX-ERROR" && ex.err != "REGEX-COMPILATION-ERROR"
                                && ex.err != "XSD-REGEX-ERROR") {
                            rethrow;
                        }
                        throw "XSD-SIMPLETYPE-ERROR", sprintf("invalid pattern facet: %s", ex.desc);
                    }
                }
            }

            # Parse length facets
            if (r.length) {
                length = XsdFacetCountHelper::parse("length", r.length."^attributes^".value);
            }
            if (r.minLength) {
                minLength = XsdFacetCountHelper::parse("minLength", r.minLength."^attributes^".value);
            }
            if (r.maxLength) {
                maxLength = XsdFacetCountHelper::parse("maxLength", r.maxLength."^attributes^".value);
            }

            # Parse numeric range facets
            if (r.minInclusive) {
                minInclusive = r.minInclusive."^attributes^".value;
            }
            if (r.maxInclusive) {
                maxInclusive = r.maxInclusive."^attributes^".value;
            }
            if (r.minExclusive) {
                minExclusive = r.minExclusive."^attributes^".value;
            }
            if (r.maxExclusive) {
                maxExclusive = r.maxExclusive."^attributes^".value;
            }

            # Parse precision facets
            if (r.totalDigits) {
                totalDigits = XsdFacetCountHelper::parse("totalDigits", r.totalDigits."^attributes^".value);
            }
            if (r.fractionDigits) {
                fractionDigits = XsdFacetCountHelper::parse("fractionDigits", r.fractionDigits."^attributes^".value);
            }

            # Parse whiteSpace facet
            if (r.whiteSpace) {
                whiteSpace = normalizeWhiteSpace(r.whiteSpace."^attributes^".value, "collapse");
            }
        } else if (st.hasKey("union")) {
            hash<auto> u = st.union ?? {};
            NamespacePrefixHelper union_scope(nsc, u."^attributes^");
            *string memberTypes = u."^attributes^".memberTypes;
            if (memberTypes) {
                foreach string str in (normalizeWhiteSpace(memberTypes, "collapse").split(" ")) {
                    union += nsc.getTypeHash(str);
                }
            }
            WSDL::XsdBase::removeNS(\u);
            # a union can have any number of anonymous simpleType member definitions
            foreach hash<auto> ust in (u.simpleType) {
                unionTypes += new XsdSimpleType(ust, nsc, unresolved, n_usedocns,
                    sprintf("simpleType %d for union simpleType %y", $# + 1, name));
            }

            if (!union && !unionTypes) {
                throw "XSD-SIMPLETYPE-ERROR", sprintf("union simpleType %Y requires a member type", name);
            }
        } else if (st.hasKey("list")) {
            hash<auto> l = st.list ?? {};
            NamespacePrefixHelper list_scope(nsc, l."^attributes^");
            WSDL::XsdBase::removeNS(\l);
            *string itemType = l."^attributes^".itemType;
            if (exists itemType && l.hasKey("simpleType")) {
                throw "XSD-SIMPLETYPE-ERROR", "list cannot combine itemType and an inline simpleType";
            }
            if (itemType) {
                nsc.doType(itemType, \listItemTypeInfo, \listItemType);
            } else if (l.simpleType) {
                # Inline simpleType definition for list items
                listItemType = new XsdSimpleType(l.simpleType, nsc, unresolved, n_usedocns);
            } else {
                throw "XSD-SIMPLETYPE-ERROR", sprintf("list definition in simpleType %y requires itemType attribute "
                    "or inline simpleType", name);
            }
        } else {
            throw "XSD-SIMPLETYPE-ERROR", sprintf("missing restriction, union, or list element in simpleType %y",
                name);
        }

        # Even builtin-only and inline declarations need kind checks and dependency finalization.
        unresolved.add(self);
    }

    finalizeResolved() {
        on_exit remove pendingQNameEnumeration;
        if (!type && unionTypes) {
            dataType = new UnionDataType(unionTypes);
        }
        *string numeric = getNumericBaseName();
        if (numeric) {
            validateNumericDeclaration(numeric);
        } else if (exists totalDigits || exists fractionDigits) {
            throw "XSD-SIMPLETYPE-ERROR", "totalDigits and fractionDigits apply only to decimal-derived types";
        }
        if (getCalendarBaseName()) {
            validateCalendarDeclaration();
        }
        if (getDurationBaseName()) {
            validateDurationDeclaration();
        }
        if (getBinaryBaseName()) {
            validateBinaryDeclaration();
        }
        string kind = getFacetKind();
        if ((kind == "QName" || kind == "NOTATION") && type) {
            validateQNameDeclaration();
        }
        if (kind == "union" && (exists minInclusive || exists minExclusive
                || exists maxInclusive || exists maxExclusive)) {
            throw "XSD-SIMPLETYPE-ERROR", "union restrictions permit only pattern and enumeration facets";
        }
        if (kind == "union" && type && enumValues) {
            if (exists pendingQNameEnumeration && XsdScopedLexicalHelper::schema(type)) {
                list<XsdScopedLexicalValue> retained();
                foreach hash<XsdQNameDeclarationLiteral> literal in (pendingQNameEnumeration) {
                    push retained, new XsdScopedLexicalValue(literal.original, literal.namespaces);
                }
                scopedUnionEnumeration = retained;
            }
            foreach auto lexical in (getUnionEnumerationValues()) {
                try {
                    cast<XsdSimpleType>(type).deserializeUnion("enumeration", new hash<string, XsdAbstractType>(),
                        NOTHING, lexical);
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err != SOAP_DESERIALIZATION_ERROR) {
                        rethrow;
                    }
                    throw "XSD-SIMPLETYPE-ERROR", sprintf("enumeration value %Y is not valid for union base of %Y: %s",
                        lexical, name, ex.desc);
                }
            }
        }
        if (kind == "boolean" && (enumValues || exists minInclusive || exists minExclusive
                || exists maxInclusive || exists maxExclusive)) {
            throw "XSD-SIMPLETYPE-ERROR", "boolean permits only pattern and whiteSpace facets";
        }
        validateLengthDeclaration(kind);
        validateWhitespaceDeclaration(kind);
        listItemValueInfo = listItemType ? XsdListValueHelper::describe(listItemType)
            : type instanceof XsdSimpleType ? cast<XsdSimpleType>(type).listItemValueInfo : NOTHING;
        if (listItemValueInfo && type && enumValues && exists pendingQNameEnumeration) {
            list<list<auto>> values();
            hash<string, bool> value_keys();
            foreach hash<XsdQNameDeclarationLiteral> literal in (pendingQNameEnumeration) {
                string lexical = literal.original;
                XsdQNameNamespaceScope declaration_scope(XsdQNameContextHelper::attributes(literal.namespaces), True);
                try {
                    *XsdSchemaUnionItemCapture caller = SchemaUnionListCapture;
                    on_exit SchemaUnionListCapture = caller;
                    if (listItemValueInfo.union_item) {
                        SchemaUnionListCapture = new XsdSchemaUnionItemCapture(XsdUnionValueHelper::listType(type));
                    }
                    list<auto> value = type.deserializeValue(name, new hash<string, XsdAbstractType>(), NOTHING, lexical);
                    string key = listItemValueInfo.union_item && SchemaUnionListCapture.identity
                        ? XsdUnionValueHelper::key(SchemaUnionListCapture.identity)
                        : XsdListValueHelper::key(listItemValueInfo, value, "XSD-SIMPLETYPE-ERROR");
                    if (!value_keys{key}) {
                        push values, value;
                        value_keys{key} = True;
                    }
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err != SOAP_DESERIALIZATION_ERROR) {
                        rethrow;
                    }
                    throw "XSD-SIMPLETYPE-ERROR", sprintf("list enumeration value %Y is not valid for the base of %Y: %s",
                        lexical, name, ex.desc);
                }
            }
            listEnumValues = values;
            listEnumKeys = value_keys;
        }
        if (type && (StringKinds{kind} || (kind == "list" && !hasNativeListValue())) && enumValues) {
            hash<string, bool> values();
            foreach string lexical in (keys enumValues) {
                try {
                    string value = type.deserializeValue(name, new hash<string, XsdAbstractType>(), NOTHING, lexical);
                    values{value} = True;
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err != SOAP_DESERIALIZATION_ERROR) {
                        rethrow;
                    }
                    throw "XSD-SIMPLETYPE-ERROR", sprintf("enumeration value %Y is not valid for the base of %Y: %s",
                        lexical, name, ex.desc);
                }
            }
            stringEnumValues = values;
        }
    }

    private XsdQNameValue validateQNameValue(auto input, *hash<string, string> bindings, string error) {
        auto scalar = XsdScalarTextHelper::value(input, error);
        XsdQNameValue value = getFacetKind() == "NOTATION"
            ? XsdNotationValueHelper::resolve(scalar, nsc.getNotationRegistry(), error, bindings).asQName()
            : XsdQNameValueHelper::resolve(scalar, error, bindings);
        *XsdSimpleType ancestor = self;
        while (ancestor) {
            if ((ancestor.patterns && !ancestor.matchesAnyPattern(value.getLexicalValue()))
                    || (exists ancestor.qnameEnumValues
                        && !ancestor.qnameEnumValues{value.getNamespaceUri()}{value.getLocalName()})) {
                throw error, sprintf("QName value %Y is outside simpleType %Y", value.getLexicalValue(), name);
            }
            ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
        }
        return value;
    }

    #! Returns enumeration literals with their declaration context when QName members require it
    /** @return scoped lexical values for contextual union declarations, ordinary strings otherwise */
    *list<auto> getUnionEnumerationValues() {
        return scopedUnionEnumeration ?? (enumValues ? keys enumValues : NOTHING);
    }

    private validateQNameDeclaration() {
        if (!exists pendingQNameEnumeration) {
            return;
        }
        hash<string, hash<string, bool>> values();
        list<XsdQNameValue> retained();
        foreach hash<XsdQNameDeclarationLiteral> literal in (pendingQNameEnumeration) {
            string lexical = XsdNameLexicalHelper::lexical("QName", literal.lexical, "XSD-SIMPLETYPE-ERROR");
            if (!exists literal.namespace_uri) {
                throw "XSD-SIMPLETYPE-ERROR", sprintf("unbound prefix in QName enumeration %Y for %Y", lexical, name);
            }
            int colon = lexical.find(":");
            string prefix = colon < 0 ? "" : lexical.substr(0, colon);
            XsdQNameValue value = XsdQNameValueHelper::resolve(lexical, "XSD-SIMPLETYPE-ERROR",
                {prefix: literal.namespace_uri});
            if (getFacetKind() == "NOTATION") {
                XsdNotationValue notation = XsdNotationValueHelper::resolve(value, nsc.getNotationRegistry(), "XSD-SIMPLETYPE-ERROR");
            }
            *XsdSimpleType ancestor = type instanceof XsdSimpleType ? cast<XsdSimpleType>(type) : NOTHING;
            while (ancestor) {
                if ((ancestor.patterns && !ancestor.matchesAnyPattern(lexical))
                        || (exists ancestor.qnameEnumValues
                            && !ancestor.qnameEnumValues{value.getNamespaceUri()}{value.getLocalName()})) {
                    throw "XSD-SIMPLETYPE-ERROR", sprintf("QName enumeration %Y for %Y is outside base type %Y",
                        lexical, name, ancestor.name);
                }
                ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
            }
            values{value.getNamespaceUri()}{value.getLocalName()} = True;
            push retained, value;
        }
        qnameEnumValues = values;
        qnameEnumeration = retained;
    }

    #! identifies list values through restriction and union derivation
    /** @return True when a native list can represent one member value
        @throw XSD-SIMPLETYPE-ERROR cyclic schema metadata
        @since %WSDL 0.5.8 caches shared member queries for each call
    */
    bool hasNativeListValue() {
        bool owner = !UnionMetadataContext;
        if (owner) {
            UnionMetadataContext = new XsdUnionMetadataContext();
        }
        on_exit if (owner) {
            remove UnionMetadataContext;
        }
        string identity = self.uniqueHash();
        if (UnionMetadataContext.native_lists.hasKey(identity)) {
            return UnionMetadataContext.native_lists{identity};
        }
        string key = "schema-list:" + identity;
        if (UnionMetadataContext.active{key}) {
            throw "XSD-SIMPLETYPE-ERROR", "cyclic union schema metadata";
        }
        UnionMetadataContext.active{key} = True;
        on_exit remove UnionMetadataContext.active{key};
        bool result = exists listItemType;
        if (!result && type) {
            result = type.hasNativeListValue();
        }
        if (!result) {
            foreach XsdAbstractType member in (unionTypes) {
                string member_key = member.uniqueHash();
                if (!UnionMetadataContext.native_lists.hasKey(member_key)) {
                    UnionMetadataContext.native_lists{member_key} = member.hasNativeListValue();
                }
                if (UnionMetadataContext.native_lists{member_key}) {
                    result = True;
                    break;
                }
            }
        }
        UnionMetadataContext.native_lists{identity} = result;
        return result;
    }

    private string getFacetKind() {
        if (listItemType) {
            return "list";
        }
        if (unionTypes) {
            return "union";
        }
        if (type instanceof XsdSimpleType) {
            return cast<XsdSimpleType>(type).getFacetKind();
        }
        @assert(type instanceof XsdBaseType);
        return type.name == "NMTOKENS" || type.name == "IDREFS" || type.name == "ENTITIES" ? "list" : type.name;
    }

    private validateLengthDeclaration(string kind) {
        bool sized = StringKinds{kind} || kind == "list" || kind == "hexBinary" || kind == "base64Binary"
            || kind == "QName" || kind == "NOTATION";
        if (!sized && (exists length || exists minLength || exists maxLength)) {
            throw "XSD-SIMPLETYPE-ERROR", sprintf("length facets do not apply to %Y", kind);
        }
        if (sized && (exists minInclusive || exists minExclusive || exists maxInclusive || exists maxExclusive)) {
            throw "XSD-SIMPLETYPE-ERROR", sprintf("ordered bounds do not apply to %Y", kind);
        }
        *XsdFacetCount exact = getEffectiveFacet("length");
        *XsdFacetCount minimum = getEffectiveFacet("minLength");
        *XsdFacetCount maximum = getEffectiveFacet("maxLength");
        bool builtin_list = kind == "list" && !hasNativeListValue();
        if (builtin_list && exists minLength && XsdFacetCountHelper::compare(minLength, 1) < 0) {
            throw "XSD-SIMPLETYPE-ERROR", "builtin token lists have an inherited minimum length of one";
        }
        if (exists minimum && exists maximum && XsdFacetCountHelper::compare(minimum, maximum) > 0) {
            throw "XSD-SIMPLETYPE-ERROR", "minLength must not exceed maxLength";
        }
        *XsdSimpleType ancestor = type instanceof XsdSimpleType ? cast<XsdSimpleType>(type) : NOTHING;
        while (ancestor) {
            foreach string facet in ("length", "minLength", "maxLength") {
                if (!exists self{facet} || !exists ancestor{facet}) {
                    continue;
                }
                int comparison = XsdFacetCountHelper::compare(self{facet}, ancestor{facet});
                if ((comparison && (facet == "length" || ancestor.fixedFacets{facet}))
                        || (facet == "minLength" && comparison < 0) || (facet == "maxLength" && comparison > 0)) {
                    throw "XSD-SIMPLETYPE-ERROR", sprintf("%s in %Y is not a valid base restriction", facet, name);
                }
            }
            ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
        }
        if (exists exact) {
            foreach string facet in ("minLength", "maxLength") {
                *XsdFacetCount bound = facet == "minLength" ? minimum : maximum;
                if (!exists bound) {
                    continue;
                }
                int comparison = XsdFacetCountHelper::compare(bound, exact);
                if ((facet == "minLength" && comparison > 0) || (facet == "maxLength" && comparison < 0)) {
                    throw "XSD-SIMPLETYPE-ERROR", sprintf("%s contradicts length in %Y", facet, name);
                }
                bool inherited = builtin_list && facet == "minLength" && !XsdFacetCountHelper::compare(bound, 1);
                ancestor = type instanceof XsdSimpleType ? cast<XsdSimpleType>(type) : NOTHING;
                while (ancestor) {
                    if (!exists ancestor.getEffectiveFacet("length") && exists ancestor{facet}
                            && !XsdFacetCountHelper::compare(bound, ancestor{facet})) {
                        inherited = True;
                        break;
                    }
                    ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
                }
                if (!inherited) {
                    throw "XSD-SIMPLETYPE-ERROR", sprintf("%s accompanying length must repeat an inherited value", facet);
                }
            }
        }
    }

    private validateWhitespaceDeclaration(string kind) {
        if (!exists whiteSpace) {
            return;
        }
        if (kind == "union") {
            throw "XSD-SIMPLETYPE-ERROR", "whiteSpace does not apply to union restrictions";
        }
        if ((!StringKinds{kind} || kind == "anyURI") && whiteSpace != "collapse") {
            throw "XSD-SIMPLETYPE-ERROR", sprintf("whiteSpace is fixed to collapse for %Y", kind);
        }
        const hash<string, int> rank = {"preserve": 0, "replace": 1, "collapse": 2};
        if (type && rank{whiteSpace} < rank{type.getWhiteSpace()}) {
            throw "XSD-SIMPLETYPE-ERROR", "whiteSpace must not weaken its base normalization";
        }
        *XsdSimpleType ancestor = type instanceof XsdSimpleType ? cast<XsdSimpleType>(type) : NOTHING;
        while (ancestor) {
            if (ancestor.fixedFacets.whiteSpace && whiteSpace != ancestor.whiteSpace) {
                throw "XSD-SIMPLETYPE-ERROR", "whiteSpace changes a fixed base facet";
            }
            ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
        }
    }

    private validateNumericDeclaration(string builtin) {
        if (exists length || exists minLength || exists maxLength) {
            throw "XSD-SIMPLETYPE-ERROR", sprintf("length facets do not apply to numeric type %Y", name);
        }
        if (exists whiteSpace && whiteSpace != "collapse") {
            throw "XSD-SIMPLETYPE-ERROR", "numeric types have whiteSpace fixed to collapse";
        }
        hash<XsdNumericFacetInfo> facets = getNumericFacets();
        XsdNumericFacetHelper::checkDefinition(facets, "XSD-SIMPLETYPE-ERROR");
        foreach string facet in (keys facets.bounds) {
            validateNumericBaseValue(facets.bounds{facet}, facet.endsWith("Exclusive") ? facet : NOTHING);
        }
        foreach string value in (facets.enumeration) {
            validateNumericBaseValue(value);
        }
        *XsdSimpleType ancestor = type instanceof XsdSimpleType ? cast<XsdSimpleType>(type) : NOTHING;
        hash<string, string> effective_bounds = facets.bounds;
        while (ancestor) {
            hash<XsdNumericFacetInfo> inherited = ancestor.getNumericFacets();
            foreach string bound in (keys inherited.bounds) {
                if (!exists effective_bounds{bound}) {
                    effective_bounds{bound} = inherited.bounds{bound};
                }
            }
            foreach string facet in ("totalDigits", "fractionDigits") {
                if (exists self{facet} && exists ancestor{facet}
                        && XsdFacetCountHelper::compare(self{facet}, ancestor{facet}) > 0) {
                    throw "XSD-SIMPLETYPE-ERROR", sprintf("%s in %Y widens its base restriction", facet, name);
                }
            }
            foreach string facet in (keys ancestor.fixedFacets) {
                if (!ancestor.fixedFacets{facet} || !exists self{facet}) {
                    continue;
                }
                bool changed = facet == "whiteSpace" ? self{facet} != ancestor{facet}
                    : facet == "totalDigits" || facet == "fractionDigits"
                        ? XsdFacetCountHelper::compare(self{facet}, ancestor{facet}) != 0
                    : !XsdNumericFacetHelper::equal(builtin, string(self{facet}), string(ancestor{facet}),
                        "XSD-SIMPLETYPE-ERROR");
                if (changed) {
                    throw "XSD-SIMPLETYPE-ERROR", sprintf("%s in %Y changes a fixed base facet", facet, name);
                }
            }
            ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
        }
        XsdNumericFacetHelper::checkBounds(builtin, XsdNumericFacetHelper::withBuiltinBounds(builtin, effective_bounds),
            "XSD-SIMPLETYPE-ERROR");
        *XsdFacetCount fractional = builtin == "decimal" ? getEffectiveFacet("fractionDigits") : 0;
        *XsdFacetCount total = getEffectiveFacet("totalDigits");
        if (exists fractional && exists total && XsdFacetCountHelper::compare(fractional, total) > 0) {
            throw "XSD-SIMPLETYPE-ERROR", "effective fractionDigits must not exceed totalDigits";
        }
    }

    private validateNumericBaseValue(string value, *string exclusive) {
        *XsdSimpleType ancestor = type instanceof XsdSimpleType ? cast<XsdSimpleType>(type) : NOTHING;
        bool repeated_endpoint = False;
        if (exclusive) {
            *XsdSimpleType base = ancestor;
            while (base) {
                if (exists base{exclusive}) {
                    repeated_endpoint = XsdNumericFacetHelper::equal(getNumericBaseName(), value,
                        string(base{exclusive}), "XSD-SIMPLETYPE-ERROR");
                    break;
                }
                base = base.type instanceof XsdSimpleType ? cast<XsdSimpleType>(base.type) : NOTHING;
            }
        }
        while (ancestor) {
            hash<XsdNumericFacetInfo> facets = ancestor.getNumericFacets();
            # A repeated exclusive endpoint may be outside the base value space (XSD 1.0 4.3.8-9).
            # Its lexical mapping, including inherited patterns, must still yield that endpoint.
            if (repeated_endpoint) {
                facets.bounds = {};
                remove facets.enumeration;
                remove facets.total_digits;
                remove facets.fraction_digits;
            }
            string checked = XsdNumericFacetHelper::validate(facets, value, "XSD-SIMPLETYPE-ERROR");
            ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
        }
    }

    AbstractDataProviderType getDataProviderType() {
        if (listItemType) {
            *hash<XsdListItemInfo> item = XsdListValueHelper::describe(listItemType);
            if (item && !item.union_item) {
                return new XsdListDataType(item);
            }
            return new ListDataType(listItemType.getDataProviderType());
        }
        if (listItemValueInfo) {
            return new XsdListRestrictionDataType(<XsdListFacetInfo>{"name": name,
                "length": length, "min_length": minLength, "max_length": maxLength,
                "patterns": pcre_patterns, "enumeration": listEnumValues}, listItemValueInfo,
                type.getDataProviderType());
        }
        if (getNumericBaseName()) {
            return new XsdNumericRestrictionDataType(getNumericFacets(), type.getDataProviderType());
        }
        if (getCalendarBaseName()) {
            return new XsdCalendarRestrictionDataType(getCalendarFacets(), type.getDataProviderType());
        }
        if (getDurationBaseName()) {
            return new XsdDurationRestrictionDataType(getDurationFacets(), type.getDataProviderType());
        }
        if (getBinaryBaseName()) {
            return new XsdBinaryRestrictionDataType(getBinaryFacets(), type.getDataProviderType());
        }
        string kind = getFacetKind();
        if (kind == "union" && type) {
            return new UnionDataType(self);
        }
        if (kind == "NOTATION") {
            *list<XsdNotationValue> values;
            if (exists qnameEnumeration) {
                values = map new XsdNotationValue($1.getNamespaceUri(), $1.getLexicalValue()), qnameEnumeration;
            }
            return new XsdNotationRestrictionDataType(<XsdNotationFacetInfo>{"name": name,
                "patterns": pcre_patterns, "enumeration": values},
                cast<XsdNotationDataType>(type.getDataProviderType()));
        }
        if (kind == "QName") {
            return new XsdQNameRestrictionDataType(<XsdQNameFacetInfo>{"name": name, "patterns": pcre_patterns,
                "enumeration": qnameEnumeration}, cast<XsdQNameDataType>(type.getDataProviderType()));
        }
        if (kind == "boolean") {
            return new XsdBooleanRestrictionDataType(<XsdBooleanFacetInfo>{"name": name,
                "patterns": pcre_patterns}, type.getDataProviderType());
        }
        bool builtin_list = kind == "list" && !hasNativeListValue();
        if (StringKinds{kind} || builtin_list || ((kind == "list" || kind == "hexBinary" || kind == "base64Binary")
                && (exists length || exists minLength || exists maxLength))) {
            return new XsdSizedRestrictionDataType(<XsdSizedFacetInfo>{
                "name": name, "kind": StringKinds{kind} ? "string"
                    : kind == "list" ? (hasNativeListValue() ? "list" : "tokens") : "binary",
                "white_space": getWhiteSpace(), "length": length, "min_length": minLength,
                "max_length": maxLength, "patterns": (StringKinds{kind} || builtin_list) ? pcre_patterns : NOTHING,
                "enumeration": exists stringEnumValues ? keys stringEnumValues : NOTHING,
            }, type.getDataProviderType());
        }
        return dataType ?? type.getDataProviderType();
    }

    private *string getCalendarBaseName() {
        string kind = getFacetKind();
        return XsdCalendarLexicalHelper::isType(kind) ? kind : NOTHING;
    }

    private hash<XsdCalendarFacetInfo> getCalendarFacets() {
        *string builtin = getCalendarBaseName();
        @assert(builtin);
        hash<XsdCalendarFacetInfo> result = <XsdCalendarFacetInfo>{
            "name": name, "base_name": builtin, "patterns": pcre_patterns,
        };
        foreach string facet in ("minInclusive", "minExclusive", "maxInclusive", "maxExclusive") {
            if (exists self{facet}) {
                result.bounds{facet} = XsdCalendarLexicalHelper::lexical(builtin, self{facet}, "XSD-SIMPLETYPE-ERROR");
            }
        }
        if (enumValues) {
            result.enumeration = keys enumValues;
        }
        return result;
    }

    private validateCalendarDeclaration() {
        hash<XsdCalendarFacetInfo> facets = getCalendarFacets();
        XsdCalendarFacetHelper::checkDefinition(facets, "XSD-SIMPLETYPE-ERROR");
        foreach string facet in (keys facets.bounds) {
            validateCalendarBaseValue(facets.bounds{facet}, facet.endsWith("Exclusive") ? facet : NOTHING);
        }
        foreach string value in (facets.enumeration) {
            validateCalendarBaseValue(value);
        }
        *XsdSimpleType ancestor = type instanceof XsdSimpleType ? cast<XsdSimpleType>(type) : NOTHING;
        hash<string, string> effective = facets.bounds;
        while (ancestor) {
            hash<XsdCalendarFacetInfo> inherited = ancestor.getCalendarFacets();
            foreach string bound in (keys inherited.bounds) {
                if (!exists effective{bound}) {
                    effective{bound} = inherited.bounds{bound};
                }
                if (ancestor.fixedFacets{bound} && exists facets.bounds{bound}
                        && XsdCalendarLexicalHelper::key(facets.base_name, facets.bounds{bound}, "XSD-SIMPLETYPE-ERROR")
                            != XsdCalendarLexicalHelper::key(facets.base_name, inherited.bounds{bound}, "XSD-SIMPLETYPE-ERROR")) {
                    throw "XSD-SIMPLETYPE-ERROR", sprintf("%s in %Y changes a fixed calendar bound", bound, name);
                }
            }
            ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
        }
        XsdCalendarFacetHelper::checkBounds(facets.base_name, effective, "XSD-SIMPLETYPE-ERROR");
    }

    private validateCalendarBaseValue(string value, *string exclusive) {
        *XsdSimpleType ancestor = type instanceof XsdSimpleType ? cast<XsdSimpleType>(type) : NOTHING;
        bool repeated = False;
        if (exclusive) {
            *XsdSimpleType candidate = ancestor;
            while (candidate) {
                if (exists candidate{exclusive}) {
                    repeated = XsdCalendarLexicalHelper::key(getCalendarBaseName(), value, "XSD-SIMPLETYPE-ERROR")
                        == XsdCalendarLexicalHelper::key(getCalendarBaseName(), candidate{exclusive}, "XSD-SIMPLETYPE-ERROR");
                    break;
                }
                candidate = candidate.type instanceof XsdSimpleType ? cast<XsdSimpleType>(candidate.type) : NOTHING;
            }
        }
        while (ancestor) {
            hash<XsdCalendarFacetInfo> facets = ancestor.getCalendarFacets();
            if (repeated) {
                # XSD 1.0 permits repetition of an inherited exclusive endpoint,
                # including an endpoint excluded from the base value space.
                facets.bounds = {};
                remove facets.enumeration;
            }
            string checked = XsdCalendarFacetHelper::validate(facets, value, "XSD-SIMPLETYPE-ERROR");
            ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
        }
    }

    private *string getBinaryBaseName() {
        string kind = getFacetKind();
        return XsdBinaryLexicalHelper::isType(kind) ? kind : NOTHING;
    }

    private hash<XsdBinaryFacetInfo> getBinaryFacets() {
        return <XsdBinaryFacetInfo>{"name": name, "base_name": getBinaryBaseName(),
            "patterns": pcre_patterns, "enumeration": enumValues ? keys enumValues : NOTHING,
            "length": length, "min_length": minLength, "max_length": maxLength};
    }

    private validateBinaryDeclaration() {
        hash<XsdBinaryFacetInfo> facets = getBinaryFacets();
        XsdBinaryFacetHelper::checkDefinition(facets, "XSD-SIMPLETYPE-ERROR");
        foreach string lexical in (facets.enumeration) {
            try {
                auto checked = type.deserializeValue(name, new hash<string, XsdAbstractType>(), NOTHING, lexical);
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != SOAP_DESERIALIZATION_ERROR) {
                    rethrow;
                }
                throw "XSD-SIMPLETYPE-ERROR", sprintf("invalid base value in binary enumeration: %s", ex.desc);
            }
        }
    }

    private *string getDurationBaseName() {
        return getFacetKind() == "duration" ? "duration" : NOTHING;
    }

    private hash<XsdDurationFacetInfo> getDurationFacets() {
        *string builtin = getDurationBaseName();
        @assert(builtin);
        hash<XsdDurationFacetInfo> result = <XsdDurationFacetInfo>{
            "name": name, "base_name": builtin, "patterns": pcre_patterns,
        };
        foreach string facet in ("minInclusive", "minExclusive", "maxInclusive", "maxExclusive") {
            if (exists self{facet}) {
                result.bounds{facet} = XsdDurationLexicalHelper::lexical(self{facet}, "XSD-SIMPLETYPE-ERROR");
            }
        }
        if (enumValues) {
            result.enumeration = keys enumValues;
        }
        return result;
    }

    private validateDurationDeclaration() {
        hash<XsdDurationFacetInfo> facets = getDurationFacets();
        XsdDurationFacetHelper::checkDefinition(facets, "XSD-SIMPLETYPE-ERROR");
        foreach string facet in (keys facets.bounds) {
            validateDurationBaseValue(facets.bounds{facet}, facet.endsWith("Exclusive") ? facet : NOTHING);
        }
        foreach string value in (facets.enumeration) {
            validateDurationBaseValue(value);
        }
        *XsdSimpleType ancestor = type instanceof XsdSimpleType ? cast<XsdSimpleType>(type) : NOTHING;
        hash<string, string> effective = facets.bounds;
        while (ancestor) {
            hash<XsdDurationFacetInfo> inherited = ancestor.getDurationFacets();
            foreach string bound in (keys inherited.bounds) {
                if (!exists effective{bound}) {
                    effective{bound} = inherited.bounds{bound};
                }
                if (ancestor.fixedFacets{bound} && exists facets.bounds{bound}
                        && XsdDurationValueHelper::key(facets.bounds{bound}, "XSD-SIMPLETYPE-ERROR")
                            != XsdDurationValueHelper::key(inherited.bounds{bound}, "XSD-SIMPLETYPE-ERROR")) {
                    throw "XSD-SIMPLETYPE-ERROR", sprintf("%s in %Y changes a fixed duration bound", bound, name);
                }
            }
            ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
        }
        XsdDurationFacetHelper::checkBounds(facets.base_name, effective, "XSD-SIMPLETYPE-ERROR");
    }

    private validateDurationBaseValue(string value, *string exclusive) {
        *XsdSimpleType ancestor = type instanceof XsdSimpleType ? cast<XsdSimpleType>(type) : NOTHING;
        bool repeated = False;
        if (exclusive) {
            *XsdSimpleType candidate = ancestor;
            while (candidate) {
                if (exists candidate{exclusive}) {
                    repeated = XsdDurationValueHelper::key(value, "XSD-SIMPLETYPE-ERROR")
                        == XsdDurationValueHelper::key(candidate{exclusive}, "XSD-SIMPLETYPE-ERROR");
                    break;
                }
                candidate = candidate.type instanceof XsdSimpleType ? cast<XsdSimpleType>(candidate.type) : NOTHING;
            }
        }
        while (ancestor) {
            hash<XsdDurationFacetInfo> facets = ancestor.getDurationFacets();
            if (repeated) {
                # XSD 1.0 permits repetition of an inherited exclusive endpoint,
                # including an endpoint excluded from the base value space.
                facets.bounds = {};
                remove facets.enumeration;
            }
            string checked = XsdDurationFacetHelper::validate(facets, value, "XSD-SIMPLETYPE-ERROR");
            ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
        }
    }

    private *string getNumericBaseName() {
        *XsdAbstractType base = type;
        while (base instanceof XsdSimpleType) {
            base = cast<XsdSimpleType>(base).type;
        }
        if (base instanceof XsdBaseType && XsdNumericFacetHelper::isType(base.name)) {
            return base.name;
        }
    }

    private hash<XsdNumericFacetInfo> getNumericFacets() {
        *string base = getNumericBaseName();
        @assert(base);
        hash<XsdNumericFacetInfo> result = <XsdNumericFacetInfo>{
            "name": name, "base_name": base, "patterns": pcre_patterns,
            "bounds": {}, "total_digits": totalDigits, "fraction_digits": fractionDigits,
        };
        foreach string facet in ("minInclusive", "minExclusive", "maxInclusive", "maxExclusive") {
            auto value = self{facet};
            if (exists value) {
                result.bounds{facet} = XsdNumericFacetHelper::lexical(base, value, "XSD-SIMPLETYPE-ERROR");
            }
        }
        if (enumValues) {
            result.enumeration = map XsdNumericFacetHelper::lexical(base, $1, "XSD-SIMPLETYPE-ERROR"), keys enumValues;
        }
        return result;
    }

    private bool enumerationAccepts(auto value, *hash<XsdUnionValueIdentity> identity) {
        if (exists listEnumKeys) {
            if (listItemValueInfo.union_item && identity) {
                return boolean(listEnumKeys{XsdUnionValueHelper::key(identity)});
            }
            return boolean(listEnumKeys{XsdListValueHelper::key(listItemValueInfo, value,
                "XSD-SIMPLETYPE-ERROR")});
        }
        if (exists stringEnumValues) {
            return boolean(stringEnumValues{value});
        }
        # Numeric enumeration is checked together with the other value facets.
        return getNumericBaseName() || getCalendarBaseName() || getDurationBaseName() || !enumValues || boolean(enumValues{value});
    }

    *list<auto> getAllowedValues() {
        if (getFacetKind() == "QName" || getFacetKind() == "NOTATION") {
            *XsdSimpleType ancestor = self;
            while (ancestor) {
                if (exists ancestor.qnameEnumeration) {
                    list<auto> choices();
                    hash<string, hash<string, bool>> seen();
                    foreach XsdQNameValue literal in (ancestor.qnameEnumeration) {
                        *XsdQNameValue candidate = getQNameChoice(literal);
                        if (candidate && !seen{candidate.getNamespaceUri()}{candidate.getLocalName()}) {
                            push choices, getFacetKind() == "NOTATION"
                                ? new XsdNotationValue(candidate.getNamespaceUri(), candidate.getLexicalValue()) : candidate;
                            seen{candidate.getNamespaceUri()}{candidate.getLocalName()} = True;
                        }
                    }
                    return choices;
                }
                ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
            }
            return;
        }
        if (getBinaryBaseName()) {
            *XsdSimpleType ancestor = self;
            while (ancestor) {
                if (ancestor.enumValues) {
                    list<auto> result();
                    hash<string, bool> seen();
                    foreach string lexical in (keys ancestor.enumValues) {
                        string key = XsdBinaryFacetHelper::key(getBinaryBaseName(), lexical, "XSD-SIMPLETYPE-ERROR");
                        auto choice = getBinaryChoice(lexical);
                        if (exists choice && !seen{key}) {
                            push result, choice;
                            seen{key} = True;
                        }
                    }
                    return result;
                }
                ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
            }
            return;
        }
        if (getCalendarBaseName() || getDurationBaseName()) {
            *XsdSimpleType ancestor = self;
            while (ancestor) {
                if (ancestor.enumValues) {
                    list<auto> choices();
                    foreach string lexical in (keys ancestor.enumValues) {
                        if (acceptsSample(lexical)) {
                            push choices, getEnumValue(lexical);
                        }
                    }
                    return choices;
                }
                ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
            }
            return;
        }
        if (listItemValueInfo) {
            *XsdSimpleType ancestor = self;
            while (ancestor) {
                if (exists ancestor.listEnumValues) {
                    return ancestor.listEnumValues;
                }
                ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
            }
            return;
        }
        if (StringKinds{getFacetKind()} || (getFacetKind() == "list" && !hasNativeListValue())) {
            *XsdSimpleType ancestor = self;
            while (ancestor) {
                if (exists ancestor.stringEnumValues) {
                    return select keys ancestor.stringEnumValues, acceptsSample($1);
                }
                ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
            }
            return;
        }
        if (!enumValues) {
            return;
        }
        # enumeration values are stored as hash keys and are therefore always strings; convert them to the value
        # type of the restricted type, otherwise numeric, boolean, and date enumerations are reported as strings
        if (getFacetKind() == "union") {
            return map getEnumValue($1), getUnionEnumerationValues();
        }
        return map getEnumValue($1), keys enumValues;
    }

    #! returns the enumeration value converted to the value type of the restricted type
    private auto getEnumValue(auto val) {
        if (!type) {
            return val;
        }
        try {
            return type.deserializeValue(name, new hash<string, XsdAbstractType>(), NOTHING, val);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != SOAP_DESERIALIZATION_ERROR || getFacetKind() == "union") {
                rethrow;
            }
            # if the enumeration value cannot be converted, then report it as declared in the schema
            return val;
        }
    }

    auto serializeValue(Namespaces nsc, auto val, *softbool omitType) {
        *XsdScopedLexicalContext lexical_scope;
        if (val instanceof XsdScopedLexicalValue) {
            lexical_scope = new XsdScopedLexicalContext(val, nsc);
            val = val.getLexicalValue();
        }
        if (getFacetKind() == "QName" || getFacetKind() == "NOTATION") {
            hash<string, string> bindings = XsdScopedLexicalContext::serializationBindings(nsc,
                val.typeCode() == NT_HASH ? val."^attributes^" : NOTHING);
            auto serialized = type.serializeValue(nsc, validateQNameValue(val, bindings, SOAP_SERIALIZATION_ERROR), omitType);
            hash<auto> retained_comments();
            if (val.typeCode() == NT_HASH) {
                foreach string key in (keys val) {
                    if (key.startsWith("^comment")) {
                        retained_comments{key} = val{key};
                    }
                }
            }
            return XsdScalarTextHelper::withComments(retained_comments, serialized);
        }
        *hash<auto> rh;
        if (val.typeCode() == NT_HASH) {
            foreach string k in (keys val) {
                if (k =~ /^\^comment/) {
                    rh{k} = remove val{k};
                }
            }
            if (val.size() == 1 && val.firstKey() == "^value^") {
                val = val."^value^";
            }
        }

        # Handle list type serialization
        if (listItemType) {
            return serializeList(nsc, val, omitType, rh);
        }

        if (listItemValueInfo) {
            *XsdSchemaUnionItemCapture caller = SchemaUnionListCapture;
            *XsdSimpleType target = listItemValueInfo.union_item ? XsdUnionValueHelper::listType(type) : NOTHING;
            bool capture_owner = target && (!caller || caller.target !== target);
            on_exit if (capture_owner) {
                SchemaUnionListCapture = caller;
            }
            if (capture_owner) {
                SchemaUnionListCapture = new XsdSchemaUnionItemCapture(target);
            }
            auto serialized = type.serializeValue(nsc, val, omitType);
            auto text = XsdScalarTextHelper::value(serialized, SOAP_SERIALIZATION_ERROR);
            string lexical = text instanceof XsdQNameOutputText ? text.getLexicalValue() : string(text);
            list<auto> items = (listItemValueInfo.builtin == "QName" || listItemValueInfo.builtin == "NOTATION") ? (val.typeCode() == NT_LIST ? val : (val,))
                : XsdListValueHelper::tokens(lexical);
            validateFacets(items, "serialize", lexical);
            if (!enumerationAccepts(items, listItemValueInfo.union_item ? SchemaUnionListCapture.identity : NOTHING)) {
                throw SOAP_SERIALIZATION_ERROR, sprintf("list value for %Y is outside its enumeration", name);
            }
            return XsdScalarTextHelper::withComments(rh, serialized);
        }

        if (getFacetKind() == "boolean") {
            string lexical = XsdBooleanLexicalHelper::lexical(
                XsdScalarTextHelper::value(val, SOAP_SERIALIZATION_ERROR), SOAP_SERIALIZATION_ERROR);
            validateFacets(lexical, "serialize", lexical);
            auto serialized = type.serializeValue(nsc, val, omitType);
            if (patterns) {
                if (serialized.typeCode() == NT_HASH) {
                    serialized."^value^" = lexical;
                } else {
                    serialized = lexical;
                }
            }
            if (rh) {
                if (serialized.typeCode() == NT_HASH) {
                    return rh + serialized;
                }
                rh."^value^" = serialized;
                return rh;
            }
            return serialized;
        }

        if (getFacetKind() == "union") {
            hash<XsdSchemaUnionTrialResult> result = serializeUnion(nsc, val, omitType);
            auto converted = result.owner && !SchemaUnionValueProbe ? preserveUnionLexical(nsc, val, result) : result.value;
            if (XsdQNameOutputScope::retains(nsc) && result.namespace_sensitive && val.typeCode() == NT_STRING
                    && (!result.identity || result.identity.family != "QName")) {
                converted = new XsdScopedLexicalValue(XsdUnionValueHelper::text(converted, SOAP_SERIALIZATION_ERROR),
                    XsdScopedLexicalHelper::usedBindings(val,
                        XsdScopedLexicalContext::serializationBindings(nsc)));
            }
            if (SchemaUnionItemCapture && SchemaUnionItemCapture.target === self) {
                SchemaUnionItemCapture.identity = result.identity;
            }
            return XsdScalarTextHelper::withComments(rh, converted);
        }

        if (getCalendarBaseName()) {
            string lexical = XsdCalendarFacetHelper::validate(getCalendarFacets(), val, SOAP_SERIALIZATION_ERROR);
            return XsdScalarTextHelper::withComments(rh, type.serializeValue(nsc, lexical, omitType));
        }
        if (getDurationBaseName()) {
            string lexical = XsdDurationFacetHelper::validate(getDurationFacets(), val, SOAP_SERIALIZATION_ERROR);
            return XsdScalarTextHelper::withComments(rh, type.serializeValue(nsc, lexical, omitType));
        }
        if (getBinaryBaseName()) {
            string lexical = XsdBinaryLexicalHelper::encode(getBinaryBaseName(), val, SOAP_SERIALIZATION_ERROR);
            lexical = XsdBinaryFacetHelper::validate(getBinaryFacets(), lexical, SOAP_SERIALIZATION_ERROR);
            return XsdScalarTextHelper::withComments(rh, type.serializeValue(nsc,
                new XsdBinaryValue(getBinaryBaseName(), lexical), omitType));
        }

        if (!exists val && getFacetKind() == "list" && hasNativeListValue()) {
            val = ();
        }

        # issue #5411: "whiteSpace" processing is applied to the lexical value before it is validated
        if (!XsdBinaryLexicalHelper::isType(getFacetKind())) {
            val = applyWhiteSpace(val);
        }
        # Validate facets before serialization
        validateFacets(val, "serialize");

        if (!enumerationAccepts(val)) {
            throw "SOAP-SERIALIZATION-ERROR", sprintf("value %y passed to simpleType %y is not in the enumeration "
                "list<auto> (%y)", val, name, enumValues.keys());
        }

        return XsdScalarTextHelper::withComments(rh, type.serializeValue(nsc, val, omitType));
    }

    # A cached ordinary rejection is local to one value and its complete conversion
    # context. Unexpected failures and cancellation always unwind to the caller.
    private hash<XsdSchemaUnionTrialResult> serializeUnion(Namespaces nsc, auto val, *softbool omitType) {
        *XsdScopedLexicalContext lexical_scope;
        if (val instanceof XsdScopedLexicalValue) {
            lexical_scope = new XsdScopedLexicalContext(val, nsc);
            val = val.getLexicalValue();
        }
        *XsdSchemaUnionTrialContext caller = SchemaUnionSerializeContext;
        bool owner = !caller || !XsdUnionInputHelper::sameInput(caller.namespace_bindings, QNameInputNamespaces) || caller.namespaces !== nsc || caller.omit_type !== omitType
            || !XsdUnionInputHelper::sameInput(caller.input, val);
        on_exit if (owner) {
            SchemaUnionSerializeContext = caller;
        }
        if (owner) {
            SchemaUnionSerializeContext = new XsdSchemaUnionTrialContext(val);
            SchemaUnionSerializeContext.namespaces = nsc;
            SchemaUnionSerializeContext.omit_type = omitType;
        }
        XsdSchemaUnionTrialContext trial = SchemaUnionSerializeContext;
        string identity = self.uniqueHash();
        if (trial.active{identity}) {
            throw "XSD-SIMPLETYPE-ERROR", "cyclic union schema conversion";
        }
        trial.active{identity} = True;
        on_exit remove trial.active{identity};
        list<string> rejected();
        bool namespace_sensitive = False;
        foreach XsdAbstractType member in (unionTypes ? unionTypes : (type,)) {
            string key = member.uniqueHash();
            if (!trial.results.hasKey(key)) {
                try {
                    *hash<XsdUnionListInfo> list_info = XsdUnionValueHelper::describeList(member);
                    auto value = member.serializeValue(nsc, list_info
                        ? XsdUnionValueHelper::listInput(val, SOAP_SERIALIZATION_ERROR, list_info)
                        : XsdUnionValueHelper::serializeInput(member, val), omitType);
                    *hash<XsdUnionValueIdentity> member_identity = trial.identities{key}
                        ?? (list_info ? XsdUnionValueHelper::schemaListIdentity(list_info, member, val, value,
                                SOAP_SERIALIZATION_ERROR, trial.identities)
                            : XsdUnionValueHelper::atomicIdentity(member, val, value, SOAP_SERIALIZATION_ERROR));
                    trial.results{key} = <XsdSchemaUnionTrialResult>{"accepted": True, "value": value,
                        "identity": member_identity,
                        "namespace_sensitive": trial.namespace_sensitive{key} ?? False,
                        "white_space": trial.selected_white_spaces{key} ?? member.getWhiteSpace()};
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err != SOAP_SERIALIZATION_ERROR) {
                        rethrow;
                    }
                    trial.results{key} = <XsdSchemaUnionTrialResult>{"accepted": False,
                        "rejection": unionRejection(member, ex)};
                }
            }
            hash<XsdSchemaUnionTrialResult> result = trial.results{key};
            if (result.accepted) {
                auto lexical = XsdScalarTextHelper::value(val, SOAP_SERIALIZATION_ERROR);
                if (lexical.typeCode() != NT_STRING
                        || (result.identity && XsdBinaryLexicalHelper::isType(result.identity.family))) {
                    lexical = XsdUnionValueHelper::text(result.value, SOAP_SERIALIZATION_ERROR);
                }
                lexical = normalizeWhiteSpace(lexical, result.white_space ?? "preserve");
                validateUnionFacets(lexical, result.identity, "serialize");
                trial.selected_white_spaces{identity} = result.white_space ?? "preserve";
                if (patterns) {
                    result.value = withUnionLexical(result.value, lexical);
                }
                if (result.identity) {
                    trial.identities{identity} = result.identity;
                }
                result.owner = owner;
                result.namespace_sensitive = result.namespace_sensitive || namespace_sensitive;
                trial.namespace_sensitive{identity} = result.namespace_sensitive;
                return result;
            }
            namespace_sensitive = namespace_sensitive || XsdScopedLexicalHelper::schema(member, XsdScopedLexicalHelper::inputText(val));
            rejected += result.rejection;
        }
        throw SOAP_SERIALIZATION_ERROR, sprintf("value %Y cannot be serialized with union types for %Y: %Y", val, name, rejected);
    }

    private auto preserveUnionLexical(Namespaces namespaces, auto input, hash<XsdSchemaUnionTrialResult> result) {
        if (!result.identity || input.typeCode() != NT_STRING
                || (result.value.typeCode() == NT_STRING && result.value === input)) {
            return result.value;
        }
        *bool caller = SchemaUnionValueProbe;
        on_exit SchemaUnionValueProbe = caller;
        SchemaUnionValueProbe = True;
        try {
            hash<XsdSchemaUnionTrialResult> observed = deserializeUnion("value",
                new hash<string, XsdAbstractType>(), NOTHING, XsdUnionValueHelper::xmlValue(result.value, namespaces));
            if (observed.identity && XsdUnionValueHelper::same(result.identity, observed.identity)) {
                return result.value;
            }
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != SOAP_DESERIALIZATION_ERROR) {
                rethrow;
            }
        }
        return withUnionLexical(result.value, input);
    }

    private static auto withUnionLexical(auto value, string lexical) {
        if (value instanceof XsdNotationValue) {
            return new XsdNotationValue(value.getNamespaceUri(), lexical);
        }
        if (value instanceof XsdQNameValue) {
            return new XsdQNameValue(value.getNamespaceUri(), lexical);
        }
        if (value instanceof XsdQNameOutputText && value.getLexicalValue() == lexical) {
            return value;
        }
        if (value.typeCode() == NT_HASH) {
            value."^value^" = withUnionLexical(value."^value^", lexical);
            return value;
        }
        return lexical;
    }

    private hash<XsdSchemaUnionTrialResult> deserializeUnion(string en, hash<string, XsdAbstractType> tmap,
            *hash<auto> mrh, auto val) {
        *XsdScopedLexicalContext lexical_scope;
        if (val instanceof XsdScopedLexicalValue) {
            lexical_scope = new XsdScopedLexicalContext(val, NOTHING);
            val = val.getLexicalValue();
        }
        # Internal value-preservation probes also enter here directly. Establish
        # their namespace context before creating a shared member trial cache.
        XsdQNameNamespaceScope qname_scope(val.typeCode() == NT_HASH ? val."^attributes^" : NOTHING);
        *XsdSchemaUnionTrialContext caller = SchemaUnionDeserializeContext;
        bool owner = !caller || !XsdUnionInputHelper::sameInput(caller.namespace_bindings, QNameInputNamespaces) || caller.element_name !== en || caller.type_map !== tmap
            || !XsdUnionInputHelper::sameInput(caller.references, mrh)
            || !XsdUnionInputHelper::sameInput(caller.input, val);
        on_exit if (owner) {
            SchemaUnionDeserializeContext = caller;
        }
        if (owner) {
            SchemaUnionDeserializeContext = new XsdSchemaUnionTrialContext(val);
            SchemaUnionDeserializeContext.element_name = en;
            SchemaUnionDeserializeContext.type_map = tmap;
            SchemaUnionDeserializeContext.references = mrh;
        }
        XsdSchemaUnionTrialContext trial = SchemaUnionDeserializeContext;
        string identity = self.uniqueHash();
        if (trial.active{identity}) {
            throw "XSD-SIMPLETYPE-ERROR", "cyclic union schema conversion";
        }
        trial.active{identity} = True;
        on_exit remove trial.active{identity};
        list<string> rejected();
        bool namespace_sensitive = False;
        foreach XsdAbstractType member in (unionTypes ? unionTypes : (type,)) {
            string key = member.uniqueHash();
            if (!trial.results.hasKey(key)) {
                try {
                    auto value = member.deserializeValue(en, tmap, mrh, val);
                    *hash<XsdUnionListInfo> list_info = XsdUnionValueHelper::describeList(member);
                    *hash<XsdUnionValueIdentity> member_identity = trial.identities{key}
                        ?? (list_info ? XsdUnionValueHelper::schemaListIdentity(list_info, member, val, value,
                                SOAP_DESERIALIZATION_ERROR, trial.identities)
                            : XsdUnionValueHelper::atomicIdentity(member, val, value, SOAP_DESERIALIZATION_ERROR));
                    trial.results{key} = <XsdSchemaUnionTrialResult>{"accepted": True, "value": value,
                        "identity": member_identity,
                        "namespace_sensitive": trial.namespace_sensitive{key} ?? False,
                        "white_space": trial.selected_white_spaces{key} ?? member.getWhiteSpace()};
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err != SOAP_DESERIALIZATION_ERROR) {
                        rethrow;
                    }
                    trial.results{key} = <XsdSchemaUnionTrialResult>{"accepted": False,
                        "rejection": unionRejection(member, ex)};
                }
            }
            hash<XsdSchemaUnionTrialResult> result = trial.results{key};
            if (result.accepted) {
                string lexical = XsdUnionValueHelper::text(val, SOAP_DESERIALIZATION_ERROR);
                lexical = normalizeWhiteSpace(lexical, result.white_space ?? "preserve");
                validateUnionFacets(lexical, result.identity, "deserialize");
                trial.selected_white_spaces{identity} = result.white_space ?? "preserve";
                if (patterns) {
                    if (result.identity && result.identity.family == "list" && result.value.typeCode() == NT_LIST
                            && XsdScopedLexicalHelper::schema(self, NOTHING)) {
                        # QName-capable collections need per-item context, including a stable
                        # empty-list representation. Other patterned unions retain their string contract.
                        result.value = XsdListValueHelper::retainedTokens(result.value,
                            XsdListValueHelper::tokens(lexical));
                    } else {
                        result.value = result.identity && XsdBinaryLexicalHelper::isType(result.identity.family)
                            ? new XsdBinaryValue(result.identity.family, lexical)
                            : result.identity && result.identity.family == "QName"
                                ? new XsdQNameValue(result.identity.value[0], lexical)
                            : result.identity && result.identity.family == "NOTATION"
                                ? new XsdNotationValue(result.identity.value[0], lexical) : lexical;
                    }
                }
                if (result.identity) {
                    trial.identities{identity} = result.identity;
                }
                result.owner = owner;
                result.namespace_sensitive = result.namespace_sensitive || namespace_sensitive;
                trial.namespace_sensitive{identity} = result.namespace_sensitive;
                return result;
            }
            namespace_sensitive = namespace_sensitive || XsdScopedLexicalHelper::schema(member, XsdScopedLexicalHelper::inputText(val));
            rejected += result.rejection;
        }
        throw SOAP_DESERIALIZATION_ERROR, sprintf("value %Y cannot be deserialized with union types for %Y in element %Y: %Y",
            val, name, en, rejected);
    }

    private validateUnionFacets(string lexical, *hash<XsdUnionValueIdentity> identity, string operation) {
        validateFacets(lexical, operation, lexical);
        if (!enumValues) {
            return;
        }
        string error = operation == "serialize" ? SOAP_SERIALIZATION_ERROR : SOAP_DESERIALIZATION_ERROR;
        foreach auto allowed in (getUnionEnumerationValues()) {
            hash<XsdSchemaUnionTrialResult> candidate = cast<XsdSimpleType>(type).deserializeUnion("enumeration",
                new hash<string, XsdAbstractType>(), NOTHING, allowed);
            if (identity && candidate.identity ? XsdUnionValueHelper::same(identity, candidate.identity)
                    : lexical === XsdUnionValueHelper::text(allowed, error)) {
                return;
            }
        }
        throw error, sprintf("union value %Y for %Y is outside its enumeration", lexical, name);
    }

    private auto preserveUnionValue(string en, hash<string, XsdAbstractType> tmap, *hash<auto> mrh, auto input,
            hash<XsdSchemaUnionTrialResult> result) {
        auto lexical = XsdScalarTextHelper::value(input, SOAP_DESERIALIZATION_ERROR);
        if (result.namespace_sensitive && lexical.typeCode() == NT_STRING
                && (!result.identity || (result.identity.family != "QName" && result.identity.family != "list"))) {
            return new XsdScopedLexicalValue(lexical,
                XsdScopedLexicalHelper::usedBindings(lexical, QNameInputNamespaces));
        }
        if (!result.identity) {
            return result.value;
        }
        if (lexical.typeCode() != NT_STRING || (result.value.typeCode() == NT_STRING && result.value === lexical)) {
            return result.value;
        }
        *bool caller = SchemaUnionValueProbe;
        on_exit SchemaUnionValueProbe = caller;
        SchemaUnionValueProbe = True;
        auto encoded;
        try {
            # Finalized schema types release their construction namespace registry.
            # Scalar value probes omit type annotations and use an independent registry.
            Namespaces probe_namespaces({});
            encoded = XsdUnionValueHelper::xmlValue(serializeValue(probe_namespaces, result.value, True));
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != SOAP_SERIALIZATION_ERROR) {
                rethrow;
            }
            return result.identity.family == "list" && result.value.typeCode() == NT_LIST
                ? XsdListValueHelper::retainedTokens(result.value, XsdListValueHelper::tokens(lexical)) : lexical;
        }
        if (encoded.typeCode() == NT_STRING && encoded === lexical) {
            return result.value;
        }
        try {
            hash<XsdSchemaUnionTrialResult> observed = deserializeUnion(en, tmap, mrh, encoded);
            if (observed.identity && XsdUnionValueHelper::same(result.identity, observed.identity)) {
                return result.value;
            }
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != SOAP_DESERIALIZATION_ERROR) {
                rethrow;
            }
        }
        return result.identity.family == "list" && result.value.typeCode() == NT_LIST
            ? XsdListValueHelper::retainedTokens(result.value, XsdListValueHelper::tokens(lexical)) : lexical;
    }

    private static string unionRejection(XsdAbstractType member, hash<ExceptionInfo> ex) {
        # Repeating nested union explanations duplicates entire shared subgraphs.
        # Keep each immediate member's category; atomic failures retain their cause.
        bool nested = member instanceof XsdSimpleType && cast<XsdSimpleType>(member).getFacetKind() == "union";
        return sprintf("type %Y: %s: %s", member.getName(), ex.err,
            nested ? "nested union validation failed" : ex.desc);
    }

    #! Serialize a list type value as space-separated string
    private auto serializeList(Namespaces nsc, auto val, *softbool omitType, *hash<auto> rh) {
        bool retain_output = XsdQNameOutputScope::retains(nsc);
        XsdQNameOutputScope output_scope(nsc);
        # The resolved schema already identifies QName items. Building a detached
        # provider here would reconstruct the complete item graph on every output.
        bool qname_items = listItemType instanceof XsdBaseType
            ? (listItemType.name == "QName" || listItemType.name == "NOTATION")
            : listItemType instanceof XsdSimpleType && (cast<XsdSimpleType>(listItemType).getFacetKind() == "QName"
                || cast<XsdSimpleType>(listItemType).getFacetKind() == "NOTATION");
        list<auto> retained_items();
        bool has_qnames = False;
        bool capture = XsdUnionValueHelper::schemaUnionItem(listItemType);
        *XsdSchemaUnionItemCapture caller_capture = SchemaUnionItemCapture;
        on_exit if (capture) {
            SchemaUnionItemCapture = caller_capture;
        }
        list<*hash<XsdUnionValueIdentity>> identities();
        list<auto> items;
        if (val.typeCode() == NT_LIST) {
            items = val;
        } else if (exists val) {
            # Single value treated as single-item list
            items = (val,);
        } else {
            items = ();
        }

        # Serialize each item and join with spaces
        list<string> serializedItems = ();
        foreach auto item in (items) {
            if (capture) {
                SchemaUnionItemCapture = new XsdSchemaUnionItemCapture(listItemType);
            }
            string lexical;
            auto retained;
            if (qname_items) {
                auto serialized = listItemType.serializeValue(nsc, item, True);
                retained = XsdScalarTextHelper::value(serialized, SOAP_SERIALIZATION_ERROR);
                @assert(retained instanceof XsdQNameValue);
                has_qnames = True;
                lexical = retained.getLexicalValue();
            } else if (item.typeCode() == NT_STRING) {
                lexical = normalizeWhiteSpace(item, listItemType.getWhiteSpace());
                try {
                    auto decoded = listItemType.deserializeValue(name, new hash<string, XsdAbstractType>(), NOTHING, lexical);
                    if (decoded instanceof XsdQNameValue || decoded instanceof XsdNotationValue || decoded instanceof XsdScopedLexicalValue) {
                        retained = decoded instanceof XsdNotationValue ? decoded.asQName() : decoded;
                        has_qnames = True;
                    }
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err != SOAP_DESERIALIZATION_ERROR) {
                        rethrow;
                    }
                    throw SOAP_SERIALIZATION_ERROR, ex.desc;
                }
            } else {
                auto serialized = listItemType.serializeValue(nsc, item, True);
                auto scalar = XsdScalarTextHelper::value(serialized, SOAP_SERIALIZATION_ERROR);
                if (scalar instanceof XsdQNameValue || scalar instanceof XsdScopedLexicalValue) {
                    retained = scalar;
                    has_qnames = True;
                    lexical = scalar.getLexicalValue();
                } else {
                    lexical = string(scalar);
                }
            }
            if (!exists retained && capture && (SchemaUnionItemCapture.identity.family == "QName" || SchemaUnionItemCapture.identity.family == "NOTATION")) {
                retained = new XsdQNameValue(SchemaUnionItemCapture.identity.value[0], lexical);
                has_qnames = True;
            }
            XsdListValueHelper::checkToken(lexical, SOAP_SERIALIZATION_ERROR);
            serializedItems += lexical;
            push retained_items, exists retained ? retained : lexical;
            if (capture) {
                push identities, SchemaUnionItemCapture.identity;
            }
        }

        string result = serializedItems.join(" ");
        if (capture) {
            *hash<XsdUnionValueIdentity> identity = XsdUnionValueHelper::capturedIdentity(identities);
            if (identity && SchemaUnionSerializeContext) {
                SchemaUnionSerializeContext.identities{self.uniqueHash()} = identity;
            }
            if (SchemaUnionListCapture && SchemaUnionListCapture.target === self) {
                SchemaUnionListCapture.identity = identity;
            }
        }
        auto output = result;
        if (has_qnames) {
            XsdQNameOutputText text(retained_items);
            output = retain_output ? text : text.standalone();
        }
        return XsdScalarTextHelper::withComments(rh, output);
    }

    #! returns the \c whiteSpace processing that applies to this type
    /** @return one of \c "preserve", \c "replace", or \c "collapse"

        The facet declared by this restriction is used if there is one; otherwise the value is inherited from the
        base type. Unions preserve the input at this level; the selected member applies its own normalization.

        @since %WSDL 0.5.8
    */
    string getWhiteSpace() {
        if (listItemType) {
            return "collapse";
        }
        if (exists whiteSpace) {
            return whiteSpace;
        }
        return type ? type.getWhiteSpace() : "preserve";
    }

    #! applies \c whiteSpace processing to a lexical value
    /** @param val the value to normalize
        @param ws the \c whiteSpace processing to apply

        @return the normalized value

        XSD 1.0 part 2 4.3.6: \c "replace" replaces every tab, newline, and carriage return with a space;
        \c "collapse" additionally collapses runs of spaces into one and removes leading and trailing spaces.

        @since %WSDL 0.5.8
    */
    static string normalizeWhiteSpace(string val, string ws) {
        switch (ws) {
            case "replace":
                val =~ s/[\t\n\r]/ /g;
                break;

            case "collapse":
                val =~ s/[\t\n\r]/ /g;
                val =~ s/  +/ /g;
                # Qore trim() also removes characters outside XML's four whitespace characters.
                val =~ s/\A | \z//g;
                break;
        }
        return val;
    }

    #! applies \c whiteSpace processing to a value if it is a string
    private auto applyWhiteSpace(auto val) {
        if (val.typeCode() != NT_STRING) {
            return val;
        }
        return XsdSimpleType::normalizeWhiteSpace(val, getWhiteSpace());
    }

    #! returns @ref True if the value matches the given XSD pattern in its entirety
    /** issue #5411: XSD patterns match the entire value, including all top-level alternatives. For example,
        "a|b" accepts only "a" or "b". New expressions use XsdCompiledPattern; older anchored PCRE metadata
        retains the same boundary requirement. See @ref WSDL::XsdRegexHelper.

        @since %WSDL 0.5.8
    */
    private bool matchesAnyPattern(string str) {
        foreach XsdPatternConstraint pcre in (pcre_patterns) {
            if (XsdPatternConstraintHelper::matches(str, pcre)) {
                return True;
            }
        }
        return False;
    }

    #! returns @ref True if the value satisfies the \c pattern facets of this type and all its base types
    /** @since %WSDL 0.5.8
    */
    bool patternsAccept(string val) {
        if (patterns && !matchesAnyPattern(val)) {
            return False;
        }
        return type instanceof XsdSimpleType ? cast<XsdSimpleType>(type).patternsAccept(val) : True;
    }

    #! returns the \c pattern facets of the innermost type in the chain that declares any
    /** @since %WSDL 0.5.8
    */
    static *list<string> getPatterns(*XsdAbstractType t) {
        if (!(t instanceof XsdSimpleType)) {
            return;
        }
        XsdSimpleType st = cast<XsdSimpleType>(t);
        return st.patterns ?? XsdSimpleType::getPatterns(st.type);
    }

    #! returns the effective value of a constraining facet, searching this type and then its base types
    /** @since %WSDL 0.5.8
    */
    private auto getEffectiveFacet(string facet) {
        auto v;
        switch (facet) {
            case "length": v = length; break;
            case "minLength": v = minLength; break;
            case "maxLength": v = maxLength; break;
            case "minInclusive": v = minInclusive; break;
            case "maxInclusive": v = maxInclusive; break;
            case "minExclusive": v = minExclusive; break;
            case "maxExclusive": v = maxExclusive; break;
            case "totalDigits": v = totalDigits; break;
            case "fractionDigits": v = fractionDigits; break;
        }
        if (exists v) {
            return v;
        }
        if (facet == "minLength" && type instanceof XsdBaseType && XsdBuiltinListHelper::isType(type.name)) {
            return 1;
        }
        return type instanceof XsdSimpleType ? cast<XsdSimpleType>(type).getEffectiveFacet(facet) : NOTHING;
    }

    #! returns a sample value satisfying the \c pattern facets of this type, if one can be generated
    /** @param min_length the minimum length the value must have, if any

        @return a value matching the \c pattern facets declared in this type or in one of its base types, or
        \c NOTHING if none could be generated

        @since %WSDL 0.5.8
    */
    *string getPatternSample(*softint min_length) {
        *XsdSimpleType pattern_owner = self;
        while (pattern_owner && !pattern_owner.patterns) {
            pattern_owner = pattern_owner.type instanceof XsdSimpleType
                ? cast<XsdSimpleType>(pattern_owner.type) : NOTHING;
        }
        if (!pattern_owner) {
            return;
        }
        if (exists min_length && min_length > XsdRegexHelper::MaxSampleLength) {
            return;
        }
        *string sample = getPatternSampleIntern(0);
        # the shortest matching value can be too short for the length facets; try longer values if so
        if (exists sample && exists min_length && sample.length() < min_length) {
            for (int reps = 1; reps <= min_length; ++reps) {
                *string longer = getPatternSampleIntern(reps);
                if (exists longer && longer.length() >= min_length) {
                    sample = longer;
                    break;
                }
            }
        }
        # the sample has to satisfy the pattern facets of every step in the derivation chain
        if (exists sample && patternsAccept(sample)) {
            return sample;
        }
        # A candidate from one restriction can fail another. Try the bounded one-character alphabet
        # against the whole derivation chain before reporting that generation is unsupported.
        if (!exists min_length || min_length <= 1) {
            for (int i = 0; i < XsdRegexHelper::SampleChars.length(); ++i) {
                string candidate = XsdRegexHelper::SampleChars[i];
                if (patternsAccept(candidate)) {
                    return candidate;
                }
            }
        }
    }

    #! returns a sample value for the innermost type declaring \c pattern facets
    private *string getPatternSampleIntern(int min_reps) {
        foreach string pattern in (patterns) {
            *string sample = XsdRegexHelper::getSampleValue(pattern, min_reps);
            if (exists sample) {
                return sample;
            }
        }
        if (type instanceof XsdSimpleType) {
            return cast<XsdSimpleType>(type).getPatternSampleIntern(min_reps);
        }
    }

    #! returns a sample value satisfying the constraining facets declared for this type
    /** @param default_value the value to use as a starting point, normally the sample value for the base type

        @return a value satisfying the type's constraining facets, derived from \a default_value where possible
        @throw XSD-SAMPLE-ERROR an example satisfying all restrictions cannot be constructed

        Used to generate example messages that can actually be serialized; the placeholder value for a base type
        does not normally satisfy the facets declared by a restriction of it.

        @since %WSDL 0.5.8
    */
    auto getSampleValue(auto default_value) {
        if (getFacetKind() == "union") {
            return getUnionSample(default_value);
        }
        if (getCalendarBaseName()) {
            return getCalendarSample(default_value);
        }
        if (getDurationBaseName()) {
            return getDurationSample(default_value);
        }
        if (getBinaryBaseName()) {
            return getBinarySample(default_value);
        }
        if (getFacetKind() == "QName" || getFacetKind() == "NOTATION") {
            return getQNameSample(default_value);
        }
        if (getFacetKind() == "boolean") {
            foreach auto candidate in (default_value, "true", "false", "1", "0") {
                if (acceptsSample(candidate)) {
                    return deserializeValue(name, new hash<string, XsdAbstractType>(), NOTHING, candidate);
                }
            }
            throw "XSD-SAMPLE-ERROR", sprintf("no boolean spelling satisfies all patterns of %Y", name);
        }
        if (StringKinds{getFacetKind()}) {
            return getStringSample(string(default_value));
        }
        if (getFacetKind() == "list" || getFacetKind() == "hexBinary" || getFacetKind() == "base64Binary") {
            return getSizedSample(default_value);
        }
        # a "pattern" facet is the most specific constraint; generate a value from it if one is declared
        *XsdFacetCount required_length = getEffectiveFacet("length") ?? getEffectiveFacet("minLength");
        *int min_length = exists required_length
            && XsdFacetCountHelper::compare(required_length, XsdRegexHelper::MaxSampleLength) <= 0
            ? int(required_length) : NOTHING;
        *string sample = getPatternSample(min_length);
        if (exists sample && (!getNumericBaseName() || acceptsSample(sample))) {
            return sample;
        }

        if (getNumericBaseName()) {
            return getNumericSample(default_value);
        }

        auto rv = default_value;

        switch (rv.typeCode()) {
            case NT_INT:
            case NT_FLOAT:
            case NT_NUMBER: {
                # respect the digit facets first, as they determine the shape of the value
                *softint td = getEffectiveFacet("totalDigits");
                *softint fd = getEffectiveFacet("fractionDigits");
                if (exists td || exists fd) {
                    int frac = fd ?? 0;
                    int int_digits = exists td ? td - frac : 1;
                    if (int_digits < 1) {
                        int_digits = 1;
                    }
                    string sv = strmul("1", int_digits);
                    if (frac) {
                        sv += "." + strmul("1", frac);
                    }
                    rv = frac ? number(sv) : sv.toInt();
                }

                number n = number(rv);
                number orig = n;
                auto v = getEffectiveFacet("minInclusive");
                if (exists v && n < number(v)) {
                    n = number(v);
                }
                v = getEffectiveFacet("minExclusive");
                if (exists v && n <= number(v)) {
                    n = number(v) + 1;
                }
                v = getEffectiveFacet("maxInclusive");
                if (exists v && n > number(v)) {
                    n = number(v);
                }
                v = getEffectiveFacet("maxExclusive");
                if (exists v && n >= number(v)) {
                    n = number(v) - 1;
                }
                if (n != orig) {
                    rv = rv.typeCode() == NT_INT ? n.toInt() : n;
                }
                break;
            }

            case NT_STRING: {
                *softint len = getEffectiveFacet("length");
                rv = exists len
                    ? XsdSimpleType::fitString(rv, len, len)
                    : XsdSimpleType::fitString(rv, getEffectiveFacet("minLength"),
                        getEffectiveFacet("maxLength"));
                break;
            }
        }
        return rv;
    }

    private *XsdQNameValue getQNameChoice(XsdQNameValue literal) {
        list<XsdQNameValue> candidates = (literal,);
        *XsdSimpleType ancestor = self;
        while (ancestor) {
            foreach string pattern in (ancestor.patterns) {
                *string sample = XsdRegexHelper::getSampleValue(pattern, 1);
                if (!exists sample) {
                    continue;
                }
                int colon = sample.find(":");
                string lexical = (colon < 0 ? "" : sample.substr(0, colon + 1)) + literal.getLocalName();
                try {
                    push candidates, new XsdQNameValue(literal.getNamespaceUri(), lexical);
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err != "XSD-QNAME-VALUE-ERROR") {
                        rethrow;
                    }
                }
            }
            ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
        }
        foreach XsdQNameValue candidate in (candidates) {
            if (acceptsSample(candidate)) {
                return candidate;
            }
        }
    }

    private auto getQNameSample(auto default_value) {
        list<auto> candidates();
        push candidates, default_value;
        candidates += getAllowedValues() ?? ();
        *string patterned = getPatternSample(1);
        if (exists patterned) {
            try {
                string lexical = XsdNameLexicalHelper::lexical("QName", patterned, "XSD-QNAME-VALUE-ERROR");
                int colon = lexical.find(":");
                string uri = colon < 0 ? "" : lexical.substr(0, colon) == "xml"
                    ? "http://www.w3.org/XML/1998/namespace" : "urn:qore:example";
                push candidates, new XsdQNameValue(uri, lexical);
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "XSD-QNAME-VALUE-ERROR") {
                    rethrow;
                }
            }
        }
        push candidates, "abc";
        foreach auto candidate in (candidates) {
            if (acceptsSample(candidate)) {
                XsdQNameValue value = validateQNameValue(candidate,
                    nsc.getInputNamespaceState().input, "XSD-SAMPLE-ERROR");
                return getFacetKind() == "NOTATION"
                    ? new XsdNotationValue(value.getNamespaceUri(), value.getLexicalValue())
                    : XsdQNameValueHelper::native(value);
            }
        }
        throw "XSD-SAMPLE-ERROR", sprintf("cannot construct a QName example satisfying the restrictions "
            "of %Y; supply a valid example", name);
    }

    private string getStringSample(string default_value) {
        string normalized = normalizeWhiteSpace(default_value, getWhiteSpace());
        if (acceptsSample(normalized)) {
            return normalized;
        }
        *XsdSimpleType ancestor = self;
        while (ancestor) {
            foreach string choice in (keys ancestor.stringEnumValues) {
                if (acceptsSample(choice)) {
                    return normalizeWhiteSpace(choice, getWhiteSpace());
                }
            }
            ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
        }
        *XsdFacetCount minimum = getEffectiveFacet("length") ?? getEffectiveFacet("minLength");
        *XsdFacetCount maximum = getEffectiveFacet("length") ?? getEffectiveFacet("maxLength");
        if (!exists minimum || XsdFacetCountHelper::compare(minimum, XsdRegexHelper::MaxSampleLength) <= 0) {
            int min_size = exists minimum ? int(minimum) : 0;
            int max_size = exists maximum
                && XsdFacetCountHelper::compare(maximum, XsdRegexHelper::MaxSampleLength) < 0
                ? int(maximum) : XsdRegexHelper::MaxSampleLength;
            *string patterned = getPatternSample(min_size);
            if (exists patterned && acceptsSample(patterned)) {
                return normalizeWhiteSpace(patterned, getWhiteSpace());
            }
            string fitted = fitString(normalized, min_size, max_size);
            if (acceptsSample(fitted)) {
                return normalizeWhiteSpace(fitted, getWhiteSpace());
            }
        }
        throw "XSD-SAMPLE-ERROR", sprintf("cannot construct a string example satisfying all facets of %Y "
            "within the %d-character generated-example limit; supply a valid example", name,
            XsdRegexHelper::MaxSampleLength);
    }

    private auto getSizedSample(auto default_value) {
        if (getFacetKind() == "list") {
            bool native_list = hasNativeListValue();
            if (native_list && default_value.typeCode() == NT_STRING) {
                default_value = XsdListValueHelper::tokens(default_value);
            }
            *XsdSimpleType ancestor = self;
            while (ancestor) {
                foreach string choice in (keys ancestor.enumValues) {
                    auto candidate = native_list ? XsdListValueHelper::tokens(choice)
                        : normalizeWhiteSpace(choice, "collapse");
                    if (acceptsSample(candidate)) {
                        return candidate;
                    }
                }
                ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
            }
            *string patterned = getPatternSample();
            if (exists patterned) {
                auto candidate = native_list ? XsdListValueHelper::tokens(patterned)
                    : normalizeWhiteSpace(patterned, "collapse");
                if (acceptsSample(candidate)) {
                    return candidate;
                }
            }
        }
        if (acceptsSample(default_value)) {
            return default_value;
        }
        *XsdFacetCount minimum = getEffectiveFacet("length") ?? getEffectiveFacet("minLength");
        *XsdFacetCount maximum = getEffectiveFacet("length") ?? getEffectiveFacet("maxLength");
        if (!exists minimum || XsdFacetCountHelper::compare(minimum, XsdRegexHelper::MaxSampleLength) <= 0) {
            int min_size = exists minimum ? int(minimum) : 0;
            int max_size = exists maximum
                && XsdFacetCountHelper::compare(maximum, XsdRegexHelper::MaxSampleLength) < 0
                ? int(maximum) : XsdRegexHelper::MaxSampleLength;
            auto candidate;
            if (getFacetKind() == "list") {
                bool native_list = hasNativeListValue();
                list<auto> items = native_list
                    ? (default_value.typeCode() == NT_LIST ? default_value : (default_value,))
                    : split(" ", normalizeWhiteSpace(string(default_value), "collapse"));
                if (items.size() > max_size) {
                    splice items, max_size;
                }
                if (items.size()) {
                    while (items.size() < min_size) {
                        items += items[0];
                    }
                }
                candidate = native_list ? items : items.join(" ");
            } else {
                # Octet counts are bounded before allocating generated binary content.
                candidate = parse_hex_string(strmul("00", min_size));
            }
            if (acceptsSample(candidate)) {
                return candidate;
            }
        }
        throw "XSD-SAMPLE-ERROR", sprintf("cannot construct an example satisfying all facets of %Y "
            "within the %d-item/octet generated-example limit; supply a valid example", name,
            XsdRegexHelper::MaxSampleLength);
    }

    private bool acceptsSample(auto value) {
        try {
            serializeValue(new Namespaces({}), value, True);
            return True;
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == SOAP_SERIALIZATION_ERROR) {
                return False;
            }
            rethrow;
        }
    }

    private auto getUnionSample(auto default_value) {
        if (acceptsSample(default_value)) {
            return default_value;
        }
        list<auto> candidates();
        *XsdSimpleType ancestor = self;
        while (ancestor) {
            foreach auto lexical in (ancestor.getUnionEnumerationValues()) {
                push candidates, lexical;
            }
            ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
        }
        *string patterned = getPatternSample();
        if (exists patterned) {
            push candidates, patterned;
        }
        foreach auto lexical in (candidates) {
            try {
                auto candidate = deserializeValue(name, new hash<string, XsdAbstractType>(), NOTHING, lexical);
                if (acceptsSample(candidate)) {
                    return candidate;
                }
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != SOAP_DESERIALIZATION_ERROR) {
                    rethrow;
                }
            }
        }
        throw "XSD-SAMPLE-ERROR", sprintf("cannot construct a union example satisfying all restrictions of %Y "
            "from its default value, enumerations or patterns; supply a valid example", name);
    }

    private auto getBinaryChoice(string lexical) {
        list<string> candidates = (lexical,);
        if (getBinaryBaseName() == "hexBinary") {
            push candidates, toupper(lexical);
            push candidates, tolower(lexical);
        }
        *string patterned = getPatternSample();
        if (exists patterned) {
            push candidates, patterned;
        }
        string key = XsdBinaryFacetHelper::key(getBinaryBaseName(), lexical, "XSD-SIMPLETYPE-ERROR");
        foreach string text in (candidates) {
            try {
                auto value = deserializeValue(name, new hash<string, XsdAbstractType>(), NOTHING, text);
                if (XsdBinaryFacetHelper::key(getBinaryBaseName(), value, "SOAP-DESERIALIZATION-ERROR") == key) {
                    return value;
                }
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != SOAP_DESERIALIZATION_ERROR) {
                    rethrow;
                }
            }
        }
    }

    private auto getBinarySample(auto default_value) {
        if (acceptsSample(default_value)) {
            return default_value;
        }
        list<string> candidates();
        *XsdSimpleType ancestor = self;
        while (ancestor) {
            foreach string choice in (keys ancestor.enumValues) {
                push candidates, choice;
            }
            ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
        }
        # Pattern samples must also form complete encoding units. A one-character
        # sample of [A-F]+ is a valid regex word but not a complete hex octet.
        int unit = getBinaryBaseName() == "hexBinary" ? 2 : 4;
        for (int minimum = 1; minimum <= unit; ++minimum) {
            *string patterned = getPatternSample(minimum);
            if (exists patterned) {
                push candidates, patterned;
            }
        }
        foreach string lexical in (candidates) {
            try {
                XsdBinaryValue candidate(getBinaryBaseName(), lexical);
                if (acceptsSample(candidate)) {
                    return deserializeValue(name, new hash<string, XsdAbstractType>(), NOTHING, lexical);
                }
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "XSD-BINARY-VALUE-ERROR") {
                    rethrow;
                }
            }
        }
        *XsdFacetCount required = getEffectiveFacet("length") ?? getEffectiveFacet("minLength");
        if (!exists required || XsdFacetCountHelper::compare(required, XsdRegexHelper::MaxSampleLength) <= 0) {
            binary zeros = parse_hex_string(strmul("00", exists required ? int(required) : 0));
            if (acceptsSample(zeros)) {
                return zeros;
            }
        }
        throw "XSD-SAMPLE-ERROR", sprintf("cannot construct binary text satisfying all facets of %Y "
            "within the %d-octet generated-example limit; supply a valid example", name, XsdRegexHelper::MaxSampleLength);
    }

    private auto getDurationSample(auto default_value) {
        if (acceptsSample(default_value)) {
            return default_value;
        }
        *XsdSimpleType ancestor = self;
        list<string> endpoints();
        int scale = 1;
        while (ancestor) {
            foreach string choice in (keys ancestor.enumValues) {
                if (acceptsSample(choice)) {
                    return choice;
                }
            }
            foreach string endpoint in (ancestor.getDurationFacets().bounds.values()) {
                push endpoints, endpoint;
                scale = max(scale, XsdDurationValueHelper::fractionDigits(endpoint) + 1);
            }
            ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
        }
        list<string> candidates = endpoints;
        foreach string endpoint in (endpoints) {
            candidates += XsdDurationValueHelper::nearby(endpoint, scale);
        }
        *string patterned = getPatternSample();
        if (exists patterned) {
            push candidates, patterned;
        }
        push candidates, "PT0S";
        foreach string candidate in (candidates) {
            if (acceptsSample(candidate)) {
                return candidate;
            }
        }
        throw "XSD-SAMPLE-ERROR", sprintf("cannot construct a duration example satisfying the patterns, "
            "enumerations and bounds of %Y from its endpoints or adjacent duration values; supply a valid example", name);
    }

    private auto getCalendarSample(auto default_value) {
        if (acceptsSample(default_value)) {
            return default_value;
        }
        *XsdSimpleType ancestor = self;
        list<string> candidates();
        while (ancestor) {
            foreach string choice in (keys ancestor.enumValues) {
                if (acceptsSample(choice)) {
                    return choice;
                }
            }
            hash<XsdCalendarFacetInfo> facets = ancestor.getCalendarFacets();
            foreach string facet in (keys facets.bounds) {
                string endpoint = facets.bounds{facet};
                push candidates, endpoint;
                candidates += XsdCalendarLexicalHelper::nearby(facets.base_name, endpoint);
            }
            ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
        }
        *string patterned = getPatternSample();
        if (exists patterned) {
            push candidates, patterned;
            string builtin = getCalendarBaseName();
            string seed = XsdCalendarLexicalHelper::Samples{builtin};
            seed = seed.substr(0, seed.size() - 1);
            if (builtin == "dateTime" || builtin == "time") {
                seed += ".";
            }
            # Regex generation may leave an unconstrained leading date/clock portion empty.
            # Try prefixes of the fixed builtin example, validating each complete candidate.
            # The longest seed is 20 ASCII characters, independent of schema/input size.
            for (int size = 1; size <= seed.size(); ++size) {
                push candidates, seed.substr(0, size) + patterned;
            }
        }
        push candidates, XsdCalendarLexicalHelper::Samples{getCalendarBaseName()};
        foreach string candidate in (candidates) {
            if (acceptsSample(candidate)) {
                return candidate;
            }
        }
        throw "XSD-SAMPLE-ERROR", sprintf("cannot construct a calendar example satisfying the patterns, "
            "enumerations and bounds of %Y from its endpoints or adjacent calendar values; supply a valid example", name);
    }

    private auto getNumericSample(auto default_value) {
        string base = getNumericBaseName();
        if (acceptsSample(default_value)) {
            return default_value;
        }
        # Inherited enumerations are finite; test their exact values before constructing a grid value.
        *XsdSimpleType ancestor = self;
        while (ancestor) {
            foreach string choice in (keys ancestor.enumValues) {
                if (acceptsSample(choice)) {
                    return choice;
                }
            }
            ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
        }
        if (acceptsSample("0")) {
            return "0";
        }
        if (XsdIeeeLexicalHelper::isType(base)) {
            return getIeeeBoundSample(base);
        }

        *string lower;
        *string upper;
        bool lower_exclusive = False;
        bool upper_exclusive = False;
        *list<*string> builtin_bounds = XsdIntegerLexicalHelper::Bounds{base};
        if (builtin_bounds) {
            lower = builtin_bounds[0];
            upper = builtin_bounds[1];
        }
        ancestor = self;
        while (ancestor) {
            foreach string facet in ("minInclusive", "minExclusive", "maxInclusive", "maxExclusive") {
                auto bound = ancestor{facet};
                if (!exists bound) {
                    continue;
                }
                string value = XsdNumericFacetHelper::lexical(base, bound, "XSD-SAMPLE-ERROR");
                bool exclusive = facet.endsWith("Exclusive");
                if (facet.startsWith("min")) {
                    int relation = exists lower ? XsdDecimalLexicalHelper::compare(value, lower) : 1;
                    if (relation > 0 || (!relation && exclusive)) {
                        lower = value;
                        lower_exclusive = exclusive;
                    }
                } else {
                    int relation = exists upper ? XsdDecimalLexicalHelper::compare(value, upper) : -1;
                    if (relation < 0 || (!relation && exclusive)) {
                        upper = value;
                        upper_exclusive = exclusive;
                    }
                }
            }
            ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
        }

        *string boundary;
        bool negative = False;
        bool exclusive = False;
        if (exists lower && XsdDecimalLexicalHelper::compare(lower, "0") >= 0) {
            boundary = lower;
            exclusive = lower_exclusive;
        } else if (exists upper && XsdDecimalLexicalHelper::compare(upper, "0") <= 0) {
            boundary = upper;
            exclusive = upper_exclusive;
            negative = True;
        }
        if (exists boundary) {
            # One more fractional position than either endpoint gives an interior grid point, if one exists.
            int scale = 0;
            if (base == "decimal") {
                foreach *string bound in (lower, upper) {
                    if (exists bound) {
                        int digits = (XsdDecimalLexicalHelper::canonical(bound).split(".")[1] ?? "").size() + 1;
                        if (digits > scale) {
                            scale = digits;
                        }
                    }
                }
                *XsdFacetCount fractional = getEffectiveFacet("fractionDigits");
                if (exists fractional && XsdFacetCountHelper::compare(fractional, scale) < 0) {
                    scale = int(fractional);
                }
                *XsdFacetCount total = getEffectiveFacet("totalDigits");
                if (exists total) {
                    string whole = XsdDecimalLexicalHelper::canonical(boundary).split(".")[0];
                    whole =~ s/\A-//;
                    int whole_digits = whole == "0" ? 0 : whole.size();
                    if (XsdFacetCountHelper::compare(total, whole_digits) <= 0) {
                        scale = 0;
                    } else if (XsdFacetCountHelper::compare(total, whole_digits + scale) < 0) {
                        scale = int(total) - whole_digits;
                    }
                }
            }
            string magnitude = XsdDecimalLexicalHelper::ceilingMagnitude(boundary, scale, exclusive);
            string candidate = (negative ? "-" : "") + magnitude;
            if (acceptsSample(candidate)) {
                return candidate;
            }
        }
        throw "XSD-SAMPLE-ERROR", sprintf("cannot construct a numeric example satisfying all facets of %Y; "
            "the numeric grid has no valid candidate or the pattern/enumeration intersection requires a supplied "
            "lexical example", name);
    }

    private auto getIeeeBoundSample(string builtin) {
        *XsdSimpleType ancestor = self;
        while (ancestor) {
            foreach string facet in ("minInclusive", "minExclusive", "maxInclusive", "maxExclusive") {
                if (!exists ancestor{facet}) {
                    continue;
                }
                float endpoint = XsdIeeeLexicalHelper::decode(builtin, ancestor{facet}, "XSD-SAMPLE-ERROR");
                foreach float candidate in (endpoint,
                        XsdIeeeLexicalHelper::adjacent(builtin, endpoint, facet.startsWith("min"))) {
                    if (acceptsSample(candidate)) {
                        return candidate;
                    }
                }
            }
            ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
        }
        throw "XSD-SAMPLE-ERROR", sprintf("cannot construct an IEEE example satisfying all facets of %Y; "
            "the value space is empty or its lexical patterns require a supplied example", name);
    }

    #! pads or truncates a sample string so that its length lies within the given bounds
    private static string fitString(string str, *softint min_len, *softint max_len) {
        if (exists max_len && str.length() > max_len) {
            str = str.substr(0, max_len);
        }
        if (exists min_len && str.length() < min_len) {
            if (!str.length()) {
                str = "a";
            }
            while (str.length() < min_len) {
                str += str;
            }
            str = str.substr(0, min_len);
        }
        return str;
    }

    #! Validate restriction facets for serialization/deserialization
    /** @param val the value to validate
        @param operation "serialize" or "deserialize" for error context
        @param lexical the normalized whole-list lexical form when validating native item lists
    */
    private validateFacets(auto val, string operation, *string lexical) {
        # Skip validation for NOTHING values
        if (!exists val) {
            return;
        }

        # Determine error type based on operation
        string errType = operation == "deserialize" ? "SOAP-DESERIALIZATION-ERROR" : "SOAP-SERIALIZATION-ERROR";
        if (getNumericBaseName()) {
            XsdNumericFacetHelper::validate(getNumericFacets(), val, errType);
            return;
        }
        if (getCalendarBaseName()) {
            string checked = XsdCalendarFacetHelper::validate(getCalendarFacets(), lexical ?? val, errType);
            return;
        }
        if (getDurationBaseName()) {
            string checked = XsdDurationFacetHelper::validate(getDurationFacets(), lexical ?? val, errType);
            return;
        }
        if (getBinaryBaseName()) {
            string checked = XsdBinaryFacetHelper::validate(getBinaryFacets(), lexical ?? val, errType);
            return;
        }

        # Pattern validation
        # issue #5411: XSD 1.0 part 2 section 4.3.4.3: multiple "pattern" facets declared in the same restriction
        # are combined as if they appeared in a single regular expression separated by "|", so a value matching any
        # one of them is valid.  Patterns declared in different derivation steps are intersected, which happens
        # automatically, as each step validates the value in serializeValue() / deserializeValue()
        if (patterns) {
            string strVal = lexical ?? string(val);
            if (!matchesAnyPattern(strVal)) {
                throw errType, sprintf("value %y for simpleType %y does not match %s during %s", val, name,
                    patterns.size() == 1
                        ? sprintf("pattern %y", patterns[0])
                        : sprintf("any of the patterns %y", patterns),
                    operation);
            }
        }

        # XSD 1.0 4.3.1-3: length facets on QName/NOTATION are deprecated and always satisfied.
        string kind = getFacetKind();
        if (kind != "QName" && kind != "NOTATION" && (exists length || exists minLength || exists maxLength)) {
            int len;
            if (kind == "list" && hasNativeListValue()) {
                # Native list serialization also accepts a scalar as one item and NOTHING as an empty list.
                len = val.typeCode() == NT_LIST ? val.size() : exists val ? 1 : 0;
            } else if (val.typeCode() == NT_STRING) {
                if (kind == "list") {
                    string tokens = normalizeWhiteSpace(val, "collapse");
                    len = tokens.empty() ? 0 : tokens.split(" ").size();
                } else {
                    len = val.length();
                }
            } else if (val.typeCode() == NT_BINARY) {
                len = val.size();
            } else if (val.typeCode() == NT_LIST) {
                len = val.size();
            } else {
                len = string(val).length();
            }

            if (exists length && XsdFacetCountHelper::compare(len, length)) {
                throw errType, sprintf("value %y for simpleType %y has length %d, "
                    "but exact length %Y is required during %s", val, name, len, length, operation);
            }
            if (exists minLength && XsdFacetCountHelper::compare(len, minLength) < 0) {
                throw errType, sprintf("value %y for simpleType %y has length %d, "
                    "but minimum length is %Y during %s", val, name, len, minLength, operation);
            }
            if (exists maxLength && XsdFacetCountHelper::compare(len, maxLength) > 0) {
                throw errType, sprintf("value %y for simpleType %y has length %d, "
                    "but maximum length is %Y during %s", val, name, len, maxLength, operation);
            }
        }

        # Numeric range validation
        if (exists minInclusive || exists maxInclusive || exists minExclusive || exists maxExclusive) {
            auto numVal = val;
            # Try to convert to number for comparison if it's a string
            if (numVal.typeCode() == NT_STRING) {
                numVal = float(numVal);
            }

            if (exists minInclusive && numVal < float(minInclusive)) {
                throw errType, sprintf("value %y for simpleType %y is less than "
                    "minInclusive %y during %s", val, name, minInclusive, operation);
            }
            if (exists maxInclusive && numVal > float(maxInclusive)) {
                throw errType, sprintf("value %y for simpleType %y is greater than "
                    "maxInclusive %y during %s", val, name, maxInclusive, operation);
            }
            if (exists minExclusive && numVal <= float(minExclusive)) {
                throw errType, sprintf("value %y for simpleType %y must be greater than "
                    "minExclusive %y during %s", val, name, minExclusive, operation);
            }
            if (exists maxExclusive && numVal >= float(maxExclusive)) {
                throw errType, sprintf("value %y for simpleType %y must be less than "
                    "maxExclusive %y during %s", val, name, maxExclusive, operation);
            }
        }

        # Precision validation (totalDigits and fractionDigits)
        # issue #5411: both facets constrain the digits of the value, so the sign is ignored and insignificant
        # zeros do not count: "0012.3400" has 4 total digits and 2 fraction digits
        if (exists totalDigits || exists fractionDigits) {
            string strVal = string(val);
            strVal =~ s/^[+-]//;
            string int_part = (strVal =~ x/^([0-9]*)/)[0] ?? "";
            string frac_part = (strVal =~ x/\.([0-9]*)$/)[0] ?? "";
            # leading zeros in the integer part and trailing zeros in the fraction are not significant
            int_part =~ s/^0+//;
            frac_part =~ s/0+$//;

            if (exists fractionDigits && frac_part.length() > fractionDigits) {
                throw errType, sprintf("value %y for simpleType %y has %d fraction digits, "
                    "but maximum is %d during %s", val, name, frac_part.length(), fractionDigits, operation);
            }

            if (exists totalDigits) {
                # a value of zero still has one digit
                int total = int_part.length() + frac_part.length();
                if (!total) {
                    total = 1;
                }
                if (total > totalDigits) {
                    throw errType, sprintf("value %y for simpleType %y has %d total digits, "
                        "but maximum is %d during %s", val, name, total, totalDigits, operation);
                }
            }
        }
    }

    auto deserializeValue(string en, hash<string, XsdAbstractType> tmap, *hash<auto> mrh, auto val) {
        *XsdScopedLexicalContext lexical_scope;
        if (val instanceof XsdScopedLexicalValue) {
            lexical_scope = new XsdScopedLexicalContext(val, NOTHING);
            val = val.getLexicalValue();
        }
        XsdQNameNamespaceScope qname_scope(val.typeCode() == NT_HASH ? val."^attributes^" : NOTHING);
        XsdAbstractType selected = XsdTypeSubstitutionHelper::select(\val, self, tmap, en);
        if (selected !== self) {
            return XsdDocumentValueHelper::deserializeValue(selected, en, tmap, mrh, val);
        }
        # Handle list type deserialization
        if (val.typeCode() == NT_HASH && val.hasKey("^attributes^")) {
            XsdBase::validateSimpleAttributes(val."^attributes^", name);
        }
        if (getFacetKind() == "NOTATION") {
            XsdQNameValue value = validateQNameValue(val, QNameInputNamespaces, SOAP_DESERIALIZATION_ERROR);
            return new XsdNotationValue(value.getNamespaceUri(), value.getLexicalValue());
        }
        if (getFacetKind() == "QName") {
            return XsdQNameValueHelper::native(validateQNameValue(val, QNameInputNamespaces,
                SOAP_DESERIALIZATION_ERROR));
        }
        if (listItemType) {
            return deserializeList(en, tmap, mrh, val);
        }

        if (getFacetKind() == "union") {
            hash<XsdSchemaUnionTrialResult> result = deserializeUnion(en, tmap, mrh, val);
            bool item_boundary = SchemaUnionItemCapture && SchemaUnionItemCapture.target === self;
            auto converted = (result.owner || item_boundary) && !SchemaUnionValueProbe
                ? preserveUnionValue(en, tmap, mrh, val, result) : result.value;
            if (SchemaUnionItemCapture && SchemaUnionItemCapture.target === self) {
                SchemaUnionItemCapture.identity = result.identity;
            }
            return converted;
        }

        if (getCalendarBaseName()) {
            string lexical = XsdCalendarFacetHelper::validate(getCalendarFacets(),
                XsdScalarTextHelper::value(val, SOAP_DESERIALIZATION_ERROR), SOAP_DESERIALIZATION_ERROR);
            auto converted = type.deserializeValue(en, tmap, mrh, lexical);
            return patterns ? lexical : converted;
        }
        if (getDurationBaseName()) {
            string lexical = XsdDurationFacetHelper::validate(getDurationFacets(),
                XsdScalarTextHelper::value(val, SOAP_DESERIALIZATION_ERROR), SOAP_DESERIALIZATION_ERROR);
            auto converted = type.deserializeValue(en, tmap, mrh, lexical);
            return patterns ? lexical : converted;
        }
        if (getBinaryBaseName()) {
            string lexical = XsdBinaryFacetHelper::validate(getBinaryFacets(),
                XsdScalarTextHelper::value(val, SOAP_DESERIALIZATION_ERROR), SOAP_DESERIALIZATION_ERROR);
            auto converted = type.deserializeValue(en, tmap, mrh, lexical);
            return patterns ? new XsdBinaryValue(getBinaryBaseName(), lexical) : converted;
        }

        if (getNumericBaseName()) {
            string lexical = XsdNumericFacetHelper::validate(getNumericFacets(),
                XsdScalarTextHelper::value(val, SOAP_DESERIALIZATION_ERROR), SOAP_DESERIALIZATION_ERROR);
            auto converted = type.deserializeValue(en, tmap, mrh, val);
            return patterns ? lexical : converted;
        }

        if (listItemValueInfo) {
            *XsdSchemaUnionItemCapture caller = SchemaUnionListCapture;
            *XsdSimpleType target = listItemValueInfo.union_item ? XsdUnionValueHelper::listType(type) : NOTHING;
            bool capture_owner = target && (!caller || caller.target !== target);
            on_exit if (capture_owner) {
                SchemaUnionListCapture = caller;
            }
            if (capture_owner) {
                SchemaUnionListCapture = new XsdSchemaUnionItemCapture(target);
            }
            auto text = XsdScalarTextHelper::value(val, SOAP_DESERIALIZATION_ERROR);
            if (exists text && !text.strp()) {
                throw SOAP_DESERIALIZATION_ERROR, "an XML list requires scalar lexical text";
            }
            string lexical = normalizeWhiteSpace(string(text), "collapse");
            list<auto> value = type.deserializeValue(en, tmap, mrh, lexical);
            validateFacets(value, "deserialize", lexical);
            if (!enumerationAccepts(value, listItemValueInfo.union_item ? SchemaUnionListCapture.identity : NOTHING)) {
                throw SOAP_DESERIALIZATION_ERROR, sprintf("list value for %Y is outside its enumeration", name);
            }
            return patterns ? XsdListValueHelper::retainedTokens(value, XsdListValueHelper::tokens(lexical)) : value;
        }

        if (getFacetKind() == "boolean") {
            string lexical = XsdBooleanLexicalHelper::lexical(
                XsdScalarTextHelper::value(val, SOAP_DESERIALIZATION_ERROR), SOAP_DESERIALIZATION_ERROR);
            validateFacets(lexical, "deserialize", lexical);
            auto converted = type.deserializeValue(en, tmap, mrh, val);
            return patterns ? lexical : converted;
        }

        if (StringKinds{getFacetKind()}) {
            val = applyWhiteSpace(XsdScalarTextHelper::value(val, SOAP_DESERIALIZATION_ERROR));
        }
        auto v = type.deserializeValue(en, tmap, mrh, val);

        # issue #5411: "whiteSpace" processing is applied to the lexical value before it is validated
        v = applyWhiteSpace(v);
        # Validate facets after deserialization
        validateFacets(v, "deserialize");

        if (!enumerationAccepts(v)) {
            throw "SOAP-DESERIALIZATION-ERROR", sprintf("value %y passed to simpleType %y while deserializing "
                "element %y is not in the enumeration list<auto> (%y)", v, name, en, enumValues.keys());
        }

        return v;
    }

    #! Deserialize a list type value from space-separated string
    private auto deserializeList(string en, hash<string, XsdAbstractType> tmap, *hash<auto> mrh, auto val) {
        bool capture = (exists SchemaUnionDeserializeContext || exists SchemaUnionListCapture)
            && XsdUnionValueHelper::schemaUnionItem(listItemType);
        *XsdSchemaUnionItemCapture caller_capture = SchemaUnionItemCapture;
        on_exit if (capture) {
            SchemaUnionItemCapture = caller_capture;
        }
        list<*hash<XsdUnionValueIdentity>> identities();
        val = XsdScalarTextHelper::value(val, SOAP_DESERIALIZATION_ERROR);
        if (exists val && !val.strp()) {
            throw SOAP_DESERIALIZATION_ERROR, "an XML list requires scalar lexical text";
        }

        # XSD list whitespace is fixed to collapse, before item boundaries are found.
        # Splitting first would pass TAB/LF/CR-separated items to a single scalar validator.
        string strVal = XsdSimpleType::normalizeWhiteSpace(string(val), getWhiteSpace());
        list<string> items = strVal.split(" ");

        # Deserialize each item
        list<auto> result = ();
        foreach string item in (items) {
            if (item != "") {  # Skip empty strings from multiple spaces
                if (capture) {
                    SchemaUnionItemCapture = new XsdSchemaUnionItemCapture(listItemType);
                }
                result += listItemType.deserializeValue(en, tmap, mrh, item);
                if (capture) {
                    push identities, SchemaUnionItemCapture.identity;
                }
            }
        }

        if (capture) {
            *hash<XsdUnionValueIdentity> identity = XsdUnionValueHelper::capturedIdentity(identities);
            if (identity && SchemaUnionDeserializeContext) {
                SchemaUnionDeserializeContext.identities{self.uniqueHash()} = identity;
            }
            if (SchemaUnionListCapture && SchemaUnionListCapture.target === self) {
                SchemaUnionListCapture.identity = identity;
            }
        }
        return result;
    }
}

class WsdlDeclarationFrame {
    public {
        string kind;
        hash<string, bool> names();
        bool binding_context = False;
    }
    constructor(string kind) {
        self.kind = kind;
    }
}

hashdecl WsdlComponentReference {
    string kind;
    string identity;
    string origin;
}

hashdecl WsdlImportInfo {
    string uri;
    string location;
}

hashdecl WsdlDeclarationInfo {
    string target_namespace;
    hash<string, bool> components;
    list<hash<WsdlComponentReference>> references;
    list<hash<WsdlImportInfo>> imports;
}

hashdecl WsdlDocumentInfo {
    string source;
    *string resource_key;
    *string location;
    *string base;
    hash<auto> data;
    hash<WsdlDeclarationInfo> declarations;
    bool schema;
}

# Construction-only metadata. Component objects do not retain this catalog.
class WsdlComponentRegistry {
    private {
        hash<string, string> names();
    }

    constructor(list<hash<WsdlDocumentInfo>> documents) {
        hash<string, bool> declarations();
        hash<string, int> local_counts();
        foreach hash<WsdlDocumentInfo> document in (documents) {
            foreach string key in (keys document.declarations.components) {
                if (declarations{key}) {
                    throw WSDL_ERROR, sprintf("duplicate imported WSDL component %Y", key);
                }
                declarations{key} = True;
                string kind = substr(key, 0, index(key, ":"));
                string local = (key =~ x/}([^}]+)$/)[0];
                ++local_counts{kind + ":" + local};
            }
        }
        foreach string key in (keys declarations) {
            int separator = index(key, ":");
            string kind = substr(key, 0, separator);
            string identity = substr(key, separator + 1);
            string local = (identity =~ x/}([^}]+)$/)[0];
            names{key} = local_counts{kind + ":" + local} == 1 ? local : identity;
        }
        foreach hash<WsdlDocumentInfo> document in (documents) {
            foreach hash<WsdlComponentReference> ref in (document.declarations.references) {
                if (!exists names{ref.kind + ":" + ref.identity}) {
                    throw WSDL_ERROR, sprintf("%s references undefined WSDL %s %Y", ref.origin, ref.kind,
                        ref.identity);
                }
            }
        }
    }

    hash<string, string> getKeys() {
        return names;
    }

    string key(string kind, *string uri, string local) {
        string identity = kind + ":" + sprintf("{%s}%s", uri ?? "", local);
        if (!exists names{identity}) {
            throw WSDL_ERROR, sprintf("undefined WSDL component %Y", identity);
        }
        return names{identity};
    }

    string resolve(string kind, string value, Namespaces nsc) {
        value = XsdNameLexicalHelper::lexical("QName", value, WSDL_ERROR);
        list<string> parts = value.split(":");
        *string uri = parts.size() == 2 ? nsc.getInputNamespaceUri(parts[0]) : nsc.getDefaultNs();
        if (parts.size() == 2 && !uri) {
            throw WSDL_ERROR, sprintf("unbound prefix in WSDL %s reference %Y", kind, value);
        }
        return key(kind, uri, parts[-1]);
    }
}

hashdecl WsdlFetchedDocument {
    string source;
    string location;
}

class WsdlDocumentCatalog {
    static list<hash<WsdlDocumentInfo>> load(string source, *string location, *string base,
            code<hash<WsdlFetchedDocument>(string, string)> fetch, hash<string, string> aliases) {
        list<hash<WsdlDocumentInfo>> documents = (read(source, location, base, False),);
        hash<string, int> known();
        if (location) {
            known{location} = 0;
            foreach string alias in (keys aliases) {
                if (aliases{alias} == location) {
                    known{alias} = 0;
                }
            }
        }
        int next = 0;
        while (next < documents.size()) {
            hash<WsdlDocumentInfo> document = documents[next++];
            foreach hash<WsdlImportInfo> edge in (document.declarations.imports) {
                string resolved = document.location
                    ? WSDLLib::resolveDocumentLocation(edge.location, document.location)
                    : WSDLLib::resolveLocation(edge.location, document.base);
                *string child_location = WSDLLib::getUriDocumentLocation(resolved);
                if (child_location) {
                    resolved = child_location;
                }
                string identity = WSDLLib::normalizeLocation(resolved, "file", NOTHING);
                int index;
                if (exists known{identity}) {
                    index = known{identity};
                } else {
                    hash<WsdlFetchedDocument> fetched = fetch(resolved, edge.location);
                    string child_source = fetched.source;
                    child_location = fetched.location;
                    *string child_base = WSDLLib::getLocationBase(child_location);
                    if (exists known{child_location}) {
                        index = known{child_location};
                    } else if (!location && child_source == source
                            && WSDLLib::normalizeLocation(WSDLLib::resolveLocation(".", child_base ?? "."))
                                == WSDLLib::normalizeLocation(WSDLLib::resolveLocation(".", base ?? "."))) {
                        index = 0;
                    } else {
                        hash<WsdlDocumentInfo> child = read(child_source, child_location, child_base, True, child_location);
                        index = documents.size();
                        push documents, child;
                    }
                    known{identity} = index;
                    known{child_location} = index;
                }
                if (documents[index].declarations.target_namespace != edge.uri) {
                    throw WSDL_ERROR, sprintf("WSDL import %Y requires namespace %Y, got %Y", resolved,
                        edge.uri, documents[index].declarations.target_namespace);
                }
            }
        }
        return documents;
    }

    private static hash<WsdlDocumentInfo> read(string source, *string location, *string base,
            bool allow_schema, *string resource_key) {
        bool schema = False;
        XmlReader reader(source);
        while (reader.read()) {
            if (reader.nodeType() != XML_NODE_TYPE_ELEMENT) {
                continue;
            }
            schema = allow_schema && reader.localName() == "schema" && reader.namespaceUri() == XSD_NS;
            break;
        }
        hash<WsdlDeclarationInfo> declarations;
        if (schema) {
            declarations = <WsdlDeclarationInfo>{
                "target_namespace": XsdSimpleType::normalizeWhiteSpace(
                    reader.getAttribute("targetNamespace") ?? "", "collapse"),
                "components": {}, "references": (), "imports": (),
            };
        } else {
            declarations = WsdlDeclarationGrammar::scan(source);
        }
        hash<auto> data = XsdSchemaSource::parse(source);
        WSDL::XsdBase::removeNS(\data);
        if (!schema) {
            WSDL::XsdBase::removeNS(\data.definitions);
        }
        return <WsdlDocumentInfo>{"source": source, "resource_key": resource_key, "location": location, "base": base,
            "data": data, "declarations": declarations, "schema": schema};
    }
}

#! Validate document and declaration identity before namespace aliases are grouped.
class WsdlDeclarationGrammar {
    private {
        const Namespace = "http://schemas.xmlsoap.org/wsdl/";
        const Global = {"message": True, "portType": True, "binding": True, "service": True};
    }

    static validate(string xml) {
        hash<WsdlDeclarationInfo> info = scan(xml);
        foreach hash<WsdlComponentReference> ref in (info.references) {
            if (!info.components{ref.kind + ":" + ref.identity}) {
                throw WSDL_ERROR, sprintf("%s references undefined WSDL %s %Y", ref.origin, ref.kind, ref.identity);
            }
        }
    }

    static hash<WsdlDeclarationInfo> scan(string xml) {
        XmlReader reader(xml);
        hash<string, WsdlDeclarationFrame> frames();
        hash<string, bool> components();
        list<hash<WsdlComponentReference>> references();
        list<hash<WsdlImportInfo>> imports();
        string target_namespace;
        bool root = False;
        while (reader.read()) {
            int depth = reader.depth();
            string key = string(depth);
            if (reader.nodeType() == XML_NODE_TYPE_END_ELEMENT) {
                remove frames{key};
                continue;
            }
            if (reader.nodeType() != XML_NODE_TYPE_ELEMENT) {
                continue;
            }
            string local = reader.localName();
            bool wsdl = reader.namespaceUri() == Namespace;
            if (depth == 0) {
                if (!wsdl || local != "definitions") {
                    throw WSDL_ERROR, sprintf("expected WSDL 1.1 definitions root, got {%s}%s",
                        reader.namespaceUri() ?? "", local);
                }
                root = True;
                target_namespace = XsdSimpleType::normalizeWhiteSpace(reader.getAttribute("targetNamespace") ?? "",
                    "collapse");
            }
            *WsdlDeclarationFrame parent = frames{string(depth - 1)};
            if (wsdl && parent.kind == "definitions" && local == "import") {
                *string uri = reader.getAttribute("namespace");
                *string location = reader.getAttribute("location");
                if (!exists uri || !exists location) {
                    throw WSDL_ERROR, "WSDL import requires namespace and location attributes";
                }
                push imports, <WsdlImportInfo>{"uri": XsdSimpleType::normalizeWhiteSpace(uri, "collapse"),
                    "location": XsdSimpleType::normalizeWhiteSpace(location, "collapse")};
            }
            bool named_global = parent.kind == "definitions" && Global{local};
            bool part = parent.kind == "message" && local == "part";
            bool port = parent.kind == "service" && local == "port";
            bool operation = (parent.kind == "portType" || parent.kind == "binding") && local == "operation";
            bool fault = parent.kind == "operation" && local == "fault";
            bool parameter = parent.kind == "operation" && (local == "input" || local == "output");
            bool header = parent.binding_context && (reader.namespaceUri() == SOAP_11_NS
                || reader.namespaceUri() == SOAP_12_NS)
                && (((parent.kind == "input" || parent.kind == "output") && local == "header")
                    || (parent.kind == "header" && local == "headerfault"));
            bool active = (wsdl && (depth == 0 || named_global || part || port || operation || fault || parameter))
                || header;
            if (!active) {
                continue;
            }
            *string name = reader.getAttribute("name");
            if (!header && (named_global || part || port || operation || fault || exists name)) {
                if (!exists name) {
                    throw WSDL_ERROR, sprintf("WSDL %s requires a name", local);
                }
                name = XsdNameLexicalHelper::lexical("NCName", name, WSDL_ERROR);
            }
            # Operations may be overloaded; their input/output signatures are a separate identity.
            if (named_global || part || port || fault) {
                string identity = local + ":" + name;
                if (parent.names{identity}) {
                    throw WSDL_ERROR, sprintf("duplicate WSDL %s declaration %Y", local, name);
                }
                parent.names{identity} = True;
            }
            if (named_global) {
                components{local + ":" + sprintf("{%s}%s", target_namespace, name)} = True;
            }
            if (named_global && local == "binding") {
                push references, componentReference(reader, "type", "portType");
            } else if (port) {
                push references, componentReference(reader, "binding", "binding");
            } else if (header || ((parameter || fault) && !parent.binding_context)) {
                push references, componentReference(reader, "message", "message");
            }
            if (!reader.isEmptyElement()) {
                frames{key} = new WsdlDeclarationFrame(local);
                frames{key}.binding_context = parent.binding_context || (named_global && local == "binding");
            }
        }
        if (!root) {
            throw WSDL_ERROR, "missing WSDL 1.1 definitions root";
        }
        return <WsdlDeclarationInfo>{"target_namespace": target_namespace, "components": components,
            "references": references, "imports": imports};
    }

    private static hash<WsdlComponentReference> componentReference(XmlReader reader, string attribute,
            string kind) {
        *string value = reader.getAttribute(attribute);
        if (!exists value) {
            throw WSDL_ERROR, sprintf("WSDL %s requires %s", reader.localName(), attribute);
        }
        value = XsdNameLexicalHelper::lexical("QName", value, WSDL_ERROR);
        list<string> parts = value.split(":");
        *string uri = parts.size() == 2 ? reader.lookupNamespace(parts[0]) : reader.lookupNamespace();
        if (parts.size() == 2 && !uri) {
            throw WSDL_ERROR, sprintf("unbound prefix in WSDL %s reference %Y", kind, value);
        }
        return <WsdlComponentReference>{"kind": kind, "identity": sprintf("{%s}%s", uri ?? "", parts[-1]),
            "origin": reader.localName() + "@" + attribute};
    }
}

# The general XML data view groups equally named children. Keep the ordered view only
# inside XSD compositors; other WSDL/schema consumers retain their grouped interfaces.
class XsdSchemaSource {
    static hash<auto> parse(string xml) {
        hash<auto> value = parse_xml(xml, XPF_PRESERVE_ORDER);
        convert(\value, "", {});
        return value;
    }

    # Extract plain text while retaining the original XML view in the saved source.
    static string documentationText(auto value) {
        list<auto> pending();
        push pending, value;
        list<string> text();
        while (pending) {
            auto node = pop pending;
            if (node.typeCode() == NT_LIST) {
                for (int i = node.size() - 1; i >= 0; --i) {
                    push pending, node[i];
                }
            } else if (node.typeCode() == NT_HASH) {
                list<string> names = keys node;
                for (int i = names.size() - 1; i >= 0; --i) {
                    string name = names[i];
                    if ((!name.startsWith("^") && !name.startsWith("."))
                            || name =~ /^\^(value|cdata)[0-9]*\^$/) {
                        push pending, node{name};
                    }
                }
            } else if (node.typeCode() == NT_STRING) {
                push text, node;
            } else if (exists node) {
                throw WSDL_ERROR, "invalid schema documentation data";
            }
        }
        return text.join("");
    }

    private static convert(reference<auto> value, string name, hash<string, string> namespaces,
            bool annotation_content = False, bool in_schema = False, string wsdl_parent = "") {
        if (value.typeCode() == NT_LIST) {
            foreach auto child in (\value) {
                convert(\child, name, namespaces, annotation_content, in_schema, wsdl_parent);
            }
            return;
        }
        foreach string key in (keys value."^attributes^") {
            if (key == "xmlns") {
                namespaces{""} = value."^attributes^"{key};
            } else if (key.startsWith("xmlns:")) {
                namespaces{substr(key, 6)} = value."^attributes^"{key};
            }
        }
        int colon = name.find(":");
        string local = colon < 0 ? name : substr(name, colon + 1);
        string uri = namespaces{colon < 0 ? "" : substr(name, 0, colon)} ?? "";
        annotation_content = annotation_content || (uri == XSD_NS && (local == "appinfo" || local == "documentation"))
            || (uri == "http://schemas.xmlsoap.org/wsdl/" && local == "documentation");
        string wsdl_context = name == "" ? "root"
            : (uri == "http://schemas.xmlsoap.org/wsdl/" && !annotation_content
                && ((wsdl_parent == "root" && local == "definitions")
                    || (wsdl_parent == "definitions" && (local == "message" || local == "portType"
                        || local == "binding" || local == "service"))
                    || (wsdl_parent == "message" && local == "part")
                    || (wsdl_parent == "service" && local == "port")
                    || ((wsdl_parent == "portType" || wsdl_parent == "binding") && local == "operation")
                    || (wsdl_parent == "operation" && (local == "fault" || local == "input" || local == "output")))
                ? local : "");
        if (wsdl_context && exists value."^attributes^".name) {
            value."^attributes^".name = XsdNameLexicalHelper::lexical("NCName",
                value."^attributes^".name, WSDL_ERROR);
        }
        if (wsdl_context == "definitions" && exists value."^attributes^".targetNamespace) {
            value."^attributes^".targetNamespace = XsdSimpleType::normalizeWhiteSpace(
                value."^attributes^".targetNamespace, "collapse");
        }
        if (wsdl_context) {
            string attribute = wsdl_context == "binding" ? "type" : wsdl_context == "port" ? "binding"
                : (wsdl_context == "input" || wsdl_context == "output" || wsdl_context == "fault") ? "message" : "";
            if (attribute) {
                if (exists value."^attributes^"{attribute}) {
                    value."^attributes^"{attribute} = XsdNameLexicalHelper::lexical("QName",
                        value."^attributes^"{attribute}, WSDL_ERROR);
                }
            }
        }
        in_schema = in_schema || (!annotation_content && uri == XSD_NS && local == "schema");
        bool element_content = in_schema && uri == XSD_NS && !annotation_content;
        if (value.typeCode() != NT_HASH) {
            if (element_content && exists value) {
                validateWhitespace(value, name);
                value = NOTHING;
            }
            return;
        }
        bool ordered = annotation_content
            || (uri == XSD_NS && (local == "sequence" || local == "choice" || local == "all"));
        bool rewrite = False;
        foreach string key in (keys value) {
            if (key[0] == "^") {
                if (element_content && (key.startsWith("^value") || key.startsWith("^cdata"))) {
                    validateWhitespace(value{key}, name);
                    remove value{key};
                }
                continue;
            }
            int suffix = key.rfind("^");
            string child_name = suffix < 0 ? key : substr(key, 0, suffix);
            convert(\value{key}, child_name, namespaces, annotation_content, in_schema, wsdl_context);
            if (!ordered && suffix >= 0) {
                rewrite = True;
            }
        }
        # Most nodes have no separated runs of the same child name. Recurse through
        # those nodes in place; only the hashes with ordered suffixes need merging.
        if (!rewrite) {
            return;
        }
        hash<auto> result();
        foreach string key in (keys value) {
            int suffix = key[0] == "^" ? -1 : key.rfind("^");
            string output_key = suffix < 0 ? key : substr(key, 0, suffix);
            if (!result.hasKey(output_key)) {
                if (value{key}.typeCode() == NT_LIST) {
                    # XML may infer list<hash<auto>> from this run, while a later run
                    # contains an empty element. Give the grouped list its actual union type.
                    list<auto> children();
                    foreach auto child in (value{key}) {
                        push children, child;
                    }
                    result{output_key} = children;
                } else {
                    result{output_key} = value{key};
                }
            } else {
                if (result{output_key}.typeCode() != NT_LIST) {
                    list<auto> children();
                    push children, result{output_key};
                    result{output_key} = children;
                }
                if (value{key}.typeCode() == NT_LIST) {
                    foreach auto child in (value{key}) {
                        push result{output_key}, child;
                    }
                } else {
                    push result{output_key}, value{key};
                }
            }
        }
        value = result;
    }

    private static validateWhitespace(auto text, string name) {
        if (text.typeCode() != NT_STRING || text =~ /[^ \t\r\n]/) {
            throw WSDL_ERROR, sprintf("schema declaration %Y cannot contain non-whitespace text", name);
        }
    }
}

hashdecl XsdParticleDeclaration {
    string kind;
    *hash<auto> data;
}

class XsdParticleSource {
    # Read before namespace stripping: two aliases of the XSD namespace can occur
    # on either side of a different compositor and must not be grouped together.
    static list<hash<XsdParticleDeclaration>> children(*hash<auto> data) {
        list<hash<XsdParticleDeclaration>> result();
        foreach string key in (keys data) {
            if (key =~ /^\^/) {
                continue;
            }
            list<string> qname = key.split("^")[0].split(":");
            string kind = qname[qname.size() - 1];
            if (kind != "sequence" && kind != "choice" && kind != "all" && kind != "group"
                    && kind != "element" && kind != "any") {
                continue;
            }
            list<auto> values = data{key}.typeCode() == NT_LIST ? data{key} : (data{key},);
            foreach auto value in (values) {
                if (exists value && value.typeCode() != NT_HASH) {
                    throw WSDL_ERROR, sprintf("invalid %s particle declaration", kind);
                }
                push result, <XsdParticleDeclaration>{"kind": kind, "data": value};
            }
        }
        return result;
    }
}

#! XSD particle term kinds
/** @since %WSDL 0.5.8 */
public enum XsdParticleKind : string {
    #! An element declaration
    Element = "element",
    #! An element wildcard
    Any = "any",
    #! An ordered sequence
    Sequence = "sequence",
    #! Alternative particles
    Choice = "choice",
    #! Unordered element members
    All = "all",
    #! A named model group reference
    Group = "group",
}

hashdecl XsdParticleVisit {
    XsdParticle node;
    bool leaving = False;
}

#! Exact bounds on occurrences attributed to named element declarations
/** @since %WSDL 0.5.8 */
public hashdecl XsdParticleOccurrenceRange {
    #! Minimum count, as an exact nonnegative decimal integer
    string minimum;
    #! Maximum count, as an exact nonnegative decimal integer, or NOTHING for unbounded
    *string maximum;
}

#! An ordered XSD particle declaration with its own occurrence range
/** The particle retains group references and each individual declaration position. Element
    objects are shared with the schema's field metadata; occurrence constraints belong to the
    particle itself. This is schema construction metadata, independent of native value projection.

    @par Example: inspect the order of an invoice's content
    @code{.py}
    XsdSchema schema("<xs:schema xmlns:xs='http://www.w3.org/2001/XMLSchema'>"
        "<xs:complexType name='Invoice'><xs:sequence><xs:element name='number' type='xs:string'/>"
        "<xs:choice><xs:element name='card' type='xs:string'/><xs:element name='transfer' type='xs:string'/>"
        "</xs:choice></xs:sequence></xs:complexType></xs:schema>");
    XsdComplexType invoice = cast<XsdComplexType>(schema.findType("Invoice"));
    list<XsdParticle> content = invoice.getParticle().getChildren();
    @assert(content[0].getElement().name == "number");
    @assert(content[1].getKind() == XsdParticleKind::Choice);
    invoice.getParticle().validateDeterminism();
    @assert(invoice.getParticle().matchesElementNames(("{}number", "{}card")));
    @assert(!invoice.getParticle().matchesElementNames(("{}card", "{}number")));
    @endcode

    @note Add and resolve schema documents before sharing their metadata between threads.
    @since %WSDL 0.5.8
*/
public final class XsdParticle inherits Qore::Serializable {
    private {
        const hash<string, XsdParticleKind> Kinds = {
            "element": XsdParticleKind::Element, "any": XsdParticleKind::Any,
            "sequence": XsdParticleKind::Sequence, "choice": XsdParticleKind::Choice,
            "all": XsdParticleKind::All, "group": XsdParticleKind::Group,
        };
        XsdParticleKind kind;
        string minimum;
        *string maximum;
        *XsdElement element;
        *string group;
        *XsdParticle group_definition;
        *hash<XsdAttributeWildcardInfo> wildcard;
        list<XsdParticle> children();
        transient bool groups_resolved = False;
    }

    #! constructs a particle in its schema declaration context
    /** @param kind the schema term kind
        @param data the ordered XML declaration data
        @param nsc the declaration's namespace context
        @param unresolved the schema's late resolution queue
        @param usedocns the local element qualification default
        @throw WSDL-ERROR an invalid term, occurrence range or missing declaration
        @throw XSD-ELEMENT-ERROR an element minimum exceeding its maximum
        @throw WSDL-NAMESPACE-ERROR an invalid declaration QName
        @note Schema clients normally obtain these objects from getParticle() on a type or group.
    */
    constructor(string kind, *hash<auto> data, Namespaces nsc,
            XsdLateResolverHelper unresolved, bool usedocns) {
        if (!Kinds.hasKey(kind)) {
            throw WSDL_ERROR, sprintf("invalid particle term %Y", kind);
        }
        self.kind = Kinds{kind};
        NamespacePrefixHelper scope(nsc, data."^attributes^");
        minimum = count(data."^attributes^".minOccurs ?? "1");
        string limit = XsdSimpleType::normalizeWhiteSpace(data."^attributes^".maxOccurs ?? "1", "collapse");
        maximum = limit == "unbounded" ? NOTHING : count(limit);
        if (exists maximum && XsdIntegerLexicalHelper::compare(minimum, maximum) > 0) {
            throw kind == "element" ? "XSD-ELEMENT-ERROR" : WSDL_ERROR,
                sprintf("%s particle minOccurs %s exceeds maxOccurs %s", kind, minimum, maximum);
        }
        if (kind == "element") {
            if (!data) {
                throw WSDL_ERROR, "element declaration requires name or ref";
            }
            # The component parser receives normalized XSD occurrence values, including
            # whitespace around 'unbounded'; the original document remains unchanged.
            if (exists data."^attributes^".minOccurs) {
                data."^attributes^".minOccurs = minimum;
            }
            if (exists data."^attributes^".maxOccurs) {
                data."^attributes^".maxOccurs = maximum ?? "unbounded";
            }
            element = new XsdElement(data, nsc, NOTHING, unresolved, usedocns);
        } else if (kind == "group") {
            if (!data."^attributes^".ref) {
                throw WSDL_ERROR, "group reference requires ref";
            }
            hash<auto> identity = nsc.getTypeHash(data."^attributes^".ref);
            group = type_qname(identity.uri, identity.val);
        } else if (kind == "any") {
            wildcard = XsdAttributeWildcardHelper::parse(data, nsc.getTargetNamespaceUri(), "any");
        } else {
            foreach hash<XsdParticleDeclaration> child in (XsdParticleSource::children(data)) {
                push children, new XsdParticle(child.kind, child.data, nsc, unresolved, usedocns);
            }
        }
    }

    private static string count(string value) {
        value = XsdSimpleType::normalizeWhiteSpace(value, "collapse");
        if (value !~ /\A(?:\+?[0-9]+|-0+)\z/) {
            throw WSDL_ERROR, sprintf("invalid particle occurrence count %Y", value);
        }
        value =~ s/^[+-]?0*//;
        return value ? value : "0";
    }

    private:internal deserializeMembers(hash<auto> members) {
        string term = string(members.kind);
        if (!Kinds.hasKey(term) || members.minimum.typeCode() != NT_STRING
                || members.minimum !~ /\A(?:0|[1-9][0-9]*)\z/
                || (exists members.maximum && (members.maximum.typeCode() != NT_STRING
                    || members.maximum !~ /\A(?:0|[1-9][0-9]*)\z/
                    || XsdIntegerLexicalHelper::compare(members.minimum, members.maximum) > 0))
                || members.children.typeCode() != NT_LIST
                || ((term == "element") != (members.element instanceof XsdElement))
                || (exists members.element && !(members.element instanceof XsdElement))
                || (exists members.group_definition && !(members.group_definition instanceof XsdParticle))
                || (term == "group" ? (members.group.typeCode() != NT_STRING || !members.group)
                    : (exists members.group || exists members.group_definition))
                || ((term == "element" || term == "group" || term == "any") && members.children)
                || (term == "any" ? members.wildcard.typeCode() != NT_HASH : exists members.wildcard)) {
            throw "DESERIALIZATION-ERROR", "invalid serialized XSD particle";
        }
        foreach auto child in (members.children) {
            if (!(child instanceof XsdParticle) || child === self) {
                throw "DESERIALIZATION-ERROR", "invalid serialized XSD particle child";
            }
        }
        kind = Kinds{term};
        minimum = members.minimum;
        maximum = members.maximum;
        element = members.element;
        group = members.group;
        group_definition = members.group_definition;
        if (term == "any") {
            wildcard = new hash<XsdAttributeWildcardInfo>(members.wildcard);
            if (wildcard.constraint != XsdWildcardConstraint::Any && wildcard.constraint != XsdWildcardConstraint::Not
                    && wildcard.constraint != XsdWildcardConstraint::Set) {
                throw "DESERIALIZATION-ERROR", "invalid serialized particle wildcard constraint";
            }
            if (wildcard.processing != XsdWildcardProcessing::Strict && wildcard.processing != XsdWildcardProcessing::Lax
                    && wildcard.processing != XsdWildcardProcessing::Skip) {
                throw "DESERIALIZATION-ERROR", "invalid serialized particle wildcard processing mode";
            }
        }
        children = members.children;
    }

    private constructor(list<XsdParticle> children) {
        kind = XsdParticleKind::Sequence;
        minimum = maximum = "1";
        self.children = children;
    }

    #! combines base and extension content in schema order
    /** @param base the base type's particle, if any
        @param extension the extension's particle, if any
        @return a sequence containing both particles, or the sole nonempty argument
    */
    static *XsdParticle concatenate(*XsdParticle base, *XsdParticle extension) {
        return base && extension ? new XsdParticle((base, extension)) : base ?? extension;
    }

    #! resolves named group references without expanding their declarations
    /** @param groups the schema's checked named model groups
        @throw WSDL-ERROR a missing or cyclic group reference
        @note Called during schema construction, before sharing a schema between threads.
    */
    resolveGroups(hash<string, XsdGroup> groups) {
        list<hash<XsdParticleVisit>> pending = (<XsdParticleVisit>{"node": self},);
        hash<string, bool> visiting();
        while (pending) {
            hash<XsdParticleVisit> visit = pop pending;
            XsdParticle node = visit.node;
            if (visit.leaving) {
                node.groups_resolved = True;
                delete visiting{node.uniqueHash()};
                continue;
            }
            if (node.groups_resolved) {
                continue;
            }
            if (visiting{node.uniqueHash()}) {
                throw WSDL_ERROR, "cyclic particle child graph";
            }
            visiting{node.uniqueHash()} = True;
            if (node.group) {
                *XsdGroup target = groups{node.group};
                if (!target) {
                    throw WSDL_ERROR, sprintf("undefined group reference %Y", node.group);
                }
                target.resolveNestedGroups(groups);
                node.group_definition = target.getParticle();
            }
            push pending, <XsdParticleVisit>{"node": node, "leaving": True};
            foreach XsdParticle child in (node.children) {
                push pending, <XsdParticleVisit>{"node": child};
            }
        }
    }

    #! returns the term kind
    /** @return element, any, sequence, choice, all, or group */
    XsdParticleKind getKind() { return kind; }
    #! returns the minimum number of occurrences of this whole particle
    /** @return an exact nonnegative integer in decimal notation */
    string getMinOccurs() { return minimum; }
    #! returns the maximum number of occurrences of this whole particle
    /** @return an exact nonnegative integer in decimal notation, or NOTHING for unbounded */
    *string getMaxOccurs() { return maximum; }
    #! returns this position's element declaration
    /** @return the shared schema element, or NOTHING for another term kind */
    *XsdElement getElement() { return element; }
    #! returns the namespace-qualified named group reference
    /** @return the expanded group identity, or NOTHING for another term kind */
    *string getGroupReference() { return group; }
    #! returns the resolved named model group
    /** @return the referenced group's particle after schema construction, or NOTHING for another term kind */
    *XsdParticle getGroupDefinition() { return group_definition; }
    #! returns direct child particles in declaration order
    /** @return a copy-on-write list; a group reference is retained as a reference */
    list<XsdParticle> getChildren() { return children; }

    #! returns the namespace and processing constraints of an element wildcard
    /** @return wildcard construction metadata, or NOTHING for another term kind
        @note Element and attribute wildcards use the same namespace constraint algebra.
    */
    *hash<XsdAttributeWildcardInfo> getWildcard() { return wildcard; }

    #! checks the order and complete occurrence ranges of expanded child names
    /** @param names child element names in {namespace-uri}local-name form, in document order
        @return True if the sequence matches this particle's language
        @throw WSDL-ERROR unresolved/cyclic groups or an invalid XSD 1.0 all placement
        @throw XSD-PARTICLE-ERROR a malformed expanded element name
        @note This checks structure and wildcard namespace admission; element values, xsi:type,
        nil, wildcard declaration validation and schema ambiguity require their separate schema checks.
    */
    bool matchesElementNames(list<string> names) {
        XsdParticleProgram program(self);
        return program.matches(names);
    }

    #! identifies the terminal declaration for every child in a complete ordered match
    /** @param names expanded child element names in document order
        @return one particle per input child, an empty list for accepted empty content, or NOTHING if rejected
        @throw WSDL-ERROR unresolved/cyclic groups or invalid XSD 1.0 all placement
        @throw XSD-PARTICLE-ERROR a malformed expanded name
        @note Complete schema attribution validation before using this conversion projection.
        Repetition boundaries may differ while selecting the same declaration position.
        Element values and wildcard processing still require their separate validation.
        @since %WSDL 0.5.8
    */
    *list<XsdParticle> attributeElementNames(list<string> names) {
        XsdParticleProgram program(self);
        return program.attribute(names);
    }

    #! finds a complete particle ordering of a collection of expanded child names
    /** @param names expanded child names, with one entry for each supplied occurrence
        @return the original order if it matches, otherwise a deterministic matching permutation,
        or NOTHING when no permutation matches; an accepted empty collection returns an empty list
        @throw WSDL-ERROR unresolved/cyclic groups or invalid XSD 1.0 all placement
        @throw XSD-PARTICLE-ERROR a malformed expanded name
        @note This reconstructs structural order only. Values sharing a name keep their supplied order.
        Use XsdXmlValue to retain a particular original interleaving. General unordered allocation uses
        count-vector dynamic programming: its state space is bounded by the product of the supplied
        per-name counts plus one, and can grow exponentially with the number of distinct names.
        Ordered matching retains its separate polynomial bound. No numeric occurrence range is expanded.
        @par Example
        A batch with two quantity/note groups can supply two values in each native field. The returned
        quantity/note/quantity/note schedule places each field's first value before its second value.
        @since %WSDL 0.5.8
    */
    *list<string> orderElementNames(list<string> names) {
        XsdParticleProgram program(self);
        return program.order(names);
    }

    #! constructs a bounded example of the complete particle's child-name sequence
    /** @param max_occurrences maximum nonempty repetitions of each particle, at least one; default: 3
        @param max_children maximum total child names in this example, at least zero; default: 10000
        @return a deterministic accepted sequence of expanded names, possibly empty
        @throw XSD-SAMPLE-ERROR invalid generation limits or no structural example within those limits
        @throw WSDL-ERROR unresolved/cyclic groups or invalid XSD 1.0 all placement
        @note Limits apply to generation, not schema validity. Empty repetitions can satisfy arbitrarily
        large minima without allocating children. Choices prefer their first feasible alternative;
        sequences reserve space for every required suffix. Wildcard names satisfy namespace constraints
        only: values, declarations, processContents and dynamic types require separate instance checks.
        The bottom-up algorithm stores two bounded words per graph node and clamps counts before allocation.
        @par Example
        For a shipment containing two to four quantity/note groups, getSampleElementNames(3, 6) returns
        three complete quantity/note pairs; a five-child budget permits two complete pairs.
        @since %WSDL 0.5.8
    */
    list<string> getSampleElementNames(int max_occurrences = 3, int max_children = 10000) {
        if (max_occurrences < 1 || max_children < 0) {
            throw "XSD-SAMPLE-ERROR", "particle sample limits require max_occurrences >= 1 and max_children >= 0";
        }
        XsdParticleProgram program(self);
        return program.sample(max_occurrences, max_children);
    }

    #! returns exact per-element occurrence bounds for the complete particle
    /** @return bounds keyed by expanded element name, an empty hash when no named declaration can occur,
        or NOTHING when the particle cannot accept any child sequence
        @throw WSDL-ERROR unresolved/cyclic groups or invalid XSD 1.0 all placement
        @note These are projections, not a replacement for complete particle validation: counts can have
        gaps, and fields can depend on one another. Wildcard positions are not named declarations.
        Bounds use particle limits and do not modify shared element declarations or public field types.
        @par Example
        A batch containing two to four repetitions of a quantity/note sequence has independent quantity
        and note bounds of two to four; accepting a batch still requires each complete ordered pair.
        @since %WSDL 0.5.8
    */
    *hash<string, hash<XsdParticleOccurrenceRange>> getElementOccurrenceRanges() {
        XsdParticleProgram program(self);
        return program.elementOccurrenceRanges();
    }

    #! validates XSD 1.0 unique particle attribution for this content model
    /** @throw WSDL-ERROR ambiguous particles, unresolved/cyclic groups or invalid all placement
        @note Occurrence counts are exact; repeated uses of one declaration do not themselves
        introduce ambiguity. Complete schema resolution before calling this method.
    */
    validateDeterminism() {
        XsdParticleProgram program(self);
        program.validateDeterminism();
    }
}

# Particle recognition shares the bounded structural matcher used by XSD patterns.
# The alphabet consists of expanded XML names, not encoded character surrogates.
class XsdParticleProgram {
    private {
        list<hash<XsdRegexNode>> nodes();
        hash<string, XsdParticle> terminals();
        hash<string, string> element_names();
        int root;
        *XsdRegexAutomaton automaton;
        *XsdParticle all;
        list<XsdParticle> all_positions();
        bool all_optional = False;
    }

    constructor(XsdParticle particle) {
        if (particle.getMaxOccurs() == "0" && particle.getKind() != XsdParticleKind::All) {
            push nodes, <XsdRegexNode>{"kind": XRN_EMPTY, "nullable": True};
            root = 0;
            automaton = XsdRegexAutomaton::compile(nodes, root);
            return;
        }
        XsdParticle top = particle;
        list<XsdParticle> references();
        hash<string, bool> seen();
        while (top.getKind() == XsdParticleKind::Group) {
            if (seen{top.uniqueHash()} || !top.getGroupDefinition()) {
                throw WSDL_ERROR, "unresolved or cyclic particle group reference";
            }
            seen{top.uniqueHash()} = True;
            push references, top;
            top = top.getGroupDefinition();
        }
        if (top.getKind() == XsdParticleKind::All) {
            references += top;
            foreach XsdParticle wrapper in (references) {
                if (wrapper.getMaxOccurs() != "1"
                        || (wrapper.getMinOccurs() != "0" && wrapper.getMinOccurs() != "1")) {
                    throw WSDL_ERROR, "XSD 1.0 all requires minOccurs 0 or 1 and maxOccurs 1";
                }
                all_optional = all_optional || wrapper.getMinOccurs() == "0";
            }
            foreach XsdParticle child in (top.getChildren()) {
                if (child.getKind() != XsdParticleKind::Element
                        || (child.getMaxOccurs() != "0" && child.getMaxOccurs() != "1")) {
                    throw WSDL_ERROR, "XSD 1.0 all members must be elements with maximum 0 or 1";
                }
                if (child.getMaxOccurs() != "0") {
                    push all_positions, child;
                    foreach string name in (keys child.getElement().getInstanceDeclarations()) {
                        if (terminals.hasKey(name)) {
                            throw WSDL_ERROR, sprintf("ambiguous all member %Y", name);
                        }
                        terminals{name} = child;
                    }
                }
            }
            all = top;
            return;
        }

        hash<string, int> compiled();
        hash<string, bool> visiting();
        list<hash<XsdParticleVisit>> work = (<XsdParticleVisit>{"node": particle},);
        bool shared = False;
        hash<string, int> uses();
        while (work) {
            hash<XsdParticleVisit> visit = pop work;
            XsdParticle node = visit.node;
            string key = node.uniqueHash();
            if (compiled.hasKey(key)) {
                continue;
            }
            if (node.getMaxOccurs() == "0") {
                compiled{key} = nodes.size();
                push nodes, <XsdRegexNode>{"kind": XRN_EMPTY, "nullable": True};
                continue;
            }
            list<XsdParticle> children = node.getChildren();
            if (node.getKind() == XsdParticleKind::Group) {
                if (!node.getGroupDefinition()) {
                    throw WSDL_ERROR, sprintf("unresolved particle group %Y", node.getGroupReference());
                }
                children = (node.getGroupDefinition(),);
            }
            if (!visit.leaving) {
                if (visiting{key}) {
                    throw WSDL_ERROR, "cyclic particle graph";
                }
                visiting{key} = True;
                if (node.getKind() == XsdParticleKind::All) {
                    throw WSDL_ERROR, "XSD 1.0 all cannot occur inside another model group";
                }
                push work, <XsdParticleVisit>{"node": node, "leaving": True};
                foreach XsdParticle child in (children) {
                    shared = ++uses{child.uniqueHash()} > 1 || shared;
                    push work, <XsdParticleVisit>{"node": child};
                }
                continue;
            }
            delete visiting{key};
            hash<XsdRegexNode> term();
            if (node.getMaxOccurs() == "0") {
                term.kind = XRN_EMPTY;
                term.nullable = True;
            } else if (node.getKind() == XsdParticleKind::Element) {
                # A substitution is a finite name alternative at the same declaration position.
                # Empty groups have an empty language, rather than admitting an abstract head.
                term.kind = XRN_ALTERNATIVE;
                foreach string name in (XsdElementFieldHelper::getPreferredInstanceNames(node.getElement())) {
                    int id = nodes.size();
                    terminals{id.toString()} = node;
                    element_names{id.toString()} = name;
                    push nodes, <XsdRegexNode>{"kind": XRN_CHARACTER};
                    push term.children, id;
                }
            } else if (node.getKind() == XsdParticleKind::Any) {
                term.kind = XRN_CHARACTER;
                terminals{nodes.size().toString()} = node;
            } else {
                term.kind = node.getKind() == XsdParticleKind::Choice ? XRN_ALTERNATIVE : XRN_SEQUENCE;
                term.nullable = term.kind == XRN_SEQUENCE;
                foreach XsdParticle child in (children) {
                    # Zero-occurrence declarations contribute no component, including
                    # no epsilon alternative to a choice (XSD 1.0 sections 3.3.2/3.8.2).
                    if (child.getMaxOccurs() == "0") {
                        continue;
                    }
                    int child_id = compiled{child.uniqueHash()};
                    push term.children, child_id;
                    term.nullable = term.kind == XRN_SEQUENCE
                        ? term.nullable && nodes[child_id].nullable : term.nullable || nodes[child_id].nullable;
                }
            }
            push nodes, term;
            int id = nodes.size() - 1;
            if (node.getMaxOccurs() != "0" && (node.getMinOccurs() != "1" || node.getMaxOccurs() != "1")) {
                push nodes, <XsdRegexNode>{"kind": XRN_REPEAT, "children": (id,),
                    "low": node.getMinOccurs(), "high": node.getMaxOccurs(),
                    "nullable": node.getMinOccurs() == "0" || term.nullable};
                id = nodes.size() - 1;
            }
            compiled{key} = id;
        }
        root = compiled{particle.uniqueHash()};
        # A Thompson fragment has one continuation. Shared group definitions use
        # the memoized structural path, which retains each caller's continuation.
        if (!shared) {
            automaton = XsdRegexAutomaton::compile(nodes, root);
        }
    }

    list<string> sample(int max_occurrences, int max_children) {
        if (all) {
            list<string> result();
            int required = 0;
            foreach XsdParticle position in (all_positions) {
                bool mandatory = position.getMinOccurs() == "1";
                if (mandatory && !position.getElement().getInstanceDeclarations()) {
                    if (all_optional) {
                        return result;
                    }
                    throw "XSD-SAMPLE-ERROR", "required all position has no concrete element declaration";
                }
                required += int(mandatory);
            }
            if (required > max_children) {
                if (all_optional) {
                    return result;
                }
                throw "XSD-SAMPLE-ERROR", sprintf("all-group sample requires %d children; max_children is %d",
                    required, max_children);
            }
            foreach XsdParticle position in (all_positions) {
                bool mandatory = position.getMinOccurs() == "1";
                if (mandatory) {
                    --required;
                }
                if (mandatory || result.size() < max_children - required) {
                    *string name = XsdElementFieldHelper::getPreferredInstanceNames(position.getElement())[0];
                    if (exists name) {
                        push result, name;
                    }
                }
            }
            return result;
        }
        XsdParticleSamplePlanner planner(nodes, terminals, element_names, max_occurrences, max_children);
        return planner.sample(root);
    }

    *hash<string, hash<XsdParticleOccurrenceRange>> elementOccurrenceRanges() {
        if (all) {
            hash<string, hash<XsdParticleOccurrenceRange>> result();
            foreach XsdParticle position in (all_positions) {
                hash<string, XsdElement> admitted = position.getElement().getInstanceDeclarations();
                if (!admitted && position.getMinOccurs() == "1") {
                    return all_optional ? new hash<string, hash<XsdParticleOccurrenceRange>>() : NOTHING;
                }
                foreach string name in (keys admitted) {
                    result{name} = <XsdParticleOccurrenceRange>{
                        "minimum": all_optional || admitted.size() != 1 ? "0" : position.getMinOccurs(),
                        "maximum": position.getMaxOccurs()};
                }
            }
            return result;
        }
        # The compiled graph is in child-before-parent order, including shared
        # group definitions. Summarize each node once without expanding counts.
        list<hash<string, hash<XsdParticleOccurrenceRange>>> summaries();
        list<bool> productive();
        for (int index = 0; index < nodes.size(); ++index) {
            hash<XsdRegexNode> node = nodes[index];
            hash<string, hash<XsdParticleOccurrenceRange>> result();
            bool possible = True;
            switch (node.kind) {
                case XRN_EMPTY:
                    break;
                case XRN_CHARACTER: {
                    XsdParticle declaration = terminals{index.toString()};
                    if (declaration.getKind() == XsdParticleKind::Element) {
                        result{element_names{index.toString()}} =
                            <XsdParticleOccurrenceRange>{"minimum": "1", "maximum": "1"};
                    }
                    break;
                }
                case XRN_SEQUENCE:
                case XRN_ALTERNATIVE: {
                    bool choice = node.kind == XRN_ALTERNATIVE;
                    int alternatives = 0;
                    hash<string, int> appearances();
                    foreach int child in (node.children) {
                        @assert(child < index);
                        if (!productive[child]) {
                            if (!choice) {
                                possible = False;
                                result = {};
                                break;
                            }
                            continue;
                        }
                        ++alternatives;
                        foreach string name in (keys summaries[child]) {
                            hash<XsdParticleOccurrenceRange> incoming = summaries[child]{name};
                            if (!result.hasKey(name)) {
                                result{name} = incoming;
                            } else {
                                result{name}.minimum = choice
                                    ? (XsdIntegerLexicalHelper::compare(result{name}.minimum, incoming.minimum) < 0
                                        ? result{name}.minimum : incoming.minimum)
                                    : XsdDurationIntegerHelper::add(result{name}.minimum, incoming.minimum);
                                result{name}.maximum = upperBound(result{name}.maximum, incoming.maximum, choice);
                            }
                            ++appearances{name};
                        }
                    }
                    if (choice) {
                        possible = alternatives != 0;
                        foreach string name in (keys result) {
                            if (appearances{name} != alternatives) {
                                result{name}.minimum = "0";
                            }
                        }
                    }
                    break;
                }
                case XRN_REPEAT: {
                    int child = node.children[0];
                    @assert(child < index);
                    possible = productive[child] || node.low == "0";
                    if (productive[child]) {
                        foreach string name in (keys summaries[child]) {
                            hash<XsdParticleOccurrenceRange> value = summaries[child]{name};
                            result{name} = <XsdParticleOccurrenceRange>{
                                "minimum": XsdDurationIntegerHelper::multiply(value.minimum, node.low),
                                "maximum": upperProduct(value.maximum, node.high)};
                        }
                    }
                    break;
                }
                default:
                    @assert(False);
            }
            push summaries, result;
            push productive, possible;
        }
        return productive[root] ? summaries[root] : NOTHING;
    }

    private static *string upperBound(*string left, *string right, bool choice) {
        if (!exists left || !exists right) {
            return;
        }
        return choice ? (XsdIntegerLexicalHelper::compare(left, right) > 0 ? left : right)
            : XsdDurationIntegerHelper::add(left, right);
    }

    private static *string upperProduct(*string left, *string right) {
        if (left == "0" || right == "0") {
            return "0";
        }
        return exists left && exists right ? XsdDurationIntegerHelper::multiply(left, right) : NOTHING;
    }

    static string namespaceOf(string name) {
        *list<string> parts = name =~ x/\A\{(.*)\}([^}]+)\z/;
        if (parts.size() != 2 || !Namespaces::isNCName(parts[1])) {
            throw "XSD-PARTICLE-ERROR", sprintf("invalid expanded child element name %Y", name);
        }
        return parts[0];
    }

    private bool terminal(int id, string name) {
        XsdParticle node = terminals{id.toString()};
        @assert(node);
        return node.getKind() == XsdParticleKind::Element ? element_names{id.toString()} == name
            : XsdAttributeWildcardHelper::allows(node.getWildcard(), namespaceOf(name));
    }

    bool matches(list<string> names) {
        foreach string name in (names) {
            string uri = namespaceOf(name);
        }
        if (all) {
            if (!names && all_optional) {
                return True;
            }
            hash<string, bool> seen();
            foreach string name in (names) {
                if (!terminals.hasKey(name)) {
                    return False;
                }
                string position = terminals{name}.uniqueHash();
                if (seen{position}) {
                    return False;
                }
                seen{position} = True;
            }
            foreach XsdParticle position in (all_positions) {
                if (!seen{position.uniqueHash()} && position.getMinOccurs() != "0") {
                    return False;
                }
            }
            return True;
        }
        XsdRegexMatcher matcher(nodes, names, \terminal());
        return matcher.matches(root, automaton);
    }

    *list<XsdParticle> attribute(list<string> names) {
        foreach string name in (names) {
            string uri = namespaceOf(name);
        }
        if (all) {
            if (!matches(names)) {
                return;
            }
            return map terminals{$1}, names;
        }
        XsdRegexMatcher matcher(nodes, names, \terminal());
        *list<int> positions = matcher.attribute(root, automaton);
        if (exists positions) {
            return map terminals{$1.toString()}, positions;
        }
    }

    *list<string> order(list<string> names) {
        if (matches(names)) {
            return names;
        }
        if (all) {
            # All accepts every permutation of a valid member collection.
            return;
        }
        bool wildcard = False;
        foreach XsdParticle declaration in (terminals.iterator()) {
            wildcard = wildcard || declaration.getKind() == XsdParticleKind::Any;
        }
        if (!wildcard) {
            *hash<string, hash<XsdParticleOccurrenceRange>> ranges = elementOccurrenceRanges();
            if (!exists ranges) {
                return;
            }
            hash<string, int> counts();
            foreach string name in (names) {
                if (!ranges.hasKey(name)) {
                    return;
                }
                ++counts{name};
            }
            foreach string name in (keys ranges) {
                string count = (counts{name} ?? 0).toString();
                if (XsdIntegerLexicalHelper::compare(count, ranges{name}.minimum) < 0
                        || (exists ranges{name}.maximum
                            && XsdIntegerLexicalHelper::compare(count, ranges{name}.maximum) > 0)) {
                    return;
                }
            }
        }
        XsdParticleOrderPlanner planner(nodes, names, \terminal());
        return planner.order(root);
    }

    validateDeterminism() {
        if (!all) {
            XsdParticleAmbiguity check(nodes, terminals, element_names, root);
        }
    }
}

hashdecl XsdParticleSampleWords {
    *list<string> minimum;
    *list<string> preferred;
}

# Each compiled node is summarized once, in child-before-parent order. The
# shortest bounded word guarantees room for required suffixes; the preferred
# word shows optional/repeated content when space permits. Neither word exceeds
# the caller's child budget. Empty repetitions are represented by no work.
class XsdParticleSamplePlanner {
    private {
        list<hash<XsdRegexNode>> nodes;
        hash<string, XsdParticle> terminals;
        hash<string, string> element_names;
        int max_occurrences;
        int max_children;
    }

    constructor(list<hash<XsdRegexNode>> nodes, hash<string, XsdParticle> terminals, hash<string, string> element_names,
            int max_occurrences, int max_children) {
        self.nodes = nodes;
        self.terminals = terminals;
        self.element_names = element_names;
        self.max_occurrences = max_occurrences;
        self.max_children = max_children;
    }

    private static *string sampleName(XsdParticle particle, *string element_name) {
        if (particle.getKind() == XsdParticleKind::Element) {
            @assert(exists element_name);
            return element_name;
        }
        hash<XsdAttributeWildcardInfo> wildcard = particle.getWildcard();
        if (wildcard.constraint == XsdWildcardConstraint::Any) {
            return "{}sample";
        }
        if (wildcard.constraint == XsdWildcardConstraint::Set) {
            foreach string uri in (keys wildcard.namespaces) {
                if (wildcard.namespaces{uri}) {
                    return type_qname(uri, "sample");
                }
            }
            return;
        }
        string uri = "urn:qore:xml:sample";
        return type_qname(uri == wildcard.excluded_namespace ? uri + ":other" : uri, "sample");
    }

    private static list<string> copies(list<string> word, int count) {
        list<string> result();
        if (word) {
            for (int index = 0; index < count; ++index) {
                foreach string name in (word) {
                    push result, name;
                }
            }
        }
        return result;
    }

    private hash<XsdParticleSampleWords> repeat(hash<XsdRegexNode> node,
            hash<XsdParticleSampleWords> child) {
        hash<XsdParticleSampleWords> result();
        if (!exists child.minimum) {
            if (node.low == "0") {
                result.minimum = result.preferred = ();
            }
            return result;
        }
        int minimum = 0;
        if (child.minimum) {
            int limit = min(max_occurrences, max_children / child.minimum.size());
            if (XsdIntegerLexicalHelper::compare(node.low, limit.toString()) > 0) {
                return result;
            }
            minimum = int(node.low);
        }
        result.minimum = copies(child.minimum, minimum);
        list<string> atom = child.preferred;
        # Prefer a complete shorter group over truncating a required repetition.
        if (atom && minimum > max_children / atom.size()) {
            atom = child.minimum;
        }
        int count = atom ? min(max_occurrences, max_children / atom.size()) : 0;
        if (exists node.high && XsdIntegerLexicalHelper::compare(node.high, count.toString()) < 0) {
            count = int(node.high);
        }
        @assert(!child.minimum || count >= minimum);
        result.preferred = copies(atom, count);
        return result;
    }

    list<string> sample(int root) {
        list<hash<XsdParticleSampleWords>> words();
        for (int index = 0; index < nodes.size(); ++index) {
            hash<XsdRegexNode> node = nodes[index];
            hash<XsdParticleSampleWords> result();
            switch (node.kind) {
                case XRN_EMPTY:
                    result.minimum = result.preferred = ();
                    break;
                case XRN_CHARACTER: {
                    *string name = sampleName(terminals{index.toString()}, element_names{index.toString()});
                    if (exists name && max_children) {
                        result.minimum = result.preferred = (name,);
                    }
                    break;
                }
                case XRN_ALTERNATIVE:
                    foreach int child in (node.children) {
                        @assert(child < index);
                        if (!exists words[child].minimum) {
                            continue;
                        }
                        if (!exists result.preferred) {
                            result.preferred = words[child].preferred;
                        }
                        if (!exists result.minimum || words[child].minimum.size() < result.minimum.size()) {
                            result.minimum = words[child].minimum;
                        }
                    }
                    break;
                case XRN_SEQUENCE: {
                    int length = 0;
                    bool possible = True;
                    foreach int child in (node.children) {
                        @assert(child < index);
                        if (!exists words[child].minimum || words[child].minimum.size() > max_children - length) {
                            possible = False;
                            break;
                        }
                        length += words[child].minimum.size();
                    }
                    if (!possible) {
                        break;
                    }
                    result.minimum = result.preferred = ();
                    foreach int child in (node.children) {
                        length -= words[child].minimum.size();
                        list<string> selected = words[child].preferred.size()
                            <= max_children - result.preferred.size() - length
                            ? words[child].preferred : words[child].minimum;
                        foreach string name in (words[child].minimum) {
                            push result.minimum, name;
                        }
                        foreach string name in (selected) {
                            push result.preferred, name;
                        }
                    }
                    break;
                }
                case XRN_REPEAT:
                    @assert(node.children[0] < index);
                    result = repeat(node, words[node.children[0]]);
                    break;
                default:
                    @assert(False);
            }
            push words, result;
        }
        if (!exists words[root].preferred) {
            throw "XSD-SAMPLE-ERROR", sprintf("no structural particle example within max_occurrences %d "
                "and max_children %d", max_occurrences, max_children);
        }
        return words[root].preferred;
    }
}

# One witness per reachable count vector is sufficient: a parent observes only
# counts and concatenates the witness. It never revisits alternative derivations.
hashdecl XsdParticleOrderState {
    list<int> counts;
    int witness = -1;
}

hashdecl XsdParticleOrderWitness {
    *string name;
    int left = -1;
    int right = -1;
}

class XsdParticleOrderPlanner {
    private {
        list<hash<XsdRegexNode>> nodes;
        list<string> alphabet();
        list<int> limits();
        code<bool(int, string)> terminal;
        int length;
        string target;
        hash<string, hash<XsdParticleOrderState>> epsilon();
        list<hash<XsdParticleOrderWitness>> witnesses();
    }

    constructor(list<hash<XsdRegexNode>> nodes, list<string> names, code<bool(int, string)> terminal) {
        self.nodes = nodes;
        self.terminal = terminal;
        length = names.size();
        hash<string, int> counts();
        foreach string name in (names) {
            ++counts{name};
        }
        alphabet = keys counts;
        limits = map counts{$1}, alphabet;
        target = key(limits);
        list<int> zero = map 0, alphabet;
        epsilon{key(zero)} = <XsdParticleOrderState>{"counts": zero};
    }

    private static string key(list<int> counts) {
        return (map $1.toString(), counts).join(",");
    }

    private static int bounded(string count, int limit) {
        return XsdIntegerLexicalHelper::compare(count, limit.toString()) > 0 ? limit : int(count);
    }

    private hash<string, hash<XsdParticleOrderState>> product(
            hash<string, hash<XsdParticleOrderState>> left, hash<string, hash<XsdParticleOrderState>> right) {
        hash<string, hash<XsdParticleOrderState>> result();
        foreach hash<XsdParticleOrderState> first in (left.iterator()) {
            foreach hash<XsdParticleOrderState> second in (right.iterator()) {
                list<int> sum();
                bool fits = True;
                for (int index = 0; index < limits.size(); ++index) {
                    # Subtract before adding so even impossible pairs cannot overflow.
                    if (first.counts[index] > limits[index] - second.counts[index]) {
                        fits = False;
                        break;
                    }
                    push sum, first.counts[index] + second.counts[index];
                }
                if (fits) {
                    string identity = key(sum);
                    if (!result.hasKey(identity)) {
                        int witness = first.witness;
                        if (witness < 0) {
                            witness = second.witness;
                        } else if (second.witness >= 0) {
                            witness = witnesses.size();
                            push witnesses, <XsdParticleOrderWitness>{"left": first.witness, "right": second.witness};
                        }
                        result{identity} = <XsdParticleOrderState>{"counts": sum,
                            "witness": witness};
                    }
                }
            }
        }
        return result;
    }

    *list<string> order(int root) {
        list<hash<string, hash<XsdParticleOrderState>>> states();
        for (int index = 0; index < nodes.size(); ++index) {
            hash<XsdRegexNode> node = nodes[index];
            hash<string, hash<XsdParticleOrderState>> result();
            switch (node.kind) {
                case XRN_EMPTY:
                    result = epsilon;
                    break;
                case XRN_CHARACTER:
                    for (int letter = 0; letter < alphabet.size(); ++letter) {
                        if (terminal(index, alphabet[letter])) {
                            list<int> counts = map 0, alphabet;
                            counts[letter] = 1;
                            result{key(counts)} = <XsdParticleOrderState>{"counts": counts,
                                "witness": witnesses.size()};
                            push witnesses, <XsdParticleOrderWitness>{"name": alphabet[letter]};
                        }
                    }
                    break;
                case XRN_SEQUENCE:
                    result = epsilon;
                    foreach int child in (node.children) {
                        result = product(result, states[child]);
                        if (!result) {
                            break;
                        }
                    }
                    break;
                case XRN_ALTERNATIVE:
                    foreach int child in (node.children) {
                        foreach string identity in (keys states[child]) {
                            if (!result.hasKey(identity)) {
                                result{identity} = states[child]{identity};
                            }
                        }
                    }
                    break;
                case XRN_REPEAT: {
                    int child = node.children[0];
                    bool nullable = nodes[child].nullable;
                    int low = nullable ? 0 : bounded(node.low, length + 1);
                    int high = exists node.high ? bounded(node.high, length) : length;
                    if (low > high) {
                        break;
                    }
                    hash<string, hash<XsdParticleOrderState>> atoms = states[child];
                    # Empty iterations can pad any minimum. Every remaining step
                    # consumes a supplied child, so at most length steps are needed.
                    delete atoms{epsilon.firstKey()};
                    hash<string, hash<XsdParticleOrderState>> frontier = epsilon;
                    if (!low) {
                        result = epsilon;
                    }
                    for (int count = 1; count <= high && frontier; ++count) {
                        frontier = product(frontier, atoms);
                        if (count >= low) {
                            foreach string identity in (keys frontier) {
                                if (!result.hasKey(identity)) {
                                    result{identity} = frontier{identity};
                                }
                            }
                        }
                    }
                    break;
                }
                default:
                    @assert(False);
            }
            push states, result;
        }
        if (!states[root].hasKey(target)) {
            return;
        }
        list<string> result();
        list<int> pending = (states[root]{target}.witness,);
        while (pending) {
            int index = pop pending;
            if (index < 0) {
                continue;
            }
            hash<XsdParticleOrderWitness> witness = witnesses[index];
            if (exists witness.name) {
                push result, witness.name;
            } else {
                push pending, witness.right;
                push pending, witness.left;
            }
        }
        return result;
    }
}

# Exact positive rationals. NOTHING denotes infinity; a zero threshold applies
# for every inherited repetition context N >= 1.
hashdecl XsdParticleRatio {
    string numerator = "1";
    string denominator = "1";
}

class XsdParticleRational {
    static hash<XsdParticleRatio> zero() {
        return <XsdParticleRatio>{"numerator": "0"};
    }

    static int compare(hash<XsdParticleRatio> left, hash<XsdParticleRatio> right) {
        return XsdIntegerLexicalHelper::compare(
            XsdDurationIntegerHelper::multiply(left.numerator, right.denominator),
            XsdDurationIntegerHelper::multiply(right.numerator, left.denominator));
    }

    static *hash<XsdParticleRatio> minimum(*hash<XsdParticleRatio> left, *hash<XsdParticleRatio> right) {
        return !left ? right : !right || compare(left, right) <= 0 ? left : right;
    }

    static *hash<XsdParticleRatio> maximum(*hash<XsdParticleRatio> left, *hash<XsdParticleRatio> right) {
        return !left || !right ? NOTHING : compare(left, right) >= 0 ? left : right;
    }

    static bool applies(*hash<XsdParticleRatio> threshold) {
        return threshold && XsdIntegerLexicalHelper::compare(threshold.numerator, threshold.denominator) <= 0;
    }

    static hash<XsdParticleRatio> threshold(string numerator, string denominator) {
        @assert(denominator != "0");
        return XsdIntegerLexicalHelper::compare(numerator, denominator) <= 0 ? zero()
            : <XsdParticleRatio>{"numerator": numerator, "denominator": denominator};
    }

    static *hash<XsdParticleRatio> scale(*hash<XsdParticleRatio> value, *string count) {
        if (!value) {
            return;
        }
        return !exists count ? zero()
            : threshold(value.numerator, XsdDurationIntegerHelper::multiply(value.denominator, count));
    }

    static *hash<XsdParticleRatio> withContext(*hash<XsdParticleRatio> value, bool inherit) {
        return inherit ? value : applies(value) ? zero() : NOTHING;
    }
}

hashdecl XsdParticleAmbiguityInfo {
    bool nullable = False;
    bool empty = False;
    hash<string, bool> first = {};
    hash<string, hash<XsdParticleRatio>> follow = {};
    *hash<XsdParticleRatio> ratio;
    *hash<XsdParticleRatio> plain;
    *hash<XsdParticleRatio> continuing;
}

# Chen/Lu's weak-determinism conditions, with Kilpelainen's flexibility
# calculation retained symbolically in the inherited maximum N. Each threshold
# represents all N at or above it. Shared definitions therefore need one summary,
# regardless of the number of paths or the magnitudes of occurrence counts.
class XsdParticleAmbiguity {
    private {
        hash<string, XsdParticle> terminals;
        hash<string, bool> overlap_cache();
        bool has_wildcards = False;
    }

    constructor(list<hash<XsdRegexNode>> nodes, hash<string, XsdParticle> terminals,
            hash<string, string> element_names, int root) {
        self.terminals = terminals;
        foreach XsdParticle terminal in (terminals.iterator()) {
            has_wildcards = has_wildcards || terminal.getKind() == XsdParticleKind::Any;
        }
        list<hash<XsdParticleAmbiguityInfo>> summaries();
        foreach hash<XsdRegexNode> node in (nodes) {
            hash<XsdParticleAmbiguityInfo> summary();
            switch (node.kind) {
                case XRN_EMPTY:
                    summary.nullable = True;
                    break;
                case XRN_CHARACTER:
                    string terminal_key = summaries.size().toString();
                    XsdParticle terminal = terminals{terminal_key};
                    if (terminal.getKind() == XsdParticleKind::Element) {
                        terminal_key = element_names{terminal_key};
                        self.terminals{terminal_key} = terminal;
                    }
                    summary.first{terminal_key} = True;
                    summary.ratio = new hash<XsdParticleRatio>();
                    break;
                case XRN_REPEAT:
                    summary = repeat(summaries[node.children[0]], node.low, node.high);
                    break;
                case XRN_SEQUENCE:
                case XRN_ALTERNATIVE:
                    summary.nullable = node.kind == XRN_SEQUENCE;
                    summary.empty = node.kind == XRN_ALTERNATIVE;
                    foreach int child in (node.children) {
                        combine(\summary, summaries[child], node.kind == XRN_ALTERNATIVE);
                    }
                    break;
                default:
                    @assert(False);
            }
            # Every present model group must satisfy its own component
            # constraints, even when a surrounding empty language is reduced.
            if (XsdParticleRational::applies(summary.plain)) {
                throw WSDL_ERROR, "content model violates XSD 1.0 unique particle attribution";
            }
            push summaries, summary;
        }
        @assert(root >= 0 && root < summaries.size());
    }

    private bool overlaps(string left, string right) {
        string key = sprintf("%d:%s%s", left.size(), left, right);
        if (overlap_cache.hasKey(key)) {
            return overlap_cache{key};
        }
        XsdParticle lhs = terminals{left};
        XsdParticle rhs = terminals{right};
        @assert(lhs && rhs);
        bool result = False;
        if (lhs.getKind() == XsdParticleKind::Element && rhs.getKind() == XsdParticleKind::Element) {
            result = left == right;
        } else if (lhs.getKind() == XsdParticleKind::Element) {
            result = XsdAttributeWildcardHelper::allows(rhs.getWildcard(), XsdParticleProgram::namespaceOf(left));
        } else if (rhs.getKind() == XsdParticleKind::Element) {
            result = XsdAttributeWildcardHelper::allows(lhs.getWildcard(), XsdParticleProgram::namespaceOf(right));
        } else {
            hash<XsdAttributeWildcardInfo> a = lhs.getWildcard();
            hash<XsdAttributeWildcardInfo> b = rhs.getWildcard();
            if (a.constraint == XsdWildcardConstraint::Set) {
                foreach string uri in (keys a.namespaces) {
                    if (XsdAttributeWildcardHelper::allows(b, uri)) {
                        result = True;
                        break;
                    }
                }
            } else if (b.constraint == XsdWildcardConstraint::Set) {
                foreach string uri in (keys b.namespaces) {
                    if (XsdAttributeWildcardHelper::allows(a, uri)) {
                        result = True;
                        break;
                    }
                }
            } else {
                # Any and cofinite constraints always share some namespace.
                result = True;
            }
        }
        overlap_cache{key} = result;
        return result;
    }

    private *hash<XsdParticleRatio> intersection(hash<string, hash<XsdParticleRatio>> follow,
            hash<string, bool> first) {
        if (!follow || !first) {
            return;
        }
        *hash<XsdParticleRatio> result;
        if (!has_wildcards) {
            foreach string key in (follow.size() < first.size() ? keys follow : keys first) {
                if (follow.hasKey(key) && first.hasKey(key)) {
                    result = XsdParticleRational::minimum(result, follow{key});
                }
            }
            return result;
        }
        list<string> wildcards = select keys first, $1[0] != "{";
        foreach string left in (keys follow) {
            if (first.hasKey(left)) {
                result = XsdParticleRational::minimum(result, follow{left});
            }
            # Exact expanded names use hash lookups. Only wildcard predicates
            # require a pairwise namespace-intersection test.
            foreach string right in (left[0] == "{" ? wildcards : keys first) {
                if (overlaps(left, right)) {
                    result = XsdParticleRational::minimum(result, follow{left});
                }
            }
        }
        return result;
    }

    private static hash<string, hash<XsdParticleRatio>> unconditional(hash<string, bool> first) {
        hash<string, hash<XsdParticleRatio>> result();
        foreach string key in (keys first) {
            result{key} = XsdParticleRational::zero();
        }
        return result;
    }

    private static hash<string, hash<XsdParticleRatio>> contexts(hash<string, hash<XsdParticleRatio>> source,
            bool inherit) {
        if (inherit) {
            return source;
        }
        hash<string, hash<XsdParticleRatio>> result();
        foreach string key in (keys source) {
            if (XsdParticleRational::applies(source{key})) {
                result{key} = XsdParticleRational::zero();
            }
        }
        return result;
    }

    private combine(reference<hash<XsdParticleAmbiguityInfo>> left,
            hash<XsdParticleAmbiguityInfo> right, bool choice) {
        if (left.empty || right.empty) {
            left = choice ? (left.empty ? right : left) : <XsdParticleAmbiguityInfo>{"empty": True};
            return;
        }
        hash<XsdParticleAmbiguityInfo> result();
        *hash<XsdParticleRatio> overlap = left.first.size() < right.first.size()
            ? intersection(unconditional(left.first), right.first)
            : intersection(unconditional(right.first), left.first);
        if (choice) {
            result.nullable = left.nullable || right.nullable;
            result.ratio = XsdParticleRational::maximum(left.ratio, right.ratio);
            result.plain = XsdParticleRational::minimum(overlap,
                XsdParticleRational::minimum(left.plain, right.plain));
            result.continuing = XsdParticleRational::minimum(overlap,
                XsdParticleRational::minimum(left.continuing, right.continuing));
            result.continuing = XsdParticleRational::minimum(result.continuing,
                XsdParticleRational::minimum(intersection(left.follow, right.first),
                    intersection(right.follow, left.first)));
            left.first += right.first;
            foreach string key in (keys right.follow) {
                left.follow{key} = XsdParticleRational::minimum(left.follow{key}, right.follow{key});
            }
            left.nullable = result.nullable;
            left.ratio = result.ratio;
            left.plain = result.plain;
            left.continuing = result.continuing;
            return;
        }
        result.nullable = left.nullable && right.nullable;
        hash<string, hash<XsdParticleRatio>> lf = contexts(left.follow, right.nullable);
        hash<string, hash<XsdParticleRatio>> rf = contexts(right.follow, left.nullable);
        result.ratio = left.nullable ? (right.nullable ? NOTHING : right.ratio)
            : right.nullable ? left.ratio : new hash<XsdParticleRatio>();
        *hash<XsdParticleRatio> base = XsdParticleRational::minimum(intersection(lf, right.first),
            left.nullable ? overlap : NOTHING);
        result.plain = XsdParticleRational::minimum(base,
            XsdParticleRational::minimum(XsdParticleRational::withContext(left.plain, right.nullable),
                XsdParticleRational::withContext(right.plain, left.nullable)));
        result.continuing = XsdParticleRational::minimum(base,
            XsdParticleRational::minimum(XsdParticleRational::withContext(
                    right.nullable ? left.continuing : left.plain, right.nullable),
                XsdParticleRational::withContext(left.nullable ? right.continuing : right.plain, left.nullable)));
        result.continuing = XsdParticleRational::minimum(result.continuing,
            XsdParticleRational::minimum(intersection(rf, left.first),
                !left.nullable && right.nullable ? overlap : NOTHING));
        remove lf;
        if (right.nullable) {
            foreach string key in (keys right.first) {
                left.follow{key} = XsdParticleRational::zero();
            }
            foreach string key in (keys rf) {
                left.follow{key} = XsdParticleRational::minimum(left.follow{key}, rf{key});
            }
        } else {
            left.follow = rf;
        }
        if (left.nullable) {
            left.first += right.first;
        }
        left.nullable = result.nullable;
        left.ratio = result.ratio;
        left.plain = result.plain;
        left.continuing = result.continuing;
    }

    private static hash<XsdParticleAmbiguityInfo> repeat(hash<XsdParticleAmbiguityInfo> child,
            string low, *string high) {
        if (high == "0" || (child.empty && low == "0")) {
            return <XsdParticleAmbiguityInfo>{"nullable": True};
        }
        if (child.empty) {
            return child;
        }
        if (child.nullable) {
            low = "0";
        }
        hash<XsdParticleAmbiguityInfo> result = child;
        result.nullable = low == "0" || child.nullable;
        if (high == "1") {
            if (low == "0") {
                result.ratio = NOTHING;
            }
            return result;
        }
        result.follow = {};
        foreach string key in (keys child.follow) {
            result.follow{key} = XsdParticleRational::scale(child.follow{key}, high);
        }
        *hash<XsdParticleRatio> flexible;
        if (!exists high || low != high || !child.ratio) {
            flexible = XsdParticleRational::zero();
        } else if (XsdIntegerLexicalHelper::compare(child.ratio.numerator, child.ratio.denominator) > 0) {
            string difference = XsdDurationIntegerHelper::add(child.ratio.numerator,
                XsdDurationIntegerHelper::negate(child.ratio.denominator));
            flexible = XsdParticleRational::threshold(child.ratio.numerator,
                XsdDurationIntegerHelper::multiply(difference, high));
        }
        if (flexible) {
            foreach string key in (keys child.first) {
                result.follow{key} = XsdParticleRational::minimum(result.follow{key}, flexible);
            }
        }
        if (low == "0" || !exists high || !child.ratio) {
            result.ratio = NOTHING;
        } else if (low != high) {
            result.ratio = <XsdParticleRatio>{
                "numerator": XsdDurationIntegerHelper::multiply(child.ratio.numerator, high),
                "denominator": XsdDurationIntegerHelper::multiply(child.ratio.denominator, low)};
        }
        result.plain = XsdParticleRational::scale(child.continuing, high);
        result.continuing = result.plain;
        return result;
    }
}

hashdecl XsdEmptiabilityInfo {
    bool optional = False;
    bool absent = False;
    bool choice = False;
    bool terminal = False;
    *string ref;
    list<hash<XsdEmptiabilityInfo>> children();
}

# Schema construction metadata for the Particle Emptiable predicate. This does not flatten
# occurrences into fields or match instance content; it retains nested zero/choice/sequence logic.
class XsdEmptiabilityHelper {
    # The wire representation uses ordinary containers. The private recursive hashdecl
    # is reconstructed inside its declaring module, rather than
    # asking Serializable to resolve a module-private list element type globally.
    static hash<auto> serialize(hash<XsdEmptiabilityInfo> info) {
        list<auto> children();
        foreach hash<XsdEmptiabilityInfo> child in (info.children) {
            push children, serialize(child);
        }
        return {"optional": info.optional, "absent": info.absent, "choice": info.choice,
            "terminal": info.terminal, "ref": info.ref, "children": children};
    }

    static hash<XsdEmptiabilityInfo> deserialize(auto data) {
        if (data.typeCode() != NT_HASH || data.children.typeCode() != NT_LIST
                || (exists data.ref && data.ref.typeCode() != NT_STRING)) {
            throw "DESERIALIZATION-ERROR", "invalid particle emptiability metadata";
        }
        foreach string flag in ("optional", "absent", "choice", "terminal") {
            if (data{flag}.typeCode() != NT_BOOLEAN) {
                throw "DESERIALIZATION-ERROR", sprintf("particle emptiability flag %Y must be a boolean", flag);
            }
        }
        hash<XsdEmptiabilityInfo> info = new hash<XsdEmptiabilityInfo>(data - "children");
        foreach auto child in (data.children) {
            push info.children, deserialize(child);
        }
        return info;
    }

    static hash<XsdEmptiabilityInfo> parse(*hash<auto> data, Namespaces nsc, string kind = "sequence") {
        NamespacePrefixHelper scope(nsc, data."^attributes^");
        hash<XsdEmptiabilityInfo> result = <XsdEmptiabilityInfo>{
            "optional": zeroOccurs(data."^attributes^".minOccurs),
            "absent": zeroOccurs(data."^attributes^".maxOccurs),
            "choice": kind == "choice",
            "terminal": kind == "element" || kind == "any",
        };
        if (kind == "group") {
            if (!data."^attributes^".ref) {
                throw WSDL_ERROR, "group reference requires ref";
            }
            hash<auto> identity = nsc.getTypeHash(data."^attributes^".ref);
            result.ref = type_qname(identity.uri, identity.val);
        } else if (!result.terminal) {
            foreach hash<XsdParticleDeclaration> child in (XsdParticleSource::children(data)) {
                result.children += parse(child.data, nsc, child.kind);
            }
        }
        return result;
    }

    static bool evaluate(hash<XsdEmptiabilityInfo> info, hash<string, XsdGroup> groups) {
        bool result = !info.terminal && (!info.choice || !info.children);
        if (info.ref) {
            *XsdGroup group = groups{info.ref};
            if (!group) {
                throw WSDL_ERROR, sprintf("undefined group reference %Y", info.ref);
            }
            result = group.isEmptiable(groups);
        }
        foreach hash<XsdEmptiabilityInfo> child in (info.children) {
            # Resolve every reference, including references under optional or already-emptiable branches.
            bool child_empty = evaluate(child, groups);
            result = info.choice ? result || child_empty : result && child_empty;
        }
        return info.absent || info.optional || result;
    }

    static bool hasEmptyContent(*hash<auto> data, bool mixed) {
        if (mixed) {
            return False;
        }
        WSDL::XsdBase::removeNS(\data);
        foreach string kind in ("group", "all", "choice", "sequence") {
            if (!data.hasKey(kind)) {
                continue;
            }
            *hash<auto> model = data{kind};
            if (zeroOccurs(model."^attributes^".maxOccurs)) {
                return True;
            }
            if (kind == "group") {
                return False;
            }
            WSDL::XsdBase::removeNS(\model);
            if (select keys model, $1 != "^attributes^" && $1 != "annotation" && $1 != "ns") {
                return False;
            }
            return kind != "choice" || zeroOccurs(model."^attributes^".minOccurs);
        }
        return True;
    }

    static bool zeroOccurs(*string value) {
        return exists value && (trim(value) =~ /^[+-]?0+$/);
    }

    static bool getMixed(*hash<auto> attributes, bool inherited = False) {
        if (!attributes.hasKey("mixed")) {
            return inherited;
        }
        string value = trim(attributes.mixed);
        if (value == "true" || value == "1") {
            return True;
        }
        if (value == "false" || value == "0") {
            return False;
        }
        throw WSDL_ERROR, sprintf("invalid mixed declaration %Y", value);
    }
}

#! XSD element group class for xs:group definitions
public class XsdGroup inherits WSDL::XsdNamedData, Qore::Serializable {
    public {
        #! Elements in this group (from sequence, choice, or all)
        /** After resolution, unambiguous fields use local names; colliding fields use expanded names. */
        hash<string, XsdElement> groupElements();
        #! The group content model type: "sequence", "choice", or "all"
        *string contentModel;
        #! Namespace URI where this group is defined
        *string nsUri;
    }

    private {
        XsdParticle particle;
        list<string> nestedGroupRefs();
        list<string> elementGroupRefs();
        list<XsdElement> declaredElements();
        hash<string, XsdElement> elementDeclarations();
        bool resolving = False;
        bool resolved = False;
        transient hash<XsdEmptiabilityInfo> emptiability;
        *bool emptiable;
        bool evaluating_emptiability = False;
    }

    private:internal hash<auto> serializeMembers(*hash<auto> members) {
        hash<auto> values = self.(keys members);
        values.emptiability = XsdEmptiabilityHelper::serialize(emptiability);
        return values;
    }

    private:internal deserializeMembers(hash<auto> members) {
        emptiability = XsdEmptiabilityHelper::deserialize(remove members.emptiability);
        self += members;
    }

    #! constructs a named model group with declaration-local QName references
    /** @param g the parsed group declaration
        @param nsc its namespace context
        @param unresolved the graph's type resolution queue
        @param usedocns the schema's element qualification default
        @throw WSDL-ERROR invalid group content or missing reference
        @throw WSDL-NAMESPACE-ERROR malformed QName or unbound reference prefix
    */
    constructor(hash<auto> g, Namespaces nsc, XsdLateResolverHelper unresolved, bool usedocns) : XsdNamedData(\g) {
        NamespacePrefixHelper declaration(nsc, g."^attributes^");
        nsUri = nsc.getTargetNamespaceUri();
        WSDL::XsdBase::removeNS(\g);
        emptiability = XsdEmptiabilityHelper::parse(g, nsc);
        int models = int(g.hasKey("sequence")) + int(g.hasKey("choice")) + int(g.hasKey("all"));
        if (models != 1) {
            throw WSDL_ERROR, sprintf("group %Y requires exactly one sequence, choice, or all", name);
        }
        contentModel = g.hasKey("sequence") ? "sequence" : (g.hasKey("choice") ? "choice" : "all");
        *hash<auto> content = g{contentModel};
        particle = new XsdParticle(contentModel, content, nsc, unresolved, usedocns);
        parseContent(particle, True);
    }

    private parseContent(XsdParticle node, bool present) {
        present = present && node.getMaxOccurs() != "0";
        if (node.getKind() == "element") {
            XsdElement elem = node.getElement();
            groupElements{elem.getExpandedName()} = elem;
            if (present) {
                declaredElements += elem;
            }
        } else if (node.getKind() == "group") {
            string key = node.getGroupReference();
            nestedGroupRefs += key;
            if (present) {
                elementGroupRefs += key;
            }
        }
        foreach XsdParticle child in (node.getChildren()) {
            parseContent(child, present);
        }
    }

    #! returns the ordered model group declaration
    /** @return the group's compositor, preserving references and whole-particle counts */
    XsdParticle getParticle() {
        return particle;
    }

    #! resolves nested group identities before consumers use their elements
    /** @param groups the schema group registry
        @throw WSDL-ERROR an undefined/cyclic group reference or ambiguous content model
        @since %WSDL 0.5.8
    */
    resolveNestedGroups(hash<string, XsdGroup> groups) {
        if (resolved) {
            return;
        }
        if (resolving) {
            throw WSDL_ERROR, sprintf("cyclic group reference involving %Y", name);
        }
        resolving = True;
        on_exit resolving = False;
        isEmptiable(groups);
        hash<string, XsdElement> declarations();
        XsdElementConsistencyHelper::merge(\declarations, declaredElements);
        hash<string, XsdElement> merged_elements = groupElements;
        foreach string key in (nestedGroupRefs) {
            *XsdGroup group = groups{key};
            if (!group) {
                throw WSDL_ERROR, sprintf("undefined group reference %Y", key);
            }
            group.resolveNestedGroups(groups);
            merged_elements += XsdElementFieldHelper::getExpandedMap(group.getElements());
        }
        foreach string key in (elementGroupRefs) {
            XsdElementConsistencyHelper::merge(\declarations, (map $1, groups{key}.getElementDeclarations().iterator()));
        }
        particle.resolveGroups(groups);
        particle.validateDeterminism();
        elementDeclarations = declarations;
        groupElements = XsdElementFieldHelper::getFieldMap(merged_elements, XsdElementFieldHelper::getFieldNames(merged_elements));
        resolved = True;
    }

    #! returns the checked element declaration identities in the resolved group
    /** @return one representative declaration per expanded name after type consistency checking
        @note Call resolveNestedGroups() before reading this construction metadata.
        @since %WSDL 0.5.8
    */
    hash<string, XsdElement> getElementDeclarations() {
        return elementDeclarations;
    }

    #! returns whether this group's particle permits no element children
    /** @param groups the schema's registry of named groups
        @return True for an emptiable particle under XSD 1.0 section 3.9.6
        @throw WSDL-ERROR an undefined or cyclic nested group reference
        @since %WSDL 0.5.8
    */
    bool isEmptiable(hash<string, XsdGroup> groups) {
        if (exists emptiable) {
            return emptiable;
        }
        if (evaluating_emptiability) {
            throw WSDL_ERROR, sprintf("cyclic group reference involving %Y", name);
        }
        evaluating_emptiability = True;
        on_exit evaluating_emptiability = False;
        emptiable = XsdEmptiabilityHelper::evaluate(emptiability, groups);
        return emptiable;
    }

    #! Returns the elements in this group
    /** @return resolved fields keyed by local name where unique, otherwise by expanded name */
    hash<string, XsdElement> getElements() {
        return groupElements;
    }

    #! Returns the qualified name for map lookup: "{namespace_uri}local_name" or just "local_name" if no namespace
    string getQualifiedName() {
        return nsUri ? sprintf("{%s}%s", nsUri, name) : name;
    }
}

#! XSD 1.0 wildcard namespace constraint forms
/** @since %WSDL 0.5.8 */
public enum XsdWildcardConstraint : string {
    #! All namespace names, including no namespace
    Any = "any",
    #! A negated namespace, also excluding no namespace
    Not = "not",
    #! An enumerated set of namespace names
    Set = "set",
}

#! XSD wildcard validation strength
/** @since %WSDL 0.5.8 */
public enum XsdWildcardProcessing : string {
    #! No declaration validation
    Skip = "skip",
    #! Validate when a declaration is available
    Lax = "lax",
    #! Require and validate a declaration
    Strict = "strict",
}

#! Resolved attribute wildcard construction metadata
/** Empty strings denote no namespace. This describes the schema component; it does not itself validate values.
    @since %WSDL 0.5.8
*/
public hashdecl XsdAttributeWildcardInfo {
    #! Namespace constraint form
    XsdWildcardConstraint constraint = XsdWildcardConstraint::Any;
    #! Negated namespace for a Not constraint; no namespace is always excluded as well
    string excluded_namespace = "";
    #! Admitted namespace names for a Set constraint
    hash<string, bool> namespaces = {};
    #! Required validation strength
    XsdWildcardProcessing processing = XsdWildcardProcessing::Strict;
}

# Wildcard fields retain XML data. Assessment uses the same resolved components as
# named children without replacing the lexical, namespace or ordered XML value.
class XsdWildcardElementHelper {
    static auto decode(Namespaces namespaces, hash<XsdAttributeWildcardInfo> wildcard, string identity,
            hash<string, XsdAbstractType> types, *hash<auto> references, auto value) {
        XsdQNameNamespaceScope scope(value.typeCode() == NT_HASH ? value."^attributes^" : NOTHING);
        validate(namespaces, wildcard, identity, types, references, value);
        return retainNamespaces(value);
    }

    static auto retainNamespaces(auto value) {
        if (value.typeCode() == NT_HASH) {
            # Public component callers can supply an inferred hash<string>.
            # Namespace metadata needs a heterogeneous XML-data hash.
            value = {} + value;
            # Detach one wildcard subtree, not every descendant. Inherited bindings
            # can occur in arbitrary lexical attribute and text values inside it.
            foreach string prefix in (keys QNameInputNamespaces) {
                if (prefix != "xml") {
                    value."^attributes^"{prefix ? "xmlns:" + prefix : "xmlns"} = QNameInputNamespaces{prefix};
                }
            }
            if (!exists QNameInputNamespaces{""}) {
                value."^attributes^".xmlns = "";
            }
        }
        return value;
    }

    static hash<auto> encode(Namespaces declarations, Namespaces output, hash<XsdAttributeWildcardInfo> wildcard,
            string identity, auto value, *softbool omitType) {
        XsdNativeTypeOutputScope types(NativeTypeOutputTypes ?? declarations.getInstanceTypes());
        *XsdXmlValue retained;
        *XsdQNameNamespaceScope retained_scope;
        if (value instanceof XsdXmlValue) {
            XsdXmlValue xml = cast<XsdXmlValue>(value);
            if (xml.getExpandedName() != identity) {
                throw SOAP_SERIALIZATION_ERROR, sprintf("wildcard field %Y cannot contain XML element %Y",
                    identity, xml.getExpandedName());
            }
            XsdSoapXmlHelper::validate(xml, SOAP_SERIALIZATION_ERROR);
            retained = xml;
            value = XsdBase::expandElementNamespaces(
                parse_xml(xml.getXml(), XPF_PRESERVE_ORDER | XPF_PRESERVE_WHITESPACE)){identity};
            retained_scope = new XsdQNameNamespaceScope(value.typeCode() == NT_HASH ? value."^attributes^" : NOTHING,
                True);
        } else if (XsdNativeTypeValueHelper::isWrapper(value)) {
            XsdIdentitySuspendScope identity_check();
            *XsdElement declaration = declarations.getGlobalElement(identity);
            if (declaration) {
                value = declaration.serializeOccurrence(output, value, omitType, identity, "element wildcard");
            } else {
                XsdBaseType any_type("anyType", new Namespaces({}));
                value = XsdDocumentValueHelper::serializePartValue(any_type, output, value, omitType);
            }
            if (value.typeCode() != NT_HASH) {
                value = {} + {"^value^": value};
            }
            value."^attributes^" += output.getOutputNamespaceHash(NOTHING);
        }
        hash<auto> wire();
        try {
            auto assessment = value;
            if (!retained) {
                # XML generator data admits both lexical and expanded child names.
                # Assess the same namespace identities that the emitted tree has.
                wire = XsdBase::restoreElementNamespaces({identity:value});
                assessment = XsdBase::expandElementNamespaces(wire){identity};
            }
            validate(declarations, wildcard, identity, NativeTypeOutputTypes ?? {}, NOTHING, assessment);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == SOAP_DESERIALIZATION_ERROR || ex.err == "XSD-PARTICLE-ERROR") {
                rethrow SOAP_SERIALIZATION_ERROR, ex.desc, ex.arg;
            }
            rethrow;
        }
        if (retained) {
            list<XsdScopedLexicalValue> contexts();
            lexicalContexts(value, \contexts);
            return {"^xml^":new XsdQNameXmlFragment(retained, contexts)};
        }
        return wire;
    }

    # A retained fragment's uninterpreted text must not acquire bindings from
    # generated ancestors. Capture potential QName tokens without changing XML.
    private static lexicalContexts(auto value, reference<list<XsdScopedLexicalValue>> result) {
        XsdQNameNamespaceScope scope(value.typeCode() == NT_HASH ? value."^attributes^" : NOTHING);
        if (value.typeCode() == NT_LIST) {
            foreach auto child in (value) {
                lexicalContexts(child, \result);
            }
        } else if (value.typeCode() == NT_HASH) {
            foreach string key in (keys value."^attributes^") {
                if (key != "xmlns" && !key.startsWith("xmlns:")) {
                    lexicalContexts(value."^attributes^"{key}, \result);
                }
            }
            foreach string key in (keys value) {
                if (!key.startsWith("^") || key =~ /^\^(value|cdata)[0-9]*\^$/) {
                    lexicalContexts(value{key}, \result);
                }
            }
        } else if (value.typeCode() == NT_STRING) {
            hash<string, string> bindings = {"":QNameInputNamespaces{""} ?? ""};
            foreach string token in (XsdListValueHelper::tokens(value)) {
                int colon = token.find(":");
                if (colon > 0) {
                    string prefix = token.substr(0, colon);
                    if (QNameInputNamespaces.hasKey(prefix)) {
                        bindings{prefix} = QNameInputNamespaces{prefix};
                    }
                }
            }
            push result, new XsdScopedLexicalValue(value, bindings);
        }
    }

    static validate(Namespaces namespaces, hash<XsdAttributeWildcardInfo> wildcard, string identity,
            hash<string, XsdAbstractType> types, *hash<auto> references, auto value) {
        if (!XsdAttributeWildcardHelper::allows(wildcard, XsdParticleProgram::namespaceOf(identity))) {
            throw SOAP_DESERIALIZATION_ERROR, sprintf("element %Y is not admitted by the element wildcard", identity);
        }
        if (wildcard.processing == XsdWildcardProcessing::Skip) {
            return;
        }
        XsdQNameNamespaceScope scope(value.typeCode() == NT_HASH ? value."^attributes^" : NOTHING);
        XsdNativeTypeValueScope native_projection(False);
        *XsdElement declaration = namespaces.getGlobalElement(identity);
        if (declaration) {
            declaration.deserializeOccurrence(types, references, value);
            return;
        }
        XsdIdentityElementScope identity_scope();
        on_success identity_scope.finish(SOAP_DESERIALIZATION_ERROR);
        XsdIdentityTupleScope tuples(identity);
        on_success tuples.finish(SOAP_DESERIALIZATION_ERROR);
        tuples.instanceAttributes(value, SOAP_DESERIALIZATION_ERROR);
        hash<auto> attributes = XsdBase::getExpandedAttributes(value.typeCode() == NT_HASH
            ? value."^attributes^" : NOTHING);
        if (exists attributes{type_qname(XSI_NS, "type")}) {
            # With no element declaration, xsi:type supplies the assessment type;
            # no element nillability, value constraint or block is invented.
            XsdBaseType any_type("anyType", new Namespaces({}));
            auto assessed = value;
            XsdAbstractType selected = XsdTypeSubstitutionHelper::select(\assessed, any_type, types, identity);
            if (!XsdTypeSubstitutionHelper::builtin(selected, "anyType")) {
                *XsdDocumentValueResult captured = tuples.captures()
                    ? new XsdDocumentValueResult(True) : NOTHING;
                XsdDocumentValueHelper::deserializeValue(selected, identity, types, references, assessed,
                    False, captured);
                tuples.value(captured.actual_type ?? selected, captured.identity);
                return;
            }
        } else if (wildcard.processing == XsdWildcardProcessing::Strict) {
            throw SOAP_DESERIALIZATION_ERROR, sprintf("strict wildcard element %Y requires a global declaration "
                "or an available xsi:type", identity);
        }
        validateLaxContent(namespaces, types, references, value, attributes);
    }

    static validateLaxContent(Namespaces namespaces, hash<string, XsdAbstractType> types,
            *hash<auto> references, auto value, hash<auto> attributes) {
        hash<XsdAttributeWildcardInfo> lax = <XsdAttributeWildcardInfo>{"processing": XsdWildcardProcessing::Lax};
        list<string> attribute_names();
        foreach string identity in (keys attributes) {
            if (!XsdBase::isInstanceAttribute(identity)) {
                XsdWildcardAttributeHelper::decode(namespaces, lax, identity, attributes{identity});
                push attribute_names, identity;
            }
        }
        XsdWildcardAttributeHelper::checkIds(namespaces, lax, {}, attribute_names, SOAP_DESERIALIZATION_ERROR);
        if (value.typeCode() != NT_HASH) {
            return;
        }
        foreach string key in (keys value) {
            if (key.startsWith("^") || key == ".ns") {
                continue;
            }
            string identity = key;
            identity =~ s/\^[0-9]+$//;
            if (!identity.startsWith("{")) {
                identity = type_qname("", identity);
            }
            list<auto> children = value{key}.typeCode() == NT_LIST ? value{key} : (value{key},);
            foreach auto child in (children) {
                validate(namespaces, lax, identity, types, references, child);
            }
        }
    }
}

# Instance attribute admission is independent of element wildcard admission.
class XsdWildcardAttributeHelper {
    static XsdQNameValue name(string key, string error) {
        string uri = "";
        string local = key;
        if (key.startsWith("{")) {
            (*string namespace_uri, *string local_name) = key =~ x/^\{(.*)\}([^{}]+)$/;
            if (!exists namespace_uri || !exists local_name) {
                throw error, sprintf("invalid expanded wildcard attribute name %Y", key);
            }
            uri = namespace_uri;
            local = local_name;
        }
        if (!Namespaces::isNCName(local)) {
            throw error, sprintf("invalid wildcard attribute local name %Y", local);
        }
        try {
            XsdQNameValue result(uri, uri == "http://www.w3.org/XML/1998/namespace" ? "xml:" + local : local);
            if (uri == "http://www.w3.org/2000/xmlns/" || (!uri && local == "xmlns")) {
                throw error, "namespace declarations are not wildcard attribute values";
            }
            return result;
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "XSD-QNAME-VALUE-ERROR") {
                rethrow error, ex.desc, ex.arg;
            }
            rethrow;
        }
    }
    static *XsdAttribute declaration(Namespaces namespaces, *hash<XsdAttributeWildcardInfo> wildcard,
            XsdQNameValue name, string error) {
        string identity = type_qname(name.getNamespaceUri(), name.getLocalName());
        if (!exists wildcard) {
            throw error, sprintf("unknown attribute %Y without an attribute wildcard", identity);
        }
        if (!XsdAttributeWildcardHelper::allows(wildcard, name.getNamespaceUri())) {
            throw error, sprintf("attribute %Y is not admitted by the attribute wildcard", identity);
        }
        if (wildcard.processing == XsdWildcardProcessing::Skip) {
            return;
        }
        *XsdAttribute declaration = namespaces.getGlobalAttribute(identity);
        if (!declaration && wildcard.processing == XsdWildcardProcessing::Strict) {
            throw error, sprintf("strict wildcard attribute %Y requires a global declaration", identity);
        }
        return declaration;
    }
    static checkIds(Namespaces namespaces, *hash<XsdAttributeWildcardInfo> wildcard,
            hash<string, XsdAttribute> declared, list<string> names, string error) {
        if (!exists wildcard || wildcard.processing == XsdWildcardProcessing::Skip) {
            return;
        }
        bool found = False;
        foreach string identity in (names) {
            *XsdAttribute attribute = namespaces.getGlobalAttribute(identity);
            if (!attribute || !XsdTypeDerivationHelper::isIdDerived(attribute.type)) {
                continue;
            }
            if (found) {
                throw error, "an element cannot have more than one wildcard ID attribute";
            }
            found = True;
        }
        if (found) {
            foreach XsdAttribute attribute in (declared.iterator()) {
                if (XsdTypeDerivationHelper::isIdDerived(attribute.type)) {
                    throw error, "a wildcard ID attribute is forbidden when the type has a declared ID attribute use";
                }
            }
        }
    }
    static auto decode(Namespaces namespaces, *hash<XsdAttributeWildcardInfo> wildcard,
            string identity, string value) {
        XsdQNameValue qname = name(identity, SOAP_DESERIALIZATION_ERROR);
        *XsdAttribute attribute = declaration(namespaces, wildcard, qname, SOAP_DESERIALIZATION_ERROR);
        if (attribute) {
            return attribute.getValue(value);
        }
        XsdIdentityTupleScope::unassessedAttribute(identity, value);
        return new XsdScopedLexicalValue(value, {"":""} + (QNameInputNamespaces ?? {}));
    }
    static auto encode(Namespaces declarations, Namespaces output, *hash<XsdAttributeWildcardInfo> wildcard,
            XsdQNameValue name, auto value) {
        *XsdAttribute attribute = declaration(declarations, wildcard, name, SOAP_SERIALIZATION_ERROR);
        if (attribute) {
            return attribute.serializeAttributeValue(output, value);
        }
        XsdIdentityTupleScope::unassessedAttribute(type_qname(name.getNamespaceUri(), name.getLocalName()), value);
        if (value instanceof XsdScopedLexicalValue) {
            return value;
        }
        if (value.typeCode() != NT_STRING) {
            throw SOAP_SERIALIZATION_ERROR, "an unassessed wildcard attribute requires XML text or XsdScopedLexicalValue";
        }
        # The carrier validates XML characters while retaining the supplied unbound namespace context.
        try {
            return new XsdScopedLexicalValue(value, {"":""});
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "XSD-SCOPED-VALUE-ERROR") {
                rethrow SOAP_SERIALIZATION_ERROR, ex.desc, ex.arg;
            }
            rethrow;
        }
    }
}

# Construction algebra follows XSD 1.0's intensional rules, including non-expressible combinations.
class XsdAttributeWildcardHelper {
    static validateMetadata(hash<auto> value, string error) {
        if (!inlist(value.constraint, (XsdWildcardConstraint::Any, XsdWildcardConstraint::Not,
                XsdWildcardConstraint::Set))
                || !inlist(value.processing, (XsdWildcardProcessing::Skip, XsdWildcardProcessing::Lax,
                    XsdWildcardProcessing::Strict))
                || value.excluded_namespace.typeCode() != NT_STRING || value.namespaces.typeCode() != NT_HASH) {
            throw error, "invalid attribute wildcard metadata";
        }
        foreach auto admitted in (value.namespaces.iterator()) {
            if (admitted !== True) {
                throw error, "an attribute wildcard namespace set requires true membership values";
            }
        }
        if ((value.constraint != XsdWildcardConstraint::Set && value.namespaces)
                || (value.constraint != XsdWildcardConstraint::Not && value.excluded_namespace)) {
            throw error, "inconsistent attribute wildcard namespace constraints";
        }
    }
    static hash<XsdAttributeWildcardInfo> parse(auto declaration, *string target_namespace, string term = "anyAttribute") {
        if (exists declaration && declaration.typeCode() != NT_HASH) {
            throw WSDL_ERROR, sprintf("exactly one %s declaration is allowed", term);
        }
        *hash<auto> attributes = declaration."^attributes^";
        hash<XsdAttributeWildcardInfo> result();
        string process = trim(attributes.processContents ?? "strict");
        if (process == "skip") {
            result.processing = XsdWildcardProcessing::Skip;
        } else if (process == "lax") {
            result.processing = XsdWildcardProcessing::Lax;
        } else if (process != "strict") {
            throw WSDL_ERROR, sprintf("invalid %s processContents %Y", term, process);
        }
        string value = XsdSimpleType::normalizeWhiteSpace(attributes."namespace" ?? "##any", "collapse");
        if (value == "##any") {
            return result;
        }
        if (value == "##other") {
            result.constraint = XsdWildcardConstraint::Not;
            result.excluded_namespace = target_namespace ?? "";
            return result;
        }
        result.constraint = XsdWildcardConstraint::Set;
        foreach string item in (value.split(" ")) {
            if (!item) {
                continue;
            }
            if (item == "##local") {
                item = "";
            } else if (item == "##targetNamespace") {
                item = target_namespace ?? "";
            } else if (item =~ /^##/) {
                throw WSDL_ERROR, sprintf("invalid %s namespace list %Y", term, value);
            }
            result.namespaces{item} = True;
        }
        return result;
    }

    static hash<XsdAttributeWildcardInfo> urType() {
        return <XsdAttributeWildcardInfo>{"processing": XsdWildcardProcessing::Lax};
    }

    static bool allows(*hash<XsdAttributeWildcardInfo> wildcard, *string uri) {
        if (!exists wildcard) {
            return False;
        }
        if (wildcard.constraint == XsdWildcardConstraint::Any) {
            return True;
        }
        if (wildcard.constraint == XsdWildcardConstraint::Not) {
            return boolean(uri) && uri != wildcard.excluded_namespace;
        }
        return wildcard.namespaces{uri ?? ""} ?? False;
    }

    static bool subset(hash<XsdAttributeWildcardInfo> derived, hash<XsdAttributeWildcardInfo> base) {
        if (base.constraint == XsdWildcardConstraint::Any) {
            return True;
        }
        if (derived.constraint == XsdWildcardConstraint::Not) {
            return base.constraint == XsdWildcardConstraint::Not
                && derived.excluded_namespace == base.excluded_namespace;
        }
        if (derived.constraint != XsdWildcardConstraint::Set) {
            return False;
        }
        foreach string uri in (keys derived.namespaces) {
            if (!allows(base, uri)) {
                return False;
            }
        }
        return True;
    }

    static *hash<XsdAttributeWildcardInfo> complete(*hash<XsdAttributeWildcardInfo> local,
            list<hash<XsdAttributeWildcardInfo>> groups) {
        *hash<XsdAttributeWildcardInfo> result = local;
        foreach hash<XsdAttributeWildcardInfo> group in (groups) {
            result = exists result ? combine(result, group, False) : group;
        }
        return result;
    }

    static *hash<XsdAttributeWildcardInfo> derive(*hash<XsdAttributeWildcardInfo> own,
            *hash<XsdAttributeWildcardInfo> base, bool restriction, bool ur_type = False) {
        if (!restriction) {
            return exists own && exists base ? combine(own, base, True) : (own ?? base);
        }
        if (exists own) {
            if (!exists base || !subset(own, base)) {
                throw WSDL_ERROR, "attribute wildcard restriction must be a subset of its base wildcard";
            }
            const hash<string, int> Strength = {"skip": 0, "lax": 1, "strict": 2};
            if (!ur_type && Strength{own.processing} < Strength{base.processing}) {
                throw WSDL_ERROR, "attribute wildcard restriction cannot weaken processContents";
            }
        }
        return own;
    }

    private static hash<XsdAttributeWildcardInfo> combine(hash<XsdAttributeWildcardInfo> first,
            hash<XsdAttributeWildcardInfo> second, bool union) {
        hash<XsdAttributeWildcardInfo> result = first;
        XsdWildcardConstraint a = first.constraint;
        XsdWildcardConstraint b = second.constraint;
        if (a == XsdWildcardConstraint::Any || b == XsdWildcardConstraint::Any) {
            if (union) {
                result.constraint = XsdWildcardConstraint::Any;
                result.namespaces = {};
                result.excluded_namespace = "";
            } else if (a == XsdWildcardConstraint::Any) {
                result = second;
                result.processing = first.processing;
            }
            return result;
        }
        if (a == XsdWildcardConstraint::Set && b == XsdWildcardConstraint::Set) {
            if (union) {
                result.namespaces += second.namespaces;
            } else {
                foreach string uri in (keys result.namespaces) {
                    if (!second.namespaces{uri}) {
                        delete result.namespaces{uri};
                    }
                }
            }
            return result;
        }
        if (a == XsdWildcardConstraint::Not && b == XsdWildcardConstraint::Not) {
            if (first.excluded_namespace != second.excluded_namespace) {
                if (union) {
                    result.excluded_namespace = "";
                } else if (first.excluded_namespace && second.excluded_namespace) {
                    throw WSDL_ERROR, "attribute wildcard intersection is not expressible in XSD 1.0";
                } else {
                    result.excluded_namespace = first.excluded_namespace ? first.excluded_namespace : second.excluded_namespace;
                }
            }
            return result;
        }
        hash<XsdAttributeWildcardInfo> negated = a == XsdWildcardConstraint::Not ? first : second;
        hash<XsdAttributeWildcardInfo> listed = a == XsdWildcardConstraint::Set ? first : second;
        result.namespaces = {};
        result.excluded_namespace = "";
        if (!union) {
            result.constraint = XsdWildcardConstraint::Set;
            foreach string uri in (keys listed.namespaces) {
                if (allows(negated, uri)) {
                    result.namespaces{uri} = True;
                }
            }
        } else {
            bool local = listed.namespaces{""} ?? False;
            bool excluded = listed.namespaces{negated.excluded_namespace} ?? False;
            if (local && excluded) {
                result.constraint = XsdWildcardConstraint::Any;
            } else if (local) {
                throw WSDL_ERROR, "attribute wildcard union is not expressible in XSD 1.0";
            } else {
                result.constraint = XsdWildcardConstraint::Not;
                result.excluded_namespace = excluded ? "" : negated.excluded_namespace;
            }
        }
        return result;
    }
}

#! XSD attribute group class for xs:attributeGroup definitions
public class XsdAttributeGroup inherits WSDL::XsdNamedData, Qore::Serializable {
    public {
        #! Attributes in this group
        hash<string, XsdAttribute> groupAttrs();
        #! Expanded nested attributeGroup reference keys to resolve later
        list<string> nestedAttrGroupRefs();
        #! Namespace URI where this attribute group is defined
        *string nsUri;
    }

    #! constructs a named attribute group with declaration-local QName references
    /** @param ag the parsed attribute-group declaration
        @param nsc its namespace context
        @param unresolved the graph's type resolution queue
        @throw WSDL-ERROR invalid attribute declaration or missing group reference
        @throw WSDL-NAMESPACE-ERROR malformed QName or unbound reference prefix
    */
    constructor(hash<auto> ag, Namespaces nsc, XsdLateResolverHelper unresolved) : XsdNamedData(\ag) {
        NamespacePrefixHelper declaration(nsc, ag."^attributes^");
        nsUri = nsc.getTargetNamespaceUri();

        WSDL::XsdBase::removeNS(\ag);
        if (ag.hasKey("anyAttribute")) {
            localWildcard = XsdAttributeWildcardHelper::parse(ag.anyAttribute, nsUri);
        }

        # Parse attributes
        if (ag.hasKey("attribute") && !ag.attribute) {
            throw WSDL_ERROR, "attribute declaration requires a name or reference";
        }
        foreach hash<auto> ah in (ag.attribute) {
            XsdAttribute attr(ah, nsc, NOTHING, unresolved);
            # A prohibited declaration contributes no attribute-use component to a group.
            if (attr.use == "prohibited") {
                continue;
            }
            string identity = type_qname(attr.namespaceUri, attr.name);
            if (groupAttrs.hasKey(identity)) {
                throw WSDL_ERROR, sprintf("duplicate attribute use %Y", identity);
            }
            groupAttrs{identity} = attr;
        }
        groupAttrs = XsdAttribute::mergeMaps(new hash<string, XsdAttribute>(), groupAttrs);

        # Capture nested reference QNames before declaration scopes unwind.
        if (ag.hasKey("attributeGroup") && !ag.attributeGroup) {
            throw WSDL_ERROR, "attributeGroup reference requires ref";
        }
        foreach hash<auto> nested in (ag.attributeGroup) {
            if (!nested."^attributes^".ref) {
                throw WSDL_ERROR, "attributeGroup reference requires ref";
            }
            NamespacePrefixHelper reference_scope(nsc, nested."^attributes^");
            hash<auto> identity = nsc.getTypeHash(nested."^attributes^".ref ?? "");
            nestedAttrGroupRefs += type_qname(identity.uri, identity.val);
        }
    }

    private {
        *hash<XsdAttributeWildcardInfo> localWildcard;
        *hash<XsdAttributeWildcardInfo> attributeWildcard;
        bool resolving = False;
        bool resolved = False;
    }

    #! Returns the attributes in this group (including resolved nested groups)
    hash<string, XsdAttribute> getAttributes() {
        return groupAttrs;
    }

    #! resolves nested attribute-group identities and merges their attributes
    /** @param attrGroupMap the schema's attribute-group registry
        @param nsc the namespace registry, retained for API compatibility
        @throw WSDL-ERROR undefined or cyclic attribute-group reference
    */
    resolveNestedGroups(hash<string, XsdAttributeGroup> attrGroupMap, Namespaces nsc) {
        if (resolved) {
            return;
        }
        if (resolving) {
            throw WSDL_ERROR, sprintf("cyclic attributeGroup reference involving %Y", name);
        }
        resolving = True;
        on_exit resolving = False;
        list<hash<string, XsdAttribute>> nested_attributes();
        list<hash<XsdAttributeWildcardInfo>> wildcards();
        foreach string key in (nestedAttrGroupRefs) {
            *XsdAttributeGroup nested = attrGroupMap{key};
            if (!nested) {
                throw WSDL_ERROR, sprintf("undefined attributeGroup reference %Y", key);
            }
            nested.resolveNestedGroups(attrGroupMap, nsc);
            nested_attributes += (nested.getAttributes(),);
            *hash<XsdAttributeWildcardInfo> wildcard = nested.getAttributeWildcard();
            if (exists wildcard) {
                wildcards += wildcard;
            }
        }
        hash<string, XsdAttribute> merged = XsdAttribute::mergeMaps(groupAttrs, nested_attributes);
        *hash<XsdAttributeWildcardInfo> wildcard = XsdAttributeWildcardHelper::complete(localWildcard, wildcards);
        groupAttrs = merged;
        attributeWildcard = wildcard;
        resolved = True;
    }

    #! returns the resolved attribute wildcard for this group
    /** @return the constructed wildcard metadata, or NOTHING if no wildcard is present
        @note Call resolveNestedGroups() before reading the result.
        @since %WSDL 0.5.8
    */
    *hash<XsdAttributeWildcardInfo> getAttributeWildcard() {
        return attributeWildcard;
    }

    #! Returns the qualified name for map lookup: "{namespace_uri}local_name" or just "local_name" if no namespace
    string getQualifiedName() {
        return nsUri ? sprintf("{%s}%s", nsUri, name) : name;
    }
}

#! complex type choice hash
public hashdecl ChoiceInfo {
    #! all elements that can appear in the choice
    hash<string, XsdElement> elementmap;

    #! if a member of the choice must be present
    bool required;

    #! the alternatives making up the choice
    /** each alternative is a hash of the elements belonging to it; alternatives declared as nested model groups
        (ex: an \c xs:sequence inside an \c xs:choice) have more than one element

        @since %WSDL 0.5.8
    */
    list<hash<string, XsdElement>> alternatives = ();
}

# Internal simple-type ancestry checks for schema construction. Scalar facet/value validation belongs
# to the types themselves. Memoize pairs so unions that reuse members do not multiply traversal work.
class XsdTypeDerivationHelper {
    private {
        hash<string, bool> results();
    }

    # Every schema has the same builtin definitions. User components and custom
    # conversion classes must retain their resolved object identity.
    static bool sameType(XsdAbstractType first, XsdAbstractType second) {
        if (first === second) {
            return True;
        }
        return Class::getClass(first).getPathName() == "WSDL::XsdBaseType"
            && Class::getClass(second).getPathName() == "WSDL::XsdBaseType"
            && first.name == second.name && first.name != "binary" && XsdBaseType::BuiltinTypes{first.name}
            && first.ons && second.ons && first.nsc.getOutputNamespaceUri(first.ons) == XSD_NS
            && second.nsc.getOutputNamespaceUri(second.ons) == XSD_NS;
    }

    static bool isDerived(XsdAbstractType derived, XsdAbstractType base) {
        XsdTypeDerivationHelper helper();
        return helper.check(derived, base);
    }

    # ID ancestry depends only on the resolved type graph, not on a type's borrowed namespace context.
    static bool isIdDerived(XsdAbstractType derived) {
        hash<string, bool> seen();
        *XsdAbstractType current = derived;
        while (current && !seen{current.uniqueHash()}) {
            seen{current.uniqueHash()} = True;
            if (current instanceof XsdBaseType) {
                return current.name == "ID";
            }
            if (!(current instanceof XsdSimpleType)) {
                return False;
            }
            current = cast<XsdSimpleType>(current).type;
        }
        return False;
    }

    private bool check(XsdAbstractType derived, XsdAbstractType base) {
        string key = derived.uniqueHash() + ":" + base.uniqueHash();
        if (!results.hasKey(key)) {
            # Simple dependency cycles are rejected before complex type finalization.
            results{key} = False;
            results{key} = checkIntern(derived, base);
        }
        return results{key};
    }

    private bool checkIntern(XsdAbstractType derived, XsdAbstractType base) {
        if (derived == base) {
            return True;
        }
        if (derived instanceof XsdBaseType && base instanceof XsdBaseType) {
            string current = derived.name;
            while (current != "anyType") {
                if (current == base.name) {
                    return True;
                }
                current = current == "anySimpleType" ? "anyType" : XsdTypeSubstitutionHelper::BuiltinParents{current} ?? "anySimpleType";
            }
            return False;
        }
        if (derived instanceof XsdSimpleType) {
            XsdSimpleType simple = cast<XsdSimpleType>(derived);
            if (simple.type && check(simple.type, base)) {
                return True;
            }
            if (base instanceof XsdBaseType && base.name == "anySimpleType") {
                return True;
            }
        }
        if (base instanceof XsdSimpleType) {
            # Restrictions of unions retain the union's member type definitions.
            XsdAbstractType current = base;
            while (current instanceof XsdSimpleType) {
                XsdSimpleType simple = cast<XsdSimpleType>(current);
                foreach XsdAbstractType member in (simple.unionTypes) {
                    if (check(derived, member)) {
                        return True;
                    }
                }
                if (!simple.type) {
                    break;
                }
                current = simple.type;
            }
        }
        return False;
    }
}

thread_local *bool PreserveNativeTypes;
thread_local *hash<string, XsdAbstractType> NativeTypeOutputTypes;

class XsdNativeTypeValueScope {
    private {
        *bool previous;
        bool active = False;
    }
    constructor(*bool preserve) {
        if (exists preserve) {
            previous = PreserveNativeTypes;
            PreserveNativeTypes = preserve;
            active = True;
        }
    }
    destructor() {
        if (active) {
            PreserveNativeTypes = previous;
        }
    }
}

class XsdNativeTypeOutputScope {
    private {
        *hash<string, XsdAbstractType> previous;
        bool active = False;
    }
    constructor(*hash<string, XsdAbstractType> types) {
        if (exists types) {
            previous = NativeTypeOutputTypes;
            NativeTypeOutputTypes = types;
            active = True;
        }
    }
    destructor() {
        if (active) {
            NativeTypeOutputTypes = previous;
        }
    }
}

# Complete element boundaries retain a selected declaration independently of xsi:type.
# Child particles already carry element identity in their field names.
class XsdElementValueHelper {
    static bool needsSelection(XsdElement declared) {
        hash<string, XsdElement> members = declared.getInstanceDeclarations();
        return members.size() != 1 || members.firstKey() != declared.getExpandedName();
    }

    static bool isWrapper(auto value) {
        return value.typeCode() == NT_HASH && value.hasKey("^element^");
    }

    static XsdElement select(XsdElement declared, reference<auto> value, *hash<string, XsdElement> members) {
        if (!isWrapper(value)) {
            return declared;
        }
        if (value.size() != 2 || !value.hasKey("^val^")
                || !(value."^element^" instanceof XsdQNameValue) || isWrapper(value."^val^")) {
            throw SOAP_SERIALIZATION_ERROR,
                "an element wrapper requires only ^element^ as an XsdQNameValue and ^val^, without nested element wrappers";
        }
        XsdQNameValue identity = value."^element^";
        string expanded = type_qname(identity.getNamespaceUri(), identity.getLocalName());
        *XsdElement selected = exists members ? members{expanded} : declared.getInstanceDeclaration(expanded);
        if (!selected) {
            throw SOAP_SERIALIZATION_ERROR, sprintf("selected element %Y is not admitted by declaration %Y",
                expanded, declared.getExpandedName());
        }
        value = value."^val^";
        return selected;
    }

    static auto retain(XsdElement declared, XsdElement selected, auto value) {
        return declared.getExpandedName() == selected.getExpandedName() ? value
            : {"^element^": new XsdQNameValue(selected.getNamespaceUri(), selected.name), "^val^": value};
    }
}

# Document/literal parts are unordered. An augmenting-path matching finds an
# assignment without greedy name consumption. An alternating cycle or an edge
# to an unused occurrence proves ambiguity; a linear topological pass checks
# uniqueness. Iterative queues keep large part sets off the stack.
class XsdMessagePartMatcher {
    static hash<string, int> match(hash<string, list<int>> candidates, int count, bool ignore_unknown) {
        *hash<string, int> result = assign(candidates);
        if (!exists result) {
            throw SOAP_DESERIALIZATION_ERROR, "SOAP elements cannot supply every selected message part";
        }
        if (!ignore_unknown && result.size() != count) {
            throw SOAP_DESERIALIZATION_ERROR, "additional keys or duplicate elements included in SOAP document parts";
        }
        hash<string, string> owners();
        hash<string, int> incoming();
        hash<string, list<string>> alternatives();
        foreach hash<string, auto> edge in (result.pairIterator()) {
            owners{string(edge.value)} = edge.key;
            incoming{edge.key} = 0;
        }
        foreach string part in (keys candidates) {
            foreach int index in (candidates{part}) {
                if (index == result{part}) {
                    continue;
                }
                *string owner = owners{string(index)};
                if (!exists owner) {
                    throw SOAP_DESERIALIZATION_ERROR, "SOAP element names cannot uniquely identify their message parts";
                }
                push alternatives{part}, owner;
                ++incoming{owner};
            }
        }
        list<string> pending = select keys incoming, !incoming{$1};
        for (int cursor = 0; cursor < pending.size(); ++cursor) {
            foreach string next in (alternatives{pending[cursor]}) {
                if (!--incoming{next}) {
                    push pending, next;
                }
            }
        }
        if (pending.size() != result.size()) {
            throw SOAP_DESERIALIZATION_ERROR, "SOAP element names cannot uniquely identify their message parts";
        }
        return result;
    }

    private static *hash<string, int> assign(hash<string, list<int>> candidates) {
        hash<string, string> owners();
        hash<string, int> result();
        foreach string start in (keys candidates) {
            list<string> pending = (start,);
            hash<string, bool> seen_parts = {start: True};
            hash<string, bool> seen_values();
            hash<string, string> previous();
            bool found = False;
            for (int cursor = 0; cursor < pending.size() && !found; ++cursor) {
                string part = pending[cursor];
                foreach int index in (candidates{part}) {
                    if (seen_values{string(index)}) {
                        continue;
                    }
                    seen_values{string(index)} = True;
                    *string owner = owners{string(index)};
                    if (exists owner) {
                        if (!seen_parts{owner}) {
                            seen_parts{owner} = True;
                            previous{owner} = part;
                            push pending, owner;
                        }
                        continue;
                    }
                    while (True) {
                        *int old = result{part};
                        result{part} = index;
                        owners{string(index)} = part;
                        if (part == start) {
                            break;
                        }
                        @assert(exists old);
                        index = old;
                        part = previous{part};
                    }
                    found = True;
                    break;
                }
            }
            if (!found) {
                return;
            }
        }
        return result;
    }
}

class XsdNativeTypeValueHelper {
    static bool isWrapper(auto value) {
        return value.typeCode() == NT_HASH && value.hasKey("^val^")
            && (value."^type^" instanceof XsdAbstractType || value."^type^" instanceof XsdQNameValue);
    }

    static checkWrapper(hash<auto> value) {
        if (value.size() != 2 || isWrapper(value."^val^")) {
            throw SOAP_SERIALIZATION_ERROR, "a type wrapper requires only ^type^ and ^val^, without nested wrappers";
        }
    }

    static XsdAbstractType resolve(auto selected, XsdAbstractType declared) {
        if (selected instanceof XsdAbstractType) {
            return cast<XsdAbstractType>(selected);
        }
        @assert(selected instanceof XsdQNameValue);
        XsdQNameValue name = cast<XsdQNameValue>(selected);
        string uri = name.getNamespaceUri();
        string local = name.getLocalName();
        if (uri == XSD_NS && local != "binary" && XsdBaseType::BuiltinTypes{local}) {
            XsdBaseType builtin(local, new Namespaces({}, declared.nsc));
            return XsdTypeDerivationHelper::sameType(builtin, declared) ? declared : builtin;
        }
        string declared_uri = declared.ons ? declared.nsc.getOutputNamespaceUri(declared.ons) : "";
        if (declared.hasRealName() && declared.name == local && declared_uri == uri) {
            return declared;
        }
        *XsdAbstractType resolved = NativeTypeOutputTypes{type_qname(uri, local)};
        if (!resolved) {
            throw SOAP_SERIALIZATION_ERROR, sprintf("cannot resolve selected type {%s}%s in the output schema", uri, local);
        }
        return resolved;
    }

    static auto retain(XsdAbstractType declared, XsdAbstractType selected, auto value) {
        if (!PreserveNativeTypes || XsdTypeDerivationHelper::sameType(declared, selected)) {
            return value;
        }
        @assert(selected.hasRealName());
        return {"^type^": new XsdQNameValue(selected.ons ? selected.nsc.getOutputNamespaceUri(selected.ons) : "",
            selected.name), "^val^": value};
    }
}

hashdecl XsdTypeSubstitutionPair {
    XsdAbstractType derived;
    XsdAbstractType base;
}

# Instance derivation uses a fixed exclusion set and resolved component identities.
# Each pair is visited once; shared union graphs never expand repeated dependency paths.
class XsdTypeSubstitutionHelper {
    const BuiltinParents = {
        "normalizedString": "string", "token": "normalizedString", "language": "token",
        "Name": "token", "NCName": "Name", "ID": "NCName", "IDREF": "NCName", "ENTITY": "NCName",
        "NMTOKEN": "token", "integer": "decimal", "nonPositiveInteger": "integer",
        "negativeInteger": "nonPositiveInteger", "long": "integer", "int": "long", "short": "int",
        "byte": "short", "nonNegativeInteger": "integer", "unsignedLong": "nonNegativeInteger",
        "unsignedInt": "unsignedLong", "unsignedShort": "unsignedInt", "unsignedByte": "unsignedShort",
        "positiveInteger": "nonNegativeInteger",
    };

    static bool builtin(XsdAbstractType type, *string name) {
        return Class::getClass(type).getPathName() == "WSDL::XsdBaseType"
            && (!exists name || type.name == name) && type.name != "binary"
            && XsdBaseType::BuiltinTypes{type.name} && type.ons
            && type.nsc.getOutputNamespaceUri(type.ons) == XSD_NS;
    }

    private static enqueue(reference<list<hash<XsdTypeSubstitutionPair>>> pending,
            reference<hash<string, bool>> seen, XsdAbstractType derived, XsdAbstractType base) {
        string key = derived.uniqueHash() + ":" + base.uniqueHash();
        if (!seen{key}) {
            seen{key} = True;
            push pending, <XsdTypeSubstitutionPair>{"derived": derived, "base": base};
        }
    }

    private static list<XsdAbstractType> unionMembers(XsdAbstractType base,
            reference<hash<string, list<XsdAbstractType>>> cache) {
        *XsdAbstractType current = base;
        hash<string, bool> visited();
        list<XsdAbstractType> members();
        while (current instanceof XsdSimpleType) {
            string key = current.uniqueHash();
            if (exists cache{key}) {
                members = cache{key};
                break;
            }
            if (visited{key}) {
                break;
            }
            visited{key} = True;
            XsdSimpleType simple = cast<XsdSimpleType>(current);
            if (simple.unionTypes) {
                members = simple.unionTypes;
                break;
            }
            current = simple.type;
        }
        foreach string key in (keys visited) {
            cache{key} = members;
        }
        return members;
    }

    static bool allowed(XsdAbstractType derived, XsdAbstractType base, hash<string, bool> blocked) {
        list<hash<XsdTypeSubstitutionPair>> pending();
        hash<string, bool> seen();
        hash<string, list<XsdAbstractType>> unions();
        enqueue(\pending, \seen, derived, base);
        while (pending) {
            hash<XsdTypeSubstitutionPair> pair = pop pending;
            if (XsdTypeDerivationHelper::sameType(pair.derived, pair.base)) {
                return True;
            }
            if (pair.derived instanceof XsdComplexType) {
                XsdComplexType complex_type = cast<XsdComplexType>(pair.derived);
                if (blocked{complex_type.extension ? XsdSubstitutionMethod::Extension : XsdSubstitutionMethod::Restriction}) {
                    continue;
                }
                if (complex_type.baseType) {
                    enqueue(\pending, \seen, complex_type.baseType, pair.base);
                } else if (builtin(pair.base, "anyType")) {
                    return True;
                }
                continue;
            }
            if (blocked{XsdSubstitutionMethod::Restriction}) {
                continue;
            }
            if (builtin(pair.derived)) {
                if (pair.derived.name == "anyType") {
                    continue;
                }
                if (builtin(pair.base)) {
                    string current = pair.derived.name;
                    while (current != "anyType") {
                        current = current == "anySimpleType" ? "anyType" : BuiltinParents{current} ?? "anySimpleType";
                        if (current == pair.base.name) {
                            return True;
                        }
                    }
                }
            } else if (pair.derived instanceof XsdSimpleType) {
                XsdSimpleType simple = cast<XsdSimpleType>(pair.derived);
                if (simple.type) {
                    if (simple.type.isFinal(XsdDerivationMethod::Restriction)) {
                        continue;
                    }
                    enqueue(\pending, \seen, simple.type, pair.base);
                } else if (builtin(pair.base, "anySimpleType") || builtin(pair.base, "anyType")) {
                    return True;
                }
            } else {
                # Custom conversion classes and legacy adapters have only component identity here.
                continue;
            }
            # Restricted unions retain the composed member definitions of their base.
            foreach XsdAbstractType member in (unionMembers(pair.base, \unions)) {
                enqueue(\pending, \seen, pair.derived, member);
            }
        }
        return False;
    }

    # XSD 1.0 Substitution Group OK (Transitive) additionally applies every intermediate
    # complex type's block to the entire derivation, including methods below that type.
    static bool allowedElement(XsdAbstractType derived, XsdAbstractType base, hash<string, bool> blocked) {
        if (blocked{XsdSubstitutionMethod::Substitution}) {
            return False;
        }
        hash<string, bool> exclusions = blocked + base.getBlockedSubstitutions();
        XsdAbstractType current = derived;
        hash<string, bool> seen();
        while (current instanceof XsdComplexType && !XsdTypeDerivationHelper::sameType(current, base)) {
            string key = current.uniqueHash();
            if (seen{key}) {
                return False;
            }
            seen{key} = True;
            *XsdAbstractType parent = cast<XsdComplexType>(current).baseType;
            if (!parent) {
                break;
            }
            exclusions += parent.getBlockedSubstitutions();
            current = parent;
        }
        return allowed(derived, base, exclusions);
    }

    static check(XsdAbstractType selected, XsdAbstractType declared, string name, string error,
            *hash<string, bool> blocked) {
        if (selected.isAbstract()) {
            throw error, sprintf("abstract type %Y cannot validate element %Y", selected.name, name);
        }
        if (XsdTypeDerivationHelper::sameType(selected, declared)) {
            return;
        }
        hash<string, bool> exclusions = blocked ?? {};
        if (selected instanceof XsdComplexType || selected instanceof XsdArrayType) {
            exclusions += declared.getBlockedSubstitutions();
        }
        if (!allowed(selected, declared, exclusions)) {
            throw error, sprintf("explicit type %Y cannot replace declared type %Y for element %Y with block %Y",
                selected.name, declared.name, name, keys exclusions);
        }
    }

    # The caller owns the instance QName scope. Consume only the resolved type annotation;
    # namespace bindings and other attributes remain available to scalar/content conversion.
    static XsdAbstractType select(reference<auto> value, XsdAbstractType declared,
            hash<string, XsdAbstractType> types, string name, *hash<string, bool> blocked) {
        XsdAbstractType selected = declared;
        hash<auto> attributes = XsdBase::getExpandedAttributes(value.typeCode() == NT_HASH ? value."^attributes^" : NOTHING);
        string attribute = type_qname(XSI_NS, "type");
        if (exists attributes{attribute}) {
            XsdQNameValue identity = XsdQNameValueHelper::resolve(attributes{attribute},
                SOAP_DESERIALIZATION_ERROR, QNameInputNamespaces);
            string uri = identity.getNamespaceUri();
            string local = identity.getLocalName();
            if (uri == XSD_NS && local != "binary" && XsdBaseType::BuiltinTypes{local}) {
                # Independent output state avoids populating a shared schema's lazy builtin cache.
                selected = new XsdBaseType(local, new Namespaces({}, declared.nsc));
            } else {
                *XsdAbstractType resolved = types{type_qname(uri, local)};
                if (!resolved) {
                    throw SOAP_DESERIALIZATION_ERROR, sprintf("unknown explicit type {%s}%s for element %Y",
                        uri, local, name);
                }
                selected = resolved;
            }
            foreach string key in (keys value."^attributes^") {
                if (key == attribute) {
                    remove value."^attributes^"{key};
                    continue;
                }
                list<string> parts = key.split(":");
                if (parts.size() == 2 && parts[1] == "type" && QNameInputNamespaces{parts[0]} == XSI_NS) {
                    remove value."^attributes^"{key};
                }
            }
            if (XsdTypeDerivationHelper::sameType(selected, declared)) {
                selected = declared;
            }
        }
        check(selected, declared, name, SOAP_DESERIALIZATION_ERROR, blocked);
        return selected;
    }
}

# Copyright (C) 2026 Qore Technologies, s.r.o.
#! Completed value providers shared by ordinary recursive XML fields
/** Internal graph definition created by XSD provider factories. Instances are
    completed before a factory returns and remain immutable during validation.
    @since %WSDL 0.5.8
*/
public class XsdOrdinaryProviderDefinition inherits Serializable {
    public {
        #! Schema type name used in provider metadata
        string name;
        #! Completed ordinary provider
        *AbstractDataProviderType value_type;
        #! Completed soft provider for recursive references
        *AbstractDataProviderType soft_value_type;
        #! Whether construction encountered a recursive reference
        bool referenced = False;
    }
    #! registers a definition before traversing its fields
    /** @param name the schema type name
        @note The factory must complete both value types before exposing references.
    */
    constructor(string name) {
        self.name = name;
    }
    private:internal deserializeMembers(hash<auto> members) {
        if (members.name.typeCode() != NT_STRING || members.referenced.typeCode() != NT_BOOLEAN
                || !(members.value_type instanceof AbstractDataProviderType)
                || !(members.soft_value_type instanceof AbstractDataProviderType)) {
            throw "DESERIALIZATION-ERROR", "a recursive provider definition requires completed value types";
        }
        name = members.name;
        referenced = members.referenced;
        value_type = members.value_type;
        soft_value_type = members.soft_value_type;
    }
}

# Indirection on recursive edges keeps later completed fields visible. Copying
# a partially constructed HashDataType would freeze its incomplete field map.
#! Validating reference to a completed ordinary XML provider definition
/** Recursive fields delegate to their completed definition so that fields added
    later during graph construction remain visible. Metadata, soft conversion and
    omission copies retain the same definition through serialization.
    @since %WSDL 0.5.8
*/
public class XsdOrdinaryProviderReference inherits AbstractDataProviderType {
    private {
        XsdOrdinaryProviderDefinition definition;
        *bool optional;
        bool softened = False;
    }
    #! creates a reference while its definition is being constructed
    /** @param definition the shared provider definition
        @note Value conversion requires the factory to have completed the definition.
    */
    constructor(XsdOrdinaryProviderDefinition definition) {
        self.definition = definition;
    }
    private:internal deserializeMembers(hash<auto> members) {
        if (!(members.definition instanceof XsdOrdinaryProviderDefinition)
                || (exists members.optional && members.optional.typeCode() != NT_BOOLEAN)
                || members.softened.typeCode() != NT_BOOLEAN) {
            throw "DESERIALIZATION-ERROR", "a recursive provider reference requires its definition and flags";
        }
        definition = members.definition;
        optional = members.optional;
        softened = members.softened;
    }
    private AbstractDataProviderType target() {
        *AbstractDataProviderType result = softened ? definition.soft_value_type : definition.value_type;
        @assert(result, "ordinary provider graph must be complete before use");
        return result;
    }
    #! returns the schema type name
    /** @return the name retained by the definition */
    string getName() {
        return definition.name;
    }
    #! requires recursive validation through the provider
    /** @return NOTHING; there is no single reflected recursive value type */
    *Type getValueType() {
        return;
    }
    #! prevents enclosing providers from bypassing recursive validation
    /** @return an empty map */
    *hash<string, bool> getDirectTypeHash() {
        return {};
    }
    #! returns the completed collection element provider, if any
    /** @return the delegated element provider or NOTHING */
    *AbstractDataProviderType getElementType() {
        return definition.value_type ? target().getElementType() : NOTHING;
    }
    #! returns fields from the completed definition
    /** @return the ordinary or soft field map */
    *hash<string, AbstractDataField> getFields() {
        return definition.value_type ? target().getFields() : NOTHING;
    }
    #! returns the completed value base type
    /** @return the delegated base type code */
    int getBaseTypeCode() {
        return definition.value_type ? target().getBaseTypeCode() : NT_HASH;
    }
    #! returns whether this occurrence can be omitted
    /** @return the explicit occurrence override or definition default */
    bool isOrNothingType() {
        return optional ?? (definition.value_type ? definition.value_type.isOrNothingType() : False);
    }
    #! returns whether this occurrence is required
    /** @return True when omission is forbidden */
    bool isMandatory() {
        return !isOrNothingType();
    }
    #! returns the accepted input types for this occurrence
    /** @param simple whether to report simplified type names
        @return the target acceptance map with the occurrence override */
    hash<string, bool> getAcceptTypeHash(*bool simple) {
        hash<string, bool> result = definition.value_type ? target().getAcceptTypeHash(simple) : {"hash":True};
        if (isOrNothingType()) {
            result.nothing = True;
        } else {
            remove result.nothing;
            remove result.null;
        }
        return result;
    }
    #! returns the converted output types for this occurrence
    /** @param simple whether to report simplified type names
        @return the target return map with the occurrence override */
    hash<string, bool> getReturnTypeHash(*bool simple) {
        hash<string, bool> result = definition.value_type ? target().getReturnTypeHash(simple) : {"hash":True};
        if (isOrNothingType()) {
            result.nothing = True;
        } else {
            remove result.nothing;
            remove result.null;
        }
        return result;
    }
    #! validates and converts a recursive XML value
    /** @param value the value supplied for this occurrence
        @return the converted value, or NOTHING for permitted omission
        @throw MISSING-VALUE-ERROR a mandatory value is missing
        @throw RUNTIME-TYPE-ERROR NULL is forbidden or nested validation fails */
    auto acceptsValue(auto value) {
        if (!exists value) {
            if (isOrNothingType()) {
                return;
            }
            throw "MISSING-VALUE-ERROR", sprintf("recursive XML value %Y must be supplied", getName());
        }
        if (value.typeCode() == NT_NULL && !isOrNothingType()) {
            throw "RUNTIME-TYPE-ERROR", sprintf("mandatory recursive XML value %Y does not accept NULL", getName());
        }
        return target().acceptsValue(value);
    }
    #! delegates bounded example generation to the completed provider
    /** @param emap the existing cycle-detection map
        @param fname the field name used for examples
        @return an example, or NOTHING for optional recursive edges */
    auto getExampleValue(*hash<string, bool> emap, *string fname) {
        if (isOrNothingType()) {
            return;
        }
        return target().getMandatoryType().getExampleValue(emap, fname);
    }
    #! returns an optional occurrence of this definition
    /** @return a reference copy permitting omission */
    AbstractDataProviderType getOrNothingType() {
        XsdOrdinaryProviderReference result = self.copy();
        result.optional = True;
        return result;
    }
    #! returns a mandatory occurrence of this definition
    /** @return a reference copy requiring a value */
    AbstractDataProviderType getMandatoryType() {
        XsdOrdinaryProviderReference result = self.copy();
        result.optional = False;
        return result;
    }
    #! returns a reference using the completed soft field graph
    /** @return a soft reference retaining its occurrence flags */
    AbstractDataProviderType getSoftType() {
        XsdOrdinaryProviderReference result = self.copy();
        result.softened = True;
        return result;
    }
}

class XsdOrdinaryProviderContext {
    private {
        hash<string, XsdOrdinaryProviderDefinition> definitions();
    }
    AbstractDataProviderType get(XsdComplexType type, code<AbstractDataProviderType()> build) {
        string identity = type.uniqueHash();
        if (*XsdOrdinaryProviderDefinition definition = definitions{identity}) {
            if (definition.value_type) {
                return definition.value_type;
            }
            definition.referenced = True;
            return new XsdOrdinaryProviderReference(definition);
        }
        XsdOrdinaryProviderDefinition definition(type.name);
        definitions{identity} = definition;
        definition.value_type = build();
        return definition.value_type;
    }
    complete() {
        foreach XsdOrdinaryProviderDefinition definition in (definitions.iterator()) {
            @assert(definition.value_type);
            if (definition.referenced) {
                definition.soft_value_type = definition.value_type.getSoftType();
            }
        }
    }
}
thread_local *XsdOrdinaryProviderContext OrdinaryProviderContext;

#! XSD complex type class
public class XsdComplexType inherits WSDL::XsdAbstractType {
    public {
        *XsdArrayType array;
        *string arrayType;
        *string restriction;
        *string extension;

        #! expanded complex-content base identity captured at its declaration
        /** @since %WSDL 0.5.8 */
        *hash<auto> baseTypeInfo;
        #! resolved complex-content base type
        /** @since %WSDL 0.5.8 */
        *XsdAbstractType baseType;

        bool usedocns;

        #! Resolved element fields in this complex type
        /** Unambiguous fields keep local names. Every field sharing a local name with another namespace
            uses its expanded \c {namespace-uri}local-name, including \c {}local-name for no namespace.
            Choice fields follow the same naming rule across the complete type.
            @since %WSDL 0.5.8
        */
        hash<string, XsdElement> elementmap();
        bool anyAttribute = False;

        bool nillable = False;
        bool required = False;
        bool requires_value = False;

        # attributes
        hash<string, XsdAttribute> attrs();

        # any annotated documentation
        *string documentation;

        # temporarily used to store type information to resolve simpleType
        *hash<auto> simpleTypeInfo;
        # simpleContent type
        XsdAbstractType simpleType;

        # finalization flag
        bool finalized = False;

        # multiple choice blocks
        list<hash<ChoiceInfo>> choices();

        #! the alternatives of a complexType that is itself a choice
        /** each alternative is a hash of the elements belonging to it; alternatives declared as nested model groups
            (ex: an \c xs:sequence inside an \c xs:choice) have more than one element

            @since %WSDL 0.5.8
        */
        list<hash<string, XsdElement>> alternatives();
    }

    private {
        #! type of complexType object
        string cx_type;
        *XsdParticle particle;
        bool finalizing = False;
        *hash<auto> simpleRestriction;
        *hash<auto> simpleRestrictionNamespaces;
        *XsdSimpleType inlineSimpleType;
        hash<string, bool> prohibited_attributes();
        bool mixed = False;
        hash<string, bool> blocked_substitutions();
        bool abstract_type = False;
        bool content_emptiable = True;
        bool content_empty = True;
        bool has_element_wildcard = False;
        transient hash<XsdEmptiabilityInfo> emptiability();
        list<XsdElement> declared_elements();
        list<string> element_group_refs();
        hash<string, XsdElement> element_declarations();
        *hash<XsdAttributeWildcardInfo> local_attribute_wildcard;
        *hash<XsdAttributeWildcardInfo> attribute_wildcard;

        const XET_ALL      = "ALL";
        const XET_CHOICE   = "CHOICE";
        const XET_SEQUENCE = "SEQUENCE";
        const XET_SIMPLE   = "SIMPLE";
        const XET_NONE     = "NONE";
    }

    private:internal hash<auto> serializeMembers(*hash<auto> members) {
        hash<auto> values = self.(keys members);
        values.emptiability = XsdEmptiabilityHelper::serialize(emptiability);
        return values;
    }

    private:internal deserializeMembers(hash<auto> members) {
        emptiability = XsdEmptiabilityHelper::deserialize(remove members.emptiability);
        foreach string field in ("local_attribute_wildcard", "attribute_wildcard") {
            if (exists members{field}) {
                if (members{field}.typeCode() != NT_HASH) {
                    throw "DESERIALIZATION-ERROR", "a complex type requires valid attribute wildcard metadata";
                }
                XsdAttributeWildcardHelper::validateMetadata(members{field}, "DESERIALIZATION-ERROR");
                members{field} = new hash<XsdAttributeWildcardInfo>(members{field});
            }
        }
        self += members;
    }

    #! constructs a complex type and captures its effective instance controls
    /** @param ct parsed declaration, or NOTHING for an empty anonymous type
        @param nsc the declaration namespace registry and active source defaults
        @param unresolved the schema resolution queue
        @param n_usedocns default local element qualification
        @param desc_name descriptive name for an anonymous type
        @throw WSDL-ERROR malformed or misplaced controls, unresolved bases or invalid content declarations
        @throw WSDL-NAMESPACE-ERROR malformed or unbound declaration QName
        @note Instance block controls do not prohibit constructing derived types; final controls do.
    */
    constructor(*hash<auto> ct, Namespaces nsc, XsdLateResolverHelper unresolved, bool n_usedocns, *string desc_name)
            : XsdAbstractType(\ct, nsc, desc_name, XsdDerivationControlHelper::forType(ct."^attributes^", nsc, False)) {
        NamespacePrefixHelper declaration(nsc, ct."^attributes^");
        usedocns = n_usedocns;
        # Anonymous nested types also need group/base resolution and final field-name selection.
        on_success unresolved.add(self);
        blocked_substitutions = XsdDerivationControlHelper::forBlock(ct."^attributes^", nsc, True);
        if (exists ct."^attributes^".abstract && !exists ct."^attributes^".name) {
            throw WSDL_ERROR, "an anonymous complex type cannot declare abstract";
        }
        abstract_type = XsdDerivationControlHelper::booleanValue(ct."^attributes^".abstract, "abstract");
        mixed = XsdEmptiabilityHelper::getMixed(ct."^attributes^");
        content_empty = !mixed;
        #any a = ct."^attributes^";
        delete ct."^attributes^";

        *hash<auto> d = ct.complexContent;
        if (d) {
            NamespacePrefixHelper content_scope(nsc, d."^attributes^");
            mixed = XsdEmptiabilityHelper::getMixed(d."^attributes^", mixed);
            content_empty = !mixed;
            WSDL::XsdBase::removeNS(\d);
            if (d.hasKey("restriction")) {
                NamespacePrefixHelper restriction_scope(nsc, d.restriction."^attributes^");
                WSDL::XsdBase::removeNS(\d.restriction);

                *string base = d.restriction."^attributes^".base;
                if (!base) {
                    throw WSDL_ERROR, sprintf("complexType %Y restriction requires a base", name);
                }
                baseTypeInfo = nsc.getTypeHash(base);

                if (baseTypeInfo.val == "Array" && baseTypeInfo.uri == SOAP_ENCODING) {
                    *hash<auto> array_declaration = d.restriction.attribute."^attributes^";
                    auto aa = array_declaration;
                    WSDL::XsdBase::removeNSKeys(\aa);
                    if (!exists aa.arrayType) {
                        throw WSDL_ERROR, sprintf("cannot parse complexType restriction: %y", d.restriction);
                    }

                    delete d.restriction.attribute;

                    # issue #2899: check for an array element
                    if (d.restriction.sequence) {
                        auto seq = d.restriction.sequence;
                        NamespacePrefixHelper compositor(nsc, seq."^attributes^");
                        WSDL::XsdBase::removeNS(\seq);

                        auto sa = seq.element."^attributes^";
                        # according to https://access.redhat.com/documentation/en-US/Fuse_ESB/4.4.1/html/Writing_WSDL_Contracts/files/WSDLDefiningArrays.html
                        # if defining an element of an array, the element's maxOccurs attribute must be set to "unbounded"
                        if (XsdSimpleType::normalizeWhiteSpace(sa.maxOccurs ?? "", "collapse") != "unbounded") {
                            throw WSDL_ERROR, sprintf("array elements must have maxOccurs = \"unbounded\"; array type %y has maxOccurs = %y",
                                aa.arrayType, sa.maxOccurs);
                        }
                        arrayType = aa.arrayType;

                        particle = new XsdParticle("sequence", d.restriction.sequence, nsc, unresolved, usedocns);
                        collectParticleDeclarations(particle, unresolved);
                        parseModelGroup(particle, False);
                        cx_type = XET_SEQUENCE;
                    } else {
                        NamespacePrefixHelper attribute_scope(nsc, array_declaration);
                        array = new XsdArrayType(name, "", aa.arrayType, nsc, unresolved, getFinalDerivations(),
                            blocked_substitutions, abstract_type);
                    }

                    #printf("DEBUG: ans: %y atn: %y aa: %y\n", ans, atn, aa);
                    baseTypeInfo = NOTHING;
                    return;
                }
                restriction = baseTypeInfo.val;

                delete d.restriction."^attributes^";

                parseData(d.restriction, unresolved, nsc);
            } else if (d.hasKey("extension")) {
                NamespacePrefixHelper extension_scope(nsc, d.extension."^attributes^");
                *string ext_base = d.extension."^attributes^".base;
                if (!ext_base) {
                    throw WSDL_ERROR, sprintf("complexType %Y extension requires a base", name);
                }
                baseTypeInfo = nsc.getTypeHash(ext_base);
                extension = baseTypeInfo.val;
                delete d.extension."^attributes^";
                WSDL::XsdBase::removeNS(\d.extension);

                parseData(d.extension, unresolved, nsc);
            } else {
                throw "XSD-COMPLEXCONTENT-ERROR", sprintf("can't parse complexContent %y %y information", getName(), d.firstKey());
            }
        } else if (ct.hasKey("simpleContent")) {
            d = ct.simpleContent;
            NamespacePrefixHelper content_scope(nsc, d."^attributes^");
            WSDL::XsdBase::removeNS(\d);
            cx_type = XET_SIMPLE;
            required = True;
            requires_value = True;
            if (!d || (d.hasKey("extension") == d.hasKey("restriction"))) {
                throw WSDL_ERROR, sprintf("simpleContent type %Y requires exactly one extension or restriction", name);
            }
            bool extending = d.hasKey("extension");
            *hash<auto> body = d{extending ? "extension" : "restriction"};
            NamespacePrefixHelper derivation_scope(nsc, body."^attributes^");
            *string base = body."^attributes^".base;
            if (!base) {
                throw WSDL_ERROR, sprintf("simpleContent type %Y requires a base", name);
            }
            simpleTypeInfo = baseTypeInfo = nsc.getTypeHash(base);
            if (extending) {
                extension = baseTypeInfo.val;
            } else {
                restriction = baseTypeInfo.val;
            }
            remove body."^attributes^";
            WSDL::XsdBase::removeNS(\body);
            parseAttributes(\body, unresolved, nsc);
            remove body.annotation;
            remove body.ns;
            if (extending) {
                if (body) {
                    throw WSDL_ERROR, sprintf("unexpected simpleContent extension children %Y", keys body);
                }
            } else {
                if (body.hasKey("simpleType")) {
                    inlineSimpleType = new XsdSimpleType(remove body.simpleType, nsc, unresolved, usedocns,
                        sprintf("simpleType in restriction of %Y", name));
                }
                simpleRestriction = {"restriction": body};
                simpleRestrictionNamespaces = {"xmlns": nsc.getDefaultNs() ?? "",
                    "targetNamespace": nsc.getTargetNamespaceUri()};
                hash<string, string> input_prefixes = nsc.getInputNamespaceState().input;
                foreach string prefix in (keys input_prefixes) {
                    simpleRestrictionNamespaces{"xmlns:" + prefix} = input_prefixes{prefix};
                }
            }

        } else if (ct) {
            parseData(ct, unresolved, nsc);
        } else {
            # empty complex type
            cx_type = XET_NONE;
            required = True;
            requires_value = False;
        }
    }

    #! returns the ordered content particle of this complex type
    /** @return the declared content model, or NOTHING for empty or simple content
        @note Particle counts are independent of the legacy native field projection.
    */
    *XsdParticle getParticle() {
        return particle;
    }

    #! returns whether character fragments and child elements share an ordered content model
    /** @return True for mixed complex content, False for simple or element-only content
        @since %WSDL 0.5.8
    */
    bool hasMixedContent() {
        return mixed && cx_type != XET_SIMPLE;
    }

    *list<auto> getAllowedValues() {
        if (simpleType) {
            return simpleType.getAllowedValues();
        }
    }

    #! returns finite choices for the complete provider value
    /** @return NOTHING for structured simple content, whose choices belong to its scalar field;
        otherwise the existing scalar choices
    */
    *list<auto> getDataProviderAllowedValues() {
        return simpleType && (attrs || exists attribute_wildcard) ? NOTHING : getAllowedValues();
    }

    finalize(hash<string, XsdAbstractType> tmap, Namespaces nsc, *hash<string, XsdGroup> groupMap,
            *hash<string, XsdAttributeGroup> attrGroupMap, *XsdLateResolverHelper unresolved) {
        if (finalized) {
            return;
        }
        if (finalizing) {
            throw WSDL_ERROR, sprintf("cyclic complex type derivation involving %Y", name);
        }
        finalizing = True;
        on_exit finalizing = False;
        on_success finalized = True;
        *XsdParticle original_particle = particle;
        on_error particle = original_particle;
        hash<string, XsdAttribute> original_attributes = attrs;
        on_error attrs = original_attributes;
        bool original_mixed = mixed;
        bool original_empty = content_empty;
        on_error {
            mixed = original_mixed;
            content_empty = original_empty;
        }
        content_emptiable = XsdEmptiabilityHelper::evaluate(emptiability, groupMap ?? {});

        # Check identities before field merges or group occurrence updates can mutate components.
        hash<string, XsdElement> declarations();
        XsdElementConsistencyHelper::merge(\declarations, declared_elements);
        foreach string key in (element_group_refs) {
            *XsdGroup group = groupMap{key};
            if (!group) {
                throw WSDL_ERROR, sprintf("undefined group reference %Y", key);
            }
            group.resolveNestedGroups(groupMap);
            XsdElementConsistencyHelper::merge(\declarations, (map $1, group.getElementDeclarations().iterator()));
        }

        list<hash<XsdAttributeWildcardInfo>> group_wildcards();
        # Resolve local attribute-group uses before combining the derived declaration with its base.
        if (unresolved) {
            *list<string> attrGroupRefs = unresolved.getAttrGroupRefs(self);
            list<hash<string, XsdAttribute>> group_attributes();
            foreach string key in (attrGroupRefs) {
                *XsdAttributeGroup attrGrp = attrGroupMap{key};
                if (!attrGrp) {
                    throw WSDL_ERROR, sprintf("undefined attributeGroup reference %Y", key);
                }
                attrGrp.resolveNestedGroups(attrGroupMap, nsc);
                group_attributes += (attrGrp.getAttributes(),);
                *hash<XsdAttributeWildcardInfo> wildcard = attrGrp.getAttributeWildcard();
                if (exists wildcard) {
                    group_wildcards += wildcard;
                }
            }
            attrs = XsdAttribute::mergeMaps(attrs, group_attributes);
        }

        validateIdAttributeUses(attrs);
        *hash<XsdAttributeWildcardInfo> wildcard = XsdAttributeWildcardHelper::complete(local_attribute_wildcard,
            group_wildcards);
        if (baseTypeInfo) {
            XsdAbstractType resolved_base = baseTypeInfo.uri == XSD_NS ? nsc.getBaseType(baseTypeInfo.val)
                : tmap_get(tmap, type_qname(baseTypeInfo.uri, baseTypeInfo.val));
            XsdDerivationControlHelper::check(resolved_base,
                extension ? XsdDerivationMethod::Extension : XsdDerivationMethod::Restriction, name);
            if (cx_type == XET_SIMPLE) {
                XsdAbstractType content_type;
                if (resolved_base instanceof XsdComplexType) {
                    XsdComplexType base = cast<XsdComplexType>(resolved_base);
                    base.finalize(tmap, nsc, groupMap, attrGroupMap, unresolved);
                    wildcard = XsdAttributeWildcardHelper::derive(wildcard, base.attribute_wildcard, boolean(restriction));
                    if (base.cx_type == XET_SIMPLE) {
                        content_type = inlineSimpleType ?? base.simpleType;
                        if (restriction && !XsdTypeDerivationHelper::isDerived(content_type, base.simpleType)) {
                            throw WSDL_ERROR, sprintf("simpleContent type %Y does not restrict base content type %Y",
                                name, base.simpleType.name);
                        }
                    } else if (restriction && inlineSimpleType && base.mixed && base.content_emptiable) {
                        content_type = inlineSimpleType;
                    } else {
                        throw WSDL_ERROR, sprintf("simpleContent type %Y requires a simple-content base or a "
                            "restriction of a mixed emptiable base with an inline simpleType", name);
                    }
                    attrs = mergeInheritedAttributeUses(base);
                } else if (restriction && inlineSimpleType && resolved_base instanceof XsdBaseType
                        && resolved_base.name == "anyType") {
                    # The ur-type has mixed, emptiable content; an explicit simpleType supplies the restriction.
                    content_type = inlineSimpleType;
                    wildcard = XsdAttributeWildcardHelper::derive(wildcard, XsdAttributeWildcardHelper::urType(), True, True);
                } else if (extension && (resolved_base instanceof XsdSimpleType
                        || (resolved_base instanceof XsdBaseType && resolved_base.name != "anyType"))) {
                    content_type = resolved_base;
                } else {
                    throw WSDL_ERROR, sprintf("invalid base %Y for simpleContent type %Y", resolved_base.name, name);
                }
                if (restriction && simpleRestriction.restriction) {
                    NamespacePrefixHelper restriction_scope(nsc, simpleRestrictionNamespaces);
                    simpleType = new XsdSimpleType(simpleRestriction, nsc, unresolved ?? new XsdLateResolverHelper(),
                        usedocns, sprintf("simple content of %Y", name), content_type);
                } else {
                    simpleType = content_type;
                }
            } else if (resolved_base instanceof XsdComplexType) {
                XsdComplexType base = cast<XsdComplexType>(resolved_base);
                base.finalize(tmap, nsc, groupMap, attrGroupMap, unresolved);
                wildcard = XsdAttributeWildcardHelper::derive(wildcard, base.attribute_wildcard, boolean(restriction));
                if (extension) {
                    XsdElementConsistencyHelper::merge(\declarations, (map $1, base.element_declarations.iterator()));
                }
                attrs = mergeInheritedAttributeUses(base);
                if (extension) {
                    if (!content_empty && !base.content_empty
                            && (base.cx_type == XET_SIMPLE || mixed != base.mixed)) {
                        throw WSDL_ERROR, sprintf("nonempty complexContent extension %Y and its base %Y "
                            "must both have mixed content or both have element-only content", name, base.name);
                    }
                    content_emptiable = content_emptiable && base.content_emptiable;
                    particle = XsdParticle::concatenate(base.particle, getExtensionParticle(nsc, unresolved));
                    if (content_empty) {
                        mixed = base.mixed;
                        content_empty = base.content_empty;
                    }
                    elementmap = XsdElementFieldHelper::getExpandedMap(base.elementmap) + elementmap;
                    choices = base.choices + choices;
                    if (cx_type == XET_NONE || !cx_type) {
                        cx_type = base.cx_type;
                        alternatives = base.alternatives;
                    }
                    required = required || base.required;
                    requires_value = requires_value || base.requires_value;
                }
            } else if (!(resolved_base instanceof XsdBaseType) || resolved_base.name != "anyType") {
                throw WSDL_ERROR, sprintf("complexContent type %Y requires a complex base, got %Y", name,
                    resolved_base.name);
            } else {
                wildcard = XsdAttributeWildcardHelper::derive(wildcard, XsdAttributeWildcardHelper::urType(),
                    boolean(restriction), True);
                if (extension) {
                    if (!content_empty && !mixed) {
                        throw WSDL_ERROR, sprintf("nonempty complexContent extension %Y of anyType "
                            "must have mixed content", name);
                    }
                    XsdParticle builtin("sequence", {"any": {"^attributes^": {
                        "minOccurs": "0", "maxOccurs": "unbounded", "processContents": "lax"}}},
                        nsc, unresolved ?? new XsdLateResolverHelper(), usedocns);
                    particle = XsdParticle::concatenate(builtin, getExtensionParticle(nsc, unresolved));
                    if (content_empty) {
                        mixed = True;
                        content_empty = False;
                    }
                }
            }
            # Publish the link only after validation; failed cycles must not retain cyclic base links.
            baseType = resolved_base;
        }

        # Resolve and validate the complete particle before projecting native fields.
        if (particle) {
            particle.resolveGroups(groupMap ?? {});
            particle.validateDeterminism();
        }

        # Resolve captured expanded group identities; missing definitions are construction errors.
        if (unresolved) {
            *list<hash<GroupRefInfo>> groupRefList = unresolved.getGroupRefs(self);
            foreach hash<GroupRefInfo> groupRefInfo in (groupRefList) {
                *XsdGroup grp = groupMap{groupRefInfo.ref};
                if (!grp) {
                    throw WSDL_ERROR, sprintf("undefined group reference %Y", groupRefInfo.ref);
                }
                grp.resolveNestedGroups(groupMap);
                # Group occurrences belong to the reference particle. Reusing a
                # group's declarations must not change their own min/max limits.
                elementmap += XsdElementFieldHelper::getExpandedMap(grp.getElements());
            }
        }
        element_declarations = declarations;
        finalizeElementFields();
        attribute_wildcard = wildcard;
        has_element_wildcard = particleHasWildcard();
    }

    # XSD 1.0 effective content distinguishes absent/empty compositors from a
    # reference to a group, even when the referenced group's language is empty.
    private *XsdParticle getExtensionParticle(Namespaces nsc, *XsdLateResolverHelper unresolved) {
        if (content_empty) {
            return NOTHING;
        }
        if (!particle || particle.getMaxOccurs() == "0" || (!particle.getChildren()
                && (particle.getKind() == XsdParticleKind::All || particle.getKind() == XsdParticleKind::Sequence
                    || (particle.getKind() == XsdParticleKind::Choice && particle.getMinOccurs() == "0")))) {
            return new XsdParticle("sequence", NOTHING, nsc, unresolved ?? new XsdLateResolverHelper(), usedocns);
        }
        return particle;
    }

    private bool particleHasWildcard() {
        if (!particle) {
            return False;
        }
        list<XsdParticle> pending = (particle,);
        hash<string, bool> seen();
        while (pending) {
            XsdParticle node = pop pending;
            if (node.getMaxOccurs() == "0" || seen{node.uniqueHash()}) {
                continue;
            }
            seen{node.uniqueHash()} = True;
            if (node.getKind() == XsdParticleKind::Any) {
                return True;
            }
            if (node.getKind() == XsdParticleKind::Group) {
                @assert(node.getGroupDefinition());
                pending += node.getGroupDefinition();
            } else {
                pending += node.getChildren();
            }
        }
        return False;
    }

    private finalizeElementFields() {
        list<hash<string, XsdElement>> maps = (elementmap,);
        foreach hash<ChoiceInfo> choice in (choices) {
            maps += (choice.elementmap,);
        }
        hash<string, string> fields = XsdElementFieldHelper::getFieldNames(maps);
        elementmap = XsdElementFieldHelper::getFieldMap(elementmap, fields);
        alternatives = map XsdElementFieldHelper::getFieldMap($1, fields), alternatives;
        for (int i = 0; i < choices.size(); ++i) {
            choices[i].elementmap = XsdElementFieldHelper::getFieldMap(choices[i].elementmap, fields);
            choices[i].alternatives = map XsdElementFieldHelper::getFieldMap($1, fields), choices[i].alternatives;
        }
    }

    private validateIdAttributeUses(hash<string, XsdAttribute> uses) {
        *string first;
        foreach XsdAttribute attribute in (uses.iterator()) {
            if (XsdTypeDerivationHelper::isIdDerived(attribute.type)) {
                if (exists first) {
                    throw WSDL_ERROR, sprintf("type %Y has multiple ID attribute uses: %Y and %Y", name, first, attribute.name);
                }
                first = attribute.name;
            }
        }
    }

    private hash<string, XsdAttribute> mergeInheritedAttributeUses(XsdComplexType base) {
        hash<string, XsdAttribute> merged = XsdAttribute::mergeMaps(getInheritedAttributes(base), attrs, boolean(restriction));
        validateIdAttributeUses(merged);
        return merged;
    }

    private hash<string, XsdAttribute> getInheritedAttributes(XsdComplexType base) {
        hash<string, XsdAttribute> inherited = base.attrs;
        if (restriction) {
            hash<string, XsdAttribute> own_attributes();
            foreach XsdAttribute attr in (attrs.iterator()) {
                own_attributes{type_qname(attr.namespaceUri, attr.name)} = attr;
            }
            hash<string, bool> inherited_identities();
            foreach XsdAttribute attr in (inherited.iterator()) {
                inherited_identities{type_qname(attr.namespaceUri, attr.name)} = True;
            }
            foreach string identity in (keys own_attributes) {
                if (!inherited_identities{identity}
                        && !XsdAttributeWildcardHelper::allows(base.attribute_wildcard, own_attributes{identity}.namespaceUri)) {
                    throw WSDL_ERROR, sprintf("type %Y cannot introduce attribute %Y outside its base attribute wildcard",
                        name, identity);
                }
            }
            foreach string key in (keys inherited) {
                XsdAttribute attr = inherited{key};
                string identity = type_qname(attr.namespaceUri, attr.name);
                *XsdAttribute own = own_attributes{identity};
                if (own) {
                    if (attr.use == "required" && own.use != "required") {
                        throw WSDL_ERROR, sprintf("type %Y cannot make required base attribute %Y optional", name,
                            identity);
                    }
                    if (!XsdTypeDerivationHelper::isDerived(own.type, attr.type)) {
                        throw WSDL_ERROR, sprintf("type %Y attribute %Y type %Y does not restrict base type %Y",
                            name, identity, own.type.name, attr.type.name);
                    }
                    if (exists attr.fixedLexical && (!exists own.fixedLexical
                            || !XsdScalarValueHelper::equal(attr.type, own.getDefaultValue(), attr.getDefaultValue()))) {
                        throw WSDL_ERROR, sprintf("type %Y attribute %Y must preserve its base fixed constraint",
                            name, identity);
                    }
                }
                if (prohibited_attributes{identity}) {
                    if (attr.use == "required" && (!own || own.use != "required")) {
                        throw WSDL_ERROR, sprintf("type %Y cannot prohibit required base attribute %Y", name, attr.name);
                    }
                    remove inherited{key};
                }
            }
        }
        return inherited;
    }

    #! returns the resolved attribute wildcard for this type
    /** @return the constructed wildcard metadata, or NOTHING if no wildcard is present
        @note Metadata is available after schema construction; native value shapes are unchanged.
        @since %WSDL 0.5.8
    */
    *hash<XsdAttributeWildcardInfo> getAttributeWildcard() {
        return attribute_wildcard;
    }

    #! returns the effective instance substitution exclusions
    /** @return an independent extension/restriction method-name set
        @note The source blockDefault is filtered when this component is constructed.
        @since %WSDL 0.5.8
    */
    hash<string, bool> getBlockedSubstitutions() {
        return blocked_substitutions;
    }

    #! returns whether instances must select a concrete derived type
    /** @return the declaration's abstract property
        @since %WSDL 0.5.8
    */
    bool isAbstract() {
        return abstract_type;
    }

    private parseData(hash<auto> d, XsdLateResolverHelper unresolved, Namespaces nsc) {
        emptiability = XsdEmptiabilityHelper::parse(d, nsc);
        content_empty = XsdEmptiabilityHelper::hasEmptyContent(d, mixed);
        delete d.ns;
        if (d.hasKey("annotation")) {
            *hash<auto> ah = remove d.annotation;
            list<string> descriptions();
            foreach string key in (keys ah) {
                if (key == "documentation" || key.endsWith(":documentation")) {
                    list<auto> documents = ah{key}.typeCode() == NT_LIST ? ah{key} : (ah{key},);
                    foreach auto value in (documents) {
                        push descriptions, trim(XsdSchemaSource::documentationText(value));
                    }
                }
            }
            if (descriptions) {
                documentation = descriptions.join("\n");
            }
        }
        if (!d) {
            cx_type = XET_NONE;
            required = True;
            requires_value = False;
            return;
        }

        parseAttributes(\d, unresolved, nsc);

        if (!d) {
            cx_type = XET_NONE;
            required = True;
            requires_value = False;
            return;
        }

        if (d.size() > 1)
            throw WSDL_ERROR, sprintf("%s: expecting a single element in the complexType hash, got: %y", name,
                d.keys());

        string k = d.firstKey();
        if (k == "all" || k == "choice" || k == "sequence" || k == "group") {
            particle = new XsdParticle(k, d{k}, nsc, unresolved, usedocns);
            collectParticleDeclarations(particle, unresolved);
        }
        if (k == "all") {
            cx_type = XET_ALL;
            # issue #5410: model groups can be nested
            parseModelGroup(particle, False);
            setGroupFlags();
        } else if (k == "choice") {
            cx_type = XET_CHOICE;
            # issue #5410: an alternative in a choice can be a nested model group with more than one element
            alternatives = getChoiceAlternatives(particle);
            map elementmap += $1, alternatives;
            foreach XsdElement elem in (elementmap.iterator()) {
                if (elem.isRequired()) {
                    required = True;
                    break;
                }
            }
            setGroupFlags();
            # the element declarations only say whether a member requires a value if the choice is serialized at
            # all; whether the choice itself must be present is given by the "minOccurs" attribute of the choice
            if (exists d.choice."^attributes^".minOccurs && !d.choice."^attributes^".minOccurs.toInt()) {
                required = requires_value = False;
            }
        } else if (k == "sequence") {
            cx_type = XET_SEQUENCE;
            # issue #5410: model groups can be nested
            parseModelGroup(particle, False);
            setGroupFlags();
        } else if (k == "group") {
            # Handle top-level group reference
            cx_type = XET_SEQUENCE;  # Groups typically expand to sequences

        } else {
            throw "XSD-COMPLEXTYPE-ERROR", sprintf("unknown keys in %y", d);
        }
    }

    # Build the legacy field view from the ordered component graph. No second element
    # construction may occur here: anonymous types and forward references have identity.
    private parseModelGroup(XsdParticle model, bool optional) {
        optional = optional || model.getMinOccurs() == "0";
        foreach XsdParticle node in (model.getChildren()) {
            string kind = node.getKind();
            if (kind == "element") {
                XsdElement elem = node.getElement();
                elementmap{elem.getExpandedName()} = elem;
                if (!optional && elem.isRequired()) {
                    required = True;
                }
            } else if (kind == "choice") {
                list<hash<string, XsdElement>> alts = getChoiceAlternatives(node);
                hash<string, XsdElement> fields();
                map fields += $1, alts;
                if (fields) {
                    choices += <ChoiceInfo>{"elementmap": fields,
                        "required": !optional && node.getMinOccurs() != "0", "alternatives": alts};
                }
            } else if (kind == "sequence" || kind == "all") {
                parseModelGroup(node, optional);
            } else if (kind == "any") {
                anyAttribute = True;
            }
        }
    }

    private list<hash<string, XsdElement>> getChoiceAlternatives(XsdParticle choice) {
        list<hash<string, XsdElement>> result();
        foreach XsdParticle child in (choice.getChildren()) {
            hash<string, XsdElement> fields = flattenModelGroup(child);
            if (fields) {
                push result, fields;
            }
        }
        return result;
    }

    private hash<string, XsdElement> flattenModelGroup(XsdParticle node) {
        hash<string, XsdElement> result();
        list<XsdParticle> pending = (node,);
        while (pending) {
            XsdParticle current = pop pending;
            if (current.getKind() == "element") {
                XsdElement elem = current.getElement();
                result{elem.getExpandedName()} = elem;
            }
            list<XsdParticle> children = current.getChildren();
            for (int index = children.size() - 1; index >= 0; --index) {
                push pending, children[index];
            }
        }
        return result;
    }

    private collectParticleDeclarations(XsdParticle node, XsdLateResolverHelper unresolved, bool present = True) {
        present = present && node.getMaxOccurs() != "0";
        if (node.getKind() == "element") {
            if (present) {
                declared_elements += node.getElement();
            }
        } else if (node.getKind() == "group") {
            string identity = node.getGroupReference();
            unresolved.addGroupRef(self, identity, int(node.getMinOccurs()),
                exists node.getMaxOccurs() ? int(node.getMaxOccurs()) : -1);
            if (present) {
                element_group_refs += identity;
            }
        } else if (node.getKind() == "any" && present) {
            has_element_wildcard = True;
        }
        foreach XsdParticle child in (node.getChildren()) {
            collectParticleDeclarations(child, unresolved, present);
        }
    }

    #! identifies a list-valued simple-content type
    /** @return True when one simple-content value is represented by a native list */
    bool hasNativeListValue() {
        return simpleType ? simpleType.hasNativeListValue() : False;
    }

    #! sets the "nillable" and "requires_value" flags after the model group has been parsed
    /** @since %WSDL 0.5.8
    */
    private setGroupFlags() {
        if (elementmap.size() == 1 && elementmap.firstValue().isNillable()) {
            nillable = True;
        }
        if (required && !nillable) {
            requires_value = True;
        }
    }

    private parseAttributes(reference d, XsdLateResolverHelper unresolved, Namespaces nsc) {
        # process attributes if any
        if (d.hasKey("attribute") && !d.attribute) {
            throw WSDL_ERROR, "attribute declaration requires a name or reference";
        }
        foreach auto ah in (remove d.attribute) {
            if (ah.typeCode() != NT_HASH) {
                throw WSDL_ERROR, "attribute declaration requires a name or reference";
            }
            XsdAttribute attr(ah, nsc, NOTHING, unresolved);
            string identity = type_qname(attr.namespaceUri, attr.name);
            if (attr.use == "prohibited") {
                # Prohibitions remove inherited uses in a restriction, but contribute no new component.
                prohibited_attributes{identity} = True;
                continue;
            }
            if (attrs.hasKey(identity)) {
                throw WSDL_ERROR, sprintf("duplicate attribute use %Y", identity);
            }
            attrs{identity} = attr;
        }
        attrs = XsdAttribute::mergeMaps(new hash<string, XsdAttribute>(), attrs);

        # Attribute-group references retain the namespace of the referring declaration.
        if (d.hasKey("attributeGroup") && !d.attributeGroup) {
            throw WSDL_ERROR, "attributeGroup reference requires ref";
        }
        foreach hash<auto> ag in (remove d.attributeGroup) {
            if (!ag."^attributes^".ref) {
                throw WSDL_ERROR, "attributeGroup reference requires ref";
            }
            NamespacePrefixHelper reference_scope(nsc, ag."^attributes^");
            hash<auto> identity = nsc.getTypeHash(ag."^attributes^".ref ?? "");
            unresolved.addAttrGroupRef(self, type_qname(identity.uri, identity.val));
        }

        if (d.hasKey("anyAttribute")) {
            local_attribute_wildcard = XsdAttributeWildcardHelper::parse(d.anyAttribute, nsc.getTargetNamespaceUri());
            anyAttribute = True;
            delete d.anyAttribute;
        }
    }

    #! returns @ref True "True" if the complexType is a choice, in which case only one element may be serialized
    /** @since %WSDL 0.5.8
    */
    bool isChoice() {
        return cx_type == XET_CHOICE;
    }

    bool isNillable() {
        return nillable;
    }

    bool isRequired() {
        return required;
    }

    bool requiresValue() {
        return requires_value;
    }

    #! returns whether the effective content has an element wildcard
    /** @return True for an active element wildcard, including inherited particles and resolved group references
        @note Attribute wildcards and particles with maxOccurs zero do not make this true.
        Wildcard namespace and processing constraints still apply to every occurrence.
        @since %WSDL 0.5.8
    */
    bool hasElementWildcard() {
        return has_element_wildcard;
    }

    #! returns whether this type has no parsed element, choice, simple-content or element-wildcard slot
    /** @return True for an empty parsed content model; attributes do not count as content
        @note This query does not replace full ordered-particle or mixed-content validation.
    */
    bool isEmpty() {
        return !elementmap && !choices && !simpleType && !has_element_wildcard;
    }

    #! returns whether an element of this type may declare a default or fixed value
    /** @return True for simple content or mixed content whose complete particle admits no children
        @note Required attributes do not prevent a declaration constraint; instances must still supply them.
        This implements XSD 1.0 Element Default Valid (Immediate), independently of instance nillability.
        @since %WSDL 0.5.8
    */
    bool allowsElementValueConstraint() {
        return exists simpleType || (mixed && (!particle || particle.matchesElementNames(())));
    }

    AbstractDataProviderType getDataProviderType() {
        if (NativeTypeProviderContext) {
            return buildOrdinaryProvider();
        }
        if (OrdinaryProviderContext) {
            return OrdinaryProviderContext.get(self, \buildOrdinaryProvider());
        }
        XsdOrdinaryProviderContext owner();
        OrdinaryProviderContext = owner;
        on_exit OrdinaryProviderContext = NOTHING;
        AbstractDataProviderType result = owner.get(self, \buildOrdinaryProvider());
        owner.complete();
        return result;
    }
    private AbstractDataProviderType buildOrdinaryProvider() {
        AbstractDataProviderType rv = getDataProviderTypeIntern();
        return nillable || ((!required || isEmpty()) && !hasRequiredAttributes())
            ? rv.getOrNothingType()
            : rv;
    }

    private bool hasRequiredAttributes() {
        foreach XsdAttribute attr in (attrs.iterator()) {
            if (attr.use == "required") {
                return True;
            }
        }
        return False;
    }

    #! adds the existing public attribute hash to a complex content provider type
    private HashDataType addAttributeFields(HashDataType rv) {
        if (!attrs && !exists attribute_wildcard) {
            return rv;
        }
        HashDataType attributes = exists attribute_wildcard
            ? new XsdAttributeMapDataType(name + " attributes", nsc, attribute_wildcard, attrs)
            : new HashDataType(name + " attributes");
        *hash<auto> defaults;
        foreach string key in (keys attrs) {
            XsdAttribute attr = attrs{key};
            bool mandatory = attr.use == "required";
            AbstractDataProviderType attr_type = attr.type.getDataProviderType();
            hash<auto> info = {
                "name": key,
                "display_name": key,
                "short_desc": mandatory ? "Required XML attribute" : "Optional XML attribute",
                "desc": sprintf("%s XML attribute `%s`", mandatory ? "Required" : "Optional",
                    make_qname(attr.namespaceUri, attr.name)),
                "type": new XsdAttributeDataType(attr_type, mandatory),
            };
            *list<auto> allowed = exists attr.fixedLexical ? (attr.getDefaultValue(),)
                : attr.type.getAllowedValues();
            if (exists allowed) {
                info.allowed_values = map ("value": $1, "display_name": XsdDataFieldHelper::display($1)), allowed;
            }
            if (attr.hasValueConstraint()) {
                info.example_value = attr.getDefaultValue();
                if (!mandatory) {
                    info.default_value = attr.getDefaultValue();
                    defaults{key} = attr.getDefaultValue();
                }
            }
            attributes.addField(XsdDataFieldHelper::create(attr.type, info));
        }
        if (exists attribute_wildcard) {
            attributes.setDefaultOtherFieldType(AbstractDataProviderType::get(AbstractDataProviderType::anyType));
        }
        bool mandatory = hasRequiredAttributes();
        rv.addField(new QoreDataField({
            "name": "^attributes^",
            "display_name": "XML attributes",
            "short_desc": "XML attribute values",
            "desc": exists attribute_wildcard
                ? "Declared XML attributes use their field names. Wildcard attributes use expanded names such as "
                    "`{urn:partner}quantity`; unassessed text retains its namespace context."
                : "XML attribute values keyed by local name, or expanded name when local names collide",
            "type": mandatory ? attributes : attributes.getOrNothingType(),
            "default_value": mandatory ? NOTHING : defaults,
        }));
        return rv;
    }

    private AbstractDataProviderType getDataProviderTypeIntern() {
        if (array) {
            return array.getDataProviderType();
        }
        if (particle && cx_type != XET_SIMPLE) {
            *hash<string, hash<XsdParticleOccurrenceRange>> ranges = particle.getElementOccurrenceRanges();
            hash<string, XsdElement> declarations = getParticleDeclarations(ranges);
            hash<string, string> fields = XsdElementFieldHelper::getFieldNames(declarations);
            HashDataType result = mixed ? new XsdMixedContentDataType(self)
                : has_element_wildcard ? new XsdWildcardContentDataType(self) : new HashDataType(name);
            foreach string identity in (keys declarations) {
                XsdElement declaration = declarations{identity};
                hash<XsdParticleOccurrenceRange> range = ranges{identity};
                bool repeated = !exists range.maximum || XsdIntegerLexicalHelper::compare(range.maximum, "1") > 0;
                hash<auto> info = {"name": fields{identity},
                    "type": XsdElementFieldHelper::getOccurrenceType(declaration, range.minimum == "0",
                        repeated)};
                if (mixed) {
                    info.display_name = fields{identity};
                    info.short_desc = "XML child element";
                    info.desc = "The declared child value in its position among surrounding text. "
                        "Use numbered keys such as `name^1` for later segments of the same child.";
                }
                info{repeated ? "element_allowed_values" : "allowed_values"} =
                    declaration.getDataProviderAllowedValues();
                result.addField(XsdDataFieldHelper::create(declaration.type, info));
            }
            return addAttributeFields(result);
        }
        if (mixed && cx_type != XET_SIMPLE) {
            return addAttributeFields(new XsdMixedContentDataType(self));
        }
        switch (cx_type) {
            case XET_SIMPLE:
                if (attrs || exists attribute_wildcard) {
                    QoreDataField value_field = XsdDataFieldHelper::create(simpleType, {
                        "name": "^value^",
                        "display_name": "Value",
                        "short_desc": "Simple content value",
                        "desc": "The element's scalar value; XML attributes are supplied separately",
                        "type": simpleType.getDataProviderType(),
                        "allowed_values": map ("value": $1, "display_name": XsdDataFieldHelper::display($1)), simpleType.getAllowedValues(),
                    });
                    HashDataType structured_type(name);
                    structured_type.addField(value_field);
                    return new XsdSimpleContentDataType(name, value_field, addAttributeFields(structured_type),
                        !hasRequiredAttributes());
                }
                return simpleType.getDataProviderType();

            case XET_SEQUENCE:
            case XET_ALL: {
                HashDataType rv(name);
                map rv.addField(XsdDataFieldHelper::create($1.value, {"name": $1.key,
                    "type": $1.value.getDataProviderType(), "allowed_values": $1.value.getDataProviderAllowedValues()})),
                    elementmap.pairIterator();
                # issue #5410: elements declared in a choice block in the model group must be included as well; at
                # most one alternative of a choice can be present, therefore all its members must be optional
                foreach hash<ChoiceInfo> ch in (choices) {
                    map rv.addField(XsdDataFieldHelper::create($1.value, {"name": $1.key,
                        "type": $1.value.getDataProviderType().getOrNothingType(),
                        "allowed_values": $1.value.getDataProviderAllowedValues()})),
                        ch.elementmap.pairIterator();
                }
                return addAttributeFields(rv);
            }

            case XET_CHOICE: {
                HashDataType rv(name);
                # at most one member of a choice may be present, therefore all members must be optional
                map rv.addField(XsdDataFieldHelper::create($1.value, {"name": $1.key,
                    "type": $1.value.getDataProviderType().getOrNothingType(),
                    "allowed_values": $1.value.getDataProviderAllowedValues()})), elementmap.pairIterator();
                return addAttributeFields(rv);
            }

            case XET_NONE:
                if (attrs || exists attribute_wildcard) {
                    return addAttributeFields(new HashDataType(name));
                }
                return AbstractDataProviderType::get(AbstractDataProviderType::nothingType);
        }

        # complexTypes with no recognized content model accept any value
        return AbstractDataProviderType::get(AbstractDataProviderType::anyType);
    }

    private *hash<auto> serializeElement(Namespaces nsc, string key, XsdElement element, auto h, *softbool omitType) {
        auto v = h{key};
        string e_ons;
        #printf("DEBUG: XsdComplexType::serializeElement() key: %y v: %y h: %y ns: %y\n", key, v, h, nsc.getTargetNamespaceUri());
        auto e = element.serializeValue(nsc, v, omitType, key, name);

        if (!exists e && !element.isRequired())
            return;

        /*
        if (e_ons != ons && e_ons != "xsd") {
            if (e.typeCode() != NT_HASH)
                e = ("^value^": e);
            e."^attributes^" = ("xmlns": nsc.getOutputNamespaceUri(ons));
        }
        */

        hash<auto> rv.(!element.usedocns || !element.ns ? element.name
            : (nsc.getOutputNamespacePrefix(element.ns) + ":" + element.name)) = e;
        return rv;
    }

    #! converts native attributes independently of the element's content
    /** @param nsc the output namespace registry
        @param attributes native declared fields or expanded wildcard attribute names
        @return converted XML attributes, including declaration defaults
        @throw SOAP-SERIALIZATION-ERROR missing, prohibited or invalid attributes
        @note Nilled elements still require normal attribute assessment.
        @since %WSDL 0.5.8
    */
    *hash<auto> serializeAttributeValues(Namespaces nsc, *hash<auto> attributes) {
        *hash<auto> ah;
        if (attributes) {
            hash<auto> mah = attributes;
            hash<string, XsdAttribute> declared_attributes();
            foreach XsdAttribute attribute in (attrs.iterator()) {
                declared_attributes{type_qname(attribute.namespaceUri, attribute.name)} = attribute;
            }
            list<string> wildcard_names();
            foreach string k in (keys mah) {
                *XsdAttribute attribute = attrs{k} ?? declared_attributes{k};
                string wire_name;
                auto value;
                if (attribute) {
                    if (attribute.use == "prohibited") {
                        throw SOAP_SERIALIZATION_ERROR, sprintf("cannot set prohibited attribute %Y", k);
                    }
                    wire_name = attribute.getXmlName(nsc);
                    value = exists mah{k} ? attribute.serializeAttributeValue(nsc, mah{k}) : mah{k};
                } else {
                    XsdQNameValue identity = XsdWildcardAttributeHelper::name(k, SOAP_SERIALIZATION_ERROR);
                    push wildcard_names, type_qname(identity.getNamespaceUri(), identity.getLocalName());
                    wire_name = identity.getNamespaceUri()
                        ? nsc.getOutputNamespacePrefix(identity.getNamespaceUri()) + ":" + identity.getLocalName()
                        : identity.getLocalName();
                    value = XsdWildcardAttributeHelper::encode(self.nsc, nsc, attribute_wildcard, identity, mah{k});
                }
                if (ah.hasKey(wire_name)) {
                    throw SOAP_SERIALIZATION_ERROR, sprintf("duplicate attribute %Y", wire_name);
                }
                ah{wire_name} = value;
            }
            XsdWildcardAttributeHelper::checkIds(self.nsc, attribute_wildcard, attrs, wildcard_names,
                SOAP_SERIALIZATION_ERROR);
        }
        foreach XsdAttribute attr in (attrs.iterator()) {
            string wire_name = attr.getXmlName(nsc);
            if (attr.use == "required" && !exists ah{wire_name}) {
                throw SOAP_SERIALIZATION_ERROR, sprintf("cannot serialize element %Y without required attribute %Y",
                    getName(), attr.name);
            }
            if (attr.use == "optional" && !exists ah{wire_name} && attr.hasValueConstraint()) {
                ah{wire_name} = attr.serializeAttributeValue(nsc, attr.getDefaultValue());
            }
        }

        return ah;
    }

    #! converts XML attributes independently of the element's content
    /** @param attributes XML attributes with their namespace context
        @return typed declared fields and expanded wildcard fields, including defaults
        @throw SOAP-DESERIALIZATION-ERROR missing, prohibited or invalid attributes
        @note The caller's instance namespace scope remains active during conversion.
        @since %WSDL 0.5.8
    */
    *hash<auto> deserializeAttributeValues(*hash<auto> attributes) {
        *hash<auto> ah;
        hash<auto> expanded_attributes = XsdBase::getExpandedAttributes(attributes);
        hash<string, bool> declared_attributes();
        foreach string field in (keys attrs) {
            XsdAttribute xa = attrs{field};
            string identity = type_qname(xa.namespaceUri, xa.name);
            declared_attributes{identity} = True;
            *string attr_val = expanded_attributes{identity};
            if (xa.use == "required" && !exists attr_val) {
                throw SOAP_DESERIALIZATION_ERROR, sprintf("cannot deserialize element %Y without required attribute %Y",
                    getName(), xa.name);
            }
            if (exists attr_val) {
                if (xa.use == "prohibited") {
                    throw SOAP_DESERIALIZATION_ERROR, sprintf("cannot deserialize element %Y with prohibited attribute %Y",
                        getName(), xa.name);
                }
                ah{field} = xa.getValue(attr_val);
            } else if (xa.use == "optional" && xa.hasValueConstraint()) {
                ah{field} = xa.getInstanceDefaultValue();
            }
        }

        list<string> wildcard_names();
        foreach string identity in (keys expanded_attributes) {
            if (!declared_attributes{identity} && !XsdBase::isInstanceAttribute(identity)) {
                push wildcard_names, identity;
                ah{identity} = XsdWildcardAttributeHelper::decode(nsc, attribute_wildcard, identity,
                    expanded_attributes{identity});
            }
        }

        XsdWildcardAttributeHelper::checkIds(nsc, attribute_wildcard, attrs, wildcard_names,
            SOAP_DESERIALIZATION_ERROR);
        return ah;
    }

    #! serializes a complex value with this component's attributes and content
    /** @param nsc the output namespace registry
        @param h the native record or simple-content value
        @param omitType omit this component's implicit type annotation
        @return XML content and attributes
        @throw SOAP-SERIALIZATION-ERROR invalid attributes, particle content or scalar value
        @note Simple content contributes text and lexical namespace bindings; the containing complex type
        owns its type annotation.
        @par Example
        A measured invoice quantity retains both its numeric text and required unit attribute.
    */
    *hash<auto> serializeValue(Namespaces nsc, auto h, *softbool omitType) {
        XsdIdentityElementScope identity_scope(True);
        on_success identity_scope.finish(SOAP_SERIALIZATION_ERROR);
        if (isAbstract()) {
            throw SOAP_SERIALIZATION_ERROR, sprintf("abstract type %Y cannot validate an instance", name);
        }
        if (array) {
            return array.serializeValue(nsc, h, omitType);
        }
        if (has_element_wildcard && h.typeCode() == NT_HASH) {
            mergeRetainedWildcardContext(\h);
        }

        *hash<auto> ah = serializeAttributeValues(nsc, h.typeCode() == NT_HASH ? remove h."^attributes^" : NOTHING);
        hash<auto> rh;
        if (!mixed && h.typeCode() == NT_HASH) {
            foreach string k in (keys h) {
                if (k =~ /^\^comment/) {
                    rh{k} = remove h{k};
                }
            }
        }

        if (mixed && cx_type != XET_SIMPLE) {
            rh = convertMixedContent(h, nsc, NativeTypeOutputTypes ?? self.nsc.getInstanceTypes(), NOTHING, omitType);
        } else if (cx_type == XET_SIMPLE) {
            h = XsdScalarTextHelper::value(h, SOAP_SERIALIZATION_ERROR);
            # The containing complex type owns xsi:type. Its simple content is
            # text with optional lexical namespace bindings, never a nested XML value.
            auto content = XsdDocumentValueHelper::serializeValue(simpleType, nsc, h, True);
            if (content.typeCode() == NT_HASH) {
                rh += content;
            } else {
                rh."^value^" = content;
            }
        } else if (cx_type != XET_NONE) {
            if (!mixed) {
                h = XsdScalarTextHelper::elementContent(h, sprintf("element-only type %Y", getName()),
                    SOAP_SERIALIZATION_ERROR);
            }
            if (exists h && h.typeCode() != NT_HASH) {
                if (!anyAttribute) {
                    throw SOAP_SERIALIZATION_ERROR, sprintf("expecting hash<auto> argument to serialize from "
                        "complexType %y (got %y, type %y)", getName(), h, type(h));
                } else {
                    # NOTE: the "{} +" prefix is required to keep the value type of the hash as
                    # "auto"; a hash literal takes its value type from the values actually present,
                    # so without it this hash would narrow to "hash<string, string>" (or int, date,
                    # etc, according to the runtime type of "h"), and the "^attributes^" updates
                    # below would then either throw a RUNTIME-TYPE-ERROR or, worse, silently fold
                    # the attribute hash to an empty string and drop the attributes
                    rh = {} + {"^value^": h};
                }
            } else if (particle && !mixed && !(select keys h, $1 =~ /^\^choices/)) {
                rh += serializeNamedParticle(nsc, h, omitType);
            } else if (cx_type == XET_SEQUENCE || cx_type == XET_ALL) {
                foreach string p in (keys elementmap) {
                    #printf("DEBUG element: %y (%y)\nvalue: %y\n", p, elementmap{p}, h{p});
                    rh += serializeElement(nsc, p, elementmap{p}, h, omitType);
                    remove h{p};
                }

                # when generating example messages we need generate all choices, in this case extra ^choices^ tag is used
                # choice name is unique in element so ne merge all choices together first
                *hash<auto> hch;
                foreach string k in (keys h) {
                    if (k =~ /^\^choices/) {
                        hch += remove h{k};
                    }
                }
                # also serialize each choice block, if any
                foreach hash<ChoiceInfo> ch in (choices) {
                    list<string> kl = ch.elementmap.keys();
                    *hash<auto> vh = h{kl};
                    *hash<auto> vhch = hch{kl};
                    if (!vh && !vhch) {
                        if (ch.required)
                            throw SOAP_SERIALIZATION_ERROR, sprintf("expecting one of %y to serialize choice / union "
                                "in complexType %y but no such keys were supplied", ch.elementmap.keys(), getName());
                    } else {
                        if (vh) {
                            rh += serializeChoice(nsc, ch.elementmap, vh, omitType, False, ch.alternatives);
                            # remove the serialized key from the input hash for the check below
                            map remove h{$1}, keys vh;
                        }
                        if (vhch) {
                            rh += serializeChoice(nsc, ch.elementmap, vhch, omitType, True, ch.alternatives);
                            map remove hch{$1}, keys vhch;
                        }
                    }
                }

                if (h) {
                    if (!anyAttribute) {
                        auto kl = h.size() == 1 ? h.firstKey() : h.keys();
                        throw SOAP_SERIALIZATION_ERROR, sprintf("%y %s of type %y (valid elements: %y)", kl,
                            kl.lsize() == 1 ? "is an invalid member" : "are invalid members", getName(), elementmap.keys());
                    }
                    rh += XsdBase::restoreElementNamespaces(h);
                }
                if (hch) {
                    throw SOAP_SERIALIZATION_ERROR, sprintf("unknown choice members %y provided via ^choices^ in %y",
                        keys hch, getName());
                }
            } else { # "choice" - union
                # when generating example messages all choices are generated in a "^choices^" tag
                *hash<auto> hch;
                foreach string k in (keys h) {
                    if (k =~ /^\^choices/) {
                        hch += remove h{k};
                    }
                }
                if (!h && !hch) {
                    # no member of the choice was supplied; this is only an error if the choice is required
                    if (required) {
                        throw SOAP_SERIALIZATION_ERROR, sprintf("expecting one of %y to serialize choice / union "
                            "in complexType %y but no such keys were supplied", elementmap.keys(), getName());
                    }
                } else {
                    if (h) {
                        rh += serializeChoice(nsc, elementmap, h, omitType, False, alternatives);
                    }
                    if (hch) {
                        rh += serializeChoice(nsc, elementmap, hch, omitType, True, alternatives);
                    }
                }
            }
        } else { # "none"
            if (!mixed) {
                XsdScalarTextHelper::requireEmpty(h, sprintf("empty-content type %Y", name), SOAP_SERIALIZATION_ERROR);
            }
            rh."^value^" = NOTHING;
        }

        #printf("DEBUG name: %y desc: %y\n", name, descriptive_name);
        if (name && !omitType && !descriptive_name) {
            rh."^attributes^" += XsdDocumentValueHelper::typeAttributes(self, nsc) + ah;
        } else if (ah) {
            rh."^attributes^" += ah;
        }

        # issue #2899: if encoding elements of an array type, include the array type attribute
        if (arrayType && !omitType) {
            rh."^attributes^"."soapenc:arrayType" = arrayType;
        }

        #printf("DEBUG complex type %s returning %y from %y\n", name, rh, h);
        return rh;
    }

    private mergeRetainedWildcardContext(reference<auto> value) {
        *hash<string, string> inherited;
        foreach string key in (keys value) {
            if (key.startsWith("^") || key.startsWith(".")) {
                continue;
            }
            list<auto> children = value{key}.typeCode() == NT_LIST ? value{key} : (value{key},);
            foreach auto child in (children) {
                if (child instanceof XsdXmlValue) {
                    XsdSoapXmlHelper::mergeContext(\inherited, cast<XsdXmlValue>(child).getInheritedXmlAttributes());
                }
            }
        }
        if (inherited) {
            # Caller literals may infer hash<XsdXmlValue>; adding XML metadata
            # requires an ordinary heterogeneous XML record.
            value = {} + value;
        }
        foreach string key in (keys inherited) {
            string identity = type_qname("http://www.w3.org/XML/1998/namespace", key.substr(4));
            string field = identity;
            foreach string declared_field in (keys attrs) {
                XsdAttribute declaration = attrs{declared_field};
                if (type_qname(declaration.namespaceUri, declaration.name) == identity) {
                    field = declared_field;
                    break;
                }
            }
            if (value."^attributes^".hasKey(field) && value."^attributes^"{field} != inherited{key}) {
                throw SOAP_SERIALIZATION_ERROR, sprintf("retained wildcard XML requires inherited attribute %Y "
                    "with value %Y", identity, inherited{key});
            }
            value."^attributes^"{field} = inherited{key};
        }
    }

    # All native field adapters use only declarations present in the language.
    private hash<string, XsdElement> getParticleDeclarations(*hash<string, hash<XsdParticleOccurrenceRange>> ranges,
            *reference<hash<string, bool>> substitution_fields) {
        if (exists substitution_fields) {
            return XsdElementFieldHelper::getParticleDeclarations(particle, ranges, \substitution_fields);
        }
        return XsdElementFieldHelper::getParticleDeclarations(particle, ranges);
    }

    # Complete attribution selects every declaration before child conversion.
    private hash<auto> serializeNamedParticle(Namespaces nsc, *hash<auto> value, *softbool omitType) {
        @assert(particle);
        *hash<string, hash<XsdParticleOccurrenceRange>> ranges = particle.getElementOccurrenceRanges();
        hash<string, bool> substitution_fields();
        hash<string, XsdElement> declarations = getParticleDeclarations(ranges, \substitution_fields);
        hash<string, string> fields = XsdElementFieldHelper::getFieldNames(declarations);
        list<string> names();
        hash<string, list<auto>> values();
        foreach string identity in (keys ranges) {
            string field = fields{identity};
            @assert(exists field && declarations.hasKey(identity));
            if (field != identity && value.hasKey(identity)) {
                if (value.hasKey(field)) {
                    throw SOAP_SERIALIZATION_ERROR, sprintf("duplicate native values for field %Y in type %Y", field, name);
                }
                value{field} = remove value{identity};
            }
            bool present = value.hasKey(field);
            auto supplied = remove value{field};
            hash<XsdParticleOccurrenceRange> range = ranges{identity};
            if (!exists supplied && range.minimum == "0" && !(present && substitution_fields{identity})) {
                continue;
            }
            bool list_value = declarations{identity}.type.hasNativeListValue() && range.maximum == "1";
            list<auto> children = supplied.typeCode() == NT_LIST && !list_value ? supplied : (supplied,);
            if (!children && range.minimum == "1" && range.maximum == "1") {
                # The established empty-list spelling of a required empty wrapper
                # still supplies the wrapper. Its declaration validates the value.
                children = (supplied,);
            }
            values{identity} = children;
            foreach auto child in (children) {
                push names, identity;
            }
        }
        if (value && has_element_wildcard) {
            foreach string key in (keys value) {
                string identity = key.startsWith("{") ? key : type_qname("", key);
                if (values.hasKey(identity)) {
                    throw SOAP_SERIALIZATION_ERROR, sprintf("duplicate native wildcard values for element %Y", identity);
                }
                list<auto> children = value{key}.typeCode() == NT_LIST ? value{key} : (value{key},);
                values{identity} = children;
                foreach auto child in (children) {
                    push names, identity;
                }
            }
            value = NOTHING;
        }
        if (value) {
            throw SOAP_SERIALIZATION_ERROR, sprintf("invalid members %Y in type %Y; expected fields %Y", keys value,
                name, map fields{$1}, keys fields);
        }
        *list<string> ordered;
        try {
            ordered = particle.orderElementNames(names);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "XSD-PARTICLE-ERROR") {
                rethrow SOAP_SERIALIZATION_ERROR, ex.desc, ex.arg;
            }
            rethrow;
        }
        if (!exists ordered) {
            throw SOAP_SERIALIZATION_ERROR, sprintf("native child collection %Y does not match the complete "
                "particle of type %Y", names, name);
        }
        *list<XsdParticle> positions = particle.attributeElementNames(ordered);
        @assert(exists positions);
        hash<auto> result();
        hash<string, int> counts();
        hash<string, int> segments();
        hash<string, int> offsets();
        string previous;
        string output_key;
        for (int index = 0; index < positions.size(); ++index) {
            XsdParticle terminal = positions[index];
            string identity = ordered[index];
            auto supplied = values{identity}[offsets{identity}++];
            auto converted;
            string wire_name;
            if (terminal.getKind() == XsdParticleKind::Element) {
                *XsdElement declaration = terminal.getElement().getInstanceDeclaration(identity);
                @assert(declaration);
                converted = declaration.serializeOccurrence(nsc, supplied, omitType, fields{identity}, name);
                wire_name = declaration.getXmlName(nsc);
            } else {
                @assert(terminal.getKind() == XsdParticleKind::Any);
                hash<auto> restored = XsdWildcardElementHelper::encode(self.nsc, nsc, terminal.getWildcard(), identity,
                    supplied, omitType);
                if (restored."^xml^" instanceof XsdQNameXmlFragment) {
                    XsdQNameXmlFragment fragment = restored."^xml^";
                    result{"^xml^wildcard:" + index} = XsdQNameOutputScope::retains(nsc)
                        ? fragment : fragment.getXml();
                    previous = "";
                    continue;
                }
                wire_name = restored.firstKey();
                converted = restored{wire_name};
            }
            if (wire_name != previous) {
                output_key = wire_name;
                if (result.hasKey(output_key)) {
                    output_key += "^" + (++segments{wire_name}).toString();
                }
                result{output_key} = converted;
                counts{output_key} = 1;
                previous = wire_name;
            } else {
                if (counts{output_key} == 1) {
                    list<auto> occurrences();
                    push occurrences, result{output_key};
                    result{output_key} = occurrences;
                }
                push result{output_key}, converted;
                ++counts{output_key};
            }
        }
        return result;
    }

    private hash<auto> convertMixedContent(auto value, *Namespaces output,
            hash<string, XsdAbstractType> types, *hash<auto> references, *softbool omitType) {
        string error = output ? SOAP_SERIALIZATION_ERROR : SOAP_DESERIALIZATION_ERROR;
        # Whole native scalars retain the established make_xml() text conversion.
        # Explicit XML fragment metadata must still carry text, never a coerced value.
        int tc = value.typeCode();
        bool native_scalar = output && (tc == NT_INT || tc == NT_FLOAT || tc == NT_BOOLEAN
            || tc == NT_DATE || tc == NT_NUMBER);
        if (!exists value) {
            value = {};
        } else if (native_scalar || tc == NT_STRING || value instanceof XsdScopedLexicalValue) {
            value = {} + {"^value^": value};
        } else if (value.typeCode() != NT_HASH) {
            throw error, sprintf("mixed type %Y requires ordered content or text", name);
        }
        hash<string, XsdElement> declarations = particle
            ? getParticleDeclarations(particle.getElementOccurrenceRanges()) : new hash<string, XsdElement>();
        hash<string, string> fields = XsdElementFieldHelper::getFieldNames(declarations);
        hash<string, string> identities = map {$1.value: $1.key}, fields.pairIterator();
        hash<string, bool> ambiguous();
        foreach XsdElement declaration in (declarations.iterator()) {
            if (fields{declaration.getExpandedName()} != declaration.name) {
                ambiguous{declaration.name} = True;
            }
        }
        list<hash<XsdMixedContentItem>> items();
        list<string> names();
        foreach string key in (keys value) {
            if (key.startsWith("^") || key.startsWith(".")) {
                if (key !~ /^\^(value|cdata|comment)[0-9]*\^$/) {
                    throw error, sprintf("invalid mixed content metadata %Y", key);
                }
                if (!native_scalar && value{key}.typeCode() != NT_STRING && !(output && !key.startsWith("^comment")
                        && value{key} instanceof XsdScopedLexicalValue)) {
                    throw error, sprintf("mixed content fragment %Y requires XML text", key);
                }
                push items, <XsdMixedContentItem>{"key": key, "value": value{key}};
                continue;
            }
            string base = key;
            base =~ s/\^[0-9]+$//;
            if (ambiguous{base}) {
                throw error, sprintf("ambiguous mixed child %Y requires its expanded name", base);
            }
            string identity = identities{base} ?? (base.startsWith("{") ? base : type_qname("", base));
            bool list_value = output && declarations{identity} && declarations{identity}.type.hasNativeListValue();
            list<auto> children = value{key}.typeCode() == NT_LIST && !list_value ? value{key} : (value{key},);
            if (!children) {
                throw error, sprintf("empty occurrence collection for mixed child %Y", key);
            }
            foreach auto child in (children) {
                push names, identity;
                push items, <XsdMixedContentItem>{"key": key, "identity": identity, "value": child};
            }
        }
        *list<XsdParticle> positions;
        try {
            positions = particle ? particle.attributeElementNames(names) : names ? NOTHING : new list<XsdParticle>();
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "XSD-PARTICLE-ERROR") {
                rethrow error, ex.desc, ex.arg;
            }
            rethrow;
        }
        if (!exists positions) {
            throw error, sprintf("ordered mixed children %Y do not match type %Y", names, name);
        }
        hash<auto> result();
        hash<string, int> segments();
        hash<string, int> counts();
        string previous;
        string previous_key;
        int position = 0;
        foreach hash<XsdMixedContentItem> item in (items) {
            if (!exists item.identity) {
                bool comment = item.key.startsWith("^comment");
                auto text = item.value;
                if (text.typeCode() == NT_STRING) {
                    if (comment && (text.find("--") >= 0 || text.endsWith("-"))) {
                        throw error, "a mixed XML comment cannot contain -- or end with a hyphen";
                    }
                    try {
                        XsdScopedLexicalValue scoped(text, output ? {"": ""} : {"": ""} + (QNameInputNamespaces ?? {}));
                        if (!comment && (output ? XsdQNameOutputScope::retains(output) : PreserveNativeTypes)) {
                            text = scoped;
                        }
                    } catch (hash<ExceptionInfo> ex) {
                        if (ex.err == "XSD-SCOPED-VALUE-ERROR") {
                            rethrow error, ex.desc, ex.arg;
                        }
                        rethrow;
                    }
                }
                result{item.key} = text;
                previous = "";
                continue;
            }
            XsdParticle terminal = positions[position++];
            string key;
            auto converted;
            bool list_value = False;
            if (terminal.getKind() == XsdParticleKind::Element) {
                *XsdElement declaration = terminal.getElement().getInstanceDeclaration(item.identity);
                @assert(declaration);
                list_value = declaration.type.hasNativeListValue();
                converted = output ? declaration.serializeOccurrence(output, item.value, omitType,
                    fields{item.identity}, name) : declaration.deserializeOccurrence(types, references,
                        getValue(references, item.value));
                key = output ? declaration.getXmlName(output) : fields{item.identity};
            } else {
                @assert(terminal.getKind() == XsdParticleKind::Any);
                if (output) {
                    hash<auto> wire = XsdWildcardElementHelper::encode(nsc, output, terminal.getWildcard(),
                        item.identity, item.value, omitType);
                    if (wire."^xml^" instanceof XsdQNameXmlFragment) {
                        XsdQNameXmlFragment fragment = wire."^xml^";
                        result{"^xml^mixed:" + position} = XsdQNameOutputScope::retains(output)
                            ? fragment : fragment.getXml();
                        previous = "";
                        continue;
                    }
                    key = wire.firstKey();
                    converted = wire{key};
                } else {
                    key = PreserveNativeTypes ? item.identity : item.key;
                    key =~ s/\^[0-9]+$//;
                    converted = XsdWildcardElementHelper::decode(nsc, terminal.getWildcard(), item.identity,
                        types, references, item.value);
                }
            }
            if (previous == key && !list_value) {
                if (counts{previous_key} == 1) {
                    list<auto> adjacent();
                    push adjacent, result{previous_key};
                    result{previous_key} = adjacent;
                }
                push result{previous_key}, converted;
                ++counts{previous_key};
            } else {
                previous = key;
                if (result.hasKey(key)) {
                    key += "^" + (++segments{key}).toString();
                }
                result{key} = converted;
                counts{key} = 1;
                previous_key = key;
            }
        }
        @assert(position == positions.size());
        return result;
    }

    private *hash<auto> serializeChoice(Namespaces nsc, hash<string, XsdElement> emap, hash<auto> h,
            *softbool omitType, bool all_members, *list<hash<string, XsdElement>> alts) {
        *hash<string, XsdElement> alt;
        # normally there is only one choice but we also need output example message where all options are enumerated
        if (!all_members && elements h > 1) {
            # issue #5410: an alternative can be a nested model group with more than one element; in that case all
            # the keys supplied must belong to a single alternative
            alt = XsdComplexType::getMatchingAlternative(alts, keys h);
            if (!alt) {
                throw SOAP_SERIALIZATION_ERROR, sprintf("cannot serialize choice / union in complexType %y with more "
                    "than 1 member (%y)", getName(), h.keys());
            }
        }
        *hash<auto> rh;
        # if a model group alternative was matched, then serialize the elements in the order they are declared in it
        foreach string key in (alt ? (select (keys alt), exists h{$1}) : (keys h)) {
            if (!emap{key})
                throw SOAP_SERIALIZATION_ERROR, sprintf("%y is an invalid member of choice / union in complexType "
                    "%y; expecting one of: %y", key, getName(), emap.keys());

            # add namespace if necessary
            rh += serializeElement(nsc, key, emap{key}, h, omitType);
        }
        # add namespace if necessary
        return rh;
    }

    #! returns the choice alternative containing all the given element names, if any
    /** @since %WSDL 0.5.8
    */
    private static *hash<string, XsdElement> getMatchingAlternative(*list<hash<string, XsdElement>> alts,
            list<auto> kl) {
        foreach hash<string, XsdElement> alt in (alts) {
            if (alt.size() > 1 && !(select kl, !exists alt{$1})) {
                return alt;
            }
        }
    }

    #! decodes complex content after selecting its explicitly named component
    /** @param en the containing element name
        @param tmap the resolved schema types indexed by expanded name
        @param mrh SOAP reference values, when applicable
        @param oval XML content with its instance namespace context
        @return the native record or simple-content value
        @throw SOAP-DESERIALIZATION-ERROR unresolved or incompatible type, invalid attributes or content
        @note Instance type QNames resolve in the element's namespace scope before derived fields are checked.
        @par Example
        Decode a shipment extension's required tracking attribute using the selected extension's declaration.
    */
    auto deserializeValue(string en, hash<string, XsdAbstractType> tmap, *hash<auto> mrh, auto oval) {
        XsdIdentityElementScope identity_scope(True);
        on_success identity_scope.finish(SOAP_DESERIALIZATION_ERROR);
        XsdQNameNamespaceScope qname_scope(oval.typeCode() == NT_HASH ? oval."^attributes^" : NOTHING);
        #printf("XsdComplexType::deserialize() name: %y val: %y required: %y\n", getName(), oval, required);
        if (exists array)
            return array.deserializeValue(en, tmap, mrh, oval);

        XsdAbstractType selected = XsdTypeSubstitutionHelper::select(\oval, self, tmap, en);
        if (selected !== self) {
            return XsdDocumentValueHelper::deserializeValue(selected, en, tmap, mrh, oval);
        }

        if (!mixed && !exists oval) {
            if (!required && !attrs) {
                if (particle && !particle.matchesElementNames(())) {
                    throw SOAP_DESERIALIZATION_ERROR, sprintf("empty content does not match the complete "
                        "particle of type %Y", name);
                }
                return;
            }
        }

        hash<auto> rh;

        # to avoid "RUNTIME-TYPE-ERROR" exceptions in the next line`
        if (mixed && cx_type != XET_SIMPLE && !exists oval) {
            oval = {};
        } else if ((cx_type == XET_SIMPLE || mixed) && oval.typeCode() != NT_HASH) {
            oval = {"^value^": oval};
        }
        if (exists oval && oval.typeCode() != NT_HASH) {
            if (!anyAttribute) {
                throw SOAP_DESERIALIZATION_ERROR, sprintf("cannot deserialize complex type %y from Qore type %y "
                    "(expecting \"hash\")", getName(), oval.type());
            } else {
                # NOTE: the "{} +" prefix is required to keep the value type of the hash as "auto";
                # a hash literal takes its value type from the values actually present, so without
                # it this hash would narrow to "hash<string, string>" (or int, date, etc, according
                # to the runtime type of "oval"), and the narrowed type survives the assignments to
                # "val" and "rh" below.  The "^attributes^" assignment at the end of this method
                # would then fail with a RUNTIME-TYPE-ERROR; that is currently unreachable, since
                # the attribute hash is only populated when the input is already a hash (which
                # skips this branch), but the widening keeps the two independent of each other
                oval = {} + {"^value^": oval};
            }
        }
        *hash<auto> val = particle ? oval : mapExpandedElementNames(oval);
        *hash<auto> attr = remove val."^attributes^";
        *hash<auto> ah = deserializeAttributeValues(attr);
        if (val.typeCode() == NT_HASH) {
            WSDL::XsdBase::removeNS2(\val);

            #any ns = val.".ns";
            val -= ".ns";
        }

        if (mixed && cx_type != XET_SIMPLE) {
            rh = convertMixedContent(val, NOTHING, tmap, mrh);
        } else if (cx_type == XET_SIMPLE) {
            if (!exists val && !required)
                return;
            auto sv = XsdDocumentValueHelper::deserializeValue(simpleType, name, tmap, mrh,
                XsdScalarTextHelper::value(val, SOAP_DESERIALIZATION_ERROR));
            if (sv.typeCode() == NT_HASH)
                rh = sv;
            else
                rh."^value^" = sv;
        } else if (cx_type != XET_NONE || particle) {
            if (exists val && val.typeCode() != NT_HASH)
                throw SOAP_DESERIALIZATION_ERROR, sprintf("cannot deserialize element %y type %y from qore type %y "
                    "(expecting hash)", en, getName(), val.type());

            if (!mixed) {
                # xml:space affects the XML data view, but schema element-only content
                # permits XML whitespace between children independently of that policy.
                val = XsdScalarTextHelper::elementContent(val, sprintf("element-only type %Y", getName()));
            }

            if (particle) {
                rh = deserializeParticle(tmap, mrh, val);
            } else if (cx_type == XET_SEQUENCE || cx_type == XET_ALL) {
                #printf("XsdComplexType::deserialize() name: %y val: %y required: %y\n", getName(), val, required);
                # if we have one element
                if (elementmap.size() == 1 && val.size() == 1
                    && val.firstKey() == elementmap.firstKey()
                    && !exists val{elementmap.firstKey()} && !required && !choices)
                    return;

                foreach string p in (keys elementmap) {
                    #printf("element %y\n", p);
                    rh{p} = elementmap{p}.deserializeValue(tmap, mrh, getValue(mrh, val{p}), val.hasKey(p));
                    remove val{p};
                }
                # also parse each choice block, if any
                foreach hash<ChoiceInfo> ch in (choices) {
                    *hash<auto> vh = val.(ch.elementmap.keys());
                    *hash<auto> h = parseChoice(vh, ch.elementmap, en, tmap, mrh, ch.required, ch.alternatives);
                    if (h)
                        rh += h;
                    remove val.(h.keys());
                    #printf("choice em: %y h: %y\n", ch.elementmap.keys(), h);
                }
                remove val."^attributes^";
                if (val) {
                    if (!anyAttribute) {
                        throw SOAP_DESERIALIZATION_ERROR, sprintf("invalid element %y passed in type %y for element %y "
                            "(expecting %y)", (keys val)[0], getName(), en, keys elementmap);
                    } else {
                        rh = val;
                    }
                }
            } else { # "choice" - union
                # a choice declared with minOccurs = 0 does not have to have a member present
                rh += parseChoice(val, elementmap, en, tmap, mrh, required, alternatives);
            }
        }

        if (cx_type == XET_NONE && !particle && !mixed) {
            XsdScalarTextHelper::requireEmpty(val, sprintf("empty-content type %Y", name), SOAP_DESERIALIZATION_ERROR);
        }
        if (ah) {
            if (RetainedXmlValidationNamespaces && particle) {
                foreach string field in (keys ah) {
                    if (attrs{field}) {
                        attrs{field}.serializeAttributeValue(RetainedXmlValidationNamespaces, ah{field});
                    } else {
                        XsdWildcardAttributeHelper::encode(nsc, RetainedXmlValidationNamespaces, attribute_wildcard,
                            XsdWildcardAttributeHelper::name(field, SOAP_SERIALIZATION_ERROR), ah{field});
                    }
                }
            }
            rh."^attributes^" = ah;
        }
        if (mixed && !PreserveNativeTypes && rh.empty()) {
            return;
        }
        if ((!mixed || !PreserveNativeTypes) && rh.size() == 1 && rh.hasKey("^value^")) {
            return rh."^value^";
        }
        return rh;
    }

    private hash<auto> deserializeParticle(hash<string, XsdAbstractType> tmap, *hash<auto> mrh,
            *hash<auto> value) {
        @assert(particle);
        hash<string, bool> substitution_fields();
        hash<string, XsdElement> declarations = getParticleDeclarations(particle.getElementOccurrenceRanges(),
            \substitution_fields);
        hash<string, string> fields = XsdElementFieldHelper::getFieldNames(declarations);
        hash<string, string> identities = map {$1.value: $1.key}, fields.pairIterator();
        hash<string, bool> ambiguous_names();
        foreach XsdElement element in (declarations.iterator()) {
            if (fields{element.getExpandedName()} != element.name) {
                ambiguous_names{element.name} = True;
            }
        }
        list<string> names();
        list<string> field_names();
        list<auto> values();
        hash<auto> result();
        foreach string key in (keys value) {
            if (key =~ /^[\^.]/) {
                if (mixed && key =~ /^\^(value|cdata)[0-9]*\^$/) {
                    result{key} = value{key};
                } else if (key !~ /^\^comment[0-9]*\^$/ && key != ".ns") {
                    throw SOAP_DESERIALIZATION_ERROR, sprintf("invalid XML content metadata %Y for type %Y",
                        key, name);
                }
                continue;
            }
            string identity = key;
            identity =~ s/\^[0-9]+$//;
            if (ambiguous_names{identity}) {
                throw SOAP_DESERIALIZATION_ERROR, sprintf("ambiguous element name %Y in type %Y; "
                    "use its namespace-expanded name", identity, name);
            }
            # Public component callers can still supply local field names. SOAP
            # callers pass namespace-expanded XML names before reaching this method.
            string field = identity;
            identity = identities{identity} ?? (identity.startsWith("{") ? identity : type_qname("", identity));
            field = fields{identity} ?? field;
            list<auto> children = value{key}.typeCode() == NT_LIST ? value{key} : (value{key},);
            if (!children) {
                throw SOAP_DESERIALIZATION_ERROR, sprintf("empty XML occurrence list for element %Y", key);
            }
            foreach auto child in (children) {
                push names, identity;
                push field_names, field;
                push values, child;
            }
        }
        *list<XsdParticle> positions;
        try {
            positions = particle.attributeElementNames(names);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "XSD-PARTICLE-ERROR") {
                rethrow;
            }
            throw SOAP_DESERIALIZATION_ERROR, sprintf("invalid XML child name in type %Y: %s", name, ex.desc);
        }
        if (!exists positions) {
            throw SOAP_DESERIALIZATION_ERROR, sprintf("ordered child elements %Y do not match the complete "
                "particle of type %Y", names, name);
        }
        # Preserve the existing absent native field contract; choice-only fields
        # remain absent until selected. Actual group validity was checked above.
        if (cx_type != XET_CHOICE && !result) {
            hash<string, bool> present = map {$1: True}, field_names;
            hash<string, bool> absent();
            foreach XsdElement element in (elementmap.iterator()) {
                string identity = element.getExpandedName();
                # A substitution field's presence selects an element even when its value is NOTHING.
                # Do not invent absent head fields that would add a second member during serialization.
                if (!substitution_fields{identity}) {
                    absent{identity} = True;
                }
            }
            # Initialize both ordinary fields and selected alternatives in particle order.
            # Adding choice fields after elementmap would move them behind the sequence's suffix.
            foreach string identity in (keys declarations) {
                string field = fields{identity};
                if (present{field} || absent{identity}) {
                    result{field} = NOTHING;
                }
            }
        }
        hash<string, int> counts();
        for (int index = 0; index < positions.size(); ++index) {
            XsdParticle terminal = positions[index];
            string field = field_names[index];
            auto converted;
            if (terminal.getKind() == XsdParticleKind::Element) {
                *XsdElement declaration = terminal.getElement().getInstanceDeclaration(names[index]);
                @assert(declaration);
                converted = declaration.deserializeOccurrence(tmap, mrh, getValue(mrh, values[index]));
            } else {
                @assert(terminal.getKind() == XsdParticleKind::Any);
                converted = XsdWildcardElementHelper::decode(nsc, terminal.getWildcard(), names[index], tmap, mrh,
                    values[index]);
            }
            if (!counts{field}) {
                result{field} = converted;
            } else {
                if (counts{field} == 1) {
                    list<auto> occurrences();
                    push occurrences, result{field};
                    result{field} = occurrences;
                }
                push result{field}, converted;
            }
            ++counts{field};
        }
        return result;
    }

    #! matches namespace-resolved wire names to the existing public record fields
    private *hash<auto> mapExpandedElementNames(*hash<auto> value) {
        hash<string, string> fields();
        foreach string field in (keys elementmap) {
            fields{elementmap{field}.getExpandedName()} = field;
        }
        foreach hash<ChoiceInfo> choice in (choices) {
            foreach string field in (keys choice.elementmap) {
                fields{choice.elementmap{field}.getExpandedName()} = field;
            }
        }
        *hash<auto> result;
        foreach string key in (keys value) {
            string field = fields{key} ?? key;
            if (result.hasKey(field)) {
                throw SOAP_DESERIALIZATION_ERROR, sprintf("duplicate XML values for field %Y in type %Y", field, name);
            }
            result{field} = value{key};
        }
        return result;
    }

    private *hash<auto> parseChoice(hash<auto> val, hash<string, XsdElement> emap, string en,
            hash<string, XsdAbstractType> tmap, *hash<auto> mrh, *bool required,
            *list<hash<string, XsdElement>> alts) {
        list<auto> kl = val.keys();
        if (elements kl > 1) {
            # issue #5410: an alternative can be a nested model group with more than one element; in that case all
            # the elements supplied must belong to a single alternative
            *hash<string, XsdElement> alt = XsdComplexType::getMatchingAlternative(alts, kl);
            if (!alt) {
                throw SOAP_DESERIALIZATION_ERROR, sprintf("too many elements supplied for choice / union in type %y "
                    "for element %y (%y)", getName(), en, kl);
            }
            hash<auto> rv();
            foreach string key in (select (keys alt), val.hasKey($1)) {
                rv{key} = emap{key}.deserializeValue(tmap, mrh, getValue(mrh, val{key}), True);
            }
            return rv;
        }
        *string key = kl[0];
        if (!exists key) {
            if (required)
                throw SOAP_DESERIALIZATION_ERROR, sprintf("missing element for choice / union in type %y for element "
                    "%y (expecting one of: %y)", getName(), en, emap.keys());
            return;
        }
        if (!exists emap{key})
            throw SOAP_DESERIALIZATION_ERROR, sprintf("element %y is not a valid element for choice / union in type "
                "%y for element %y (valid elements: %y)", key, getName(), en, emap.keys());

        return (key: emap{key}.deserializeValue(tmap, mrh, getValue(mrh, val{key}), val.hasKey(key)));
    }
}

#! Abstract WSDL 1.1 message exchange order
/** @since %WSDL 0.5.8 */
public enum WsdlOperationPattern : string {
    #! Receive one message
    OneWay = "one-way",
    #! Receive a message and send a correlated response
    RequestResponse = "request-response",
    #! Send a message and receive a correlated response
    SolicitResponse = "solicit-response",
    #! Send one message
    Notification = "notification",
}

#! web service operation class
/** Operations own their namespace context, input/output/fault messages and operational bindings.
    A handle remains usable after its source WebService leaves scope; binding headers retain their own messages.
    Serializable reconstruction establishes the same ownership, including older graphs with weak member references.
    @par Example
    Cache a partner operation directly with service.getOperation("submitOrder") for later serialization;
    retaining a second reference to the service is unnecessary.
*/
public class WSOperation inherits WSDL::XsdNamedData {
    public {
        #! request message
        *WSMessage input;
        #! response message
        *WSMessage output;
        #! abstract input label used to identify the WSDL operation; not an RPC wrapper name
        *string input_name;
        #! abstract output label used to identify the WSDL operation; not an RPC wrapper name
        *string output_name;

        #! namespace container
        Namespaces nsc;

        #! the SOAPAction header value to send with this operation
        *string soapAction;

        #! a hash of top-level request names for this operation (depends on bindings)
        hash<string, bool> reqh;

        #! params per associated binding; key = binding name; value = OperationalBinding object
        hash<string, OperationalBinding> bindings;
    }

    private {
        #! fault messages keyed by fault name
        hash<string, WSMessage> faults;

        # Expanded binding identities map to the single public bindings entry.
        hash<string, string> binding_keys();
        # Older standalone graphs did not retain the order of abstract messages.
        *WsdlOperationPattern exchange_pattern;
        *string selection_key;
    }

    #! creates the WSOperation object from the arguments supplied
    /** @param p the raw hash from deserialized XML data for the operation
        @param nsc the namespace container
        @param messages message component keys mapped to WSMessage objects
        @param registry optional internal registry for resolving imported component identities
        @param overloaded True when the containing port type declares more than one operation with this XML name
        @throw WSDL-ERROR the operation has no input/output message or references an unknown message
     */
    constructor(hash<auto> p, Namespaces nsc, *hash<auto> messages, *WsdlComponentRegistry registry,
            bool overloaded = False) : XsdNamedData(\p) {
        self.nsc = nsc;
        NamespacePrefixHelper operation_scope(nsc, p."^attributes^");

        if (p.input) {
            NamespacePrefixHelper message_scope(nsc, p.input."^attributes^");
            hash<auto> msghash = processNSValue(p.input."^attributes^");
            string key = registry ? registry.resolve("message", p.input."^attributes^".message, nsc)
                : msghash.message.val;
            *WSMessage msg = messages{key};
            if (!msg)
                throw WSDL_ERROR, sprintf("missing definition for input message %y required by operation %y", msghash.name.val ?? msghash.name ?? msghash.message.val, name);
            input = msg;

            #printf("DBG: WSOperation::constructor() name: %y msghash: %y\n", name, msghash);
            if (msghash.name)
                input_name = msghash.name.val ?? msghash.name;
        }

        if (p.output) {
            NamespacePrefixHelper message_scope(nsc, p.output."^attributes^");
            hash<auto> msghash = processNSValue(p.output."^attributes^");
            string key = registry ? registry.resolve("message", p.output."^attributes^".message, nsc)
                : msghash.message.val;
            *WSMessage msg = messages{key};
            if (!msg)
                throw WSDL_ERROR, sprintf("missing definition for output message %y required by operation %y", msghash.name.val ?? msghash.name ?? msghash.message.val, name);

            output = msg;
            if (msghash.name)
                output_name = msghash.name.val ?? msghash.name;
        }

        if (input && output) {
            foreach string key in (keys p) {
                if (key == "input" || key == "output") {
                    exchange_pattern = key == "input" ? WsdlOperationPattern::RequestResponse
                        : WsdlOperationPattern::SolicitResponse;
                    break;
                }
            }
        } else if (input) {
            exchange_pattern = WsdlOperationPattern::OneWay;
        } else if (output) {
            exchange_pattern = WsdlOperationPattern::Notification;
        } else {
            throw WSDL_ERROR, sprintf("operation %Y requires an input or output message", name);
        }

        if (overloaded) {
            selection_key = getSignatureKey();
        }

        if (p.fault && (exchange_pattern == WsdlOperationPattern::OneWay
                || exchange_pattern == WsdlOperationPattern::Notification)) {
            throw WSDL_ERROR, sprintf("operation %Y with interaction pattern %Y cannot declare faults",
                name, exchange_pattern);
        }

        # issue #2804: process fault messages
        foreach hash<auto> fh in (p.fault) {
            NamespacePrefixHelper fault_scope(nsc, fh."^attributes^");
            hash<auto> msghash = processNSValue(fh."^attributes^");
            string key = registry ? registry.resolve("message", fh."^attributes^".message, nsc)
                : msghash.message.val;
            *WSMessage msg = messages{key};
            if (!msg) {
                throw WSDL_ERROR, sprintf("missing definition for fault message %y required by operation %y", msghash.name.val, name);
            }

            string fault_name = msghash.name.val ?? msghash.name;
            faults{fault_name} = msg;
            #printf("DEBUG: op %y fault %y msg %y\n", name, fault_name, msg.name);
        }

        *string op_ns = nsc.getTargetNamespaceUri();
        if (op_ns && op_ns !~ /\/$/)
            op_ns += "/";
        soapAction = op_ns ? op_ns + name : name;
    }

    private:internal deserializeMembers(hash<auto> members) {
        if (!(members.nsc instanceof Namespaces)
                || (exists members.input && !(members.input instanceof WSMessage))
                || (exists members.output && !(members.output instanceof WSMessage))) {
            throw "DESERIALIZATION-ERROR", "a WSDL operation requires its namespace context and valid messages";
        }
        # Explicit assignments promote references from older weak-member serializations.
        nsc = remove members.nsc;
        input = remove members.input;
        output = remove members.output;
        binding_keys = remove members.binding_keys ?? {};
        auto pattern = remove members.exchange_pattern;
        if (exists pattern) {
            if (pattern != WsdlOperationPattern::OneWay && pattern != WsdlOperationPattern::RequestResponse
                    && pattern != WsdlOperationPattern::SolicitResponse && pattern != WsdlOperationPattern::Notification) {
                throw "DESERIALIZATION-ERROR", "invalid WSDL operation exchange pattern";
            }
            bool expects_input = pattern != WsdlOperationPattern::Notification;
            bool expects_output = pattern != WsdlOperationPattern::OneWay;
            if (expects_input != exists input || expects_output != exists output) {
                throw "DESERIALIZATION-ERROR", "WSDL operation exchange pattern does not match its messages";
            }
        }
        exchange_pattern = pattern;
        self += members;
        pattern = getMessageExchangePattern();
        if (faults && (pattern == WsdlOperationPattern::OneWay || pattern == WsdlOperationPattern::Notification)) {
            throw "DESERIALIZATION-ERROR", "one-way and notification operations cannot declare faults";
        }
        foreach OperationalBinding binding in (bindings.iterator()) {
            validateBinding(binding, "DESERIALIZATION-ERROR");
        }
    }

    #! returns the retained abstract message exchange order
    /** @return the WSDL pattern, or NOTHING for an older standalone graph with both messages but no order metadata
        @note WebService reconstruction recovers the order from its retained WSDL source.
        @since %WSDL 0.5.8
    */
    *WsdlOperationPattern getMessageExchangePattern() {
        return exchange_pattern ?? (input && !output ? WsdlOperationPattern::OneWay
            : output && !input ? WsdlOperationPattern::Notification : NOTHING);
    }

    #! returns the effective abstract input label, including the WSDL default
    /** @return the authored or default input name, or NOTHING if no input exists
        @throw WSDL-OPERATION-ERROR a legacy standalone graph lacks the order needed to derive a default
        @note This name identifies an abstract message and does not name a SOAP RPC wrapper.
        @since %WSDL 0.5.8
    */
    *string getInputName() {
        if (!input) {
            return NOTHING;
        }
        if (exists input_name) {
            return input_name;
        }
        *WsdlOperationPattern pattern = getMessageExchangePattern();
        if (!exists pattern) {
            throw "WSDL-OPERATION-ERROR", "legacy standalone operation lacks message order; reload the WSDL "
                "to derive its default input name";
        }
        return name + (pattern == WsdlOperationPattern::OneWay ? ""
            : pattern == WsdlOperationPattern::RequestResponse ? "Request" : "Solicit");
    }

    #! returns the effective abstract output label, including the WSDL default
    /** @return the authored or default output name, or NOTHING if no output exists
        @note Both two-message patterns use the Response suffix. This label is separate from SOAP RPC wrappers.
        @since %WSDL 0.5.8
    */
    *string getOutputName() {
        if (!output) {
            return NOTHING;
        }
        return output_name ?? (name + (input ? "Response" : ""));
    }

    #! returns this operation's lookup key within its port type
    /** @return the XML operation name when unique, or name(input,output) for an overloaded operation
        @note The input/output slots contain effective labels; an absent message has an empty slot.
        @par Example
        Use service.getOperation("lookup(ById,ResultId)") to select one overloaded declaration.
        @since %WSDL 0.5.8
    */
    string getSelectionKey() {
        return selection_key ?? name;
    }

    #! returns the full abstract operation signature
    /** @return name(input,output), using effective message labels and empty slots for absent directions
        @throw WSDL-OPERATION-ERROR a legacy standalone graph lacks the order required for an input default
        @note Overloaded operations use this signature as their port-type lookup key.
        @since %WSDL 0.5.8
    */
    string getSignatureKey() {
        return name + "(" + (getInputName() ?? "") + "," + (getOutputName() ?? "") + ")";
    }

    #! tests whether this operation belongs to a concrete binding
    /** @param key a binding component key or expanded name
        @return True if this operation has the selected binding, otherwise False
        @since %WSDL 0.5.8
    */
    bool hasBinding(string key) {
        return bindings.hasKey(binding_keys{key} ?? key);
    }

    #! returns a hash of fault messages keyed by fault name
    *hash<string, WSMessage> getFaultMessages() {
        return faults;
    }

    #! returns True if the given string is a valid fault message for the operation
    bool hasFault(string fault) {
        return faults.hasKey(fault);
    }

    #! this method is called if this operation supports at least one binding with document style
    setDocStyleBinding(reference idocmap) {
        foreach string key in (keys input.args) {
            # FIXME: could be a type here instead of an element
            if (!input.args{key}.element.name) {
                return;
            }

            string element = input.args{key}.element.name;
            idocmap{element} := input.args{key}.element;
            reqh{element} = True;
        }
    }

    #! this method is called if this operation supports at least one binding with RPC style
    markRpcStyleBinding() {
        reqh{name} = True;
    }

    #! returns all top-level request names for this operation
    /** @return the existing binding names plus concrete members of document body element parts
        @note Member names are obtained from the current schema when a handler registers the operation.
        Body validation still checks the complete expanded name and selected binding.
        @since %WSDL 0.5.8
    */
    list<auto> getTopLevelRequestNames() {
        hash<string, bool> names = reqh;
        if (input) {
            foreach OperationalBinding binding in (bindings.iterator()) {
                if (!(binding instanceof SoapBinding) || !binding.docstyle || !binding.input) {
                    continue;
                }
                foreach string part in (binding.input.getBodyPartNames(input) ?? keys input.pmap) {
                    *XsdElement head = input.args{input.pmap{part}}.element;
                    if (head) {
                        foreach XsdElement member in (head.getInstanceDeclarations().iterator()) {
                            names{member.name} = True;
                        }
                    }
                }
            }
        }
        return keys names;
    }

    #! returns a hash representing the given binding
    /** @param bname a binding component key or expanded name; if omitted, uses the first assigned binding

        @return the selected operational binding

        @throw WSDL-BINDING-ERROR unknown binding
     */
    OperationalBinding getBinding(*string bname) {
        if (bindings && !exists bname) {
            return bindings.firstValue();
        }
        bname = binding_keys{bname} ?? bname;
        if (!exists bindings{bname}) {
            throw "WSDL-BINDING-ERROR", sprintf("binding %y is not a known binding for operation %y; known bindings: %y", bname, name, bindings.keys());
        }
        return bindings{bname};
    }

    #! adds the given binding
    /** @param b the binding to add; its name must be unique in this operation
        @param expanded_name optional expanded binding name in \c "{namespace}local" form

        @throw WSDL-BINDING-ERROR when binding is already registered or its interaction pattern is unsupported
     */
    addBinding(WSDL::OperationalBinding b, *string expanded_name) {
        validateBinding(b, "WSDL-BINDING-ERROR");
        string bname = b.getName();
        if (bindings.hasKey(bname) || (exists expanded_name && exists binding_keys{expanded_name})) {
            throw "WSDL-BINDING-ERROR", sprintf("binding %y is already registered in operation %y", bname, name);
        }
        bindings{bname} = b;
        if (exists expanded_name) {
            binding_keys{expanded_name} = bname;
        }
    }

    private validateBinding(OperationalBinding binding, string error) {
        *WsdlOperationPattern pattern = getMessageExchangePattern();
        if ((binding instanceof SoapBinding || binding instanceof HttpBinding)
                && (pattern == WsdlOperationPattern::Notification || pattern == WsdlOperationPattern::SolicitResponse)) {
            throw error, sprintf("standard binding %Y cannot bind operation %Y with interaction pattern %Y",
                binding.getName(), name, pattern);
        }
        if (binding instanceof SoapBinding) {
            foreach hash<auto> entry in (cast<SoapBinding>(binding).getFaultBindings().pairIterator()) {
                *WSMessage message = faults{entry.key};
                if (!message || message.pmap.size() != 1 || (entry.value.encoded && !message.args.firstValue().type)) {
                    throw error, sprintf("SOAP binding %Y fault %Y has no compatible fault message in operation %Y",
                        binding.getName(), entry.key, name);
                }
            }
        }
    }

    #! serializes a fault response to an XML string or HTTP payload for the operation.
    /** @param fault an optional fault message for the operation (@see getFaultMessages())
        @param faultmsg the fault description to include in the SOAP message
        @param h the fault data to serialize
        @param header optional soap header info to serialize if required (ex: authorization info). In the first step
        headers are matched to binding/input/header WSDL definition, remaining headers are passed as-is
        @param enc the optional encoding to use; if this argument is not present, then the default encoding will be
        used
        @param nsh an optional namespace hash for the output message
        @param xml_opts optional XML generation options
        @param req_soapaction if present will override any SOAPAction value for the request, ignored for HTTP binding
        @param bname SOAP binding name or empty to get the first assigned binding

        @throw SOAP-SERIALIZATION-ERROR an unknown or unbound fault, invalid detail, or generic fault with detail data
        @throw WSDL-BINDING-ERROR legacy standalone binding metadata cannot identify the declared fault
        @note Declared SOAP faults use their own concrete binding and document-style detail regardless of the
        operation style. Generic faults (fault = NOTHING) have no declared detail and require h = NOTHING.
        @par Example
        @code{.qore}
        hash<auto> response = operation.serializeFault("OrderRejected", "Order exceeds available stock",
            {"orderId": "PO-724", "available": 12});
        @endcode

        @return a hash with keys:
        - \c body: XML string in the SOAP response format or body part of HTTP message (string or binary). Target
          content type is evaluated from WSDL or in case of ambiguity using "^attributes^"."^content-type^". The
          provided content type must match allowed types in the WSDL. Also "application/x-www-form-urlencoded" or any
          general type are supported.
        - \c hdr: hash of HTTP headers
        - \c path: the path part of URL. Used when urlEncoded is defined
        - \c method: the HTTP request method
    */
    hash<auto> serializeFault(*string fault, string faultmsg, auto h, *hash<auto> header, *string enc,
            *hash<auto> nsh, *int xml_opts, *string req_soapaction, *string bname) {
        XsdIdentityDocumentScope identity_document();
        if (exists fault && !faults{fault}) {
            throw SOAP_SERIALIZATION_ERROR, sprintf("cannot serialize unknown fault %y for operation %y; known "
                "faults: %y", fault, name, keys faults);
        }
        OperationalBinding binding = getBinding(bname);
        if (binding instanceof SoapBinding) {
            return cast<SoapBinding>(binding).serializeFaultMessage(self, fault, faultmsg, h, header, enc,
                nsh, xml_opts, req_soapaction);
        }
        return binding.serializeMessage(self, faults{fault}, False, binding.isSoap12(), h, header, enc, nsh,
            xml_opts, req_soapaction, faultmsg);
    }

    #! serializes a request to an XML string or HTTP payload for the operation.
    /** @param h the request to serialize; SOAP accepts the explicit maps described in @ref wsdl_soap_header_deserialization
        @param header optional soap header info to serialize if required (ex: authorization info). In the first step
        headers are matched to binding/input/header WSDL definition, remaining headers are passed as-is
        @param enc the optional encoding to use; if this argument is not present, then the default encoding will be
        used
        @param nsh an optional namespace hash for the output message
        @param xml_opts optional XML generation options
        @param req_soapaction if present will override any SOAPAction value for the request, ignored for HTTP binding
        @param bname SOAP binding name or empty to get the first assigned binding
        @param http_headers optional HTTP headers supplied for serialization

        @return a hash with keys:
        - \c body: XML string in the SOAP request format or body part of HTTP message (string or binary). Target
          content type is evaluated from WSDL or in case of ambiguity using "^attributes^"."^content-type^".  The
          provided content type must match allowed types in WSDL; also "application/x-www-form-urlencoded" or any
          general type are supported.
        - \c hdr: hash of HTTP headers
        - \c path: the path part of URL. Used when urlEncoded is defined
        - \c method: the HTTP request method

        @throw SOAP-SERIALIZATION-ERROR no input description, missing selected part, malformed explicit maps or conflicting header sources
    */
    hash<auto> serializeRequest(auto h, *hash<auto> header, *string enc, *hash<auto> nsh, *int xml_opts, *string req_soapaction, *string bname, *hash<auto> http_headers) {
        XsdIdentityDocumentScope identity_document();
        @assert(nsc, "namespace container must be initialized");
        OperationalBinding binding = getBinding(bname);
        return binding.serializeMessage(self, input, True, binding.isSoap12(), h, header, enc, nsh, xml_opts,
            req_soapaction, NOTHING, http_headers);
    }

    #! serializes a SOAP response to an XML string for the operation
    /** @param h the response to serialize; SOAP accepts the explicit maps described in @ref wsdl_soap_header_deserialization
        @param header SOAP header hash. In the first step headers are matched to binding/input/header WSDL definition,
        remaining headers are passed as-is
        @param enc the optional encoding to use; if this argument is not present, then the default encoding will be
        used
        @param nsh namespace hash
        @param soap12 explicit legacy response-version override; if omitted, use the selected binding's version
        @note The explicit override retains its existing namespace-declaration availability check.
        It does not establish that the selected WSDL binding supports the overridden protocol.
        @param xml_opts optional XML generation options
        @param bname SOAP binding name, leave empty to get the first assigned binding
        @param http_headers HTTP headers to serialize in the response

        @return a hash with keys:
        - \c body: XML string in the SOAP request format or body part of HTTP message (string or binary). Target
          content type is evaluated from WSDL or in case of ambiguity using "^attributes^"."^content-type^".  The
          provided content type must match allowed types in WSDL; also "application/x-www-form-urlencoded" or any
          general type are supported.
        - \c hdr: hash of HTTP headers

        @throw SOAP-SERIALIZATION-ERROR no output description, missing selected part, malformed explicit maps or conflicting header sources
    */
    hash<auto> serializeResponse(auto h, *hash<auto> header, *string enc, *hash<auto> nsh, *bool soap12, *int xml_opts, *string bname, *hash<auto> http_headers) {
        XsdIdentityDocumentScope identity_document();
        @assert(nsc, "namespace container must be initialized");
        OperationalBinding binding = getBinding(bname);
        if (exists soap12) {
            # Preserve the explicit response override used by legacy SoapHandler consumers.
            if (!(soap12 ? nsc.hasSoap12() : nsc.hasSoap11())) {
                throw SOAP_SERIALIZATION_ERROR, sprintf("cannot serialize response for operation %Y with SOAP %s; "
                    "this WSDL does not declare that SOAP version", name, soap12 ? "1.2" : "1.1");
            }
        } else {
            soap12 = binding.isSoap12();
        }
        return binding.serializeMessage(self, output, False, soap12, h, header, enc, nsh, xml_opts,
            NOTHING, NOTHING, http_headers);
    }

    #! parses a hash representing a parsed XML request (parsed with @ref Qore::Xml::parse_xml "parse_xml(XPF_PRESERVE_ORDER | XPF_PRESERVE_WHITESPACE)") for the operation and returns the corresponding Qore data structure
    /** @param o the parsed SOAP or HTTP request with @ref WSDLLib::parseSOAPMessage() for the operation
        @param bname SOAP binding name, leave empty to use the first assigned binding
        @param preserve_types True to retain nonidentical selected types as portable native wrappers;
        False preserves the established return shapes
        @return the Qore data structure corresponding to the request data; see @ref wsdl_soap_header_deserialization
        for the body/header merge rules. HTTP bindings match the content type against the WSDL binding, including
        wildcards, and apply the current value to \c "^attributes^"."^content-type^".
        @throw SOAP-DESERIALIZATION-ERROR invalid message, type selection or content
        @note A retained type uses XsdQNameValue in \c ^type^ and its native value in \c ^val^;
        output resolves that QName in its own schema and repeats all compatibility and content checks.
        When headers accompany a selected root type, the body retains its part-name key to keep the wrapper intact;
        if that key collides with a header message name, it is nested inside the body message container.
        @par Example
        Retain a shipment part subtype before storing and later forwarding a decoded message.
    */
    auto deserializeRequest(hash<auto> o, *string bname, bool preserve_types = False) {
        XsdIdentityDocumentScope identity_document();
        XsdNativeTypeValueScope type_scope(preserve_types);
        return getBinding(bname).deserializeMessage(self, o, True);
    }

    #! parses a hash representing a parsed XML response (parsed with @ref Qore::Xml::parse_xml "parse_xml(XPF_PRESERVE_ORDER | XPF_PRESERVE_WHITESPACE)") for the operation and returns the corresponding Qore data structure
    /** @param o the parsed SOAP or HTTP request with @ref WSDLLib::parseSOAPMessage() for the operation
        @param bname SOAP binding name, leave empty to use the first assigned binding
        @param preserve_types True to retain nonidentical selected types as portable native wrappers;
        False preserves the established return shapes
        @return the Qore data structure corresponding to the response data; see @ref wsdl_soap_header_deserialization
        for the body/header merge rules. HTTP bindings match the content type against the WSDL binding, including
        wildcards, and apply the current value to \c "^attributes^"."^content-type^".
        @throw SOAP-DESERIALIZATION-ERROR invalid message, type selection or content
        @note A retained type uses XsdQNameValue in \c ^type^ and its native value in \c ^val^;
        output resolves that QName in its own schema and repeats all compatibility and content checks.
        When headers accompany a selected root type, the body retains its part-name key to keep the wrapper intact;
        if that key collides with a header message name, it is nested inside the body message container.
        @par Example
        Retain a shipment part subtype before storing and later forwarding a decoded message.
    */
    auto deserializeResponse(hash<auto> o, *string bname, bool preserve_types = False) {
        XsdIdentityDocumentScope identity_document();
        XsdNativeTypeValueScope type_scope(preserve_types);
        return getBinding(bname).deserializeMessage(self, o, False);
    }

    #! decodes a SOAP request into explicitly retained XML parts
    /** @param xml the complete SOAP envelope, before conversion to a native hash
        @param bname the binding name, or NOTHING for the first assigned binding
        @return body and header XML values keyed by their WSDL part and message identities
        @throw SOAP-DESERIALIZATION-ERROR an invalid request or payload
        @throw WSDL-BINDING-ERROR the binding does not use element-based literal SOAP parts
        @par Example
        @code{.py}
        hash<SoapXmlMessageInfo> request = operation.deserializeXmlRequest(incoming_xml, "StockSoap");
        string original_quantity = request.body.order.getElementData().quantity;
        @endcode
    */
    hash<SoapXmlMessageInfo> deserializeXmlRequest(string xml, *string bname) {
        XsdIdentityDocumentScope identity_document();
        return getSoapBinding(bname).deserializeXmlMessage(self, xml, True);
    }

    #! decodes a SOAP response into explicitly retained XML parts
    /** @param xml the complete SOAP envelope, before conversion to a native hash
        @param bname the binding name, or NOTHING for the first assigned binding
        @return body and header XML values keyed by their WSDL part and message identities
        @throw SOAP-DESERIALIZATION-ERROR an invalid response or payload
        @throw SOAP-SERVER-FAULT-RESPONSE a SOAP fault was received
        @throw WSDL-BINDING-ERROR the binding does not use element-based literal SOAP parts
        @see deserializeXmlRequest()
    */
    hash<SoapXmlMessageInfo> deserializeXmlResponse(string xml, *string bname) {
        XsdIdentityDocumentScope identity_document();
        return getSoapBinding(bname).deserializeXmlMessage(self, xml, False);
    }

    private SoapBinding getSoapBinding(*string bname) {
        OperationalBinding binding = getBinding(bname);
        if (!(binding instanceof SoapBinding)) {
            throw "WSDL-BINDING-ERROR", "this operation requires a SOAP binding";
        }
        return binding;
    }

    /** Operation is resolved from method and path so let's look if data are passed in URL.
        When URL replacement is defined for operation then exception is raised.
        @return NOTHING if data are not encoded in URL for operation
    */
    *hash<auto> deserializeRequestPath(string path, *string bname) {
        return getBinding(bname).deserializeRequestPath(self, path);
    }

    #! decodes a declared application's SOAP fault detail
    /** @param xml the complete SOAP fault envelope
        @param fault the declared WSDL fault name
        @param bname binding name, or NOTHING for the first assigned binding
        @param preserve_types True retains selected native schema type/element wrappers
        @return the schema-validated value of the fault message's single part
        @throw WSDL-BINDING-ERROR unknown/unbound fault, missing metadata or non-SOAP binding
        @throw SOAP-DESERIALIZATION-ERROR malformed envelope, detail or schema value
        @note Ordinary response decoding still raises SOAP-SERVER-FAULT-RESPONSE with its raw fault data.
        The explicit name selects a concrete WSDL fault; codes and reason strings do not select schemas.
        @par Example
        @code{.qore}
        auto rejection = operation.deserializeFault(call_info."response-body", "OrderRejected");
        @endcode
    */
    auto deserializeFault(string xml, string fault, *string bname, bool preserve_types = False) {
        XsdIdentityDocumentScope identity_document();
        XsdNativeTypeValueScope type_scope(preserve_types);
        return getSoapBinding(bname).deserializeFaultMessage(self, xml, fault);
    }

    #! retains a declared literal SOAP fault detail element after schema validation
    /** @param xml the complete SOAP fault envelope
        @param fault the declared WSDL fault name
        @param bname binding name, or NOTHING for the first assigned binding
        @return the literal element with its lexical content and namespace context
        @throw WSDL-BINDING-ERROR unknown/unbound fault or a nonliteral/non-element representation
        @throw SOAP-DESERIALIZATION-ERROR malformed envelope, detail or schema value
        @par Example
        Pass operation.deserializeXmlFault(xml, "OrderRejected") to serializeFault() to forward the detail.
    */
    XsdXmlValue deserializeXmlFault(string xml, string fault, *string bname) {
        XsdIdentityDocumentScope identity_document();
        return getSoapBinding(bname).deserializeFaultMessage(self, xml, fault, True);
    }

    #! serializes a declared header-processing fault
    /** @param info the headerfault message, part, typed value and source direction
        @param reason the human-readable fault reason
        @param bname binding name, or NOTHING for the first assigned binding
        @param enc XML output encoding
        @return the SOAP transport message, with fault data in Header and a generic Fault in Body
        @throw WSDL-BINDING-ERROR unknown/ambiguous headerfault or a non-SOAP binding
        @throw SOAP-SERIALIZATION-ERROR invalid headerfault value
        @par Example
        @code{.qore}
        hash<auto> response = operation.serializeHeaderFault(<SoapHeaderFaultInfo>{
            "message": "{urn:session}SessionExpired", "part": "problem", "value": 401}, "Session expired");
        @endcode
    */
    hash<auto> serializeHeaderFault(hash<SoapHeaderFaultInfo> info, string reason, *string bname,
            string enc = "UTF-8") {
        XsdIdentityDocumentScope identity_document();
        return getSoapBinding(bname).serializeHeaderFaultMessage(self, info, reason, enc);
    }

    #! decodes a selected headerfault block from a SOAP fault envelope
    /** @param xml the complete SOAP fault envelope
        @param message local or namespace-expanded WSDL headerfault message name
        @param part WSDL headerfault part name
        @param bname binding name, or NOTHING for the first assigned binding
        @param request_header True selects input headerfaults, False selects output headerfaults
        @param preserve_types True retains selected native type wrappers; False uses ordinary native values
        @return the schema-validated native value of the selected headerfault part
        @throw WSDL-BINDING-ERROR unknown/ambiguous declaration or non-SOAP binding
        @throw SOAP-DESERIALIZATION-ERROR invalid envelope, missing/repeated block or invalid schema value
        @note Ordinary response decoding retains its SOAP-SERVER-FAULT-RESPONSE exception contract.
        This explicit method selects typed header error data from the retained response XML.
        @par Example
        @code{.qore}
        auto problem = operation.deserializeHeaderFault(call_info."response-body",
            "{urn:session}SessionExpired", "problem");
        @endcode
    */
    auto deserializeHeaderFault(string xml, string message, string part, *string bname,
            bool request_header = True, bool preserve_types = False) {
        XsdIdentityDocumentScope identity_document();
        XsdNativeTypeValueScope type_scope(preserve_types);
        return getSoapBinding(bname).deserializeHeaderFaultMessage(xml, message, part, request_header);
    }

    #! retains the selected literal headerfault block as XML after schema validation
    /** @param xml the complete SOAP fault envelope
        @param message local or expanded WSDL headerfault message name
        @param part WSDL headerfault part name
        @param bname binding name, or NOTHING for the first assigned binding
        @param request_header True selects input headerfaults, False selects output headerfaults
        @return the selected literal element preserving lexical values and namespace context
        @throw WSDL-BINDING-ERROR unknown/ambiguous declaration, non-SOAP binding or nonliteral/non-element part
        @throw SOAP-DESERIALIZATION-ERROR invalid envelope, missing/repeated block or invalid schema value
        @par Example
        Forward an exact partner error payload by assigning the returned XsdXmlValue to SoapHeaderFaultInfo.value.
    */
    XsdXmlValue deserializeXmlHeaderFault(string xml, string message, string part, *string bname,
            bool request_header = True) {
        XsdIdentityDocumentScope identity_document();
        return getSoapBinding(bname).deserializeHeaderFaultMessage(xml, message, part, request_header, True);
    }

    #! expands QName attribute values into local-name and prefix records
    static private hash<auto> processNSValue(hash<auto> h) {
        hash<auto> result();
        foreach string k in (keys h) {
            (*string ns, *string name) = h{k} =~ x/([^:]+):([^:]+)/;
            # Parsed XML and typed public-constructor hashes must behave identically.
            # Replacing scalar entries in the original typed hash cannot preserve its value type.
            result{k} = name ? {"ns":ns, "val":name} : {"val":h{k}};
        }
        return result;
    }

    #! returns True if the selected binding uses SOAP 1.2
    /** @param bname binding name, or NOTHING for the first assigned binding
        @return True for SOAP 1.2, False for SOAP 1.1 or HTTP
        @throw WSDL-BINDING-ERROR unknown binding or a legacy binding without version metadata
        @par Example
        When a shipping service exposes ShippingSoap and ShippingSoap12, inspect the intended endpoint
        with operation.isSoap12("ShippingSoap12") and pass that same binding name to serializeRequest().
    */
    bool isSoap12(*string bname) {
        return getBinding(bname).isSoap12();
    }

    #! returns the target namespace for the operation
    /** @return the target namespace for the operation
    */
    string getTargetNS() {
        return nsc.getTargetNamespaceUri();
    }
}

#! message argument hash description
public hashdecl ArgInfo {
    #! the arg name
    string name;

    #! unique part name
    string part;

    #! type for the argument
    XsdAbstractType type;

    #! element for the argument
    XsdElement element;
}

#! web service message class
/** Message parts retain distinct part names for binding selection and provider fields. Element-based parts
    resolve their QNames in the enclosing XML scope. Unambiguous element arguments keep local aliases;
    collisions use expanded names. XML output always uses the element declaration's own name and namespace.
    Messages own their namespace context and part definitions independently of the source service.
    Zero-part messages expose empty argument/part maps and an empty provider record.
*/
public class WSMessage inherits WSDL::XsdNamedData {
    public {
        #! Argument keys are part names for type parts and local or expanded names for element parts
        /** Unambiguous element names keep their local aliases; names colliding with another element or
            type-part name use expanded names. Use pmap to look up an argument by its WSDL part name.
        */
        hash<string, hash<WSDL::ArgInfo>> args();

        #! maps part names to args key, all parts are in hash
        hash<string, string> pmap();

        #! type map
        hash<string, XsdAbstractType> tmap;

        # Owned namespace context, including empty messages without schema types.
        Namespaces nsc;
    }

    constructor(hash<auto> m, hash<string, hash<string, XsdElement>> emap, hash<string, XsdAbstractType> tmap, Namespaces nsc) : XsdNamedData(\m) {
        self.tmap = tmap;
        self.nsc = nsc;

        NamespacePrefixHelper message_scope(nsc, m."^attributes^");
        name = m."^attributes^".name;
        hash<string, hash<ArgInfo>> parts();
        hash<string, int> local_names();
        hash<string, bool> element_names();
        foreach auto p in (m.part) {
            *hash<auto> part = p."^attributes^";
            NamespacePrefixHelper part_scope(nsc, part);
            if (!exists part.name) {
                throw WSDL_ERROR, sprintf("missing part name in message %Y", name);
            }
            if (parts.hasKey(part.name)) {
                throw WSDL_ERROR, sprintf("duplicate part name %Y in message %Y", part.name, name);
            }
            hash<ArgInfo> arg = <ArgInfo>{"name": part.name, "part": part.name};
            if (part.element) {
                hash<auto> identity = nsc.getTypeHash(part.element);
                arg.element = emap_get(emap, identity.uri, identity.val);
                string expanded = arg.element.getExpandedName();
                if (element_names{expanded}) {
                    throw WSDL_ERROR, sprintf("ambiguous element %Y in message %Y", expanded, name);
                }
                element_names{expanded} = True;
                ++local_names{arg.element.name};
            } else {
                hash<auto> type_info;
                if (!nsc.doType(part.type, \type_info, \arg.type, tmap)) {
                    throw WSDL_ERROR, sprintf("cannot resolve type %Y for part %Y in message %Y", part.type,
                        part.name, name);
                }
                ++local_names{part.name};
            }
            parts{part.name} = arg;
        }
        foreach string part in (keys parts) {
            hash<ArgInfo> arg = parts{part};
            string key = arg.element ? (local_names{arg.element.name} == 1 ? arg.element.name
                : arg.element.getExpandedName()) : part;
            @assert(!args.hasKey(key));
            args{key} = arg;
            pmap{part} = key;
        }
    }

    private:internal deserializeMembers(hash<auto> members) {
        if (!(members.nsc instanceof Namespaces)) {
            throw "DESERIALIZATION-ERROR", "a WSDL message requires its namespace context";
        }
        nsc = remove members.nsc;
        # Old zero-part messages saved NOTHING instead of initialized empty maps.
        args = (remove members.args) ?? {};
        pmap = (remove members.pmap) ?? {};
        self += members;
    }

    #! returns the namespace-expanded identity of this WSDL message
    /** @return the message identity in `{namespace-uri}local-name` form
        @par Example
        Imported messages named Session are distinguished by identities such as `{urn:billing}Session`.
    */
    string getExpandedName() {
        return type_qname(nsc.getTargetNamespaceUri() ?? "", name);
    }

    #! returns native fields with schema instance checks for the message parts
    /** @param preserve_types True to accept native selected-type wrappers, with declared and wrapper metadata;
        False retains the ordinary native field types
        @return a HashDataType-compatible provider keyed by WSDL part name
        @note Explicit field projections can omit parts; supplied retained fields still satisfy their schema.
        @since %WSDL 0.5.8
    */
    AbstractDataProviderType getDataProviderType(bool preserve_types = False) {
        return new XsdMessageDataType(self, preserve_types);
    }

    /**
        Serializes a message part and returns its output namespace.
        @param part the WSDL part name
        @param encoded whether SOAP encoding is used
        @param h input values; the serialized value is removed from this hash
        @param ons receives the output namespace prefix
    */
    auto serializeRpcValue(string part, bool encoded, reference<hash<auto>> h, reference<string> ons) {
        Namespaces output_namespaces = QNameOutputNamespaces ?? nsc;
        XsdNativeTypeOutputScope type_scope(tmap);
        string key = pmap{part};
        auto v = getValueFromHash(key, \h, True);
        if (!exists v) {
            if (key || args.size() == 1) {
                v = getValueFromHash(args{key}.element, \h, True);
            }
            if (!exists v)
                return;
        }
        if (v.typeCode() == NT_NULL)
            delete v;

        auto hv;
        #printf("DEBUG: part: %y, key: %y, with %y\n", part, key, args{key});
        #printf("DEBUG: serializeRpcValue, part: %y, key: %y, val: %y\n", part, key, v."^val^" ?? v);
        if (args{key}.element) {
            hv = args{key}.element.serializeValue(output_namespaces, v, !encoded, key, name);
            ons = output_namespaces.getOutputNamespacePrefix(args{key}.element.ns);
        } else {
            hv = XsdDocumentValueHelper::serializePartValue(args{key}.type, output_namespaces, v, !encoded);
            ons = args{key}.type.getOutputNamespacePrefix();
        }
        #printf("DEBUG: arg %s got %y from %y (%y)\n", part, hv, v, exists args{key}.element ? args{key}.element : args{key}.type);
        return hv;
    }

    #! serializes data into a hash with SOAP namespaces etc. with RPC-style messages
    /**
        @param parts if present then serializes only particular element or part, if NOTHING then serializes all message elements
        @param msginfo a description of the message for the current binding, if available
        @param mpm optional multipart message receiving attachments
        @param n_name name of output key
        @param encoded if the encoded use module should be used (or the literal use model)
        @param h data to be serialized, keys are wsdl element names (or optionally the part name) and part names for simple types
        @param fault @ref True if serializing a fault response
     */
    *hash<auto> serializeRpc(*softlist<auto> parts, *WSDL::BindingMessageDescription msginfo, *MultiPartRelatedMessage mpm, string n_name, bool encoded, reference<auto> h, bool fault) {
        Namespaces output_namespaces = QNameOutputNamespaces ?? nsc;
        hash<auto> rh;
        #printf("DEBUG: message %s: parts: %y, pmap: %y, h: %y\n", name , parts, pmap, ,h);
        foreach string part in (parts ?? keys pmap) {
            string ons;
            auto hv = serializeRpcValue(part, encoded, \h, \ons);
            if (!exists hv) {
                if (msginfo && !encoded && !mpm) {
                    throw SOAP_SERIALIZATION_ERROR, sprintf("missing selected SOAP body part %Y in message %Y", part, name);
                }
                continue;
            }
            string k = pmap{part};
            # Handle multipart attachments - if this part is defined as a multipart content part
            if (mpm && msginfo.parts{k}) {
                auto partContentType = msginfo.parts{k};
                if (partContentType.typeCode() == NT_LIST) {
                    partContentType = shift partContentType;
                }
                mpm.addPart(hv, sprintf("<%s>", k), partContentType);
                hv = {"^attributes^": {"href": "cid:" + k}};
            }
            rh{args{k}.element ? args{k}.element.getXmlName(output_namespaces) : k} = hv;
        }

        if (rh || !fault) {
            if (encoded) {
                rh."^attributes^" += {
                    "soapenv:encodingStyle": SOAP_ENCODING,
                };
            }

            # issue #2804: do not wrap the fault data with the request name
            if (fault) {
                return rh;
            }

            *string wrapper_uri = msginfo.body.ns ?? output_namespaces.getTargetNamespaceUri();
            string wrapper = wrapper_uri ? output_namespaces.getOutputNamespacePrefix(wrapper_uri) + ":" + n_name
                : n_name;
            return {wrapper: rh ?? {}};
        }
    }

    #! serializes data into a hash with SOAP namespaces etc. with document-style messages
    /**
        @param parts if present then serializes only particular element or part, if NOTHING then serializes all message elements
        @param msginfo a description of the message for the current binding, if available
        @param mpm a multipart message object, for future use
        @param encoded if the encoded use module should be used (or the literal use model)
        @param h data to be serialized, keys are wsdl element names (optionally part name is also possible) and part names for simple types
        @param fault @ref True if serializing a fault response
        @note A single selected part accepts unwrapped record fields, including nested choices and
        explicit element wildcards. Explicit values for other parts and declared headers remain available.
        Multiple selected parts require part or element wrappers to identify ownership.
     */
    *hash<auto> serializeDocument(*softlist<auto> parts, *WSDL::BindingMessageDescription msginfo, *MultiPartRelatedMessage mpm, bool encoded, reference<auto> h, bool fault) {
        Namespaces output_namespaces = QNameOutputNamespaces ?? nsc;
        XsdNativeTypeOutputScope type_scope(tmap);
        hash<auto> rh;
        *hash<string, string> xml_attributes;
        list<string> emitted_parts();
        list<string> emitted_names();

        #printf("DEBUG: WSMessage::serializeDocument() parts: %y h: %y args: %y, pmap: %y\n", parts, h.typeCode()==NT_HASH ?  h.keys() : h, args.keys(), pmap);

        if (h instanceof XsdXmlValue) {
            list<string> selected = map $1, (parts ?? keys pmap);
            if (selected.size() != 1) {
                throw SOAP_SERIALIZATION_ERROR, "a bare retained XML value requires exactly one selected message part";
            }
            h = {pmap{selected[0]}: h};
        }

        if (args.size() == 1) {
            string fk = args.firstKey();
            if (!exists parts) {
                /*
                for backwards compatibility with a single argument, just when parts is NOTHING which is used for body
                serialization when is no explicit part name.
                */
                if (h.typeCode() != NT_HASH) {
                    h  = (fk: h);
                } else {
                    # it is ambiguous so do not do any heuristic
                }
            }
        }
        foreach string p in (parts ?? keys pmap) {
            string k = pmap{p};
            auto val = getValueFromHash(k, \h, True);
            if (!exists val) {
                if ((parts ? parts.lsize() : args.size()) == 1) {
                    # A bare record belongs to one selected part. Preserve explicit values for other
                    # parts and headers so a wildcard cannot consume their wrappers as child elements.
                    hash<string, bool> reserved = {name: True};
                    foreach string other in (keys pmap) {
                        if (other != p) {
                            reserved{other} = reserved{pmap{other}} = True;
                        }
                    }
                    if (msginfo) {
                        foreach BindingMessageHeaderDescription hdr in (msginfo.getHeaders()) {
                            reserved{hdr.msg.name} = reserved{hdr.part} = reserved{hdr.msg.pmap{hdr.part}} = True;
                        }
                        foreach string field in (msginfo.getHeaderMessageKeys(self).iterator()) {
                            reserved{field} = True;
                        }
                    }
                    if (h.typeCode() == NT_HASH && h.hasKey(name)) {
                        val = getValueFromHash(args{k}.element, \h{name}, True, reserved);
                        if (exists val && !h{name}) {
                            remove h{name};
                        }
                    }
                    if (!exists val) {
                        val = getValueFromHash(args{k}.element, \h, True, reserved);
                    }
                }
                if (!exists val) continue;
            }
            if (val.typeCode() == NT_NULL)
                val = NOTHING;
            if (val.typeCode() == NT_HASH)
                XsdBase::removeNS2(\val);
            #printf("DEBUG: k: %y val: %y, args: %y\n", k, val, keys args);
            hash<auto> arg = args{k};
            if (val instanceof XsdXmlValue) {
                if (!arg.element || encoded || (mpm && msginfo.parts{k})) {
                    throw SOAP_SERIALIZATION_ERROR,
                        "retained XML values require an element-based literal SOAP part";
                }
                XsdSoapXmlHelper::validate(val, SOAP_SERIALIZATION_ERROR);
                auto native = arg.element.validateXmlValue(val, output_namespaces, tmap);
                XsdSoapXmlHelper::mergeContext(\xml_attributes, cast<XsdXmlValue>(val).getInheritedXmlAttributes());
                # Headers are serialized in separate calls and merged, so the marker must include
                # both message and part identity rather than a per-call numeric index.
                rh{sprintf("^xml^%d:%s:%s", getExpandedName().length(), getExpandedName(), p)} = XsdQNameOutputScope::retains(output_namespaces)
                    ? new XsdQNameXmlFragment(cast<XsdXmlValue>(val), native) : cast<XsdXmlValue>(val).getXml();
                push emitted_parts, p;
                push emitted_names, cast<XsdXmlValue>(val).getExpandedName();
                continue;
            }
            # Handle multipart attachments - if this part is defined as a multipart content part
            if (mpm && msginfo.parts{k}) {
                auto partContentType = msginfo.parts{k};
                if (partContentType.typeCode() == NT_LIST) {
                    partContentType = shift partContentType;
                }
                mpm.addPart(val, sprintf("<%s>", k), partContentType);
                # For document style with element parts, use element name with namespace
                if (arg.element) {
                    rh{arg.element.getXmlName(output_namespaces)} = {"^attributes^": {"href": "cid:" + k}};
                } else {
                    rh{p} = {"^attributes^": {"href": "cid:" + k}};
                }
            } else if (arg.element) {
                XsdElement selected = XsdElementValueHelper::select(arg.element, \val);
                auto th = selected.serializeValue(output_namespaces, val, !encoded, k, name);
                string wire_name = selected.getXmlName(output_namespaces);
                if (rh.hasKey(wire_name)) {
                    throw SOAP_SERIALIZATION_ERROR, sprintf("multiple message parts select element %Y", wire_name);
                }
                rh{wire_name} = th;
                push emitted_parts, p;
                push emitted_names, selected.getExpandedName();
            } else {
                auto th = XsdDocumentValueHelper::serializePartValue(arg.type, output_namespaces, val, !encoded);
                rh{p} = th;
                push emitted_parts, p;
                push emitted_names, type_qname("", p);
            }
        }

        if (!encoded && !mpm) {
            try {
                matchDocumentParts(msginfo ? (parts ?? keys pmap) : emitted_parts, emitted_names);
            } catch (hash<ExceptionInfo> error) {
                if (error.err == SOAP_DESERIALIZATION_ERROR) {
                    rethrow SOAP_SERIALIZATION_ERROR, error.desc, error.arg;
                }
                rethrow;
            }
        }

        if (xml_attributes) {
            rh."^attributes^" += xml_attributes;
        }
        if (encoded && rh) {
            rh."^attributes^" += {
                "soapenv:encodingStyle": SOAP_ENCODING,
            };
        }

        #printf("DEBUG: message %s: pmap: %y rh: %y\n", name, pmap, rh);

        return rh;
    }

    #! deserialize RPC message
    /**
    @param mrh optional SOAP multi-reference lookup hash
    @param val keys are element names or part names for simple types
    @param part selected part names; NOTHING selects every part, an empty list selects none
    @param ignore_unknown True to ignore unselected fields; by default this is True only when part is supplied
    @throw SOAP-DESERIALIZATION-ERROR invalid values or unexpected fields when strict selection is requested
    @throw WSDL-ERROR a selected part is unknown or repeated
    @return converted values keyed by WSDL part name
    @note A string still selects one part. SOAP bindings explicitly request strict selection.
    @par Example
    Decode only a partner's acknowledged item count with
    message.deserializeRpc(NOTHING, {"accepted": 17}, ("accepted",), False).
    */
    *hash<auto> deserializeRpc(*hash<auto> mrh, hash<auto> val, *softlist<string> part, *bool ignore_unknown) {
        #printf("DBG WSMessage::deserializeRpc() pmap: %y part: %y val: %y\n", pmap, part, val);
        hash<auto> ro();

        foreach string p in (part ?? keys pmap) {
            if (!pmap.hasKey(p) || ro.hasKey(p)) {
                throw WSDL_ERROR, sprintf("unknown or repeated RPC part %Y in message %Y", p, name);
            }
            string k = getSerializedKey(p);
            bool present = val.hasKey(k);
            auto v = remove val{k};
            hash<auto> arg = args{k};
            #printf("DBG WSMessage::deserializeRpc() part: %y, key: %y, val: %y\n", p, k, v);
            if (v.typeCode() == NT_HASH) {
                XsdBase::removeNS2(\v);
            }
            if (arg.element) {
                ro{p} = arg.element.deserializeValue(tmap, mrh, getValue(mrh, v), present);
            } else {
                ro{p} = XsdDocumentValueHelper::deserializeValue(arg.type, name, tmap, mrh, getValue(mrh, v), True);
            }
        }

        # issue #2902: ignore XML attributes
        remove val."^attributes^";
        if (val && !(ignore_unknown ?? exists part)) {
            throw SOAP_DESERIALIZATION_ERROR, sprintf("additional keys %y included in %y message hash", val.keys(), name);
        }

        # if there is only one argument, return it directly
        return ro;
    }

    #! deserializes the given message parts from a document-style message
    /** @param mrh any multiRef hash for the message
        @param val the message data
        @param parts the names of the parts to deserialize; if not present, then all parts of the message are
        deserialized
        @param ignore_unknown if @ref True "True", then keys in \a val that do not correspond to a part being
        deserialized are ignored; if not present, then unknown keys are ignored only if \a parts is given, for
        backwards compatibility with SOAP header deserialization
        @param expanded_names True when element names have been resolved by XsdBase::expandElementNamespaces();
        matching then requires the declared namespace and local name without the legacy single-argument inference

        @return a hash of deserialized part values keyed by part name
    */
    *hash<auto> deserializeDocument(*hash<auto> mrh, auto val, *softlist<string> parts, *bool ignore_unknown,
            bool expanded_names = False) {
        hash<auto> rh();

        *hash<auto> attr = remove val."^attributes^";

        if (expanded_names) {
            list<string> identities();
            list<auto> values();
            foreach string key in (keys val) {
                string identity = key;
                identity =~ s/\^[0-9]+$//;
                list<auto> occurrences = val{key}.typeCode() == NT_LIST ? val{key} : (val{key},);
                foreach auto occurrence in (occurrences) {
                    push identities, identity;
                    push values, occurrence;
                }
            }
            hash<string, int> assigned = matchDocumentParts(parts ?? keys pmap, identities,
                ignore_unknown ?? exists parts);
            foreach hash<string, auto> entry in (assigned.pairIterator()) {
                string part = entry.key;
                int index = entry.value;
                hash<ArgInfo> arg = args{pmap{part}};
                auto value = values[index];
                if (value.typeCode() == NT_HASH) {
                    XsdBase::removeNS2(\value);
                }
                if (arg.element) {
                    XsdElement selected = arg.element.getInstanceDeclaration(identities[index]);
                    rh{part} = XsdElementValueHelper::retain(arg.element, selected,
                        selected.deserializeValue(tmap, mrh, getValue(mrh, value), True));
                } else {
                    rh{part} = XsdDocumentValueHelper::deserializeValue(arg.type, name, tmap, mrh,
                        getValue(mrh, value), True);
                }
            }
            return rh;
        }

        #printf("DBG WSMessage::deserializeDocument() pmap: %y val: %y\n", pmap, val);
        if (!expanded_names && args.size() == 1) {
            string k = getSerializedKey(pmap.firstKey());
            if (val.typeCode() != NT_HASH || !val.hasKey(k)) {
                auto v = val;
                val = hash();
                val{k} = v;
            }
        }

        foreach string p in (parts ?? keys pmap) {
            string k = expanded_names ? getExpandedSerializedKey(p) : getSerializedKey(p);
            bool present = val.hasKey(k);
            auto v = remove val{k};
            #printf("DBG WSMessage::deserializeDocument() part: %y, key: %y, val: %y\n", p, k, v);
            if (v.typeCode() == NT_HASH) {
                XsdBase::removeNS2(\v);
            }
            hash<auto> arg = args{pmap{p}};
            if (arg.element) {
                rh{p} = arg.element.deserializeValue(tmap, mrh, getValue(mrh, v), present);
            } else {
                rh{p} = XsdDocumentValueHelper::deserializeValue(arg.type, name, tmap, mrh, getValue(mrh, v), True);
            }
        }

        if (val && !(ignore_unknown ?? exists parts))
            throw SOAP_DESERIALIZATION_ERROR, sprintf("additional keys %y included in %y message hash", val.keys(), name);

        #printf("DBG WSMessage::deserializeDocument() args: %y val: %y\nRH: %y\n", args.keys(), val, rh);
        return rh;
    }

    #! serialize all values as string or binary
    /**
        @return hash of all parts in key-value pair
    */
    hash<auto> serializeAllPartData(*hash<auto> val) {
        return map {$1: serializeData(nsc, $1, val).value}, keys args;
    }

    #! serialized value of particular type value as string or binary
    /**
        @param val value to be resolved
        @param key member name referencing a simple type
        @param nsc namespaces for the output value

        @return as hash with 'value' and optional 'content-type' key passed from v.content-type if exists
     */
    hash<auto> serializeData(Namespaces nsc, string key, *hash<auto> val) {
        XsdNativeTypeOutputScope type_scope(tmap);
        if (args{key}.element) {
            throw SOAP_SERIALIZATION_ERROR, sprintf("cannot get element value %y in message %y. Type part is needed", key, name);
        }
        auto v = getValueFromHash(key, \val, False);
        if (v.typeCode() == NT_NULL)
            v = NOTHING;
        hash<auto> rv.value = XsdDocumentValueHelper::serializePartValue(args{key}.type, nsc, v, False){"^value^"};
        if (v.typeCode() == NT_HASH) {
            rv."content-type" = v."^attributes^"."^content-type^";
        }
        return rv;
    }

    #! deserialize value in string or binary form
    /**
        @return hash<auto> in key-value pair
    */
    hash<auto> deserializeData(string part, hash<auto> val) {
        hash<auto> rv;
        hash<auto> arg = args{pmap{part}};
        rv{part} = arg.element
            ? arg.element.deserializeValue(tmap, NOTHING, val{pmap{part}}, val.hasKey(pmap{part}))
            : XsdDocumentValueHelper::deserializeValue(arg.type, name, tmap, NOTHING, val{pmap{part}}, True);
        return rv;
    }

    #! deserialize all values in string or binary form
    /**
        @return hash of all parts in key-value pair
    */
    hash<auto> deserializeAllPartData(hash<auto> val) {
        hash<auto> rv = {};
        #printf("deserializeAllPartData: pmap: %y, val: %y\n", pmap, val);
        foreach string p in (keys pmap) {
            rv += deserializeData(p, val);
        }
        return rv;
    }

    #! find part in value, remove that value from the hash
    /**
        @param ename element/type name
        @param v reference to hash, supposed structure is [msgname.](partname|elemname) = value to support more message data in one hash
        @param removeFound if True found values are removed from the hash

        @return resolved value, if not found then returns NOTHING
    */
    private:internal auto getValueFromHash(string ename, reference<auto> v, bool removeFound) {
        #printf("DEBUG: WSMessage::getValueFromHash() ename: %y v: %y rF: %y args: %y args{%y}.part: %y\n", ename, v, removeFound, args.keys(), ename, args{ename}.part);

        auto rv;
        string k;
        # there is no unique part namespace as it may contain more messages in one hash, so let's do a little heuristic
        if (v.typeCode() == NT_HASH && v.hasKey(name)) {
            if (args{ename}.part && v{name}.typeCode() == NT_HASH && v{name}.hasKey(args{ename}.part)) {
                k = args{ename}.part;
            } else if (v{name}.typeCode() == NT_HASH && v{name}.hasKey(ename)) {
                k = ename;
            }
            if (k) {
                rv = v{name}{k} ?? NULL;
                if (removeFound) {
                    remove v{name}{k};
                    if (!v{name}) {
                        remove v{name};
                    }
                }
            }
        }
        if (!k) {
            if (args{ename}.part && v.typeCode() == NT_HASH && v.hasKey(args{ename}.part)) {
                k = args{ename}.part;
            } else if (v.typeCode() == NT_HASH && v.hasKey(ename)) {
                k = ename;
            }
            if (k) {
                rv = v{k} ?? NULL;
                if (removeFound) {
                    remove v{k};
                    if (!v{name}) {
                        remove v{name};
                    }
                }
            }
        }
        return rv;
    }

    #! when only one arg then try to get values based on element keys
    private:internal auto getValueFromHash(*WSDL::XsdElement element, reference<auto> v, bool removeFound,
            *hash<string, bool> reserved) {
        if ((args.size() == 1 || exists reserved)
                && (XsdElementValueHelper::isWrapper(v) || XsdNativeTypeValueHelper::isWrapper(v))) {
            if (!XsdElementValueHelper::isWrapper(v)) {
                XsdNativeTypeValueHelper::checkWrapper(v);
            }
            auto value = v;
            if (removeFound) {
                remove v;
            }
            return value;
        }
        if (!element) {
            return;
        }
        if (element.type instanceof WSDL::XsdComplexType) {
            XsdComplexType type = cast<WSDL::XsdComplexType>(element.type);
            if (type.simpleType) {
                # A simple-content value uses the existing scalar/^value^ representation, with attributes beside it.
                if (v.typeCode() != NT_HASH) {
                    auto value = v;
                    if (removeFound) {
                        remove v;
                    }
                    return value ?? NULL;
                }
                if (v.hasKey("^value^")) {
                    list<string> members = select keys v, $1 == "^value^" || $1 == "^attributes^" || $1 =~ /^\^comment/;
                    hash<auto> value = v{members};
                    if (removeFound) {
                        map remove v{$1}, members;
                    }
                    return value;
                }
            }
            hash<auto> rv;
            if (v.typeCode() == NT_HASH && v.hasKey("^attributes^")) {
                rv."^attributes^" = v."^attributes^";
                if (removeFound) {
                    remove v."^attributes^";
                }
            }
            if (type.isEmpty()) {
                # An empty content model can still carry attributes.
                return rv ?? NULL;
            }
            if (v.typeCode() == NT_HASH) {
                hash<string, bool> fields();
                if (type.getParticle()) {
                    XsdParticle particle = type.getParticle();
                    hash<string, XsdElement> declarations = XsdElementFieldHelper::getParticleDeclarations(particle,
                        particle.getElementOccurrenceRanges());
                    foreach hash<auto> field in (XsdElementFieldHelper::getFieldNames(declarations).pairIterator()) {
                        fields{field.key} = fields{field.value} = True;
                    }
                } else {
                    fields = map {$1: True}, keys type.elementmap;
                    foreach hash<ChoiceInfo> choice in (type.choices) {
                        map fields{$1} = True, keys choice.elementmap;
                    }
                }
                foreach string key in (keys v) {
                    if (reserved{key} && !(key == name && fields{key})) {
                        continue;
                    }
                    if (fields{key} || key =~ /^\^comment/ || key =~ /^\^choices/
                            || (type.hasElementWildcard() && key !~ /^\^/)) {
                        rv{key} = v{key}.typeCode() == NT_NULL ? NOTHING : v{key};
                        if (removeFound) {
                            remove v{key};
                        }
                    }
                }
            }
            if (!exists rv && type.getParticle() && ((v.typeCode() == NT_HASH && !v)
                    || type.getParticle().matchesElementNames(()))) {
                # Preserve an explicitly empty flat record so its required particle is validated.
                # A model admitting no children also retains its enclosing element.
                return new hash<auto>();
            }
            return rv;
        }
    }

    string getSerializedKey(string part) {
        return args{pmap{part}}.element ? pmap{part} : part;
    }

    #! returns the expanded wire name of a document message part
    /** @param part the WSDL part name
        @return the declared element's expanded name, or the unqualified type-part name
        @since %WSDL 0.5.8
    */
    string getExpandedSerializedKey(string part) {
        *XsdElement element = args{pmap{part}}.element;
        return element ? element.getExpandedName() : type_qname("", part);
    }

    #! returns all concrete expanded element names admitted by a document part
    /** @param part the WSDL part name
        @return admitted element names, or the unqualified name of a type part
        @throw WSDL-ERROR the part does not exist
        @since %WSDL 0.5.8
    */
    list<string> getDocumentPartNames(string part) {
        if (!pmap.hasKey(part)) {
            throw WSDL_ERROR, sprintf("no part %Y in message %Y", part, name);
        }
        *XsdElement element = args{pmap{part}}.element;
        return element ? keys element.getInstanceDeclarations() : (type_qname("", part),);
    }

    #! assigns document elements to selected WSDL parts by their expanded names
    /** @param parts selected part names
        @param names expanded names of the supplied element occurrences
        @param ignore_unknown whether other parts may remain outside the assignment
        @return an occurrence index for each selected part
        @throw SOAP-DESERIALIZATION-ERROR missing, duplicate or ambiguous part values
        @throw WSDL-ERROR an unknown part was requested
        @since %WSDL 0.5.8
    */
    hash<string, int> matchDocumentParts(list<string> parts, list<string> names, bool ignore_unknown = False) {
        hash<string, list<int>> candidates();
        hash<string, list<int>> occurrences();
        for (int index = 0; index < names.size(); ++index) {
            push occurrences{names[index]}, index;
        }
        foreach string part in (parts) {
            if (candidates.hasKey(part)) {
                throw SOAP_DESERIALIZATION_ERROR, sprintf("message part %Y was selected more than once", part);
            }
            candidates{part} = ();
            foreach string identity in (getDocumentPartNames(part)) {
                candidates{part} += occurrences{identity} ?? ();
            }
        }
        return XsdMessagePartMatcher::match(candidates, names.size(), ignore_unknown);
    }

    #! check if pname is defined as message part
    /** @param pname the WSDL part name to resolve
        @return translated part name to element/type name
        @throw WSDL-ERROR the message has no part with this name
        @par Example
        Resolve an imported session message's token argument with message.checkPart("token").
     */
    string checkPart(string pname) {
        if (!pmap{pname}) {
            throw WSDL_ERROR, sprintf("%y is an unknown part in message %y, defined parts: %y", pname, name, keys pmap);
        }
        return pmap{pname};
    }
}

#! Group reference info with occurrence constraints
public hashdecl GroupRefInfo {
    #! The captured expanded group reference key (for example, "{urn:address}AddressGroup")
    string ref;
    #! Minimum occurrences (default 1)
    int minOccurs = 1;
    #! Maximum occurrences (-1 = unbounded, default 1)
    int maxOccurs = 1;
}

# NOTATION enumeration is a schema component constraint, not an empty builtin lexical space.
class XsdNotationTypeUseHelper {
    private {
        hash<string, bool> unrestricted();
    }

    check(XsdAbstractType type) {
        list<XsdAbstractType> path();
        *XsdAbstractType current = type;
        while (current && !unrestricted.hasKey(current.uniqueHash())) {
            push path, current;
            if (current instanceof XsdSimpleType) {
                XsdSimpleType simple = cast<XsdSimpleType>(current);
                if (simple.listItemType || simple.unionTypes) {
                    current = NOTHING;
                } else {
                    current = simple.type;
                }
            } else if (current instanceof XsdComplexType) {
                current = cast<XsdComplexType>(current).simpleType;
            } else {
                unrestricted{current.uniqueHash()} = current instanceof XsdBaseType && current.name == "NOTATION";
                break;
            }
        }
        bool forbidden = current ? unrestricted{current.uniqueHash()} : False;
        while (path) {
            XsdAbstractType step = pop path;
            if (step instanceof XsdSimpleType && cast<XsdSimpleType>(step).enumValues) {
                forbidden = False;
            }
            unrestricted{step.uniqueHash()} = forbidden;
        }
        if (unrestricted{type.uniqueHash()}) {
            throw WSDL_ERROR, sprintf("NOTATION type %Y must be derived with enumeration before schema use", type.name);
        }
    }

    collections(list<XsdSimpleType> definitions) {
        list<XsdAbstractType> pending = map $1, definitions;
        hash<string, bool> visited();
        while (pending) {
            XsdAbstractType current = pop pending;
            if (visited{current.uniqueHash()}) {
                continue;
            }
            visited{current.uniqueHash()} = True;
            if (!(current instanceof XsdSimpleType)) {
                continue;
            }
            XsdSimpleType simple = cast<XsdSimpleType>(current);
            list<XsdAbstractType> members = simple.listItemType ? (simple.listItemType,) : simple.unionTypes ?? ();
            foreach XsdAbstractType member in (members) {
                check(member);
                push pending, member;
            }
            if (simple.type) {
                push pending, simple.type;
            }
        }
    }
}

# private helper class for lazy name resolution
class XsdLateResolverHelper {
    private {
        list<object> l();
        list<XsdElement> constrainedElements();
        list<XsdElement> notationElementUses();
        list<XsdAttribute> notationAttributeUses();
        list<XsdSimpleType> notationDefinitions();
        list<XsdIdentityConstraint> identityConstraints();
        #! Group references: maps complexType -> list of group ref info
        hash<string, list<hash<GroupRefInfo>>> groupRefs();
        #! Attribute group references: maps complexType -> list of attribute group ref names
        hash<string, list<string>> attrGroupRefs();
    }

    constructor() {
    }

    add(object v) {
        l += v;
    }

    list<auto> getList() {
        return l;
    }

    addIdentityConstraint(XsdIdentityConstraint definition) {
        identityConstraints += definition;
    }

    publishIdentityConstraints(Namespaces nsc) {
        hash<string, XsdIdentityConstraint> completed = nsc.getIdentityConstraintRegistry().getDefinitions();
        foreach XsdIdentityConstraint definition in (identityConstraints) {
            string name = definition.getExpandedName();
            if (completed.hasKey(name)) {
                throw WSDL_ERROR, sprintf("identity constraint %Y is declared more than once", name);
            }
            completed{name} = definition;
        }
        nsc.getIdentityConstraintRegistry().replace(completed);
    }

    addNotationUse(XsdElement element) {
        push notationElementUses, element;
    }
    addNotationUse(XsdAttribute attribute) {
        push notationAttributeUses, attribute;
    }
    addNotationDefinition(XsdSimpleType type) {
        push notationDefinitions, type;
    }
    validateNotationUses() {
        XsdNotationTypeUseHelper helper();
        helper.collections(notationDefinitions);
        foreach XsdElement element in (notationElementUses) {
            helper.check(element.type);
        }
        foreach XsdAttribute attribute in (notationAttributeUses) {
            helper.check(attribute.type);
        }
    }

    addConstrainedElement(XsdElement element) {
        constrainedElements += element;
    }

    validateElementConstraints() {
        foreach XsdElement element in (constrainedElements) {
            element.validateValueConstraintType();
        }
    }

    #! Add a group reference to be resolved later
    /** @param ct the complex type containing the group reference
        @param groupRef the group reference string
        @param minOccurs the minimum occurrences (default 1)
        @param maxOccurs the maximum occurrences (-1 for unbounded, default 1)
    */
    addGroupRef(XsdComplexType ct, string groupRef, int minOccurs = 1, int maxOccurs = 1) {
        string key = ct.uniqueHash();
        if (!groupRefs{key}) {
            groupRefs{key} = ();
        }
        groupRefs{key} += <GroupRefInfo>{
            "ref": groupRef,
            "minOccurs": minOccurs,
            "maxOccurs": maxOccurs,
        };
    }

    #! Add an attribute group reference to be resolved later
    addAttrGroupRef(XsdComplexType ct, string attrGroupRef) {
        string key = ct.uniqueHash();
        if (!attrGroupRefs{key}) {
            attrGroupRefs{key} = ();
        }
        attrGroupRefs{key} += attrGroupRef;
    }

    #! Get group references for a complex type
    *list<hash<GroupRefInfo>> getGroupRefs(XsdComplexType ct) {
        return groupRefs{ct.uniqueHash()};
    }

    #! Get attribute group references for a complex type
    *list<string> getAttrGroupRefs(XsdComplexType ct) {
        return attrGroupRefs{ct.uniqueHash()};
    }

    clearResolved() {
        l = map $1, l, !isResolved($1);
    }

    static bool isResolved(XsdTypedData t) {
        return t.type instanceof XsdAbstractType;
    }

    static bool isResolved(XsdSimpleType t) {
        return t.type instanceof XsdAbstractType;
    }

    static bool isResolved(XsdComplexType t) {
        return t.simpleType instanceof XsdAbstractType;
    }

    static bool isResolved(XsdArrayType t) {
        return t.elementType instanceof XsdAbstractType;
    }

    static bool isResolved(auto t) {
        return False;
    }
}

#! class for WSDL bindings associated with a SOAP operation
public class OperationalBinding inherits WSDL::XsdNamedData {
    public {
        bool docstyle;
        *WSDL::BindingMessageDescription input;
        *WSDL::BindingMessageDescription output;
        *string soapAction;
    }

    constructor(string name, string ns, bool docstyle, *string soapAction, *WSDL::BindingMessageDescription input, *WSDL::BindingMessageDescription output) : XsdNamedData(name, ns) {
        self.docstyle = docstyle;
        self.soapAction = soapAction;
        self.input = input;
        self.output = output;
    }

    #! returns True for a SOAP 1.2 binding, False for other protocols
    /** @return False in the base implementation; SOAP bindings override this query
    */
    bool isSoap12() {
        return False;
    }

    hash<auto> serializeMessage(WSOperation op, *WSMessage msg, bool request, bool soap12, auto h, *hash<auto> header, string enc = "UTF-8", *hash<auto> nsh, *int xml_opts, *string req_soapaction, *string faultmsg, *hash<auto> http_headers) {
        return serializeMessageImpl(op, msg, request, soap12, h, header, enc, nsh, xml_opts, req_soapaction, faultmsg, http_headers);
    }

    auto deserializeMessage(WSOperation op, hash<auto> o, bool request) {
        return deserializeMessageImpl(op, o, request);
    }

    auto deserializeRequestPath(WSOperation op, string path) {
        return deserializeRequestPathImpl(op, path);
    }

    abstract hash<auto> serializeMessageImpl(WSOperation op, *WSMessage msg, bool request, bool soap12, auto h, *hash<auto> header, string enc, *hash<auto> nsh, *int xml_opts, *string req_soapaction, *string faultmsg, *hash<auto> http_headers);

    abstract auto deserializeMessageImpl(WSOperation op, hash<auto> o, bool request);

    abstract auto deserializeRequestPathImpl(WSOperation op, string path);
}

public class SoapBinding inherits WSDL::OperationalBinding {
    public {
        string soapTransport;
    }

    private {
        # Absent in old standalone serialized bindings; never infer it from unrelated xmlns declarations.
        *bool soap12_version;
        # NOTHING denotes a legacy standalone binding with no concrete fault metadata.
        *hash<string, BindingMessageBodyDescription> fault_bindings;
    }

    #! creates an operational SOAP binding
    /** @param name binding name
        @param ns binding namespace prefix
        @param docstyle True for document style, False for RPC style
        @param soapTransport SOAP transport URI
        @param soapAction action URI
        @param input request message description
        @param output response message description
        @param soap12 the binding's SOAP version; supply it for implicit WSOperation serialization
        @param fault_bindings concrete fault descriptions keyed by abstract fault name; NOTHING marks legacy
        metadata without concrete fault information, while an empty map declares no faults
        @throw WSDL-ERROR invalid concrete fault descriptors or an unsupported encoding style
        @note Older standalone bindings without version metadata can still be used with the explicit
        version argument of serializeMessage(). Reload their WSDL to use implicit version selection.
        WebService serialization retains and reparses the WSDL automatically.
    */
    constructor(string name, string ns, bool docstyle, string soapTransport, *string soapAction,
            *WSDL::BindingMessageDescription input, *WSDL::BindingMessageDescription output, *bool soap12,
            *hash<string, BindingMessageBodyDescription> fault_bindings)
            : OperationalBinding(name, ns, docstyle, soapAction, input, output) {
        self.soapTransport = soapTransport;
        soap12_version = soap12;
        validateFaultBindings(fault_bindings, WSDL_ERROR);
        self.fault_bindings = fault_bindings;
    }

    private:internal deserializeMembers(hash<auto> members) {
        auto descriptions = remove members.fault_bindings;
        if (exists descriptions && descriptions.typeCode() != NT_HASH) {
            throw "DESERIALIZATION-ERROR", "SOAP fault descriptions require a hash";
        }
        validateFaultBindings(descriptions, "DESERIALIZATION-ERROR");
        fault_bindings = descriptions;
        self += members;
    }

    private static validateFaultBindings(*hash<auto> descriptions, string error) {
        foreach hash<auto> entry in (descriptions.pairIterator()) {
            XsdNameLexicalHelper::lexical("NCName", entry.key, error);
            if (!(entry.value instanceof BindingMessageBodyDescription) || exists entry.value.parts) {
                throw error, "a concrete SOAP fault requires a body description without a part selection";
            }
            if (entry.value.encoded && exists entry.value.encodingStyle
                    && XsdSimpleType::normalizeWhiteSpace(entry.value.encodingStyle, "collapse") != SOAP_ENCODING) {
                throw error, sprintf("SOAP fault %Y selects an unsupported encoding style %Y",
                    entry.key, entry.value.encodingStyle);
            }
        }
    }

    #! Returns concrete fault descriptions keyed by their abstract fault name
    /** @return the descriptions, or NOTHING for a legacy binding without concrete fault metadata
        @note Descriptions retain the fault's own use, namespace and encodingStyle. They are shared binding
        metadata and must not be mutated while the binding is in use.
        @since %WSDL 0.5.8
    */
    *hash<string, BindingMessageBodyDescription> getFaultBindings() {
        return fault_bindings;
    }

    #! Serializes a selected declared fault or a generic protocol fault
    /** @param op the operation owning the fault message
        @param fault the declared fault name, or NOTHING for a generic fault without a detail message
        @param reason the fault reason
        @param value the fault message's native value
        @param header optional SOAP headers for the response
        @param enc output encoding
        @param nsh optional output namespaces
        @param xml_opts XML generation options
        @param action optional SOAPAction override
        @return the SOAP transport message with body and headers
        @throw SOAP-SERIALIZATION-ERROR the fault is not bound or its detail is invalid
        @throw WSDL-BINDING-ERROR the binding lacks protocol or concrete fault metadata
        @par Example
        Use WSOperation::serializeFault("Rejected", "Order rejected", detail) to select the operation's binding.
        @since %WSDL 0.5.8
    */
    hash<auto> serializeFaultMessage(WSOperation op, *string fault, string reason, auto value,
            *hash<auto> header, string enc = "UTF-8", *hash<auto> nsh, *int xml_opts, *string action) {
        BindingMessageDescription description();
        *WSMessage message;
        if (exists fault) {
            if (!exists fault_bindings) {
                throw "WSDL-BINDING-ERROR", "legacy SOAP binding lacks concrete fault metadata; reload its WSDL";
            }
            if (!fault_bindings.hasKey(fault)) {
                throw SOAP_SERIALIZATION_ERROR, sprintf("fault %Y is not declared in SOAP binding %Y", fault, name);
            }
            message = op.getFaultMessages(){fault};
            if (!message || message.pmap.size() != 1) {
                throw SOAP_SERIALIZATION_ERROR, sprintf("fault %Y requires a declared single-part message", fault);
            }
            description.body = fault_bindings{fault};
            if (description.body.encoded && !message.args.firstValue().type) {
                throw SOAP_SERIALIZATION_ERROR, "an encoded SOAP fault must reference a type-based message part";
            }
        } else {
            if (exists value) {
                throw SOAP_SERIALIZATION_ERROR, "a generic SOAP fault has no declared detail message";
            }
            description.body = new BindingMessageBodyDescription(False);
        }
        if (output) {
            foreach BindingMessageHeaderDescription item in (output.getHeaders()) {
                description.addHeader(item);
            }
        }
        return serializeMessageWithDescription(op, message, False, isSoap12(), value, header, enc, nsh,
            xml_opts, action, reason, NOTHING, description);
    }

    #! decodes the single detail part of a selected declared fault
    /** @param op the operation owning the fault message
        @param xml the complete SOAP fault envelope
        @param fault the declared fault name
        @param retain_xml True retains the literal element after validation
        @return the native schema value, or XsdXmlValue when retain_xml is True
        @throw WSDL-BINDING-ERROR unknown/unbound fault or incompatible XML representation
        @throw SOAP-DESERIALIZATION-ERROR malformed envelope, detail or schema value
        @par Example
        Prefer WSOperation::deserializeFault() to select a concrete binding and native capture policy.
    */
    auto deserializeFaultMessage(WSOperation op, string xml, string fault, bool retain_xml = False) {
        if (!exists fault_bindings) {
            throw "WSDL-BINDING-ERROR", "legacy SOAP binding lacks concrete fault metadata; reload its WSDL";
        }
        *WSMessage message = op.getFaultMessages(){fault};
        if (!fault_bindings.hasKey(fault) || !message || message.pmap.size() != 1) {
            throw "WSDL-BINDING-ERROR", sprintf("fault %Y requires a bound single-part message in binding %Y", fault, name);
        }
        BindingMessageBodyDescription description = fault_bindings{fault};
        string part = message.pmap.firstKey();
        if (retain_xml && (description.encoded || !message.args.firstValue().element)) {
            throw "WSDL-BINDING-ERROR", "retained XML faults require literal element parts";
        }
        hash<SoapFaultEnvelopeInfo> envelope = parseFaultEnvelope(xml);
        string detail_name = envelope.uri == SOAP_12_ENV ? type_qname(envelope.uri, "Detail") : "{}detail";
        list<XsdXmlValue> details = select envelope.fault.getChildValues(), $1.getExpandedName() == detail_name;
        if (details.size() != 1) {
            throw SOAP_DESERIALIZATION_ERROR, "a declared SOAP fault requires exactly one detail container";
        }
        XsdScalarTextHelper::elementContent(details[0].getElementData(), "SOAP fault detail");
        list<XsdXmlValue> entries = details[0].getChildValues();
        if (entries.size() != 1) {
            throw SOAP_DESERIALIZATION_ERROR, "a declared SOAP fault requires exactly one detail part";
        }
        XsdXmlValue selected = entries[0];
        if (description.encoded) {
            string expected = type_qname(description.ns ?? "", part);
            if (selected.getExpandedName() != expected) {
                throw SOAP_DESERIALIZATION_ERROR, sprintf("expected encoded fault accessor %Y; got %Y", expected, selected.getExpandedName());
            }
        }
        hash<auto> data = XsdBase::expandElementNamespaces(selected.getXmlDataView());
        auto value = description.encoded ? prepareEncodedPartValue(data.firstValue(), envelope.uri) : data.firstValue();
        auto decoded = message.deserializeDocument(NOTHING,
            {description.encoded ? type_qname("", part) : selected.getExpandedName(): value}, part, False, True){part};
        return retain_xml ? selected : decoded;
    }

    #! selects a headerfault declaration by message identity and part
    /** @param message local or namespace-expanded WSDL message name
        @param part WSDL part name
        @param request_header True for input headerfaults, False for output headerfaults
        @return the owned concrete headerfault description
        @throw WSDL-BINDING-ERROR no matching declaration or ambiguous message/metadata selection
        @note The returned shared description must not be mutated while the binding is in use.
        @par Example
        Select an imported session error with binding.getHeaderFaultDescription("{urn:session}Error", "problem").
    */
    BindingMessageHeaderDescription getHeaderFaultDescription(string message, string part,
            bool request_header = True) {
        *BindingMessageDescription description = request_header ? input : output;
        *BindingMessageHeaderDescription selected;
        foreach BindingMessageHeaderDescription header in (description ? description.getHeaders() : ()) {
            foreach BindingMessageHeaderDescription fault in (header.getHeaderFaults()) {
                if (fault.part != part || (fault.msg.name != message && fault.msg.getExpandedName() != message)) {
                    continue;
                }
                if (selected && (selected.msg.getExpandedName() != fault.msg.getExpandedName()
                        || selected.encoded != fault.encoded
                        || selected.getDocumentPartNames() != fault.getDocumentPartNames())) {
                    throw "WSDL-BINDING-ERROR", sprintf("ambiguous headerfault message %Y part %Y in binding %Y",
                        message, part, name);
                }
                selected = fault;
            }
        }
        if (!selected) {
            throw "WSDL-BINDING-ERROR", sprintf("unknown headerfault message %Y part %Y in binding %Y",
                message, part, name);
        }
        return selected;
    }

    #! serializes a fault concerning a declared SOAP header
    /** @param op the owning operation
        @param info headerfault message/part identity, value and source direction
        @param reason the fault reason
        @param enc output encoding
        @return SOAP transport message with a headerfault block and no application detail
        @throw WSDL-BINDING-ERROR unknown/ambiguous headerfault or missing binding version
        @throw SOAP-SERIALIZATION-ERROR invalid headerfault value
        @par Example
        Prefer WSOperation::serializeHeaderFault() to select the operation's binding explicitly.
    */
    hash<auto> serializeHeaderFaultMessage(WSOperation op, hash<SoapHeaderFaultInfo> info, string reason,
            string enc = "UTF-8") {
        BindingMessageHeaderDescription fault = getHeaderFaultDescription(info.message, info.part, info.request_header);
        BindingMessageDescription description();
        description.body = new BindingMessageBodyDescription(False);
        description.addHeader(fault);
        return serializeMessageWithDescription(op, NOTHING, False, isSoap12(), NOTHING,
            {fault.msg.name: {fault.part: info.value}}, enc, NOTHING, NOTHING, NOTHING, reason, NOTHING, description);
    }

    #! decodes one declared headerfault block independently of the normal output message
    /** @param xml the complete SOAP fault envelope
        @param message local or expanded WSDL headerfault message name
        @param part WSDL headerfault part name
        @param request_header True selects input headerfaults, False selects output headerfaults
        @param retain_xml True returns a retained literal element after schema validation
        @return the selected native schema value, or XsdXmlValue when retain_xml is True
        @throw WSDL-BINDING-ERROR unknown/ambiguous declaration or absent protocol metadata
        @throw SOAP-DESERIALIZATION-ERROR invalid envelope, missing/repeated block or invalid value
        @par Example
        Prefer WSOperation::deserializeHeaderFault() to select the operation's binding explicitly.
    */
    auto deserializeHeaderFaultMessage(string xml, string message, string part, bool request_header = True,
            bool retain_xml = False) {
        BindingMessageHeaderDescription fault = getHeaderFaultDescription(message, part, request_header);
        if (retain_xml && (fault.encoded || !fault.msg.args{fault.msg.pmap{part}}.element)) {
            throw "WSDL-BINDING-ERROR", "retained XML headerfaults require literal element parts";
        }
        hash<SoapFaultEnvelopeInfo> envelope = parseFaultEnvelope(xml);
        string uri = envelope.uri;
        list<XsdXmlValue> headers = envelope.headers;
        BindingMessageDescription description();
        description.addHeader(fault);
        hash<string, BindingMessageHeaderDescription> matches = matchHeaders(description,
            map $1.getExpandedName(), headers);
        if (matches.size() != 1) {
            throw SOAP_DESERIALIZATION_ERROR, "missing selected SOAP headerfault block";
        }
        XsdXmlValue selected = headers[int(matches.firstKey())];
        hash<auto> data = XsdBase::expandElementNamespaces(selected.getXmlDataView());
        auto value = fault.encoded ? prepareEncodedPartValue(data.firstValue(), uri) : data.firstValue();
        auto decoded = fault.msg.deserializeDocument(NOTHING,
            {fault.encoded ? type_qname("", part) : selected.getExpandedName(): value}, part, False, True){part};
        return retain_xml ? selected : decoded;
    }

    private hash<SoapFaultEnvelopeInfo> parseFaultEnvelope(string xml) {
        string uri = isSoap12() ? SOAP_12_ENV : SOAP_11_ENV;
        XsdXmlValue envelope(xml);
        if (envelope.getExpandedName() != type_qname(uri, "Envelope")) {
            throw SOAP_DESERIALIZATION_ERROR, "fault envelope does not match the binding's SOAP version";
        }
        XsdSoapXmlHelper::validate(envelope, SOAP_DESERIALIZATION_ERROR);
        XsdScalarTextHelper::elementContent(envelope.getElementData(), "SOAP Envelope");
        bool body_seen = False;
        bool header_seen = False;
        list<XsdXmlValue> headers();
        list<XsdXmlValue> body();
        foreach XsdXmlValue child in (envelope.getChildValues()) {
            if (child.getExpandedName() == type_qname(uri, "Header")) {
                if (header_seen || body_seen) {
                    throw SOAP_DESERIALIZATION_ERROR, "SOAP Header must occur once before Body";
                }
                header_seen = True;
                XsdScalarTextHelper::elementContent(child.getElementData(), "SOAP Header");
                headers = child.getChildValues();
            } else if (child.getExpandedName() == type_qname(uri, "Body")) {
                if (body_seen) {
                    throw SOAP_DESERIALIZATION_ERROR, "duplicate SOAP Body";
                }
                body_seen = True;
                XsdScalarTextHelper::elementContent(child.getElementData(), "SOAP Body");
                body = child.getChildValues();
            } else if (uri != SOAP_11_ENV || !body_seen || !child.getNamespaceUri()) {
                throw SOAP_DESERIALIZATION_ERROR, sprintf("unexpected SOAP envelope child %Y", child.getExpandedName());
            }
        }
        list<XsdXmlValue> faults = select body, $1.getExpandedName() == type_qname(uri, "Fault");
        if (!body_seen || faults.size() != 1 || (uri == SOAP_12_ENV && body.size() != 1)) {
            throw SOAP_DESERIALIZATION_ERROR, "expected one SOAP Fault in Body";
        }
        XsdScalarTextHelper::elementContent(faults[0].getElementData(), "SOAP Fault");
        foreach XsdXmlValue header in (headers) {
            if (!header.getNamespaceUri()) {
                throw SOAP_DESERIALIZATION_ERROR, "SOAP header blocks must be namespace-qualified";
            }
        }
        return <SoapFaultEnvelopeInfo>{"uri": uri, "fault": faults[0], "headers": headers};
    }

    #! returns the binding's declared SOAP version
    /** @return True for SOAP 1.2, False for SOAP 1.1
        @throw WSDL-BINDING-ERROR a legacy standalone binding has no version metadata; reload its WSDL
    */
    bool isSoap12() {
        if (!exists soap12_version) {
            throw "WSDL-BINDING-ERROR", sprintf("SOAP binding %Y has no saved protocol version; reload its WSDL "
                "or construct it with an explicit SOAP version", name);
        }
        return soap12_version;
    }

    hash<auto> serializeMessageImpl(WSOperation op, *WSMessage msg, bool request, bool soap12, auto h, *hash<auto> header, string enc, *hash<auto> nsh, *int xml_opts, *string req_soapaction, *string faultmsg, *hash<auto> http_headers) {
        return serializeMessageWithDescription(op, msg, request, soap12, h, header, enc, nsh, xml_opts,
            req_soapaction, faultmsg, http_headers, self{request ? "input" : "output"});
    }

    private hash<auto> serializeMessageWithDescription(WSOperation op, *WSMessage msg, bool request, bool soap12,
            auto h, *hash<auto> header, string enc, *hash<auto> nsh, *int xml_opts, *string req_soapaction,
            *string faultmsg, *hash<auto> http_headers, *BindingMessageDescription bmd) {
        hash<auto> rv;

        if (request) {
            # make sure that rv stays hash<auto> instead of hash<string, string>
            rv += {
                "method": "POST",
            };
        }

        string io = request ? "input" : "output";

        if (!bmd) {
            throw SOAP_SERIALIZATION_ERROR, sprintf("no %s message description for message %y", io, name);
        }

        if (!exists req_soapaction)
            req_soapaction = soapAction;

        MultiPartRelatedMessage mpm;

        Namespaces output_namespaces = op.nsc.copy();
        XsdQNameOutputScope output_scope(output_namespaces);
        XsdQNameXmlOutputHelper output();
        rv.body = make_xml(output.prepare(serializeSoapMessage(op, msg, h, header, nsh, request, soap12, \mpm, faultmsg, bmd)), xml_opts, enc);

        string ct = WSDLLib::getSoapMimeType12(soap12);

        # Handle multipart message assembly - splice SOAP body as first part
        if (mpm && mpm.size() > 0) {
            string partId = sprintf("<%s>", (bmd.body.parts ?? (msg ? keys msg.args : ())).join(" "));
            mpm.splicePart(rv.body, partId, ct);
            hash<Mime::MessageInfo> mpmResult = mpm.getMsgAndHeaders();
            rv.body = mpmResult.body;
            rv.hdr += mpmResult.hdr;
            # Content-Type will be overwritten below if not multipart
            ct = rv.hdr."Content-Type";
        }

        if (req_soapaction) {
            rv.hdr += {"SOAPAction": req_soapaction};
            if (soap12) {
                ct += sprintf(";action=%s", req_soapaction);
            }
        }

        if (rv.body) {
            if (exists enc) {
                ct += sprintf(";charset=%s", enc);
            }

            rv.hdr."Content-Type" = ct;
        }

        rv.hdr."Accept" = WSDLLib::SoapMimeTypes.join(",");

        rv.hdr += http_headers;

        return rv;
    }

    private:internal hash<auto> serializeSoapMessage(WSOperation op, *WSMessage msg, auto val, *hash<auto> header,
            *hash<auto> nsh, bool request, bool soap12, reference mpm, *string faultmsg, BindingMessageDescription bmd) {
        if (val.typeCode() == NT_HASH && (val.hasKey("^body^") || val.hasKey("^headers^"))) {
            if (val.size() != 2 || !val.hasKey("^body^") || !val.hasKey("^headers^")
                    || val."^body^".typeCode() != NT_HASH || val."^headers^".typeCode() != NT_HASH) {
                throw SOAP_SERIALIZATION_ERROR, "an explicit SOAP value requires exactly ^body^ and ^headers^ hash maps";
            }
            if (header && val."^headers^") {
                throw SOAP_SERIALIZATION_ERROR, "SOAP headers cannot be supplied both in ^headers^ and a header argument";
            }
            header = header ? header : val."^headers^";
            val = val."^body^";
        }
        string io = request ? "input" : "output";
        # setup namespaces for SOAP envelope
        #printf("DEBUG: serializeSoapMessage: io:%s, h: %y, header: %y, soap12:%y\n", io, val, header, soap12);
        # make sure that rh stays hash<auto> instead of hash<string, string>

        hash<auto> rh = hash(soap12 ? WSDL::ENVELOPE_12_NS : WSDL::ENVELOPE_11_NS);
        string soapenvEnvelope = rh.firstKey();
        Namespaces output_namespaces = QNameOutputNamespaces ?? op.nsc;

        # Create multipart message container if multipartRelated binding is used
        if (exists bmd.multipart) {
            mpm = new MultiPartRelatedMessage();
        }

        bool fault = exists faultmsg;

        #printf("DEBUG: docstyle: %y fault: %y\n", docstyle, fault);
        #printf("DEBUG: op: %y io: %y op{io}: %s %d %y\n", op.keys(), io, op{io}.type(), op{io}.typeCode(), boolean(op{io}));
        *hash<auto> body;
        if (msg) {
            bool encoded = bmd.body.encoded;
            if (fault && (msg.pmap.size() != 1 || (encoded && !msg.args.firstValue().type))) {
                throw SOAP_SERIALIZATION_ERROR, "SOAP fault detail requires one part, referencing a type for encoded use";
            }
            # Fault detail belongs to its own message, not the ordinary output body selection.
            *list<string> body_parts = fault ? NOTHING : bmd.body.parts;
            if (docstyle || fault) {
                # bmd.body.encoded == False = literal encoding
                #printf("parts: %y, args: %y\n", bmd.body.parts, msg.args.keys());
                body = msg.serializeDocument(body_parts, bmd, mpm, encoded, \val, fault);
            } else {
                string mname = op.name + (request ? "" : "Response");
                body = msg.serializeRpc(body_parts, bmd, mpm, mname, encoded, \val, fault);
            }
            if (fault && encoded && body) {
                string part = msg.pmap.firstKey();
                string key = bmd.body.ns ? output_namespaces.getOutputNamespacePrefix(bmd.body.ns) + ":" + part
                    : part;
                auto value = remove body{part};
                body{key} = value.typeCode() == NT_HASH ? value : {"^value^": value};
                # encodingStyle belongs to application detail, not the SOAP-defined Detail element.
                body{key}."^attributes^"."soapenv:encodingStyle" = bmd.body.encodingStyle
                    ? XsdSimpleType::normalizeWhiteSpace(bmd.body.encodingStyle, "collapse") : SOAP_ENCODING;
                remove body."^attributes^"."soapenv:encodingStyle";
                if (!body."^attributes^") {
                    remove body."^attributes^";
                }
            }
            if (encoded) {
                rh{soapenvEnvelope}."^attributes^"."xmlns:soapenc" = SOAP_ENCODING;
            }
            #printf("DEBUG: body: %N\nval: %N\n", body, val);
        }

        *hash<string, string> header_xml_attributes;
        hash<string, string> header_keys = bmd.getHeaderMessageKeys(msg);
        if (bmd.hasHeaders()) {
            #printf("DEBUG: %s header: %y\n", io, header);
            #printf("DEBUG: doc: %y bhdr: %N\n", docstyle, (map $1.("message", "part"), bmd.getHeaders()));
            hash<auto> outh;
            list<string> emitted_header_names();
            foreach BindingMessageHeaderDescription hdr in (bmd.getHeaders()) {
                #printf("DEBUG: hdr: %y (%y)\n", hdr.("encoded", "part"), hdr.msg.args.keys());
                # only style="document" is assumed since headers do not contain parameters.
                *hash<auto> h;
                string field = header_keys{hdr.msg.getExpandedName()};
                if (header) {
                    h = serializeHeaderPart(hdr, field, \header);
                }
                if (!h && val) {
                    h = serializeHeaderPart(hdr, field, \val);
                }
                if (h) {
                    if (hdr.encoded) {
                        string key = hdr.ns ? output_namespaces.getOutputNamespacePrefix(hdr.ns) + ":" + hdr.part
                            : hdr.part;
                        auto value = remove h{hdr.part};
                        h{key} = value.typeCode() == NT_HASH ? value : {"^value^": value};
                        h{key}."^attributes^"."soapenv:encodingStyle" = hdr.encodingStyle
                            ? XsdSimpleType::normalizeWhiteSpace(hdr.encodingStyle, "collapse") : SOAP_ENCODING;
                    }
                    foreach string key in (keys h) {
                        if (key.startsWith("^xml^")) {
                            auto fragment = h{key};
                            XsdXmlValue xml(fragment instanceof XsdQNameXmlFragment ? fragment.getXml() : fragment);
                            push emitted_header_names, xml.getExpandedName();
                            hash<string, string> attributes();
                            foreach string attribute in ("xml:lang", "xml:space", "xml:base") {
                                if (h."^attributes^".hasKey(attribute)) {
                                    attributes{attribute} = h."^attributes^"{attribute};
                                }
                            }
                            XsdSoapXmlHelper::mergeContext(\header_xml_attributes, attributes);
                        } else if (!key.startsWith("^")) {
                            list<string> qname = key.split(":");
                            push emitted_header_names, type_qname(qname.size() == 2
                                ? output_namespaces.getOutputNamespaceUri(qname[0]) : "", qname[-1]);
                            if (outh.hasKey(key)) {
                                throw SOAP_SERIALIZATION_ERROR, sprintf("multiple header parts select element %Y", key);
                            }
                        }
                    }
                    remove h."^attributes^".("soapenv:encodingStyle");
                    outh += h;
                }
            }
            try {
                matchHeaders(bmd, emitted_header_names);
            } catch (hash<ExceptionInfo> error) {
                if (error.err == SOAP_DESERIALIZATION_ERROR) {
                    rethrow SOAP_SERIALIZATION_ERROR, error.desc, error.arg;
                }
                rethrow;
            }
            #printf("DEBUG: outh: %y\n", outh);
            rh{soapenvEnvelope}."soapenv:Header" = outh;
        }
        if (header.typeCode() == NT_HASH && header) {
            if (op.nsc.opt_allow_any_header) {
                if (exists header_xml_attributes) {
                    foreach string attribute in ("xml:lang", "xml:space", "xml:base") {
                        if (header."^attributes^".hasKey(attribute)
                                && (!header_xml_attributes.hasKey(attribute)
                                    || header."^attributes^"{attribute}.typeCode() != NT_STRING
                                    || header."^attributes^"{attribute} != header_xml_attributes{attribute})) {
                            throw SOAP_SERIALIZATION_ERROR,
                                "explicit SOAP Header attributes conflict with retained XML context";
                        }
                    }
                }
                rh{soapenvEnvelope}."soapenv:Header" += header;
            } else {
                throw SOAP_SERIALIZATION_ERROR, sprintf("%s header data provided for operation %y remains unserialized: %y", io, op.name, header);
            }
        }
        if (header_xml_attributes) {
            rh{soapenvEnvelope}."soapenv:Header"."^attributes^" += header_xml_attributes;
        }
        if (val.typeCode() == NT_HASH && val)
            throw SOAP_SERIALIZATION_ERROR, sprintf("%s data provided for operation %y remains unserialized: %y", io, op.name, val);

        if (fault) {
            if (soap12) {
                rh{soapenvEnvelope}."soapenv:Body" = {
                    "soapenv:Fault": {
                        "soapenv:Code": {
                            "soapenv:Value": "soapenv:Sender",
                        },
                        "soapenv:Reason": {
                            "soapenv:Text": faultmsg,
                        },
                    } + (body ? {"soapenv:Detail": body} : NOTHING),
                };
                # optional Node, Role, Detail, see https://www.w3.org/TR/soap12/, 5.4 Fault
            } else {
                # soap 1.1
                rh{soapenvEnvelope}."soapenv:Body" = {
                    "soapenv:Fault": {
                        "faultcode": "soapenv:Client",
                        "faultstring": faultmsg,
                    } + (body ? {"detail": body} : NOTHING),
                };
            }
        } else {
            # Every SOAP envelope has a Body, including document messages with zero body parts.
            rh{soapenvEnvelope}."soapenv:Body" = body ?? {};
        }
        # Body and header values can introduce namespaces absent from the schema. Publish the
        # complete per-message map only after every part has allocated its output names.
        rh{soapenvEnvelope}."^attributes^" += output_namespaces.getOutputNamespaceHash(nsh);
        return rh;
    }

    #! decodes element-based literal SOAP parts without converting their XML scalar values
    /** @param op the operation describing the request or response
        @param xml the complete SOAP envelope XML
        @param request True for input, False for output
        @return retained body parts and headers keyed by their WSDL identities
        @throw SOAP-DESERIALIZATION-ERROR invalid message or payload
        @throw SOAP-SERVER-FAULT-RESPONSE a SOAP fault response was received
        @throw WSDL-BINDING-ERROR the binding requires a nonliteral or nonelement XML representation
        @note Existing schema decode and encode constraints apply before any XML values are returned.
    */
    hash<SoapXmlMessageInfo> deserializeXmlMessage(WSOperation op, string xml, bool request) {
        string io = request ? "input" : "output";
        *BindingMessageDescription description = self{io};
        *WSMessage message = op{io};
        if (!description || !message) {
            throw SOAP_DESERIALIZATION_ERROR, sprintf("operation %y has no %s message", op.name, io);
        }
        if (!docstyle || description.body.encoded || description.multipart) {
            throw "WSDL-BINDING-ERROR", "retained XML decoding requires an element-based literal SOAP binding";
        }
        XsdXmlValue envelope(xml);
        if (envelope.getLocalName() != "Envelope"
                || !inlist(envelope.getNamespaceUri(), (SOAP_11_ENV, SOAP_12_ENV))) {
            throw SOAP_DESERIALIZATION_ERROR, "expected a SOAP Envelope element";
        }
        XsdSoapXmlHelper::validate(envelope, SOAP_DESERIALIZATION_ERROR);
        list<XsdXmlValue> body_values();
        list<XsdXmlValue> header_values();
        bool has_body = False;
        bool has_header = False;
        hash<SoapXmlMessageInfo> result();
        foreach XsdXmlValue child in (envelope.getChildValues()) {
            if (child.getExpandedName() == type_qname(envelope.getNamespaceUri(), "Body")) {
                if (has_body) {
                    throw SOAP_DESERIALIZATION_ERROR, "duplicate SOAP Body";
                }
                has_body = True;
                body_values = child.getChildValues();
            } else if (child.getExpandedName() == type_qname(envelope.getNamespaceUri(), "Header")) {
                if (has_header || has_body) {
                    throw SOAP_DESERIALIZATION_ERROR, "SOAP Header must occur once before Body";
                }
                has_header = True;
                header_values = child.getChildValues();
            } else if (envelope.getNamespaceUri() == SOAP_11_ENV && has_body && child.getNamespaceUri()) {
                result.extensions += child;
            } else {
                throw SOAP_DESERIALIZATION_ERROR, sprintf("unexpected SOAP envelope child %y", child.getExpandedName());
            }
        }
        if (!has_body) {
            throw SOAP_DESERIALIZATION_ERROR, "missing SOAP Body";
        }
        # Check envelope structure before passing it through a native hash projection, which cannot
        # preserve duplicate singleton containers. Keep existing schema and fault handling after that.
        deserializeMessage(op, parse_xml(xml, XPF_PRESERVE_ORDER | XPF_PRESERVE_WHITESPACE), request);
        if (message) {
            list<string> parts = description.getBodyPartNames(message) ?? keys message.pmap;
            hash<string, int> assigned = message.matchDocumentParts(parts, map $1.getExpandedName(), body_values);
            foreach hash<string, auto> entry in (assigned.pairIterator()) {
                string part = entry.key;
                XsdXmlValue value = body_values[entry.value];
                validateXmlPart(op, message, part, value);
                result.body{part} = value;
            }
        }
        foreach BindingMessageHeaderDescription header in (description.getHeaders()) {
            if (header.encoded) {
                throw "WSDL-BINDING-ERROR", "retained XML headers must be literal";
            }
        }
        hash<string, string> header_keys = description.getHeaderMessageKeys(message);
        hash<string, BindingMessageHeaderDescription> selected_headers = matchHeaders(description,
            map $1.getExpandedName(), header_values);
        for (int index = 0; index < header_values.size(); ++index) {
            XsdXmlValue value = header_values[index];
            if (!value.getNamespaceUri()) {
                throw SOAP_DESERIALIZATION_ERROR, "SOAP header blocks must be namespace-qualified";
            }
            *BindingMessageHeaderDescription header = selected_headers{string(index)};
            if (!header) {
                result.unbound_headers += value;
                continue;
            }
            validateXmlPart(op, header.msg, header.part, value);
            result.headers{header_keys{header.msg.getExpandedName()}}{header.part} = value;
        }
        return result;
    }

    private static *hash<auto> serializeHeaderPart(BindingMessageHeaderDescription header, string field,
            reference<auto> values) {
        if (field == header.msg.name) {
            return header.msg.serializeDocument(header.part, NOTHING, NOTHING, header.encoded, \values, False);
        }
        if (values.typeCode() != NT_HASH || !values.hasKey(field)) {
            return;
        }
        if (values{field}.typeCode() != NT_HASH) {
            throw SOAP_SERIALIZATION_ERROR, sprintf("header message %Y requires a part-value hash", field);
        }
        # Isolate the qualified container without mutating the shared WSMessage or consuming another message.
        hash<auto> selected = {header.msg.name: values{field}};
        *hash<auto> result = header.msg.serializeDocument(header.part, NOTHING, NOTHING, header.encoded,
            \selected, False);
        if (selected.hasKey(header.msg.name)) {
            values{field} = selected{header.msg.name};
        } else {
            remove values{field};
        }
        return result;
    }

    private static auto prepareEncodedPartValue(auto value, string envelope_uri) {
        if (value.typeCode() != NT_HASH) {
            return value;
        }
        *hash<auto> attributes = value."^attributes^";
        hash<auto> expanded = XsdBase::getExpandedAttributes(attributes);
        string identity = type_qname(envelope_uri, "encodingStyle");
        if (expanded.hasKey(identity)) {
            if (expanded{identity}.typeCode() != NT_STRING
                    || XsdSimpleType::normalizeWhiteSpace(expanded{identity}, "collapse") != SOAP_ENCODING) {
                throw SOAP_DESERIALIZATION_ERROR, sprintf("unsupported SOAP encoding style %Y", expanded{identity});
            }
            hash<string, string> namespaces = XsdBase::getAttributeNamespaces(attributes);
            foreach string key in (keys attributes) {
                list<string> name = key.split(":");
                if (key == identity || (name.size() == 2 && name[1] == "encodingStyle"
                        && namespaces{name[0]} == envelope_uri)) {
                    remove value."^attributes^"{key};
                }
            }
        }
        return value;
    }

    private static hash<string, BindingMessageHeaderDescription> matchHeaders(BindingMessageDescription description,
            list<string> names) {
        hash<string, list<int>> candidates();
        hash<string, BindingMessageHeaderDescription> declarations();
        hash<string, list<int>> occurrences();
        for (int index = 0; index < names.size(); ++index) {
            push occurrences{names[index]}, index;
        }
        int id = 0;
        foreach BindingMessageHeaderDescription header in (description.getHeaders()) {
            string key = string(id++);
            foreach string identity in (header.getDocumentPartNames()) {
                if (occurrences{identity}) {
                    candidates{key} += occurrences{identity};
                    declarations{key} = header;
                }
            }
        }
        hash<string, int> assigned = XsdMessagePartMatcher::match(candidates, names.size(), True);
        hash<string, BindingMessageHeaderDescription> result();
        foreach hash<string, auto> entry in (assigned.pairIterator()) {
            result{string(entry.value)} = declarations{entry.key};
        }
        return result;
    }

    private static validateXmlPart(WSOperation op, WSMessage message, string part, XsdXmlValue value) {
        *XsdElement element = message.args{message.pmap{part}}.element;
        if (!element) {
            throw "WSDL-BINDING-ERROR", sprintf("retained XML part %y must reference an element", part);
        }
        try {
            element.validateXmlValue(value, op.nsc, message.tmap);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "PROGRAM-INTERRUPTED" || ex.err == "THREAD-CANCELLED") {
                rethrow;
            }
            throw SOAP_DESERIALIZATION_ERROR, sprintf("invalid XML for part %y: %s: %s", part, ex.err, ex.desc);
        }
    }

    auto deserializeMessageImpl(WSOperation op, hash<auto> orig_msg, bool request) {
        #printf("DEBUG: deserializeSoapMessage(%N, %y)\n", o, request);
        string io = request ? "input" : "output";
        # NOTE: types must be stripped on "o"; cannot use hash<auto> here
        hash o = orig_msg;
        XsdBase::inheritAttributeNamespaces(\o);
        WSDL::XsdBase::removeNS2(\o);
        WSDL::XsdBase::removeNS2(\o.Envelope);
        XsdQNameNamespaceScope envelope_scope(o.Envelope."^attributes^", True);
        hash<string, string> envelope_namespaces = XsdBase::getElementNamespaces(o.Envelope."^attributes^");
        hash<auto> hrv;

        *BindingMessageDescription bmd = self{io};
        hash<string, string> header_keys = bmd ? bmd.getHeaderMessageKeys(op{io}) : {};

        if (bmd && bmd.hasHeaders()) {
            XsdQNameNamespaceScope header_scope(o.Envelope.Header."^attributes^");
            *hash<auto> header = XsdScalarTextHelper::elementContent(o.Envelope.Header, "SOAP Header");
            if (header) {
                header = XsdBase::expandElementNamespaces(header, envelope_namespaces);
            }

            #printf("DEBUG: Deserialize SOAP headers: %N\n", header);
            list<string> header_names();
            list<auto> header_values();
            foreach string key in (keys header) {
                if (key =~ /^[\^.]/) {
                    continue;
                }
                string identity = key;
                identity =~ s/\^[0-9]+$//;
                list<auto> occurrences = header{key}.typeCode() == NT_LIST ? header{key} : (header{key},);
                foreach auto occurrence in (occurrences) {
                    push header_names, identity;
                    push header_values, occurrence;
                }
            }
            foreach hash<string, auto> entry in (matchHeaders(bmd, header_names).pairIterator()) {
                int index = int(entry.key);
                BindingMessageHeaderDescription hdr = entry.value;
                auto value = hdr.encoded ? prepareEncodedPartValue(header_values[index],
                    isSoap12() ? SOAP_12_ENV : SOAP_11_ENV) : header_values[index];
                hrv{header_keys{hdr.msg.getExpandedName()}} += hdr.msg.deserializeDocument(NOTHING,
                    {hdr.encoded ? type_qname("", hdr.part) : header_names[index]: value}, hdr.part, NOTHING, True);
            }
            #printf("DEBUG: Deserialized SOAP headers: %N\n", hrv);
        }

        XsdQNameNamespaceScope body_scope(o.Envelope.Body."^attributes^");
        *hash<auto> body = XsdScalarTextHelper::elementContent(o.Envelope.Body, "SOAP Body");

        if (!op{io}) {
            if (exists body) {
                throw SOAP_DESERIALIZATION_ERROR, sprintf("%s value given for operation %y binding %y with no %s message: %y", request ? "request" : "response", op.name, name, io, body);
            }
        } else if (!exists body) {
            if (docstyle && o.Envelope.hasKey("Body")
                    && !(bmd.getBodyPartNames(op{io}) ?? keys op{io}.pmap)) {
                body = {};
            } else {
                throw SOAP_DESERIALIZATION_ERROR, sprintf("no %s body value given for operation %y binding %y", request ? "request" : "response", op.name, name);
            }
        }

        *WSMessage msg = op{io};

        auto rv;
        if (exists body) {
            hash<auto> expanded_body = XsdBase::expandElementNamespaces(body, envelope_namespaces);
            hash<auto> msgh = docstyle ? expanded_body : body;
            *hash<auto> mrh;
            # Literal parts use their concrete schema: id and href can be ordinary attributes.
            # Only an encoded body supplies a SOAP reference context to schema value conversion.
            if (bmd.body.encoded) {
                (mrh, msgh) = processMultiRef(msgh);
            } else if (!docstyle) {
                WSDL::XsdBase::removeNS2(\msgh);
            }

            if (!request) {
                # check for Soap Fault, if so raise an exception immediately with the fault info
                WSDL::XsdBase::removeNS2(\body);

                if (body.Fault) {
                    WSDL::XsdBase::removeNS(\body.Fault);
                    delete body.Fault.".ns";
                    if (envelope_namespaces{o.Envelope.".ns" ?? ""} == SOAP_12_ENV) {
                        WSDL::XsdBase::removeNS(\body.Fault.Code);
                        WSDL::XsdBase::removeNS(\body.Fault.Reason);
                        # remove extraneous "ns" keys
                        remove body.Fault.Code.ns;
                        remove body.Fault.Reason.ns;
                        string desc = sprintf("The following fault response was received from the server: code: %y",
                            body.Fault.Code.Value);
                        auto sc = body.Fault.Code.Subcode;
                        while (exists sc) {
                            WSDL::XsdBase::removeNS(\sc);
                            # remove extraneous "ns" keys
                            remove sc.ns;
                            desc += sprintf(", subcode: %y", sc.Value);
                            sc = sc.Subcode;
                        }
                        foreach auto rn in (body.Fault.Reason.Text) {
                            desc += sprintf(", text: %y", rn);
                        }

                        throw "SOAP-SERVER-FAULT-RESPONSE", desc, body.Fault;
                    } else {
                        string desc = sprintf("The following fault response was received from the server: code: %y",
                            body.Fault.faultcode);
                        if (exists body.Fault.faultstring)
                            desc += sprintf(", faultstring: %y", body.Fault.faultstring);
                        if (exists body.Fault.desc)
                            desc += sprintf(", desc: %y", body.Fault.desc);

                        throw "SOAP-SERVER-FAULT-RESPONSE", desc, body.Fault;
                    }
                }
            }

            #any ns = msgh.".ns";
            msgh -= ("ns", ".ns");
            if (docstyle) {
                # only the parts appearing in the SOAP body may be deserialized from it; parts bound to SOAP
                # headers are deserialized above
                rv = msg.deserializeDocument(mrh, msgh, bmd.getBodyPartNames(msg), False, True);
            } else {
                string mname = op.name + (request ? "" : "Response");
                string wrapper_identity = type_qname(bmd.body.ns ?? op.nsc.getTargetNamespaceUri() ?? "", mname);
                if (!expanded_body.hasKey(wrapper_identity)) {
                    throw SOAP_DESERIALIZATION_ERROR, sprintf("expected SOAP RPC wrapper %Y for %s operation %Y",
                        wrapper_identity, io, op.name);
                }
                if (!msgh.hasKey(mname)) {
                    throw SOAP_DESERIALIZATION_ERROR, sprintf("missing %s message name %y as top-level element; got elements: %y", io, mname, keys msgh);
                }
                XsdQNameNamespaceScope rpc_scope(msgh{mname}."^attributes^");
                msgh = XsdScalarTextHelper::elementContent(remove msgh{mname}, "SOAP RPC wrapper") ?? {};
                XsdBase::removeNS2(\msgh);
                msgh -= (".ns", "ns");

                rv = msg.deserializeRpc(mrh, msgh, bmd.body.parts, False);
            }
        }

        if (exists hrv) {
            foreach BindingMessageHeaderDescription header in (bmd.getHeaders()) {
                if (header_keys{header.msg.getExpandedName()} != header.msg.name) {
                    return {"^body^": rv ?? {}, "^headers^": hrv};
                }
            }
            if (rv.typeCode() == NT_HASH && hrv.hasKey(msg.name)
                    && (select keys rv, hrv{msg.name}.hasKey($1))) {
                # Repeated part names in the two locations cannot use the legacy message-container
                # lookup on output: it would consume the header's value for the body part.
                return {"^body^": rv, "^headers^": hrv};
            }
            # Flatten only a non-wrapper body value whose keys cannot replace header messages.
            auto fv = rv.firstValue();
            if (rv.size() == 1 && rv.typeCode() == NT_HASH
                    && (!exists fv || (fv.typeCode() == NT_HASH && !(select keys fv, hrv.hasKey($1))
                        && !XsdNativeTypeValueHelper::isWrapper(fv) && !XsdElementValueHelper::isWrapper(fv)))) {
                rv = fv;
            } else if (rv.typeCode() == NT_HASH && (select keys rv, hrv.hasKey($1))) {
                if (hrv.hasKey(msg.name)) {
                    # Distinct part names share a message container without losing selected wrappers.
                    hrv{msg.name} += rv;
                    rv = NOTHING;
                } else {
                    rv = {msg.name: rv};
                }
            }
            rv += hrv;
        } else if (exists rv ) {
            # for backwards compatibility with a flat hash when there was only argument
            # but we must be care of when the argument is a type (not element)
            if (rv.size() == 1 && rv.typeCode() == NT_HASH) {
                rv = rv.firstValue();
            }
        }

        return rv;
    }

    #! processes multi-part references and returns a hash of multi-part reference info and the updated message body hash
    private:internal static list<auto> processMultiRef(hash<auto> body) {
        # setup message info hash and multiRef lookup hash key, if any are present
        hash<auto> mrh = {
            # save original msg body hash
            "body": body,
        };
        # remove namespace prefixes from body element keys
        WSDL::XsdBase::removeNS2(\mrh.body);

        # issue #2902: get all multiref elements with an "id" tag
        # SOAP 1.1 Section 5.4.1 defines multiref elements with:
        # - id: unique identifier for the element
        # - root: "1" = root element, "0" = not a root (referenced only), absent = may be root
        # - xsi:type: polymorphic type indicator
        foreach hash<auto> hh in (body.pairIterator()) {
            if (!exists hh.value."^attributes^".id) {
                continue;
            }
            hash<auto> h = remove body{hh.key};
            hash<auto> attrs = h."^attributes^";
            string id = remove h."^attributes^".id;

            # Process root attribute (SOAP 1.1 Section 5.4.1)
            # root="1" means this is a root element, root="0" means it's only referenced
            # If absent, the element may be a root
            *string rootAttr = attrs.root;
            if (rootAttr == "1") {
                # This is explicitly marked as a root element - keep track of it
                mrh.rootIds{id} = True;
            }
            remove h."^attributes^".root;

            # Process xsi:type attribute for polymorphic type resolution
            # Store the type info for use during deserialization
            *string xsiType = attrs."xsi:type";
            if (xsiType) {
                mrh.typeMap{id} = xsiType;
            }

            mrh.mrh{id} = h;
        }

        # resolve interior references to multiRefs
        foreach string id in (keys mrh.mrh) {
            foreach string key in (keys mrh.mrh{id}) {
                if (key == "^attributes^")
                    continue;

                #printf("multiRef id: %y key: %y val: %y\n", id, key, mrh.mrh{id}{key});

                if (mrh.mrh{id}{key}.typeCode() == NT_LIST) {
                    foreach auto e in (\mrh.mrh{id}{key}) {
                        auto href = substr(e."^attributes^".href, 1);
                        if (exists href) {
                            if (!exists mrh.mrh{href})
                                throw "INVALID-MULTIREF", sprintf("multiRef id: %y does not exist", href);
                            e = mrh.mrh{href};
                        }
                    }
                } else if (mrh.mrh{id}{key}.typeCode() == NT_HASH) {
                    auto href = substr(mrh.mrh{id}{key}."^attributes^".href, 1);
                    if (exists href) {
                        if (!exists mrh.mrh{href})
                            throw "INVALID-MULTIREF", sprintf("multiRef id: %y does not exist", href);
                        mrh.mrh{id}{key} = mrh.mrh{href};
                    }
                }
            }
        }

        #printf("mrh: %y\n", mrh.mrh);
        #printf("operation: %y\n", self);

        # remove namespace tags from element names
        WSDL::XsdBase::removeNS2(\body);
        remove body.".ns";

        return (mrh, body);
    }

    hash<auto> deserializeRequestPathImpl(WSOperation op, string path) {
        throw SOAP_DESERIALIZATION_ERROR, sprintf("cannot deserialize URI request path %y for SOAP binding %y", path, name);
    }
}

public class HttpBinding inherits WSDL::OperationalBinding {
    public {
        string httpMethod;
        string location;
    }

    constructor(string name, string ns, bool docstyle, string httpMethod, string location, *string soapAction,
            *WSDL::BindingMessageDescription input, *WSDL::BindingMessageDescription output)
            : OperationalBinding(name, ns, docstyle, soapAction, input, output) {
        self.httpMethod = httpMethod;
        self.location = location;
    }

    hash<auto> serializeMessageImpl(WSOperation op, *WSMessage msg, bool request, bool soap12, auto h,
            *hash<auto> header, string enc, *hash<auto> nsh, *int xml_opts, *string req_soapaction, *string faultmsg,
            *hash<auto> http_headers) {
        hash<auto> rv;

        if (request) {
            # make sure that rv stays hash<auto> instead of hash<string, string>
            rv = hash({
                "path": serializeRequestPath(op, h),
                "method": httpMethod,
            });
        }

        string io = request ? "input" : "output";

        string ct;

        *BindingMessageDescription bmd = self{io};
        if (!bmd) {
            throw SOAP_SERIALIZATION_ERROR, sprintf("no %s message description for message %y", io, name);
        }

        if (!msg && (bmd.content || bmd.mimeXml))
            throw SOAP_SERIALIZATION_ERROR, sprintf("%s value given for operation %y with no %s message: %y",
                request ? "request" : "response", name, io, h);

        if (bmd.content.formUrlEncoded || (request && bmd.urlEncoded && httpMethod == "POST")) {
            ct = MimeTypeFormUrlEncoded;
            # application/x-www-form-urlencoded Content-Type does not have any parameters
            delete enc;
            # Non-ASCII characters (> 127) are properly percent-encoded as UTF-8 bytes
            # per https://www.w3.org/TR/html5/forms.html#application/x-www-form-urlencoded-encoding-algorithm
            rv.body = mime_get_form_urlencoded_string(msg.serializeAllPartData(h));
        } else if (bmd.content) {
            hash<auto> v = msg.serializeData(op.nsc, bmd.content.part, h);
            if (v."content-type") {
                if (!bmd.content.acceptAllContentTypes) {
                    WsdlLibPriv::checkContentType(v."content-type", bmd.content.acceptedContentTypeSubtypes
                        + bmd.content.acceptedContentTypes);
                }
                ct = v."content-type";
            } else {
                if (bmd.content.acceptAllContentTypes || bmd.content.acceptedContentTypes
                    || bmd.content.acceptedContentTypeSubtypes.size() != 1) {
                    throw SOAP_SERIALIZATION_ERROR, sprintf("ambiguous content type in message %y related to %s "
                        "operation %y", msg.name, io, op.name);
                }
                ct = bmd.content.acceptedContentTypeSubtypes[0];
            }
            if (v.value.typeCode() == NT_BINARY) {
                delete enc;
                rv.body = v.value;
            } else {
                rv.body = convert_encoding(v.value, enc);
            }
        } else if (bmd.mimeXml) {
            ct = MimeTypeXml;
            # in case of mimeXml is body content, i.e. XML tag based on element/type name, not part
            string ons;
            hash<auto> hh;
            hh{msg.getSerializedKey(bmd.mimeXml.part)} = msg.serializeRpcValue(bmd.mimeXml.part, False, \h, \ons);
            rv.body = make_xml(hh);
        }

        # add request headers if necessary
        if (request) {
            if (output.content) {
                if (output.content.acceptAllContentTypes) {
                    rv.accept = "*/*";
                } else {
                    softlist<auto> l = output.content.acceptedContentTypeSubtypes;
                    map l += $1 + "*", output.content.acceptedContentTypes;
                    rv.accept = foldl $1 + "," + $2, l;
                }
            } else if (output.mimeXml) {
                rv.accept = MimeTypeXml;
            }
        }

        if (exists rv.body && exists ct) {
            if (exists enc) {
                ct += sprintf(";charset=%s", enc);
            }
            rv.hdr."Content-Type" = ct;
        }

        if (rv.accept) {
            rv.hdr."Accept" = rv.accept;
        }

        rv.hdr += http_headers;

        return rv;
    }

    #! serializes path part of URL when urlEncoded WSDL is defined
    private:internal string serializeRequestPath(WSOperation op, auto h) {
        if ((input.urlReplacement || input.urlEncoded) && exists h && h.typeCode() != NT_HASH) {
            throw SOAP_SERIALIZATION_ERROR, sprintf("HTTP URL arguments for operation %Y require a hash, got %y",
                op.name, h.type());
        }
        string path = location;
        if (input.urlReplacement) {
            path = "";
            foreach string k in (keys input.urlReplacement) {
                if (k =~ /^string/) {
                    path += input.urlReplacement{k};
                } else if (k =~ /^part/) {
                    if (!op.input) {
                        throw SOAP_SERIALIZATION_ERROR, sprintf("url replacement requested for operation %s with no message (%y)", op.name, h);
                    }
                    hash<auto> v = op.input.serializeData(op.nsc, input.urlReplacement{k}, h);
                    path += encode_url(string(v.value), True);
                }
            }
        } else if (input.urlEncoded && httpMethod != "POST") {
            string s = mime_get_form_urlencoded_string(op.input.serializeAllPartData(h));
            if (s) {
                path += location =~ /\?/ ? "&" : "?";
                path += s;
            }
        }

        return path;
    }

    auto deserializeMessageImpl(WSOperation op, hash<auto> v, bool request) {
        string io = request ? "input" : "output";

        *BindingMessageDescription bmd = self{io};
        if (!bmd) {
            if (!v.body.val()) {
                return;
            }
            throw SOAP_DESERIALIZATION_ERROR, sprintf("no %s message description for message %y", io, name);
        }

        *string ct = v."content-type";
        if (!exists ct && !bmd.mimeXml) {
            throw SOAP_DESERIALIZATION_ERROR, sprintf("missing content-type in input hash: %y", v);
        }

        if ((bmd.urlEncoded && httpMethod != "POST") || bmd.urlReplacement) {
            # is should be processed via deserializeUrl()
            throw SOAP_DESERIALIZATION_ERROR, sprintf("urlencoded message deserialization is not supported in "
                "binding: %y", name);
        }

        if (!op{io} && (bmd.content || bmd.mimeXml))
            throw SOAP_DESERIALIZATION_ERROR, sprintf("%s value given for operation %y with no %s message: %y",
                request ? "request" : "response", name, io, v);

        *WSMessage msg = op{io};

        if (bmd.content.formUrlEncoded || (request && bmd.urlEncoded && httpMethod == "POST")) {
            WsdlLibPriv::checkContentType(ct, list(MimeTypeFormUrlEncoded));
            if (v.body.typeCode() == NT_BINARY) {
                v.body = binary_to_string(v.body);
            }
            hash<auto> h = mime_parse_form_urlencoded_string(v.body); # TODO: data have no encoding
            return msg.deserializeAllPartData(h);
        }

        if (bmd.content) {
            if (!bmd.content.acceptAllContentTypes) {
                WsdlLibPriv::checkContentType(ct,
                    bmd.content.acceptedContentTypeSubtypes + bmd.content.acceptedContentTypes);
            }
            hash<auto> v2;
            v2{bmd.content.part} = v.body;
            hash<auto> h = msg.deserializeData(bmd.content.part, v2);
            string k = h.firstKey();
            h{k}."^value^" = remove h{k};
            h{k}."^attributes^"."^content-type^" = ct;
            return h;
        }

        if (bmd.mimeXml) {
            *hash<auto> h = msg.deserializeData(bmd.mimeXml.part, v);
            return h;
        }
    }

    #! checks whether a raw URI path matches this binding's URL-replacement template
    /** @param path the percent-encoded request path, without a handler mount prefix
        @return True when the complete template matches, otherwise False
        @throw URL-ENCODING-ERROR invalid percent encoding in a replacement value
        @note Matching checks path structure and repeated values; message types are checked during decoding.
        @par Example
        A template `/items/(id)/view` matches `/items/A%2FB/view` and supplies the id `A/B` during decoding.
        @since %WSDL 0.5.8
    */
    bool matchesRequestPath(string path) {
        return exists getRequestPathValues(path);
    }

    private *hash<auto> getRequestPathValues(string path) {
        if (!input.urlReplacement) {
            return NOTHING;
        }
        hash<auto> values = {};
        int pos = 0;
        list<string> tokens = keys input.urlReplacement;
        # Leading slashes do not change the operation-relative template.
        path = ltrim(path, "/");
        for (int i = 0; i < tokens.size(); ++i) {
            string key = tokens[i];
            if (key =~ /^string/) {
                string expected = input.urlReplacement{key};
                if (!i) {
                    expected = ltrim(expected, "/");
                }
                if (substr(path, pos, expected.size()) != expected) {
                    return NOTHING;
                }
                pos += expected.size();
            } else if (key =~ /^part/) {
                *string next_literal = i + 1 < tokens.size() && tokens[i + 1] =~ /^string/
                    ? input.urlReplacement{tokens[i + 1]} : NOTHING;
                int end = next_literal ? index(path, next_literal, pos) : index(path, "?", pos);
                if (end < 0) {
                    if (next_literal) {
                        return NOTHING;
                    }
                    end = path.size();
                }
                string name = input.urlReplacement{key};
                string value = decode_url(substr(path, pos, end - pos));
                if (values.hasKey(name) && values{name} != value) {
                    return NOTHING;
                }
                values{name} = value;
                pos = end;
            }
        }
        if (pos < path.size() && path[pos] != "?") {
            return NOTHING;
        }
        return values;
    }

    hash<auto> deserializeRequestPathImpl(WSOperation op, string path) {
        if (input.urlReplacement) {
            *hash<auto> values = getRequestPathValues(path);
            if (!exists values) {
                throw SOAP_DESERIALIZATION_ERROR, sprintf("request path %Y does not match URL replacement template %Y",
                    path, location);
            }
            return op.input.deserializeAllPartData(values);
        }
        if (input.urlEncoded) {
            hash<auto> h;
            if (index(path, "?") >= 0) {
                # any params ?
                int i = index(path, location);
                if (i >= 0) {
                    # strip potential prefix in URL params
                    path = substr(path, i + location.size());
                }
                # all parameters are in URL
                i = index(path, "?");
                if (i >= 0) {
                    path = substr(path, i+1);
                }
                i = 0;
                while (path[i] == "&") {
                    i++;
                }
                if (i) {
                    path = substr(path, i);
                }
                if (path != "") {
                    h = mime_parse_form_urlencoded_string(path);
                    return op.input.deserializeAllPartData(h);
                }
            }
            return {};
        }
        throw SOAP_DESERIALIZATION_ERROR, sprintf("BUG: cannot deserialize URI request path %y for HTTP binding %y", path, name);
    }
}

#! describes the message body for a SOAP operational binding message description
/** @see https://www.w3.org/TR/wsdl#_soap:body
*/
public class BindingMessageBodyDescription inherits Serializable {
    public {
        #! required attribute
        /** if @ref Qore::True "True", then use = \c "encoded" (each message part references an abstract type using the \c type attribute),
            otherwise use = \c "literal" (each part references a concrete schema definition using either the \c element or \c type attribute)
         */
        bool encoded;

        #! when encoded @ref Qore::True "True", this is used to produce a concrete message by applying the specified encoding
        *string encodingStyle;

        #! namespace; "only applies to content not explicitly defined by the abstract types"
        *string ns;

        #! Selected SOAP body part names; NOTHING means omitted, an empty list selects no parts
        *list<string> parts;
    }

    #! creates the body description and preserves explicit part selection
    /** @param encoded True for encoded use, False for literal use
        @param encodingStyle optional encoding-style URI list
        @param ns optional namespace for the RPC wrapper
        @param parts optional XML-whitespace-separated part names; an empty string selects no parts
        @throw WSDL-ERROR a part name is repeated
        @note Part references are checked against the selected operation message during binding construction.
    */
    constructor(bool encoded, *string encodingStyle, *string ns, *string parts) {
        self.encoded = encoded;
        self.encodingStyle = encodingStyle;
        self.ns = ns;
        if (exists parts) {
            string normalized = XsdSimpleType::normalizeWhiteSpace(parts, "collapse");
            self.parts = normalized ? normalized.split(" ") : ();
            hash<string, bool> seen();
            foreach string part in (self.parts) {
                if (seen{part}) {
                    throw WSDL_ERROR, sprintf("duplicate SOAP body part %Y", part);
                }
                seen{part} = True;
            }
        }
    }

    bool isMultipart() {
        return False;
    }
}

#! describes a SOAP message header for a SOAP operational binding message description
/** The description owns its message; input/output descriptions can share a message without relying on
    the lifetime of the source WebService. Saved legacy weak message references become owned on load.
*/
public class BindingMessageHeaderDescription inherits Serializable {
    public {
        #! message part name
        string part;

        #! True for SOAP-encoded values; False for literal schema values
        bool encoded;

        #! owned actual message, independent of the source service lifetime
        WSMessage msg;

        #! concrete namespace of an encoded accessor, when supplied by the binding
        *string ns;

        #! selected encoding URI list, or a literal-format hint for literal use
        *string encodingStyle;
    }

    private {
        list<BindingMessageHeaderDescription> headerfaults();
    }

    private:internal deserializeMembers(hash<auto> members) {
        if (!(members.msg instanceof WSMessage) || members.part.typeCode() != NT_STRING
                || members.encoded.typeCode() != NT_BOOLEAN
                || (exists members.ns && members.ns.typeCode() != NT_STRING)
                || (exists members.encodingStyle && members.encodingStyle.typeCode() != NT_STRING)) {
            throw "DESERIALIZATION-ERROR", "invalid SOAP header binding members";
        }
        validate(members.msg, members.part, members.encoded, members.encodingStyle, "DESERIALIZATION-ERROR");
        validateFaults(members.headerfaults, "DESERIALIZATION-ERROR", self);
        headerfaults = (remove members.headerfaults) ?? ();
        msg = remove members.msg;
        self += members;
    }

    #! creates an owned concrete header description
    /** @param part message part name
        @param encoded True for encoded use, False for literal use
        @param msg the owned message, which remains valid after its source service leaves scope
        @param namespace_uri the optional binding namespace of the encoded accessor
        @param encoding_style optional encoding URI list; literal use retains this as a format hint
        @param faults optional owned headerfault descriptions; nested headerfaults are invalid
        @throw WSDL-ERROR unknown part, incompatible encoded format or nested headerfault declarations
        @note Descriptions are shared by operation handles; do not mutate them while bindings are in use.
        @par Example
        A type-based authentication token can use namespace_uri = "urn:session" and
        encoding_style = SOAP_ENCODING independently of the operation's literal body.
    */
    constructor(string part, bool encoded = False, WSMessage msg, *string namespace_uri, *string encoding_style,
            *list<BindingMessageHeaderDescription> faults) {
        validate(msg, part, encoded, encoding_style, WSDL_ERROR);
        validateFaults(faults, WSDL_ERROR, self);
        headerfaults = faults ?? ();
        self.part = part;
        self.encoded = encoded;
        self.msg = msg;
        ns = namespace_uri;
        encodingStyle = encoding_style;
    }

    #! returns owned descriptions of faults concerning this header
    /** @return the headerfault declarations, or an empty list when none are declared
        @note Returned descriptors are shared and must not be mutated while bindings are in use.
        @par Example
        Inspect header.getHeaderFaults() to discover session-expiration error types.
    */
    list<BindingMessageHeaderDescription> getHeaderFaults() {
        return headerfaults;
    }

    private static validateFaults(auto faults, string error, BindingMessageHeaderDescription owner) {
        if (exists faults && faults.typeCode() != NT_LIST) {
            throw error, "SOAP headerfault descriptions require a list";
        }
        foreach auto fault in (faults) {
            if (!(fault instanceof BindingMessageHeaderDescription) || fault === owner || fault.getHeaderFaults()) {
                throw error, "a SOAP headerfault requires a header description without nested headerfaults";
            }
            foreach string identity in (fault.getDocumentPartNames()) {
                if (identity.startsWith("{}")) {
                    throw error, "a SOAP headerfault requires a namespace-qualified block";
                }
            }
        }
    }

    private static validate(WSMessage message, string part, bool encoded, *string encoding_style, string error) {
        if (!message.pmap.hasKey(part)) {
            throw error, sprintf("SOAP header references unknown part %Y in message %Y", part, message.name);
        }
        if (encoded && !message.args{message.pmap{part}}.type) {
            throw error, sprintf("encoded SOAP header part %Y must reference a type", part);
        }
        if (encoded && exists encoding_style
                && XsdSimpleType::normalizeWhiteSpace(encoding_style, "collapse") != SOAP_ENCODING) {
            throw error, sprintf("SOAP header part %Y selects unsupported encoding style %Y", part, encoding_style);
        }
    }

    #! returns the possible wire element identities for this header
    /** @return expanded accessor name for encoded use, or the literal part's declared element names
        @note Literal namespace/encoding hints do not override element declarations.
        @par Example
        A type-based token with namespace "urn:session" returns ("{urn:session}token",).
    */
    list<string> getDocumentPartNames() {
        return encoded ? (type_qname(ns ?? "", part),) : msg.getDocumentPartNames(part);
    }
}

#! describes MIME content information for SOAP operational binding message descriptions
/** @see https://www.w3.org/TR/wsdl#_mime:content
 */
public class BindingContentDescription inherits Serializable {
    public {
        #! specifies the name of the message part
        string part;

        # list of accepted content types (with "xxx/*")
        list<auto> acceptedContentTypes = ();

        # list of accepted specific content types
        list<auto> acceptedContentTypeSubtypes = ();

        #! are all content-types form URL encoded?
        bool formUrlEncoded = False;

        #! are all content-types accepted?
        bool acceptAllContentTypes = False;
    }

    addContentType(string type) {
        bool isFormUrlEncoded = (type == MimeTypeFormUrlEncoded);
        if (isFormUrlEncoded && (acceptedContentTypes || acceptedContentTypeSubtypes))
            throw WSDL_ERROR, sprintf("%y content type cannot be declared with other content-types: %y", MimeTypeFormUrlEncoded, (acceptedContentTypes + acceptedContentTypeSubtypes));
        if (!isFormUrlEncoded && formUrlEncoded)
            throw WSDL_ERROR, sprintf("%y content type cannot be declared in conjunction with the %y content-type (this last type cannot be mixed with other types)", type, MimeTypeFormUrlEncoded);
        if (isFormUrlEncoded && !formUrlEncoded)
            formUrlEncoded = True;

        if (!type || type == "*/*") {
            acceptAllContentTypes = True;
            return;
        }

        hash<auto> act;

        list<auto> st = type.split("/");
        if (st.size() != 2)
            throw WSDL_ERROR, sprintf("Content type %y does not match 'type/subtype' pattern", type);
        if (bindex(st[0], "*") != -1)
            throw WSDL_ERROR, sprintf("Content type %y contains unexpected asterisk in type part", type);

        act.type = st[0];

        # check for a wildcard
        if (st[1] == "*") {
            acceptedContentTypes += (st[0] + "/");
            return;
        }

        if (bindex(st[1], "*") != -1) {
            throw WSDL_ERROR, sprintf("Content type %y contains unexpected asterisk in subtype part", type);
        }

        acceptedContentTypeSubtypes += (st[0] + "/" + st[1]);
    }
}

#! describes a mimeXml payload for a SOAP operational binding message description
/** @see https://www.w3.org/TR/wsdl#_mime:mimeXml
 */
public class MimeXmlMessageDescription inherits Serializable {
    public {
        #! refers to a message part defining the concrete schema of the root XML element
        /** The part references a concrete schema using the element attribute for simple parts or type attribute for composite parts
         */
        string part;
    }

    constructor(string part) {
        self.part = part;
    }
}

#! describes an input or output message in a SOAP operational binding
public class BindingMessageDescription inherits Serializable {
    public {
        #! the description of the message body
        *WSDL::BindingMessageBodyDescription body;

        #! a hash of URL replacement values keyed by part name, values are URI paths
        /** @note for HTTP bindings only
         */
        *hash<auto> urlReplacement;

        #! indicates that all the message parts are encoded into the HTTP request URI using the standard URI-encoding rules
        /** ex: name1=value&name2=value...

            The names of the parameters correspond to the names of the message parts.
            Each value contributed by the part is encoded using a name=value pair.
            This may be used with GET to specify URL encoding, or with POST to specify a FORM-POST.
            For GET, the "?" character is automatically appended as necessary.

            @note for HTTP bindings only

            @see https://www.w3.org/TR/wsdl#_http:urlEncoded
         */
        bool urlEncoded = False;

        #! optional content-type descriptions
        *WSDL::BindingContentDescription content;

        #! optional mimeXml message scription
        *WSDL::MimeXmlMessageDescription mimeXml;

        #! multipart type (e.g., Mime::MPT_RELATED) if multipartRelated binding is used
        /** @see https://www.w3.org/TR/wsdl#_mime:multipartRelated
        */
        *string multipart;

        #! hash of part names to content types for multipart messages
        /** Keys are part names, values are content type strings or lists of content type strings
        */
        *hash<auto> parts;
    }

    private:internal {
        #! a list of WSDL::BindingMessageHeaderDescription objects
        list<BindingMessageHeaderDescription> headers = cast<list<BindingMessageHeaderDescription>>(());
    }

    addHeader(BindingMessageHeaderDescription hdr) {
        headers += hdr;
    }

    #! returns @ref Qore::True "True" if the header descriptions are available
    bool hasHeaders() {
        return !headers.empty();
    }

    #! returns a list of WSDL::BindingMessageHeaderDescription objects
    list<BindingMessageHeaderDescription> getHeaders() {
        return headers;
    }

    #! returns stable header container names for this message direction
    /** @param message the body message, or NOTHING when no body message is selected
        @return a map from expanded header message identities to value-container keys; local names are
        retained only when unambiguous among the body and header messages
        @note Names depend on the binding declarations, not on which optional headers appear in a payload.
        @par Example
        Two imported Session messages use `{urn:billing}Session` and `{urn:shipping}Session` containers.
    */
    hash<string, string> getHeaderMessageKeys(*WSMessage message) {
        hash<string, hash<string, bool>> identities();
        if (message) {
            identities{message.name}{message.getExpandedName()} = True;
        }
        foreach BindingMessageHeaderDescription header in (headers) {
            identities{header.msg.name}{header.msg.getExpandedName()} = True;
        }
        hash<string, string> fields();
        foreach BindingMessageHeaderDescription header in (headers) {
            string identity = header.msg.getExpandedName();
            fields{identity} = identities{header.msg.name}.size() > 1 ? identity : header.msg.name;
        }
        return fields;
    }

    #! returns the names of the message parts that appear in the SOAP body
    /** if the \c parts attribute is given in the \c soap:body element, then it determines the body parts, otherwise
        all parts of the message appear in the body, including parts also bound to a SOAP header

        @param msg the message bound to this description; retained for API compatibility

        @return the names of the parts appearing in the SOAP body, or \c NOTHING if all parts of the message
        appear in the body; an explicit empty selection returns an empty list

        @see https://www.w3.org/TR/wsdl#_soap:body

        @since %WSDL 0.5.8
    */
    *list<string> getBodyPartNames(WSMessage msg) {
        return body.parts;
    }

    setUrlReplacement(string loc) {
        int i = 0;
        while (i < loc.size()) {
            int j = index(loc, "(", i);
            if (j < 0) {
                j = loc.size();
            }
            if (j > i) {
                urlReplacement{sprintf("string^%d", urlReplacement.size() + 1)} = substr(loc, i, j - i);
            }
            if (j < loc.size()) {
                i = j + 1;
                j = index(loc, ")", i);
                if (j == i) {
                    throw WSDL_ERROR, sprintf("empty replace token in %y near %y", loc, substr(loc, i-1, loc.size()));
                } else if (j < 0) {
                    throw WSDL_ERROR, sprintf("missing close parentheses in %y near %y", loc, substr(loc, i-1, loc.size()));
                }
                string p = substr(loc, i, j-i);
                # if (messages)   TODO test messages / part here probably not ?
                urlReplacement{sprintf("part^%d", urlReplacement.size() + 1)} = p;
                ++j;
            }
            i = j;
        }
    }
}

#! class for WSDL bindings
public class Binding inherits WSDL::XsdNamedData {
    private:internal {
        string port;

        #! use RPC or document style
        /** according to https://www.w3.org/TR/wsdl#_soap:operation
            'If the soap:binding element does not specify a style, it is assumed to be "document".'
         */
        bool docstyle = True;

        *string httpMethod;
        *string soapTransport;
        *bool soap12_version;
    }

    private {
        *string component_key;
        const FaultAttributes = {"name": True, "use": True, "namespace": True, "encodingStyle": True};
        const HeaderAttributes = {"message": True, "part": True, "use": True, "namespace": True,
            "encodingStyle": True};
    }

    #! returns this binding's unambiguous component selection key
    /** @return the local name when unique, otherwise its expanded QName; old standalone bindings use their name
        @since %WSDL 0.5.8
    */
    string getComponentKey() {
        return component_key ?? name;
    }

    #! compiles a binding in its declaration's namespace context
    /** @param data the binding XML data
        @param nsc the containing document's namespace context
        @param portTypes port type component keys mapped to their declarations
        @param idocmap document body elements used for request dispatch
        @param messages message component keys mapped to their declarations
        @param registry optional internal registry for imported component identities
        @throw WSDL-ERROR invalid binding declarations or unresolved references
    */
    constructor(hash<auto> data, Namespaces nsc, reference portTypes, reference idocmap, *hash<auto> messages,
            *WsdlComponentRegistry registry) : XsdNamedData(\data) {
        component_key = registry ? registry.key("binding", nsc.getTargetNamespaceUri(), name) : name;
        NamespacePrefixHelper binding_scope(nsc, data."^attributes^");
        # get binding attributes
        {
            *hash<auto> ba = data."^attributes^";

            (*string ns, *string prt) = ba.type =~ x/(?:([^:]+):)?([^:]+)/;
            if (!prt)
                throw WSDL_ERROR, sprintf("missing port type for binding %y", name);
            port = registry ? registry.resolve("portType", ba.type, nsc) : prt;
        }

        if (data.binding.typeCode() != NT_HASH) {
            throw WSDL_ERROR, sprintf("binding %Y requires exactly one SOAP or HTTP binding extension", name);
        }
        {
            *hash<auto> bba = data.binding."^attributes^";
            NamespacePrefixHelper extension_scope(nsc, bba);
            string binding_uri = data.binding.ns ? nsc.getInputNamespaceUri(data.binding.ns)
                : nsc.getDefaultNs() ?? "";
            if (binding_uri == HTTP_NS) {
                if (!bba.verb || exists bba.transport) {
                    throw WSDL_ERROR, sprintf("HTTP binding %Y requires a verb and cannot declare a SOAP transport", name);
                }
                httpMethod = bba.verb;
            } else if (binding_uri == SOAP_11_NS || binding_uri == SOAP_12_NS) {
                if (exists bba.verb || !SOAP_TRANSPORT{bba.transport}) {
                    throw WSDL_ERROR, sprintf("SOAP binding %Y requires a supported transport and cannot declare "
                        "an HTTP verb (transport: %Y)", name, bba.transport);
                }
                soapTransport = bba.transport;
                soap12_version = binding_uri == SOAP_12_NS;
                if (exists bba.style) {
                    *bool ds = SoapStyleMap{bba.style};
                    if (!exists ds) {
                        throw WSDL_ERROR, sprintf("invalid style %Y in binding %Y; expected one of: %Y",
                            bba.style, name, keys SoapStyleMap);
                    }
                    docstyle = ds;
                }
            } else {
                throw WSDL_ERROR, sprintf("unsupported binding extension namespace %Y in binding %Y", binding_uri, name);
            }
        }

        foreach hash<auto> ophash in (data.operation) {
            NamespacePrefixHelper operation_scope(nsc, ophash."^attributes^");
            string opname = ophash."^attributes^".name;
            WSDL::XsdBase::removeNS(\ophash);
            *WSOperation selected = WsdlOperationLookup::find(portTypes{port}, opname,
                ophash.input."^attributes^".name, ophash.output."^attributes^".name, NOTHING, WSDL_ERROR);
            if (!selected) {
                throw WSDL_ERROR, sprintf("binding %Y references an unknown operation signature %Y(%Y,%Y) "
                    "in port type %Y", name, opname, ophash.input."^attributes^".name,
                    ophash.output."^attributes^".name, port);
            }

            *WsdlOperationPattern pattern = selected.getMessageExchangePattern();
            if (pattern != WsdlOperationPattern::OneWay && pattern != WsdlOperationPattern::RequestResponse) {
                throw WSDL_ERROR, sprintf("binding %Y cannot bind operation %Y with unsupported interaction pattern %Y; "
                    "standard SOAP and HTTP bindings support one-way and request-response", name, opname, pattern);
            }

            bool b_docstyle = docstyle;

            *hash<auto> opah = ophash.operation."^attributes^";
            *string soapAction = opah.soapAction;
            if (!exists soapAction) {
                *string op_ns = selected.nsc.getTargetNamespaceUri();
                if (op_ns && op_ns !~ /\/$/)
                    op_ns += "/";
                soapAction = op_ns ? op_ns + opname : opname;
            }

            {
                *string style = opah.style;
                if (exists style) {
                    *bool ds = SoapStyleMap{style};
                    if (!exists ds)
                        throw WSDL_ERROR, sprintf("invalid '\"style\" attribute %y in binding %y operation %y; expected one of: %y", style, name, opname, SoapStyleMap.keys());
                    b_docstyle = ds;
                }
            }

            if (b_docstyle)
                selected.setDocStyleBinding(\idocmap);
            else
                selected.markRpcStyleBinding();

            *string location;

            if (httpMethod) {
                location = ophash.operation."^attributes^".location;
                if (!location) {
                    throw WSDL_ERROR, sprintf("location is missing binding %y, operation %y", name, opname);
                }
            }

            # input/output hash
            hash<auto> ioh;
            hash<auto> op = remove ophash{"input", "output"};

            foreach string io in (keys op) {
                NamespacePrefixHelper io_scope(nsc, op{io}."^attributes^");
                WSDL::XsdBase::removeNS(\op{io});
                if (!exists selected{io}) {
                    *hash<auto> hk = map {$1: True}, keys op{io};
                    remove hk.("header", "ns");
                    if (hk)
                        throw WSDL_ERROR, sprintf("binding %y for operation %y does not reference %s message in porttype %y",  name, opname, io, port);
                }

                BindingMessageDescription bmd();

                if (exists op{io}.body) {
                    hash<auto> bh = remove op{io}.body;
                    *hash<auto> pa = bh."^attributes^";

                    *bool encoded = SoapUseMap{pa.use};
                    if (!exists encoded)
                        throw WSDL_ERROR, sprintf("binding %y for operation %y for the %s message has an invalid 'use' attribute: %y", name, opname, io, pa.use);

                    bmd.body = new BindingMessageBodyDescription(encoded, pa.encodingStyle, pa."namespace", pa.parts);
                }

                if (exists op{io}.multipartRelated) {
                    if (bmd.body) {
                        throw WSDL_ERROR, sprintf("%s binding %y for operation %y specifies both body and "
                            "multipart elements", io, name, opname);
                    }

                    bmd.multipart = Mime::MPT_RELATED;
                    bmd.parts = {};
                    WSDL::XsdBase::removeNS(\op{io}.multipartRelated);

                    if (!exists op{io}.multipartRelated.part) {
                        throw WSDL_ERROR, sprintf("binding %y is missing part definition(s) in %s message "
                            "definition for operation %y: %y", name, io, opname, op);
                    }

                    foreach auto part in (op{io}.multipartRelated.part) {
                        WSDL::XsdBase::removeNS(\part);
                        part -= "^attributes^";
                        if (exists part.body) {
                            if (bmd.body) {
                                throw WSDL_ERROR, sprintf("%s binding %y for operation %y specifies multiple "
                                    "body parts in multipart elements", io, name, opname);
                            }
                            auto bodyAttrs = part.body."^attributes^";
                            if (bodyAttrs.use != "literal") {
                                throw WSDL_ERROR, sprintf("unsupported body part without use=\"literal\": %y",
                                    part.body);
                            }
                            # Create body description for the SOAP body part within multipart message
                            bmd.body = new BindingMessageBodyDescription(False, NOTHING, NOTHING,
                                bodyAttrs.parts);
                        } else if (exists part.content) {
                            *string pcname;
                            foreach auto c in (part.content) {
                                WSDL::XsdBase::removeNS(\c);
                                auto contentAttrs = c."^attributes^";
                                auto partName = contentAttrs.part;
                                if (!exists partName) {
                                    throw WSDL_ERROR, sprintf("unsupported content part without part "
                                        "attribute: %y", c);
                                }
                                if (pcname) {
                                    if (pcname != partName) {
                                        throw WSDL_ERROR, sprintf("multiple content part names inside part "
                                            "section: %y!=%y", partName, pcname);
                                    }
                                } else {
                                    pcname = partName;
                                    partName = selected{io}.checkPart(partName);
                                }
                                auto contentType = contentAttrs.type;
                                if (!exists contentType) {
                                    throw WSDL_ERROR, sprintf("unsupported content part without type "
                                        "attribute: %y", c);
                                }

                                if (!exists bmd.parts{partName}) {
                                    bmd.parts{partName} = contentType;
                                } else {
                                    if (bmd.parts{partName}.typeCode() != NT_LIST) {
                                        bmd.parts{partName} = list(bmd.parts{partName});
                                    }
                                    bmd.parts{partName} += contentType;
                                }
                            }
                        } else {
                            throw WSDL_ERROR, sprintf("cannot parse part: %y", part);
                        }
                    }
                    delete op{io}.multipartRelated;
                }

                foreach string part in (bmd.body.parts) {
                    if (!selected{io}.pmap.hasKey(part)) {
                        throw WSDL_ERROR, sprintf("binding %Y for %s operation %Y selects unknown body part %Y",
                            name, io, opname, part);
                    }
                }

                if (exists op{io}.header) {
                    foreach hash<auto> hdr in (op{io}.header) {
                        bmd.addHeader(parseHeader(hdr, nsc, messages, registry, True));
                    }
                    delete op{io}.header;
                }

                if (op{io}.hasKey("urlReplacement")) {
                    if (!location)
                        throw WSDL_ERROR, sprintf("%s binding %y for operation %y has a 'urlReplacement' element but does not use HTTP binding", io, name, opname);

                    bmd.setUrlReplacement(location);
                    delete op{io}.urlReplacement;
                }

                if (op{io}.hasKey("urlEncoded")) {
                    if (!location)
                        throw WSDL_ERROR, sprintf("%s binding %y for operation %y has a 'urlEncoded' element but does not use HTTP binding", io, name, opname);

                    bmd.urlEncoded = True;
                    delete op{io}.urlEncoded;
                }

                if (exists op{io}.content) {
                    BindingContentDescription bcd();

                    foreach auto cnt in (op{io}.content) {
                        WSDL::XsdBase::removeNS(\cnt);
                        cnt = remove cnt."^attributes^";

                        bcd.addContentType(cnt.type);

                        if (bcd.formUrlEncoded)
                            continue;

                        string part = checkMessagePart(selected{io}, cnt.part, sprintf("content %s operation %y", io, opname));
                        if (exists bcd.part) {
                            if (bcd.part != part) {
                                throw WSDL_ERROR, sprintf("ambiguous part %y in message %y in binding %y for %s operation %y", part, selected{io}.name, name, io, opname);
                            }
                        } else {
                            bcd.part = part;
                        }
                    }

                    bmd.content = bcd;
                    delete op{io}.content;
                }

                if (op{io}.hasKey("mimeXml")) {
                    string part = checkMessagePart(selected{io}, op{io}.mimeXml."^attributes^".part, sprintf("%s operation %y", io, opname));
                    bmd.mimeXml = new MimeXmlMessageDescription(part);
                    delete op{io}.mimeXml;
                }

                delete op{io}.("^attributes^", "ns");

                if (op{io}) {
                    throw WSDL_ERROR, sprintf("unknown element(s) in binding %y for %s operation %y: %y", name, io, opname, keys op{io});
                }

                ioh{io} = bmd;
            }

            if (ioh.output.content.formUrlEncoded) {
                throw WSDL_ERROR, sprintf("%y type is not supported as output type in binding %y for output operation %y", MimeTypeFormUrlEncoded, name, opname);
            }

            hash<string, BindingMessageBodyDescription> fault_bindings();
            foreach hash<auto> declaration in (ophash.fault) {
                XsdBase::removeNS(\declaration);
                string fault_name = declaration."^attributes^".name;
                NamespacePrefixHelper fault_scope(nsc, declaration."^attributes^");
                *WSMessage fault_message = selected.getFaultMessages(){fault_name};
                if (!soapTransport || !fault_message) {
                    throw WSDL_ERROR, sprintf("binding %Y references undefined or unsupported fault %Y", name, fault_name);
                }
                if (fault_message.pmap.size() != 1) {
                    throw WSDL_ERROR, sprintf("SOAP fault %Y requires exactly one message part", fault_name);
                }
                if (declaration.fault.typeCode() != NT_HASH) {
                    throw WSDL_ERROR, sprintf("SOAP fault %Y requires exactly one fault extension", fault_name);
                }
                hash<auto> attributes = declaration.fault."^attributes^";
                NamespacePrefixHelper extension_scope(nsc, attributes);
                foreach string attribute in (keys attributes) {
                    if (attribute != "xmlns" && !attribute.contains(":")
                            && !FaultAttributes.hasKey(attribute)) {
                        throw WSDL_ERROR, sprintf("SOAP fault %Y has unsupported attribute %Y", fault_name, attribute);
                    }
                }
                if (declaration.fault - ("^attributes^", "ns")) {
                    throw WSDL_ERROR, sprintf("SOAP fault %Y cannot contain child content", fault_name);
                }
                string uri = declaration.fault.ns ? nsc.getInputNamespaceUri(declaration.fault.ns)
                    : nsc.getDefaultNs() ?? "";
                if (uri != (soap12_version ? SOAP_12_NS : SOAP_11_NS) || attributes.name != fault_name) {
                    throw WSDL_ERROR, sprintf("SOAP fault %Y has mismatched name or extension namespace", fault_name);
                }
                *bool encoded = SoapUseMap{attributes.use};
                if (!exists encoded) {
                    throw WSDL_ERROR, sprintf("SOAP fault %Y has invalid use %Y", fault_name, attributes.use);
                }
                if (encoded && !fault_message.args.firstValue().type) {
                    throw WSDL_ERROR, sprintf("encoded SOAP fault %Y must reference a type-based message part",
                        fault_name);
                }
                fault_bindings{fault_name} = new BindingMessageBodyDescription(encoded,
                    attributes.encodingStyle, attributes."namespace");
            }

            OperationalBinding b = soapTransport
                ? new SoapBinding(getComponentKey(), ophash.ns ?? "", b_docstyle, soapTransport, soapAction,
                    ioh.input, ioh.output, soap12_version, fault_bindings)
                : new HttpBinding(getComponentKey(), ophash.ns ?? "", b_docstyle, httpMethod, location, soapAction, ioh.input, ioh.output);

            selected.addBinding(b,
                sprintf("{%s}%s", nsc.getTargetNamespaceUri() ?? "", name));
        }

        #binding = data;
    }

    private BindingMessageHeaderDescription parseHeader(hash<auto> declaration, Namespaces nsc,
            *hash<auto> messages, *WsdlComponentRegistry registry, bool allow_faults) {
        XsdBase::removeNS(\declaration);
        *hash<auto> attributes = declaration."^attributes^";
        NamespacePrefixHelper scope(nsc, attributes);
        string uri = declaration.ns ? nsc.getInputNamespaceUri(declaration.ns) : nsc.getDefaultNs() ?? "";
        if (!soapTransport || uri != (soap12_version ? SOAP_12_NS : SOAP_11_NS)) {
            throw WSDL_ERROR, sprintf("header/headerfault in binding %Y has a mismatched extension namespace", name);
        }
        foreach string attribute in (keys attributes) {
            if (attribute != "xmlns" && !attribute.contains(":") && !HeaderAttributes.hasKey(attribute)) {
                throw WSDL_ERROR, sprintf("header/headerfault in binding %Y has unsupported attribute %Y", name, attribute);
            }
        }
        if (!attributes.message || !attributes.part) {
            throw WSDL_ERROR, sprintf("header/headerfault in binding %Y requires message and part attributes", name);
        }
        if (declaration - ("^attributes^", "ns", "headerfault") || (!allow_faults && declaration.hasKey("headerfault"))) {
            throw WSDL_ERROR, sprintf("header/headerfault in binding %Y has invalid child content", name);
        }
        hash<auto> identity = nsc.getTypeHash(attributes.message);
        string key = registry ? registry.resolve("message", attributes.message, nsc) : identity.val;
        *WSMessage message = messages{key};
        if (!message) {
            throw WSDL_ERROR, sprintf("header/headerfault in binding %Y references unknown message %Y", name, attributes.message);
        }
        *bool encoded = SoapUseMap{attributes.use};
        if (!exists encoded) {
            throw WSDL_ERROR, sprintf("header/headerfault in binding %Y has invalid use %Y", name, attributes.use);
        }
        list<BindingMessageHeaderDescription> faults();
        foreach auto fault in (declaration.headerfault) {
            if (fault.typeCode() != NT_HASH) {
                throw WSDL_ERROR, sprintf("headerfault in binding %Y requires a description", name);
            }
            push faults, parseHeader(fault, nsc, messages, registry, False);
        }
        return new BindingMessageHeaderDescription(attributes.part, encoded, message, attributes."namespace",
            attributes.encodingStyle, faults);
    }

    #! check if part exists in massage, if part is empty and message contains single part then return it otherwise raise an exception
    private:internal string checkMessagePart(WSMessage msg, *string partname, string errs) {
        if (exists partname) {
            msg.checkPart(partname);
            return partname;
        }
        if (msg.pmap.size() == 1) {  # some args may be defined without part name so use pmap to test
            return msg.pmap.firstKey();
        } else {
            throw WSDL_ERROR, sprintf("message %y must have exactly one part to resolve the part name with binding "
                "%y: %s (parts: %y args: %y)", msg.name, name, errs, keys msg.pmap, keys msg.args);
        }
    }

    string getPort() {
        return port;
    }

    bool isSoapBinding() {
        return exists soapTransport;
    }

    #! returns True if this binding declares the SOAP 1.2 extension
    /** @return True for SOAP 1.2, False for SOAP 1.1 or HTTP
        @throw WSDL-BINDING-ERROR a legacy standalone SOAP binding has no version metadata; reload its WSDL
    */
    bool isSoap12() {
        if (!isSoapBinding()) {
            return False;
        }
        if (!exists soap12_version) {
            throw "WSDL-BINDING-ERROR", sprintf("SOAP binding %Y has no saved protocol version; reload its WSDL", name);
        }
        return soap12_version;
    }

    bool isHttpBinding() {
        return exists httpMethod;
    }
}

# private namespace prefix redefinition class
class NamespacePrefixHelper {
    public {
    }

    private {
        #! namespaces data
        Namespaces nsc;

        # complete input maps before entering this declaration's scope
        hash<string, hash<string, string>> input_state;
        bool active = False;

        # overridden target namespace
        bool targ_ns;

        # overridden default namespace
        bool def_ns;

        # schema description
        string desc;

        #! schema internal ID
        int id = ++count;

        #! schema ID counter
        static int count = 0;
    }

    constructor(Namespaces nsc, *hash<auto> nsattr, bool schema_scope = False) {
        self.nsc := nsc;
        input_state = nsc.getInputNamespaceState();
        active = True;
        on_error restore();

        if (schema_scope) {
            nsc.pushSchemaTargetNamespace(nsattr.targetNamespace);
            targ_ns = True;
        }
        if (nsattr) {
            nsc.addNamespaces(nsattr, self);
            if (nsattr.targetNamespace && !schema_scope) {
                nsc.pushTargetNamespace(nsattr.targetNamespace);
                targ_ns = True;
                desc = sprintf("schema-%d-targetNamespace:%s", id, nsattr.targetNamespace);
            }
            if (exists nsattr.xmlns) {
                nsc.pushDefaultNamespace(nsattr.xmlns);
                def_ns = True;
                if (!desc) {
                    desc = sprintf("schema-%d-xmlns:%s", id, nsattr.xmlns);
                }
            }
        }

        if (!desc) {
            desc = sprintf("schema-%d", id);
        }
    }

    destructor() {
        restore();
    }

    private restore() {
        if (!active) {
            return;
        }
        active = False;
        if (def_ns) {
            nsc.popDefaultNamespace();
        }
        if (targ_ns) {
            nsc.popTargetNamespace();
        }
        nsc.restoreInputNamespaceState(input_state);
    }

    string getDesc() {
        return desc;
    }
}

#! Shared completed global attributes for a schema's declaration namespace contexts
/** Serialized provider graphs retain this registry independently of their source schema.
    @note Replacement is a schema-construction operation and must precede concurrent reads.
    @since %WSDL 0.5.8
*/
public class XsdGlobalAttributeRegistry inherits Serializable {
    private {
        hash<string, XsdAttribute> attributes();
    }
    private:internal deserializeMembers(hash<auto> members) {
        if (members.attributes.typeCode() != NT_HASH) {
            throw "DESERIALIZATION-ERROR", "a global attribute registry requires its declaration map";
        }
        foreach auto value in (members.attributes.iterator()) {
            if (!(value instanceof XsdAttribute)) {
                throw "DESERIALIZATION-ERROR", "a global attribute registry requires attribute declarations";
            }
        }
        attributes = members.attributes;
    }
    #! replaces the completed declaration map
    /** @param attributes global attributes indexed by expanded name */
    replace(hash<string, XsdAttribute> attributes) {
        self.attributes = attributes;
    }
    #! resolves a global attribute
    /** @param identity the expanded name
        @return its declaration, or NOTHING if it is not available
    */
    *XsdAttribute get(string identity) {
        return attributes{identity};
    }
}

#! Shared completed global elements for instance wildcard assessment
/** Declaration namespace contexts and detached providers retain the same registry.
    @note Schema construction publishes a complete map before concurrent reads.
    @par Example
    A detached invoice provider can validate a globally declared partner quantity after the caller
    releases the schema object that originally loaded that declaration.
    @since %WSDL 0.5.8
*/
public class XsdGlobalElementRegistry inherits Serializable {
    private {
        hash<string, XsdElement> declarations();
        hash<string, XsdAbstractType> types();
    }
    private:internal deserializeMembers(hash<auto> members) {
        if (members.declarations.typeCode() != NT_HASH) {
            throw "DESERIALIZATION-ERROR", "a global element registry requires its declaration map";
        }
        foreach auto value in (members.declarations.iterator()) {
            if (!(value instanceof XsdElement)) {
                throw "DESERIALIZATION-ERROR", "a global element registry requires element declarations";
            }
        }
        if (members.types.typeCode() != NT_HASH) {
            throw "DESERIALIZATION-ERROR", "a global element registry requires its named type map";
        }
        foreach auto value in (members.types.iterator()) {
            if (!(value instanceof XsdAbstractType)) {
                throw "DESERIALIZATION-ERROR", "a global element registry requires named type definitions";
            }
        }
        declarations = members.declarations;
        types = members.types;
    }
    #! publishes completed declarations
    /** @param declarations declarations indexed by expanded name
        @param types named types available for instance-type assessment
    */
    replace(hash<string, XsdElement> declarations, hash<string, XsdAbstractType> types) {
        self.declarations = declarations;
        self.types = types;
    }
    #! resolves a global element by its expanded name
    /** @param identity expanded name
        @return the declaration, or NOTHING when unavailable
    */
    *XsdElement get(string identity) {
        return declarations{identity};
    }
    #! returns the named types available for wildcard assessment
    /** @return types indexed by expanded name */
    hash<string, XsdAbstractType> getTypes() {
        return types;
    }
}

#! Expanded identity and identifiers of a schema notation declaration
/** Identifier strings use XSD whitespace collapse. An empty identifier is distinct from an absent one.
    @since %WSDL 0.5.8
*/
public hashdecl XsdNotationInfo {
    #! Namespace URI, or the empty string for no namespace
    string namespace_uri;
    #! Normalized NCName
    string local_name;
    #! Public identifier, if present
    *string public_id;
    #! System identifier, if present
    *string system_id;
}

class XsdNotationDeclarationHelper {
    static hash<XsdNotationInfo> normalize(auto input, string error) {
        if (input.typeCode() != NT_HASH || input.namespace_uri.typeCode() != NT_STRING
                || input.local_name.typeCode() != NT_STRING) {
            throw error, "a notation declaration requires namespace URI and local name strings";
        }
        string name = XsdSimpleType::normalizeWhiteSpace(input.local_name, "collapse");
        if (!Namespaces::isNCName(name)) {
            throw error, sprintf("invalid notation declaration name %Y", name);
        }
        if (input.namespace_uri =~ /[^\x{9}\x{A}\x{D}\x{20}-\x{D7FF}\x{E000}-\x{FFFD}\x{10000}-\x{10FFFF}]/) {
            throw error, "a notation namespace URI must contain XML 1.0 characters";
        }
        if (!exists input.public_id && !exists input.system_id) {
            throw error, "a notation declaration requires a public or system identifier";
        }
        hash<XsdNotationInfo> result = <XsdNotationInfo>{"namespace_uri": input.namespace_uri,
            "local_name": name, "public_id": NOTHING, "system_id": NOTHING};
        foreach string key in ("public_id", "system_id") {
            if (exists input{key}) {
                if (input{key}.typeCode() != NT_STRING
                        || input{key} =~ /[^\x{9}\x{A}\x{D}\x{20}-\x{D7FF}\x{E000}-\x{FFFD}\x{10000}-\x{10FFFF}]/) {
                    throw error, sprintf("notation %s requires XML character text", key);
                }
                result{key} = XsdSimpleType::normalizeWhiteSpace(input{key}, "collapse");
            }
        }
        return result;
    }

    static attributes(XmlReader reader) {
        hash<auto> values();
        if (reader.moveToFirstAttribute()) {
            on_exit reader.moveToElement();
            do {
                string uri = reader.namespaceUri() ?? "";
                string local = reader.localName();
                if (uri && uri != XSD_NS) {
                    continue;
                }
                if (uri || (local != "name" && local != "id" && local != "public" && local != "system")) {
                    throw WSDL_ERROR, sprintf("unexpected notation attribute {%s}%s", uri, local);
                }
                values{local} = reader.value();
            } while (reader.moveToNextAttribute());
        }
        hash<XsdNotationInfo> checked = normalize({"namespace_uri": "", "local_name": values.name,
            "public_id": values.public, "system_id": values.system}, WSDL_ERROR);
        if (exists values.id) {
            string id = XsdSimpleType::normalizeWhiteSpace(values.id, "collapse");
            if (!Namespaces::isNCName(id)) {
                throw WSDL_ERROR, sprintf("invalid notation declaration ID %Y", values.id);
            }
        }
    }
}

#! Shared notation declarations retained by detached schema types and providers
/** Construction publishes complete maps before concurrent reads, like the global element registry.
    Returned metadata hashes use value semantics; changing a returned hash does not modify the registry.
    @par Example
    A saved catalog field can resolve \c "{urn:media}jpeg" without retaining its original schema object.
    @since %WSDL 0.5.8
*/
public class XsdNotationRegistry inherits Serializable {
    private {
        hash<string, hash<XsdNotationInfo>> declarations();
    }

    private:internal deserializeMembers(hash<auto> members) {
        declarations = checked(members.declarations, "DESERIALIZATION-ERROR");
    }

    private static hash<string, hash<XsdNotationInfo>> checked(auto input, string error) {
        if (input.typeCode() != NT_HASH) {
            throw error, "a notation registry requires a declaration map";
        }
        hash<string, hash<XsdNotationInfo>> result();
        foreach string key in (keys input) {
            hash<XsdNotationInfo> value = XsdNotationDeclarationHelper::normalize(input{key}, error);
            if (key != type_qname(value.namespace_uri, value.local_name)) {
                throw error, sprintf("notation registry key %Y does not match its declaration", key);
            }
            result{key} = value;
        }
        return result;
    }

    #! Atomically publishes completed notation declarations
    /** @param declarations metadata indexed by expanded name
        @throw WSDL-ERROR invalid declaration metadata or an inconsistent key
        @note Call only during schema construction, before concurrent reads.
    */
    replace(hash<string, hash<XsdNotationInfo>> declarations) {
        self.declarations = checked(declarations, WSDL_ERROR);
    }

    #! Returns the completed notation declaration table
    /** @return metadata indexed by expanded name, with value semantics
        @since %WSDL 0.5.8
    */
    hash<string, hash<XsdNotationInfo>> getDeclarations() {
        return declarations;
    }

    #! Resolves notation metadata by expanded name
    /** @param identity expanded name, in \c "{namespace}local" notation
        @return declaration metadata, or NOTHING when absent
    */
    *hash<XsdNotationInfo> get(string identity) {
        return declarations{identity};
    }
}

#! namespace container class
public class Namespaces inherits Serializable {
    public {
        # options are here since this object is passed through all serialization and deserialization
        bool opt_empty_string_is_nothing = False;
        bool opt_allow_any_header = False;

        #! attribute form default in the schema currently being constructed
        /** @since %WSDL 0.5.8 */
        string attribute_form_default = "unqualified";

        #! finalDefault in the schema currently being constructed, restored on scope exit
        /** @since %WSDL 0.5.8 */
        hash<string, bool> schema_final_default();

        #! blockDefault for the schema currently being constructed, restored on scope exit
        /** @since %WSDL 0.5.8 */
        hash<string, bool> schema_block_default();

        #! schema component namespaces allowed by the source currently being constructed
        /** This construction scope includes the target namespace, declared imports and builtin XSD types.
            NOTHING outside schema construction preserves general QName expansion for public callers.
            @since %WSDL 0.5.8
        */
        *hash<string, bool> schema_reference_namespaces;
    }

    private {
        XsdGlobalAttributeRegistry global_attributes();
        XsdGlobalElementRegistry global_elements();
        XsdNotationRegistry notations();
        XsdIdentityConstraintRegistry identity_constraints();

        #! maps output namespace prefixes to namespace URIs
        hash<string, string> ns = {
            "xsd": XSD_NS,
        };

        #! maps namespace URIs to output namespace prefixes
        hash<string, string> nsr = {
            XSD_NS: "xsd",
        };

        #! hash for valid XSD namespaces, maps input namespace prefixes -> True if it refers to an XSD schema
        hash<string, bool> xsd_schema();

        #! hash mapping input namespace prefixes to namespaces URIs
        hash<string, string> imap();

        #! hash mapping input namespace URIs to input namespace prefixes
        hash<string, string> imapr();

        #! if True then has SOAP 1.1
        bool hassoap11 = False;

        #! if True then has SOAP 1.2
        bool hassoap12 = False;

        #! current target namespace
        *string target_ns;

        #! target namespace stack;
        list<auto> nss = ();

        #! default namespace for unprefixed definitions
        *string default_ns;

        # No-namespace QName references in a chameleon document adopt its including namespace.
        *string chameleon_ns;

        #! default namespace stack;
        list<auto> dss = ();

        #! base type map
        hash<string, XsdBaseType> base_types;

        # XML 1.0 (Fifth Edition), productions 4/4a with ':' excluded for NCName.
        const NCNameStart = 'A-Z_a-z\x{C0}-\x{D6}\x{D8}-\x{F6}\x{F8}-\x{2FF}\x{370}-\x{37D}'
            + '\x{37F}-\x{1FFF}\x{200C}-\x{200D}\x{2070}-\x{218F}\x{2C00}-\x{2FEF}'
            + '\x{3001}-\x{D7FF}\x{F900}-\x{FDCF}\x{FDF0}-\x{FFFD}\x{10000}-\x{EFFFF}';
        const NCNameRegex = '\A[' + NCNameStart + '][' + NCNameStart
            + '\-.0-9\x{B7}\x{300}-\x{36F}\x{203F}-\x{2040}]*\z';

        #! maps namespaces to default prefixes
        const DefaultPrefixes = {
            "http://www.w3.org/XML/1998/namespace": "xml",
            SOAP_ENCODING: "soapenc",
            XSD_NS: "xsd",
            XSI_NS: "xsi",
            SOAP_11_ENV: "soapenv",
            SOAP_12_ENV: "soapenv",
            MIME_NS: "mime",
            HTTP_NS: "http",
        };
    }

    #! creates the object with the WSDL definitions attribute hash
    constructor(hash<auto> nsh, *Namespaces nsc, *string targetNamespace) {
        if (nsc) {
            # Types retain output prefixes during construction. Reserve the enclosing registry's
            # prefixes before allocating any for this schema so later merging cannot reassign them.
            ns = nsc.ns;
            nsr = nsc.nsr;
            global_attributes = nsc.global_attributes;
            global_elements = nsc.global_elements;
            notations = nsc.notations;
            identity_constraints = nsc.identity_constraints;
        }
        if (!nsh.targetNamespace && targetNamespace) {
            chameleon_ns = targetNamespace;
        }
        if (nsh.targetNamespace || targetNamespace) {
            target_ns = nsh.targetNamespace ?? targetNamespace;
            # issue #3029: add target namespace to output namespace hash by default
            getOutputNamespacePrefix(target_ns);
        }

        # set default namespace for unprefixed definitions
        if (exists nsh.xmlns) {
            default_ns = nsh.xmlns;
        }

        #printf("*** DEBUG: Namespaces::constructor() nsh: %y imap: %y\n", nsh, imap);
        addNamespaces(nsh);

        base_types += nsc.base_types;
        #printf("*** DEBUG: Namespaces::constructor() imap: %y\n", imap);
    }

    #! publishes completed schema attribute declarations to the shared instance registry
    /** @param attributes global declarations indexed by expanded name
        @note Schema construction calls this after successful resolution; updates must precede concurrent use.
        @since %WSDL 0.5.8
    */
    setGlobalAttributes(hash<string, XsdAttribute> attributes) {
        global_attributes.replace(attributes);
    }

    #! resolves an instance attribute independently of source-prefix spelling
    /** @param identity the expanded global attribute name
        @return its declaration, or NOTHING if none is available
        @since %WSDL 0.5.8
    */
    *XsdAttribute getGlobalAttribute(string identity) {
        return global_attributes.get(identity);
    }

    #! publishes completed global elements to the shared instance registry
    /** @param element_map global declarations indexed by namespace and local name
        @param types named types available for instance-type assessment
        @note Updates are schema-construction operations and must precede concurrent reads.
        @since %WSDL 0.5.8
    */
    setGlobalElements(hash<string, hash<string, XsdElement>> element_map, hash<string, XsdAbstractType> types) {
        hash<string, XsdElement> completed();
        foreach hash<string, XsdElement> declarations in (element_map.iterator()) {
            foreach XsdElement element in (declarations.iterator()) {
                completed{element.getExpandedName()} = element;
            }
        }
        global_elements.replace(completed, types);
    }

    #! resolves a global instance element independently of declaration prefixes
    /** @param identity expanded name
        @return the declaration, or NOTHING when unavailable
        @since %WSDL 0.5.8
    */
    *XsdElement getGlobalElement(string identity) {
        return global_elements.get(identity);
    }

    #! returns named types available for wildcard instance assessment
    /** @return the completed map, indexed by expanded name
        @since %WSDL 0.5.8
    */
    hash<string, XsdAbstractType> getInstanceTypes() {
        return global_elements.getTypes();
    }

    #! Publishes completed notation declarations to all retained namespace contexts
    /** @param declarations notation metadata indexed by expanded name
        @throw WSDL-ERROR invalid declaration metadata
        @note Schema construction must finish before concurrent reads.
        @since %WSDL 0.5.8
    */
    setNotations(hash<string, hash<XsdNotationInfo>> declarations) {
        notations.replace(declarations);
    }

    #! Returns the shared notation registry for detached validating providers
    /** @return the declaration registry
        @note Mutation must finish before concurrent reads.
        @since %WSDL 0.5.8
    */
    XsdNotationRegistry getNotationRegistry() {
        return notations;
    }

    #! Returns the schema-wide identity-constraint registry
    /** @return resolved definitions shared by declaration namespace contexts
        @note Mutation must finish before concurrent reads.
        @since %WSDL 0.5.8
    */
    XsdIdentityConstraintRegistry getIdentityConstraintRegistry() {
        return identity_constraints;
    }

    #! Resolves a schema notation independently of prefix spelling
    /** @param identity expanded notation name
        @return declaration metadata, or NOTHING when absent
        @since %WSDL 0.5.8
    */
    *hash<XsdNotationInfo> getNotation(string identity) {
        return notations.get(identity);
    }

    *string getDefaultNs() {
        return default_ns;
    }

    #! returns input namespace maps for an exception-safe declaration scope
    /** @return input prefix/URI and reverse maps; output prefixes are not scoped
        @since %WSDL 0.5.8
    */
    hash<string, hash<string, string>> getInputNamespaceState() {
        return {"input": imap, "reverse": imapr};
    }

    #! restores an input declaration scope, including newly introduced prefixes
    /** @param state maps returned by getInputNamespaceState()
        @throw WSDL-NAMESPACE-ERROR inconsistent or missing namespace maps
        @since %WSDL 0.5.8
    */
    restoreInputNamespaceState(hash<string, hash<string, string>> state) {
        if (!exists state.input || !exists state.reverse) {
            throw "WSDL-NAMESPACE-ERROR", "input namespace state requires input and reverse maps";
        }
        foreach string uri in (keys state.reverse) {
            if (state.input{state.reverse{uri}} != uri) {
                throw "WSDL-NAMESPACE-ERROR", "input namespace state contains an inconsistent reverse map";
            }
        }
        foreach string prefix in (keys state.input) {
            if (!exists state.reverse{state.input{prefix}}) {
                throw "WSDL-NAMESPACE-ERROR", "input namespace state has no reverse mapping for an input URI";
            }
        }
        imap = state.input;
        imapr = state.reverse;
        xsd_schema = {};
        foreach string prefix in (keys imap) {
            if (imap{prefix} == XSD_NS) {
                xsd_schema{prefix} = True;
            }
        }
    }

    addNamespaces(hash<auto> nsh, *NamespacePrefixHelper nph) {
        foreach string k in (keys nsh) {
            *string ns = (k =~ x/xmlns:([^:]+)/)[0];

            if (!ns)
                continue;

            if (imap{ns}) {
                # ignore if the definition is the same
                if (imap{ns} == nsh{k})
                    continue;

                if (!nph) {
                    throw "WSDL-NAMESPACE-ERROR", sprintf("namespace prefix %y defined twice", ns);
                }
            }
            addNamespaceIntern(ns, nsh{k});
        }
    }

    restorePrefixes(hash<auto> h) {
        map addNamespaceIntern($1.key, $1.value, True), h.pairIterator();
    }

    private addNamespaceIntern(string ns, string val, *bool override) {
        *string previous = imap{ns};
        imap{ns} = val;

        if (exists previous && previous != val && imapr{previous} == ns) {
            remove imapr{previous};
            foreach string prefix in (keys imap) {
                if (imap{prefix} == previous) {
                    imapr{previous} = prefix;
                    break;
                }
            }
        }

        if (override || !imapr{val}) {
            imapr{val} = ns;
        }

        if (val == XSD_NS) {
            xsd_schema{ns} = True;
        } else {
            remove xsd_schema{ns};
        }

        if (!hassoap11 && val == SOAP_11_NS) {
            hassoap11 = True;
        }

        if (!hassoap12 && val == SOAP_12_NS) {
            hassoap12 = True;
        }
    }

    #! merges namespaces when parsing imported schemas
    merge(Namespaces nsc) {
        foreach string prefix in (keys nsc.ns) {
            string uri = nsc.ns{prefix};
            # only import the prefix if the URI isn't already registered
            if (!nsr{uri}) {
                if (ns{prefix}) {
                    if (ns{prefix} == uri) {
                        continue;
                    }

                    # issue #3194: rename clashing namespace prefixes
                    string new_prefix = getUniquePrefix(uri);
                    # update both forward and reverse mappings consistently
                    ns{new_prefix} = uri;
                    nsr{uri} = new_prefix;
                    # also update the source namespace container's reverse mapping
                    nsc.nsr{uri} = new_prefix;
                } else {
                    ns{prefix} = uri;
                    nsr{uri} = prefix;
                }
            }
        }
        # merge input namespace mappings
        foreach string k in (keys nsc.imap) {
            string v = nsc.imap{k};
            if (imap{k}) {
                if (imap{k} == v) {
                    continue;
                }
                # issue #4455: rename clashing namespace prefixes
                k = getUniquePrefix(v);
            }
            imap{k} = v;
            # ensure reverse mapping is also updated
            imapr{v} = k;
        }

        base_types += nsc.base_types;
    }

    #! returns a unique namespace prefix from a URI path string
    /** @param uri the namespace URI to generate a prefix for
        @param default_prefix optional default prefix to use if extraction fails

        @return a unique namespace prefix that:
        - starts with a letter (valid XML namespace prefix)
        - is not already in use in the output namespace map
        - is between 2-6 characters for readability (increased from 3)
    */
    string getUniquePrefix(string uri, *string default_prefix) {
        @assert(uri, "URI is required for prefix generation");
        # try to get last URI path segment
        *string str = (uri =~ x/\/([^\/]+)$/)[0];
        if (str) {
            # keep up to 6 characters for better readability (increased from 3)
            splice str, 6;
            # convert to all lower case
            str =~ tr/A-Z/a-z/;
            # remove special characters
            str =~ s/[^a-z0-9_]//g;
        }
        # only accept strings that start with a letter and are non-empty
        if (!str || str !~ /^[a-z]/) {
            # otherwise we use a hardcoded prefix
            str = default_prefix ?? "ns";
        }
        @assert(str, "prefix generation must produce a non-empty string");
        if (!ns{str}) {
            return str;
        }
        string pfx = str;
        int count = 0;
        do {
            str = pfx + ++count;
        } while (ns{str});
        return str;
    }

    #! returns the namespace URI for the given output namespace prefix
    string getOutputNamespaceUri(string nsp) {
        @assert(nsp, "namespace prefix is required");
        *string uri = ns{nsp};
        if (!uri) {
            throw "WSDL-NAMESPACE-ERROR", sprintf("output namespace prefix %y is unknown (known output namespace "
                "prefixes: %y)", nsp, ns.keys());
        }
        return uri;
    }

    #! returns a hash of namespace attributes for outgoing SOAP messages
    *hash<auto> getOutputNamespaceHash(*hash<auto> nsh) {
        hash<auto> h;
        map h.("xmlns:" + $1.key) = $1.value, ns.pairIterator();

        foreach string k in (keys nsh) {
            string xs = "xmlns:" + k;
            if (h{xs}) {
                if (h{xs} != nsh{k})
                    throw "WSDL-NAMESPACE-ERROR", sprintf("namespace %y has already been added automatically as %y and therefore cannot be overridden as %y", k, h{xs}, nsh{k});
            }
            else
                h{xs} = nsh{k};
        }

        return h;
    }

    #! returns the primary target namespace Uri
    *string getTargetNamespaceUri() {
        return target_ns;
    }

    #! returns the namespace URI for the given prefix or the target namespace Uri
    *string getNamespaceUri(*string nsp) {
        if (exists nsp)
            return getInputNamespaceUri(nsp);
        return getTargetNamespaceUri();
    }

    #! enters a schema target namespace, preserving chameleon adoption and clearing enclosing WSDL targets
    /** @param uri the schema's targetNamespace, or NOTHING if absent
        @note Balance this call with popTargetNamespace().
        @since %WSDL 0.5.8
    */
    pushSchemaTargetNamespace(*string uri) {
        nss += target_ns;
        target_ns = uri ?? chameleon_ns;
    }

    #! pushes the current target namespace URI on the stack and sets the new target namespace URI
    pushTargetNamespace(string ns) {
        @assert(ns, "namespace URI is required");
        nss += target_ns;
        target_ns = ns;
    }

    #! restores any previous target namespace URI from the stack to the current target namespace URI
    popTargetNamespace() {
        @assert(nss.size() > 0, "target namespace stack underflow - mismatched push/pop");
        target_ns = pop nss;
    }

    #! pushes the current default namespace URI on the stack when parsing schemas and sets the current default namespace URI to the current value
    pushDefaultNamespace(string ns) {
        # An empty namespace is the explicit xmlns="" reset.
        dss += default_ns;
        default_ns = ns;
    }

    #! restores any previous default namespace URI from the stack to the current default namespace URI
    popDefaultNamespace() {
        @assert(dss.size() > 0, "default namespace stack underflow - mismatched push/pop");
        default_ns = pop dss;
    }

    #! looks up and registers a namespace if necessary, returns the namespace's prefix
    string getOutputNamespacePrefix(string ns) {
        @assert(ns, "namespace URI is required");
        return nsr{ns} ?? registerNamespaceIntern(ns);
    }

    #! returns the output namespace prefix for the target namespace, if any
    string getTargetNamespaceOutputPrefix() {
        if (!target_ns) {
            throw "NAMESPACE-ERROR", sprintf("no target namespace");
        }
        return getOutputNamespacePrefix(target_ns);
    }

    #! returns the input namespace prefix for the target namespace, if any
    *string getTargetNamespaceInputPrefix() {
        if (!target_ns) {
            throw "NAMESPACE-ERROR", sprintf("no target namespace");
        }
        # return the input prefix mapping for the target namespace (may be NOTHING if not mapped)
        return imapr{target_ns};
    }

    #! registers a namespace internally
    private string registerNamespaceIntern(string uri, *string default_pfx) {
        # see if ns gets a default prefix or create namespace prefix
        string nsa = DefaultPrefixes{uri} ?? getUniquePrefix(uri);
        # register namespace in forward and reverse maps
        ns{nsa} = uri;
        nsr{uri} = nsa;

        return nsa;
    }

    #! returns a hash of namespace prefixes to namespaces URIs actually used
    *hash<auto> getReferencedNamespaceMap() {
        return ns;
    }

    #! returns True if using SOAP 1.1, False if not
    bool hasSoap11() {
        return hassoap11;
    }

    #! returns True if using SOAP 1.2, False if not
    bool hasSoap12() {
        return hassoap12;
    }

    #! returns True if if the input namespace prefix refers to the XSD namespace URI
    *bool isSchema(string ns) {
        return xsd_schema{ns};
    }

    #! returns the input namespace URI from the input namespace prefix
    string getInputNamespaceUri(string nsa) {
        @assert(nsa, "namespace prefix is required");
        *string rv = imap{nsa};
        if (!rv)
            throw "WSDL-NAMESPACE-ERROR", sprintf("input namespace %y is unknown (known input namespaces: %y)", nsa, imap.keys());
        return rv;
    }

    #! returns the input namespace URI from the input namespace prefix, or NOTHING if not found
    /** @param nsa the input namespace prefix
        @return the namespace URI or NOTHING if the prefix is not defined

        @note this method does not throw an exception if the prefix is not found
    */
    *string tryGetInputNamespaceUri(*string nsa) {
        if (!nsa) {
            return NOTHING;
        }
        return imap{nsa};
    }

    #! resolves a type name to type info or a concrete type object
    /** @param t the type name, potentially with namespace prefix (e.g., "xsd:string" or "tns:MyType")
        @param typeinfo reference to store type info hash if type is not resolved
        @param rtype reference to store the resolved XsdAbstractType object
        @param tmap optional type map for custom type lookup

        @return True if type was resolved to an XsdAbstractType, False if typeinfo was populated instead
        @throw WSDL-NAMESPACE-ERROR malformed or unbound type QName, including an empty name
        @throw WSDL-ERROR a referenced schema namespace is not imported
    */
    bool doType(string t, reference<hash> typeinfo, reference<XsdAbstractType> rtype, *hash<string, XsdAbstractType> tmap) {
        hash<auto> resolved = getTypeHash(t);
        if (resolved.uri == XSD_NS) {
            rtype = getBaseType(resolved.val);
            return True;
        }
        if (tmap) {
            if ((rtype = tmap_try_get(tmap, type_qname(resolved.uri, resolved.val)))) {
                return True;
            }
        }
        typeinfo = resolved;
        return False;
    }

    #! captures a type QName in the current declaration's namespace context
    /** @param t lexical type QName
        @return local name, namespace URI (empty for no namespace), and optional output prefix
        @throw WSDL-NAMESPACE-ERROR malformed QName or unbound prefix
        @throw WSDL-ERROR a schema component namespace is not imported by the active source document
        @since %WSDL 0.5.8
    */
    hash<auto> getTypeHash(string t) {
        t =~ s/^[ \t\r\n]+|[ \t\r\n]+$//g;
        list<string> parts = split(":", t);
        if (t !~ /\A[^:]+(?::[^:]+)?\z/) {
            throw "WSDL-NAMESPACE-ERROR", sprintf("invalid type QName %Y", t);
        }
        foreach string part in (parts) {
            if (!regex(part, NCNameRegex)) {
                throw "WSDL-NAMESPACE-ERROR", sprintf("invalid type QName %Y", t);
            }
        }
        string uri = parts.size() == 2 ? getInputNamespaceUri(parts[0]) : (default_ns ?? "");
        if (!uri && chameleon_ns) {
            uri = chameleon_ns;
        }
        if (exists schema_reference_namespaces && !schema_reference_namespaces{uri}) {
            throw WSDL_ERROR, sprintf("schema component QName %Y references namespace %Y without a corresponding "
                "import in this schema document", t, uri);
        }
        hash<auto> info = {"uri": uri, "val": parts[-1]};
        if (uri) {
            info.ns = getOutputNamespacePrefix(uri);
        }
        return info;
    }

    #! returns a recognized builtin schema type
    /** @param t the local builtin type name
        @return the cached builtin type object
        @throw WSDL-ERROR the name is not a recognized builtin type
        @note The existing binary transport extension is retained for legacy HTTP/MIME bindings;
        it is not an XSD 1.0 datatype.
    */
    XsdBaseType getBaseType(string t) {
        if (!XsdBaseType::BuiltinTypes{t}) {
            throw WSDL_ERROR, sprintf("unknown builtin schema type %Y", t);
        }
        if (!base_types{t}) {
            base_types{t} = new XsdBaseType(t, self);
        }

        XsdBaseType rv := base_types{t};
        return rv;
    }

    #! validates the local name of a schema component declaration
    /** @param name the declaration name, which must be a nonempty XML NCName
        @throw WSDL-ERROR missing or invalid declaration name
        @since %WSDL 0.5.8
    */
    validateDeclarationName(*string name) {
        if (!exists name || !regex(name, NCNameRegex)) {
            throw WSDL_ERROR, sprintf("invalid or missing schema declaration name %Y", name);
        }
    }

    #! returns whether a string is an XML NCName
    /** @param name the candidate prefix or local name
        @return True for an XML 1.0 NCName
        @since %WSDL 0.5.8
    */
    static bool isNCName(string name) {
        return regex(name, NCNameRegex);
    }

    #! returns the output namespace prefix for the given input namespace prefix
    string translateOutputNamespacePrefix(*string nsa) {
        return getOutputNamespacePrefix(getInputNamespaceUri(nsa));
    }
}

# private functions
# Unlike legacy local-name aliases, the no-namespace key must be unambiguous too.
string sub type_qname(*string uri, string local_name) {
    return sprintf("{%s}%s", uri ?? "", local_name);
}

XsdAbstractType sub tmap_get(hash<string, XsdAbstractType> tmap, string name) {
if (!tmap{name})
    throw WSDL_ERROR, sprintf("no such type %y; known types: %y", name, tmap.keys());
XsdAbstractType rv := tmap{name};
return rv;
}

*XsdAbstractType sub tmap_try_get(hash<string, XsdAbstractType> tmap, string name) {
*XsdAbstractType rv := tmap{name};
return rv;
}

#! Returns a namespace-qualified key in James-Clark notation: \c "{namespace_uri}local_name", or
#! \c local_name when no namespace URI is given.
/** Used for keying the type/element/group registries so that identifiers reused across different
    target namespaces (typical of UN/CEFACT and other multi-namespace XSD packages) do not collide.

    @since %WSDL 0.5.8
*/
public string sub make_qname(*string nsUri, string localName) {
    return nsUri ? sprintf("{%s}%s", nsUri, localName) : localName;
}

#! Resolves a group/attributeGroup reference to a qualified key for map lookup
/** @param ref the reference string (e.g., "tns:AddressGroup" or "AddressGroup")
    @param defaultNsUri the default namespace URI to use for unqualified refs
    @param nsc the Namespaces object for resolving prefixes
    @return the qualified key in format "{namespace_uri}local_name" or just "local_name" if no namespace
*/
string sub resolveGroupRef(string ref, *string defaultNsUri, Namespaces nsc) {
    string localName = ref;
    *string nsUri = defaultNsUri;

    # Parse prefix if present
    if (ref =~ /:/) {
        (*string prefix, *string name) = (ref =~ x/^([^:]+):(.+)$/);
        if (name) {
            localName = name;
            # Resolve prefix to namespace URI
            *string resolvedNs = nsc.getInputNamespaceUri(prefix);
            if (resolvedNs) {
                nsUri = resolvedNs;
            }
        }
    }

    # Return qualified key
    return nsUri ? sprintf("{%s}%s", nsUri, localName) : localName;
}

# private functions
XsdElement sub emap_get(hash<string, hash<string, XsdElement>> emap, string ns, string name) {
if (!emap{ns})
    throw WSDL_ERROR, sprintf("no such namespace %y; known namespaces: %y", ns, emap.keys());
if (!emap{ns}{name})
    throw WSDL_ERROR, sprintf("no such element %y in namespace %y; known elements: %y", name, ns, emap{ns}.keys());
XsdElement rv := emap{ns}{name};
return rv;
}

*XsdElement sub emap_try_get(hash<string, hash<string, XsdElement>> emap, string ns, string name) {
*XsdElement rv := emap{ns}{name};
return rv;
}

#! WSDL port type hash
public hashdecl PortTypeInfo {
    #! Operation lookup keys mapped to declarations
    hash<string, WSOperation> operations;
    #! XML operation names mapped to their declarations in source order
    hash<string, list<WSOperation>> operation_candidates = {};
}

# Port-type indexes are built once; binding lookups inspect only same-name candidates.
class WsdlOperationLookup {
    static *WSOperation find(hash<PortTypeInfo> port, string key, *string input_name = NOTHING,
            *string output_name = NOTHING, *string binding = NOTHING, string error = "WSDL-OPERATION-ERROR") {
        list<WSOperation> candidates = port.operations{key} ? (port.operations{key},)
            : port.operation_candidates{key} ?? ();
        *WSOperation result;
        foreach WSOperation candidate in (candidates) {
            if ((exists input_name && candidate.getInputName() != input_name)
                    || (exists output_name && candidate.getOutputName() != output_name)
                    || (exists binding && !candidate.hasBinding(binding))) {
                continue;
            }
            if (result) {
                throw error, sprintf("ambiguous operation %Y; select an input/output signature from %Y",
                    key, map $1.getSelectionKey(), candidates);
            }
            result = candidate;
        }
        return result;
    }
}

#! WSDL service info hash
public hashdecl ServiceInfo {
    #! service name
    string name;
    #! port info
    hash<string, hash> port;
}

#! WSDL operation info
public hashdecl OperationInfo {
    #! the name of the port defining the operation
    string port;

    #! the operation object
    WSDL::WSOperation operation;
}

#! Poll operation for async WSDL retrieval and schema imports
/** Uses only non-blocking I/O for WSDL and XSD retrieval

    @since %WSDL 0.5.8
*/
public class WsdlPollOperation inherits Qore::AbstractPollOperation {
    public {
        #! Get WSDL state
        const SPS_GET_WSDL = "get-wsdl";

        #! Get XSD import state
        const SPS_GET_IMPORT = "get-import";

        #! Build WebService state
        const SPS_BUILD = "build-wsdl";

        #! Complete state
        const SPS_COMPLETE = "complete";
    }

    private {
        string wsdl_url;
        *string def_path;
        *hash<auto> http_opts;
        *hash<auto> http_headers;
        *AbstractPollOperation<hash<FileResourceResult>> poller;
        *string document_location;
        hash<string, string> resource_locations();
        string state;
        bool goal_reached = False;
        auto output;
        string wsdl_text;
        string current_location;
        hash<string, string> xsd_cache();
        *Logger::LoggerInterface logger;
    }

    constructor(string wsdl_url, *hash<auto> http_opts, *hash<auto> http_headers,
            *Logger::LoggerInterface logger) {
        self.wsdl_url = wsdl_url;
        self.http_opts = http_opts;
        self.http_headers = http_headers;
        self.logger = logger;

        if (wsdl_url =~ /^</) {
            log("INFO", "WSDL async build start: inline data");
            wsdl_text = wsdl_url;
            state = SPS_BUILD;
        } else {
            state = SPS_GET_WSDL;
            log("INFO", "WSDL async fetch start: %y", wsdl_url);
            startFetch(normalizeWsdlLocation(wsdl_url));
        }
    }

    string getGoal() {
        return "wsdl";
    }

    string getState() {
        return state + (poller ? ("-" + poller.getState()) : NOTHING);
    }

    bool goalReached() {
        return goal_reached;
    }

    *hash<SocketPollInfo> continuePoll() {
        on_error abort();
        while (True) {
            if (poller) {
                *hash<SocketPollInfo> info = poller.continuePoll();
                if (info) {
                    return info;
                }
                handlePollComplete();
                continue;
            }

            if (state == SPS_BUILD) {
                try {
                    output = new WebService(wsdl_text, {
                        "def_path": def_path,
                        "document_location": document_location,
                        "resource_locations": resource_locations,
                        "http_headers": http_headers,
                        "xsd_cache": xsd_cache,
                        "async_only": True,
                    });
                    goal_reached = True;
                    state = SPS_COMPLETE;
                    log("INFO", "WSDL async build complete");
                    return;
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err != "WSDL-ASYNC-IMPORT") {
                        rethrow;
                    }
                    string loc = ex.arg;
                    if (!loc) {
                        throw "WSDL-ASYNC-IMPORT", "missing async import location in exception";
                    }
                    log("DEBUG", "WSDL async import required: %y", loc);
                    current_location = loc;
                    state = SPS_GET_IMPORT;
                    startFetch(loc);
                    continue;
                }
            }

            return;
        }
    }

    auto getOutput() {
        return output;
    }

    abort() {
        if (poller) {
            poller.abort();
        }
    }

    private handlePollComplete() {
        hash<FileResourceResult> resource = poller.getOutput();
        string text = WsdlResourceHelper::text(resource);
        string effective = resource.info.effective_location
            ? WSDLLib::getUriDocumentLocation(resource.info.effective_location) : current_location;
        resource_locations += WsdlResourceHelper::locations(resource.info, current_location);
        if (exists xsd_cache{effective} && xsd_cache{effective} != text) {
            throw WSDL_ERROR, sprintf("conflicting source bytes for resource %Y", effective);
        }
        # Retain the root too: an import can redirect back to it through a new alias.
        xsd_cache{effective} = text;
        if (state == SPS_GET_WSDL) {
            wsdl_text = text;
            document_location = effective;
            def_path = WSDLLib::getLocationBase(effective);
        }
        state = SPS_BUILD;
        poller = NOTHING;
        log("DEBUG", "WSDL async fetch complete: %y", effective);
    }

    private startFetch(string location) {
        current_location = location;
        if (location =~ /^https?:/) {
            HTTPClient hc((http_opts ?? {}) + {"url": location});
            # HTTPClient does not support setLogger()
            AbstractFileLocationHandler handler = FileLocationHandler::getHttpHandlerForClient(hc);
            poller = handler.getResourcePoller("http", WsdlUriComponents::httpPath(location),
                {"headers": http_headers});
        } else {
            # The core file handler consumes a literal path, not a percent-encoded URI.
            string retrieval = WsdlFileLocation::isFile(location)
                ? "file://" + WsdlFileLocation::path(location) : location;
            poller = FileLocationHandler::getResourcePollerForLocation(retrieval);
        }
        log("DEBUG", "WSDL async fetch queued: %y", location);
    }

    private string normalizeWsdlLocation(string location) {
        string normalized = WSDLLib::normalizeLocation(location, "file", NOTHING);
        if (WsdlFileLocation::isFile(normalized)) {
            def_path = dirname(WsdlFileLocation::path(normalized));
        } else {
            def_path = WSDLLib::getLocationBase(normalized);
        }
        return normalized;
    }

    private log(string level, string msg, ...) {
        if (logger) {
            logger.logArgs(level, msg, argv);
        }
    }

}

#! Original schema source and resolution base used for Serializable reconstruction
/** @since %WSDL 0.5.8
*/
public hashdecl XsdSourceInfo {
    #! complete original XSD document
    string xml;
    #! base used to resolve relative imports and includes
    *string base;
    #! complete containing document URI, when available
    *string location;
}

#! Encapsulates XSD schema parsing and the resulting type/element/group registry
/** This class isolates the XSD parsing logic so it can be used independently of WSDL parsing.
    @ref WebService inherits from this class to add WSDL-specific parsing on top of the XSD machinery,
    while modules that need to work with bare XSD documents (for example, industry message standards
    delivered as XSD packages) can use this class directly.

    Construct an empty schema and add documents incrementally, or pass one or more XSD documents
    to the constructor:
    @code{.py}
        XsdSchema xs();
        xs.addSchemaFile("/path/to/Header.xsd");
        xs.addSchemaDir("/path/to/messages/");
    @endcode

    @par Example: cache a parsed partner message schema
    @code{.py}
        XsdSchema original(xsd_text, {"async_only": True, "xsd_cache": dependency_cache});
        XsdSchema restored = Serializable::deserialize(original.serialize());
        XsdElement invoice = restored.getElement("urn:partner:invoice", "Invoice");
        AbstractDataProviderType fields = invoice.getDataProviderType();
    @endcode

    Original schema documents and successfully retrieved dependencies are saved with the object;
    restoration rebuilds the transient type/element registries from those bytes. Import callbacks
    are not serialized. Serialized schemas created before source retention cannot reconstruct
    declarations that were not stored. Existing \c WebService objects retain their WSDL rebuild path.

    @note Add documents before sharing the schema between threads. Concurrent mutations of one
    schema are not supported. Failed additions leave previously parsed components usable.

    @since %WSDL 0.5.8
*/
public class XsdSchema inherits WSDL::XsdBase {
    public {
        #! options used to parse the schema
        *hash<auto> opts;

        #! flag if the object has a "try_import" closure or call reference
        bool has_try_import = False;

        #! namespace container
        transient Namespaces nsc;

        #! map of elements keyed by namespace URI then element name
        transient hash<string, hash<string, XsdElement>> emap();

        #! map of types
        transient hash<string, XsdAbstractType> tmap();

        #! map of xs:group definitions by name
        transient hash<string, XsdGroup> groupMap();

        #! map of xs:attributeGroup definitions by name
        transient hash<string, XsdAttributeGroup> attrGroupMap();

        #! global attribute declarations, keyed by expanded namespace/local name
        /** @since %WSDL 0.5.8 */
        transient hash<string, XsdAttribute> attributeMap();

        #! Notation identifiers indexed by expanded namespace/local name
        /** @since %WSDL 0.5.8 */
        transient hash<string, hash<XsdNotationInfo>> notationMap();

        #! optional closure/call reference to try to resolve import declarations
        transient *code try_import;

        #! default path for retrieving XSD references
        /** Preserved separately from options because addSchemaFile() can set it after construction.
        */
        *string def_path;

        #! complete containing document URI used for URI-relative schema references
        *string document_location;
    }

    private {
        #! issue #4449: map of imports used while parsing
        transient hash<string, bool> import_map();

        # Active source identities also recognize a root supplied as XML when a dependency imports it.
        transient hash<string, bool> active_schemas();

        # Temporary DFS states while resolving the complete simple type dependency graph.
        transient hash<string, bool> resolving_simple();
        transient hash<string, bool> resolved_simple();
        transient hash<string, bool> valid_list_items();
        transient hash<string, XsdSimpleType> union_definitions();

        # Original documents and their bases reconstruct transient component registries.
        list<hash<XsdSourceInfo>> schema_sources();

        # WebService must restore its inline declarations before schemas added later.
        transient list<hash<XsdSourceInfo>> pending_schema_sources();
        # Root WSDL reconstruction temporarily uses its original options, then restores these defaults.
        transient *string pending_default_base;
        transient *string pending_document_location;

        # Successfully retrieved dependency bytes, indexed by normalized absolute location.
        hash<string, string> schema_dependencies();

        # Requested resource URI to final retrieval URI; retained for offline reconstruction.
        hash<string, string> resource_locations();
    }

    private:internal deserializeMembers(hash<auto> members) {
        if (!exists members.schema_sources && !(self instanceof WebService)) {
            throw "DESERIALIZATION-ERROR", "serialized XsdSchema has no source documents; recreate it from the original XSD";
        }
        resource_locations = members.resource_locations ?? {};
        initOptions(members.opts);
        def_path = members.def_path ?? opts.def_path;
        document_location = members.document_location ?? opts.document_location;
        pending_default_base = def_path;
        pending_document_location = document_location;
        has_try_import = members.has_try_import ?? False;
        nsc = new Namespaces({});
        nsc.opt_empty_string_is_nothing = opts.compat_empty_string_is_nothing
            || global_compat_empty_string_is_nothing;
        emap = {};
        tmap = {};
        groupMap = {};
        attrGroupMap = {};
        attributeMap = {};
        notationMap = {};
        import_map = {};
        schema_sources = ();
        schema_dependencies = members.schema_dependencies ?? {};
        pending_schema_sources = members.schema_sources ?? ();
        if (!(self instanceof WebService)) {
            restoreSchemaSources();
        }
    }

    private restoreSchemaSources() {
        on_exit {
            def_path = pending_default_base;
            document_location = pending_document_location;
            pending_default_base = pending_document_location = NOTHING;
        }
        foreach hash<XsdSourceInfo> source in (pending_schema_sources) {
            def_path = source.base;
            document_location = source.location;
            addSchemaString(source.xml);
        }
        pending_schema_sources = ();
    }

    #! creates an empty XsdSchema
    /** Use this constructor when you intend to add XSD documents incrementally via @ref addSchemaString,
        @ref addSchemaFile, or @ref addSchemaDir, or when this class is used as a base class.
    */
    constructor() {
        nsc = new Namespaces({});
    }

    #! creates an XsdSchema by parsing one or more XSD source documents
    /** @param xsd a single XSD document string, or a list of XSD document strings (parsed in order)
        @param opts an optional hash of options:
        - \c "document_location": full URI of the containing document, used instead of the directory base
          for URI references; saved with each source
        - \c "def_path": default path for retrieving referenced XSD imports
        - \c "try_import": call reference or closure to resolve XSD imports without a scheme; takes a
          string argument (the resource name) and returns a string (the resource data)
        - \c "http_client": HTTPClient object for retrieving XSD imports
        - \c "http_headers": hash of HTTP headers for XSD imports
        - \c "resource_locations": hash mapping requested resource URIs directly to final retrieval URIs;
          returned by WSDLLib retrieval helpers and retained with saved graphs
        - \c "xsd_cache": hash mapping schema locations to cached schema data
        - \c "async_only": if @ref True then external imports must be satisfied by xsd_cache
        - \c "compat_empty_string_is_nothing": deserialize empty strings to NOTHING instead of ""
    */
    constructor(softlist<string> xsd, *hash<auto> opts) {
        initOptions(opts);
        nsc = new Namespaces({});
        if (opts.compat_empty_string_is_nothing || global_compat_empty_string_is_nothing) {
            nsc.opt_empty_string_is_nothing = True;
        }
        foreach string s in (xsd) {
            addSchemaString(s);
        }
    }

    #! adds an XSD document to the schema and parses its types
    /** @param xsd an XSD document string

        Multiple schemas with their own \c targetNamespace can be added via repeated calls.
        @throw XSD-ERROR invalid schema document root
        @throw WSDL-NAMESPACE-ERROR unresolved namespace prefix
        @throw WSDL-ERROR unresolved or duplicate schema component
        @throw XSD-SIMPLETYPE-ERROR malformed facet declaration or invalid numeric restriction
        @throw WSDL-ASYNC-IMPORT an external schema is absent from the asynchronous cache
        @note A failed addition does not retain declarations or dependency marks from that document.
    */
    addSchemaString(string xsd) {
        validateSchemaRoot(xsd, "XSD-ERROR");
        validateSchemaGrammar(xsd);
        hash<auto> h = XsdSchemaSource::parse(xsd);
        if (h.size() != 1) {
            throw "XSD-ERROR", sprintf("expecting a single root element in XSD; got: %y", h.keys());
        }
        string root_key = h.firstKey();
        if (root_key !~ /(?:^|:)schema$/) {
            throw "XSD-ERROR", sprintf("expected XSD root element <schema> or <prefix:schema>; got <%s>",
                root_key);
        }
        # Registry updates are atomic: failed documents must not leave declarations or import marks.
        hash<string, hash<string, XsdElement>> old_elements = emap;
        hash<string, hash<string, XsdElement>> old_substitution_groups();
        foreach hash<string, XsdElement> declarations in (old_elements.iterator()) {
            foreach XsdElement element in (declarations.iterator()) {
                old_substitution_groups{element.getExpandedName()} = element.getSubstitutionGroup();
            }
        }
        hash<string, XsdAbstractType> old_types = tmap;
        hash<string, XsdGroup> old_groups = groupMap;
        hash<string, XsdAttributeGroup> old_attribute_groups = attrGroupMap;
        hash<string, XsdAttribute> old_attributes = attributeMap;
        hash<string, hash<XsdNotationInfo>> old_notations = notationMap;
        hash<string, XsdIdentityConstraint> old_identities = nsc.getIdentityConstraintRegistry().getDefinitions();
        hash<string, bool> old_imports = import_map;
        hash<string, string> old_dependencies = schema_dependencies;
        hash<string, string> old_resource_locations = resource_locations;
        list<hash<XsdSourceInfo>> old_sources = schema_sources;
        on_error {
            emap = old_elements;
            foreach hash<string, XsdElement> declarations in (old_elements.iterator()) {
                foreach XsdElement element in (declarations.iterator()) {
                    element.resolveSubstitutionGroupMembers(old_substitution_groups{element.getExpandedName()});
                }
            }
            tmap = old_types;
            groupMap = old_groups;
            attrGroupMap = old_attribute_groups;
            attributeMap = old_attributes;
            notationMap = old_notations;
            nsc.setNotations(old_notations);
            nsc.getIdentityConstraintRegistry().replace(old_identities);
            nsc.setGlobalAttributes(old_attributes);
            nsc.setGlobalElements(old_elements, old_types);
            import_map = old_imports;
            schema_dependencies = old_dependencies;
            resource_locations = old_resource_locations;
            schema_sources = old_sources;
        }

        # Use a fresh namespace context for the schema being added so that target/default namespaces
        # set during parsing persist after parseTypes' NamespacePrefixHelper unwinds (mirroring the
        # XSD-import logic in parseTypes()).
        Namespaces n_nsc = nsc;
        *hash<auto> root_attrs = h{root_key}."^attributes^";
        nsc = new Namespaces(root_attrs ?? {}, n_nsc);
        nsc.opt_empty_string_is_nothing = n_nsc.opt_empty_string_is_nothing;
        nsc.opt_allow_any_header = n_nsc.opt_allow_any_header;
        on_exit nsc = n_nsc;
        on_success n_nsc.merge(nsc);

        string source_key = schemaSourceKey(xsd, nsc.getTargetNamespaceUri(), def_path, document_location);
        active_schemas{source_key} = True;
        on_exit remove active_schemas{source_key};
        parseTypes(h, opts.http_client instanceof HTTPClient ? opts.http_client : NOTHING, opts.http_headers);
        hash<XsdSourceInfo> source = <XsdSourceInfo>{"xml": xsd, "base": def_path, "location": document_location};
        schema_sources += source;
    }

    #! parses an XSD file and adds its type information to this schema
    /** @param path the XSD file to read
        @throw XSD-ERROR invalid schema root
        @throw WSDL-ERROR invalid schema declarations or dependency graph
        @note Dependencies always resolve relative to this file. An existing default base is restored;
        the first successful file addition establishes the default if none was configured.
        Failed additions restore the original default base.
    */
    addSchemaFile(string path) {
        *string previous_location = document_location;
        document_location = WsdlFileLocation::fromPath(path);
        on_exit document_location = previous_location;
        *string previous_base = def_path;
        def_path = dirname(path);
        on_error def_path = previous_base;
        on_success {
            if (previous_base) {
                def_path = previous_base;
            }
        }
        addSchemaString(WSDLLib::getFile(path));
    }

    #! parses every matching XSD file in the given directory (non-recursive)
    /** @param dir the directory containing XSD files
        @param regex regex anchored against each file name (default matches filenames ending in \c .xsd)

        Sets @ref def_path to \a dir if not already set. Individual files retain their own resolution bases.
        @throw XSD-ERROR an invalid schema root
        @throw WSDL-ERROR invalid schema declarations or dependency graph
        @note A failed call restores the original default base. Files successfully added before a later
        file fails remain available; each file addition is atomic.
    */
    addSchemaDir(string dir, string regex = "\\.xsd$") {
        *string previous_base = def_path;
        on_error def_path = previous_base;
        if (!def_path) {
            def_path = dir;
        }
        Dir d();
        d.chdir(dir);
        list<string> files = d.listFiles(regex);
        foreach string f in (sort(files)) {
            addSchemaFile(dir + DirSep + f);
        }
    }

    #! returns the list of namespace URIs in which top-level elements are declared
    list<string> getElementNamespaces() {
        return keys emap;
    }

    #! returns the names of all top-level elements declared in the given namespace
    /** @param ns the namespace URI; if not provided, returns names from all namespaces
    */
    list<string> getElementNames(*string ns) {
        if (exists ns) {
            return keys (emap{ns} ?? {});
        }
        list<string> result = ();
        foreach string n in (keys emap) {
            result += keys emap{n};
        }
        return result;
    }

    #! returns the top-level element by namespace and local name, or NOTHING if not found
    *XsdElement getElement(string ns, string name) {
        return emap{ns}{name};
    }

    #! returns a global attribute by expanded name
    /** @param ns the namespace URI, or an empty string for no namespace
        @param name the local attribute name
        @return the declaration, or NOTHING if it does not exist
        @since %WSDL 0.5.8
    */
    *XsdAttribute getAttribute(string ns, string name) {
        return attributeMap{type_qname(ns, name)};
    }

    #! validates a retained XML value against its global element declaration
    /** @param value a complete XML element
        @return the same immutable value after native decode and encode checks
        @throw SOAP-SERIALIZATION-ERROR no matching global declaration or rejected content
        @since %WSDL 0.5.8
    */
    XsdXmlValue validateXmlValue(XsdXmlValue value) {
        XsdIdentityDocumentScope identity_document();
        *XsdElement element = getElement(value.getNamespaceUri(), value.getLocalName());
        if (!element) {
            throw SOAP_SERIALIZATION_ERROR, sprintf("no global element declaration for XML value %Y",
                value.getExpandedName());
        }
        element.validateXmlValue(value, nsc, tmap);
        return value;
    }

    #! creates a validated retained XML value
    /** @param xml a complete XML element document
        @return an immutable XML value checked against its global declaration
        @throw PARSE-XML-EXCEPTION malformed XML
        @throw SOAP-SERIALIZATION-ERROR no matching declaration or rejected content
        @since %WSDL 0.5.8
    */
    XsdXmlValue getXmlValue(string xml) {
        return validateXmlValue(new XsdXmlValue(xml));
    }

    #! serializes a native value as one complete global XML element
    /** @param namespace_uri the global element namespace, or an empty string
        @param local_name the global element's local name
        @param value the native value accepted by the element's schema type, or a ^element^ / ^val^ wrapper
        selecting an admitted concrete member by XsdQNameValue
        @return an immutable XML value with its complete namespace context
        @throw WSDL-ERROR the global element does not exist
        @throw SOAP-SERIALIZATION-ERROR invalid content or conflicting lexical namespace requirements
        @note Unlike low-level serializeValue() fragments, the complete element lets output
        processing preserve QName attributes, list items and scoped union member selection.
        The schema's shared namespace registry is unchanged.
        @par Example
        Serialize a catalog record whose category is an XsdQNameValue before storing or sending
        its XML outside a SOAP envelope.
        @since %WSDL 0.5.8
    */
    XsdXmlValue serializeXmlValue(string namespace_uri, string local_name, auto value) {
        XsdIdentityDocumentScope identity_document();
        XsdNativeTypeOutputScope type_scope(tmap);
        *XsdElement element = getElement(namespace_uri, local_name);
        if (!element) {
            throw WSDL_ERROR, sprintf("no global element declaration %Y", type_qname(namespace_uri, local_name));
        }
        Namespaces namespaces = nsc.copy();
        XsdQNameOutputScope output_scope(namespaces);
        element = XsdElementValueHelper::select(element, \value);
        auto serialized = element.serializeValue(namespaces, value, True, local_name, local_name);
        hash<auto> content();
        if (serialized.typeCode() == NT_HASH) {
            content += serialized;
        } else {
            content."^value^" = serialized;
        }
        string root = element.getXmlName(namespaces);
        content."^attributes^" += namespaces.getOutputNamespaceHash(NOTHING);
        if (!element.getNamespaceUri()) {
            content."^attributes^".xmlns = "";
        }
        XsdQNameXmlOutputHelper output();
        return new XsdXmlValue(make_xml(output.prepare({root: content})));
    }

    #! returns an opt-in provider type for a retained XML element
    /** @param namespace_uri the global element namespace, or an empty string
        @param local_name the global element's local name
        @return a provider that validates and retains XsdXmlValue instances
        @throw WSDL-ERROR the global element does not exist
        @note Ordinary getDataProviderType() methods continue to describe native values.
        @since %WSDL 0.5.8
    */
    AbstractDataProviderType getXmlDataProviderType(string namespace_uri, string local_name) {
        *XsdElement element = getElement(namespace_uri, local_name);
        if (!element) {
            throw WSDL_ERROR, sprintf("no global element declaration %Y", type_qname(namespace_uri, local_name));
        }
        return new XsdXmlValueDataType(self, namespace_uri, local_name);
    }

    #! returns an explicit provider for native values retaining selected element types
    /** @param namespace_uri the global element namespace, or an empty string
        @param local_name the global element name
        @return a native provider accepting declared values, selected type wrappers and concrete element selections
        @throw WSDL-ERROR the global element does not exist
        @note The receiving schema and available element alternatives are retained independently of the source
        object's lifetime. Construct a new provider to include declarations added after the provider was created.
        @par Example
        Validate a stored shipment part with its selected subtype before forwarding it.
        @since %WSDL 0.5.8
    */
    AbstractDataProviderType getNativeDataProviderType(string namespace_uri, string local_name) {
        *XsdElement element = getElement(namespace_uri, local_name);
        if (!element) {
            throw WSDL_ERROR, sprintf("no global element declaration %Y", type_qname(namespace_uri, local_name));
        }
        if (XsdElementValueHelper::needsSelection(element)) {
            XsdNativeTypeProviderContext owner(tmap);
            XsdNativeTypeProviderScope scope(owner);
            XsdElementDataType result(element, tmap);
            owner.complete();
            return result;
        }
        return XsdNativeTypeProviderHelper::create(element.type, tmap, element);
    }


    #! looks up a type by name; returns NOTHING if not found
    *XsdAbstractType findType(string name) {
        return tmap{name};
    }

    #! returns the underlying type map (name -> XsdAbstractType)
    hash<string, XsdAbstractType> getTypeMap() {
        return tmap;
    }

    #! returns a hash value that can be used to serialize a value as a particular type
    hash<auto> getType(string name, auto v) {
        return ("^type^": tmap_get(tmap, name), "^val^": v);
    }

    private string schemaSourceKey(string xml, *string uri, *string base, *string location) {
        if (exists location) {
            # A full URI determines resolution independently of the fallback directory.
            location = WSDLLib::resolveDocumentLocation("", location);
            return sprintf("uri:%Y:%Y:%s", uri ?? "", location, xml.toSHA512());
        }
        # Legacy inline sources have only a directory base.
        if (base) {
            base = WSDLLib::resolveLocation(".", base);
            base =~ s{/+$}{};
        }
        return sprintf("base:%Y:%Y:%s", uri ?? "", base ?? "", xml.toSHA512());
    }

    private validateSchemaRoot(string xml, string error) {
        XmlReader reader(xml);
        while (reader.read()) {
            if (reader.nodeType() == XML_NODE_TYPE_ELEMENT) {
                if (reader.namespaceUri() != XSD_NS || reader.localName() != "schema") {
                    throw error, sprintf("expected XSD schema root, got {%s}%s", reader.namespaceUri() ?? "",
                        reader.localName());
                }
                return;
            }
        }
        throw error, "missing XSD schema root";
    }

    # Check the ordered schema grammar before parseTypes groups declarations by name.
    private validateSchemaGrammar(string xml) {
        XmlReader reader(xml);
        XsdFacetGrammarHelper facet_grammar();
        XsdAnnotationGrammarHelper annotations();
        XsdIdentityGrammarHelper identities();
        int schema_depth = -1;
        int notation_depth = -1;
        bool notation_annotation = False;
        bool declared = False;
        bool definitions = False;
        bool types = False;
        const string wsdl_namespace = "http://schemas.xmlsoap.org/wsdl/";
        const hash<string, bool> declarations = {"simpleType": True, "complexType": True, "group": True,
            "attributeGroup": True, "element": True, "attribute": True, "notation": True};
        while (reader.read()) {
            int depth = reader.depth();
            int kind = reader.nodeType();
            if (schema_depth >= 0) {
                facet_grammar.consume(reader);
                annotations.consume(reader);
                identities.consume(reader);
            }
            if (kind == XML_NODE_TYPE_END_ELEMENT) {
                if (depth == notation_depth) {
                    notation_depth = -1;
                }
                if (depth == schema_depth) {
                    schema_depth = -1;
                }
                if (depth == 1) {
                    types = False;
                }
                continue;
            }
            if (kind != XML_NODE_TYPE_ELEMENT) {
                continue;
            }
            *string uri = reader.namespaceUri();
            string local = reader.localName();
            if (depth == 0) {
                definitions = uri == wsdl_namespace && local == "definitions";
            }
            if (depth == 1) {
                types = definitions && uri == wsdl_namespace && local == "types";
            }
            if (uri == XSD_NS && local == "schema" && (depth == 0 || (depth == 2 && types))) {
                annotations.consume(reader);
                identities.consume(reader);
                schema_depth = reader.isEmptyElement() ? -1 : depth;
                declared = False;
            } else if (schema_depth >= 0 && depth == schema_depth + 1) {
                if (uri != XSD_NS) {
                    throw WSDL_ERROR, sprintf("schema grammar: unexpected child {%s}%s", uri ?? "", local);
                }
                if (local == "import" || local == "include" || local == "redefine") {
                    if (declared) {
                        throw WSDL_ERROR, sprintf("schema grammar: %s must precede component declarations", local);
                    }
                } else if (declarations{local}) {
                    declared = True;
                    if (local == "notation") {
                        XsdNotationDeclarationHelper::attributes(reader);
                        notation_depth = reader.isEmptyElement() ? -1 : depth;
                        notation_annotation = False;
                    }
                } else if (local != "annotation") {
                    throw WSDL_ERROR, sprintf("schema grammar: unexpected child {%s}%s", uri, local);
                }
            } else if (notation_depth >= 0 && depth == notation_depth + 1) {
                if (uri != XSD_NS || local != "annotation" || notation_annotation) {
                    throw WSDL_ERROR, "notation content permits only one optional XSD annotation";
                }
                notation_annotation = True;
            }
        }
    }

    #! parse \a opts into XSD-specific state
    private initOptions(*hash<auto> opts) {
        self.opts = opts;
        resource_locations = (opts.resource_locations ?? {}) + resource_locations;
        try_import = opts.try_import;
        if (try_import) {
            remove self.opts.try_import;
            has_try_import = True;
        }
        def_path = opts.def_path;
        document_location = opts.document_location;
        if (exists document_location) {
            document_location = WSDLLib::resolveDocumentLocation("", document_location);
