    #! returns the PCRE character range for an XSD \c "\p{IsXxx}" block name, if it is known
    /** @param prop the property name from the escape, ex: \c "IsBasicLatin"

        @return the corresponding character range (ex: \c "\x{0000}-\x{007F}"), or \c NOTHING if \a prop does
        not name a Unicode block

        @since %WSDL 0.5.8
    */
    static *string getBlockRange(string prop) {
        if (prop !~ /^Is/) {
            return;
        }
        # block names are compared ignoring case, whitespace, hyphens, and underscores
        string key = prop.substr(2).lwr();
        key =~ s/[[:space:]_-]//g;
        return XsdRegexHelper::UnicodeBlocks{key};
    }

    #! the maximum length of a generated sample value
    const MaxSampleLength = 256;

    #! the maximum nesting depth accepted when generating a sample value
    const MaxSampleDepth = 32;

    #! characters tried in order when looking for one accepted by a character class
    const SampleChars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
        + " -_.:+@!$#%&*/=?,;'<>()[]{}|~^\"\\\t\n\r";

    #! returns a bounded sample matching the given XSD pattern, or \c NOTHING if none can be generated
    /** Generation selects the first alternation branch and searches a fixed character alphabet for classes.
        If no candidate can be constructed within the depth and length limits, or if the pattern is invalid,
        \c NOTHING is returned. The caller must validate any alternative default against the complete type.

        @param xsd the XSD regular expression to generate a value for
        @param min_reps minimum repetitions to use for optional pattern components

        @return a value matching \a xsd, or \c NOTHING if none could be generated
        @note Unexpected errors and cancellation propagate to the caller.
    */
    static *string getSampleValue(string xsd, int min_reps = 0) {
        int i = 0;
        string rv;
        XsdPatternConstraint constraint;
        try {
            constraint = XsdPatternConstraintHelper::compile(xsd);
            rv = XsdRegexHelper::sampleAlternation(xsd, \i, 0, min_reps);
            # the whole pattern must have been consumed
            if (i < xsd.length()) {
                return;
            }
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "XSD-REGEX-SAMPLE-ERROR" && ex.err != "XSD-REGEX-ERROR") {
                rethrow;
            }
            return;
        }
        # never return a value that does not match the pattern it was generated from
        try {
            return XsdPatternConstraintHelper::matches(rv, constraint) ? rv : NOTHING;
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "XSD-REGEX-ERROR" && ex.err != "REGEX-ERROR" && ex.err != "REGEX-COMPILATION-ERROR") {
                rethrow;
            }
            return;
        }
    }

    #! generates a sample for an alternation; the first branch is used
    private static string sampleAlternation(string xsd, reference<int> i, int depth, int min_reps) {
        if (depth > XsdRegexHelper::MaxSampleDepth) {
            throw "XSD-REGEX-SAMPLE-ERROR", "expression nested too deeply";
        }
        string rv = XsdRegexHelper::sampleSequence(xsd, \i, depth, min_reps);
        # parse and discard the remaining branches
        while (i < xsd.length() && xsd[i] == "|") {
            ++i;
            XsdRegexHelper::sampleSequence(xsd, \i, depth, min_reps);
        }
        return rv;
    }

    #! generates a sample for a sequence of pieces
    private static string sampleSequence(string xsd, reference<int> i, int depth, int min_reps) {
        string rv = "";
        while (i < xsd.length()) {
            string c = xsd[i];
            if (c == "|" || c == ")") {
                break;
            }
            int before = i;
            rv += XsdRegexHelper::samplePiece(xsd, \i, depth, min_reps);
            if (i == before) {
                throw "XSD-REGEX-SAMPLE-ERROR", sprintf("no progress parsing %y at offset %d", xsd, i);
            }
            if (rv.length() > XsdRegexHelper::MaxSampleLength) {
                throw "XSD-REGEX-SAMPLE-ERROR", "sample value too long";
            }
        }
        return rv;
    }

    #! generates a sample for an atom and its quantifier, repeating the atom the minimum number of times
    private static string samplePiece(string xsd, reference<int> i, int depth, int min_reps) {
        string atom = XsdRegexHelper::sampleAtom(xsd, \i, depth, min_reps);
        int min = 1;
        # the upper bound of the quantifier, if it has one
        *int max = 1;
        if (i < xsd.length()) {
            switch (xsd[i]) {
                case "?":
                    min = 0;
                    ++i;
                    break;

                case "*":
                    min = 0;
                    delete max;
                    ++i;
                    break;

                case "+":
                    delete max;
                    ++i;
                    break;

                case "{": {
                    int close = index(xsd, "}", i);
                    if (close < 0) {
                        throw "XSD-REGEX-SAMPLE-ERROR", "unterminated quantifier";
                    }
                    string body = xsd.substr(i + 1, close - i - 1);
                    *string mn = (body =~ x/^([0-9]+)/)[0];
                    if (!exists mn) {
                        throw "XSD-REGEX-SAMPLE-ERROR", "unsupported quantifier";
                    }
                    min = sampleCount(mn);
                    if (body !~ /,/) {
                        max = min;
                    } else {
                        *string mx = (body =~ x/,\s*([0-9]+)$/)[0];
                        if (exists mx) {
                            max = sampleCount(mx);
                        } else {
                            delete max;
                        }
                    }
                    i = close + 1;
                    break;
                }
            }
        }
        # repeat the atom more often when a longer value is required, but never more than the quantifier allows
        int reps = min_reps > min ? min_reps : min;
        if (exists max && reps > max) {
            reps = max;
        }
        if (!atom.length()) {
            return "";
        }
        if (reps > XsdRegexHelper::MaxSampleLength / atom.length()) {
            throw "XSD-REGEX-SAMPLE-ERROR", "sample value too long";
        }
        string rv = "";
        for (int j = 0; j < reps; ++j) {
            rv += atom;
        }
        return rv;
    }

    #! bounds sample work before converting an arbitrary-size repetition count to a native integer
    private static int sampleCount(string count) {
        string canonical = XsdIntegerLexicalHelper::canonical(count);
        int limit = MaxSampleLength + 1;
        return XsdIntegerLexicalHelper::compare(canonical, limit.toString()) > 0 ? limit : canonical.toInt();
    }

    #! generates a sample for a single atom
    private static string sampleAtom(string xsd, reference<int> i, int depth, int min_reps) {
        switch (xsd[i]) {
            case "(": {
                ++i;
                string rv = XsdRegexHelper::sampleAlternation(xsd, \i, depth + 1, min_reps);
                if (i >= xsd.length() || xsd[i] != ")") {
                    throw "XSD-REGEX-SAMPLE-ERROR", "unterminated group";
                }
                ++i;
                return rv;
            }

            case "[":
                return XsdRegexHelper::sampleClass(xsd, \i);

            case "\\":
                return XsdRegexHelper::sampleEscape(xsd, \i);

            case ".":
                ++i;
                return "a";
        }
        string c = xsd[i];
        ++i;
        return c;
    }

    #! generates a sample character for an escape sequence
    private static string sampleEscape(string xsd, reference<int> i) {
        if (i + 1 >= xsd.length()) {
            throw "XSD-REGEX-SAMPLE-ERROR", "trailing backslash";
        }
        string e = xsd[i + 1];
        i += 2;
        switch (e) {
            case "d": return "0";
            case "w":
            case "i":
            case "c": return "a";
            case "s": return " ";
            case "n": return "\n";
            case "r": return "\r";
            case "t": return "\t";
            # the complement escapes: a character that is in none of the corresponding sets
            case "D":
            case "S": return "a";
            case "W":
            case "I":
            case "C": return "!";
            case "p":
            case "P": {
                *string prop = XsdRegexHelper::readProperty(xsd.splitChars(), \i);
                if (!exists prop) {
                    throw "XSD-REGEX-SAMPLE-ERROR", "unsupported property escape";
                }
                if (e == "P") {
                    return "!";
                }
                *string range = XsdRegexHelper::getBlockRange(prop);
                if (exists range) {
                    return XsdRegexHelper::sampleForPattern("[" + range + "]")
                        ?? XsdRegexHelper::firstCharOfRange(range);
                }
                return XsdRegexHelper::sampleForPattern(sprintf("\\p{%s}", prop))
                    ?? (prop =~ /^N/ ? "0" : "a");
            }
        }
        return e;
    }

    #! generates a sample character accepted by a character class
    private static string sampleClass(string xsd, reference<int> i) {
        int start = i;
        # convert the class first, so that negation and character class subtraction are handled
        string pcre = XsdRegexHelper::classToPcre(xsd.splitChars(), \i);
        *string ch = XsdRegexHelper::sampleForPattern(pcre);
        if (exists ch) {
            return ch;
        }
        throw "XSD-REGEX-SAMPLE-ERROR", sprintf("no sample character for character class %y",
            xsd.substr(start, i - start));
    }

    #! returns the first of @ref SampleChars accepted by the given PCRE expression, if any
    private static *string sampleForPattern(string pcre) {
        for (int j = 0; j < XsdRegexHelper::SampleChars.length(); ++j) {
            string ch = XsdRegexHelper::SampleChars[j];
            try {
                if (regex(ch, "^(?:" + pcre + ")$")) {
                    return ch;
                }
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "REGEX-ERROR" && ex.err != "REGEX-COMPILATION-ERROR") {
                    rethrow;
                }
                # An expression that cannot be compiled cannot produce a sample.
                return;
            }
        }
    }

    #! returns the character at the start of a character range such as \c "\x{0370}-\x{03FF}"
    private static string firstCharOfRange(string range) {
        *string cp = (range =~ x/^\\x\{([0-9A-Fa-f]+)\}/)[0];
        if (!exists cp) {
            throw "XSD-REGEX-SAMPLE-ERROR", sprintf("cannot derive a sample from range %y", range);
        }
        # note that chr() operates on bytes, while <int>::toUnicode() returns the character for a code point
        return cp.toInt(16).toUnicode();
    }

    #! converts an XSD regular expression to the equivalent PCRE expression
    /** @param xsd an XSD 1.0 pattern
        @return the translated expression, without implicit whole-value anchors
        @throw XSD-REGEX-ERROR the pattern does not satisfy the XSD grammar or names an unknown Unicode block

        @par Example
        The product-code pattern \c "[a-z-[aeiou]]+" accepts lowercase consonants; the returned expression
        implements character-class subtraction using single-character lookahead assertions.

        @note The caller must add whole-value anchors and compile the expression. PCRE's compilation and
        matching resource limits still apply independently of XSD syntax validation.
    */
    static string toPcre(string xsd) {
        return XsdRegexParser::parse(xsd);
    }

    #! the single-character escapes allowed by XSD 1.0 Appendix F, production 24
    const SingleEscapes = {"n": "\n", "r": "\r", "t": "\t", "\\": "\\", "|": "|", ".": ".",
        "-": "-", "^": "^", "?": "?", "*": "*", "+": "+", "{": "{", "}": "}", "(": "(", ")": ")",
        "[": "[", "]": "]"};

    #! converts one escape to a complete single-character expression
    private static string escapeToPcre(list<string> xsd, reference<int> i) {
        if (i + 1 >= xsd.size()) {
            throw "XSD-REGEX-ERROR", "trailing backslash";
        }
        string e = xsd[i + 1];
        i += 2;
        if (SingleEscapes.hasKey(e)) {
            return sprintf("\\x{%X}", SingleEscapes{e}.getUnicode());
        }
        switch (e) {
            case "i": return "[" + NameStartChars + "]";
            case "I": return "[^" + NameStartChars + "]";
            case "c": return "[" + NameChars + "]";
            case "C": return "[^" + NameChars + "]";
            case "s": return "[" + SpaceChars + "]";
            case "S": return "[^" + SpaceChars + "]";
            case "d": return "\\p{Nd}";
            case "D": return "\\P{Nd}";
            case "w": return "[^" + NonWordCategories + "]";
            case "W": return "[" + NonWordCategories + "]";
            case "p":
            case "P": {
                *string prop = readProperty(xsd, \i);
                if (!exists prop) {
                    throw "XSD-REGEX-ERROR", "a property escape requires a braced property name";
                }
                if (regex(prop, '\A(?:L[ultmo]?|M[nce]?|N[dlo]?|P[cdseifo]?|Z[slp]?|S[mcko]?|C[cfon]?)\z')) {
                    return sprintf("\\%s{%s}", e, prop);
                }
                if (!regex(prop, '\AIs[A-Za-z0-9-]+\z')) {
                    throw "XSD-REGEX-ERROR", sprintf("invalid XSD character property %Y", prop);
                }
                *string range = getBlockRange(prop);
                if (!exists range) {
                    throw "XSD-REGEX-ERROR", sprintf("unknown XSD Unicode block %Y", prop);
                }
                return "[" + (e == "P" ? "^" : "") + range + "]";
            }
        }
        throw "XSD-REGEX-ERROR", sprintf("invalid XSD escape %Y", e);
    }

    #! reads the \c "{...}" property name of a \c "\p" or \c "\P" escape; \a i is advanced past it
    private static *string readProperty(list<string> xsd, reference<int> i) {
        if (i >= xsd.size() || xsd[i] != "{") {
            return;
        }
        int close = i + 1;
        list<string> name();
        while (close < xsd.size() && xsd[close] != "}") {
            push name, xsd[close++];
        }
        if (close == xsd.size()) {
            return;
        }
        i = close + 1;
        return name.join("");
    }

    #! combines a positive or negative group of single-character expressions
    private static string characterGroup(list<string> terms, bool negative) {
        if (!terms) {
            throw "XSD-REGEX-ERROR", "an XSD character group must not be empty";
        }
        string group = terms.size() == 1 ? terms[0] : "(?:" + terms.join("|") + ")";
        return negative ? "(?:(?!" + group + ")[\\s\\S])" : group;
    }

    #! parses a literal character or a single-character escape used as a range endpoint
    private static int rangeCharacter(list<string> xsd, reference<int> i) {
        if (i >= xsd.size()) {
            throw "XSD-REGEX-ERROR", "missing character range endpoint";
        }
        string value = xsd[i];
        if (value == "\\") {
            if (i + 1 >= xsd.size() || !SingleEscapes.hasKey(xsd[i + 1])) {
                throw "XSD-REGEX-ERROR", "a range endpoint must be one character";
            }
            value = SingleEscapes{xsd[i + 1]};
            i += 2;
        } else {
            if (value == "[" || value == "]" || value == "-") {
                throw "XSD-REGEX-ERROR", "invalid unescaped character range endpoint";
            }
            ++i;
        }
        return value.getUnicode();
    }

    #! converts XSD character classes with iterative, linear-size subtraction assembly
    private static string classToPcre(list<string> xsd, reference<int> i, *XsdRegexProgram program = NOTHING) {
        list<string> parents();
        list<int> parent_sets();
        while (True) {
            @assert(i < xsd.size() && xsd[i] == "[");
            ++i;
            bool negative = i < xsd.size() && xsd[i] == "^";
            if (negative) {
                ++i;
            }
            list<string> terms();
            list<int> set_terms();
            bool subtract = False;
            while (i < xsd.size() && xsd[i] != "]") {
                string c = xsd[i];
                if (c == "-" && i + 1 < xsd.size() && xsd[i + 1] == "[") {
                    push parents, characterGroup(terms, negative);
                    if (program) {
                        push parent_sets, program.makeSet(set_terms, negative);
                    }
                    ++i;
                    subtract = True;
                    break;
                }
                if (c == "-") {
                    bool last = i + 1 < xsd.size() && (xsd[i + 1] == "]"
                        || (i + 2 < xsd.size() && xsd[i + 1] == "-" && xsd[i + 2] == "["));
                    if (terms && !last) {
                        throw "XSD-REGEX-ERROR", "an unescaped hyphen must start or end a positive character group";
                    }
                    push terms, "\\x{2D}";
                    if (program) {
                        push set_terms, program.makeCharacter(terms[-1]);
                    }
                    ++i;
                    continue;
                }
                if (c == "\\" && i + 1 < xsd.size() && !SingleEscapes.hasKey(xsd[i + 1])) {
                    string escaped = escapeToPcre(xsd, \i);
                    push terms, escaped;
                    if (program) {
                        push set_terms, program.makeCharacter(escaped);
                    }
                    continue;
                }
                int start = rangeCharacter(xsd, \i);
                bool range = i + 1 < xsd.size() && xsd[i] == "-" && xsd[i + 1] != "["
                    && xsd[i + 1] != "]"
                    && !(i + 2 < xsd.size() && xsd[i + 1] == "-" && xsd[i + 2] == "[");
                if (range) {
                    ++i;
                    int end = rangeCharacter(xsd, \i);
                    if (start > end) {
                        throw "XSD-REGEX-ERROR", "character range end precedes its start";
                    }
                    push terms, sprintf("[\\x{%X}-\\x{%X}]", start, end);
                    if (program) {
                        push set_terms, program.makeCharacter(terms[-1]);
                    }
                } else {
                    push terms, sprintf("\\x{%X}", start);
                    if (program) {
                        push set_terms, program.makeCharacter(terms[-1]);
                    }
                }
            }
            if (subtract) {
                continue;
            }
            if (i >= xsd.size()) {
                throw "XSD-REGEX-ERROR", "unterminated character class";
            }
            ++i;
            string leaf = characterGroup(terms, negative);
            int set_root;
            if (program) {
                set_root = program.makeSet(set_terms, negative);
            }
            list<string> pieces();
            foreach string parent in (parents) {
                push pieces, "(?:(?!";
            }
            push pieces, leaf;
            for (int parent = parents.size() - 1; parent >= 0; --parent) {
                if (i >= xsd.size() || xsd[i] != "]") {
                    throw "XSD-REGEX-ERROR", "subtraction must end its enclosing character class";
                }
                ++i;
                push pieces, ")" + parents[parent] + ")";
                if (program) {
                    set_root = program.makeDifference(parent_sets[parent], set_root);
                }
            }
            if (program) {
                program.appendAtom(set_root);
            }
            return pieces.join("");
        }
    }

}

#! a literal's namespace identity, captured before its declaration scope is restored
hashdecl XsdQNameDeclarationLiteral {
    string lexical;
    *string namespace_uri;
}

#! Validate facet declarations before constructing their value-space constraints.
class XsdFacetDeclarationHelper {
    const Names = {"minInclusive": True, "maxInclusive": True, "minExclusive": True, "maxExclusive": True,
        "length": True, "minLength": True, "maxLength": True, "totalDigits": True, "fractionDigits": True,
        "whiteSpace": True, "pattern": True, "enumeration": True};

    static hash<string, bool> validate(hash<auto> restriction, Namespaces nsc,
            reference<*list<hash<XsdQNameDeclarationLiteral>>> literals) {
        hash<string, bool> fixed();
        foreach string facet in (keys restriction) {
            if (facet == "annotation" || facet == "simpleType" || facet == "ns" || facet == "^attributes^") {
                continue;
            }
            if (!Names{facet}) {
                throw "XSD-SIMPLETYPE-ERROR", sprintf("unexpected simple restriction child %Y", facet);
            }
            auto raw = restriction{facet};
            if (raw.typeCode() == NT_LIST && facet != "pattern" && facet != "enumeration") {
                throw "XSD-SIMPLETYPE-ERROR", sprintf("facet %Y must occur at most once per restriction", facet);
            }
            foreach auto node in (raw ?? (NOTHING,)) {
                if (node.typeCode() != NT_HASH || !exists node."^attributes^".value
                        || node."^attributes^".value.typeCode() != NT_STRING) {
                    throw "XSD-SIMPLETYPE-ERROR", sprintf("facet %Y requires a lexical value attribute", facet);
                }
                hash<auto> attributes = node."^attributes^";
                NamespacePrefixHelper scope(nsc, attributes);
                foreach string key in (keys attributes) {
                    if (key == "value" || key == "id" || key == "xmlns" || key.startsWith("xmlns:")) {
                        continue;
                    }
                    if (key == "fixed" && facet != "pattern" && facet != "enumeration") {
                        fixed{facet} = XsdBooleanLexicalHelper::decode(attributes.fixed, "XSD-SIMPLETYPE-ERROR");
                        continue;
                    }
                    if (key.find(":") >= 0) {
                        string prefix = key.substr(0, key.find(":"));
                        if (nsc.getInputNamespaceUri(prefix) != XSD_NS) {
                            continue;
                        }
                    }
                    throw "XSD-SIMPLETYPE-ERROR", sprintf("unexpected attribute %Y on facet %Y", key, facet);
                }
                hash<auto> content = node;
                WSDL::XsdBase::removeNS(\content);
                foreach string key in (keys content) {
                    if (key == "^attributes^" || key == "ns") {
                        continue;
                    }
                    if (key == "annotation" && content{key}.typeCode() != NT_LIST) {
                        continue;
                    }
                    throw "XSD-SIMPLETYPE-ERROR", sprintf("unexpected content %Y in facet %Y", key, facet);
                }
                if (facet == "whiteSpace") {
                    string value = XsdSimpleType::normalizeWhiteSpace(attributes.value, "collapse");
                    if (value != "preserve" && value != "replace" && value != "collapse") {
                        throw "XSD-SIMPLETYPE-ERROR", sprintf("invalid whiteSpace facet %Y", attributes.value);
                    }
                }
                if (facet == "enumeration") {
                    # The base may be resolved later. Retain every literal, including equal
                    # spellings with different bindings, without copying complete namespace maps.
                    string lexical = XsdSimpleType::normalizeWhiteSpace(attributes.value, "collapse");
                    int colon = lexical.find(":");
                    string prefix = colon < 0 ? "" : lexical.substr(0, colon);
                    *string uri = prefix == "xml" ? "http://www.w3.org/XML/1998/namespace"
                        : prefix ? nsc.getInputNamespaceState().input{prefix} : (nsc.getDefaultNs() ?? "");
                    push literals, <XsdQNameDeclarationLiteral>{"lexical": lexical, "namespace_uri": uri};
                }
            }
        }
        return fixed;
    }
}

enum XsdFacetGrammarKind {
    XFG_OTHER = 0,
    XFG_SIMPLE_TYPE = 1,
    XFG_SIMPLE_CONTENT = 2,
    XFG_RESTRICTION = 3,
    XFG_FACET = 4,
}

hashdecl XsdFacetGrammarFrame {
    XsdFacetGrammarKind kind = XFG_OTHER;
    bool ignored = False;
    bool simple_content = False;
    bool annotation = False;
    bool inline_type = False;
    bool facets = False;
    bool attributes = False;
    bool any_attribute = False;
}

#! Check the ordered XML representation before parseTypes merges namespace-qualified child names.
class XsdFacetGrammarHelper {
    private {
        hash<string, hash<XsdFacetGrammarFrame>> frames;
    }

    consume(XmlReader reader) {
        int depth = reader.depth();
        string key = string(depth);
        if (reader.nodeType() == XML_NODE_TYPE_END_ELEMENT) {
            remove frames{key};
            return;
        }
        *hash<XsdFacetGrammarFrame> parent = frames{string(depth - 1)};
        if (reader.nodeType() != XML_NODE_TYPE_ELEMENT) {
            if (parent && (parent.kind == XFG_RESTRICTION || parent.kind == XFG_FACET)
                    && (reader.nodeType() == XML_NODE_TYPE_TEXT || reader.nodeType() == XML_NODE_TYPE_CDATA
                        || reader.nodeType() == XML_NODE_TYPE_SIGNIFICANT_WHITESPACE)
                    && XsdSimpleType::normalizeWhiteSpace(reader.value() ?? "", "collapse").val()) {
                throw "XSD-SIMPLETYPE-ERROR", "facet and restriction declarations cannot contain character data";
            }
            return;
        }
        string local = reader.localName();
        bool xsd = reader.namespaceUri() == XSD_NS;
        hash<XsdFacetGrammarFrame> current();
        current.ignored = parent.ignored || (xsd && local == "annotation");
        if (parent && (parent.kind == XFG_SIMPLE_TYPE || parent.kind == XFG_SIMPLE_CONTENT)) {
            string error = parent.kind == XFG_SIMPLE_CONTENT ? WSDL_ERROR : "XSD-SIMPLETYPE-ERROR";
            if (!xsd) {
                throw error, sprintf("unexpected simple type derivation {%s}%s",
                    reader.namespaceUri() ?? "", local);
            }
            if (local == "annotation" && !parent.annotation && !parent.facets) {
                parent.annotation = True;
            } else if (!parent.facets && (local == "restriction"
                    || (parent.kind == XFG_SIMPLE_TYPE && (local == "list" || local == "union"))
                    || (parent.kind == XFG_SIMPLE_CONTENT && local == "extension"))) {
                parent.facets = True;
                if (local == "restriction") {
                    current.kind = XFG_RESTRICTION;
                    current.simple_content = parent.kind == XFG_SIMPLE_CONTENT;
                }
            } else {
                throw error, "simple type content requires an optional annotation then one derivation";
            }
            frames{string(depth - 1)} = parent;
        } else if (parent && (parent.kind == XFG_RESTRICTION || parent.kind == XFG_FACET)) {
            if (!xsd) {
                throw "XSD-SIMPLETYPE-ERROR", sprintf("unexpected restriction content {%s}%s",
                    reader.namespaceUri() ?? "", local);
            }
            if (local == "annotation") {
                if (parent.annotation || parent.inline_type || parent.facets || parent.attributes) {
                    throw "XSD-SIMPLETYPE-ERROR", "annotation must occur once, before other restriction content";
                }
                parent.annotation = True;
            } else if (parent.kind == XFG_FACET) {
                throw "XSD-SIMPLETYPE-ERROR", sprintf("unexpected facet child %Y", local);
            } else if (local == "simpleType") {
                if (parent.inline_type || parent.facets || parent.attributes) {
                    throw "XSD-SIMPLETYPE-ERROR", "inline simpleType must precede restriction facets";
                }
                parent.inline_type = True;
                current.kind = XFG_SIMPLE_TYPE;
            } else if (XsdFacetDeclarationHelper::Names{local}) {
                if (parent.attributes) {
                    throw "XSD-SIMPLETYPE-ERROR", "restriction facets must precede attributes";
                }
                parent.facets = True;
                current.kind = XFG_FACET;
                validateAttributes(reader, local);
            } else if (parent.simple_content
                    && (local == "attribute" || local == "attributeGroup" || local == "anyAttribute")) {
                if (parent.any_attribute) {
                    throw "XSD-SIMPLETYPE-ERROR", "anyAttribute must be the last restriction child";
                }
                parent.attributes = True;
                parent.any_attribute = local == "anyAttribute";
            } else {
                throw "XSD-SIMPLETYPE-ERROR", sprintf("unexpected restriction child %Y", local);
            }
            frames{string(depth - 1)} = parent;
        } else if (!current.ignored && xsd) {
            if (local == "simpleType") {
                current.kind = XFG_SIMPLE_TYPE;
            } else if (local == "simpleContent") {
                current.kind = XFG_SIMPLE_CONTENT;
            }
        }
        if (!reader.isEmptyElement()) {
            frames{key} = current;
        }
    }

    private static validateAttributes(XmlReader reader, string facet) {
        if (!reader.moveToFirstAttribute()) {
            return;
        }
        on_exit reader.moveToElement();
        do {
            *string uri = reader.namespaceUri();
            string name = reader.localName();
            if (uri) {
                if (uri != XSD_NS) {
                    continue;
                }
            } else if (name == "value" || name == "id"
                    || (name == "fixed" && facet != "pattern" && facet != "enumeration")) {
                continue;
            }
            throw "XSD-SIMPLETYPE-ERROR", sprintf("unexpected attribute {%s}%s on facet %Y", uri ?? "", name, facet);
        } while (reader.moveToNextAttribute());
    }
}

#! XSD simple type class
public class XsdSimpleType inherits WSDL::XsdAbstractType {
    private {
        hash<string, bool> fixedFacets;
        transient *list<hash<XsdQNameDeclarationLiteral>> pendingQNameEnumeration;
        *hash<string, hash<string, bool>> qnameEnumValues;
        *hash<string, bool> stringEnumValues;
        *hash<XsdListItemInfo> listItemValueInfo;
        *list<list<auto>> listEnumValues;
        *hash<string, bool> listEnumKeys;
        const StringKinds = {"string": True, "normalizedString": True, "token": True, "language": True,
            "Name": True, "NCName": True, "NMTOKEN": True, "ID": True, "IDREF": True, "ENTITY": True,
            "anyURI": True};
    }

    public {
        hash<auto> enumValues;
        hash<auto> typeinfo;
        list<hash<auto>> union;
        list<XsdAbstractType> unionTypes;
        XsdAbstractType type;
        AbstractDataProviderType dataType;
        bool usedocns;

        #! XSD restriction facets
        #! Pattern facets declared in this restriction
        /** a value matching any one of them is valid (XSD 1.0 part 2 4.3.4.3)
        */
        *list<string> patterns;
        #! compiled \c pattern facets, matched against the whole value
        /** New constraints use immutable XsdCompiledPattern objects retaining the original XSD source.
            Older serialized anchored PCRE strings remain readable. Compilation happens once per restriction.

            @since %WSDL 0.5.8
        */
        *list<XsdPatternConstraint> pcre_patterns;
        #! String length facets
        *XsdFacetCount minLength;
        *XsdFacetCount maxLength;
        *XsdFacetCount length;
        #! Numeric range facets
        *auto minInclusive;
        *auto maxInclusive;
        *auto minExclusive;
        *auto maxExclusive;
        #! Numeric precision facets, retaining a decimal string beyond the native integer range
        /** @since %WSDL 0.5.8 uses XsdFacetCount to avoid bounded conversion */
        *XsdFacetCount totalDigits;
        #! maximum fractional digits, with exact arbitrary-size count representation
        /** @since %WSDL 0.5.8 uses XsdFacetCount to avoid bounded conversion */
        *XsdFacetCount fractionDigits;
        #! WhiteSpace facet
        *string whiteSpace;

        #! List type support
        *XsdAbstractType listItemType;
        *hash<auto> listItemTypeInfo;
    }

    #! constructs a simple type from its schema declaration
    /** @param st the parsed simpleType declaration
        @param nsc the declaration namespace context
        @param unresolved the schema's late resolution queue
        @param n_usedocns the schema's element form policy
        @param desc_name descriptive name for an anonymous declaration
        @param resolved_base already resolved simple content to restrict, when the XML base denotes a complex type
        @throw XSD-SIMPLETYPE-ERROR malformed restriction or non-simple resolved base
        @throw WSDL-NAMESPACE-ERROR invalid or unresolved base QName prefix
        @since %WSDL 0.5.8 supports resolved_base for simple-content restrictions
    */
    constructor(hash<auto> st, Namespaces nsc, XsdLateResolverHelper unresolved, bool n_usedocns, *string desc_name,
            *XsdAbstractType resolved_base)
            : XsdAbstractType(\st, nsc, desc_name) {
        NamespacePrefixHelper declaration(nsc, st."^attributes^");
        usedocns = n_usedocns;
        #any a = st."^attributes^";
        delete st."^attributes^";

        WSDL::XsdBase::removeNS(\st);

        int alternatives = int(st.hasKey("restriction")) + int(st.hasKey("union")) + int(st.hasKey("list"));
        if (alternatives != 1) {
            throw "XSD-SIMPLETYPE-ERROR", sprintf("simpleType %Y requires exactly one restriction, list, or union", name);
        }
        if (st.hasKey("restriction")) {
            hash<auto> r = st.restriction ?? {};
            NamespacePrefixHelper restriction_scope(nsc, r."^attributes^");
            WSDL::XsdBase::removeNS(\r);

            *string base = r."^attributes^".base;
            if (exists base && r.hasKey("simpleType")) {
                throw "XSD-SIMPLETYPE-ERROR", "restriction cannot combine base and an inline simpleType";
            }
            if (!base && !resolved_base && !r.hasKey("simpleType")) {
                throw "XSD-SIMPLETYPE-ERROR", sprintf("missing 'base' attribute in simpleType %y restriction", name);
            }

            if (resolved_base) {
                if (!(resolved_base instanceof XsdSimpleType)
                        && (!(resolved_base instanceof XsdBaseType) || resolved_base.name == "anyType")) {
                    throw "XSD-SIMPLETYPE-ERROR", "resolved restriction base must be a simple type";
                }
                type = resolved_base;
            } else if (r.hasKey("simpleType")) {
                type = new XsdSimpleType(r.simpleType ?? {}, nsc, unresolved, n_usedocns);
            } else {
                nsc.doType(base, \typeinfo, \type);
            }

            WSDL::XsdBase::removeNS(\r);

            fixedFacets = XsdFacetDeclarationHelper::validate(r, nsc, \pendingQNameEnumeration);

            # Parse enumeration facet
            if (r.enumeration) {
                enumValues = map {$1."^attributes^".value: True}, r.enumeration;
            }

            # Parse pattern facets (multiple patterns allowed; they are combined with "|")
            if (r.pattern) {
                # Handle both single pattern (hash) and multiple patterns (list)
                if (r.pattern.typeCode() == NT_LIST) {
                    patterns = map $1."^attributes^".value, r.pattern;
                } else {
                    patterns = (r.pattern."^attributes^".value,);
                }
                # Compile the original XSD source once, independently of PCRE repetition/backtracking limits.
                if (patterns) {
                    try {
                        pcre_patterns = map XsdPatternConstraintHelper::compile($1), patterns;
                    } catch (hash<ExceptionInfo> ex) {
                        if (ex.err != "REGEX-ERROR" && ex.err != "REGEX-COMPILATION-ERROR"
                                && ex.err != "XSD-REGEX-ERROR") {
                            rethrow;
                        }
                        throw "XSD-SIMPLETYPE-ERROR", sprintf("invalid pattern facet: %s", ex.desc);
                    }
                }
            }

            # Parse length facets
            if (r.length) {
                length = XsdFacetCountHelper::parse("length", r.length."^attributes^".value);
            }
            if (r.minLength) {
                minLength = XsdFacetCountHelper::parse("minLength", r.minLength."^attributes^".value);
            }
            if (r.maxLength) {
                maxLength = XsdFacetCountHelper::parse("maxLength", r.maxLength."^attributes^".value);
            }

            # Parse numeric range facets
            if (r.minInclusive) {
                minInclusive = r.minInclusive."^attributes^".value;
            }
            if (r.maxInclusive) {
                maxInclusive = r.maxInclusive."^attributes^".value;
            }
            if (r.minExclusive) {
                minExclusive = r.minExclusive."^attributes^".value;
            }
            if (r.maxExclusive) {
                maxExclusive = r.maxExclusive."^attributes^".value;
            }

            # Parse precision facets
            if (r.totalDigits) {
                totalDigits = XsdFacetCountHelper::parse("totalDigits", r.totalDigits."^attributes^".value);
            }
            if (r.fractionDigits) {
                fractionDigits = XsdFacetCountHelper::parse("fractionDigits", r.fractionDigits."^attributes^".value);
            }

            # Parse whiteSpace facet
            if (r.whiteSpace) {
                whiteSpace = normalizeWhiteSpace(r.whiteSpace."^attributes^".value, "collapse");
            }
        } else if (st.hasKey("union")) {
            hash<auto> u = st.union ?? {};
            NamespacePrefixHelper union_scope(nsc, u."^attributes^");
            *string memberTypes = u."^attributes^".memberTypes;
            if (memberTypes) {
                foreach string str in (normalizeWhiteSpace(memberTypes, "collapse").split(" ")) {
                    union += nsc.getTypeHash(str);
                }
            }
            WSDL::XsdBase::removeNS(\u);
            # a union can have any number of anonymous simpleType member definitions
            foreach hash<auto> ust in (u.simpleType) {
                unionTypes += new XsdSimpleType(ust, nsc, unresolved, n_usedocns,
                    sprintf("simpleType %d for union simpleType %y", $# + 1, name));
            }

            if (!union && !unionTypes) {
                throw "XSD-SIMPLETYPE-ERROR", sprintf("union simpleType %Y requires a member type", name);
            }
        } else if (st.hasKey("list")) {
            hash<auto> l = st.list ?? {};
            NamespacePrefixHelper list_scope(nsc, l."^attributes^");
            WSDL::XsdBase::removeNS(\l);
            *string itemType = l."^attributes^".itemType;
            if (exists itemType && l.hasKey("simpleType")) {
                throw "XSD-SIMPLETYPE-ERROR", "list cannot combine itemType and an inline simpleType";
            }
            if (itemType) {
                nsc.doType(itemType, \listItemTypeInfo, \listItemType);
            } else if (l.simpleType) {
                # Inline simpleType definition for list items
                listItemType = new XsdSimpleType(l.simpleType, nsc, unresolved, n_usedocns);
            } else {
                throw "XSD-SIMPLETYPE-ERROR", sprintf("list definition in simpleType %y requires itemType attribute "
                    "or inline simpleType", name);
            }
        } else {
            throw "XSD-SIMPLETYPE-ERROR", sprintf("missing restriction, union, or list element in simpleType %y",
                name);
        }

        # Even builtin-only and inline declarations need kind checks and dependency finalization.
        unresolved.add(self);
    }

    finalizeResolved() {
        on_exit remove pendingQNameEnumeration;
        if (!type && unionTypes) {
            dataType = new UnionDataType(unionTypes);
        }
        *string numeric = getNumericBaseName();
        if (numeric) {
            validateNumericDeclaration(numeric);
        } else if (exists totalDigits || exists fractionDigits) {
            throw "XSD-SIMPLETYPE-ERROR", "totalDigits and fractionDigits apply only to decimal-derived types";
        }
        if (getCalendarBaseName()) {
            validateCalendarDeclaration();
        }
        if (getDurationBaseName()) {
            validateDurationDeclaration();
        }
        if (getBinaryBaseName()) {
            validateBinaryDeclaration();
        }
        string kind = getFacetKind();
        if (kind == "QName" && type) {
            validateQNameDeclaration();
        }
        if (kind == "union" && (exists minInclusive || exists minExclusive
                || exists maxInclusive || exists maxExclusive)) {
            throw "XSD-SIMPLETYPE-ERROR", "union restrictions permit only pattern and enumeration facets";
        }
        if (kind == "union" && type && enumValues) {
            foreach string lexical in (keys enumValues) {
                try {
                    cast<XsdSimpleType>(type).deserializeUnion("enumeration", new hash<string, XsdAbstractType>(),
                        NOTHING, lexical);
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err != SOAP_DESERIALIZATION_ERROR) {
                        rethrow;
                    }
                    throw "XSD-SIMPLETYPE-ERROR", sprintf("enumeration value %Y is not valid for union base of %Y: %s",
                        lexical, name, ex.desc);
                }
            }
        }
        if (kind == "boolean" && (enumValues || exists minInclusive || exists minExclusive
                || exists maxInclusive || exists maxExclusive)) {
            throw "XSD-SIMPLETYPE-ERROR", "boolean permits only pattern and whiteSpace facets";
        }
        validateLengthDeclaration(kind);
        validateWhitespaceDeclaration(kind);
        listItemValueInfo = listItemType ? XsdListValueHelper::describe(listItemType)
            : type instanceof XsdSimpleType ? cast<XsdSimpleType>(type).listItemValueInfo : NOTHING;
        if (listItemValueInfo && type && enumValues) {
            list<list<auto>> values();
            hash<string, bool> value_keys();
            foreach string lexical in (keys enumValues) {
                try {
                    *XsdSchemaUnionItemCapture caller = SchemaUnionListCapture;
                    on_exit SchemaUnionListCapture = caller;
                    if (listItemValueInfo.union_item) {
                        SchemaUnionListCapture = new XsdSchemaUnionItemCapture(XsdUnionValueHelper::listType(type));
                    }
                    list<auto> value = type.deserializeValue(name, new hash<string, XsdAbstractType>(), NOTHING, lexical);
                    string key = listItemValueInfo.union_item && SchemaUnionListCapture.identity
                        ? XsdUnionValueHelper::key(SchemaUnionListCapture.identity)
                        : XsdListValueHelper::key(listItemValueInfo, value, "XSD-SIMPLETYPE-ERROR");
                    if (!value_keys{key}) {
                        push values, value;
                        value_keys{key} = True;
                    }
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err != SOAP_DESERIALIZATION_ERROR) {
                        rethrow;
                    }
                    throw "XSD-SIMPLETYPE-ERROR", sprintf("list enumeration value %Y is not valid for the base of %Y: %s",
                        lexical, name, ex.desc);
                }
            }
            listEnumValues = values;
            listEnumKeys = value_keys;
        }
        if (type && (StringKinds{kind} || (kind == "list" && !hasNativeListValue())) && enumValues) {
            hash<string, bool> values();
            foreach string lexical in (keys enumValues) {
                try {
                    string value = type.deserializeValue(name, new hash<string, XsdAbstractType>(), NOTHING, lexical);
                    values{value} = True;
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err != SOAP_DESERIALIZATION_ERROR) {
                        rethrow;
                    }
                    throw "XSD-SIMPLETYPE-ERROR", sprintf("enumeration value %Y is not valid for the base of %Y: %s",
                        lexical, name, ex.desc);
                }
            }
            stringEnumValues = values;
        }
    }

    private validateQNameDeclaration() {
        if (!exists pendingQNameEnumeration) {
            return;
        }
        hash<string, hash<string, bool>> values();
        foreach hash<XsdQNameDeclarationLiteral> literal in (pendingQNameEnumeration) {
            string lexical = XsdNameLexicalHelper::lexical("QName", literal.lexical, "XSD-SIMPLETYPE-ERROR");
            if (!exists literal.namespace_uri) {
                throw "XSD-SIMPLETYPE-ERROR", sprintf("unbound prefix in QName enumeration %Y for %Y", lexical, name);
            }
            int colon = lexical.find(":");
            string prefix = colon < 0 ? "" : lexical.substr(0, colon);
            XsdQNameValue value = XsdQNameValueHelper::resolve(lexical, "XSD-SIMPLETYPE-ERROR",
                {prefix: literal.namespace_uri});
            *XsdSimpleType ancestor = type instanceof XsdSimpleType ? cast<XsdSimpleType>(type) : NOTHING;
            while (ancestor) {
                if ((ancestor.patterns && !ancestor.matchesAnyPattern(lexical))
                        || (exists ancestor.qnameEnumValues
                            && !ancestor.qnameEnumValues{value.getNamespaceUri()}{value.getLocalName()})) {
                    throw "XSD-SIMPLETYPE-ERROR", sprintf("QName enumeration %Y for %Y is outside base type %Y",
                        lexical, name, ancestor.name);
                }
                ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
            }
            values{value.getNamespaceUri()}{value.getLocalName()} = True;
        }
        qnameEnumValues = values;
    }

    #! identifies list values through restriction and union derivation
    /** @return True when a native list can represent one member value
        @throw XSD-SIMPLETYPE-ERROR cyclic schema metadata
        @since %WSDL 0.5.8 caches shared member queries for each call
    */
    bool hasNativeListValue() {
        bool owner = !UnionMetadataContext;
        if (owner) {
            UnionMetadataContext = new XsdUnionMetadataContext();
        }
        on_exit if (owner) {
            remove UnionMetadataContext;
        }
        string identity = self.uniqueHash();
        if (UnionMetadataContext.native_lists.hasKey(identity)) {
            return UnionMetadataContext.native_lists{identity};
        }
        string key = "schema-list:" + identity;
        if (UnionMetadataContext.active{key}) {
            throw "XSD-SIMPLETYPE-ERROR", "cyclic union schema metadata";
        }
        UnionMetadataContext.active{key} = True;
        on_exit remove UnionMetadataContext.active{key};
        bool result = exists listItemType;
        if (!result && type) {
            result = type.hasNativeListValue();
        }
        if (!result) {
            foreach XsdAbstractType member in (unionTypes) {
                string member_key = member.uniqueHash();
                if (!UnionMetadataContext.native_lists.hasKey(member_key)) {
                    UnionMetadataContext.native_lists{member_key} = member.hasNativeListValue();
                }
                if (UnionMetadataContext.native_lists{member_key}) {
                    result = True;
                    break;
                }
            }
        }
        UnionMetadataContext.native_lists{identity} = result;
        return result;
    }

    private string getFacetKind() {
        if (listItemType) {
            return "list";
        }
        if (unionTypes) {
            return "union";
        }
        if (type instanceof XsdSimpleType) {
            return cast<XsdSimpleType>(type).getFacetKind();
        }
        @assert(type instanceof XsdBaseType);
        return type.name == "NMTOKENS" || type.name == "IDREFS" || type.name == "ENTITIES" ? "list" : type.name;
    }

    private validateLengthDeclaration(string kind) {
        bool sized = StringKinds{kind} || kind == "list" || kind == "hexBinary" || kind == "base64Binary"
            || kind == "QName" || kind == "NOTATION";
        if (!sized && (exists length || exists minLength || exists maxLength)) {
            throw "XSD-SIMPLETYPE-ERROR", sprintf("length facets do not apply to %Y", kind);
        }
        if (sized && (exists minInclusive || exists minExclusive || exists maxInclusive || exists maxExclusive)) {
            throw "XSD-SIMPLETYPE-ERROR", sprintf("ordered bounds do not apply to %Y", kind);
        }
        *XsdFacetCount exact = getEffectiveFacet("length");
        *XsdFacetCount minimum = getEffectiveFacet("minLength");
        *XsdFacetCount maximum = getEffectiveFacet("maxLength");
        bool builtin_list = kind == "list" && !hasNativeListValue();
        if (builtin_list && exists minLength && XsdFacetCountHelper::compare(minLength, 1) < 0) {
            throw "XSD-SIMPLETYPE-ERROR", "builtin token lists have an inherited minimum length of one";
        }
        if (exists minimum && exists maximum && XsdFacetCountHelper::compare(minimum, maximum) > 0) {
            throw "XSD-SIMPLETYPE-ERROR", "minLength must not exceed maxLength";
        }
        *XsdSimpleType ancestor = type instanceof XsdSimpleType ? cast<XsdSimpleType>(type) : NOTHING;
        while (ancestor) {
            foreach string facet in ("length", "minLength", "maxLength") {
                if (!exists self{facet} || !exists ancestor{facet}) {
                    continue;
                }
                int comparison = XsdFacetCountHelper::compare(self{facet}, ancestor{facet});
                if ((comparison && (facet == "length" || ancestor.fixedFacets{facet}))
                        || (facet == "minLength" && comparison < 0) || (facet == "maxLength" && comparison > 0)) {
                    throw "XSD-SIMPLETYPE-ERROR", sprintf("%s in %Y is not a valid base restriction", facet, name);
                }
            }
            ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
        }
        if (exists exact) {
            foreach string facet in ("minLength", "maxLength") {
                *XsdFacetCount bound = facet == "minLength" ? minimum : maximum;
                if (!exists bound) {
                    continue;
                }
                int comparison = XsdFacetCountHelper::compare(bound, exact);
                if ((facet == "minLength" && comparison > 0) || (facet == "maxLength" && comparison < 0)) {
                    throw "XSD-SIMPLETYPE-ERROR", sprintf("%s contradicts length in %Y", facet, name);
                }
                bool inherited = builtin_list && facet == "minLength" && !XsdFacetCountHelper::compare(bound, 1);
                ancestor = type instanceof XsdSimpleType ? cast<XsdSimpleType>(type) : NOTHING;
                while (ancestor) {
                    if (!exists ancestor.getEffectiveFacet("length") && exists ancestor{facet}
                            && !XsdFacetCountHelper::compare(bound, ancestor{facet})) {
                        inherited = True;
                        break;
                    }
                    ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
                }
                if (!inherited) {
                    throw "XSD-SIMPLETYPE-ERROR", sprintf("%s accompanying length must repeat an inherited value", facet);
                }
            }
        }
    }

    private validateWhitespaceDeclaration(string kind) {
        if (!exists whiteSpace) {
            return;
        }
        if (kind == "union") {
            throw "XSD-SIMPLETYPE-ERROR", "whiteSpace does not apply to union restrictions";
        }
        if ((!StringKinds{kind} || kind == "anyURI") && whiteSpace != "collapse") {
            throw "XSD-SIMPLETYPE-ERROR", sprintf("whiteSpace is fixed to collapse for %Y", kind);
        }
        const hash<string, int> rank = {"preserve": 0, "replace": 1, "collapse": 2};
        if (type && rank{whiteSpace} < rank{type.getWhiteSpace()}) {
            throw "XSD-SIMPLETYPE-ERROR", "whiteSpace must not weaken its base normalization";
        }
        *XsdSimpleType ancestor = type instanceof XsdSimpleType ? cast<XsdSimpleType>(type) : NOTHING;
        while (ancestor) {
            if (ancestor.fixedFacets.whiteSpace && whiteSpace != ancestor.whiteSpace) {
                throw "XSD-SIMPLETYPE-ERROR", "whiteSpace changes a fixed base facet";
            }
            ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
        }
    }

    private validateNumericDeclaration(string builtin) {
        if (exists length || exists minLength || exists maxLength) {
            throw "XSD-SIMPLETYPE-ERROR", sprintf("length facets do not apply to numeric type %Y", name);
        }
        if (exists whiteSpace && whiteSpace != "collapse") {
            throw "XSD-SIMPLETYPE-ERROR", "numeric types have whiteSpace fixed to collapse";
        }
        hash<XsdNumericFacetInfo> facets = getNumericFacets();
        XsdNumericFacetHelper::checkDefinition(facets, "XSD-SIMPLETYPE-ERROR");
        foreach string facet in (keys facets.bounds) {
            validateNumericBaseValue(facets.bounds{facet}, facet.endsWith("Exclusive") ? facet : NOTHING);
        }
        foreach string value in (facets.enumeration) {
            validateNumericBaseValue(value);
        }
        *XsdSimpleType ancestor = type instanceof XsdSimpleType ? cast<XsdSimpleType>(type) : NOTHING;
        hash<string, string> effective_bounds = facets.bounds;
        while (ancestor) {
            hash<XsdNumericFacetInfo> inherited = ancestor.getNumericFacets();
            foreach string bound in (keys inherited.bounds) {
                if (!exists effective_bounds{bound}) {
                    effective_bounds{bound} = inherited.bounds{bound};
                }
            }
            foreach string facet in ("totalDigits", "fractionDigits") {
                if (exists self{facet} && exists ancestor{facet}
                        && XsdFacetCountHelper::compare(self{facet}, ancestor{facet}) > 0) {
                    throw "XSD-SIMPLETYPE-ERROR", sprintf("%s in %Y widens its base restriction", facet, name);
                }
            }
            foreach string facet in (keys ancestor.fixedFacets) {
                if (!ancestor.fixedFacets{facet} || !exists self{facet}) {
                    continue;
                }
                bool changed = facet == "whiteSpace" ? self{facet} != ancestor{facet}
                    : facet == "totalDigits" || facet == "fractionDigits"
                        ? XsdFacetCountHelper::compare(self{facet}, ancestor{facet}) != 0
                    : !XsdNumericFacetHelper::equal(builtin, string(self{facet}), string(ancestor{facet}),
                        "XSD-SIMPLETYPE-ERROR");
                if (changed) {
                    throw "XSD-SIMPLETYPE-ERROR", sprintf("%s in %Y changes a fixed base facet", facet, name);
                }
            }
            ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
        }
        XsdNumericFacetHelper::checkBounds(builtin, XsdNumericFacetHelper::withBuiltinBounds(builtin, effective_bounds),
            "XSD-SIMPLETYPE-ERROR");
        *XsdFacetCount fractional = builtin == "decimal" ? getEffectiveFacet("fractionDigits") : 0;
        *XsdFacetCount total = getEffectiveFacet("totalDigits");
        if (exists fractional && exists total && XsdFacetCountHelper::compare(fractional, total) > 0) {
            throw "XSD-SIMPLETYPE-ERROR", "effective fractionDigits must not exceed totalDigits";
        }
    }

    private validateNumericBaseValue(string value, *string exclusive) {
        *XsdSimpleType ancestor = type instanceof XsdSimpleType ? cast<XsdSimpleType>(type) : NOTHING;
        bool repeated_endpoint = False;
        if (exclusive) {
            *XsdSimpleType base = ancestor;
            while (base) {
                if (exists base{exclusive}) {
                    repeated_endpoint = XsdNumericFacetHelper::equal(getNumericBaseName(), value,
                        string(base{exclusive}), "XSD-SIMPLETYPE-ERROR");
                    break;
                }
                base = base.type instanceof XsdSimpleType ? cast<XsdSimpleType>(base.type) : NOTHING;
            }
        }
        while (ancestor) {
            hash<XsdNumericFacetInfo> facets = ancestor.getNumericFacets();
            # A repeated exclusive endpoint may be outside the base value space (XSD 1.0 4.3.8-9).
            # Its lexical mapping, including inherited patterns, must still yield that endpoint.
            if (repeated_endpoint) {
                facets.bounds = {};
                remove facets.enumeration;
                remove facets.total_digits;
                remove facets.fraction_digits;
            }
            string checked = XsdNumericFacetHelper::validate(facets, value, "XSD-SIMPLETYPE-ERROR");
            ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
        }
    }

    AbstractDataProviderType getDataProviderType() {
        if (listItemType) {
            *hash<XsdListItemInfo> item = XsdListValueHelper::describe(listItemType);
            if (item && !item.union_item) {
                return new XsdListDataType(item);
            }
            return new ListDataType(listItemType.getDataProviderType());
        }
        if (listItemValueInfo) {
            return new XsdListRestrictionDataType(<XsdListFacetInfo>{"name": name,
                "length": length, "min_length": minLength, "max_length": maxLength,
                "patterns": pcre_patterns, "enumeration": listEnumValues}, listItemValueInfo,
                type.getDataProviderType());
        }
        if (getNumericBaseName()) {
            return new XsdNumericRestrictionDataType(getNumericFacets(), type.getDataProviderType());
        }
        if (getCalendarBaseName()) {
            return new XsdCalendarRestrictionDataType(getCalendarFacets(), type.getDataProviderType());
        }
        if (getDurationBaseName()) {
            return new XsdDurationRestrictionDataType(getDurationFacets(), type.getDataProviderType());
        }
        if (getBinaryBaseName()) {
            return new XsdBinaryRestrictionDataType(getBinaryFacets(), type.getDataProviderType());
        }
        string kind = getFacetKind();
        if (kind == "union" && type) {
            return new UnionDataType(self);
        }
        if (kind == "QName") {
            # QName length facets do not constrain values. Patterns constrain normalized lexical text;
            # namespace-based enumeration identity is separate from the string-valued provider facets.
            return new XsdSizedRestrictionDataType(<XsdSizedFacetInfo>{"name": name, "kind": "string",
                "white_space": "collapse", "name_type": "QName", "patterns": pcre_patterns},
                type.getDataProviderType());
        }
        if (kind == "boolean") {
            return new XsdBooleanRestrictionDataType(<XsdBooleanFacetInfo>{"name": name,
                "patterns": pcre_patterns}, type.getDataProviderType());
        }
        bool builtin_list = kind == "list" && !hasNativeListValue();
        if (StringKinds{kind} || builtin_list || ((kind == "list" || kind == "hexBinary" || kind == "base64Binary")
                && (exists length || exists minLength || exists maxLength))) {
            return new XsdSizedRestrictionDataType(<XsdSizedFacetInfo>{
                "name": name, "kind": StringKinds{kind} ? "string"
                    : kind == "list" ? (hasNativeListValue() ? "list" : "tokens") : "binary",
                "white_space": getWhiteSpace(), "length": length, "min_length": minLength,
                "max_length": maxLength, "patterns": (StringKinds{kind} || builtin_list) ? pcre_patterns : NOTHING,
                "enumeration": exists stringEnumValues ? keys stringEnumValues : NOTHING,
            }, type.getDataProviderType());
        }
        return dataType ?? type.getDataProviderType();
    }

    private *string getCalendarBaseName() {
        string kind = getFacetKind();
        return XsdCalendarLexicalHelper::isType(kind) ? kind : NOTHING;
    }

    private hash<XsdCalendarFacetInfo> getCalendarFacets() {
        *string builtin = getCalendarBaseName();
        @assert(builtin);
        hash<XsdCalendarFacetInfo> result = <XsdCalendarFacetInfo>{
            "name": name, "base_name": builtin, "patterns": pcre_patterns,
        };
        foreach string facet in ("minInclusive", "minExclusive", "maxInclusive", "maxExclusive") {
            if (exists self{facet}) {
                result.bounds{facet} = XsdCalendarLexicalHelper::lexical(builtin, self{facet}, "XSD-SIMPLETYPE-ERROR");
            }
        }
        if (enumValues) {
            result.enumeration = keys enumValues;
        }
        return result;
    }

    private validateCalendarDeclaration() {
        hash<XsdCalendarFacetInfo> facets = getCalendarFacets();
        XsdCalendarFacetHelper::checkDefinition(facets, "XSD-SIMPLETYPE-ERROR");
        foreach string facet in (keys facets.bounds) {
            validateCalendarBaseValue(facets.bounds{facet}, facet.endsWith("Exclusive") ? facet : NOTHING);
        }
        foreach string value in (facets.enumeration) {
            validateCalendarBaseValue(value);
        }
        *XsdSimpleType ancestor = type instanceof XsdSimpleType ? cast<XsdSimpleType>(type) : NOTHING;
        hash<string, string> effective = facets.bounds;
        while (ancestor) {
            hash<XsdCalendarFacetInfo> inherited = ancestor.getCalendarFacets();
            foreach string bound in (keys inherited.bounds) {
                if (!exists effective{bound}) {
                    effective{bound} = inherited.bounds{bound};
                }
                if (ancestor.fixedFacets{bound} && exists facets.bounds{bound}
                        && XsdCalendarLexicalHelper::key(facets.base_name, facets.bounds{bound}, "XSD-SIMPLETYPE-ERROR")
                            != XsdCalendarLexicalHelper::key(facets.base_name, inherited.bounds{bound}, "XSD-SIMPLETYPE-ERROR")) {
                    throw "XSD-SIMPLETYPE-ERROR", sprintf("%s in %Y changes a fixed calendar bound", bound, name);
                }
            }
            ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
        }
        XsdCalendarFacetHelper::checkBounds(facets.base_name, effective, "XSD-SIMPLETYPE-ERROR");
    }

    private validateCalendarBaseValue(string value, *string exclusive) {
        *XsdSimpleType ancestor = type instanceof XsdSimpleType ? cast<XsdSimpleType>(type) : NOTHING;
        bool repeated = False;
        if (exclusive) {
            *XsdSimpleType candidate = ancestor;
            while (candidate) {
                if (exists candidate{exclusive}) {
                    repeated = XsdCalendarLexicalHelper::key(getCalendarBaseName(), value, "XSD-SIMPLETYPE-ERROR")
                        == XsdCalendarLexicalHelper::key(getCalendarBaseName(), candidate{exclusive}, "XSD-SIMPLETYPE-ERROR");
                    break;
                }
                candidate = candidate.type instanceof XsdSimpleType ? cast<XsdSimpleType>(candidate.type) : NOTHING;
            }
        }
        while (ancestor) {
            hash<XsdCalendarFacetInfo> facets = ancestor.getCalendarFacets();
            if (repeated) {
                # XSD 1.0 permits repetition of an inherited exclusive endpoint,
                # including an endpoint excluded from the base value space.
                facets.bounds = {};
                remove facets.enumeration;
            }
            string checked = XsdCalendarFacetHelper::validate(facets, value, "XSD-SIMPLETYPE-ERROR");
            ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
        }
    }

    private *string getBinaryBaseName() {
        string kind = getFacetKind();
        return XsdBinaryLexicalHelper::isType(kind) ? kind : NOTHING;
    }

    private hash<XsdBinaryFacetInfo> getBinaryFacets() {
        return <XsdBinaryFacetInfo>{"name": name, "base_name": getBinaryBaseName(),
            "patterns": pcre_patterns, "enumeration": enumValues ? keys enumValues : NOTHING,
            "length": length, "min_length": minLength, "max_length": maxLength};
    }

    private validateBinaryDeclaration() {
        hash<XsdBinaryFacetInfo> facets = getBinaryFacets();
        XsdBinaryFacetHelper::checkDefinition(facets, "XSD-SIMPLETYPE-ERROR");
        foreach string lexical in (facets.enumeration) {
            try {
                auto checked = type.deserializeValue(name, new hash<string, XsdAbstractType>(), NOTHING, lexical);
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != SOAP_DESERIALIZATION_ERROR) {
                    rethrow;
                }
                throw "XSD-SIMPLETYPE-ERROR", sprintf("invalid base value in binary enumeration: %s", ex.desc);
            }
        }
    }

    private *string getDurationBaseName() {
        return getFacetKind() == "duration" ? "duration" : NOTHING;
    }

    private hash<XsdDurationFacetInfo> getDurationFacets() {
        *string builtin = getDurationBaseName();
        @assert(builtin);
        hash<XsdDurationFacetInfo> result = <XsdDurationFacetInfo>{
            "name": name, "base_name": builtin, "patterns": pcre_patterns,
        };
        foreach string facet in ("minInclusive", "minExclusive", "maxInclusive", "maxExclusive") {
            if (exists self{facet}) {
                result.bounds{facet} = XsdDurationLexicalHelper::lexical(self{facet}, "XSD-SIMPLETYPE-ERROR");
            }
        }
        if (enumValues) {
            result.enumeration = keys enumValues;
        }
        return result;
    }

    private validateDurationDeclaration() {
        hash<XsdDurationFacetInfo> facets = getDurationFacets();
        XsdDurationFacetHelper::checkDefinition(facets, "XSD-SIMPLETYPE-ERROR");
        foreach string facet in (keys facets.bounds) {
            validateDurationBaseValue(facets.bounds{facet}, facet.endsWith("Exclusive") ? facet : NOTHING);
        }
        foreach string value in (facets.enumeration) {
            validateDurationBaseValue(value);
        }
        *XsdSimpleType ancestor = type instanceof XsdSimpleType ? cast<XsdSimpleType>(type) : NOTHING;
        hash<string, string> effective = facets.bounds;
        while (ancestor) {
            hash<XsdDurationFacetInfo> inherited = ancestor.getDurationFacets();
            foreach string bound in (keys inherited.bounds) {
                if (!exists effective{bound}) {
                    effective{bound} = inherited.bounds{bound};
                }
                if (ancestor.fixedFacets{bound} && exists facets.bounds{bound}
                        && XsdDurationValueHelper::key(facets.bounds{bound}, "XSD-SIMPLETYPE-ERROR")
                            != XsdDurationValueHelper::key(inherited.bounds{bound}, "XSD-SIMPLETYPE-ERROR")) {
                    throw "XSD-SIMPLETYPE-ERROR", sprintf("%s in %Y changes a fixed duration bound", bound, name);
                }
            }
            ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
        }
        XsdDurationFacetHelper::checkBounds(facets.base_name, effective, "XSD-SIMPLETYPE-ERROR");
    }

    private validateDurationBaseValue(string value, *string exclusive) {
        *XsdSimpleType ancestor = type instanceof XsdSimpleType ? cast<XsdSimpleType>(type) : NOTHING;
        bool repeated = False;
        if (exclusive) {
            *XsdSimpleType candidate = ancestor;
            while (candidate) {
                if (exists candidate{exclusive}) {
                    repeated = XsdDurationValueHelper::key(value, "XSD-SIMPLETYPE-ERROR")
                        == XsdDurationValueHelper::key(candidate{exclusive}, "XSD-SIMPLETYPE-ERROR");
                    break;
                }
                candidate = candidate.type instanceof XsdSimpleType ? cast<XsdSimpleType>(candidate.type) : NOTHING;
            }
        }
        while (ancestor) {
            hash<XsdDurationFacetInfo> facets = ancestor.getDurationFacets();
            if (repeated) {
                # XSD 1.0 permits repetition of an inherited exclusive endpoint,
                # including an endpoint excluded from the base value space.
                facets.bounds = {};
                remove facets.enumeration;
            }
            string checked = XsdDurationFacetHelper::validate(facets, value, "XSD-SIMPLETYPE-ERROR");
            ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
        }
    }

    private *string getNumericBaseName() {
        *XsdAbstractType base = type;
        while (base instanceof XsdSimpleType) {
            base = cast<XsdSimpleType>(base).type;
        }
        if (base instanceof XsdBaseType && XsdNumericFacetHelper::isType(base.name)) {
            return base.name;
        }
    }

    private hash<XsdNumericFacetInfo> getNumericFacets() {
        *string base = getNumericBaseName();
        @assert(base);
        hash<XsdNumericFacetInfo> result = <XsdNumericFacetInfo>{
            "name": name, "base_name": base, "patterns": pcre_patterns,
            "bounds": {}, "total_digits": totalDigits, "fraction_digits": fractionDigits,
        };
        foreach string facet in ("minInclusive", "minExclusive", "maxInclusive", "maxExclusive") {
            auto value = self{facet};
            if (exists value) {
                result.bounds{facet} = XsdNumericFacetHelper::lexical(base, value, "XSD-SIMPLETYPE-ERROR");
            }
        }
        if (enumValues) {
            result.enumeration = map XsdNumericFacetHelper::lexical(base, $1, "XSD-SIMPLETYPE-ERROR"), keys enumValues;
        }
        return result;
    }

    private bool enumerationAccepts(auto value, *hash<XsdUnionValueIdentity> identity) {
        if (exists listEnumKeys) {
            if (listItemValueInfo.union_item && identity) {
                return boolean(listEnumKeys{XsdUnionValueHelper::key(identity)});
            }
            return boolean(listEnumKeys{XsdListValueHelper::key(listItemValueInfo, value,
                "XSD-SIMPLETYPE-ERROR")});
        }
        if (exists stringEnumValues) {
            return boolean(stringEnumValues{value});
        }
        # Numeric enumeration is checked together with the other value facets.
        return getNumericBaseName() || getCalendarBaseName() || getDurationBaseName() || !enumValues || boolean(enumValues{value});
    }

    *list<auto> getAllowedValues() {
        if (getBinaryBaseName()) {
            *XsdSimpleType ancestor = self;
            while (ancestor) {
                if (ancestor.enumValues) {
                    list<auto> result();
                    hash<string, bool> seen();
                    foreach string lexical in (keys ancestor.enumValues) {
                        string key = XsdBinaryFacetHelper::key(getBinaryBaseName(), lexical, "XSD-SIMPLETYPE-ERROR");
                        auto choice = getBinaryChoice(lexical);
                        if (exists choice && !seen{key}) {
                            push result, choice;
                            seen{key} = True;
                        }
                    }
                    return result;
                }
                ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
            }
            return;
        }
        if (getCalendarBaseName() || getDurationBaseName()) {
            *XsdSimpleType ancestor = self;
            while (ancestor) {
                if (ancestor.enumValues) {
                    list<auto> choices();
                    foreach string lexical in (keys ancestor.enumValues) {
                        if (acceptsSample(lexical)) {
                            push choices, getEnumValue(lexical);
                        }
                    }
                    return choices;
                }
                ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
            }
            return;
        }
        if (listItemValueInfo) {
            *XsdSimpleType ancestor = self;
            while (ancestor) {
                if (exists ancestor.listEnumValues) {
                    return ancestor.listEnumValues;
                }
                ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
            }
            return;
        }
        if (StringKinds{getFacetKind()} || (getFacetKind() == "list" && !hasNativeListValue())) {
            *XsdSimpleType ancestor = self;
            while (ancestor) {
                if (exists ancestor.stringEnumValues) {
                    return select keys ancestor.stringEnumValues, acceptsSample($1);
                }
                ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
            }
            return;
        }
        if (!enumValues) {
            return;
        }
        # enumeration values are stored as hash keys and are therefore always strings; convert them to the value
        # type of the restricted type, otherwise numeric, boolean, and date enumerations are reported as strings
        return map getEnumValue($1), keys enumValues;
    }

    #! returns the enumeration value converted to the value type of the restricted type
    private auto getEnumValue(string val) {
        if (!type) {
            return val;
        }
        try {
            return type.deserializeValue(name, new hash<string, XsdAbstractType>(), NOTHING, val);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != SOAP_DESERIALIZATION_ERROR || getFacetKind() == "union") {
                rethrow;
            }
            # if the enumeration value cannot be converted, then report it as declared in the schema
            return val;
        }
    }

    auto serializeValue(Namespaces nsc, auto val, *softbool omitType) {
        *hash<auto> rh;
        if (val.typeCode() == NT_HASH) {
            foreach string k in (keys val) {
                if (k =~ /^\^comment/) {
                    rh{k} = remove val{k};
                }
            }
            if (val.size() == 1 && val.firstKey() == "^value^") {
                val = val."^value^";
            }
        }

        # Handle list type serialization
        if (listItemType) {
            return serializeList(nsc, val, omitType, rh);
        }

        if (listItemValueInfo) {
            *XsdSchemaUnionItemCapture caller = SchemaUnionListCapture;
            *XsdSimpleType target = listItemValueInfo.union_item ? XsdUnionValueHelper::listType(type) : NOTHING;
            bool capture_owner = target && (!caller || caller.target !== target);
            on_exit if (capture_owner) {
                SchemaUnionListCapture = caller;
            }
            if (capture_owner) {
                SchemaUnionListCapture = new XsdSchemaUnionItemCapture(target);
            }
            string lexical = string(type.serializeValue(nsc, val, omitType));
            list<string> items = XsdListValueHelper::tokens(lexical);
            validateFacets(items, "serialize", lexical);
            if (!enumerationAccepts(items, listItemValueInfo.union_item ? SchemaUnionListCapture.identity : NOTHING)) {
                throw SOAP_SERIALIZATION_ERROR, sprintf("list value for %Y is outside its enumeration", name);
            }
            if (rh) {
                rh."^value^" = lexical;
                return rh;
            }
            return lexical;
        }

        if (getFacetKind() == "boolean") {
            string lexical = XsdBooleanLexicalHelper::lexical(
                XsdScalarTextHelper::value(val, SOAP_SERIALIZATION_ERROR), SOAP_SERIALIZATION_ERROR);
            validateFacets(lexical, "serialize", lexical);
            auto serialized = type.serializeValue(nsc, val, omitType);
            if (patterns) {
                if (serialized.typeCode() == NT_HASH) {
                    serialized."^value^" = lexical;
                } else {
                    serialized = lexical;
                }
            }
            if (rh) {
                if (serialized.typeCode() == NT_HASH) {
                    return rh + serialized;
                }
                rh."^value^" = serialized;
                return rh;
            }
            return serialized;
        }

        if (getFacetKind() == "union") {
            hash<XsdSchemaUnionTrialResult> result = serializeUnion(nsc, val, omitType);
            auto converted = result.owner && !SchemaUnionValueProbe ? preserveUnionLexical(nsc, val, result) : result.value;
            if (SchemaUnionItemCapture && SchemaUnionItemCapture.target === self) {
                SchemaUnionItemCapture.identity = result.identity;
            }
            return XsdScalarTextHelper::withComments(rh, converted);
        }

        if (getCalendarBaseName()) {
            string lexical = XsdCalendarFacetHelper::validate(getCalendarFacets(), val, SOAP_SERIALIZATION_ERROR);
            return XsdScalarTextHelper::withComments(rh, type.serializeValue(nsc, lexical, omitType));
        }
        if (getDurationBaseName()) {
            string lexical = XsdDurationFacetHelper::validate(getDurationFacets(), val, SOAP_SERIALIZATION_ERROR);
            return XsdScalarTextHelper::withComments(rh, type.serializeValue(nsc, lexical, omitType));
        }
        if (getBinaryBaseName()) {
            string lexical = XsdBinaryLexicalHelper::encode(getBinaryBaseName(), val, SOAP_SERIALIZATION_ERROR);
            lexical = XsdBinaryFacetHelper::validate(getBinaryFacets(), lexical, SOAP_SERIALIZATION_ERROR);
            return XsdScalarTextHelper::withComments(rh, type.serializeValue(nsc,
                new XsdBinaryValue(getBinaryBaseName(), lexical), omitType));
        }

        if (!exists val && getFacetKind() == "list" && hasNativeListValue()) {
            val = ();
        }

        # issue #5411: "whiteSpace" processing is applied to the lexical value before it is validated
        if (!XsdBinaryLexicalHelper::isType(getFacetKind())) {
            val = applyWhiteSpace(val);
        }
        # Validate facets before serialization
        validateFacets(val, "serialize");

        if (!enumerationAccepts(val)) {
            throw "SOAP-SERIALIZATION-ERROR", sprintf("value %y passed to simpleType %y is not in the enumeration "
                "list<auto> (%y)", val, name, enumValues.keys());
        }

        return XsdScalarTextHelper::withComments(rh, type.serializeValue(nsc, val, omitType));
    }

    # A cached ordinary rejection is local to one value and its complete conversion
    # context. Unexpected failures and cancellation always unwind to the caller.
    private hash<XsdSchemaUnionTrialResult> serializeUnion(Namespaces nsc, auto val, *softbool omitType) {
        *XsdSchemaUnionTrialContext caller = SchemaUnionSerializeContext;
        bool owner = !caller || caller.namespaces !== nsc || caller.omit_type !== omitType
            || !XsdUnionInputHelper::sameInput(caller.input, val);
        on_exit if (owner) {
            SchemaUnionSerializeContext = caller;
        }
        if (owner) {
            SchemaUnionSerializeContext = new XsdSchemaUnionTrialContext(val);
            SchemaUnionSerializeContext.namespaces = nsc;
            SchemaUnionSerializeContext.omit_type = omitType;
        }
        XsdSchemaUnionTrialContext trial = SchemaUnionSerializeContext;
        string identity = self.uniqueHash();
        if (trial.active{identity}) {
            throw "XSD-SIMPLETYPE-ERROR", "cyclic union schema conversion";
        }
        trial.active{identity} = True;
        on_exit remove trial.active{identity};
        list<string> rejected();
        foreach XsdAbstractType member in (unionTypes ? unionTypes : (type,)) {
            string key = member.uniqueHash();
            if (!trial.results.hasKey(key)) {
                try {
                    *hash<XsdUnionListInfo> list_info = XsdUnionValueHelper::describeList(member);
                    auto value = member.serializeValue(nsc, list_info
                        ? XsdUnionValueHelper::listInput(val, SOAP_SERIALIZATION_ERROR, list_info)
                        : XsdUnionValueHelper::serializeInput(member, val), omitType);
                    *hash<XsdUnionValueIdentity> member_identity = trial.identities{key}
                        ?? (list_info ? XsdUnionValueHelper::schemaListIdentity(list_info, member, val, value,
                                SOAP_SERIALIZATION_ERROR, trial.identities)
                            : XsdUnionValueHelper::atomicIdentity(member, val, value, SOAP_SERIALIZATION_ERROR));
                    trial.results{key} = <XsdSchemaUnionTrialResult>{"accepted": True, "value": value,
                        "identity": member_identity,
                        "white_space": trial.selected_white_spaces{key} ?? member.getWhiteSpace()};
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err != SOAP_SERIALIZATION_ERROR) {
                        rethrow;
                    }
                    trial.results{key} = <XsdSchemaUnionTrialResult>{"accepted": False,
                        "rejection": unionRejection(member, ex)};
                }
            }
            hash<XsdSchemaUnionTrialResult> result = trial.results{key};
            if (result.accepted) {
                auto lexical = XsdScalarTextHelper::value(val, SOAP_SERIALIZATION_ERROR);
                if (lexical.typeCode() != NT_STRING
                        || (result.identity && XsdBinaryLexicalHelper::isType(result.identity.family))) {
                    lexical = string(XsdScalarTextHelper::value(result.value, SOAP_SERIALIZATION_ERROR));
                }
                lexical = normalizeWhiteSpace(lexical, result.white_space ?? "preserve");
                validateUnionFacets(lexical, result.identity, "serialize");
                trial.selected_white_spaces{identity} = result.white_space ?? "preserve";
                if (patterns) {
                    result.value = withUnionLexical(result.value, lexical);
                }
                if (result.identity) {
                    trial.identities{identity} = result.identity;
                }
                result.owner = owner;
                return result;
            }
            rejected += result.rejection;
        }
        throw SOAP_SERIALIZATION_ERROR, sprintf("value %Y cannot be serialized with union types for %Y: %Y", val, name, rejected);
    }

    private auto preserveUnionLexical(Namespaces namespaces, auto input, hash<XsdSchemaUnionTrialResult> result) {
        if (!result.identity || input.typeCode() != NT_STRING
                || (result.value.typeCode() == NT_STRING && result.value === input)) {
            return result.value;
        }
        *bool caller = SchemaUnionValueProbe;
        on_exit SchemaUnionValueProbe = caller;
        SchemaUnionValueProbe = True;
        try {
            hash<XsdSchemaUnionTrialResult> observed = deserializeUnion("value",
                new hash<string, XsdAbstractType>(), NOTHING, XsdUnionValueHelper::xmlValue(result.value, namespaces));
            if (observed.identity && XsdUnionValueHelper::same(result.identity, observed.identity)) {
                return result.value;
            }
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != SOAP_DESERIALIZATION_ERROR) {
                rethrow;
            }
        }
        return withUnionLexical(result.value, input);
    }

    private static auto withUnionLexical(auto value, string lexical) {
        if (value.typeCode() == NT_HASH) {
            value."^value^" = lexical;
            return value;
        }
        return lexical;
    }

    private hash<XsdSchemaUnionTrialResult> deserializeUnion(string en, hash<string, XsdAbstractType> tmap,
            *hash<auto> mrh, auto val) {
        *XsdSchemaUnionTrialContext caller = SchemaUnionDeserializeContext;
        bool owner = !caller || caller.element_name !== en || caller.type_map !== tmap
            || !XsdUnionInputHelper::sameInput(caller.references, mrh)
            || !XsdUnionInputHelper::sameInput(caller.input, val);
        on_exit if (owner) {
            SchemaUnionDeserializeContext = caller;
        }
        if (owner) {
            SchemaUnionDeserializeContext = new XsdSchemaUnionTrialContext(val);
            SchemaUnionDeserializeContext.element_name = en;
            SchemaUnionDeserializeContext.type_map = tmap;
            SchemaUnionDeserializeContext.references = mrh;
        }
        XsdSchemaUnionTrialContext trial = SchemaUnionDeserializeContext;
        string identity = self.uniqueHash();
        if (trial.active{identity}) {
            throw "XSD-SIMPLETYPE-ERROR", "cyclic union schema conversion";
        }
        trial.active{identity} = True;
        on_exit remove trial.active{identity};
        list<string> rejected();
        foreach XsdAbstractType member in (unionTypes ? unionTypes : (type,)) {
            string key = member.uniqueHash();
            if (!trial.results.hasKey(key)) {
                try {
                    auto value = member.deserializeValue(en, tmap, mrh, val);
                    *hash<XsdUnionListInfo> list_info = XsdUnionValueHelper::describeList(member);
                    *hash<XsdUnionValueIdentity> member_identity = trial.identities{key}
                        ?? (list_info ? XsdUnionValueHelper::schemaListIdentity(list_info, member, val, value,
                                SOAP_DESERIALIZATION_ERROR, trial.identities)
                            : XsdUnionValueHelper::atomicIdentity(member, val, value, SOAP_DESERIALIZATION_ERROR));
                    trial.results{key} = <XsdSchemaUnionTrialResult>{"accepted": True, "value": value,
                        "identity": member_identity,
                        "white_space": trial.selected_white_spaces{key} ?? member.getWhiteSpace()};
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err != SOAP_DESERIALIZATION_ERROR) {
                        rethrow;
                    }
                    trial.results{key} = <XsdSchemaUnionTrialResult>{"accepted": False,
                        "rejection": unionRejection(member, ex)};
                }
            }
            hash<XsdSchemaUnionTrialResult> result = trial.results{key};
            if (result.accepted) {
                string lexical = string(XsdScalarTextHelper::value(val, SOAP_DESERIALIZATION_ERROR));
                lexical = normalizeWhiteSpace(lexical, result.white_space ?? "preserve");
                validateUnionFacets(lexical, result.identity, "deserialize");
                trial.selected_white_spaces{identity} = result.white_space ?? "preserve";
                if (patterns) {
                    result.value = result.identity && XsdBinaryLexicalHelper::isType(result.identity.family)
                        ? new XsdBinaryValue(result.identity.family, lexical) : lexical;
                }
                if (result.identity) {
                    trial.identities{identity} = result.identity;
                }
                result.owner = owner;
                return result;
            }
            rejected += result.rejection;
        }
        throw SOAP_DESERIALIZATION_ERROR, sprintf("value %Y cannot be deserialized with union types for %Y in element %Y: %Y",
            val, name, en, rejected);
    }

    private validateUnionFacets(string lexical, *hash<XsdUnionValueIdentity> identity, string operation) {
        validateFacets(lexical, operation, lexical);
        if (!enumValues) {
            return;
        }
        string error = operation == "serialize" ? SOAP_SERIALIZATION_ERROR : SOAP_DESERIALIZATION_ERROR;
        foreach string allowed in (keys enumValues) {
            hash<XsdSchemaUnionTrialResult> candidate = cast<XsdSimpleType>(type).deserializeUnion("enumeration",
                new hash<string, XsdAbstractType>(), NOTHING, allowed);
            if (identity && candidate.identity ? XsdUnionValueHelper::same(identity, candidate.identity)
                    : lexical === allowed) {
                return;
            }
        }
        throw error, sprintf("union value %Y for %Y is outside its enumeration", lexical, name);
    }

    private auto preserveUnionValue(string en, hash<string, XsdAbstractType> tmap, *hash<auto> mrh, auto input,
            hash<XsdSchemaUnionTrialResult> result) {
        if (!result.identity) {
            return result.value;
        }
        auto lexical = XsdScalarTextHelper::value(input, SOAP_DESERIALIZATION_ERROR);
        if (lexical.typeCode() != NT_STRING || (result.value.typeCode() == NT_STRING && result.value === lexical)) {
            return result.value;
        }
        *bool caller = SchemaUnionValueProbe;
        on_exit SchemaUnionValueProbe = caller;
        SchemaUnionValueProbe = True;
        auto encoded;
        try {
            # Finalized schema types release their construction namespace registry.
            # Scalar value probes omit type annotations and use an independent registry.
            Namespaces probe_namespaces({});
            encoded = XsdUnionValueHelper::xmlValue(serializeValue(probe_namespaces, result.value, True));
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != SOAP_SERIALIZATION_ERROR) {
                rethrow;
            }
            return result.identity.family == "list" && result.value.typeCode() == NT_LIST
                ? XsdListValueHelper::tokens(lexical) : lexical;
        }
        if (encoded.typeCode() == NT_STRING && encoded === lexical) {
            return result.value;
        }
        try {
            hash<XsdSchemaUnionTrialResult> observed = deserializeUnion(en, tmap, mrh, encoded);
            if (observed.identity && XsdUnionValueHelper::same(result.identity, observed.identity)) {
                return result.value;
            }
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != SOAP_DESERIALIZATION_ERROR) {
                rethrow;
            }
        }
        return result.identity.family == "list" && result.value.typeCode() == NT_LIST
            ? XsdListValueHelper::tokens(lexical) : lexical;
    }

    private static string unionRejection(XsdAbstractType member, hash<ExceptionInfo> ex) {
        # Repeating nested union explanations duplicates entire shared subgraphs.
        # Keep each immediate member's category; atomic failures retain their cause.
        bool nested = member instanceof XsdSimpleType && cast<XsdSimpleType>(member).getFacetKind() == "union";
        return sprintf("type %Y: %s: %s", member.getName(), ex.err,
            nested ? "nested union validation failed" : ex.desc);
    }

    #! Serialize a list type value as space-separated string
    private auto serializeList(Namespaces nsc, auto val, *softbool omitType, *hash<auto> rh) {
        bool capture = (exists SchemaUnionSerializeContext || exists SchemaUnionListCapture)
            && XsdUnionValueHelper::schemaUnionItem(listItemType);
        *XsdSchemaUnionItemCapture caller_capture = SchemaUnionItemCapture;
        on_exit if (capture) {
            SchemaUnionItemCapture = caller_capture;
        }
        list<*hash<XsdUnionValueIdentity>> identities();
        list<auto> items;
        if (val.typeCode() == NT_LIST) {
            items = val;
        } else if (exists val) {
            # Single value treated as single-item list
            items = (val,);
        } else {
            items = ();
        }

        # Serialize each item and join with spaces
        list<string> serializedItems = ();
        foreach auto item in (items) {
            if (capture) {
                SchemaUnionItemCapture = new XsdSchemaUnionItemCapture(listItemType);
            }
            string lexical;
            if (item.typeCode() == NT_STRING) {
                lexical = normalizeWhiteSpace(item, listItemType.getWhiteSpace());
                try {
                    listItemType.deserializeValue(name, new hash<string, XsdAbstractType>(), NOTHING, lexical);
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err != SOAP_DESERIALIZATION_ERROR) {
                        rethrow;
                    }
                    throw SOAP_SERIALIZATION_ERROR, ex.desc;
                }
            } else {
                auto serialized = listItemType.serializeValue(nsc, item, True);
                lexical = string(serialized.typeCode() == NT_HASH && serialized.hasKey("^value^")
                    ? serialized."^value^" : serialized);
            }
            XsdListValueHelper::checkToken(lexical, SOAP_SERIALIZATION_ERROR);
            serializedItems += lexical;
            if (capture) {
                push identities, SchemaUnionItemCapture.identity;
            }
        }

        string result = serializedItems.join(" ");
        if (capture) {
            *hash<XsdUnionValueIdentity> identity = XsdUnionValueHelper::capturedIdentity(identities);
            if (identity && SchemaUnionSerializeContext) {
                SchemaUnionSerializeContext.identities{self.uniqueHash()} = identity;
            }
            if (SchemaUnionListCapture && SchemaUnionListCapture.target === self) {
                SchemaUnionListCapture.identity = identity;
            }
        }
        if (rh) {
            rh."^value^" = result;
            return rh;
        }
        return result;
    }

    #! returns the \c whiteSpace processing that applies to this type
    /** @return one of \c "preserve", \c "replace", or \c "collapse"

        The facet declared by this restriction is used if there is one; otherwise the value is inherited from the
        base type. Unions preserve the input at this level; the selected member applies its own normalization.

        @since %WSDL 0.5.8
    */
    string getWhiteSpace() {
        if (listItemType) {
            return "collapse";
        }
        if (exists whiteSpace) {
            return whiteSpace;
        }
        return type ? type.getWhiteSpace() : "preserve";
    }

    #! applies \c whiteSpace processing to a lexical value
    /** @param val the value to normalize
        @param ws the \c whiteSpace processing to apply

        @return the normalized value

        XSD 1.0 part 2 4.3.6: \c "replace" replaces every tab, newline, and carriage return with a space;
        \c "collapse" additionally collapses runs of spaces into one and removes leading and trailing spaces.

        @since %WSDL 0.5.8
    */
    static string normalizeWhiteSpace(string val, string ws) {
        switch (ws) {
            case "replace":
                val =~ s/[\t\n\r]/ /g;
                break;

            case "collapse":
                val =~ s/[\t\n\r]/ /g;
                val =~ s/  +/ /g;
                # Qore trim() also removes characters outside XML's four whitespace characters.
                val =~ s/\A | \z//g;
                break;
        }
        return val;
    }

    #! applies \c whiteSpace processing to a value if it is a string
    private auto applyWhiteSpace(auto val) {
        if (val.typeCode() != NT_STRING) {
            return val;
        }
        return XsdSimpleType::normalizeWhiteSpace(val, getWhiteSpace());
    }

    #! returns @ref True if the value matches the given XSD pattern in its entirety
    /** issue #5411: XSD patterns match the entire value, including all top-level alternatives. For example,
        "a|b" accepts only "a" or "b". New expressions use XsdCompiledPattern; older anchored PCRE metadata
        retains the same boundary requirement. See @ref WSDL::XsdRegexHelper.

        @since %WSDL 0.5.8
    */
    private bool matchesAnyPattern(string str) {
        foreach XsdPatternConstraint pcre in (pcre_patterns) {
            if (XsdPatternConstraintHelper::matches(str, pcre)) {
                return True;
            }
        }
        return False;
    }

    #! returns @ref True if the value satisfies the \c pattern facets of this type and all its base types
    /** @since %WSDL 0.5.8
    */
    bool patternsAccept(string val) {
        if (patterns && !matchesAnyPattern(val)) {
            return False;
        }
        return type instanceof XsdSimpleType ? cast<XsdSimpleType>(type).patternsAccept(val) : True;
    }

    #! returns the \c pattern facets of the innermost type in the chain that declares any
    /** @since %WSDL 0.5.8
    */
    static *list<string> getPatterns(*XsdAbstractType t) {
        if (!(t instanceof XsdSimpleType)) {
            return;
        }
        XsdSimpleType st = cast<XsdSimpleType>(t);
        return st.patterns ?? XsdSimpleType::getPatterns(st.type);
    }

    #! returns the effective value of a constraining facet, searching this type and then its base types
    /** @since %WSDL 0.5.8
    */
    private auto getEffectiveFacet(string facet) {
        auto v;
        switch (facet) {
            case "length": v = length; break;
            case "minLength": v = minLength; break;
            case "maxLength": v = maxLength; break;
            case "minInclusive": v = minInclusive; break;
            case "maxInclusive": v = maxInclusive; break;
            case "minExclusive": v = minExclusive; break;
            case "maxExclusive": v = maxExclusive; break;
            case "totalDigits": v = totalDigits; break;
            case "fractionDigits": v = fractionDigits; break;
        }
        if (exists v) {
            return v;
        }
        if (facet == "minLength" && type instanceof XsdBaseType && XsdBuiltinListHelper::isType(type.name)) {
            return 1;
        }
        return type instanceof XsdSimpleType ? cast<XsdSimpleType>(type).getEffectiveFacet(facet) : NOTHING;
    }

    #! returns a sample value satisfying the \c pattern facets of this type, if one can be generated
    /** @param min_length the minimum length the value must have, if any

        @return a value matching the \c pattern facets declared in this type or in one of its base types, or
        \c NOTHING if none could be generated

        @since %WSDL 0.5.8
    */
    *string getPatternSample(*softint min_length) {
        *XsdSimpleType pattern_owner = self;
        while (pattern_owner && !pattern_owner.patterns) {
            pattern_owner = pattern_owner.type instanceof XsdSimpleType
                ? cast<XsdSimpleType>(pattern_owner.type) : NOTHING;
        }
        if (!pattern_owner) {
            return;
        }
        if (exists min_length && min_length > XsdRegexHelper::MaxSampleLength) {
            return;
        }
        *string sample = getPatternSampleIntern(0);
        # the shortest matching value can be too short for the length facets; try longer values if so
        if (exists sample && exists min_length && sample.length() < min_length) {
            for (int reps = 1; reps <= min_length; ++reps) {
                *string longer = getPatternSampleIntern(reps);
                if (exists longer && longer.length() >= min_length) {
                    sample = longer;
                    break;
                }
            }
        }
        # the sample has to satisfy the pattern facets of every step in the derivation chain
        if (exists sample && patternsAccept(sample)) {
            return sample;
        }
        # A candidate from one restriction can fail another. Try the bounded one-character alphabet
        # against the whole derivation chain before reporting that generation is unsupported.
        if (!exists min_length || min_length <= 1) {
            for (int i = 0; i < XsdRegexHelper::SampleChars.length(); ++i) {
                string candidate = XsdRegexHelper::SampleChars[i];
                if (patternsAccept(candidate)) {
                    return candidate;
                }
            }
        }
    }

    #! returns a sample value for the innermost type declaring \c pattern facets
    private *string getPatternSampleIntern(int min_reps) {
        foreach string pattern in (patterns) {
            *string sample = XsdRegexHelper::getSampleValue(pattern, min_reps);
            if (exists sample) {
                return sample;
            }
        }
        if (type instanceof XsdSimpleType) {
            return cast<XsdSimpleType>(type).getPatternSampleIntern(min_reps);
        }
    }

    #! returns a sample value satisfying the constraining facets declared for this type
    /** @param default_value the value to use as a starting point, normally the sample value for the base type

        @return a value satisfying the type's constraining facets, derived from \a default_value where possible
        @throw XSD-SAMPLE-ERROR an example satisfying all restrictions cannot be constructed

        Used to generate example messages that can actually be serialized; the placeholder value for a base type
        does not normally satisfy the facets declared by a restriction of it.

        @since %WSDL 0.5.8
    */
    auto getSampleValue(auto default_value) {
        if (getFacetKind() == "union") {
            return getUnionSample(default_value);
        }
        if (getCalendarBaseName()) {
            return getCalendarSample(default_value);
        }
        if (getDurationBaseName()) {
            return getDurationSample(default_value);
        }
        if (getBinaryBaseName()) {
            return getBinarySample(default_value);
        }
        if (getFacetKind() == "QName") {
            return getQNameSample(default_value);
        }
        if (getFacetKind() == "boolean") {
            foreach auto candidate in (default_value, "true", "false", "1", "0") {
                if (acceptsSample(candidate)) {
                    return deserializeValue(name, new hash<string, XsdAbstractType>(), NOTHING, candidate);
                }
            }
            throw "XSD-SAMPLE-ERROR", sprintf("no boolean spelling satisfies all patterns of %Y", name);
        }
        if (StringKinds{getFacetKind()}) {
            return getStringSample(string(default_value));
        }
        if (getFacetKind() == "list" || getFacetKind() == "hexBinary" || getFacetKind() == "base64Binary") {
            return getSizedSample(default_value);
        }
        # a "pattern" facet is the most specific constraint; generate a value from it if one is declared
        *XsdFacetCount required_length = getEffectiveFacet("length") ?? getEffectiveFacet("minLength");
        *int min_length = exists required_length
            && XsdFacetCountHelper::compare(required_length, XsdRegexHelper::MaxSampleLength) <= 0
            ? int(required_length) : NOTHING;
        *string sample = getPatternSample(min_length);
        if (exists sample && (!getNumericBaseName() || acceptsSample(sample))) {
            return sample;
        }

        if (getNumericBaseName()) {
            return getNumericSample(default_value);
        }

        auto rv = default_value;

        switch (rv.typeCode()) {
            case NT_INT:
            case NT_FLOAT:
            case NT_NUMBER: {
                # respect the digit facets first, as they determine the shape of the value
                *softint td = getEffectiveFacet("totalDigits");
                *softint fd = getEffectiveFacet("fractionDigits");
                if (exists td || exists fd) {
                    int frac = fd ?? 0;
                    int int_digits = exists td ? td - frac : 1;
                    if (int_digits < 1) {
                        int_digits = 1;
                    }
                    string sv = strmul("1", int_digits);
                    if (frac) {
                        sv += "." + strmul("1", frac);
                    }
                    rv = frac ? number(sv) : sv.toInt();
                }

                number n = number(rv);
                number orig = n;
                auto v = getEffectiveFacet("minInclusive");
                if (exists v && n < number(v)) {
                    n = number(v);
                }
                v = getEffectiveFacet("minExclusive");
                if (exists v && n <= number(v)) {
                    n = number(v) + 1;
                }
                v = getEffectiveFacet("maxInclusive");
                if (exists v && n > number(v)) {
                    n = number(v);
                }
                v = getEffectiveFacet("maxExclusive");
                if (exists v && n >= number(v)) {
                    n = number(v) - 1;
                }
                if (n != orig) {
                    rv = rv.typeCode() == NT_INT ? n.toInt() : n;
                }
                break;
            }

            case NT_STRING: {
                *softint len = getEffectiveFacet("length");
                rv = exists len
                    ? XsdSimpleType::fitString(rv, len, len)
                    : XsdSimpleType::fitString(rv, getEffectiveFacet("minLength"),
                        getEffectiveFacet("maxLength"));
                break;
            }
        }
        return rv;
    }

    private string getQNameSample(auto default_value) {
        list<auto> candidates = (default_value,);
        *XsdSimpleType ancestor = self;
        while (ancestor) {
            foreach string choice in (keys ancestor.enumValues) {
                push candidates, choice;
            }
            ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
        }
        # Deprecated QName length facets must not truncate or enlarge a lexical name.
        *string patterned = getPatternSample(1);
        if (exists patterned) {
            push candidates, patterned;
        }
        push candidates, "abc";
        foreach auto candidate in (candidates) {
            if (acceptsSample(candidate)) {
                return deserializeValue(name, new hash<string, XsdAbstractType>(), NOTHING, candidate);
            }
        }
        throw "XSD-SAMPLE-ERROR", sprintf("cannot construct a QName example satisfying the lexical restrictions "
            "of %Y; supply a valid example", name);
    }

    private string getStringSample(string default_value) {
        string normalized = normalizeWhiteSpace(default_value, getWhiteSpace());
        if (acceptsSample(normalized)) {
            return normalized;
        }
        *XsdSimpleType ancestor = self;
        while (ancestor) {
            foreach string choice in (keys ancestor.stringEnumValues) {
                if (acceptsSample(choice)) {
                    return normalizeWhiteSpace(choice, getWhiteSpace());
                }
            }
            ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
        }
        *XsdFacetCount minimum = getEffectiveFacet("length") ?? getEffectiveFacet("minLength");
        *XsdFacetCount maximum = getEffectiveFacet("length") ?? getEffectiveFacet("maxLength");
        if (!exists minimum || XsdFacetCountHelper::compare(minimum, XsdRegexHelper::MaxSampleLength) <= 0) {
            int min_size = exists minimum ? int(minimum) : 0;
            int max_size = exists maximum
                && XsdFacetCountHelper::compare(maximum, XsdRegexHelper::MaxSampleLength) < 0
                ? int(maximum) : XsdRegexHelper::MaxSampleLength;
            *string patterned = getPatternSample(min_size);
            if (exists patterned && acceptsSample(patterned)) {
                return normalizeWhiteSpace(patterned, getWhiteSpace());
            }
            string fitted = fitString(normalized, min_size, max_size);
            if (acceptsSample(fitted)) {
                return normalizeWhiteSpace(fitted, getWhiteSpace());
            }
        }
        throw "XSD-SAMPLE-ERROR", sprintf("cannot construct a string example satisfying all facets of %Y "
            "within the %d-character generated-example limit; supply a valid example", name,
            XsdRegexHelper::MaxSampleLength);
    }

    private auto getSizedSample(auto default_value) {
        if (getFacetKind() == "list") {
            bool native_list = hasNativeListValue();
            if (native_list && default_value.typeCode() == NT_STRING) {
                default_value = XsdListValueHelper::tokens(default_value);
            }
            *XsdSimpleType ancestor = self;
            while (ancestor) {
                foreach string choice in (keys ancestor.enumValues) {
                    auto candidate = native_list ? XsdListValueHelper::tokens(choice)
                        : normalizeWhiteSpace(choice, "collapse");
                    if (acceptsSample(candidate)) {
                        return candidate;
                    }
                }
                ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
            }
            *string patterned = getPatternSample();
            if (exists patterned) {
                auto candidate = native_list ? XsdListValueHelper::tokens(patterned)
                    : normalizeWhiteSpace(patterned, "collapse");
                if (acceptsSample(candidate)) {
                    return candidate;
                }
            }
        }
        if (acceptsSample(default_value)) {
            return default_value;
        }
        *XsdFacetCount minimum = getEffectiveFacet("length") ?? getEffectiveFacet("minLength");
        *XsdFacetCount maximum = getEffectiveFacet("length") ?? getEffectiveFacet("maxLength");
        if (!exists minimum || XsdFacetCountHelper::compare(minimum, XsdRegexHelper::MaxSampleLength) <= 0) {
            int min_size = exists minimum ? int(minimum) : 0;
            int max_size = exists maximum
                && XsdFacetCountHelper::compare(maximum, XsdRegexHelper::MaxSampleLength) < 0
                ? int(maximum) : XsdRegexHelper::MaxSampleLength;
            auto candidate;
            if (getFacetKind() == "list") {
                bool native_list = hasNativeListValue();
                list<auto> items = native_list
                    ? (default_value.typeCode() == NT_LIST ? default_value : (default_value,))
                    : split(" ", normalizeWhiteSpace(string(default_value), "collapse"));
                if (items.size() > max_size) {
                    splice items, max_size;
                }
                if (items.size()) {
                    while (items.size() < min_size) {
                        items += items[0];
                    }
                }
                candidate = native_list ? items : items.join(" ");
            } else {
                # Octet counts are bounded before allocating generated binary content.
                candidate = parse_hex_string(strmul("00", min_size));
            }
            if (acceptsSample(candidate)) {
                return candidate;
            }
        }
        throw "XSD-SAMPLE-ERROR", sprintf("cannot construct an example satisfying all facets of %Y "
            "within the %d-item/octet generated-example limit; supply a valid example", name,
            XsdRegexHelper::MaxSampleLength);
    }

    private bool acceptsSample(auto value) {
        try {
            serializeValue(new Namespaces({}), value, True);
            return True;
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == SOAP_SERIALIZATION_ERROR) {
                return False;
            }
            rethrow;
        }
    }

    private auto getUnionSample(auto default_value) {
        if (acceptsSample(default_value)) {
            return default_value;
        }
        list<string> candidates();
        *XsdSimpleType ancestor = self;
        while (ancestor) {
            foreach string lexical in (keys ancestor.enumValues) {
                push candidates, lexical;
            }
            ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
        }
        *string patterned = getPatternSample();
        if (exists patterned) {
            push candidates, patterned;
        }
        foreach string lexical in (candidates) {
            try {
                auto candidate = deserializeValue(name, new hash<string, XsdAbstractType>(), NOTHING, lexical);
                if (acceptsSample(candidate)) {
                    return candidate;
                }
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != SOAP_DESERIALIZATION_ERROR) {
                    rethrow;
                }
            }
        }
        throw "XSD-SAMPLE-ERROR", sprintf("cannot construct a union example satisfying all restrictions of %Y "
            "from its default value, enumerations or patterns; supply a valid example", name);
    }

    private auto getBinaryChoice(string lexical) {
        list<string> candidates = (lexical,);
        if (getBinaryBaseName() == "hexBinary") {
            push candidates, toupper(lexical);
            push candidates, tolower(lexical);
        }
        *string patterned = getPatternSample();
        if (exists patterned) {
            push candidates, patterned;
        }
        string key = XsdBinaryFacetHelper::key(getBinaryBaseName(), lexical, "XSD-SIMPLETYPE-ERROR");
        foreach string text in (candidates) {
            try {
                auto value = deserializeValue(name, new hash<string, XsdAbstractType>(), NOTHING, text);
                if (XsdBinaryFacetHelper::key(getBinaryBaseName(), value, "SOAP-DESERIALIZATION-ERROR") == key) {
                    return value;
                }
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != SOAP_DESERIALIZATION_ERROR) {
                    rethrow;
                }
            }
        }
    }

    private auto getBinarySample(auto default_value) {
        if (acceptsSample(default_value)) {
            return default_value;
        }
        list<string> candidates();
        *XsdSimpleType ancestor = self;
        while (ancestor) {
            foreach string choice in (keys ancestor.enumValues) {
                push candidates, choice;
            }
            ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
        }
        # Pattern samples must also form complete encoding units. A one-character
        # sample of [A-F]+ is a valid regex word but not a complete hex octet.
        int unit = getBinaryBaseName() == "hexBinary" ? 2 : 4;
        for (int minimum = 1; minimum <= unit; ++minimum) {
            *string patterned = getPatternSample(minimum);
            if (exists patterned) {
                push candidates, patterned;
            }
        }
        foreach string lexical in (candidates) {
            try {
                XsdBinaryValue candidate(getBinaryBaseName(), lexical);
                if (acceptsSample(candidate)) {
                    return deserializeValue(name, new hash<string, XsdAbstractType>(), NOTHING, lexical);
                }
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "XSD-BINARY-VALUE-ERROR") {
                    rethrow;
                }
            }
        }
        *XsdFacetCount required = getEffectiveFacet("length") ?? getEffectiveFacet("minLength");
        if (!exists required || XsdFacetCountHelper::compare(required, XsdRegexHelper::MaxSampleLength) <= 0) {
            binary zeros = parse_hex_string(strmul("00", exists required ? int(required) : 0));
            if (acceptsSample(zeros)) {
                return zeros;
            }
        }
        throw "XSD-SAMPLE-ERROR", sprintf("cannot construct binary text satisfying all facets of %Y "
            "within the %d-octet generated-example limit; supply a valid example", name, XsdRegexHelper::MaxSampleLength);
    }

    private auto getDurationSample(auto default_value) {
        if (acceptsSample(default_value)) {
            return default_value;
        }
        *XsdSimpleType ancestor = self;
        list<string> endpoints();
        int scale = 1;
        while (ancestor) {
            foreach string choice in (keys ancestor.enumValues) {
                if (acceptsSample(choice)) {
                    return choice;
                }
            }
            foreach string endpoint in (ancestor.getDurationFacets().bounds.values()) {
                push endpoints, endpoint;
                scale = max(scale, XsdDurationValueHelper::fractionDigits(endpoint) + 1);
            }
            ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
        }
        list<string> candidates = endpoints;
        foreach string endpoint in (endpoints) {
            candidates += XsdDurationValueHelper::nearby(endpoint, scale);
        }
        *string patterned = getPatternSample();
        if (exists patterned) {
            push candidates, patterned;
        }
        push candidates, "PT0S";
        foreach string candidate in (candidates) {
            if (acceptsSample(candidate)) {
                return candidate;
            }
        }
        throw "XSD-SAMPLE-ERROR", sprintf("cannot construct a duration example satisfying the patterns, "
            "enumerations and bounds of %Y from its endpoints or adjacent duration values; supply a valid example", name);
    }

    private auto getCalendarSample(auto default_value) {
        if (acceptsSample(default_value)) {
            return default_value;
        }
        *XsdSimpleType ancestor = self;
        list<string> candidates();
        while (ancestor) {
            foreach string choice in (keys ancestor.enumValues) {
                if (acceptsSample(choice)) {
                    return choice;
                }
            }
            hash<XsdCalendarFacetInfo> facets = ancestor.getCalendarFacets();
            foreach string facet in (keys facets.bounds) {
                string endpoint = facets.bounds{facet};
                push candidates, endpoint;
                candidates += XsdCalendarLexicalHelper::nearby(facets.base_name, endpoint);
            }
            ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
        }
        *string patterned = getPatternSample();
        if (exists patterned) {
            push candidates, patterned;
        }
        push candidates, XsdCalendarLexicalHelper::Samples{getCalendarBaseName()};
        foreach string candidate in (candidates) {
            if (acceptsSample(candidate)) {
                return candidate;
            }
        }
        throw "XSD-SAMPLE-ERROR", sprintf("cannot construct a calendar example satisfying the patterns, "
            "enumerations and bounds of %Y from its endpoints or adjacent calendar values; supply a valid example", name);
    }

    private auto getNumericSample(auto default_value) {
        string base = getNumericBaseName();
        if (acceptsSample(default_value)) {
            return default_value;
        }
        # Inherited enumerations are finite; test their exact values before constructing a grid value.
        *XsdSimpleType ancestor = self;
        while (ancestor) {
            foreach string choice in (keys ancestor.enumValues) {
                if (acceptsSample(choice)) {
                    return choice;
                }
            }
            ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
        }
        if (acceptsSample("0")) {
            return "0";
        }
        if (XsdIeeeLexicalHelper::isType(base)) {
            return getIeeeBoundSample(base);
        }

        *string lower;
        *string upper;
        bool lower_exclusive = False;
        bool upper_exclusive = False;
        *list<*string> builtin_bounds = XsdIntegerLexicalHelper::Bounds{base};
        if (builtin_bounds) {
            lower = builtin_bounds[0];
            upper = builtin_bounds[1];
        }
        ancestor = self;
        while (ancestor) {
            foreach string facet in ("minInclusive", "minExclusive", "maxInclusive", "maxExclusive") {
                auto bound = ancestor{facet};
                if (!exists bound) {
                    continue;
                }
                string value = XsdNumericFacetHelper::lexical(base, bound, "XSD-SAMPLE-ERROR");
                bool exclusive = facet.endsWith("Exclusive");
                if (facet.startsWith("min")) {
                    int relation = exists lower ? XsdDecimalLexicalHelper::compare(value, lower) : 1;
                    if (relation > 0 || (!relation && exclusive)) {
                        lower = value;
                        lower_exclusive = exclusive;
                    }
                } else {
                    int relation = exists upper ? XsdDecimalLexicalHelper::compare(value, upper) : -1;
                    if (relation < 0 || (!relation && exclusive)) {
                        upper = value;
                        upper_exclusive = exclusive;
                    }
                }
            }
            ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
        }

        *string boundary;
        bool negative = False;
        bool exclusive = False;
        if (exists lower && XsdDecimalLexicalHelper::compare(lower, "0") >= 0) {
            boundary = lower;
            exclusive = lower_exclusive;
        } else if (exists upper && XsdDecimalLexicalHelper::compare(upper, "0") <= 0) {
            boundary = upper;
            exclusive = upper_exclusive;
            negative = True;
        }
        if (exists boundary) {
            # One more fractional position than either endpoint gives an interior grid point, if one exists.
            int scale = 0;
            if (base == "decimal") {
                foreach *string bound in (lower, upper) {
                    if (exists bound) {
                        int digits = (XsdDecimalLexicalHelper::canonical(bound).split(".")[1] ?? "").size() + 1;
                        if (digits > scale) {
                            scale = digits;
                        }
                    }
                }
                *XsdFacetCount fractional = getEffectiveFacet("fractionDigits");
                if (exists fractional && XsdFacetCountHelper::compare(fractional, scale) < 0) {
                    scale = int(fractional);
                }
                *XsdFacetCount total = getEffectiveFacet("totalDigits");
                if (exists total) {
                    string whole = XsdDecimalLexicalHelper::canonical(boundary).split(".")[0];
                    whole =~ s/\A-//;
                    int whole_digits = whole == "0" ? 0 : whole.size();
                    if (XsdFacetCountHelper::compare(total, whole_digits) <= 0) {
                        scale = 0;
                    } else if (XsdFacetCountHelper::compare(total, whole_digits + scale) < 0) {
                        scale = int(total) - whole_digits;
                    }
                }
            }
            string magnitude = XsdDecimalLexicalHelper::ceilingMagnitude(boundary, scale, exclusive);
            string candidate = (negative ? "-" : "") + magnitude;
            if (acceptsSample(candidate)) {
                return candidate;
            }
        }
        throw "XSD-SAMPLE-ERROR", sprintf("cannot construct a numeric example satisfying all facets of %Y; "
            "the numeric grid has no valid candidate or the pattern/enumeration intersection requires a supplied "
            "lexical example", name);
    }

    private auto getIeeeBoundSample(string builtin) {
        *XsdSimpleType ancestor = self;
        while (ancestor) {
            foreach string facet in ("minInclusive", "minExclusive", "maxInclusive", "maxExclusive") {
                if (!exists ancestor{facet}) {
                    continue;
                }
                float endpoint = XsdIeeeLexicalHelper::decode(builtin, ancestor{facet}, "XSD-SAMPLE-ERROR");
                foreach float candidate in (endpoint,
                        XsdIeeeLexicalHelper::adjacent(builtin, endpoint, facet.startsWith("min"))) {
                    if (acceptsSample(candidate)) {
                        return candidate;
                    }
                }
            }
            ancestor = ancestor.type instanceof XsdSimpleType ? cast<XsdSimpleType>(ancestor.type) : NOTHING;
        }
        throw "XSD-SAMPLE-ERROR", sprintf("cannot construct an IEEE example satisfying all facets of %Y; "
            "the value space is empty or its lexical patterns require a supplied example", name);
    }

    #! pads or truncates a sample string so that its length lies within the given bounds
    private static string fitString(string str, *softint min_len, *softint max_len) {
        if (exists max_len && str.length() > max_len) {
            str = str.substr(0, max_len);
        }
        if (exists min_len && str.length() < min_len) {
            if (!str.length()) {
                str = "a";
            }
            while (str.length() < min_len) {
                str += str;
            }
            str = str.substr(0, min_len);
        }
        return str;
    }

    #! Validate restriction facets for serialization/deserialization
    /** @param val the value to validate
        @param operation "serialize" or "deserialize" for error context
        @param lexical the normalized whole-list lexical form when validating native item lists
    */
    private validateFacets(auto val, string operation, *string lexical) {
        # Skip validation for NOTHING values
        if (!exists val) {
            return;
        }

        # Determine error type based on operation
        string errType = operation == "deserialize" ? "SOAP-DESERIALIZATION-ERROR" : "SOAP-SERIALIZATION-ERROR";
        if (getNumericBaseName()) {
            XsdNumericFacetHelper::validate(getNumericFacets(), val, errType);
            return;
        }
        if (getCalendarBaseName()) {
            string checked = XsdCalendarFacetHelper::validate(getCalendarFacets(), lexical ?? val, errType);
            return;
        }
        if (getDurationBaseName()) {
            string checked = XsdDurationFacetHelper::validate(getDurationFacets(), lexical ?? val, errType);
            return;
        }
        if (getBinaryBaseName()) {
            string checked = XsdBinaryFacetHelper::validate(getBinaryFacets(), lexical ?? val, errType);
            return;
        }

        # Pattern validation
        # issue #5411: XSD 1.0 part 2 section 4.3.4.3: multiple "pattern" facets declared in the same restriction
        # are combined as if they appeared in a single regular expression separated by "|", so a value matching any
        # one of them is valid.  Patterns declared in different derivation steps are intersected, which happens
        # automatically, as each step validates the value in serializeValue() / deserializeValue()
        if (patterns) {
            string strVal = lexical ?? string(val);
            if (!matchesAnyPattern(strVal)) {
                throw errType, sprintf("value %y for simpleType %y does not match %s during %s", val, name,
                    patterns.size() == 1
                        ? sprintf("pattern %y", patterns[0])
                        : sprintf("any of the patterns %y", patterns),
                    operation);
            }
        }

        # XSD 1.0 4.3.1-3: length facets on QName/NOTATION are deprecated and always satisfied.
        string kind = getFacetKind();
        if (kind != "QName" && kind != "NOTATION" && (exists length || exists minLength || exists maxLength)) {
            int len;
            if (kind == "list" && hasNativeListValue()) {
                # Native list serialization also accepts a scalar as one item and NOTHING as an empty list.
                len = val.typeCode() == NT_LIST ? val.size() : exists val ? 1 : 0;
            } else if (val.typeCode() == NT_STRING) {
                if (kind == "list") {
                    string tokens = normalizeWhiteSpace(val, "collapse");
                    len = tokens.empty() ? 0 : tokens.split(" ").size();
                } else {
                    len = val.length();
                }
            } else if (val.typeCode() == NT_BINARY) {
                len = val.size();
            } else if (val.typeCode() == NT_LIST) {
                len = val.size();
            } else {
                len = string(val).length();
            }

            if (exists length && XsdFacetCountHelper::compare(len, length)) {
                throw errType, sprintf("value %y for simpleType %y has length %d, "
                    "but exact length %Y is required during %s", val, name, len, length, operation);
            }
            if (exists minLength && XsdFacetCountHelper::compare(len, minLength) < 0) {
                throw errType, sprintf("value %y for simpleType %y has length %d, "
                    "but minimum length is %Y during %s", val, name, len, minLength, operation);
            }
            if (exists maxLength && XsdFacetCountHelper::compare(len, maxLength) > 0) {
                throw errType, sprintf("value %y for simpleType %y has length %d, "
                    "but maximum length is %Y during %s", val, name, len, maxLength, operation);
            }
        }

        # Numeric range validation
        if (exists minInclusive || exists maxInclusive || exists minExclusive || exists maxExclusive) {
            auto numVal = val;
            # Try to convert to number for comparison if it's a string
            if (numVal.typeCode() == NT_STRING) {
                numVal = float(numVal);
            }

            if (exists minInclusive && numVal < float(minInclusive)) {
                throw errType, sprintf("value %y for simpleType %y is less than "
                    "minInclusive %y during %s", val, name, minInclusive, operation);
            }
            if (exists maxInclusive && numVal > float(maxInclusive)) {
                throw errType, sprintf("value %y for simpleType %y is greater than "
                    "maxInclusive %y during %s", val, name, maxInclusive, operation);
            }
            if (exists minExclusive && numVal <= float(minExclusive)) {
                throw errType, sprintf("value %y for simpleType %y must be greater than "
                    "minExclusive %y during %s", val, name, minExclusive, operation);
            }
            if (exists maxExclusive && numVal >= float(maxExclusive)) {
                throw errType, sprintf("value %y for simpleType %y must be less than "
                    "maxExclusive %y during %s", val, name, maxExclusive, operation);
            }
        }

        # Precision validation (totalDigits and fractionDigits)
        # issue #5411: both facets constrain the digits of the value, so the sign is ignored and insignificant
        # zeros do not count: "0012.3400" has 4 total digits and 2 fraction digits
        if (exists totalDigits || exists fractionDigits) {
            string strVal = string(val);
            strVal =~ s/^[+-]//;
            string int_part = (strVal =~ x/^([0-9]*)/)[0] ?? "";
            string frac_part = (strVal =~ x/\.([0-9]*)$/)[0] ?? "";
            # leading zeros in the integer part and trailing zeros in the fraction are not significant
            int_part =~ s/^0+//;
            frac_part =~ s/0+$//;

            if (exists fractionDigits && frac_part.length() > fractionDigits) {
                throw errType, sprintf("value %y for simpleType %y has %d fraction digits, "
                    "but maximum is %d during %s", val, name, frac_part.length(), fractionDigits, operation);
            }

            if (exists totalDigits) {
                # a value of zero still has one digit
                int total = int_part.length() + frac_part.length();
                if (!total) {
                    total = 1;
                }
                if (total > totalDigits) {
                    throw errType, sprintf("value %y for simpleType %y has %d total digits, "
                        "but maximum is %d during %s", val, name, total, totalDigits, operation);
                }
            }
        }
    }

    auto deserializeValue(string en, hash<string, XsdAbstractType> tmap, *hash<auto> mrh, auto val) {
        # Handle list type deserialization
        if (val.typeCode() == NT_HASH && val.hasKey("^attributes^")) {
            XsdBase::validateSimpleAttributes(val."^attributes^", name);
        }
        if (listItemType) {
            return deserializeList(en, tmap, mrh, val);
        }

        if (getFacetKind() == "union") {
            hash<XsdSchemaUnionTrialResult> result = deserializeUnion(en, tmap, mrh, val);
            auto converted = result.owner && !SchemaUnionValueProbe ? preserveUnionValue(en, tmap, mrh, val, result) : result.value;
            if (SchemaUnionItemCapture && SchemaUnionItemCapture.target === self) {
                SchemaUnionItemCapture.identity = result.identity;
            }
            return converted;
        }

        if (getCalendarBaseName()) {
            string lexical = XsdCalendarFacetHelper::validate(getCalendarFacets(),
                XsdScalarTextHelper::value(val, SOAP_DESERIALIZATION_ERROR), SOAP_DESERIALIZATION_ERROR);
            auto converted = type.deserializeValue(en, tmap, mrh, lexical);
            return patterns ? lexical : converted;
        }
        if (getDurationBaseName()) {
            string lexical = XsdDurationFacetHelper::validate(getDurationFacets(),
                XsdScalarTextHelper::value(val, SOAP_DESERIALIZATION_ERROR), SOAP_DESERIALIZATION_ERROR);
            auto converted = type.deserializeValue(en, tmap, mrh, lexical);
            return patterns ? lexical : converted;
        }
        if (getBinaryBaseName()) {
            string lexical = XsdBinaryFacetHelper::validate(getBinaryFacets(),
                XsdScalarTextHelper::value(val, SOAP_DESERIALIZATION_ERROR), SOAP_DESERIALIZATION_ERROR);
            auto converted = type.deserializeValue(en, tmap, mrh, lexical);
            return patterns ? new XsdBinaryValue(getBinaryBaseName(), lexical) : converted;
        }

        if (getNumericBaseName()) {
            string lexical = XsdNumericFacetHelper::validate(getNumericFacets(),
                XsdScalarTextHelper::value(val, SOAP_DESERIALIZATION_ERROR), SOAP_DESERIALIZATION_ERROR);
            auto converted = type.deserializeValue(en, tmap, mrh, val);
            return patterns ? lexical : converted;
        }

        if (listItemValueInfo) {
            *XsdSchemaUnionItemCapture caller = SchemaUnionListCapture;
            *XsdSimpleType target = listItemValueInfo.union_item ? XsdUnionValueHelper::listType(type) : NOTHING;
            bool capture_owner = target && (!caller || caller.target !== target);
            on_exit if (capture_owner) {
                SchemaUnionListCapture = caller;
            }
            if (capture_owner) {
                SchemaUnionListCapture = new XsdSchemaUnionItemCapture(target);
            }
            auto text = XsdScalarTextHelper::value(val, SOAP_DESERIALIZATION_ERROR);
            if (exists text && !text.strp()) {
                throw SOAP_DESERIALIZATION_ERROR, "an XML list requires scalar lexical text";
            }
            string lexical = normalizeWhiteSpace(string(text), "collapse");
            list<auto> value = type.deserializeValue(en, tmap, mrh, lexical);
            validateFacets(value, "deserialize", lexical);
            if (!enumerationAccepts(value, listItemValueInfo.union_item ? SchemaUnionListCapture.identity : NOTHING)) {
                throw SOAP_DESERIALIZATION_ERROR, sprintf("list value for %Y is outside its enumeration", name);
            }
            return patterns ? XsdListValueHelper::tokens(lexical) : value;
        }

        if (getFacetKind() == "boolean") {
            string lexical = XsdBooleanLexicalHelper::lexical(
                XsdScalarTextHelper::value(val, SOAP_DESERIALIZATION_ERROR), SOAP_DESERIALIZATION_ERROR);
            validateFacets(lexical, "deserialize", lexical);
            auto converted = type.deserializeValue(en, tmap, mrh, val);
            return patterns ? lexical : converted;
        }

        if (StringKinds{getFacetKind()}) {
            val = applyWhiteSpace(XsdScalarTextHelper::value(val, SOAP_DESERIALIZATION_ERROR));
        }
        auto v = type.deserializeValue(en, tmap, mrh, val);

        # issue #5411: "whiteSpace" processing is applied to the lexical value before it is validated
        v = applyWhiteSpace(v);
        # Validate facets after deserialization
        validateFacets(v, "deserialize");

        if (!enumerationAccepts(v)) {
            throw "SOAP-DESERIALIZATION-ERROR", sprintf("value %y passed to simpleType %y while deserializing "
                "element %y is not in the enumeration list<auto> (%y)", v, name, en, enumValues.keys());
        }

        return v;
    }

    #! Deserialize a list type value from space-separated string
    private auto deserializeList(string en, hash<string, XsdAbstractType> tmap, *hash<auto> mrh, auto val) {
        bool capture = (exists SchemaUnionDeserializeContext || exists SchemaUnionListCapture)
            && XsdUnionValueHelper::schemaUnionItem(listItemType);
        *XsdSchemaUnionItemCapture caller_capture = SchemaUnionItemCapture;
        on_exit if (capture) {
            SchemaUnionItemCapture = caller_capture;
        }
        list<*hash<XsdUnionValueIdentity>> identities();
        val = XsdScalarTextHelper::value(val, SOAP_DESERIALIZATION_ERROR);
        if (exists val && !val.strp()) {
            throw SOAP_DESERIALIZATION_ERROR, "an XML list requires scalar lexical text";
        }

        # XSD list whitespace is fixed to collapse, before item boundaries are found.
        # Splitting first would pass TAB/LF/CR-separated items to a single scalar validator.
        string strVal = XsdSimpleType::normalizeWhiteSpace(string(val), getWhiteSpace());
        list<string> items = strVal.split(" ");

        # Deserialize each item
        list<auto> result = ();
        foreach string item in (items) {
            if (item != "") {  # Skip empty strings from multiple spaces
                if (capture) {
                    SchemaUnionItemCapture = new XsdSchemaUnionItemCapture(listItemType);
                }
                result += listItemType.deserializeValue(en, tmap, mrh, item);
                if (capture) {
                    push identities, SchemaUnionItemCapture.identity;
                }
            }
        }

        if (capture) {
            *hash<XsdUnionValueIdentity> identity = XsdUnionValueHelper::capturedIdentity(identities);
            if (identity && SchemaUnionDeserializeContext) {
                SchemaUnionDeserializeContext.identities{self.uniqueHash()} = identity;
            }
            if (SchemaUnionListCapture && SchemaUnionListCapture.target === self) {
                SchemaUnionListCapture.identity = identity;
            }
        }
        return result;
    }
}

hashdecl XsdEmptiabilityInfo {
    bool optional = False;
    bool absent = False;
    bool choice = False;
    bool terminal = False;
    *string ref;
    list<hash<XsdEmptiabilityInfo>> children();
}

# Schema construction metadata for the Particle Emptiable predicate. This does not flatten
# occurrences into fields or match instance content; it retains nested zero/choice/sequence logic.
class XsdEmptiabilityHelper {
    static hash<XsdEmptiabilityInfo> parse(*hash<auto> data, Namespaces nsc, string kind = "sequence") {
        NamespacePrefixHelper scope(nsc, data."^attributes^");
        WSDL::XsdBase::removeNS(\data);
        hash<XsdEmptiabilityInfo> result = <XsdEmptiabilityInfo>{
            "optional": zeroOccurs(data."^attributes^".minOccurs),
            "absent": zeroOccurs(data."^attributes^".maxOccurs),
            "choice": kind == "choice",
            "terminal": kind == "element" || kind == "any",
        };
        if (kind == "group") {
            if (!data."^attributes^".ref) {
                throw WSDL_ERROR, "group reference requires ref";
            }
            hash<auto> identity = nsc.getTypeHash(data."^attributes^".ref);
            result.ref = type_qname(identity.uri, identity.val);
        } else if (!result.terminal) {
            foreach string key in (keys data) {
                if (key == "sequence" || key == "choice" || key == "all" || key == "group"
                        || key == "element" || key == "any") {
                    # Empty compositors are represented as NOTHING, but remain a child of a choice.
                    foreach *hash<auto> child in (data{key} ?? (NOTHING,)) {
                        result.children += parse(child, nsc, key);
                    }
                }
            }
        }
        return result;
    }

    static bool evaluate(hash<XsdEmptiabilityInfo> info, hash<string, XsdGroup> groups) {
        bool result = !info.terminal && (!info.choice || !info.children);
        if (info.ref) {
            *XsdGroup group = groups{info.ref};
            if (!group) {
                throw WSDL_ERROR, sprintf("undefined group reference %Y", info.ref);
            }
            result = group.isEmptiable(groups);
        }
        foreach hash<XsdEmptiabilityInfo> child in (info.children) {
            # Resolve every reference, including references under optional or already-emptiable branches.
            bool child_empty = evaluate(child, groups);
            result = info.choice ? result || child_empty : result && child_empty;
        }
        return info.absent || info.optional || result;
    }

    static bool hasEmptyContent(*hash<auto> data, bool mixed) {
        if (mixed) {
            return False;
        }
        WSDL::XsdBase::removeNS(\data);
        foreach string kind in ("group", "all", "choice", "sequence") {
            if (!data.hasKey(kind)) {
                continue;
            }
            if (kind == "group") {
                return False;
            }
            *hash<auto> model = data{kind};
            WSDL::XsdBase::removeNS(\model);
            if (select keys model, $1 != "^attributes^" && $1 != "annotation" && $1 != "ns") {
                return False;
            }
            return kind != "choice" || zeroOccurs(model."^attributes^".minOccurs);
        }
        return True;
    }

    static bool zeroOccurs(*string value) {
        return exists value && (trim(value) =~ /^[+-]?0+$/);
    }

    static bool getMixed(*hash<auto> attributes, bool inherited = False) {
        if (!attributes.hasKey("mixed")) {
            return inherited;
        }
        string value = trim(attributes.mixed);
        if (value == "true" || value == "1") {
            return True;
        }
        if (value == "false" || value == "0") {
            return False;
        }
        throw WSDL_ERROR, sprintf("invalid mixed declaration %Y", value);
    }
}

#! XSD element group class for xs:group definitions
public class XsdGroup inherits WSDL::XsdNamedData, Qore::Serializable {
    public {
        #! Elements in this group (from sequence, choice, or all)
        /** After resolution, unambiguous fields use local names; colliding fields use expanded names. */
        hash<string, XsdElement> groupElements();
        #! The group content model type: "sequence", "choice", or "all"
        *string contentModel;
        #! Namespace URI where this group is defined
        *string nsUri;
    }

    private {
        list<string> nestedGroupRefs();
        list<string> elementGroupRefs();
        list<XsdElement> declaredElements();
        hash<string, XsdElement> elementDeclarations();
        bool resolving = False;
        bool resolved = False;
        hash<XsdEmptiabilityInfo> emptiability;
        *bool emptiable;
        bool evaluating_emptiability = False;
    }

    #! constructs a named model group with declaration-local QName references
    /** @param g the parsed group declaration
        @param nsc its namespace context
        @param unresolved the graph's type resolution queue
        @param usedocns the schema's element qualification default
        @throw WSDL-ERROR invalid group content or missing reference
        @throw WSDL-NAMESPACE-ERROR malformed QName or unbound reference prefix
    */
    constructor(hash<auto> g, Namespaces nsc, XsdLateResolverHelper unresolved, bool usedocns) : XsdNamedData(\g) {
        NamespacePrefixHelper declaration(nsc, g."^attributes^");
        nsUri = nsc.getTargetNamespaceUri();
        WSDL::XsdBase::removeNS(\g);
        emptiability = XsdEmptiabilityHelper::parse(g, nsc);
        int models = int(g.hasKey("sequence")) + int(g.hasKey("choice")) + int(g.hasKey("all"));
        if (models != 1) {
            throw WSDL_ERROR, sprintf("group %Y requires exactly one sequence, choice, or all", name);
        }
        contentModel = g.hasKey("sequence") ? "sequence" : (g.hasKey("choice") ? "choice" : "all");
        *hash<auto> content = g{contentModel};
        parseContent(content, nsc, unresolved, usedocns, True);
    }

    private parseContent(*hash<auto> content, Namespaces nsc, XsdLateResolverHelper unresolved,
            bool usedocns, bool present) {
        NamespacePrefixHelper compositor(nsc, content."^attributes^");
        WSDL::XsdBase::removeNS(\content);
        present = present && !XsdElementConsistencyHelper::isAbsent(content);
        foreach string kind in (keys content) {
            if (kind == "element") {
                if (!content.element) {
                    throw WSDL_ERROR, "element declaration requires name or ref";
                }
                foreach auto e in (content.element) {
                    if (e.typeCode() != NT_HASH) {
                        throw WSDL_ERROR, "element declaration requires name or ref";
                    }
                    XsdElement elem(e, nsc, NOTHING, unresolved, usedocns);
                    groupElements{elem.getExpandedName()} = elem;
                    if (present && !XsdElementConsistencyHelper::isAbsent(e)) {
                        declaredElements += elem;
                    }
                }
            } else if (kind == "sequence" || kind == "choice" || kind == "all") {
                foreach *hash<auto> nested in (content{kind}) {
                    parseContent(nested, nsc, unresolved, usedocns, present);
                }
            } else if (kind == "group") {
                if (!content.group) {
                    throw WSDL_ERROR, "group reference requires ref";
                }
                foreach hash<auto> nested in (content.group) {
                    if (!nested."^attributes^".ref) {
                        throw WSDL_ERROR, "group reference requires ref";
                    }
                    NamespacePrefixHelper reference_scope(nsc, nested."^attributes^");
                    hash<auto> identity = nsc.getTypeHash(nested."^attributes^".ref ?? "");
                    string key = type_qname(identity.uri, identity.val);
                    nestedGroupRefs += key;
                    if (present && !XsdElementConsistencyHelper::isAbsent(nested)) {
                        elementGroupRefs += key;
                    }
                }
            }
        }
    }

    #! resolves nested group identities before consumers use their elements
    /** @param groups the schema group registry
        @throw WSDL-ERROR an undefined or cyclic group reference
        @since %WSDL 0.5.8
    */
    resolveNestedGroups(hash<string, XsdGroup> groups) {
        if (resolved) {
            return;
        }
        if (resolving) {
            throw WSDL_ERROR, sprintf("cyclic group reference involving %Y", name);
        }
        resolving = True;
        on_exit resolving = False;
        isEmptiable(groups);
        hash<string, XsdElement> declarations();
        XsdElementConsistencyHelper::merge(\declarations, declaredElements);
        hash<string, XsdElement> merged_elements = groupElements;
        foreach string key in (nestedGroupRefs) {
            *XsdGroup group = groups{key};
            if (!group) {
                throw WSDL_ERROR, sprintf("undefined group reference %Y", key);
            }
            group.resolveNestedGroups(groups);
            merged_elements += XsdElementFieldHelper::getExpandedMap(group.getElements());
        }
        foreach string key in (elementGroupRefs) {
            XsdElementConsistencyHelper::merge(\declarations, (map $1, groups{key}.getElementDeclarations().iterator()));
        }
        elementDeclarations = declarations;
        groupElements = XsdElementFieldHelper::getFieldMap(merged_elements, XsdElementFieldHelper::getFieldNames(merged_elements));
        resolved = True;
    }

    #! returns the checked element declaration identities in the resolved group
    /** @return one representative declaration per expanded name after type consistency checking
        @note Call resolveNestedGroups() before reading this construction metadata.
        @since %WSDL 0.5.8
    */
    hash<string, XsdElement> getElementDeclarations() {
        return elementDeclarations;
    }

    #! returns whether this group's particle permits no element children
    /** @param groups the schema's registry of named groups
        @return True for an emptiable particle under XSD 1.0 section 3.9.6
        @throw WSDL-ERROR an undefined or cyclic nested group reference
        @since %WSDL 0.5.8
    */
    bool isEmptiable(hash<string, XsdGroup> groups) {
        if (exists emptiable) {
            return emptiable;
        }
        if (evaluating_emptiability) {
            throw WSDL_ERROR, sprintf("cyclic group reference involving %Y", name);
        }
        evaluating_emptiability = True;
        on_exit evaluating_emptiability = False;
        emptiable = XsdEmptiabilityHelper::evaluate(emptiability, groups);
        return emptiable;
    }

    #! Returns the elements in this group
    /** @return resolved fields keyed by local name where unique, otherwise by expanded name */
    hash<string, XsdElement> getElements() {
        return groupElements;
    }

    #! Returns the qualified name for map lookup: "{namespace_uri}local_name" or just "local_name" if no namespace
    string getQualifiedName() {
        return nsUri ? sprintf("{%s}%s", nsUri, name) : name;
    }
}

#! XSD 1.0 wildcard namespace constraint forms
/** @since %WSDL 0.5.8 */
public enum XsdWildcardConstraint : string {
    #! All namespace names, including no namespace
    Any = "any",
    #! A negated namespace, also excluding no namespace
    Not = "not",
    #! An enumerated set of namespace names
    Set = "set",
}

#! XSD wildcard validation strength
/** @since %WSDL 0.5.8 */
public enum XsdWildcardProcessing : string {
    #! No declaration validation
    Skip = "skip",
    #! Validate when a declaration is available
    Lax = "lax",
    #! Require and validate a declaration
    Strict = "strict",
}

#! Resolved attribute wildcard construction metadata
/** Empty strings denote no namespace. This describes the schema component; it does not itself validate values.
    @since %WSDL 0.5.8
*/
public hashdecl XsdAttributeWildcardInfo {
    #! Namespace constraint form
    XsdWildcardConstraint constraint = XsdWildcardConstraint::Any;
    #! Negated namespace for a Not constraint; no namespace is always excluded as well
    string excluded_namespace = "";
    #! Admitted namespace names for a Set constraint
    hash<string, bool> namespaces = {};
    #! Required validation strength
    XsdWildcardProcessing processing = XsdWildcardProcessing::Strict;
}

# Construction algebra follows XSD 1.0's intensional rules, including non-expressible combinations.
class XsdAttributeWildcardHelper {
    static hash<XsdAttributeWildcardInfo> parse(auto declaration, *string target_namespace) {
        if (exists declaration && declaration.typeCode() != NT_HASH) {
            throw WSDL_ERROR, "exactly one anyAttribute declaration is allowed";
        }
        *hash<auto> attributes = declaration."^attributes^";
        hash<XsdAttributeWildcardInfo> result();
        string process = trim(attributes.processContents ?? "strict");
        if (process == "skip") {
            result.processing = XsdWildcardProcessing::Skip;
        } else if (process == "lax") {
            result.processing = XsdWildcardProcessing::Lax;
        } else if (process != "strict") {
            throw WSDL_ERROR, sprintf("invalid anyAttribute processContents %Y", process);
        }
        string value = XsdSimpleType::normalizeWhiteSpace(attributes."namespace" ?? "##any", "collapse");
        if (value == "##any") {
            return result;
        }
        if (value == "##other") {
            result.constraint = XsdWildcardConstraint::Not;
            result.excluded_namespace = target_namespace ?? "";
            return result;
        }
        result.constraint = XsdWildcardConstraint::Set;
        foreach string item in (value.split(" ")) {
            if (!item) {
                continue;
            }
            if (item == "##local") {
                item = "";
            } else if (item == "##targetNamespace") {
                item = target_namespace ?? "";
            } else if (item =~ /^##/) {
                throw WSDL_ERROR, sprintf("invalid anyAttribute namespace list %Y", value);
            }
            result.namespaces{item} = True;
        }
        return result;
    }

    static hash<XsdAttributeWildcardInfo> urType() {
        return <XsdAttributeWildcardInfo>{"processing": XsdWildcardProcessing::Lax};
    }

    static bool allows(*hash<XsdAttributeWildcardInfo> wildcard, *string uri) {
        if (!exists wildcard) {
            return False;
        }
        if (wildcard.constraint == XsdWildcardConstraint::Any) {
            return True;
        }
        if (wildcard.constraint == XsdWildcardConstraint::Not) {
            return boolean(uri) && uri != wildcard.excluded_namespace;
        }
        return wildcard.namespaces{uri ?? ""} ?? False;
    }

    static bool subset(hash<XsdAttributeWildcardInfo> derived, hash<XsdAttributeWildcardInfo> base) {
        if (base.constraint == XsdWildcardConstraint::Any) {
            return True;
        }
        if (derived.constraint == XsdWildcardConstraint::Not) {
            return base.constraint == XsdWildcardConstraint::Not
                && derived.excluded_namespace == base.excluded_namespace;
        }
        if (derived.constraint != XsdWildcardConstraint::Set) {
            return False;
        }
        foreach string uri in (keys derived.namespaces) {
            if (!allows(base, uri)) {
                return False;
            }
        }
        return True;
    }

    static *hash<XsdAttributeWildcardInfo> complete(*hash<XsdAttributeWildcardInfo> local,
            list<hash<XsdAttributeWildcardInfo>> groups) {
        *hash<XsdAttributeWildcardInfo> result = local;
        foreach hash<XsdAttributeWildcardInfo> group in (groups) {
            result = exists result ? combine(result, group, False) : group;
        }
        return result;
    }

    static *hash<XsdAttributeWildcardInfo> derive(*hash<XsdAttributeWildcardInfo> own,
            *hash<XsdAttributeWildcardInfo> base, bool restriction, bool ur_type = False) {
        if (!restriction) {
            return exists own && exists base ? combine(own, base, True) : (own ?? base);
        }
        if (exists own) {
            if (!exists base || !subset(own, base)) {
                throw WSDL_ERROR, "attribute wildcard restriction must be a subset of its base wildcard";
            }
            const hash<string, int> Strength = {"skip": 0, "lax": 1, "strict": 2};
            if (!ur_type && Strength{own.processing} < Strength{base.processing}) {
                throw WSDL_ERROR, "attribute wildcard restriction cannot weaken processContents";
            }
        }
        return own;
    }

    private static hash<XsdAttributeWildcardInfo> combine(hash<XsdAttributeWildcardInfo> first,
            hash<XsdAttributeWildcardInfo> second, bool union) {
        hash<XsdAttributeWildcardInfo> result = first;
        XsdWildcardConstraint a = first.constraint;
        XsdWildcardConstraint b = second.constraint;
        if (a == XsdWildcardConstraint::Any || b == XsdWildcardConstraint::Any) {
            if (union) {
                result.constraint = XsdWildcardConstraint::Any;
                result.namespaces = {};
                result.excluded_namespace = "";
            } else if (a == XsdWildcardConstraint::Any) {
                result = second;
                result.processing = first.processing;
            }
            return result;
        }
        if (a == XsdWildcardConstraint::Set && b == XsdWildcardConstraint::Set) {
            if (union) {
                result.namespaces += second.namespaces;
            } else {
                foreach string uri in (keys result.namespaces) {
                    if (!second.namespaces{uri}) {
                        delete result.namespaces{uri};
                    }
                }
            }
            return result;
        }
        if (a == XsdWildcardConstraint::Not && b == XsdWildcardConstraint::Not) {
            if (first.excluded_namespace != second.excluded_namespace) {
                if (union) {
                    result.excluded_namespace = "";
                } else if (first.excluded_namespace && second.excluded_namespace) {
                    throw WSDL_ERROR, "attribute wildcard intersection is not expressible in XSD 1.0";
                } else {
                    result.excluded_namespace = first.excluded_namespace ? first.excluded_namespace : second.excluded_namespace;
                }
            }
            return result;
        }
        hash<XsdAttributeWildcardInfo> negated = a == XsdWildcardConstraint::Not ? first : second;
        hash<XsdAttributeWildcardInfo> listed = a == XsdWildcardConstraint::Set ? first : second;
        result.namespaces = {};
        result.excluded_namespace = "";
        if (!union) {
            result.constraint = XsdWildcardConstraint::Set;
            foreach string uri in (keys listed.namespaces) {
                if (allows(negated, uri)) {
                    result.namespaces{uri} = True;
                }
            }
        } else {
            bool local = listed.namespaces{""} ?? False;
            bool excluded = listed.namespaces{negated.excluded_namespace} ?? False;
            if (local && excluded) {
                result.constraint = XsdWildcardConstraint::Any;
            } else if (local) {
                throw WSDL_ERROR, "attribute wildcard union is not expressible in XSD 1.0";
            } else {
                result.constraint = XsdWildcardConstraint::Not;
                result.excluded_namespace = excluded ? "" : negated.excluded_namespace;
            }
        }
        return result;
    }
}

#! XSD attribute group class for xs:attributeGroup definitions
public class XsdAttributeGroup inherits WSDL::XsdNamedData, Qore::Serializable {
    public {
        #! Attributes in this group
        hash<string, XsdAttribute> groupAttrs();
        #! Expanded nested attributeGroup reference keys to resolve later
        list<string> nestedAttrGroupRefs();
        #! Namespace URI where this attribute group is defined
        *string nsUri;
    }

    #! constructs a named attribute group with declaration-local QName references
    /** @param ag the parsed attribute-group declaration
        @param nsc its namespace context
        @param unresolved the graph's type resolution queue
        @throw WSDL-ERROR invalid attribute declaration or missing group reference
        @throw WSDL-NAMESPACE-ERROR malformed QName or unbound reference prefix
    */
    constructor(hash<auto> ag, Namespaces nsc, XsdLateResolverHelper unresolved) : XsdNamedData(\ag) {
        NamespacePrefixHelper declaration(nsc, ag."^attributes^");
        nsUri = nsc.getTargetNamespaceUri();

        WSDL::XsdBase::removeNS(\ag);
        if (ag.hasKey("anyAttribute")) {
            localWildcard = XsdAttributeWildcardHelper::parse(ag.anyAttribute, nsUri);
        }

        # Parse attributes
        if (ag.hasKey("attribute") && !ag.attribute) {
            throw WSDL_ERROR, "attribute declaration requires a name or reference";
        }
        foreach hash<auto> ah in (ag.attribute) {
            XsdAttribute attr(ah, nsc, NOTHING, unresolved);
            # A prohibited declaration contributes no attribute-use component to a group.
            if (attr.use == "prohibited") {
                continue;
            }
            string identity = type_qname(attr.namespaceUri, attr.name);
            if (groupAttrs.hasKey(identity)) {
                throw WSDL_ERROR, sprintf("duplicate attribute use %Y", identity);
            }
            groupAttrs{identity} = attr;
        }
        groupAttrs = XsdAttribute::mergeMaps(new hash<string, XsdAttribute>(), groupAttrs);

        # Capture nested reference QNames before declaration scopes unwind.
        if (ag.hasKey("attributeGroup") && !ag.attributeGroup) {
            throw WSDL_ERROR, "attributeGroup reference requires ref";
        }
        foreach hash<auto> nested in (ag.attributeGroup) {
            if (!nested."^attributes^".ref) {
                throw WSDL_ERROR, "attributeGroup reference requires ref";
            }
            NamespacePrefixHelper reference_scope(nsc, nested."^attributes^");
            hash<auto> identity = nsc.getTypeHash(nested."^attributes^".ref ?? "");
            nestedAttrGroupRefs += type_qname(identity.uri, identity.val);
        }
    }

    private {
        *hash<XsdAttributeWildcardInfo> localWildcard;
        *hash<XsdAttributeWildcardInfo> attributeWildcard;
        bool resolving = False;
        bool resolved = False;
    }

    #! Returns the attributes in this group (including resolved nested groups)
    hash<string, XsdAttribute> getAttributes() {
        return groupAttrs;
    }

    #! resolves nested attribute-group identities and merges their attributes
    /** @param attrGroupMap the schema's attribute-group registry
        @param nsc the namespace registry, retained for API compatibility
        @throw WSDL-ERROR undefined or cyclic attribute-group reference
    */
    resolveNestedGroups(hash<string, XsdAttributeGroup> attrGroupMap, Namespaces nsc) {
        if (resolved) {
            return;
        }
        if (resolving) {
            throw WSDL_ERROR, sprintf("cyclic attributeGroup reference involving %Y", name);
        }
        resolving = True;
        on_exit resolving = False;
        list<hash<string, XsdAttribute>> nested_attributes();
        list<hash<XsdAttributeWildcardInfo>> wildcards();
        foreach string key in (nestedAttrGroupRefs) {
            *XsdAttributeGroup nested = attrGroupMap{key};
            if (!nested) {
                throw WSDL_ERROR, sprintf("undefined attributeGroup reference %Y", key);
            }
            nested.resolveNestedGroups(attrGroupMap, nsc);
            nested_attributes += (nested.getAttributes(),);
            *hash<XsdAttributeWildcardInfo> wildcard = nested.getAttributeWildcard();
            if (exists wildcard) {
                wildcards += wildcard;
            }
        }
        hash<string, XsdAttribute> merged = XsdAttribute::mergeMaps(groupAttrs, nested_attributes);
        *hash<XsdAttributeWildcardInfo> wildcard = XsdAttributeWildcardHelper::complete(localWildcard, wildcards);
        groupAttrs = merged;
        attributeWildcard = wildcard;
        resolved = True;
    }

    #! returns the resolved attribute wildcard for this group
    /** @return the constructed wildcard metadata, or NOTHING if no wildcard is present
        @note Call resolveNestedGroups() before reading the result.
        @since %WSDL 0.5.8
    */
    *hash<XsdAttributeWildcardInfo> getAttributeWildcard() {
        return attributeWildcard;
    }

    #! Returns the qualified name for map lookup: "{namespace_uri}local_name" or just "local_name" if no namespace
    string getQualifiedName() {
        return nsUri ? sprintf("{%s}%s", nsUri, name) : name;
    }
}

#! complex type choice hash
public hashdecl ChoiceInfo {
    #! all elements that can appear in the choice
    hash<string, XsdElement> elementmap;

    #! if a member of the choice must be present
    bool required;

    #! the alternatives making up the choice
    /** each alternative is a hash of the elements belonging to it; alternatives declared as nested model groups
        (ex: an \c xs:sequence inside an \c xs:choice) have more than one element

        @since %WSDL 0.5.8
    */
    list<hash<string, XsdElement>> alternatives = ();
}

# Internal simple-type ancestry checks for schema construction. Scalar facet/value validation belongs
# to the types themselves. Memoize pairs so unions that reuse members do not multiply traversal work.
class XsdTypeDerivationHelper {
    private {
        hash<string, bool> results();
        const BuiltinParents = {
            "normalizedString": "string", "token": "normalizedString", "language": "token",
            "Name": "token", "NCName": "Name", "ID": "NCName", "IDREF": "NCName", "ENTITY": "NCName",
            "NMTOKEN": "token", "integer": "decimal", "nonPositiveInteger": "integer",
            "negativeInteger": "nonPositiveInteger", "long": "integer", "int": "long", "short": "int",
            "byte": "short", "nonNegativeInteger": "integer", "unsignedLong": "nonNegativeInteger",
            "unsignedInt": "unsignedLong", "unsignedShort": "unsignedInt", "unsignedByte": "unsignedShort",
            "positiveInteger": "nonNegativeInteger",
        };
    }

    static bool isDerived(XsdAbstractType derived, XsdAbstractType base) {
        XsdTypeDerivationHelper helper();
        return helper.check(derived, base);
    }

    # ID ancestry depends only on the resolved type graph, not on a type's borrowed namespace context.
    static bool isIdDerived(XsdAbstractType derived) {
        hash<string, bool> seen();
        *XsdAbstractType current = derived;
        while (current && !seen{current.uniqueHash()}) {
            seen{current.uniqueHash()} = True;
            if (current instanceof XsdBaseType) {
                return current.name == "ID";
            }
            if (!(current instanceof XsdSimpleType)) {
                return False;
            }
            current = cast<XsdSimpleType>(current).type;
        }
        return False;
    }

    private bool check(XsdAbstractType derived, XsdAbstractType base) {
        string key = derived.uniqueHash() + ":" + base.uniqueHash();
        if (!results.hasKey(key)) {
            # Simple dependency cycles are rejected before complex type finalization.
            results{key} = False;
            results{key} = checkIntern(derived, base);
        }
        return results{key};
    }

    private bool checkIntern(XsdAbstractType derived, XsdAbstractType base) {
        if (derived == base) {
            return True;
        }
        if (derived instanceof XsdBaseType && base instanceof XsdBaseType) {
            string current = derived.name;
            while (current != "anyType") {
                if (current == base.name) {
                    return True;
                }
                current = current == "anySimpleType" ? "anyType" : BuiltinParents{current} ?? "anySimpleType";
            }
            return False;
        }
        if (derived instanceof XsdSimpleType) {
            XsdSimpleType simple = cast<XsdSimpleType>(derived);
            if (simple.type && check(simple.type, base)) {
                return True;
            }
            if (base instanceof XsdBaseType && base.name == "anySimpleType") {
                return True;
            }
        }
        if (base instanceof XsdSimpleType) {
            # Restrictions of unions retain the union's member type definitions.
            XsdAbstractType current = base;
            while (current instanceof XsdSimpleType) {
                XsdSimpleType simple = cast<XsdSimpleType>(current);
                foreach XsdAbstractType member in (simple.unionTypes) {
                    if (check(derived, member)) {
                        return True;
                    }
                }
                if (!simple.type) {
                    break;
                }
                current = simple.type;
            }
        }
        return False;
    }
}

#! XSD complex type class
public class XsdComplexType inherits WSDL::XsdAbstractType {
    public {
        *XsdArrayType array;
        *string arrayType;
        *string restriction;
        *string extension;

        #! expanded complex-content base identity captured at its declaration
        /** @since %WSDL 0.5.8 */
        *hash<auto> baseTypeInfo;
        #! resolved complex-content base type
        /** @since %WSDL 0.5.8 */
        *XsdAbstractType baseType;

        bool usedocns;

        #! Resolved element fields in this complex type
        /** Unambiguous fields keep local names. Every field sharing a local name with another namespace
            uses its expanded \c {namespace-uri}local-name, including \c {}local-name for no namespace.
            Choice fields follow the same naming rule across the complete type.
            @since %WSDL 0.5.8
        */
        hash<string, XsdElement> elementmap();
        bool anyAttribute = False;

        bool nillable = False;
        bool required = False;
        bool requires_value = False;

        # attributes
        hash<string, XsdAttribute> attrs();

        # any annotated documentation
        *string documentation;

        # temporarily used to store type information to resolve simpleType
        *hash<auto> simpleTypeInfo;
        # simpleContent type
        XsdAbstractType simpleType;

        # finalization flag
        bool finalized = False;

        # multiple choice blocks
        list<hash<ChoiceInfo>> choices();

        #! the alternatives of a complexType that is itself a choice
        /** each alternative is a hash of the elements belonging to it; alternatives declared as nested model groups
            (ex: an \c xs:sequence inside an \c xs:choice) have more than one element

            @since %WSDL 0.5.8
        */
        list<hash<string, XsdElement>> alternatives();
    }

    private {
        #! type of complexType object
        string cx_type;
        bool finalizing = False;
        *hash<auto> simpleRestriction;
        *hash<auto> simpleRestrictionNamespaces;
        *XsdSimpleType inlineSimpleType;
        hash<string, bool> prohibited_attributes();
        bool mixed = False;
        bool content_emptiable = True;
        bool content_empty = True;
        bool has_element_wildcard = False;
        hash<XsdEmptiabilityInfo> emptiability();
        list<XsdElement> declared_elements();
        list<string> element_group_refs();
        hash<string, XsdElement> element_declarations();
        bool declarations_present = True;
        *hash<XsdAttributeWildcardInfo> local_attribute_wildcard;
        *hash<XsdAttributeWildcardInfo> attribute_wildcard;

        const XET_ALL      = "ALL";
        const XET_CHOICE   = "CHOICE";
        const XET_SEQUENCE = "SEQUENCE";
        const XET_SIMPLE   = "SIMPLE";
        const XET_NONE     = "NONE";
    }

    # ct can be NOTHING in case of an empty complex type
    constructor(*hash<auto> ct, Namespaces nsc, XsdLateResolverHelper unresolved, bool n_usedocns, *string desc_name)
            : XsdAbstractType(\ct, nsc, desc_name) {
        NamespacePrefixHelper declaration(nsc, ct."^attributes^");
        usedocns = n_usedocns;
        # Anonymous nested types also need group/base resolution and final field-name selection.
        on_success unresolved.add(self);
        mixed = XsdEmptiabilityHelper::getMixed(ct."^attributes^");
        content_empty = !mixed;
        #any a = ct."^attributes^";
        delete ct."^attributes^";

        *hash<auto> d = ct.complexContent;
        if (d) {
            NamespacePrefixHelper content_scope(nsc, d."^attributes^");
            mixed = XsdEmptiabilityHelper::getMixed(d."^attributes^", mixed);
            content_empty = !mixed;
            WSDL::XsdBase::removeNS(\d);
            if (d.hasKey("restriction")) {
                NamespacePrefixHelper restriction_scope(nsc, d.restriction."^attributes^");
                WSDL::XsdBase::removeNS(\d.restriction);

                *string base = d.restriction."^attributes^".base;
                if (!base) {
                    throw WSDL_ERROR, sprintf("complexType %Y restriction requires a base", name);
                }
                baseTypeInfo = nsc.getTypeHash(base);

                if (baseTypeInfo.val == "Array" && baseTypeInfo.uri == SOAP_ENCODING) {
                    *hash<auto> array_declaration = d.restriction.attribute."^attributes^";
                    auto aa = array_declaration;
                    WSDL::XsdBase::removeNSKeys(\aa);
                    if (!exists aa.arrayType) {
                        throw WSDL_ERROR, sprintf("cannot parse complexType restriction: %y", d.restriction);
                    }

                    delete d.restriction.attribute;

                    # issue #2899: check for an array element
                    if (d.restriction.sequence) {
                        auto seq = d.restriction.sequence;
                        NamespacePrefixHelper compositor(nsc, seq."^attributes^");
                        WSDL::XsdBase::removeNS(\seq);

                        auto sa = seq.element."^attributes^";
                        # according to https://access.redhat.com/documentation/en-US/Fuse_ESB/4.4.1/html/Writing_WSDL_Contracts/files/WSDLDefiningArrays.html
                        # if defining an element of an array, the element's maxOccurs attribute must be set to "unbounded"
                        if (sa.maxOccurs != "unbounded") {
                            throw WSDL_ERROR, sprintf("array elements must have maxOccurs = \"unbounded\"; array type %y has maxOccurs = %y",
                                aa.arrayType, sa.maxOccurs);
                        }
                        arrayType = aa.arrayType;

                        elementmap = parseElements(seq.element, unresolved, nsc);
                        cx_type = XET_SEQUENCE;
                    } else {
                        NamespacePrefixHelper attribute_scope(nsc, array_declaration);
                        array = new XsdArrayType(name, "", aa.arrayType, nsc, unresolved);
                    }

                    #printf("DEBUG: ans: %y atn: %y aa: %y\n", ans, atn, aa);
                    baseTypeInfo = NOTHING;
                    return;
                }
                restriction = baseTypeInfo.val;

                delete d.restriction."^attributes^";

                parseData(d.restriction, unresolved, nsc);
            } else if (d.hasKey("extension")) {
                NamespacePrefixHelper extension_scope(nsc, d.extension."^attributes^");
                *string ext_base = d.extension."^attributes^".base;
                if (!ext_base) {
                    throw WSDL_ERROR, sprintf("complexType %Y extension requires a base", name);
                }
                baseTypeInfo = nsc.getTypeHash(ext_base);
                extension = baseTypeInfo.val;
                delete d.extension."^attributes^";
                WSDL::XsdBase::removeNS(\d.extension);

                parseData(d.extension, unresolved, nsc);
            } else {
                throw "XSD-COMPLEXCONTENT-ERROR", sprintf("can't parse complexContent %y %y information", getName(), d.firstKey());
            }
        } else if (ct.hasKey("simpleContent")) {
            d = ct.simpleContent;
            NamespacePrefixHelper content_scope(nsc, d."^attributes^");
            WSDL::XsdBase::removeNS(\d);
            cx_type = XET_SIMPLE;
            required = True;
            requires_value = True;
            if (!d || (d.hasKey("extension") == d.hasKey("restriction"))) {
                throw WSDL_ERROR, sprintf("simpleContent type %Y requires exactly one extension or restriction", name);
            }
            bool extending = d.hasKey("extension");
            *hash<auto> body = d{extending ? "extension" : "restriction"};
            NamespacePrefixHelper derivation_scope(nsc, body."^attributes^");
            *string base = body."^attributes^".base;
            if (!base) {
                throw WSDL_ERROR, sprintf("simpleContent type %Y requires a base", name);
            }
            simpleTypeInfo = baseTypeInfo = nsc.getTypeHash(base);
            if (extending) {
                extension = baseTypeInfo.val;
            } else {
                restriction = baseTypeInfo.val;
            }
            remove body."^attributes^";
            WSDL::XsdBase::removeNS(\body);
            parseAttributes(\body, unresolved, nsc);
            remove body.annotation;
            remove body.ns;
            if (extending) {
                if (body) {
                    throw WSDL_ERROR, sprintf("unexpected simpleContent extension children %Y", keys body);
                }
            } else {
                if (body.hasKey("simpleType")) {
                    inlineSimpleType = new XsdSimpleType(remove body.simpleType, nsc, unresolved, usedocns,
                        sprintf("simpleType in restriction of %Y", name));
                }
                simpleRestriction = {"restriction": body};
                simpleRestrictionNamespaces = {"xmlns": nsc.getDefaultNs() ?? "",
                    "targetNamespace": nsc.getTargetNamespaceUri()};
                hash<string, string> input_prefixes = nsc.getInputNamespaceState().input;
                foreach string prefix in (keys input_prefixes) {
                    simpleRestrictionNamespaces{"xmlns:" + prefix} = input_prefixes{prefix};
                }
            }

        } else if (ct) {
            parseData(ct, unresolved, nsc);
        } else {
            # empty complex type
            cx_type = XET_NONE;
            required = True;
            requires_value = False;
        }
    }

    *list<auto> getAllowedValues() {
        if (simpleType) {
            return simpleType.getAllowedValues();
        }
    }

    #! returns finite choices for the complete provider value
    /** @return NOTHING for structured simple content, whose choices belong to its scalar field;
        otherwise the existing scalar choices
    */
    *list<auto> getDataProviderAllowedValues() {
        return simpleType && attrs ? NOTHING : getAllowedValues();
    }

    finalize(hash<string, XsdAbstractType> tmap, Namespaces nsc, *hash<string, XsdGroup> groupMap,
            *hash<string, XsdAttributeGroup> attrGroupMap, *XsdLateResolverHelper unresolved) {
        if (finalized) {
            return;
        }
        if (finalizing) {
            throw WSDL_ERROR, sprintf("cyclic complex type derivation involving %Y", name);
        }
        finalizing = True;
        on_exit finalizing = False;
        on_success finalized = True;
        hash<string, XsdAttribute> original_attributes = attrs;
        on_error attrs = original_attributes;
        bool original_mixed = mixed;
        bool original_empty = content_empty;
        on_error {
            mixed = original_mixed;
            content_empty = original_empty;
        }
        content_emptiable = XsdEmptiabilityHelper::evaluate(emptiability, groupMap ?? {});

        # Check identities before field merges or group occurrence updates can mutate components.
        hash<string, XsdElement> declarations();
        XsdElementConsistencyHelper::merge(\declarations, declared_elements);
        foreach string key in (element_group_refs) {
            *XsdGroup group = groupMap{key};
            if (!group) {
                throw WSDL_ERROR, sprintf("undefined group reference %Y", key);
            }
            group.resolveNestedGroups(groupMap);
            XsdElementConsistencyHelper::merge(\declarations, (map $1, group.getElementDeclarations().iterator()));
        }

        list<hash<XsdAttributeWildcardInfo>> group_wildcards();
        # Resolve local attribute-group uses before combining the derived declaration with its base.
        if (unresolved) {
            *list<string> attrGroupRefs = unresolved.getAttrGroupRefs(self);
            list<hash<string, XsdAttribute>> group_attributes();
            foreach string key in (attrGroupRefs) {
                *XsdAttributeGroup attrGrp = attrGroupMap{key};
                if (!attrGrp) {
                    throw WSDL_ERROR, sprintf("undefined attributeGroup reference %Y", key);
                }
                attrGrp.resolveNestedGroups(attrGroupMap, nsc);
                group_attributes += (attrGrp.getAttributes(),);
                *hash<XsdAttributeWildcardInfo> wildcard = attrGrp.getAttributeWildcard();
                if (exists wildcard) {
                    group_wildcards += wildcard;
                }
            }
            attrs = XsdAttribute::mergeMaps(attrs, group_attributes);
        }

        validateIdAttributeUses(attrs);
        *hash<XsdAttributeWildcardInfo> wildcard = XsdAttributeWildcardHelper::complete(local_attribute_wildcard,
            group_wildcards);
        if (baseTypeInfo) {
            XsdAbstractType resolved_base = baseTypeInfo.uri == XSD_NS ? nsc.getBaseType(baseTypeInfo.val)
                : tmap_get(tmap, type_qname(baseTypeInfo.uri, baseTypeInfo.val));
            if (cx_type == XET_SIMPLE) {
                XsdAbstractType content_type;
                if (resolved_base instanceof XsdComplexType) {
                    XsdComplexType base = cast<XsdComplexType>(resolved_base);
                    base.finalize(tmap, nsc, groupMap, attrGroupMap, unresolved);
                    wildcard = XsdAttributeWildcardHelper::derive(wildcard, base.attribute_wildcard, boolean(restriction));
                    if (base.cx_type == XET_SIMPLE) {
                        content_type = inlineSimpleType ?? base.simpleType;
                        if (restriction && !XsdTypeDerivationHelper::isDerived(content_type, base.simpleType)) {
                            throw WSDL_ERROR, sprintf("simpleContent type %Y does not restrict base content type %Y",
                                name, base.simpleType.name);
                        }
                    } else if (restriction && inlineSimpleType && base.mixed && base.content_emptiable) {
                        content_type = inlineSimpleType;
                    } else {
                        throw WSDL_ERROR, sprintf("simpleContent type %Y requires a simple-content base or a "
                            "restriction of a mixed emptiable base with an inline simpleType", name);
                    }
                    attrs = mergeInheritedAttributeUses(base);
                } else if (restriction && inlineSimpleType && resolved_base instanceof XsdBaseType
                        && resolved_base.name == "anyType") {
                    # The ur-type has mixed, emptiable content; an explicit simpleType supplies the restriction.
                    content_type = inlineSimpleType;
                    wildcard = XsdAttributeWildcardHelper::derive(wildcard, XsdAttributeWildcardHelper::urType(), True, True);
                } else if (extension && (resolved_base instanceof XsdSimpleType
                        || (resolved_base instanceof XsdBaseType && resolved_base.name != "anyType"))) {
                    content_type = resolved_base;
                } else {
                    throw WSDL_ERROR, sprintf("invalid base %Y for simpleContent type %Y", resolved_base.name, name);
                }
                if (restriction && simpleRestriction.restriction) {
                    NamespacePrefixHelper restriction_scope(nsc, simpleRestrictionNamespaces);
                    simpleType = new XsdSimpleType(simpleRestriction, nsc, unresolved ?? new XsdLateResolverHelper(),
                        usedocns, sprintf("simple content of %Y", name), content_type);
                } else {
                    simpleType = content_type;
                }
            } else if (resolved_base instanceof XsdComplexType) {
                XsdComplexType base = cast<XsdComplexType>(resolved_base);
                base.finalize(tmap, nsc, groupMap, attrGroupMap, unresolved);
                wildcard = XsdAttributeWildcardHelper::derive(wildcard, base.attribute_wildcard, boolean(restriction));
                if (extension) {
                    XsdElementConsistencyHelper::merge(\declarations, (map $1, base.element_declarations.iterator()));
                }
                attrs = mergeInheritedAttributeUses(base);
                if (extension) {
                    content_emptiable = content_emptiable && base.content_emptiable;
                    if (content_empty) {
                        mixed = base.mixed;
                        content_empty = base.content_empty;
                    }
                    elementmap = XsdElementFieldHelper::getExpandedMap(base.elementmap) + elementmap;
                    choices = base.choices + choices;
                    if (cx_type == XET_NONE || !cx_type) {
                        cx_type = base.cx_type;
                        alternatives = base.alternatives;
                    }
                    required = required || base.required;
                    requires_value = requires_value || base.requires_value;
                }
            } else if (!(resolved_base instanceof XsdBaseType) || resolved_base.name != "anyType") {
                throw WSDL_ERROR, sprintf("complexContent type %Y requires a complex base, got %Y", name,
                    resolved_base.name);
            } else {
                wildcard = XsdAttributeWildcardHelper::derive(wildcard, XsdAttributeWildcardHelper::urType(),
                    boolean(restriction), True);
                if (extension && content_empty) {
                    # An empty extension inherits the ur-type's mixed, emptiable wildcard particle.
                    mixed = True;
                    content_empty = False;
                }
            }
            # Publish the link only after validation; failed cycles must not retain cyclic base links.
            baseType = resolved_base;
        }

        # Resolve captured expanded group identities; missing definitions are construction errors.
        if (unresolved) {
            *list<hash<GroupRefInfo>> groupRefList = unresolved.getGroupRefs(self);
            foreach hash<GroupRefInfo> groupRefInfo in (groupRefList) {
                *XsdGroup grp = groupMap{groupRefInfo.ref};
                if (!grp) {
                    throw WSDL_ERROR, sprintf("undefined group reference %Y", groupRefInfo.ref);
                }
                grp.resolveNestedGroups(groupMap);
                if (grp) {
                    # Merge group elements into this complex type's element map
                    # Apply group-level occurrence constraints to elements
                    hash<string, XsdElement> groupElements = grp.getElements();
                    if (groupRefInfo.minOccurs == 0) {
                        # If the group ref has minOccurs=0, make all elements optional
                        foreach string elemName in (keys groupElements) {
                            XsdElement elem = groupElements{elemName};
                            # Only make optional if not already optional
                            if (elem.minOccurs > 0) {
                                elem.minOccurs = 0;
                            }
                        }
                    }
                    if (groupRefInfo.maxOccurs == -1 || groupRefInfo.maxOccurs > 1) {
                        # If the group ref allows multiple occurrences, set maxOccurs on elements
                        foreach string elemName in (keys groupElements) {
                            XsdElement elem = groupElements{elemName};
                            if (groupRefInfo.maxOccurs == -1) {
                                elem.maxOccurs = -1;
                            } else if (elem.maxOccurs != -1) {
                                elem.maxOccurs = max(elem.maxOccurs, groupRefInfo.maxOccurs);
                            }
                        }
                    }
                    elementmap += XsdElementFieldHelper::getExpandedMap(groupElements);
                }
            }
        }
        element_declarations = declarations;
        finalizeElementFields();
        attribute_wildcard = wildcard;
    }

    private finalizeElementFields() {
        list<hash<string, XsdElement>> maps = (elementmap,);
        foreach hash<ChoiceInfo> choice in (choices) {
            maps += (choice.elementmap,);
        }
        hash<string, string> fields = XsdElementFieldHelper::getFieldNames(maps);
        elementmap = XsdElementFieldHelper::getFieldMap(elementmap, fields);
        alternatives = map XsdElementFieldHelper::getFieldMap($1, fields), alternatives;
        for (int i = 0; i < choices.size(); ++i) {
            choices[i].elementmap = XsdElementFieldHelper::getFieldMap(choices[i].elementmap, fields);
            choices[i].alternatives = map XsdElementFieldHelper::getFieldMap($1, fields), choices[i].alternatives;
        }
    }

    private validateIdAttributeUses(hash<string, XsdAttribute> uses) {
        *string first;
        foreach XsdAttribute attribute in (uses.iterator()) {
            if (XsdTypeDerivationHelper::isIdDerived(attribute.type)) {
                if (exists first) {
                    throw WSDL_ERROR, sprintf("type %Y has multiple ID attribute uses: %Y and %Y", name, first, attribute.name);
                }
                first = attribute.name;
            }
        }
    }

    private hash<string, XsdAttribute> mergeInheritedAttributeUses(XsdComplexType base) {
        hash<string, XsdAttribute> merged = XsdAttribute::mergeMaps(getInheritedAttributes(base), attrs, boolean(restriction));
        validateIdAttributeUses(merged);
        return merged;
    }

    private hash<string, XsdAttribute> getInheritedAttributes(XsdComplexType base) {
        hash<string, XsdAttribute> inherited = base.attrs;
        if (restriction) {
            hash<string, XsdAttribute> own_attributes();
            foreach XsdAttribute attr in (attrs.iterator()) {
                own_attributes{type_qname(attr.namespaceUri, attr.name)} = attr;
            }
            hash<string, bool> inherited_identities();
            foreach XsdAttribute attr in (inherited.iterator()) {
                inherited_identities{type_qname(attr.namespaceUri, attr.name)} = True;
            }
            foreach string identity in (keys own_attributes) {
                if (!inherited_identities{identity}
                        && !XsdAttributeWildcardHelper::allows(base.attribute_wildcard, own_attributes{identity}.namespaceUri)) {
                    throw WSDL_ERROR, sprintf("type %Y cannot introduce attribute %Y outside its base attribute wildcard",
                        name, identity);
                }
            }
            foreach string key in (keys inherited) {
                XsdAttribute attr = inherited{key};
                string identity = type_qname(attr.namespaceUri, attr.name);
                *XsdAttribute own = own_attributes{identity};
                if (own) {
                    if (attr.use == "required" && own.use != "required") {
                        throw WSDL_ERROR, sprintf("type %Y cannot make required base attribute %Y optional", name,
                            identity);
                    }
                    if (!XsdTypeDerivationHelper::isDerived(own.type, attr.type)) {
                        throw WSDL_ERROR, sprintf("type %Y attribute %Y type %Y does not restrict base type %Y",
                            name, identity, own.type.name, attr.type.name);
                    }
                    if (exists attr.fixedLexical && (!exists own.fixedLexical
                            || !XsdScalarValueHelper::equal(attr.type, own.getDefaultValue(), attr.getDefaultValue()))) {
                        throw WSDL_ERROR, sprintf("type %Y attribute %Y must preserve its base fixed constraint",
                            name, identity);
                    }
                }
                if (prohibited_attributes{identity}) {
                    if (attr.use == "required" && (!own || own.use != "required")) {
                        throw WSDL_ERROR, sprintf("type %Y cannot prohibit required base attribute %Y", name, attr.name);
                    }
                    remove inherited{key};
                }
            }
        }
        return inherited;
    }

    #! returns the resolved attribute wildcard for this type
    /** @return the constructed wildcard metadata, or NOTHING if no wildcard is present
        @note Metadata is available after schema construction; native value shapes are unchanged.
        @since %WSDL 0.5.8
    */
    *hash<XsdAttributeWildcardInfo> getAttributeWildcard() {
        return attribute_wildcard;
    }

    #! throws an exception if the types are not compatible
    checkExtends(XsdAbstractType t, string ename) {
        if (extension == t.name || t == self)
            return;
        throw SOAP_SERIALIZATION_ERROR, sprintf("explicit type %y given for element %y, type %y, however the types "
            "are not compatible%s", name, ename, t.name,
            extension ? sprintf("; %y extends %y", name, extension) : "");
    }

    private parseData(hash<auto> d, XsdLateResolverHelper unresolved, Namespaces nsc) {
        emptiability = XsdEmptiabilityHelper::parse(d, nsc);
        content_empty = XsdEmptiabilityHelper::hasEmptyContent(d, mixed);
        delete d.ns;
        if (d.annotation) {
            *hash<auto> ah = remove d.annotation;
            if (ah.size() == 1 && ah.firstKey() =~ /documentation$/)
                documentation = trim(ah.firstValue());
        }
        if (!d) {
            cx_type = XET_NONE;
            required = True;
            requires_value = False;
            return;
        }

        parseAttributes(\d, unresolved, nsc);

        if (!d) {
            cx_type = XET_NONE;
            required = True;
            requires_value = False;
            return;
        }

        if (d.size() > 1)
            throw WSDL_ERROR, sprintf("%s: expecting a single element in the complexType hash, got: %y", name,
                d.keys());

        string k = d.firstKey();
        if (k == "all") {
            cx_type = XET_ALL;
            # issue #5410: model groups can be nested
            parseModelGroup(d.all, unresolved, nsc, False);
            setGroupFlags();
        } else if (k == "choice") {
            cx_type = XET_CHOICE;
            # issue #5410: an alternative in a choice can be a nested model group with more than one element
            alternatives = getChoiceAlternatives(d.choice, unresolved, nsc);
            map elementmap += $1, alternatives;
            foreach XsdElement elem in (elementmap.iterator()) {
                if (elem.isRequired()) {
                    required = True;
                    break;
                }
            }
            setGroupFlags();
            # the element declarations only say whether a member requires a value if the choice is serialized at
            # all; whether the choice itself must be present is given by the "minOccurs" attribute of the choice
            if (exists d.choice."^attributes^".minOccurs && !d.choice."^attributes^".minOccurs.toInt()) {
                required = requires_value = False;
            }
        } else if (k == "sequence") {
            cx_type = XET_SEQUENCE;
            # issue #5410: model groups can be nested
            parseModelGroup(d.sequence, unresolved, nsc, False);
            setGroupFlags();
        } else if (k == "group") {
            # Handle top-level group reference
            cx_type = XET_SEQUENCE;  # Groups typically expand to sequences
            parseGroupReferences(\d, unresolved, nsc);
        } else {
            throw "XSD-COMPLEXTYPE-ERROR", sprintf("unknown keys in %y", d);
        }
    }

    #! parses a \c sequence or \c all model group, including any nested model groups
    /** @param mg the model group to parse
        @param unresolved the container for types that must be resolved after parsing
        @param nsc the namespace container
        @param optional if the model group itself is optional, in which case none of its members can be required

        Elements declared in nested model groups belong to the enclosing model group, so they are added to the
        element map of this complexType; \c choice blocks are added to the choice collection, and \c group references are
        registered for resolution in finalize().

        @note the XML parser does not preserve the relative order of elements with different names, therefore the
        keys of the model group are processed in the order in which they first appear in the schema

        @since %WSDL 0.5.8
    */
    private parseModelGroup(*hash<auto> mg, XsdLateResolverHelper unresolved, Namespaces nsc, bool optional) {
        bool previous_present = declarations_present;
        on_exit declarations_present = previous_present;
        declarations_present = declarations_present && !XsdElementConsistencyHelper::isAbsent(mg);
        # an empty model group (ex: "<xs:sequence/>") is parsed as NOTHING
        if (!mg) {
            return;
        }
        NamespacePrefixHelper compositor(nsc, mg."^attributes^");
        WSDL::XsdBase::removeNS(\mg);
        foreach string k in (keys mg) {
            switch (k) {
                case "element": {
                    elementmap += parseElements(mg.element, unresolved, nsc, True, optional);
                    break;
                }

                case "choice": {
                    foreach hash<auto> ch in (mg.choice) {
                        addChoiceBlock(ch, unresolved, nsc, optional);
                    }
                    break;
                }

                case "sequence":
                case "all": {
                    foreach hash<auto> nested in (mg{k}) {
                        parseModelGroup(nested, unresolved, nsc,
                            optional || XsdComplexType::isOptionalGroup(nested));
                    }
                    break;
                }

                case "group": {
                    parseGroupReferences(\mg, unresolved, nsc);
                    break;
                }

                case "any": {
                    foreach auto wildcard in (mg.any.typeCode() == NT_LIST ? mg.any : (mg.any,)) {
                        if (declarations_present && !XsdElementConsistencyHelper::isAbsent(wildcard)) {
                            has_element_wildcard = True;
                        }
                    }
                    anyAttribute = True;
                    break;
                }
            }
        }
    }

    #! adds a \c choice block declared in a model group to the choice collection
    /** @since %WSDL 0.5.8
    */
    private addChoiceBlock(*hash<auto> ch, XsdLateResolverHelper unresolved, Namespaces nsc, bool optional) {
        list<hash<string, XsdElement>> alts = getChoiceAlternatives(ch, unresolved, nsc);
        hash<string, XsdElement> h();
        map h += $1, alts;
        if (h) {
            choices += <ChoiceInfo>{
                "elementmap": h,
                "required": !optional && ch."^attributes^".minOccurs > 0,
                "alternatives": alts,
            };
        }
    }

    #! returns the alternatives of a \c choice model group
    /** Each direct \c element child is an alternative on its own; each nested model group is a single alternative
        made up of all the elements declared in it.

        @note elements contributed by a \c group reference are merged into the element map in finalize() and
        therefore do not belong to any single alternative

        @since %WSDL 0.5.8
    */
    private list<hash<string, XsdElement>> getChoiceAlternatives(*hash<auto> ch, XsdLateResolverHelper unresolved,
            Namespaces nsc) {
        bool previous_present = declarations_present;
        on_exit declarations_present = previous_present;
        declarations_present = declarations_present && !XsdElementConsistencyHelper::isAbsent(ch);
        list<hash<string, XsdElement>> rv();
        # an empty choice (ex: "<xs:choice/>") is parsed as NOTHING
        if (!ch) {
            return rv;
        }
        NamespacePrefixHelper compositor(nsc, ch."^attributes^");
        WSDL::XsdBase::removeNS(\ch);
        foreach string k in (keys ch) {
            switch (k) {
                case "element": {
                    if (!ch.element) {
                        throw WSDL_ERROR, "element declaration requires name or ref";
                    }
                    foreach auto e in (ch.element) {
                        rv += parseElements(e, unresolved, nsc, False);
                    }
                    break;
                }

                case "sequence":
                case "all":
                case "choice": {
                    foreach hash<auto> nested in (ch{k}) {
                        hash<string, XsdElement> h = flattenModelGroup(nested, unresolved, nsc);
                        if (h) {
                            rv += h;
                        }
                    }
                    break;
                }

                case "group": {
                    parseGroupReferences(\ch, unresolved, nsc);
                    break;
                }
            }
        }
        return rv;
    }

    #! identifies a list-valued simple-content type
    /** @return True when one simple-content value is represented by a native list */
    bool hasNativeListValue() {
        return simpleType ? simpleType.hasNativeListValue() : False;
    }

    #! returns all elements declared in a model group, including any nested model groups
    /** @since %WSDL 0.5.8
    */
    private hash<string, XsdElement> flattenModelGroup(*hash<auto> mg, XsdLateResolverHelper unresolved,
            Namespaces nsc) {
        bool previous_present = declarations_present;
        on_exit declarations_present = previous_present;
        declarations_present = declarations_present && !XsdElementConsistencyHelper::isAbsent(mg);
        hash<string, XsdElement> rv();
        # an empty model group (ex: "<xs:sequence/>") is parsed as NOTHING
        if (!mg) {
            return rv;
        }
        NamespacePrefixHelper compositor(nsc, mg."^attributes^");
        WSDL::XsdBase::removeNS(\mg);
        foreach string k in (keys mg) {
            switch (k) {
                case "element": {
                    rv += parseElements(mg.element, unresolved, nsc, False);
                    break;
                }

                case "sequence":
                case "all":
                case "choice": {
                    foreach hash<auto> nested in (mg{k}) {
                        rv += flattenModelGroup(nested, unresolved, nsc);
                    }
                    break;
                }

                case "group": {
                    parseGroupReferences(\mg, unresolved, nsc);
                    break;
                }
            }
        }
        return rv;
    }

    #! returns @ref True if the model group is declared with \c minOccurs="0"
    /** @since %WSDL 0.5.8
    */
    private static bool isOptionalGroup(*hash<auto> mg) {
        return exists mg."^attributes^".minOccurs && !mg."^attributes^".minOccurs.toInt();
    }

    #! sets the "nillable" and "requires_value" flags after the model group has been parsed
    /** @since %WSDL 0.5.8
    */
    private setGroupFlags() {
        if (elementmap.size() == 1 && elementmap.firstValue().isNillable()) {
            nillable = True;
        }
        if (required && !nillable) {
            requires_value = True;
        }
    }

    #! Parse group references within a content model element
    /** Group references are stored and resolved during the finalize() phase,
        where the group's elements are merged into this complex type's element map.
        minOccurs/maxOccurs on the group ref are captured and applied to elements.
    */
    private parseGroupReferences(reference<hash<auto>> content, XsdLateResolverHelper unresolved, Namespaces nsc) {
        if (content.hasKey("group") && !content.group) {
            throw WSDL_ERROR, "group reference requires ref";
        }
        foreach hash<auto> g in (content.group) {
            *hash<auto> attrs = g."^attributes^";
            *string groupRef = attrs.ref;
            if (!groupRef) {
                throw WSDL_ERROR, "group reference requires ref";
            }
            NamespacePrefixHelper reference_scope(nsc, attrs);
            hash<auto> identity = nsc.getTypeHash(groupRef ?? "");
            if (groupRef) {
                # Parse occurrence constraints (defaults: minOccurs=1, maxOccurs=1)
                int minOccurs = exists attrs.minOccurs ? int(attrs.minOccurs) : 1;
                int maxOccurs;
                if (attrs.maxOccurs == "unbounded") {
                    maxOccurs = -1;
                } else if (exists attrs.maxOccurs) {
                    maxOccurs = int(attrs.maxOccurs);
                } else {
                    maxOccurs = 1;
                }
                # Store group reference with occurrence info for resolution during finalization
                unresolved.addGroupRef(self, type_qname(identity.uri, identity.val), minOccurs, maxOccurs);
                if (declarations_present && !XsdElementConsistencyHelper::isAbsent(g)) {
                    element_group_refs += type_qname(identity.uri, identity.val);
                }
            }
        }
        delete content.group;
    }

    private parseAttributes(reference d, XsdLateResolverHelper unresolved, Namespaces nsc) {
        # process attributes if any
        if (d.hasKey("attribute") && !d.attribute) {
            throw WSDL_ERROR, "attribute declaration requires a name or reference";
        }
        foreach auto ah in (remove d.attribute) {
            if (ah.typeCode() != NT_HASH) {
                throw WSDL_ERROR, "attribute declaration requires a name or reference";
            }
            XsdAttribute attr(ah, nsc, NOTHING, unresolved);
            string identity = type_qname(attr.namespaceUri, attr.name);
            if (attr.use == "prohibited") {
                # Prohibitions remove inherited uses in a restriction, but contribute no new component.
                prohibited_attributes{identity} = True;
                continue;
            }
            if (attrs.hasKey(identity)) {
                throw WSDL_ERROR, sprintf("duplicate attribute use %Y", identity);
            }
            attrs{identity} = attr;
        }
        attrs = XsdAttribute::mergeMaps(new hash<string, XsdAttribute>(), attrs);

        # Attribute-group references retain the namespace of the referring declaration.
        if (d.hasKey("attributeGroup") && !d.attributeGroup) {
            throw WSDL_ERROR, "attributeGroup reference requires ref";
        }
        foreach hash<auto> ag in (remove d.attributeGroup) {
            if (!ag."^attributes^".ref) {
                throw WSDL_ERROR, "attributeGroup reference requires ref";
            }
            NamespacePrefixHelper reference_scope(nsc, ag."^attributes^");
            hash<auto> identity = nsc.getTypeHash(ag."^attributes^".ref ?? "");
            unresolved.addAttrGroupRef(self, type_qname(identity.uri, identity.val));
        }

        if (d.hasKey("anyAttribute")) {
            local_attribute_wildcard = XsdAttributeWildcardHelper::parse(d.anyAttribute, nsc.getTargetNamespaceUri());
            anyAttribute = True;
            delete d.anyAttribute;
        }
    }

    #! returns @ref True "True" if the complexType is a choice, in which case only one element may be serialized
    /** @since %WSDL 0.5.8
    */
    bool isChoice() {
        return cx_type == XET_CHOICE;
    }

    bool isNillable() {
        return nillable;
    }

    bool isRequired() {
        return required;
    }

    bool requiresValue() {
        return requires_value;
    }

    #! returns whether the currently parsed content has an explicit element wildcard
    /** @return True for an element wildcard in the parsed sequence/all content
        @note Attribute wildcards do not make this true. Group particle expansion and wildcard runtime
        constraints are handled separately from unwrapped message argument selection.
        @since %WSDL 0.5.8
    */
    bool hasElementWildcard() {
        return has_element_wildcard;
    }

    #! returns whether this type has no parsed element, choice, simple-content or element-wildcard slot
    /** @return True for an empty parsed content model; attributes do not count as content
        @note This query does not replace full ordered-particle or mixed-content validation.
    */
    bool isEmpty() {
        return !elementmap && !choices && !simpleType && !has_element_wildcard;
    }

    private hash<string, XsdElement> parseElements(softlist<auto> el, XsdLateResolverHelper unresolved,
            Namespaces nsc, bool for_object = True, bool optional = False) {
        #printf("DEBUG: XsdComplexType::parseElements(%y)\n", el);
        hash<string, XsdElement> h();
        if (!el) {
            throw WSDL_ERROR, "element declaration requires name or ref";
        }
        foreach auto e in (el) {
            if (e.typeCode() != NT_HASH) {
                throw WSDL_ERROR, "element declaration requires name or ref";
            }
            XsdElement elem(e, nsc, NOTHING, unresolved, usedocns);
            if (declarations_present && !XsdElementConsistencyHelper::isAbsent(e)) {
                declared_elements += elem;
            }
            h{elem.getExpandedName()} = elem;

            # issue #5410: elements declared in an optional model group can never be required
            if (for_object && !optional && !required && elem.isRequired()) {
                required = True;
            }
        }

        return h;
    }

    AbstractDataProviderType getDataProviderType() {
        AbstractDataProviderType rv = getDataProviderTypeIntern();
        return nillable || (!required && !hasRequiredAttributes())
            ? rv.getOrNothingType()
            : rv;
    }

    private bool hasRequiredAttributes() {
        foreach XsdAttribute attr in (attrs.iterator()) {
            if (attr.use == "required") {
                return True;
            }
        }
        return False;
    }

    #! adds the existing public attribute hash to a complex content provider type
    private HashDataType addAttributeFields(HashDataType rv) {
        if (!attrs) {
            return rv;
        }
        HashDataType attributes(name + " attributes");
        *hash<auto> defaults;
        foreach string key in (keys attrs) {
            XsdAttribute attr = attrs{key};
            bool mandatory = attr.use == "required";
            AbstractDataProviderType attr_type = attr.type.getDataProviderType();
            hash<auto> info = {
                "name": key,
                "display_name": key,
                "short_desc": mandatory ? "Required XML attribute" : "Optional XML attribute",
                "desc": sprintf("%s XML attribute `%s`", mandatory ? "Required" : "Optional",
                    make_qname(attr.namespaceUri, attr.name)),
                "type": new XsdAttributeDataType(attr_type, mandatory),
            };
            *list<auto> allowed = exists attr.fixedLexical ? (attr.getDefaultValue(),)
                : attr.type.getAllowedValues();
            if (exists allowed) {
                info.allowed_values = map ("value": $1, "display_name": XsdDataFieldHelper::display($1)), allowed;
            }
            if (attr.hasValueConstraint()) {
                info.example_value = attr.getDefaultValue();
                if (!mandatory) {
                    info.default_value = attr.getDefaultValue();
                    defaults{key} = attr.getDefaultValue();
                }
            }
            attributes.addField(XsdDataFieldHelper::create(attr.type, info));
        }
        if (anyAttribute) {
            attributes.setDefaultOtherFieldType(AbstractDataProviderType::get(AbstractDataProviderType::anyType));
        }
        bool mandatory = hasRequiredAttributes();
        rv.addField(new QoreDataField({
            "name": "^attributes^",
            "display_name": "XML attributes",
            "short_desc": "XML attribute values",
            "desc": "XML attribute values keyed by local name, or expanded name when local names collide",
            "type": mandatory ? attributes : attributes.getOrNothingType(),
            "default_value": mandatory ? NOTHING : defaults,
        }));
        return rv;
    }

    private AbstractDataProviderType getDataProviderTypeIntern() {
        if (array) {
            return array.getDataProviderType();
        }
        switch (cx_type) {
            case XET_SIMPLE:
                if (attrs) {
                    QoreDataField value_field = XsdDataFieldHelper::create(simpleType, {
                        "name": "^value^",
                        "display_name": "Value",
                        "short_desc": "Simple content value",
                        "desc": "The element's scalar value; XML attributes are supplied separately",
                        "type": simpleType.getDataProviderType(),
                        "allowed_values": map ("value": $1, "display_name": XsdDataFieldHelper::display($1)), simpleType.getAllowedValues(),
                    });
                    HashDataType structured_type(name);
                    structured_type.addField(value_field);
                    return new XsdSimpleContentDataType(name, value_field, addAttributeFields(structured_type),
                        !hasRequiredAttributes());
                }
                return simpleType.getDataProviderType();

            case XET_SEQUENCE:
            case XET_ALL: {
                HashDataType rv(name);
                map rv.addField(XsdDataFieldHelper::create($1.value, {"name": $1.key,
                    "type": $1.value.getDataProviderType(), "allowed_values": $1.value.getDataProviderAllowedValues()})),
                    elementmap.pairIterator();
                # issue #5410: elements declared in a choice block in the model group must be included as well; at
                # most one alternative of a choice can be present, therefore all its members must be optional
                foreach hash<ChoiceInfo> ch in (choices) {
                    map rv.addField(XsdDataFieldHelper::create($1.value, {"name": $1.key,
                        "type": $1.value.getDataProviderType().getOrNothingType(),
                        "allowed_values": $1.value.getDataProviderAllowedValues()})),
                        ch.elementmap.pairIterator();
                }
                return addAttributeFields(rv);
            }

            case XET_CHOICE: {
                HashDataType rv(name);
                # at most one member of a choice may be present, therefore all members must be optional
                map rv.addField(XsdDataFieldHelper::create($1.value, {"name": $1.key,
                    "type": $1.value.getDataProviderType().getOrNothingType(),
                    "allowed_values": $1.value.getDataProviderAllowedValues()})), elementmap.pairIterator();
                return addAttributeFields(rv);
            }

            case XET_NONE:
                if (attrs) {
                    return addAttributeFields(new HashDataType(name));
                }
                return AbstractDataProviderType::get(AbstractDataProviderType::nothingType);
        }

        # complexTypes with no recognized content model accept any value
        return AbstractDataProviderType::get(AbstractDataProviderType::anyType);
    }

    private *hash<auto> serializeElement(Namespaces nsc, string key, XsdElement element, auto h, *softbool omitType) {
        auto v = h{key};
        string e_ons;
        #printf("DEBUG: XsdComplexType::serializeElement() key: %y v: %y h: %y ns: %y\n", key, v, h, nsc.getTargetNamespaceUri());
        auto e = element.serializeValue(nsc, v, omitType, key, name);

        if (!exists e && !element.isRequired())
            return;

        /*
        if (e_ons != ons && e_ons != "xsd") {
            if (e.typeCode() != NT_HASH)
                e = ("^value^": e);
            e."^attributes^" = ("xmlns": nsc.getOutputNamespaceUri(ons));
        }
        */

        hash<auto> rv.(!element.usedocns || !element.ns ? element.name
            : (nsc.getOutputNamespacePrefix(element.ns) + ":" + element.name)) = e;
        return rv;
    }

    *hash<auto> serializeValue(Namespaces nsc, auto h, *softbool omitType) {
        if (array) {
            return array.serializeValue(nsc, h, omitType);
        }

        # process attributes first
        *hash<auto> ah;
        hash<auto> rh;
        if (h.typeCode() == NT_HASH) {
            if (h."^attributes^") {
                hash<auto> mah = remove h."^attributes^";
                foreach string k in (keys mah) {
                    if (!attrs{k}) {
                        throw SOAP_SERIALIZATION_ERROR, sprintf("cannot set unknown attribute %y of element %y; known "
                            "attributes: %y", k, getName(), attrs.keys());
                    }
                    if (attrs{k}.use == "prohibited") {
                        throw SOAP_SERIALIZATION_ERROR, sprintf("cannot set attribute %y of element %y; the WSDL "
                            "marks this attribute as prohibited", k, getName());
                    }
                    # attribute values must be serialized according to their type like element values; a missing
                    # value is left untouched so that the check for required attributes below still catches it
                    ah{attrs{k}.getXmlName(nsc)} = exists mah{k} ? attrs{k}.serializeAttributeValue(nsc, mah{k}) : mah{k};
                }
            }
            foreach string k in (keys h) {
                if (k =~ /^\^comment/) {
                    rh{k} = remove h{k};
                }
            }
        }

        foreach XsdAttribute attr in (attrs.iterator()) {
            string wire_name = attr.getXmlName(nsc);
            if (attr.use == "required" && !exists ah{wire_name}) {
                throw SOAP_SERIALIZATION_ERROR, sprintf("cannot serialize element %Y without required attribute %Y",
                    getName(), attr.name);
            }
            if (attr.use == "optional" && !exists ah{wire_name} && attr.hasValueConstraint()) {
                ah{wire_name} = attr.serializeAttributeValue(nsc, attr.getDefaultValue());
            }
        }

        if (cx_type == XET_SIMPLE) {
            h = XsdScalarTextHelper::value(h, SOAP_SERIALIZATION_ERROR);
            rh."^value^" = simpleType.serializeValue(nsc, h, omitType);
        } else if (cx_type != XET_NONE) {
            if (exists h && h.typeCode() != NT_HASH) {
                if (!anyAttribute) {
                    throw SOAP_SERIALIZATION_ERROR, sprintf("expecting hash<auto> argument to serialize from "
                        "complexType %y (got %y, type %y)", getName(), h, type(h));
                } else {
                    rh = {"^value^": h};
                }
            } else if (cx_type == XET_SEQUENCE || cx_type == XET_ALL) {
                foreach string p in (keys elementmap) {
                    #printf("DEBUG element: %y (%y)\nvalue: %y\n", p, elementmap{p}, h{p});
                    rh += serializeElement(nsc, p, elementmap{p}, h, omitType);
                    delete h{p};
                }

                # when generating example messages we need generate all choices, in this case extra ^choices^ tag is used
                # choice name is unique in element so ne merge all choices together first
                *hash<auto> hch;
                foreach string k in (keys h) {
                    if (k =~ /^\^choices/) {
                        hch += remove h{k};
                    }
                }
                # also serialize each choice block, if any
                foreach hash<ChoiceInfo> ch in (choices) {
                    list<string> kl = ch.elementmap.keys();
                    *hash<auto> vh = h{kl};
                    *hash<auto> vhch = hch{kl};
                    if (!vh && !vhch) {
                        if (ch.required)
                            throw SOAP_SERIALIZATION_ERROR, sprintf("expecting one of %y to serialize choice / union "
                                "in complexType %y but no such keys were supplied", ch.elementmap.keys(), getName());
                    } else {
                        if (vh) {
                            rh += serializeChoice(nsc, ch.elementmap, vh, omitType, False, ch.alternatives);
                            # remove the serialized key from the input hash for the check below
                            map remove h{$1}, keys vh;
                        }
                        if (vhch) {
                            rh += serializeChoice(nsc, ch.elementmap, vhch, omitType, True, ch.alternatives);
                            map remove hch{$1}, keys vhch;
                        }
                    }
                }

                if (h) {
                    if (!anyAttribute) {
                        auto kl = h.size() == 1 ? h.firstKey() : h.keys();
                        throw SOAP_SERIALIZATION_ERROR, sprintf("%y %s of type %y (valid elements: %y)", kl,
                            kl.lsize() == 1 ? "is an invalid member" : "are invalid members", getName(), elementmap.keys());
                    }
                    rh += XsdBase::restoreElementNamespaces(h);
                }
                if (hch) {
                    throw SOAP_SERIALIZATION_ERROR, sprintf("unknown choice members %y provided via ^choices^ in %y",
                        keys hch, getName());
                }
            } else { # "choice" - union
                # when generating example messages all choices are generated in a "^choices^" tag
                *hash<auto> hch;
                foreach string k in (keys h) {
                    if (k =~ /^\^choices/) {
                        hch += remove h{k};
                    }
                }
                if (!h && !hch) {
                    # no member of the choice was supplied; this is only an error if the choice is required
                    if (required) {
                        throw SOAP_SERIALIZATION_ERROR, sprintf("expecting one of %y to serialize choice / union "
                            "in complexType %y but no such keys were supplied", elementmap.keys(), getName());
                    }
                } else {
                    if (h) {
                        rh += serializeChoice(nsc, elementmap, h, omitType, False, alternatives);
                    }
                    if (hch) {
                        rh += serializeChoice(nsc, elementmap, hch, omitType, True, alternatives);
                    }
                }
            }
        } else { # "none"
            rh."^value^" = NOTHING;
        }

        #printf("DEBUG name: %y desc: %y\n", name, descriptive_name);
        if (name && !omitType && !descriptive_name) {
            rh."^attributes^" += ("xsi:type": nsc.getTargetNamespaceOutputPrefix() + ":" + name) + ah;
        } else if (ah) {
            rh."^attributes^" += ah;
        }

        # issue #2899: if encoding elements of an array type, include the array type attribute
        if (arrayType && !omitType) {
            rh."^attributes^"."soapenc:arrayType" = arrayType;
        }

        #printf("DEBUG complex type %s returning %y from %y\n", name, rh, h);
        return rh;
    }

    private *hash<auto> serializeChoice(Namespaces nsc, hash<string, XsdElement> emap, hash<auto> h,
            *softbool omitType, bool all_members, *list<hash<string, XsdElement>> alts) {
        *hash<string, XsdElement> alt;
        # normally there is only one choice but we also need output example message where all options are enumerated
        if (!all_members && elements h > 1) {
            # issue #5410: an alternative can be a nested model group with more than one element; in that case all
            # the keys supplied must belong to a single alternative
            alt = XsdComplexType::getMatchingAlternative(alts, keys h);
            if (!alt) {
                throw SOAP_SERIALIZATION_ERROR, sprintf("cannot serialize choice / union in complexType %y with more "
                    "than 1 member (%y)", getName(), h.keys());
            }
        }
        *hash<auto> rh;
        # if a model group alternative was matched, then serialize the elements in the order they are declared in it
        foreach string key in (alt ? (select (keys alt), exists h{$1}) : (keys h)) {
            if (!emap{key})
                throw SOAP_SERIALIZATION_ERROR, sprintf("%y is an invalid member of choice / union in complexType "
                    "%y; expecting one of: %y", key, getName(), emap.keys());

            # add namespace if necessary
            rh += serializeElement(nsc, key, emap{key}, h, omitType);
        }
        # add namespace if necessary
        return rh;
    }

    #! returns the choice alternative containing all the given element names, if any
    /** @since %WSDL 0.5.8
    */
    private static *hash<string, XsdElement> getMatchingAlternative(*list<hash<string, XsdElement>> alts,
            list<auto> kl) {
        foreach hash<string, XsdElement> alt in (alts) {
            if (alt.size() > 1 && !(select kl, !exists alt{$1})) {
                return alt;
            }
        }
    }

    auto deserializeValue(string en, hash<string, XsdAbstractType> tmap, *hash<auto> mrh, auto oval) {
        #printf("XsdComplexType::deserialize() name: %y val: %y required: %y\n", getName(), oval, required);
        if (exists array)
            return array.deserializeValue(en, tmap, mrh, oval);

        if (!exists oval) {
            if (!required && !attrs) {
                return;
            }
        }

        hash<auto> rh;

        # to avoid "RUNTIME-TYPE-ERROR" exceptions in the next line`
        if (cx_type == XET_SIMPLE && oval.typeCode() != NT_HASH) {
            oval = {"^value^": oval};
        }
        if (exists oval && oval.typeCode() != NT_HASH) {
            if (!anyAttribute) {
                throw SOAP_DESERIALIZATION_ERROR, sprintf("cannot deserialize complex type %y from Qore type %y "
                    "(expecting \"hash\")", getName(), oval.type());
            } else {
                oval = {"^value^": oval};
            }
        }
        *hash<auto> val = mapExpandedElementNames(oval);
        *hash<auto> attr = val."^attributes^";

        # attribute hash
        *hash<auto> ah;
        hash<auto> expanded_attributes = XsdBase::getExpandedAttributes(attr);
        hash<string, bool> declared_attributes();
        foreach string field in (keys attrs) {
            XsdAttribute xa = attrs{field};
            string identity = type_qname(xa.namespaceUri, xa.name);
            declared_attributes{identity} = True;
            *string attr_val = expanded_attributes{identity};
            if (xa.use == "required" && !exists attr_val) {
                throw SOAP_DESERIALIZATION_ERROR, sprintf("cannot deserialize element %Y without required attribute %Y",
                    getName(), xa.name);
            }
            if (exists attr_val) {
                if (xa.use == "prohibited") {
                    throw SOAP_DESERIALIZATION_ERROR, sprintf("cannot deserialize element %Y with prohibited attribute %Y",
                        getName(), xa.name);
                }
                ah{field} = xa.getValue(attr_val);
            } else if (xa.use == "optional" && xa.hasValueConstraint()) {
                ah{field} = xa.getDefaultValue();
            }
        }

        foreach string identity in (keys expanded_attributes) {
            if (!declared_attributes{identity} && !XsdBase::isInstanceAttribute(identity) && !anyAttribute) {
                throw SOAP_DESERIALIZATION_ERROR, sprintf("unknown attribute %Y for element %Y", identity, en);
            }
        }

        if (attr) {
            delete val."^attributes^";

            # ensure types match
            *string tn = attr."xsi:type";
            if (exists tn) {
                (*string ns, *string tname) = tn =~ x/(.*):(.*)/;
                if (exists tname)
                    tn = tname;
                if (tn != name) {
                    # check for compatible extension
                    *XsdAbstractType t = tmap_try_get(tmap, tn);
                    #printf("DEBUG: type provided %y: %y\n", tn, t.name);
                    if (t) {
                        t.checkExtends(self, en);
                        return t.deserializeValue(en, tmap, mrh, oval);
                    }

                    throw SOAP_DESERIALIZATION_ERROR, sprintf("expecting ComplexType type %y for element %y, got %y",
                        getName(), en, tn);
                }
            }
        }

        if (val.typeCode() == NT_HASH) {
            WSDL::XsdBase::removeNS2(\val);

            #any ns = val.".ns";
            val -= ".ns";
        }

        if (cx_type == XET_SIMPLE) {
            if (!exists val && !required)
                return;
            auto sv = simpleType.deserializeValue(name, tmap, mrh,
                XsdScalarTextHelper::value(val, SOAP_DESERIALIZATION_ERROR));
            if (sv.typeCode() == NT_HASH)
                rh = sv;
            else
                rh."^value^" = sv;
        } else if (cx_type != XET_NONE) {
            if (exists val && val.typeCode() != NT_HASH)
                throw SOAP_DESERIALIZATION_ERROR, sprintf("cannot deserialize element %y type %y from qore type %y "
                    "(expecting hash)", en, getName(), val.type());

            if (!mixed) {
                # xml:space affects the XML data view, but schema element-only content
                # permits XML whitespace between children independently of that policy.
                val = XsdScalarTextHelper::elementContent(val, sprintf("element-only type %Y", getName()));
            }

            if (cx_type == XET_SEQUENCE || cx_type == XET_ALL) {
                #printf("XsdComplexType::deserialize() name: %y val: %y required: %y\n", getName(), val, required);
                # if we have one element
                if (elementmap.size() == 1 && val.size() == 1
                    && val.firstKey() == elementmap.firstKey()
                    && !exists val{elementmap.firstKey()} && !required && !choices)
                    return;

                foreach string p in (keys elementmap) {
                    #printf("element %y\n", p);
                    rh{p} = elementmap{p}.deserializeValue(tmap, mrh, getValue(mrh, val{p}), val.hasKey(p));
                    delete val{p};
                }
                # also parse each choice block, if any
                foreach hash<ChoiceInfo> ch in (choices) {
                    *hash<auto> vh = val.(ch.elementmap.keys());
                    *hash<auto> h = parseChoice(vh, ch.elementmap, en, tmap, mrh, ch.required, ch.alternatives);
                    if (h)
                        rh += h;
                    delete val.(h.keys());
                    #printf("choice em: %y h: %y\n", ch.elementmap.keys(), h);
                }
                delete val."^attributes^";
                if (val) {
                    if (!anyAttribute) {
                        throw SOAP_DESERIALIZATION_ERROR, sprintf("invalid element %y passed in type %y for element %y "
                            "(expecting %y)", (keys val)[0], getName(), en, keys elementmap);
                    } else {
                        rh = val;
                    }
                }
            } else { # "choice" - union
                # a choice declared with minOccurs = 0 does not have to have a member present
                rh += parseChoice(val, elementmap, en, tmap, mrh, required, alternatives);
            }
        }

        if (ah) {
            rh."^attributes^" = ah;
        }
        if (rh.size() == 1 && rh.hasKey("^value^")) {
            return rh."^value^";
        }
        return rh;
    }

    #! matches namespace-resolved wire names to the existing public record fields
    private *hash<auto> mapExpandedElementNames(*hash<auto> value) {
        hash<string, string> fields();
        foreach string field in (keys elementmap) {
            fields{elementmap{field}.getExpandedName()} = field;
        }
        foreach hash<ChoiceInfo> choice in (choices) {
            foreach string field in (keys choice.elementmap) {
                fields{choice.elementmap{field}.getExpandedName()} = field;
            }
        }
        *hash<auto> result;
        foreach string key in (keys value) {
            string field = fields{key} ?? key;
            if (result.hasKey(field)) {
                throw SOAP_DESERIALIZATION_ERROR, sprintf("duplicate XML values for field %Y in type %Y", field, name);
            }
            result{field} = value{key};
        }
        return result;
    }

    private *hash<auto> parseChoice(hash<auto> val, hash<string, XsdElement> emap, string en,
            hash<string, XsdAbstractType> tmap, *hash<auto> mrh, *bool required,
            *list<hash<string, XsdElement>> alts) {
        list<auto> kl = val.keys();
        if (elements kl > 1) {
            # issue #5410: an alternative can be a nested model group with more than one element; in that case all
            # the elements supplied must belong to a single alternative
            *hash<string, XsdElement> alt = XsdComplexType::getMatchingAlternative(alts, kl);
            if (!alt) {
                throw SOAP_DESERIALIZATION_ERROR, sprintf("too many elements supplied for choice / union in type %y "
                    "for element %y (%y)", getName(), en, kl);
            }
            hash<auto> rv();
            foreach string key in (select (keys alt), val.hasKey($1)) {
                rv{key} = emap{key}.deserializeValue(tmap, mrh, getValue(mrh, val{key}), True);
            }
            return rv;
        }
        *string key = kl[0];
        if (!exists key) {
            if (required)
                throw SOAP_DESERIALIZATION_ERROR, sprintf("missing element for choice / union in type %y for element "
                    "%y (expecting one of: %y)", getName(), en, emap.keys());
            return;
        }
        if (!exists emap{key})
            throw SOAP_DESERIALIZATION_ERROR, sprintf("element %y is not a valid element for choice / union in type "
                "%y for element %y (valid elements: %y)", key, getName(), en, emap.keys());

        return (key: emap{key}.deserializeValue(tmap, mrh, getValue(mrh, val{key}), val.hasKey(key)));
    }
}

#! web service operation class
public class WSOperation inherits WSDL::XsdNamedData {
    public {
        #! request message
        *WSMessage input;
        #! response message
        *WSMessage output;
        #! request message name
        *string input_name;
        #! response message name
        *string output_name;

        #! namespace container
        Namespaces nsc;

        #! the SOAPAction header value to send with this operation
        *string soapAction;

        #! a hash of top-level request names for this operation (depends on bindings)
        hash<string, bool> reqh;

        #! params per associated binding; key = binding name; value = OperationalBinding object
        hash<string, OperationalBinding> bindings;
    }

    private {
        #! fault messages keyed by fault name
        hash<string, WSMessage> faults;
    }

    #! creates the WSOperation object from the arguments supplied
    /** @param p the raw hash from deserialized XML data for the operation
        @param nsc the namespace container
        @param messages a hash of messages defined in the WSDL; keys are message names; values are WSMessage objects
     */
    constructor(hash<auto> p, Namespaces nsc, *hash<auto> messages) : XsdNamedData(\p) {
        self.nsc := nsc;

        if (p.input) {
            hash<auto> msghash = processNSValue(p.input."^attributes^");

            *WSMessage msg = messages.(msghash.message.val);
            if (!msg)
                throw WSDL_ERROR, sprintf("missing definition for input message %y required by operation %y", msghash.name.val ?? msghash.name ?? msghash.message.val, name);
            input := msg;

            #printf("DBG: WSOperation::constructor() name: %y msghash: %y\n", name, msghash);
            if (msghash.name)
                input_name = msghash.name.val ?? msghash.name;
        }

        if (p.output) {
            hash<auto> msghash = processNSValue(p.output."^attributes^");

            *WSMessage msg = messages.(msghash.message.val);
            if (!msg)
                throw WSDL_ERROR, sprintf("missing definition for output message %y required by operation %y", msghash.name.val ?? msghash.name ?? msghash.message.val, name);

            output := msg;
            if (msghash.name)
                output_name = msghash.name.val ?? msghash.name;
        }

        # issue #2804: process fault messages
        foreach hash<auto> fh in (p.fault) {
            hash<auto> msghash = processNSValue(fh."^attributes^");

            *WSMessage msg = messages{msghash.message.val};
            if (!msg) {
                throw WSDL_ERROR, sprintf("missing definition for fault message %y required by operation %y", msghash.name.val, name);
            }

            string fault_name = msghash.name.val ?? msghash.name;
            faults{fault_name} = msg;
            #printf("DEBUG: op %y fault %y msg %y\n", name, fault_name, msg.name);
        }

        *string op_ns = nsc.getTargetNamespaceUri();
        if (op_ns && op_ns !~ /\/$/)
            op_ns += "/";
        soapAction = op_ns ? op_ns + name : name;
    }

    #! returns a hash of fault messages keyed by fault name
    *hash<string, WSMessage> getFaultMessages() {
        return faults;
    }

    #! returns True if the given string is a valid fault message for the operation
    bool hasFault(string fault) {
        return faults.hasKey(fault);
    }

    #! this method is called if this operation supports at least one binding with document style
    setDocStyleBinding(reference idocmap) {
        foreach string key in (keys input.args) {
            # FIXME: could be a type here instead of an element
            if (!input.args{key}.element.name) {
                return;
            }

            string element = input.args{key}.element.name;
            idocmap{element} := input.args{key}.element;
            reqh{element} = True;
        }
    }

    #! this method is called if this operation supports at least one binding with RPC style
    markRpcStyleBinding() {
        reqh{name} = True;
    }

    #! returns all top-level request names for this operation
    list<auto> getTopLevelRequestNames() {
        return reqh.keys();
    }

    #! returns a hash representing the given binding
    /** @param bname the name of the binding, if not provided then uses the first assigned binding

        @return a binding param hash describing the binding with the following keys:
        - \c "httpMethod"
        - \c "soapTransport"

        @throw WSDL-BINDING-ERROR unknown binding
     */
    OperationalBinding getBinding(*string bname) {
        if (bindings && !exists bname)
            return bindings.firstValue();
        if (!exists bindings{bname})
            throw "WSDL-BINDING-ERROR", sprintf("binding %y is not a known binding for operation %y; known bindings: %y", bname, name, bindings.keys());
        return bindings{bname};
    }

    #! adds the given binding
    /** @param b the binding to add; its name must be unique in this operation

        @throw WSDL-BINDING-ERROR when binding already registered
     */
    addBinding(WSDL::OperationalBinding b) {
        string bname = b.getName();
        if (bindings.hasKey(bname))
            throw "WSDL-BINDING-ERROR", sprintf("binding %y is already registered in operation %y", bname, name);
        bindings{bname} = b;
    }

    #! serializes a fault response to an XML string or HTTP payload for the operation.
    /** @param fault an optional fault message for the operation (@see getFaultMessages())
        @param faultmsg the fault description to include in the SOAP message
        @param h the fault data to serialize
        @param header optional soap header info to serialize if required (ex: authorization info). In the first step
        headers are matched to binding/input/header WSDL definition, remaining headers are passed as-is
        @param enc the optional encoding to use; if this argument is not present, then the default encoding will be
        used
        @param nsh an optional namespace hash for the output message
        @param xml_opts optional XML generation options
        @param req_soapaction if present will override any SOAPAction value for the request, ignored for HTTP binding
        @param bname SOAP binding name or empty to get the first assigned binding

        @return a hash with keys:
        - \c body: XML string in the SOAP response format or body part of HTTP message (string or binary). Target
          content type is evaluated from WSDL or in case of ambiguity using "^attributes^"."^content-type^". The
          provided content type must match allowed types in the WSDL. Also "application/x-www-form-urlencoded" or any
          general type are supported.
        - \c hdr: hash of HTTP headers
        - \c path: the path part of URL. Used when urlEncoded is defined
        - \c method: the HTTP request method
    */
    hash<auto> serializeFault(*string fault, string faultmsg, auto h, *hash<auto> header, *string enc,
            *hash<auto> nsh, *int xml_opts, *string req_soapaction, *string bname) {
        if (exists fault && !faults{fault}) {
            throw SOAP_SERIALIZATION_ERROR, sprintf("cannot serialize unknown fault %y for operation %y; known "
                "faults: %y", fault, name, keys faults);
        }
        return getBinding(bname).serializeMessage(self, faults{fault}, False, nsc.hasSoap12(), h, header, enc, nsh,
            xml_opts, req_soapaction, faultmsg);
    }

    #! serializes a request to an XML string or HTTP payload for the operation.
    /** @param h the request to serialize
        @param header optional soap header info to serialize if required (ex: authorization info). In the first step
        headers are matched to binding/input/header WSDL definition, remaining headers are passed as-is
        @param enc the optional encoding to use; if this argument is not present, then the default encoding will be
        used
        @param nsh an optional namespace hash for the output message
        @param xml_opts optional XML generation options
        @param req_soapaction if present will override any SOAPAction value for the request, ignored for HTTP binding
        @param bname SOAP binding name or empty to get the first assigned binding
        @param http_headers optional HTTP headers supplied for serialization

        @return a hash with keys:
        - \c body: XML string in the SOAP request format or body part of HTTP message (string or binary). Target
          content type is evaluated from WSDL or in case of ambiguity using "^attributes^"."^content-type^".  The
          provided content type must match allowed types in WSDL; also "application/x-www-form-urlencoded" or any
          general type are supported.
        - \c hdr: hash of HTTP headers
        - \c path: the path part of URL. Used when urlEncoded is defined
        - \c method: the HTTP request method

        @throw SOAP-SERIALIZATION-ERROR no input message description
    */
    hash<auto> serializeRequest(auto h, *hash<auto> header, *string enc, *hash<auto> nsh, *int xml_opts, *string req_soapaction, *string bname, *hash<auto> http_headers) {
        @assert(nsc, "namespace container must be initialized");
        return getBinding(bname).serializeMessage(self, input, True, nsc.hasSoap12(), h, header, enc, nsh, xml_opts,
            req_soapaction, NOTHING, http_headers);
    }

    #! serializes a SOAP response to an XML string for the operation
    /** @param h the response to serialize
        @param header SOAP header hash. In the first step headers are matched to binding/input/header WSDL definition,
        remaining headers are passed as-is
        @param enc the optional encoding to use; if this argument is not present, then the default encoding will be
        used
        @param nsh namespace hash
        @param soap12 set to True if the response should use SOAP 1.2 encoding
        @param xml_opts optional XML generation options
        @param bname SOAP binding name, leave empty to get the first assigned binding
        @param http_headers HTTP headers to serialize in the response

        @return a hash with keys:
        - \c body: XML string in the SOAP request format or body part of HTTP message (string or binary). Target
          content type is evaluated from WSDL or in case of ambiguity using "^attributes^"."^content-type^".  The
          provided content type must match allowed types in WSDL; also "application/x-www-form-urlencoded" or any
          general type are supported.
        - \c hdr: hash of HTTP headers

        @throw SOAP-SERIALIZATION-ERROR no output message description
    */
    hash<auto> serializeResponse(auto h, *hash<auto> header, *string enc, *hash<auto> nsh, *bool soap12, *int xml_opts, *string bname, *hash<auto> http_headers) {
        @assert(nsc, "namespace container must be initialized");
        if (exists soap12) {
            if (soap12) {
                if (!nsc.hasSoap12())
                    throw SOAP_SERIALIZATION_ERROR, sprintf("cannot serialize response for operation %y with SOAP "
                        "1.2 encoding; this operation does not support SOAP 1.2", name);
            } else {
                if (!nsc.hasSoap11())
                    throw SOAP_SERIALIZATION_ERROR, sprintf("cannot serialize response for operation %y with SOAP "
                        "1.1 encoding; this operation does not support SOAP 1.1", name);
            }
        } else
            soap12 = nsc.hasSoap12();

        return getBinding(bname).serializeMessage(self, output, False, soap12, h, header, enc, nsh, xml_opts, NOTHING, NOTHING, http_headers);
    }

    #! parses a hash representing a parsed XML request (parsed with @ref Qore::Xml::parse_xml "parse_xml(XPF_PRESERVE_ORDER)") for the operation and returns the corresponding Qore data structure
    /** @param o the parsed SOAP or HTTP request with @ref WSDLLib::parseSOAPMessage() for the operation
        @param bname SOAP binding name, leave empty to use the first assigned binding
        @return the Qore data structure corresponding to the request data. When SOAP header is deserialized according binding/input WSDL then all data are passed under subhash vales prefixed by message name
        In case of HTTP binding the content type is matched against WSDL binding when wildcards are supported and current content type value is applied to "^attributes^"."^content-type^".
    */
    auto deserializeRequest(hash<auto> o, *string bname) {
        return getBinding(bname).deserializeMessage(self, o, True);
    }

    #! parses a hash representing a parsed XML response (parsed with @ref Qore::Xml::parse_xml "parse_xml(XPF_PRESERVE_ORDER)") for the operation and returns the corresponding Qore data structure
    /** @param o the parsed SOAP or HTTP request with @ref WSDLLib::parseSOAPMessage() for the operation
        @param bname SOAP binding name, leave empty to use the first assigned binding
        @return the Qore data structure corresponding to the response data. When SOAP header is deserialized according binding/output WSDL then all data are passed under subhash vales prefixed by message name
        In case of HTTP binding the content type is matched against WSDL binding when wildcards are supported and current content type value is applied to "^attributes^"."^content-type^".
    */
    auto deserializeResponse(hash<auto> o, *string bname) {
        return getBinding(bname).deserializeMessage(self, o, False);
    }

    #! decodes a SOAP request into explicitly retained XML parts
    /** @param xml the complete SOAP envelope, before conversion to a native hash
        @param bname the binding name, or NOTHING for the first assigned binding
        @return body and header XML values keyed by their WSDL part and message identities
        @throw SOAP-DESERIALIZATION-ERROR an invalid request or payload
        @throw WSDL-BINDING-ERROR the binding does not use element-based literal SOAP parts
        @par Example
        @code{.py}
        hash<SoapXmlMessageInfo> request = operation.deserializeXmlRequest(incoming_xml, "StockSoap");
        string original_quantity = request.body.order.getElementData().quantity;
        @endcode
    */
    hash<SoapXmlMessageInfo> deserializeXmlRequest(string xml, *string bname) {
        return getXmlBinding(bname).deserializeXmlMessage(self, xml, True);
    }

    #! decodes a SOAP response into explicitly retained XML parts
    /** @param xml the complete SOAP envelope, before conversion to a native hash
        @param bname the binding name, or NOTHING for the first assigned binding
        @return body and header XML values keyed by their WSDL part and message identities
        @throw SOAP-DESERIALIZATION-ERROR an invalid response or payload
        @throw SOAP-SERVER-FAULT-RESPONSE a SOAP fault was received
        @throw WSDL-BINDING-ERROR the binding does not use element-based literal SOAP parts
        @see deserializeXmlRequest()
    */
    hash<SoapXmlMessageInfo> deserializeXmlResponse(string xml, *string bname) {
        return getXmlBinding(bname).deserializeXmlMessage(self, xml, False);
    }

    private SoapBinding getXmlBinding(*string bname) {
        OperationalBinding binding = getBinding(bname);
        if (!(binding instanceof SoapBinding)) {
            throw "WSDL-BINDING-ERROR", "retained XML decoding requires a SOAP binding";
        }
        return binding;
    }

    /** Operation is resolved from method and path so let's look if data are passed in URL.
        When URL replacement is defined for operation then exception is raised.
        @return NOTHING if data are not encoded in URL for operation
    */
    *hash<auto> deserializeRequestPath(string path, *string bname) {
        return getBinding(bname).deserializeRequestPath(self, path);
    }

    #! processes a hash of raw deserialized XML data and removes any namespace prefix from keys (saved to a \c "ns" key in the hash vale assigned to the key) and returns the processed version of the hash
    static private hash<auto> processNSValue(hash<auto> h) {
        foreach string k in (keys h) {
            (*string ns, *string name) = h{k} =~ x/([^:]+):([^:]+)/;
            if (!name)
                h{k}.val = h{k};
            else {
                h{k}.ns = ns;
                h{k}.val = name;
            }
        }
        return h;
    }

    #! returns True if the operation is a SOAP 1.2 operation
    /** @return True if the operation is a SOAP 1.2 operation
    */
    bool isSoap12() {
        return nsc.hasSoap12();
    }

    #! returns the target namespace for the operation
    /** @return the target namespace for the operation
    */
    string getTargetNS() {
        return nsc.getTargetNamespaceUri();
    }
}

#! message argument hash description
public hashdecl ArgInfo {
    #! the arg name
    string name;

    #! unique part name
    string part;

    #! type for the argument
    XsdAbstractType type;

    #! element for the argument
    XsdElement element;
}

#! web service message class
/** Message parts retain distinct part names for binding selection and provider fields. Element-based parts
    resolve their QNames in the enclosing XML scope. Unambiguous element arguments keep local aliases;
    collisions use expanded names. XML output always uses the element declaration's own name and namespace.
*/
public class WSMessage inherits WSDL::XsdNamedData {
    public {
        #! Argument keys are part names for type parts and local or expanded names for element parts
        /** Unambiguous element names keep their local aliases; names colliding with another element or
            type-part name use expanded names. Use pmap to look up an argument by its WSDL part name.
        */
        hash<string, hash<WSDL::ArgInfo>> args;

        #! maps part names to args key, all parts are in hash
        hash<string, string> pmap;

        #! type map
        hash<string, XsdAbstractType> tmap;

        # keep a weak reference to the namespace map
        Namespaces nsc;
    }

    constructor(hash<auto> m, hash<string, hash<string, XsdElement>> emap, hash<string, XsdAbstractType> tmap, Namespaces nsc) : XsdNamedData(\m) {
        self.tmap = tmap;
        self.nsc := nsc;

        NamespacePrefixHelper message_scope(nsc, m."^attributes^");
        name = m."^attributes^".name;
        hash<string, hash<ArgInfo>> parts();
        hash<string, int> local_names();
        hash<string, bool> element_names();
        foreach auto p in (m.part) {
            *hash<auto> part = p."^attributes^";
            NamespacePrefixHelper part_scope(nsc, part);
            if (!exists part.name) {
                throw WSDL_ERROR, sprintf("missing part name in message %Y", name);
            }
            if (parts.hasKey(part.name)) {
                throw WSDL_ERROR, sprintf("duplicate part name %Y in message %Y", part.name, name);
            }
            hash<ArgInfo> arg = <ArgInfo>{"name": part.name, "part": part.name};
            if (part.element) {
                hash<auto> identity = nsc.getTypeHash(part.element);
                arg.element = emap_get(emap, identity.uri, identity.val);
                string expanded = arg.element.getExpandedName();
                if (element_names{expanded}) {
                    throw WSDL_ERROR, sprintf("ambiguous element %Y in message %Y", expanded, name);
                }
                element_names{expanded} = True;
                ++local_names{arg.element.name};
            } else {
                hash<auto> type_info;
                if (!nsc.doType(part.type, \type_info, \arg.type, tmap)) {
                    throw WSDL_ERROR, sprintf("cannot resolve type %Y for part %Y in message %Y", part.type,
                        part.name, name);
                }
                ++local_names{part.name};
            }
            parts{part.name} = arg;
        }
        foreach string part in (keys parts) {
            hash<ArgInfo> arg = parts{part};
            string key = arg.element ? (local_names{arg.element.name} == 1 ? arg.element.name
                : arg.element.getExpandedName()) : part;
            @assert(!args.hasKey(key));
            args{key} = arg;
            pmap{part} = key;
        }
    }

    #! Returns the data provider type for this message
    AbstractDataProviderType getDataProviderType() {
        HashDataType rv(name);
        foreach hash<ArgInfo> arg in (args.iterator()) {
            hash<auto> info = {"name": arg.name,
                "type": arg.type ? arg.type.getDataProviderType() : arg.element.getDataProviderType(),
                "allowed_values": arg.type ? arg.type.getDataProviderAllowedValues()
                    : arg.element.getDataProviderAllowedValues()};
            rv.addField(arg.type ? XsdDataFieldHelper::create(arg.type, info)
                : XsdDataFieldHelper::create(arg.element, info));
        }
        return rv;
    }

    /**
        Serializes a message part and returns its output namespace.
        @param part the WSDL part name
        @param encoded whether SOAP encoding is used
        @param h input values; the serialized value is removed from this hash
        @param ons receives the output namespace prefix
    */
    auto serializeRpcValue(string part, bool encoded, reference<hash<auto>> h, reference<string> ons) {
        string key = pmap{part};
        auto v = getValueFromHash(key, \h, True);
        if (!exists v) {
            if (key || args.size() == 1) {
                v = getValueFromHash(args{key}.element, \h, True);
            }
            if (!exists v)
                return;
        }
        if (v.typeCode() == NT_NULL)
            delete v;

        auto hv;
        #printf("DEBUG: part: %y, key: %y, with %y\n", part, key, args{key});
        #printf("DEBUG: serializeRpcValue, part: %y, key: %y, val: %y\n", part, key, v."^val^" ?? v);
        if (args{key}.element) {
            hv = args{key}.element.serializeValue(nsc, v, !encoded, key, name);
            ons = nsc.getOutputNamespacePrefix(args{key}.element.ns);
        } else {
            hv = args{key}.type.serializeValue(nsc, v, !encoded);
            ons = args{key}.type.getOutputNamespacePrefix();
        }
        #printf("DEBUG: arg %s got %y from %y (%y)\n", part, hv, v, exists args{key}.element ? args{key}.element : args{key}.type);
        return hv;
    }

    #! serializes data into a hash with SOAP namespaces etc. with RPC-style messages
    /**
        @param parts if present then serializes only particular element or part, if NOTHING then serializes all message elements
        @param msginfo a description of the message for the current binding, if available
        @param mpm optional multipart message receiving attachments
        @param n_name name of output key
        @param encoded if the encoded use module should be used (or the literal use model)
        @param h data to be serialized, keys are wsdl element names (or optionally the part name) and part names for simple types
        @param fault @ref True if serializing a fault response
     */
    *hash<auto> serializeRpc(*softlist<auto> parts, *WSDL::BindingMessageDescription msginfo, *MultiPartRelatedMessage mpm, string n_name, bool encoded, reference<auto> h, bool fault) {
        hash<auto> rh;
        #printf("DEBUG: message %s: parts: %y, pmap: %y, h: %y\n", name , parts, pmap, ,h);
        foreach string part in (parts ?? keys pmap) {
            string ons;
            auto hv = serializeRpcValue(part, encoded, \h, \ons);
            if (!exists hv) {
                continue;
            }
            string k = pmap{part};
            # Handle multipart attachments - if this part is defined as a multipart content part
            if (mpm && msginfo.parts{k}) {
                auto partContentType = msginfo.parts{k};
                if (partContentType.typeCode() == NT_LIST) {
                    partContentType = shift partContentType;
                }
                mpm.addPart(hv, sprintf("<%s>", k), partContentType);
                hv = {"^attributes^": {"href": "cid:" + k}};
            }
            rh{args{k}.element ? args{k}.element.getXmlName(nsc) : k} = hv;
        }

        if (rh) {
            if (encoded) {
                rh."^attributes^" += {
                    "soapenv:encodingStyle": SOAP_ENCODING,
                };
            }

            # issue #2804: do not wrap the fault data with the request name
            if (fault) {
                return rh;
            }

            return {nsc.getTargetNamespaceOutputPrefix() + ":" + n_name: rh};
        }
    }

    #! serializes data into a hash with SOAP namespaces etc. with document-style messages
    /**
        @param parts if present then serializes only particular element or part, if NOTHING then serializes all message elements
        @param msginfo a description of the message for the current binding, if available
        @param mpm a multipart message object, for future use
        @param encoded if the encoded use module should be used (or the literal use model)
        @param h data to be serialized, keys are wsdl element names (optionally part name is also possible) and part names for simple types
        @param fault @ref True if serializing a fault response
        @note A single selected part accepts unwrapped record fields, including nested choices and
        explicit element wildcards. Explicit values for other parts and declared headers remain available.
        Multiple selected parts require part or element wrappers to identify ownership.
     */
    *hash<auto> serializeDocument(*softlist<auto> parts, *WSDL::BindingMessageDescription msginfo, *MultiPartRelatedMessage mpm, bool encoded, reference<auto> h, bool fault) {
        hash<auto> rh;
        *hash<string, string> xml_attributes;

        #printf("DEBUG: WSMessage::serializeDocument() parts: %y h: %y args: %y, pmap: %y\n", parts, h.typeCode()==NT_HASH ?  h.keys() : h, args.keys(), pmap);

        if (h instanceof XsdXmlValue) {
            list<string> selected = map $1, (parts ?? keys pmap);
            if (selected.size() != 1) {
                throw SOAP_SERIALIZATION_ERROR, "a bare retained XML value requires exactly one selected message part";
            }
            h = {pmap{selected[0]}: h};
        }

        if (args.size() == 1) {
            string fk = args.firstKey();
            if (!parts) {
                /*
                for backwards compatibility with a single argument, just when parts is NOTHING which is used for body
                serialization when is no explicit part name.
                */
                if (h.typeCode() != NT_HASH) {
                    h  = (fk: h);
                } else {
                    # it is ambiguous so do not do any heuristic
                }
            }
        }
        foreach string p in (parts ?? keys pmap) {
            string k = pmap{p};
            auto val = getValueFromHash(k, \h, True);
            if (!exists val) {
                if ((parts ? parts.lsize() : args.size()) == 1) {
                    # A bare record belongs to one selected part. Preserve explicit values for other
                    # parts and headers so a wildcard cannot consume their wrappers as child elements.
                    hash<string, bool> reserved = {name: True};
                    foreach string other in (keys pmap) {
                        if (other != p) {
                            reserved{other} = reserved{pmap{other}} = True;
                        }
                    }
                    if (msginfo) {
                        foreach BindingMessageHeaderDescription hdr in (msginfo.getHeaders()) {
                            reserved{hdr.msg.name} = reserved{hdr.part} = reserved{hdr.msg.pmap{hdr.part}} = True;
                        }
                    }
                    if (h.typeCode() == NT_HASH && h.hasKey(name)) {
                        val = getValueFromHash(args{k}.element, \h{name}, True, reserved);
                        if (exists val && !h{name}) {
                            remove h{name};
                        }
                    }
                    if (!exists val) {
                        val = getValueFromHash(args{k}.element, \h, True, reserved);
                    }
                }
                if (!exists val) continue;
            }
            if (val.typeCode() == NT_NULL)
                val = NOTHING;
            if (val.typeCode() == NT_HASH)
                XsdBase::removeNS2(\val);
            #printf("DEBUG: k: %y val: %y, args: %y\n", k, val, keys args);
            hash<auto> arg = args{k};
            if (val instanceof XsdXmlValue) {
                if (!arg.element || encoded || (mpm && msginfo.parts{k})) {
                    throw SOAP_SERIALIZATION_ERROR,
                        "retained XML values require an element-based literal SOAP part";
                }
                XsdSoapXmlHelper::validate(val, SOAP_SERIALIZATION_ERROR);
                arg.element.validateXmlValue(val, nsc, tmap);
                XsdSoapXmlHelper::mergeContext(\xml_attributes, cast<XsdXmlValue>(val).getInheritedXmlAttributes());
                # Headers are serialized in separate calls and merged, so the marker must include
                # both message and part identity rather than a per-call numeric index.
                rh{sprintf("^xml^%d:%s:%s", name.length(), name, p)} = cast<XsdXmlValue>(val).getXml();
                continue;
            }
            # Handle multipart attachments - if this part is defined as a multipart content part
            if (mpm && msginfo.parts{k}) {
                auto partContentType = msginfo.parts{k};
                if (partContentType.typeCode() == NT_LIST) {
                    partContentType = shift partContentType;
                }
                mpm.addPart(val, sprintf("<%s>", k), partContentType);
                # For document style with element parts, use element name with namespace
                if (arg.element) {
                    rh{arg.element.getXmlName(nsc)} = {"^attributes^": {"href": "cid:" + k}};
                } else {
                    rh{p} = {"^attributes^": {"href": "cid:" + k}};
                }
            } else if (arg.element) {
                auto th = arg.element.serializeValue(nsc, val, !encoded, k, name);
                rh{arg.element.getXmlName(nsc)} = th;
            } else {
                auto th = arg.type.serializeValue(nsc, val, !encoded);
                rh{p} = th;
            }
        }

        if (xml_attributes) {
            rh."^attributes^" += xml_attributes;
        }
        if (encoded && rh) {
            rh."^attributes^" += {
                "soapenv:encodingStyle": SOAP_ENCODING,
            };
        }

        #printf("DEBUG: message %s: pmap: %y rh: %y\n", name, pmap, rh);

        return rh;
    }

    #! deserialize RPC message
    /**
    @param mrh optional SOAP multi-reference lookup hash
    @param val keys are element names or part names for simple types
    @param part if exists then deserialize only particular part
    @return serialized data, keys are wsdl element names (optionally part name is also possible) and part names for simple types
    */
    *hash<auto> deserializeRpc(*hash<auto> mrh, hash<auto> val, *string part) {
        #printf("DBG WSMessage::deserializeRpc() pmap: %y part: %y val: %y\n", pmap, part, val);
        hash<auto> ro;

        foreach string p in (part ?? keys pmap) {
            string k = getSerializedKey(p);
            bool present = val.hasKey(k);
            auto v = remove val{k};
            hash<auto> arg = args{k};
            #printf("DBG WSMessage::deserializeRpc() part: %y, key: %y, val: %y\n", p, k, v);
            if (v.typeCode() == NT_HASH) {
                XsdBase::removeNS2(\v);
            }
            if (arg.element) {
                ro{p} = arg.element.deserializeValue(tmap, mrh, getValue(mrh, v), present);
            } else {
                ro{p} = arg.type.deserializeValue(name, tmap, mrh, getValue(mrh, v));
            }
        }

        # issue #2902: ignore XML attributes
        remove val."^attributes^";
        if (val && !exists part)
            throw SOAP_DESERIALIZATION_ERROR, sprintf("additional keys %y included in %y message hash", val.keys(), name);

        # if there is only one argument, return it directly
        return ro;
    }

    #! deserializes the given message parts from a document-style message
    /** @param mrh any multiRef hash for the message
        @param val the message data
        @param parts the names of the parts to deserialize; if not present, then all parts of the message are
        deserialized
        @param ignore_unknown if @ref True "True", then keys in \a val that do not correspond to a part being
        deserialized are ignored; if not present, then unknown keys are ignored only if \a parts is given, for
        backwards compatibility with SOAP header deserialization
        @param expanded_names True when element names have been resolved by XsdBase::expandElementNamespaces();
        matching then requires the declared namespace and local name without the legacy single-argument inference

        @return a hash of deserialized part values keyed by part name
    */
    *hash<auto> deserializeDocument(*hash<auto> mrh, auto val, *softlist<string> parts, *bool ignore_unknown,
            bool expanded_names = False) {
        hash<auto> rh;

        *hash<auto> attr = remove val."^attributes^";

        #printf("DBG WSMessage::deserializeDocument() pmap: %y val: %y\n", pmap, val);
        if (!expanded_names && args.size() == 1) {
            string k = getSerializedKey(pmap.firstKey());
            if (val.typeCode() != NT_HASH || !val.hasKey(k)) {
                auto v = val;
                val = hash();
                val{k} = v;
            }
        }

        foreach string p in (parts ?? keys pmap) {
            string k = expanded_names ? getExpandedSerializedKey(p) : getSerializedKey(p);
            bool present = val.hasKey(k);
            auto v = remove val{k};
            #printf("DBG WSMessage::deserializeDocument() part: %y, key: %y, val: %y\n", p, k, v);
            if (v.typeCode() == NT_HASH) {
                XsdBase::removeNS2(\v);
            }
            hash<auto> arg = args{pmap{p}};
            if (arg.element) {
                rh{p} = arg.element.deserializeValue(tmap, mrh, getValue(mrh, v), present);
            } else {
                rh{p} = arg.type.deserializeValue(name, tmap, mrh, getValue(mrh, v));
            }
        }

        if (val && !(ignore_unknown ?? exists parts))
            throw SOAP_DESERIALIZATION_ERROR, sprintf("additional keys %y included in %y message hash", val.keys(), name);

        #printf("DBG WSMessage::deserializeDocument() args: %y val: %y\nRH: %y\n", args.keys(), val, rh);
        return rh;
    }

    #! serialize all values as string or binary
    /**
        @return hash of all parts in key-value pair
    */
    hash<auto> serializeAllPartData(*hash<auto> val) {
        return map {$1: serializeData(nsc, $1, val).value}, keys args;
    }

    #! serialized value of particular type value as string or binary
    /**
        @param val value to be resolved
        @param key member name referencing a simple type
        @param nsc namespaces for the output value

        @return as hash with 'value' and optional 'content-type' key passed from v.content-type if exists
     */
    hash<auto> serializeData(Namespaces nsc, string key, *hash<auto> val) {
        if (args{key}.element) {
            throw SOAP_SERIALIZATION_ERROR, sprintf("cannot get element value %y in message %y. Type part is needed", key, name);
        }
        auto v = getValueFromHash(key, \val, False);
        if (v.typeCode() == NT_NULL)
            v = NOTHING;
        hash<auto> rv.value = args{key}.type.serializeValue(nsc, v, False){"^value^"};
        if (v.typeCode() == NT_HASH) {
            rv."content-type" = v."^attributes^"."^content-type^";
        }
        return rv;
    }

    #! deserialize value in string or binary form
    /**
        @return hash<auto> in key-value pair
    */
    hash<auto> deserializeData(string part, hash<auto> val) {
        hash<auto> rv;
        hash<auto> arg = args{pmap{part}};
        rv{part} = arg.element
            ? arg.element.deserializeValue(tmap, NOTHING, val{pmap{part}}, val.hasKey(pmap{part}))
            : arg.type.deserializeValue(name, tmap, NOTHING, val{pmap{part}});
        return rv;
    }

    #! deserialize all values in string or binary form
    /**
        @return hash of all parts in key-value pair
    */
    hash<auto> deserializeAllPartData(hash<auto> val) {
        hash<auto> rv = {};
        #printf("deserializeAllPartData: pmap: %y, val: %y\n", pmap, val);
        foreach string p in (keys pmap) {
            rv += deserializeData(p, val);
        }
        return rv;
    }

    #! find part in value, remove that value from the hash
    /**
        @param ename element/type name
        @param v reference to hash, supposed structure is [msgname.](partname|elemname) = value to support more message data in one hash
        @param removeFound if True found values are removed from the hash

        @return resolved value, if not found then returns NOTHING
    */
    private:internal auto getValueFromHash(string ename, reference<auto> v, bool removeFound) {
        #printf("DEBUG: WSMessage::getValueFromHash() ename: %y v: %y rF: %y args: %y args{%y}.part: %y\n", ename, v, removeFound, args.keys(), ename, args{ename}.part);

        auto rv;
        string k;
        # there is no unique part namespace as it may contain more messages in one hash, so let's do a little heuristic
        if (v.typeCode() == NT_HASH && v.hasKey(name)) {
            if (args{ename}.part && exists v{name}{args{ename}.part}) {
                k = args{ename}.part;
            } else if (exists v{name}{ename}) {
                k = ename;
            }
            if (k) {
                rv = v{name}{k};
                if (removeFound) {
                    remove v{name}{k};
                    if (!v{name}) {
                        remove v{name};
                    }
                }
            }
        }
        if (!k) {
            if (args{ename}.part && exists v{args{ename}.part}) {
                k = args{ename}.part;
            } else if (v.typeCode() == NT_HASH && v.hasKey(ename)) {
                k = ename;
            }
            if (k) {
                rv = v{k} ?? NULL;
                if (removeFound) {
                    remove v{k};
                    if (!v{name}) {
                        remove v{name};
                    }
                }
            }
        }
        return rv;
    }

    #! when only one arg then try to get values based on element keys
    private:internal auto getValueFromHash(*WSDL::XsdElement element, reference<auto> v, bool removeFound,
            *hash<string, bool> reserved) {
        if (!element) {
            return;
        }
        if (element.type instanceof WSDL::XsdComplexType) {
            XsdComplexType type = cast<WSDL::XsdComplexType>(element.type);
            if (type.simpleType) {
                # A simple-content value uses the existing scalar/^value^ representation, with attributes beside it.
                if (v.typeCode() != NT_HASH) {
                    auto value = v;
                    if (removeFound) {
                        remove v;
                    }
                    return value ?? NULL;
                }
                if (v.hasKey("^value^")) {
                    list<string> members = select keys v, $1 == "^value^" || $1 == "^attributes^" || $1 =~ /^\^comment/;
                    hash<auto> value = v{members};
                    if (removeFound) {
                        map remove v{$1}, members;
                    }
                    return value;
                }
            }
            hash<auto> rv;
            if (v.typeCode() == NT_HASH && v.hasKey("^attributes^")) {
                rv."^attributes^" = v."^attributes^";
                if (removeFound) {
                    remove v."^attributes^";
                }
            }
            if (type.isEmpty()) {
                # An empty content model can still carry attributes.
                return rv ?? NULL;
            }
            if (v.typeCode() == NT_HASH) {
                hash<string, bool> fields = map {$1: True}, keys type.elementmap;
                foreach hash<ChoiceInfo> choice in (type.choices) {
                    map fields{$1} = True, keys choice.elementmap;
                }
                foreach string key in (keys v) {
                    if (reserved{key} && !(key == name && fields{key})) {
                        continue;
                    }
                    if (fields{key} || key =~ /^\^comment/ || key =~ /^\^choices/
                            || (type.hasElementWildcard() && key !~ /^\^/)) {
                        rv{key} = v{key}.typeCode() == NT_NULL ? NOTHING : v{key};
                        if (removeFound) {
                            remove v{key};
                        }
                    }
                }
            }
            return rv;
        }
    }

    string getSerializedKey(string part) {
        return args{pmap{part}}.element ? pmap{part} : part;
    }

    #! returns the expanded wire name of a document message part
    /** @param part the WSDL part name
        @return the declared element's expanded name, or the unqualified type-part name
        @since %WSDL 0.5.8
    */
    string getExpandedSerializedKey(string part) {
        *XsdElement element = args{pmap{part}}.element;
        return element ? element.getExpandedName() : type_qname("", part);
    }

    #! check if pname is defined as message part
    /** @return translated part name to element/type name
     */
    string checkPart(string pname) {
        if (!pmap{pname}) {
            throw sprintf("%y is an unknown part in message %y, defined parts: %y", pname, name, keys pmap);
        }
        return pmap{pname};
    }
}

#! Group reference info with occurrence constraints
public hashdecl GroupRefInfo {
    #! The captured expanded group reference key (for example, "{urn:address}AddressGroup")
    string ref;
    #! Minimum occurrences (default 1)
    int minOccurs = 1;
    #! Maximum occurrences (-1 = unbounded, default 1)
    int maxOccurs = 1;
}

# private helper class for lazy name resolution
class XsdLateResolverHelper {
    private {
        list<object> l();
        list<XsdElement> constrainedElements();
        #! Group references: maps complexType -> list of group ref info
        hash<string, list<hash<GroupRefInfo>>> groupRefs();
        #! Attribute group references: maps complexType -> list of attribute group ref names
        hash<string, list<string>> attrGroupRefs();
    }

    constructor() {
    }

    add(object v) {
        l += v;
    }

    list<auto> getList() {
        return l;
    }

    addConstrainedElement(XsdElement element) {
        constrainedElements += element;
    }

    validateElementConstraints() {
        foreach XsdElement element in (constrainedElements) {
            element.validateValueConstraintType();
        }
    }

    #! Add a group reference to be resolved later
    /** @param ct the complex type containing the group reference
        @param groupRef the group reference string
        @param minOccurs the minimum occurrences (default 1)
        @param maxOccurs the maximum occurrences (-1 for unbounded, default 1)
    */
    addGroupRef(XsdComplexType ct, string groupRef, int minOccurs = 1, int maxOccurs = 1) {
        string key = ct.uniqueHash();
        if (!groupRefs{key}) {
            groupRefs{key} = ();
        }
        groupRefs{key} += <GroupRefInfo>{
            "ref": groupRef,
            "minOccurs": minOccurs,
            "maxOccurs": maxOccurs,
        };
    }

    #! Add an attribute group reference to be resolved later
    addAttrGroupRef(XsdComplexType ct, string attrGroupRef) {
        string key = ct.uniqueHash();
        if (!attrGroupRefs{key}) {
            attrGroupRefs{key} = ();
        }
        attrGroupRefs{key} += attrGroupRef;
    }

    #! Get group references for a complex type
    *list<hash<GroupRefInfo>> getGroupRefs(XsdComplexType ct) {
        return groupRefs{ct.uniqueHash()};
    }

    #! Get attribute group references for a complex type
    *list<string> getAttrGroupRefs(XsdComplexType ct) {
        return attrGroupRefs{ct.uniqueHash()};
    }

    clearResolved() {
        l = map $1, l, !isResolved($1);
    }

    static bool isResolved(XsdTypedData t) {
        return t.type instanceof XsdAbstractType;
    }

    static bool isResolved(XsdSimpleType t) {
        return t.type instanceof XsdAbstractType;
    }

    static bool isResolved(XsdComplexType t) {
        return t.simpleType instanceof XsdAbstractType;
    }

    static bool isResolved(XsdArrayType t) {
        return t.elementType instanceof XsdAbstractType;
    }

    static bool isResolved(auto t) {
        return False;
    }
}

#! class for WSDL bindings associated with a SOAP operation
public class OperationalBinding inherits WSDL::XsdNamedData {
    public {
        bool docstyle;
        *WSDL::BindingMessageDescription input;
        *WSDL::BindingMessageDescription output;
        *string soapAction;
    }

    constructor(string name, string ns, bool docstyle, *string soapAction, *WSDL::BindingMessageDescription input, *WSDL::BindingMessageDescription output) : XsdNamedData(name, ns) {
        self.docstyle = docstyle;
        self.soapAction = soapAction;
        self.input = input;
        self.output = output;
    }

    hash<auto> serializeMessage(WSOperation op, *WSMessage msg, bool request, bool soap12, auto h, *hash<auto> header, string enc = "UTF-8", *hash<auto> nsh, *int xml_opts, *string req_soapaction, *string faultmsg, *hash<auto> http_headers) {
        return serializeMessageImpl(op, msg, request, soap12, h, header, enc, nsh, xml_opts, req_soapaction, faultmsg, http_headers);
    }

    auto deserializeMessage(WSOperation op, hash<auto> o, bool request) {
        return deserializeMessageImpl(op, o, request);
    }

    auto deserializeRequestPath(WSOperation op, string path) {
        return deserializeRequestPathImpl(op, path);
    }

    abstract hash<auto> serializeMessageImpl(WSOperation op, *WSMessage msg, bool request, bool soap12, auto h, *hash<auto> header, string enc, *hash<auto> nsh, *int xml_opts, *string req_soapaction, *string faultmsg, *hash<auto> http_headers);

    abstract auto deserializeMessageImpl(WSOperation op, hash<auto> o, bool request);

    abstract auto deserializeRequestPathImpl(WSOperation op, string path);
}

public class SoapBinding inherits WSDL::OperationalBinding {
    public {
        string soapTransport;
    }

    constructor(string name, string ns, bool docstyle, string soapTransport, *string soapAction, *WSDL::BindingMessageDescription input, *WSDL::BindingMessageDescription output) : OperationalBinding(name, ns, docstyle, soapAction, input, output) {
        self.soapTransport = soapTransport;
    }

    hash<auto> serializeMessageImpl(WSOperation op, *WSMessage msg, bool request, bool soap12, auto h, *hash<auto> header, string enc, *hash<auto> nsh, *int xml_opts, *string req_soapaction, *string faultmsg, *hash<auto> http_headers) {
        hash<auto> rv;

        if (request) {
            # make sure that rv stays hash<auto> instead of hash<string, string>
            rv += {
                "method": "POST",
            };
        }

        string io = request ? "input" : "output";

        *BindingMessageDescription bmd = self{io};
        if (!bmd) {
            throw SOAP_SERIALIZATION_ERROR, sprintf("no %s message description for message %y", io, name);
        }

        if (!exists req_soapaction)
            req_soapaction = soapAction;

        MultiPartRelatedMessage mpm;

        rv.body = make_xml(serializeSoapMessage(op, msg, h, header, nsh, request, soap12, \mpm, faultmsg), xml_opts, enc);

        string ct = WSDLLib::getSoapMimeType12(soap12);

        # Handle multipart message assembly - splice SOAP body as first part
        if (mpm && mpm.size() > 0) {
            bmd = self{request ? "input" : "output"};
            string partId = sprintf("<%s>", (bmd.body.parts ?? (msg ? keys msg.args : ())).join(" "));
            mpm.splicePart(rv.body, partId, ct);
            hash<Mime::MessageInfo> mpmResult = mpm.getMsgAndHeaders();
            rv.body = mpmResult.body;
            rv.hdr += mpmResult.hdr;
            # Content-Type will be overwritten below if not multipart
            ct = rv.hdr."Content-Type";
        }

        if (req_soapaction) {
            rv.hdr += {"SOAPAction": req_soapaction};
            if (soap12) {
                ct += sprintf(";action=%s", req_soapaction);
            }
        }

        if (rv.body) {
            if (exists enc) {
                ct += sprintf(";charset=%s", enc);
            }

            rv.hdr."Content-Type" = ct;
        }

        rv.hdr."Accept" = WSDLLib::SoapMimeTypes.join(",");

        rv.hdr += http_headers;

        return rv;
    }

    private:internal hash<auto> serializeSoapMessage(WSOperation op, *WSMessage msg, auto val, *hash<auto> header,
            *hash<auto> nsh, bool request, bool soap12, reference mpm, *string faultmsg) {
        string io = request ? "input" : "output";
        # setup namespaces for SOAP envelope
        #printf("DEBUG: serializeSoapMessage: io:%s, h: %y, header: %y, soap12:%y\n", io, val, header, soap12);
        # make sure that rh stays hash<auto> instead of hash<string, string>

        hash<auto> rh = hash(soap12 ? WSDL::ENVELOPE_12_NS : WSDL::ENVELOPE_11_NS);
        string soapenvEnvelope = rh.firstKey();
        rh{soapenvEnvelope}."^attributes^" += op.nsc.getOutputNamespaceHash(nsh);

        BindingMessageDescription bmd = self{io};

        # Create multipart message container if multipartRelated binding is used
        if (exists bmd.multipart) {
            mpm = new MultiPartRelatedMessage();
        }

        bool fault = exists faultmsg;

        #printf("DEBUG: docstyle: %y fault: %y\n", docstyle, fault);
        #printf("DEBUG: op: %y io: %y op{io}: %s %d %y\n", op.keys(), io, op{io}.type(), op{io}.typeCode(), boolean(op{io}));
        *hash<auto> body;
        if (msg) {
            bool encoded = bmd.body.encoded;
            if (docstyle) {
                # bmd.body.encoded == False = literal encoding
                #printf("parts: %y, args: %y\n", bmd.body.parts, msg.args.keys());
                body = msg.serializeDocument(bmd.body.parts, bmd, mpm, encoded, \val, fault);
            } else {
                string mname = (request ? op.output_name : op.input_name) ?? (op.name + (request ? "" : "Response"));
                body = msg.serializeRpc(bmd.body.parts, bmd, mpm, mname, encoded, \val, fault);
            }
            if (encoded) {
                rh{soapenvEnvelope}."^attributes^"."xmlns:soapenc" = SOAP_ENCODING;
            }
            #printf("DEBUG: body: %N\nval: %N\n", body, val);
        }

        *hash<string, string> header_xml_attributes;
        if (bmd.hasHeaders()) {
            #printf("DEBUG: %s header: %y\n", io, header);
            #printf("DEBUG: doc: %y bhdr: %N\n", docstyle, (map $1.("message", "part"), bmd.getHeaders()));
            hash<auto> outh;
            foreach BindingMessageHeaderDescription hdr in (bmd.getHeaders()) {
                #printf("DEBUG: hdr: %y (%y)\n", hdr.("encoded", "part"), hdr.msg.args.keys());
                # only style="document" is assumed since headers do not contain parameters.
                *hash<auto> h;
                if (header)
                    h = hdr.msg.serializeDocument(hdr.part, NOTHING, NOTHING, hdr.encoded, \header, False);
                if (!h && val) {
                    # header data provided in val ?
                    h = hdr.msg.serializeDocument(hdr.part, NOTHING, NOTHING, hdr.encoded, \val, False);
                }
                if (h) {
                    foreach string key in (keys h) {
                        if (key.startsWith("^xml^")) {
                            hash<string, string> attributes();
                            foreach string attribute in ("xml:lang", "xml:space", "xml:base") {
                                if (h."^attributes^".hasKey(attribute)) {
                                    attributes{attribute} = h."^attributes^"{attribute};
                                }
                            }
                            XsdSoapXmlHelper::mergeContext(\header_xml_attributes, attributes);
                            break;
                        }
                    }
                    remove h."^attributes^".("soapenv:encodingStyle");
                    outh += h;
                }
            }
            #printf("DEBUG: outh: %y\n", outh);
            rh{soapenvEnvelope}."soapenv:Header" = outh;
        }
        if (header.typeCode() == NT_HASH && header) {
            if (op.nsc.opt_allow_any_header) {
                if (exists header_xml_attributes) {
                    foreach string attribute in ("xml:lang", "xml:space", "xml:base") {
                        if (header."^attributes^".hasKey(attribute)
                                && (!header_xml_attributes.hasKey(attribute)
                                    || header."^attributes^"{attribute}.typeCode() != NT_STRING
                                    || header."^attributes^"{attribute} != header_xml_attributes{attribute})) {
                            throw SOAP_SERIALIZATION_ERROR,
                                "explicit SOAP Header attributes conflict with retained XML context";
                        }
                    }
                }
                rh{soapenvEnvelope}."soapenv:Header" += header;
            } else {
                throw SOAP_SERIALIZATION_ERROR, sprintf("%s header data provided for operation %y remains unserialized: %y", io, op.name, header);
            }
        }
        if (header_xml_attributes) {
            rh{soapenvEnvelope}."soapenv:Header"."^attributes^" += header_xml_attributes;
        }
        if (val.typeCode() == NT_HASH && val)
            throw SOAP_SERIALIZATION_ERROR, sprintf("%s data provided for operation %y remains unserialized: %y", io, op.name, val);

        if (fault) {
            if (soap12) {
                rh{soapenvEnvelope}."soapenv:Body" = {
                    "soapenv:Fault": {
                        "soapenv:Code": {
                            "soapenv:Value": "soapenv:Sender",
                        },
                        "soapenv:Reason": {
                            "soapenv:Text": faultmsg,
                        },
                    } + (body ? {"soapenv:Detail": body} : NOTHING),
                };
                # optional Node, Role, Detail, see https://www.w3.org/TR/soap12/, 5.4 Fault
            } else {
                # soap 1.1
                rh{soapenvEnvelope}."soapenv:Body" = {
                    "soapenv:Fault": {
                        "faultcode": "soapenv:Client",
                        "faultstring": faultmsg,
                    } + (body ? {"detail": body} : NOTHING),
                };
            }
        } else {
            if (body) {
                rh{soapenvEnvelope}."soapenv:Body" = body;
            }
        }
        return rh;
    }

    #! decodes element-based literal SOAP parts without converting their XML scalar values
    /** @param op the operation describing the request or response
        @param xml the complete SOAP envelope XML
        @param request True for input, False for output
        @return retained body parts and headers keyed by their WSDL identities
        @throw SOAP-DESERIALIZATION-ERROR invalid message or payload
        @throw SOAP-SERVER-FAULT-RESPONSE a SOAP fault response was received
        @throw WSDL-BINDING-ERROR the binding requires a nonliteral or nonelement XML representation
        @note Existing schema decode and encode constraints apply before any XML values are returned.
    */
    hash<SoapXmlMessageInfo> deserializeXmlMessage(WSOperation op, string xml, bool request) {
        string io = request ? "input" : "output";
        *BindingMessageDescription description = self{io};
        *WSMessage message = op{io};
        if (!description || !message) {
            throw SOAP_DESERIALIZATION_ERROR, sprintf("operation %y has no %s message", op.name, io);
        }
        if (!docstyle || description.body.encoded || description.multipart) {
            throw "WSDL-BINDING-ERROR", "retained XML decoding requires an element-based literal SOAP binding";
        }
        XsdXmlValue envelope(xml);
        if (envelope.getLocalName() != "Envelope"
                || !inlist(envelope.getNamespaceUri(), (SOAP_11_ENV, SOAP_12_ENV))) {
            throw SOAP_DESERIALIZATION_ERROR, "expected a SOAP Envelope element";
        }
        XsdSoapXmlHelper::validate(envelope, SOAP_DESERIALIZATION_ERROR);
        list<XsdXmlValue> body_values();
        list<XsdXmlValue> header_values();
        bool has_body = False;
        bool has_header = False;
        hash<SoapXmlMessageInfo> result();
        foreach XsdXmlValue child in (envelope.getChildValues()) {
            if (child.getExpandedName() == type_qname(envelope.getNamespaceUri(), "Body")) {
                if (has_body) {
                    throw SOAP_DESERIALIZATION_ERROR, "duplicate SOAP Body";
                }
                has_body = True;
                body_values = child.getChildValues();
            } else if (child.getExpandedName() == type_qname(envelope.getNamespaceUri(), "Header")) {
                if (has_header || has_body) {
                    throw SOAP_DESERIALIZATION_ERROR, "SOAP Header must occur once before Body";
                }
                has_header = True;
                header_values = child.getChildValues();
            } else if (envelope.getNamespaceUri() == SOAP_11_ENV && has_body && child.getNamespaceUri()) {
                result.extensions += child;
            } else {
                throw SOAP_DESERIALIZATION_ERROR, sprintf("unexpected SOAP envelope child %y", child.getExpandedName());
            }
        }
        if (!has_body) {
            throw SOAP_DESERIALIZATION_ERROR, "missing SOAP Body";
        }
        # Check envelope structure before passing it through a native hash projection, which cannot
        # preserve duplicate singleton containers. Keep existing schema and fault handling after that.
        deserializeMessage(op, parse_xml(xml, XPF_PRESERVE_ORDER), request);
        if (message) {
            list<string> parts = description.getBodyPartNames(message) ?? keys message.pmap;
            hash<string, string> wire_parts();
            foreach string part in (parts) {
                string wire_name = message.getExpandedSerializedKey(part);
                if (wire_parts.hasKey(wire_name)) {
                    throw SOAP_DESERIALIZATION_ERROR, sprintf("ambiguous XML parts for element %y", wire_name);
                }
                wire_parts{wire_name} = part;
            }
            foreach XsdXmlValue value in (body_values) {
                *string part = remove wire_parts{value.getExpandedName()};
                if (!exists part) {
                    throw SOAP_DESERIALIZATION_ERROR, sprintf("unexpected or duplicate SOAP body element %y",
                        value.getExpandedName());
                }
                validateXmlPart(op, message, part, value);
                result.body{part} = value;
            }
            if (wire_parts) {
                throw SOAP_DESERIALIZATION_ERROR, sprintf("missing SOAP body parts: %y", keys wire_parts);
            }
        }
        hash<string, BindingMessageHeaderDescription> wire_headers();
        foreach BindingMessageHeaderDescription header in (description.getHeaders()) {
            string wire_name = header.msg.getExpandedSerializedKey(header.part);
            if (header.encoded || wire_headers.hasKey(wire_name)) {
                throw "WSDL-BINDING-ERROR", sprintf("retained XML header %y must be unambiguous and literal", wire_name);
            }
            wire_headers{wire_name} = header;
        }
        hash<string, bool> seen_headers();
        foreach XsdXmlValue value in (header_values) {
            if (!value.getNamespaceUri()) {
                throw SOAP_DESERIALIZATION_ERROR, "SOAP header blocks must be namespace-qualified";
            }
            *BindingMessageHeaderDescription header = wire_headers{value.getExpandedName()};
            if (!header) {
                result.unbound_headers += value;
                continue;
            }
            if (seen_headers{value.getExpandedName()}) {
                throw SOAP_DESERIALIZATION_ERROR, sprintf("duplicate SOAP header %y", value.getExpandedName());
            }
            seen_headers{value.getExpandedName()} = True;
            validateXmlPart(op, header.msg, header.part, value);
            result.headers{header.msg.name}{header.part} = value;
        }
        return result;
    }

    private static validateXmlPart(WSOperation op, WSMessage message, string part, XsdXmlValue value) {
        *XsdElement element = message.args{message.pmap{part}}.element;
        if (!element) {
            throw "WSDL-BINDING-ERROR", sprintf("retained XML part %y must reference an element", part);
        }
        try {
            element.validateXmlValue(value, op.nsc, message.tmap);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "PROGRAM-INTERRUPTED" || ex.err == "THREAD-CANCELLED") {
                rethrow;
            }
            throw SOAP_DESERIALIZATION_ERROR, sprintf("invalid XML for part %y: %s: %s", part, ex.err, ex.desc);
        }
    }

    auto deserializeMessageImpl(WSOperation op, hash<auto> orig_msg, bool request) {
        #printf("DEBUG: deserializeSoapMessage(%N, %y)\n", o, request);
        string io = request ? "input" : "output";
        # NOTE: types must be stripped on "o"; cannot use hash<auto> here
        hash o = orig_msg;
        XsdBase::inheritAttributeNamespaces(\o);
        WSDL::XsdBase::removeNS2(\o);
        WSDL::XsdBase::removeNS2(\o.Envelope);
        hash<string, string> envelope_namespaces = XsdBase::getElementNamespaces(o.Envelope."^attributes^");
        hash<auto> hrv;

        *BindingMessageDescription bmd = self{io};

        if (bmd && bmd.hasHeaders()) {
            *hash<auto> header = XsdScalarTextHelper::elementContent(o.Envelope.Header, "SOAP Header");
            if (header) {
                header = XsdBase::expandElementNamespaces(header, envelope_namespaces);
            }

            #printf("DEBUG: Deserialize SOAP headers: %N\n", header);
            foreach BindingMessageHeaderDescription hdr in (bmd.getHeaders()) {
                if (header.hasKey(hdr.msg.getExpandedSerializedKey(hdr.part))) {
                    # seems it may appear part name conflict between messages when namespace is stripped
                    hrv{hdr.msg.name} += hdr.msg.deserializeDocument(NOTHING, header, hdr.part, NOTHING, True);
                }
            }
            #printf("DEBUG: Deserialized SOAP headers: %N\n", hrv);
        }

        *hash<auto> body = XsdScalarTextHelper::elementContent(o.Envelope.Body, "SOAP Body");

        if (!op{io}) {
            if (exists body) {
                throw SOAP_DESERIALIZATION_ERROR, sprintf("%s value given for operation %y binding %y with no %s message: %y", request ? "request" : "response", op.name, name, io, body);
            }
        } else if (!exists body)
            throw SOAP_DESERIALIZATION_ERROR, sprintf("no %s body value given for operation %y binding %y", request ? "request" : "response", op.name, name);

        *WSMessage msg = op{io};

        auto rv;
        if (exists body) {
            (*hash<auto> mrh, hash<auto> msgh) = processMultiRef(docstyle
                ? XsdBase::expandElementNamespaces(body, envelope_namespaces) : body);

            if (!request) {
                # check for Soap Fault, if so raise an exception immediately with the fault info
                WSDL::XsdBase::removeNS2(\body);

                if (body.Fault) {
                    WSDL::XsdBase::removeNS(\body.Fault);
                    delete body.Fault.".ns";
                    if (op.nsc.hasSoap12()) {
                        WSDL::XsdBase::removeNS(\body.Fault.Code);
                        WSDL::XsdBase::removeNS(\body.Fault.Reason);
                        # remove extraneous "ns" keys
                        remove body.Fault.Code.ns;
                        remove body.Fault.Reason.ns;
                        string desc = sprintf("The following fault response was received from the server: code: %y",
                            body.Fault.Code.Value);
                        auto sc = body.Fault.Code.Subcode;
                        while (exists sc) {
                            WSDL::XsdBase::removeNS(\sc);
                            # remove extraneous "ns" keys
                            remove sc.ns;
                            desc += sprintf(", subcode: %y", sc.Value);
                            sc = sc.Subcode;
                        }
                        foreach auto rn in (body.Fault.Reason.Text) {
                            desc += sprintf(", text: %y", rn);
                        }

                        throw "SOAP-SERVER-FAULT-RESPONSE", desc, body.Fault;
                    } else {
                        string desc = sprintf("The following fault response was received from the server: code: %y",
                            body.Fault.faultcode);
                        if (exists body.Fault.faultstring)
                            desc += sprintf(", faultstring: %y", body.Fault.faultstring);
                        if (exists body.Fault.desc)
                            desc += sprintf(", desc: %y", body.Fault.desc);

                        throw "SOAP-SERVER-FAULT-RESPONSE", desc, body.Fault;
                    }
                }
            }

            #any ns = msgh.".ns";
            msgh -= ("ns", ".ns");
            if (docstyle) {
                # only the parts appearing in the SOAP body may be deserialized from it; parts bound to SOAP
                # headers are deserialized above
                rv = msg.deserializeDocument(mrh, msgh, bmd.getBodyPartNames(msg), False, True);
            } else {
                string mname = (request ? op.output_name : op.input_name) ?? (op.name + (request ? "" : "Response"));
                if (!msgh{mname})
                    throw SOAP_DESERIALIZATION_ERROR, sprintf("missing %s message name %y as top-level element; got elements: %y", io, mname, keys msgh);
                msgh = XsdScalarTextHelper::elementContent(remove msgh{mname}, "SOAP RPC wrapper");
                XsdBase::removeNS2(\msgh);
                msgh -= (".ns", "ns");

                rv = msg.deserializeRpc(mrh, msgh);
            }
        }

        if (exists hrv) {
            # for backwards compatibility with a flat hash when there was only argument
            # but we must be care of when the argument is a type (not element)
            if (rv.size() == 1 && rv.typeCode() == NT_HASH && !exists hrv{rv.firstKey()} ) {
                rv = rv.firstValue();
            } else {
                foreach string k in (keys hrv) {
                    if (exists rv{k}) {
                        # name conflict
                        rv{msg.name} = rv;
                        break;
                    }
                }
            }
            rv += hrv;
        } else if (exists rv ) {
            # for backwards compatibility with a flat hash when there was only argument
            # but we must be care of when the argument is a type (not element)
            if (rv.size() == 1 && rv.typeCode() == NT_HASH) {
                rv = rv.firstValue();
            }
        }

        return rv;
    }

    #! processes multi-part references and returns a hash of multi-part reference info and the updated message body hash
    private:internal static list<auto> processMultiRef(hash<auto> body) {
        # setup message info hash and multiRef lookup hash key, if any are present
        hash<auto> mrh = {
            # save original msg body hash
            "body": body,
        };
        # remove namespace prefixes from body element keys
        WSDL::XsdBase::removeNS2(\mrh.body);

        # issue #2902: get all multiref elements with an "id" tag
        # SOAP 1.1 Section 5.4.1 defines multiref elements with:
        # - id: unique identifier for the element
        # - root: "1" = root element, "0" = not a root (referenced only), absent = may be root
        # - xsi:type: polymorphic type indicator
        foreach hash<auto> hh in (body.pairIterator()) {
            if (!exists hh.value."^attributes^".id) {
                continue;
            }
            hash<auto> h = remove body{hh.key};
            hash<auto> attrs = h."^attributes^";
            string id = remove h."^attributes^".id;

            # Process root attribute (SOAP 1.1 Section 5.4.1)
            # root="1" means this is a root element, root="0" means it's only referenced
            # If absent, the element may be a root
            *string rootAttr = attrs.root;
            if (rootAttr == "1") {
                # This is explicitly marked as a root element - keep track of it
                mrh.rootIds{id} = True;
            }
            remove h."^attributes^".root;

            # Process xsi:type attribute for polymorphic type resolution
            # Store the type info for use during deserialization
            *string xsiType = attrs."xsi:type";
            if (xsiType) {
                mrh.typeMap{id} = xsiType;
            }

            mrh.mrh{id} = h;
        }

        # resolve interior references to multiRefs
        foreach string id in (keys mrh.mrh) {
            foreach string key in (keys mrh.mrh{id}) {
                if (key == "^attributes^")
                    continue;

                #printf("multiRef id: %y key: %y val: %y\n", id, key, mrh.mrh{id}{key});

                if (mrh.mrh{id}{key}.typeCode() == NT_LIST) {
                    foreach auto e in (\mrh.mrh{id}{key}) {
                        auto href = substr(e."^attributes^".href, 1);
                        if (exists href) {
                            if (!exists mrh.mrh{href})
                                throw "INVALID-MULTIREF", sprintf("multiRef id: %y does not exist", href);
                            e = mrh.mrh{href};
                        }
                    }
                } else if (mrh.mrh{id}{key}.typeCode() == NT_HASH) {
                    auto href = substr(mrh.mrh{id}{key}."^attributes^".href, 1);
                    if (exists href) {
                        if (!exists mrh.mrh{href})
                            throw "INVALID-MULTIREF", sprintf("multiRef id: %y does not exist", href);
                        mrh.mrh{id}{key} = mrh.mrh{href};
                    }
                }
            }
        }

        #printf("mrh: %y\n", mrh.mrh);
        #printf("operation: %y\n", self);

        # remove namespace tags from element names
        WSDL::XsdBase::removeNS2(\body);
        remove body.".ns";

        return (mrh, body);
    }

    hash<auto> deserializeRequestPathImpl(WSOperation op, string path) {
        throw SOAP_DESERIALIZATION_ERROR, sprintf("cannot deserialize URI request path %y for SOAP binding %y", path, name);
    }
}

public class HttpBinding inherits WSDL::OperationalBinding {
    public {
        string httpMethod;
        string location;
    }

    constructor(string name, string ns, bool docstyle, string httpMethod, string location, *string soapAction,
            *WSDL::BindingMessageDescription input, *WSDL::BindingMessageDescription output)
            : OperationalBinding(name, ns, docstyle, soapAction, input, output) {
        self.httpMethod = httpMethod;
        self.location = location;
    }

    hash<auto> serializeMessageImpl(WSOperation op, *WSMessage msg, bool request, bool soap12, auto h,
            *hash<auto> header, string enc, *hash<auto> nsh, *int xml_opts, *string req_soapaction, *string faultmsg,
            *hash<auto> http_headers) {
        hash<auto> rv;

        if (request) {
            # make sure that rv stays hash<auto> instead of hash<string, string>
            rv = hash({
                "path": serializeRequestPath(op, h),
                "method": httpMethod,
            });
        }

        string io = request ? "input" : "output";

        string ct;

        *BindingMessageDescription bmd = self{io};
        if (!bmd) {
            throw SOAP_SERIALIZATION_ERROR, sprintf("no %s message description for message %y", io, name);
        }

        if (!msg && (bmd.content || bmd.mimeXml))
            throw SOAP_SERIALIZATION_ERROR, sprintf("%s value given for operation %y with no %s message: %y",
                request ? "request" : "response", name, io, h);

        if (bmd.content.formUrlEncoded) {
            ct = MimeTypeFormUrlEncoded;
            # application/x-www-form-urlencoded Content-Type does not have any parameters
            delete enc;
            # Non-ASCII characters (> 127) are properly percent-encoded as UTF-8 bytes
            # per https://www.w3.org/TR/html5/forms.html#application/x-www-form-urlencoded-encoding-algorithm
            rv.body = mime_get_form_urlencoded_string(msg.serializeAllPartData(h));
        } else if (bmd.content) {
            hash<auto> v = msg.serializeData(op.nsc, bmd.content.part, h);
            if (v."content-type") {
                if (!bmd.content.acceptAllContentTypes) {
                    WsdlLibPriv::checkContentType(v."content-type", bmd.content.acceptedContentTypeSubtypes
                        + bmd.content.acceptedContentTypes);
                }
                ct = v."content-type";
            } else {
                if (bmd.content.acceptAllContentTypes || bmd.content.acceptedContentTypes
                    || bmd.content.acceptedContentTypeSubtypes.size() != 1) {
                    throw SOAP_SERIALIZATION_ERROR, sprintf("ambiguous content type in message %y related to %s "
                        "operation %y", msg.name, io, op.name);
                }
                ct = bmd.content.acceptedContentTypeSubtypes[0];
            }
            if (v.value.typeCode() == NT_BINARY) {
                delete enc;
                rv.body = v.value;
            } else {
                rv.body = convert_encoding(v.value, enc);
            }
        } else if (bmd.mimeXml) {
            ct = MimeTypeXml;
            # in case of mimeXml is body content, i.e. XML tag based on element/type name, not part
            string ons;
            hash<auto> hh;
            hh{msg.getSerializedKey(bmd.mimeXml.part)} = msg.serializeRpcValue(bmd.mimeXml.part, False, \h, \ons);
            rv.body = make_xml(hh);
        }

        # add request headers if necessary
        if (request) {
            if (output.content) {
                if (output.content.acceptAllContentTypes) {
                    rv.accept = "*/*";
                } else {
                    softlist<auto> l = output.content.acceptedContentTypeSubtypes;
                    map l += $1 + "*", output.content.acceptedContentTypes;
                    rv.accept = foldl $1 + "," + $2, l;
                }
            } else if (output.mimeXml) {
                rv.accept = MimeTypeXml;
            }
        }

        if (exists rv.body && exists ct) {
            if (exists enc) {
                ct += sprintf(";charset=%s", enc);
            }
            rv.hdr."Content-Type" = ct;
        }

        if (rv.accept) {
            rv.hdr."Accept" = rv.accept;
        }

        rv.hdr += http_headers;

        return rv;
    }

    #! serializes path part of URL when urlEncoded WSDL is defined
    private:internal string serializeRequestPath(WSOperation op, auto h) {
        string path = location;
        if (input.urlReplacement) {
            path = "";
            foreach string k in (keys input.urlReplacement) {
                if (k =~ /^string/) {
                    path += input.urlReplacement{k};
                } else if (k =~ /^part/) {
                    if (!op.input) {
                        throw SOAP_SERIALIZATION_ERROR, sprintf("url replacement requested for operation %s with no message (%y)", op.name, h);
                    }
                    hash<auto> v = op.input.serializeData(op.nsc, input.urlReplacement{k}, h);
                    path += encode_url(string(v.value), True);
                }
            }
        } else if (input.urlEncoded) {
            string s = mime_get_form_urlencoded_string(op.input.serializeAllPartData(h));
            if (s) {
                path += location =~ /\?/ ? "&" : "?";
                path += s;
            }
        }

        return path;
    }

    auto deserializeMessageImpl(WSOperation op, hash<auto> v, bool request) {
        string io = request ? "input" : "output";

        *BindingMessageDescription bmd = self{io};
        if (!bmd) {
            if (!v.body.val()) {
                return;
            }
            throw SOAP_DESERIALIZATION_ERROR, sprintf("no %s message description for message %y", io, name);
        }

        *string ct = v."content-type";
        if (!exists ct && !bmd.mimeXml) {
            throw SOAP_DESERIALIZATION_ERROR, sprintf("missing content-type in input hash: %y", v);
        }

        if (bmd.urlEncoded || bmd.urlReplacement) {
            # is should be processed via deserializeUrl()
            throw SOAP_DESERIALIZATION_ERROR, sprintf("urlencoded message deserialization is not supported in "
                "binding: %y", name);
        }

        if (!op{io} && (bmd.content || bmd.mimeXml))
            throw SOAP_DESERIALIZATION_ERROR, sprintf("%s value given for operation %y with no %s message: %y",
                request ? "request" : "response", name, io, v);

        *WSMessage msg = op{io};

        if (bmd.content.formUrlEncoded) {
            WsdlLibPriv::checkContentType(ct, list(MimeTypeFormUrlEncoded));
            if (v.body.typeCode() == NT_BINARY) {
                v.body = binary_to_string(v.body);
            }
            hash<auto> h = mime_parse_form_urlencoded_string(v.body); # TODO: data have no encoding
            return msg.deserializeAllPartData(h);
        }

        if (bmd.content) {
            if (!bmd.content.acceptAllContentTypes) {
                WsdlLibPriv::checkContentType(ct,
                    bmd.content.acceptedContentTypeSubtypes + bmd.content.acceptedContentTypes);
            }
            hash<auto> v2;
            v2{bmd.content.part} = v.body;
            hash<auto> h = msg.deserializeData(bmd.content.part, v2);
            string k = h.firstKey();
            h{k}."^value^" = remove h{k};
            h{k}."^attributes^"."^content-type^" = ct;
            return h;
        }

        if (bmd.mimeXml) {
            *hash<auto> h = msg.deserializeData(bmd.mimeXml.part, v);
            return h;
        }
    }

    hash<auto> deserializeRequestPathImpl(WSOperation op, string path) {
        if (input.urlReplacement) {
            # Parse URL replacement parameters from path
            # urlReplacement hash contains alternating string literals and part names:
            # {"string^1": "/api/users/", "part^2": "userId", "string^3": "/profile/", ...}
            hash<auto> values;
            int pos = 0;

            foreach string k in (keys input.urlReplacement) {
                if (k =~ /^string/) {
                    # String literal - must match exactly at current position
                    string expected = input.urlReplacement{k};
                    if (substr(path, pos, expected.size()) != expected) {
                        throw SOAP_DESERIALIZATION_ERROR, sprintf("URL replacement mismatch at position %d: "
                            "expected %y, path: %y", pos, expected, path);
                    }
                    pos += expected.size();
                } else if (k =~ /^part/) {
                    # Part value - extract until next string literal or end of path
                    string partName = input.urlReplacement{k};

                    # Find the next string literal to know where this part value ends
                    *string nextLiteral;
                    bool foundNext = False;
                    foreach string k2 in (keys input.urlReplacement) {
                        if (foundNext && k2 =~ /^string/) {
                            nextLiteral = input.urlReplacement{k2};
                            break;
                        }
                        if (k2 == k) {
                            foundNext = True;
                        }
                    }

                    int endPos;
                    if (nextLiteral) {
                        endPos = index(path, nextLiteral, pos);
                        if (endPos < 0) {
                            throw SOAP_DESERIALIZATION_ERROR, sprintf("URL replacement: cannot find delimiter %y "
                                "after position %d in path: %y", nextLiteral, pos, path);
                        }
                    } else {
                        # No next literal - value goes to end of path (excluding query string)
                        endPos = index(path, "?", pos);
                        if (endPos < 0) {
                            endPos = path.size();
                        }
                    }

                    string partValue = decode_url(substr(path, pos, endPos - pos));
                    values{partName} = partValue;
                    pos = endPos;
                }
            }

            return op.input.deserializeAllPartData(values);
        }
        if (input.urlEncoded) {
            hash<auto> h;
            if (index(path, "?") >= 0) {
                # any params ?
                int i = index(path, location);
                if (i >= 0) {
                    # strip potential prefix in URL params
                    path = substr(path, i + location.size());
                }
                # all parameters are in URL
                i = index(path, "?");
                if (i >= 0) {
                    path = substr(path, i+1);
                }
                i = 0;
                while (path[i] == "&") {
                    i++;
                }
                if (i) {
                    path = substr(path, i);
                }
                if (path != "") {
                    h = mime_parse_form_urlencoded_string(path);
                    return op.input.deserializeAllPartData(h);
                }
            }
            return {};
        }
        throw SOAP_DESERIALIZATION_ERROR, sprintf("BUG: cannot deserialize URI request path %y for HTTP binding %y", path, name);
    }
}

#! describes the message body for a SOAP operational binding message description
/** @see https://www.w3.org/TR/wsdl#_soap:body
*/
public class BindingMessageBodyDescription inherits Serializable {
    public {
        #! required attribute
        /** if @ref Qore::True "True", then use = \c "encoded" (each message part references an abstract type using the \c type attribute),
            otherwise use = \c "literal" (each part references a concrete schema definition using either the \c element or \c type attribute)
         */
        bool encoded;

        #! when encoded @ref Qore::True "True", this is used to produce a concrete message by applying the specified encoding
        *string encodingStyle;

        #! namespace; "only applies to content not explicitly defined by the abstract types"
        *string ns;

        #! indicates which parts appear somewhere within the SOAP Body portion of the message
        *list<auto> parts;
    }

    constructor(bool encoded, *string encodingStyle, *string ns, *string parts) {
        self.encoded = encoded;
        self.encodingStyle = encodingStyle;
        self.ns = ns;
        # get a list of strings ignoring whitespace
        if (parts.val())
            self.parts = select (map trim($1), parts.split(" ")), $1.val();
    }

    bool isMultipart() {
        return False;
    }
}

#! describes a SOAP message header for a SOAP operational binding message description
public class BindingMessageHeaderDescription inherits Serializable {
    public {
        #! message part name
        string part;

        #! required attribute
        /** if @ref Qore::True "True", then use = \c "encoded" (each message part references an abstract type using the \c type attribute),
            otherwise use = \c "literal" (each part references a concrete schema definition using either the \c element or \c type attribute)
            */
        bool encoded;

        #! a weak reference to the actual message
        WSMessage msg;
    }

    #! creates the object
    /*
        @param part message part name
        @param encoded if @ref Qore::True "True", then use = \c "encoded" (each message part references an abstract type using the \c type attribute), otherwise use = \c "literal" (each part references a concrete schema definition using either the \c element or \c type attribute)
        @param msg actual message
    */
    constructor(string part, bool encoded = False, WSMessage msg) {
        self.part = part;
        self.encoded = encoded;
        self.msg := msg;
    }
}

#! describes MIME content information for SOAP operational binding message descriptions
/** @see https://www.w3.org/TR/wsdl#_mime:content
 */
public class BindingContentDescription inherits Serializable {
    public {
        #! specifies the name of the message part
        string part;

        # list of accepted content types (with "xxx/*")
        list<auto> acceptedContentTypes = ();

        # list of accepted specific content types
        list<auto> acceptedContentTypeSubtypes = ();

        #! are all content-types form URL encoded?
        bool formUrlEncoded = False;

        #! are all content-types accepted?
        bool acceptAllContentTypes = False;
    }

    addContentType(string type) {
        bool isFormUrlEncoded = (type == MimeTypeFormUrlEncoded);
        if (isFormUrlEncoded && (acceptedContentTypes || acceptedContentTypeSubtypes))
            throw WSDL_ERROR, sprintf("%y content type cannot be declared with other content-types: %y", MimeTypeFormUrlEncoded, (acceptedContentTypes + acceptedContentTypeSubtypes));
        if (!isFormUrlEncoded && formUrlEncoded)
            throw WSDL_ERROR, sprintf("%y content type cannot be declared in conjunction with the %y content-type (this last type cannot be mixed with other types)", type, MimeTypeFormUrlEncoded);
        if (isFormUrlEncoded && !formUrlEncoded)
            formUrlEncoded = True;

        if (!type || type == "*/*") {
            acceptAllContentTypes = True;
            return;
        }

        hash<auto> act;

        list<auto> st = type.split("/");
        if (st.size() != 2)
            throw WSDL_ERROR, sprintf("Content type %y does not match 'type/subtype' pattern", type);
        if (bindex(st[0], "*") != -1)
            throw WSDL_ERROR, sprintf("Content type %y contains unexpected asterisk in type part", type);

        act.type = st[0];

        # check for a wildcard
        if (st[1] == "*") {
            acceptedContentTypes += (st[0] + "/");
            return;
        }

        if (bindex(st[1], "*") != -1) {
            throw WSDL_ERROR, sprintf("Content type %y contains unexpected asterisk in subtype part", type);
        }

        acceptedContentTypeSubtypes += (st[0] + "/" + st[1]);
    }
}

#! describes a mimeXml payload for a SOAP operational binding message description
/** @see https://www.w3.org/TR/wsdl#_mime:mimeXml
 */
public class MimeXmlMessageDescription inherits Serializable {
    public {
        #! refers to a message part defining the concrete schema of the root XML element
        /** The part references a concrete schema using the element attribute for simple parts or type attribute for composite parts
         */
        string part;
    }

    constructor(string part) {
        self.part = part;
    }
}

#! describes an input or output message in a SOAP operational binding
public class BindingMessageDescription inherits Serializable {
    public {
        #! the description of the message body
        *WSDL::BindingMessageBodyDescription body;

        #! a hash of URL replacement values keyed by part name, values are URI paths
        /** @note for HTTP bindings only
         */
        *hash<auto> urlReplacement;

        #! indicates that all the message parts are encoded into the HTTP request URI using the standard URI-encoding rules
        /** ex: name1=value&name2=value...

            The names of the parameters correspond to the names of the message parts.
            Each value contributed by the part is encoded using a name=value pair.
            This may be used with GET to specify URL encoding, or with POST to specify a FORM-POST.
            For GET, the "?" character is automatically appended as necessary.

            @note for HTTP bindings only

            @see https://www.w3.org/TR/wsdl#_http:urlEncoded
         */
        bool urlEncoded = False;

        #! optional content-type descriptions
        *WSDL::BindingContentDescription content;

        #! optional mimeXml message scription
        *WSDL::MimeXmlMessageDescription mimeXml;

        #! multipart type (e.g., Mime::MPT_RELATED) if multipartRelated binding is used
        /** @see https://www.w3.org/TR/wsdl#_mime:multipartRelated
        */
        *string multipart;

        #! hash of part names to content types for multipart messages
        /** Keys are part names, values are content type strings or lists of content type strings
        */
        *hash<auto> parts;
    }

    private:internal {
        #! a list of WSDL::BindingMessageHeaderDescription objects
        list<BindingMessageHeaderDescription> headers = cast<list<BindingMessageHeaderDescription>>(());
    }

    addHeader(BindingMessageHeaderDescription hdr) {
        headers += hdr;
    }

    #! returns @ref Qore::True "True" if the header descriptions are available
    bool hasHeaders() {
        return !headers.empty();
    }

    #! returns a list of WSDL::BindingMessageHeaderDescription objects
    list<BindingMessageHeaderDescription> getHeaders() {
        return headers;
    }

    #! returns the names of the message parts that appear in the SOAP body
    /** if the \c parts attribute is given in the \c soap:body element, then it determines the body parts, otherwise
        all parts of the message that are not bound to a SOAP header appear in the body

        @param msg the message bound to this description

        @return the names of the parts appearing in the SOAP body, or \c NOTHING if all parts of the message
        appear in the body

        @see https://www.w3.org/TR/wsdl#_soap:body

        @since %WSDL 0.5.8
    */
    *list<string> getBodyPartNames(WSMessage msg) {
        if (body.parts) {
            return map $1, body.parts;
        }
        # parts bound to a header of the same message do not appear in the body
        hash<string, bool> hdr_parts;
        map hdr_parts{$1.part} = True, headers, $1.msg.name == msg.name;
        if (!hdr_parts) {
            return;
        }
        return select keys msg.pmap, !hdr_parts{$1};
    }

    setUrlReplacement(string loc) {
        int i = 0;
        while (i < loc.size()) {
            int j = index(loc, "(", i);
            if (j < 0) {
                j = loc.size();
            }
            if (j > i) {
                urlReplacement{sprintf("string^%d", urlReplacement.size() + 1)} = substr(loc, i, j - i);
            }
            if (j < loc.size()) {
                i = j + 1;
                j = index(loc, ")", i);
                if (j == i) {
                    throw WSDL_ERROR, sprintf("empty replace token in %y near %y", loc, substr(loc, i-1, loc.size()));
                } else if (j < 0) {
                    throw WSDL_ERROR, sprintf("missing close parentheses in %y near %y", loc, substr(loc, i-1, loc.size()));
                }
                string p = substr(loc, i, j-i);
                # if (messages)   TODO test messages / part here probably not ?
                urlReplacement{sprintf("part^%d", urlReplacement.size() + 1)} = p;
                ++j;
            }
            i = j;
        }
    }
}

#! class for WSDL bindings
public class Binding inherits WSDL::XsdNamedData {
    private:internal {
        string port;

        #! use RPC or document style
        /** according to https://www.w3.org/TR/wsdl#_soap:operation
            'If the soap:binding element does not specify a style, it is assumed to be "document".'
         */
        bool docstyle = True;

        *string httpMethod;
        *string soapTransport;
    }

    constructor(hash<auto> data, Namespaces nsc, reference portTypes, reference idocmap, *hash<auto> messages) : XsdNamedData(\data) {
        # get binding attributes
        {
            *hash<auto> ba = data."^attributes^";

            (*string ns, *string prt) = ba.type =~ x/(?:([^:]+):)?([^:]+)/;
            if (!prt)
                throw WSDL_ERROR, sprintf("missing port type for binding %y", name);
            port = prt;
        }

        if (data.binding) {
            *hash<auto> bba = data.binding."^attributes^";
            if (bba.verb) {
                # HTTP binding
                httpMethod = bba.verb;
            }

            if (bba.transport) {
                # SOAP binding
                if (!SOAP_TRANSPORT.(bba.transport))
                    throw WSDL_ERROR, sprintf("unsupported transport %y in binding %y (known transports: %y)", bba.transport, name, SOAP_TRANSPORT.keys());
                soapTransport = bba.transport;
            }
            if (!soapTransport && !httpMethod)
                throw WSDL_ERROR, sprintf("missing SOAP verb or transport in binding %y (known SOAP transports: %y)", name, SOAP_TRANSPORT.keys());

            if (exists bba.style) {
                *bool ds = SoapStyleMap{bba.style};
                if (!exists ds)
                    throw WSDL_ERROR, sprintf("invalid '\"style\" attribute %y in binding %y; expected one of: %y", bba.style, name, SoapStyleMap.keys());
                if (!ds)
                    docstyle = False;
            }

            hash<string, string> nsh;
            # issue #2858: add any XML namespaces to namespace object here
            foreach hash<auto> h in (bba.pairIterator()) {
                if (h.key =~ /^xmlns:/) {
                    nsh{h.key} = h.value;
                }
            }
            if (nsh) {
                nsc.addNamespaces(nsh);
            }
        }

        foreach hash<auto> ophash in (data.operation) {
            string opname = ophash."^attributes^".name;
            if (!exists portTypes{port}.operations{opname})
                throw WSDL_ERROR, sprintf("binding %y references unknown porttype %y operation %y", name, port, opname);

            WSDL::XsdBase::removeNS(\ophash);

            bool b_docstyle = docstyle;

            *hash<auto> opah = ophash.operation."^attributes^";
            *string soapAction = opah.soapAction;
            if (!exists soapAction) {
                *string op_ns = portTypes{port}.operations{opname}.nsc.getTargetNamespaceUri();
                if (op_ns && op_ns !~ /\/$/)
                    op_ns += "/";
                soapAction = op_ns ? op_ns + opname : opname;
            }

            {
                *string style = opah.style;
                if (exists style) {
                    *bool ds = SoapStyleMap{style};
                    if (!exists ds)
                        throw WSDL_ERROR, sprintf("invalid '\"style\" attribute %y in binding %y operation %y; expected one of: %y", style, name, opname, SoapStyleMap.keys());
                    b_docstyle = ds;
                }
            }

            if (b_docstyle)
                portTypes{port}.operations{opname}.setDocStyleBinding(\idocmap);
            else
                portTypes{port}.operations{opname}.markRpcStyleBinding();

            *string location;

            if (httpMethod) {
                location = ophash.operation."^attributes^".location;
                if (!location) {
                    throw WSDL_ERROR, sprintf("location is missing binding %y, operation %y", name, opname);
                }
            }

            # input/output hash
            hash<auto> ioh;
            hash<auto> op = remove ophash{"input", "output"};

            foreach string io in (keys op) {
                WSDL::XsdBase::removeNS(\op{io});
                if (!exists portTypes{port}.operations{opname}{io}) {
                    *hash<auto> hk = map {$1: True}, keys op{io};
                    remove hk.("header", "ns");
                    if (hk)
                        throw WSDL_ERROR, sprintf("binding %y for operation %y does not reference %s message in porttype %y",  name, opname, io, port);
                }

                BindingMessageDescription bmd();

                if (exists op{io}.body) {
                    hash<auto> bh = remove op{io}.body;
                    *hash<auto> pa = bh."^attributes^";

                    *bool encoded = SoapUseMap{pa.use};
                    if (!exists encoded)
                        throw WSDL_ERROR, sprintf("binding %y for operation %y for the %s message has an invalid 'use' attribute: %y", name, opname, io, pa.use);

                    bmd.body = new BindingMessageBodyDescription(encoded, pa.encodingStyle, pa."namespace", pa.parts);
                }

                if (exists op{io}.multipartRelated) {
                    if (bmd.body) {
                        throw WSDL_ERROR, sprintf("%s binding %y for operation %y specifies both body and "
                            "multipart elements", io, name, opname);
                    }

                    bmd.multipart = Mime::MPT_RELATED;
                    bmd.parts = {};
                    WSDL::XsdBase::removeNS(\op{io}.multipartRelated);

                    if (!exists op{io}.multipartRelated.part) {
                        throw WSDL_ERROR, sprintf("binding %y is missing part definition(s) in %s message "
                            "definition for operation %y: %y", name, io, opname, op);
                    }

                    foreach auto part in (op{io}.multipartRelated.part) {
                        WSDL::XsdBase::removeNS(\part);
                        part -= "^attributes^";
                        if (exists part.body) {
                            if (bmd.body) {
                                throw WSDL_ERROR, sprintf("%s binding %y for operation %y specifies multiple "
                                    "body parts in multipart elements", io, name, opname);
                            }
                            auto bodyAttrs = part.body."^attributes^";
                            if (bodyAttrs.use != "literal") {
                                throw WSDL_ERROR, sprintf("unsupported body part without use=\"literal\": %y",
                                    part.body);
                            }
                            # Create body description for the SOAP body part within multipart message
                            bmd.body = new BindingMessageBodyDescription(False, NOTHING, NOTHING,
                                bodyAttrs.parts);
                        } else if (exists part.content) {
                            *string pcname;
                            foreach auto c in (part.content) {
                                WSDL::XsdBase::removeNS(\c);
                                auto contentAttrs = c."^attributes^";
                                auto partName = contentAttrs.part;
                                if (!exists partName) {
                                    throw WSDL_ERROR, sprintf("unsupported content part without part "
                                        "attribute: %y", c);
                                }
                                if (pcname) {
                                    if (pcname != partName) {
                                        throw WSDL_ERROR, sprintf("multiple content part names inside part "
                                            "section: %y!=%y", partName, pcname);
                                    }
                                } else {
                                    pcname = partName;
                                    partName = portTypes{port}.operations{opname}{io}.checkPart(partName);
                                }
                                auto contentType = contentAttrs.type;
                                if (!exists contentType) {
                                    throw WSDL_ERROR, sprintf("unsupported content part without type "
                                        "attribute: %y", c);
                                }

                                if (!exists bmd.parts{partName}) {
                                    bmd.parts{partName} = contentType;
                                } else {
                                    if (bmd.parts{partName}.typeCode() != NT_LIST) {
                                        bmd.parts{partName} = list(bmd.parts{partName});
                                    }
                                    bmd.parts{partName} += contentType;
                                }
                            }
                        } else {
                            throw WSDL_ERROR, sprintf("cannot parse part: %y", part);
                        }
                    }
                    delete op{io}.multipartRelated;
                }

                if (exists op{io}.header) {
                    foreach hash<auto> hdr in (op{io}.header) {
                        *hash<auto> ma = hdr."^attributes^";

                        if (!ma.message)
                            throw WSDL_ERROR, sprintf("%s binding %y for operation %y specifies a soap header element without a 'message' attribute (attr: %y)", io, name, opname, ma);

                        hash<auto> h = nsc.getTypeHash(ma.message);
                        *WSMessage msg = messages.(h.val);
                        if (!msg)
                            throw WSDL_ERROR, sprintf("%s binding %y for operation %y references unknown message %y in the soap header element", io, name, opname, h.val);

                        string part = checkMessagePart(msg, ma.part, sprintf("header %s operation %y", io, opname));

                        *bool encoded = SoapUseMap{ma.use};
                        if (!exists encoded)
                            throw WSDL_ERROR, sprintf("binding %y for operation %y for the %y header of the %s message has an invalid 'use' attribute: %y", name, opname, ma.part, io, ma.use);

                        #printf("DEBUG: match part to message: %y, part: %y\n", msg.name, part);
                        bmd.addHeader(new BindingMessageHeaderDescription(part, encoded, msg));
                    }
                    delete op{io}.header;
                }

                if (op{io}.hasKey("urlReplacement")) {
                    if (!location)
                        throw WSDL_ERROR, sprintf("%s binding %y for operation %y has a 'urlReplacement' element but does not use HTTP binding", io, name, opname);

                    bmd.setUrlReplacement(location);
                    delete op{io}.urlReplacement;
                }

                if (op{io}.hasKey("urlEncoded")) {
                    if (!location)
                        throw WSDL_ERROR, sprintf("%s binding %y for operation %y has a 'urlEncoded' element but does not use HTTP binding", io, name, opname);

                    bmd.urlEncoded = True;
                    delete op{io}.urlEncoded;
                }

                if (exists op{io}.content) {
                    BindingContentDescription bcd();

                    foreach auto cnt in (op{io}.content) {
                        WSDL::XsdBase::removeNS(\cnt);
                        cnt = remove cnt."^attributes^";

                        bcd.addContentType(cnt.type);

                        if (bcd.formUrlEncoded)
                            continue;

                        string part = checkMessagePart(portTypes{port}.operations{opname}{io}, cnt.part, sprintf("content %s operation %y", io, opname));
                        if (exists bcd.part) {
                            if (bcd.part != part) {
                                throw WSDL_ERROR, sprintf("ambiguous part %y in message %y in binding %y for %s operation %y", part, portTypes{port}.operations{opname}{io}.name, name, io, opname);
                            }
                        } else {
                            bcd.part = part;
                        }
                    }

                    bmd.content = bcd;
                    delete op{io}.content;
                }

                if (op{io}.hasKey("mimeXml")) {
                    string part = checkMessagePart(portTypes{port}.operations{opname}{io}, ioh{io}.mimeXml."^attributes^".part, sprintf("%s operation %y", io, opname));
                    bmd.mimeXml = new MimeXmlMessageDescription(part);
                    delete op{io}.mimeXml;
                }

                delete op{io}.("^attributes^", "ns");

                if (op{io}) {
                    throw WSDL_ERROR, sprintf("unknown element(s) in binding %y for %s operation %y: %y", name, io, opname, keys op{io});
                }

                ioh{io} = bmd;
            }

            if (ioh.output.content.formUrlEncoded) {
                throw WSDL_ERROR, sprintf("%y type is not supported as output type in binding %y for output operation %y", MimeTypeFormUrlEncoded, name, opname);
            }

            OperationalBinding b = soapTransport
                ? new SoapBinding(name, ophash.ns ?? "", b_docstyle, soapTransport, soapAction, ioh.input, ioh.output)
                : new HttpBinding(name, ophash.ns ?? "", b_docstyle, httpMethod, location, soapAction, ioh.input, ioh.output);

            portTypes{port}.operations{opname}.addBinding(b);
        }

        #binding = data;
    }

    #! check if part exists in massage, if part is empty and message contains single part then return it otherwise raise an exception
    private:internal string checkMessagePart(WSMessage msg, *string partname, string errs) {
        if (exists partname) {
            msg.checkPart(partname);
            return partname;
        }
        if (msg.pmap.size() == 1) {  # some args may be defined without part name so use pmap to test
            return msg.pmap.firstKey();
        } else {
            throw WSDL_ERROR, sprintf("message %y must have exactly one part to resolve the part name with binding "
                "%y: %s (parts: %y args: %y)", msg.name, name, errs, keys msg.pmap, keys msg.args);
        }
    }

    string getPort() {
        return port;
    }

    bool isSoapBinding() {
        return exists soapTransport;
    }

    bool isHttpBinding() {
        return exists httpMethod;
    }
}

# private namespace prefix redefinition class
class NamespacePrefixHelper {
    public {
    }

    private {
        #! namespaces data
        Namespaces nsc;

        # complete input maps before entering this declaration's scope
        hash<string, hash<string, string>> input_state;
        bool active = False;

        # overridden target namespace
        bool targ_ns;

        # overridden default namespace
        bool def_ns;

        # schema description
        string desc;

        #! schema internal ID
        int id = ++count;

        #! schema ID counter
        static int count = 0;
    }

    constructor(Namespaces nsc, *hash<auto> nsattr, bool schema_scope = False) {
        self.nsc := nsc;
        input_state = nsc.getInputNamespaceState();
        active = True;
        on_error restore();

        if (schema_scope) {
            nsc.pushSchemaTargetNamespace(nsattr.targetNamespace);
            targ_ns = True;
        }
        if (nsattr) {
            nsc.addNamespaces(nsattr, self);
            if (nsattr.targetNamespace && !schema_scope) {
                nsc.pushTargetNamespace(nsattr.targetNamespace);
                targ_ns = True;
                desc = sprintf("schema-%d-targetNamespace:%s", id, nsattr.targetNamespace);
            }
            if (exists nsattr.xmlns) {
                nsc.pushDefaultNamespace(nsattr.xmlns);
                def_ns = True;
                if (!desc) {
                    desc = sprintf("schema-%d-xmlns:%s", id, nsattr.xmlns);
                }
            }
        }

        if (!desc) {
            desc = sprintf("schema-%d", id);
        }
    }

    destructor() {
        restore();
    }

    private restore() {
        if (!active) {
            return;
        }
        active = False;
        if (def_ns) {
            nsc.popDefaultNamespace();
        }
        if (targ_ns) {
            nsc.popTargetNamespace();
        }
        nsc.restoreInputNamespaceState(input_state);
    }

    string getDesc() {
        return desc;
    }
}

#! namespace container class
public class Namespaces inherits Serializable {
    public {
        # options are here since this object is passed through all serialization and deserialization
        bool opt_empty_string_is_nothing = False;
        bool opt_allow_any_header = False;

        #! attribute form default in the schema currently being constructed
        /** @since %WSDL 0.5.8 */
        string attribute_form_default = "unqualified";

        #! schema component namespaces allowed by the source currently being constructed
        /** This construction scope includes the target namespace, declared imports and builtin XSD types.
            NOTHING outside schema construction preserves general QName expansion for public callers.
            @since %WSDL 0.5.8
        */
        *hash<string, bool> schema_reference_namespaces;
    }

    private {
        #! maps output namespace prefixes to namespace URIs
        hash<string, string> ns = {
            "xsd": XSD_NS,
        };

        #! maps namespace URIs to output namespace prefixes
        hash<string, string> nsr = {
            XSD_NS: "xsd",
        };

        #! hash for valid XSD namespaces, maps input namespace prefixes -> True if it refers to an XSD schema
        hash<string, bool> xsd_schema();

        #! hash mapping input namespace prefixes to namespaces URIs
        hash<string, string> imap();

        #! hash mapping input namespace URIs to input namespace prefixes
        hash<string, string> imapr();

        #! if True then has SOAP 1.1
        bool hassoap11 = False;

        #! if True then has SOAP 1.2
        bool hassoap12 = False;

        #! current target namespace
        *string target_ns;

        #! target namespace stack;
        list<auto> nss = ();

        #! default namespace for unprefixed definitions
        *string default_ns;

        # No-namespace QName references in a chameleon document adopt its including namespace.
        *string chameleon_ns;

        #! default namespace stack;
        list<auto> dss = ();

        #! base type map
        hash<string, XsdBaseType> base_types;

        # XML 1.0 (Fifth Edition), productions 4/4a with ':' excluded for NCName.
        const NCNameStart = 'A-Z_a-z\x{C0}-\x{D6}\x{D8}-\x{F6}\x{F8}-\x{2FF}\x{370}-\x{37D}'
            + '\x{37F}-\x{1FFF}\x{200C}-\x{200D}\x{2070}-\x{218F}\x{2C00}-\x{2FEF}'
            + '\x{3001}-\x{D7FF}\x{F900}-\x{FDCF}\x{FDF0}-\x{FFFD}\x{10000}-\x{EFFFF}';
        const NCNameRegex = '\A[' + NCNameStart + '][' + NCNameStart
            + '\-.0-9\x{B7}\x{300}-\x{36F}\x{203F}-\x{2040}]*\z';

        #! maps namespaces to default prefixes
        const DefaultPrefixes = {
            SOAP_ENCODING: "soapenc",
            XSD_NS: "xsd",
            XSI_NS: "xsi",
            SOAP_11_ENV: "soapenv",
            SOAP_12_ENV: "soapenv",
            MIME_NS: "mime",
            HTTP_NS: "http",
        };
    }

    #! creates the object with the WSDL definitions attribute hash
    constructor(hash<auto> nsh, *Namespaces nsc, *string targetNamespace) {
        if (nsc) {
            # Types retain output prefixes during construction. Reserve the enclosing registry's
            # prefixes before allocating any for this schema so later merging cannot reassign them.
            ns = nsc.ns;
            nsr = nsc.nsr;
        }
        if (!nsh.targetNamespace && targetNamespace) {
            chameleon_ns = targetNamespace;
        }
        if (nsh.targetNamespace || targetNamespace) {
            target_ns = nsh.targetNamespace ?? targetNamespace;
            # issue #3029: add target namespace to output namespace hash by default
            getOutputNamespacePrefix(target_ns);
        }

        # set default namespace for unprefixed definitions
        if (exists nsh.xmlns) {
            default_ns = nsh.xmlns;
        }

        #printf("*** DEBUG: Namespaces::constructor() nsh: %y imap: %y\n", nsh, imap);
        addNamespaces(nsh);

        base_types += nsc.base_types;
        #printf("*** DEBUG: Namespaces::constructor() imap: %y\n", imap);
    }

    *string getDefaultNs() {
        return default_ns;
    }

    #! returns input namespace maps for an exception-safe declaration scope
    /** @return input prefix/URI and reverse maps; output prefixes are not scoped
        @since %WSDL 0.5.8
    */
    hash<string, hash<string, string>> getInputNamespaceState() {
        return {"input": imap, "reverse": imapr};
    }

    #! restores an input declaration scope, including newly introduced prefixes
    /** @param state maps returned by getInputNamespaceState()
        @throw WSDL-NAMESPACE-ERROR inconsistent or missing namespace maps
        @since %WSDL 0.5.8
    */
    restoreInputNamespaceState(hash<string, hash<string, string>> state) {
        if (!exists state.input || !exists state.reverse) {
            throw "WSDL-NAMESPACE-ERROR", "input namespace state requires input and reverse maps";
        }
        foreach string uri in (keys state.reverse) {
            if (state.input{state.reverse{uri}} != uri) {
                throw "WSDL-NAMESPACE-ERROR", "input namespace state contains an inconsistent reverse map";
            }
        }
        foreach string prefix in (keys state.input) {
            if (!exists state.reverse{state.input{prefix}}) {
                throw "WSDL-NAMESPACE-ERROR", "input namespace state has no reverse mapping for an input URI";
            }
        }
        imap = state.input;
        imapr = state.reverse;
        xsd_schema = {};
        foreach string prefix in (keys imap) {
            if (imap{prefix} == XSD_NS) {
                xsd_schema{prefix} = True;
            }
        }
    }

    addNamespaces(hash<auto> nsh, *NamespacePrefixHelper nph) {
        foreach string k in (keys nsh) {
            *string ns = (k =~ x/xmlns:([^:]+)/)[0];

            if (!ns)
                continue;

            if (imap{ns}) {
                # ignore if the definition is the same
                if (imap{ns} == nsh{k})
                    continue;

                if (!nph) {
                    throw "WSDL-NAMESPACE-ERROR", sprintf("namespace prefix %y defined twice", ns);
                }
            }
            addNamespaceIntern(ns, nsh{k});
        }
    }

    restorePrefixes(hash<auto> h) {
        map addNamespaceIntern($1.key, $1.value, True), h.pairIterator();
    }

    private addNamespaceIntern(string ns, string val, *bool override) {
        *string previous = imap{ns};
        imap{ns} = val;

        if (exists previous && previous != val && imapr{previous} == ns) {
            remove imapr{previous};
            foreach string prefix in (keys imap) {
                if (imap{prefix} == previous) {
                    imapr{previous} = prefix;
                    break;
                }
            }
        }

        if (override || !imapr{val}) {
            imapr{val} = ns;
        }

        if (val == XSD_NS) {
            xsd_schema{ns} = True;
        } else {
            remove xsd_schema{ns};
        }

        if (!hassoap11 && val == SOAP_11_NS) {
            hassoap11 = True;
        }

        if (!hassoap12 && val == SOAP_12_NS) {
            hassoap12 = True;
        }
    }

    #! merges namespaces when parsing imported schemas
    merge(Namespaces nsc) {
        foreach string prefix in (keys nsc.ns) {
            string uri = nsc.ns{prefix};
            # only import the prefix if the URI isn't already registered
            if (!nsr{uri}) {
                if (ns{prefix}) {
                    if (ns{prefix} == uri) {
                        continue;
                    }

                    # issue #3194: rename clashing namespace prefixes
                    string new_prefix = getUniquePrefix(uri);
                    # update both forward and reverse mappings consistently
                    ns{new_prefix} = uri;
                    nsr{uri} = new_prefix;
                    # also update the source namespace container's reverse mapping
                    nsc.nsr{uri} = new_prefix;
                } else {
                    ns{prefix} = uri;
                    nsr{uri} = prefix;
                }
            }
        }
        # merge input namespace mappings
        foreach string k in (keys nsc.imap) {
            string v = nsc.imap{k};
            if (imap{k}) {
                if (imap{k} == v) {
                    continue;
                }
                # issue #4455: rename clashing namespace prefixes
                k = getUniquePrefix(v);
            }
            imap{k} = v;
            # ensure reverse mapping is also updated
            imapr{v} = k;
        }

        base_types += nsc.base_types;
    }

    #! returns a unique namespace prefix from a URI path string
    /** @param uri the namespace URI to generate a prefix for
        @param default_prefix optional default prefix to use if extraction fails

        @return a unique namespace prefix that:
        - starts with a letter (valid XML namespace prefix)
        - is not already in use in the output namespace map
        - is between 2-6 characters for readability (increased from 3)
    */
    string getUniquePrefix(string uri, *string default_prefix) {
        @assert(uri, "URI is required for prefix generation");
        # try to get last URI path segment
        *string str = (uri =~ x/\/([^\/]+)$/)[0];
        if (str) {
            # keep up to 6 characters for better readability (increased from 3)
            splice str, 6;
            # convert to all lower case
            str =~ tr/A-Z/a-z/;
            # remove special characters
            str =~ s/[^a-z0-9_]//g;
        }
        # only accept strings that start with a letter and are non-empty
        if (!str || str !~ /^[a-z]/) {
            # otherwise we use a hardcoded prefix
            str = default_prefix ?? "ns";
        }
        @assert(str, "prefix generation must produce a non-empty string");
        if (!ns{str}) {
            return str;
        }
        string pfx = str;
        int count = 0;
        do {
            str = pfx + ++count;
        } while (ns{str});
        return str;
    }

    #! returns the namespace URI for the given output namespace prefix
    string getOutputNamespaceUri(string nsp) {
        @assert(nsp, "namespace prefix is required");
        *string uri = ns{nsp};
        if (!uri) {
            throw "WSDL-NAMESPACE-ERROR", sprintf("output namespace prefix %y is unknown (known output namespace "
                "prefixes: %y)", nsp, ns.keys());
        }
        return uri;
    }

    #! returns a hash of namespace attributes for outgoing SOAP messages
    *hash<auto> getOutputNamespaceHash(*hash<auto> nsh) {
        hash<auto> h;
        map h.("xmlns:" + $1.key) = $1.value, ns.pairIterator();

        foreach string k in (keys nsh) {
            string xs = "xmlns:" + k;
            if (h{xs}) {
                if (h{xs} != nsh{k})
                    throw "WSDL-NAMESPACE-ERROR", sprintf("namespace %y has already been added automatically as %y and therefore cannot be overridden as %y", k, h{xs}, nsh{k});
            }
            else
                h{xs} = nsh{k};
        }

        return h;
    }

    #! returns the primary target namespace Uri
    *string getTargetNamespaceUri() {
        return target_ns;
    }

    #! returns the namespace URI for the given prefix or the target namespace Uri
    *string getNamespaceUri(*string nsp) {
        if (exists nsp)
            return getInputNamespaceUri(nsp);
        return getTargetNamespaceUri();
    }

    #! enters a schema target namespace, preserving chameleon adoption and clearing enclosing WSDL targets
    /** @param uri the schema's targetNamespace, or NOTHING if absent
        @note Balance this call with popTargetNamespace().
        @since %WSDL 0.5.8
    */
    pushSchemaTargetNamespace(*string uri) {
        nss += target_ns;
        target_ns = uri ?? chameleon_ns;
    }

    #! pushes the current target namespace URI on the stack and sets the new target namespace URI
    pushTargetNamespace(string ns) {
        @assert(ns, "namespace URI is required");
        nss += target_ns;
        target_ns = ns;
    }

    #! restores any previous target namespace URI from the stack to the current target namespace URI
    popTargetNamespace() {
        @assert(nss.size() > 0, "target namespace stack underflow - mismatched push/pop");
        target_ns = pop nss;
    }

    #! pushes the current default namespace URI on the stack when parsing schemas and sets the current default namespace URI to the current value
    pushDefaultNamespace(string ns) {
        # An empty namespace is the explicit xmlns="" reset.
        dss += default_ns;
        default_ns = ns;
    }

    #! restores any previous default namespace URI from the stack to the current default namespace URI
    popDefaultNamespace() {
        @assert(dss.size() > 0, "default namespace stack underflow - mismatched push/pop");
        default_ns = pop dss;
    }

    #! looks up and registers a namespace if necessary, returns the namespace's prefix
    string getOutputNamespacePrefix(string ns) {
        @assert(ns, "namespace URI is required");
        return nsr{ns} ?? registerNamespaceIntern(ns);
    }

    #! returns the output namespace prefix for the target namespace, if any
    string getTargetNamespaceOutputPrefix() {
        if (!target_ns) {
            throw "NAMESPACE-ERROR", sprintf("no target namespace");
        }
        return getOutputNamespacePrefix(target_ns);
    }

    #! returns the input namespace prefix for the target namespace, if any
    *string getTargetNamespaceInputPrefix() {
        if (!target_ns) {
            throw "NAMESPACE-ERROR", sprintf("no target namespace");
        }
        # return the input prefix mapping for the target namespace (may be NOTHING if not mapped)
        return imapr{target_ns};
    }

    #! registers a namespace internally
    private string registerNamespaceIntern(string uri, *string default_pfx) {
        # see if ns gets a default prefix or create namespace prefix
        string nsa = DefaultPrefixes{uri} ?? getUniquePrefix(uri);
        # register namespace in forward and reverse maps
        ns{nsa} = uri;
        nsr{uri} = nsa;

        return nsa;
    }

    #! returns a hash of namespace prefixes to namespaces URIs actually used
    *hash<auto> getReferencedNamespaceMap() {
        return ns;
    }

    #! returns True if using SOAP 1.1, False if not
    bool hasSoap11() {
        return hassoap11;
    }

    #! returns True if using SOAP 1.2, False if not
    bool hasSoap12() {
        return hassoap12;
    }

    #! returns True if if the input namespace prefix refers to the XSD namespace URI
    *bool isSchema(string ns) {
        return xsd_schema{ns};
    }

    #! returns the input namespace URI from the input namespace prefix
    string getInputNamespaceUri(string nsa) {
        @assert(nsa, "namespace prefix is required");
        *string rv = imap{nsa};
        if (!rv)
            throw "WSDL-NAMESPACE-ERROR", sprintf("input namespace %y is unknown (known input namespaces: %y)", nsa, imap.keys());
        return rv;
    }

    #! returns the input namespace URI from the input namespace prefix, or NOTHING if not found
    /** @param nsa the input namespace prefix
        @return the namespace URI or NOTHING if the prefix is not defined

        @note this method does not throw an exception if the prefix is not found
    */
    *string tryGetInputNamespaceUri(*string nsa) {
        if (!nsa) {
            return NOTHING;
        }
        return imap{nsa};
    }

    #! resolves a type name to type info or a concrete type object
    /** @param t the type name, potentially with namespace prefix (e.g., "xsd:string" or "tns:MyType")
        @param typeinfo reference to store type info hash if type is not resolved
        @param rtype reference to store the resolved XsdAbstractType object
        @param tmap optional type map for custom type lookup

        @return True if type was resolved to an XsdAbstractType, False if typeinfo was populated instead
        @throw WSDL-NAMESPACE-ERROR malformed or unbound type QName, including an empty name
        @throw WSDL-ERROR a referenced schema namespace is not imported
    */
    bool doType(string t, reference<hash> typeinfo, reference<XsdAbstractType> rtype, *hash<string, XsdAbstractType> tmap) {
        hash<auto> resolved = getTypeHash(t);
        if (resolved.uri == XSD_NS) {
            rtype = getBaseType(resolved.val);
            return True;
        }
        if (tmap) {
            if ((rtype = tmap_try_get(tmap, type_qname(resolved.uri, resolved.val)))) {
                return True;
            }
        }
        typeinfo = resolved;
        return False;
    }

    #! captures a type QName in the current declaration's namespace context
    /** @param t lexical type QName
        @return local name, namespace URI (empty for no namespace), and optional output prefix
        @throw WSDL-NAMESPACE-ERROR malformed QName or unbound prefix
        @throw WSDL-ERROR a schema component namespace is not imported by the active source document
        @since %WSDL 0.5.8
    */
    hash<auto> getTypeHash(string t) {
        t =~ s/^[ \t\r\n]+|[ \t\r\n]+$//g;
        list<string> parts = split(":", t);
        if (t !~ /\A[^:]+(?::[^:]+)?\z/) {
            throw "WSDL-NAMESPACE-ERROR", sprintf("invalid type QName %Y", t);
        }
        foreach string part in (parts) {
            if (!regex(part, NCNameRegex)) {
                throw "WSDL-NAMESPACE-ERROR", sprintf("invalid type QName %Y", t);
            }
        }
        string uri = parts.size() == 2 ? getInputNamespaceUri(parts[0]) : (default_ns ?? "");
        if (!uri && chameleon_ns) {
            uri = chameleon_ns;
        }
        if (exists schema_reference_namespaces && !schema_reference_namespaces{uri}) {
            throw WSDL_ERROR, sprintf("schema component QName %Y references namespace %Y without a corresponding "
                "import in this schema document", t, uri);
        }
        hash<auto> info = {"uri": uri, "val": parts[-1]};
        if (uri) {
            info.ns = getOutputNamespacePrefix(uri);
        }
        return info;
    }

    #! returns a recognized builtin schema type
    /** @param t the local builtin type name
        @return the cached builtin type object
        @throw WSDL-ERROR the name is not a recognized builtin type
        @note The existing binary transport extension is retained for legacy HTTP/MIME bindings;
        it is not an XSD 1.0 datatype.
    */
    XsdBaseType getBaseType(string t) {
        if (!XsdBaseType::BuiltinTypes{t}) {
            throw WSDL_ERROR, sprintf("unknown builtin schema type %Y", t);
        }
        if (!base_types{t}) {
            base_types{t} = new XsdBaseType(t, self);
        }

        XsdBaseType rv := base_types{t};
        return rv;
    }

    #! validates the local name of a schema component declaration
    /** @param name the declaration name, which must be a nonempty XML NCName
        @throw WSDL-ERROR missing or invalid declaration name
        @since %WSDL 0.5.8
    */
    validateDeclarationName(*string name) {
        if (!exists name || !regex(name, NCNameRegex)) {
            throw WSDL_ERROR, sprintf("invalid or missing schema declaration name %Y", name);
        }
    }

    #! returns whether a string is an XML NCName
    /** @param name the candidate prefix or local name
        @return True for an XML 1.0 NCName
        @since %WSDL 0.5.8
    */
    static bool isNCName(string name) {
        return regex(name, NCNameRegex);
    }

    #! returns the output namespace prefix for the given input namespace prefix
    string translateOutputNamespacePrefix(*string nsa) {
        return getOutputNamespacePrefix(getInputNamespaceUri(nsa));
    }
}

# private functions
# Unlike legacy local-name aliases, the no-namespace key must be unambiguous too.
string sub type_qname(*string uri, string local_name) {
    return sprintf("{%s}%s", uri ?? "", local_name);
}

XsdAbstractType sub tmap_get(hash<string, XsdAbstractType> tmap, string name) {
if (!tmap{name})
    throw WSDL_ERROR, sprintf("no such type %y; known types: %y", name, tmap.keys());
XsdAbstractType rv := tmap{name};
return rv;
}

*XsdAbstractType sub tmap_try_get(hash<string, XsdAbstractType> tmap, string name) {
*XsdAbstractType rv := tmap{name};
return rv;
}

#! Returns a namespace-qualified key in James-Clark notation: \c "{namespace_uri}local_name", or
#! \c local_name when no namespace URI is given.
/** Used for keying the type/element/group registries so that identifiers reused across different
    target namespaces (typical of UN/CEFACT and other multi-namespace XSD packages) do not collide.

    @since %WSDL 0.5.8
*/
public string sub make_qname(*string nsUri, string localName) {
    return nsUri ? sprintf("{%s}%s", nsUri, localName) : localName;
}

#! Resolves a group/attributeGroup reference to a qualified key for map lookup
/** @param ref the reference string (e.g., "tns:AddressGroup" or "AddressGroup")
    @param defaultNsUri the default namespace URI to use for unqualified refs
    @param nsc the Namespaces object for resolving prefixes
    @return the qualified key in format "{namespace_uri}local_name" or just "local_name" if no namespace
*/
string sub resolveGroupRef(string ref, *string defaultNsUri, Namespaces nsc) {
    string localName = ref;
    *string nsUri = defaultNsUri;

    # Parse prefix if present
    if (ref =~ /:/) {
        (*string prefix, *string name) = (ref =~ x/^([^:]+):(.+)$/);
        if (name) {
            localName = name;
            # Resolve prefix to namespace URI
            *string resolvedNs = nsc.getInputNamespaceUri(prefix);
            if (resolvedNs) {
                nsUri = resolvedNs;
            }
        }
    }

    # Return qualified key
    return nsUri ? sprintf("{%s}%s", nsUri, localName) : localName;
}

# private functions
XsdElement sub emap_get(hash<string, hash<string, XsdElement>> emap, string ns, string name) {
if (!emap{ns})
    throw WSDL_ERROR, sprintf("no such namespace %y; known namespaces: %y", ns, emap.keys());
if (!emap{ns}{name})
    throw WSDL_ERROR, sprintf("no such element %y in namespace %y; known elements: %y", name, ns, emap{ns}.keys());
XsdElement rv := emap{ns}{name};
return rv;
}

*XsdElement sub emap_try_get(hash<string, hash<string, XsdElement>> emap, string ns, string name) {
*XsdElement rv := emap{ns}{name};
return rv;
}

#! WSDL port type hash
public hashdecl PortTypeInfo {
    hash<string, WSOperation> operations;
}

#! WSDL service info hash
public hashdecl ServiceInfo {
    #! service name
    string name;
    #! port info
    hash<string, hash> port;
}

#! WSDL operation info
public hashdecl OperationInfo {
    #! the name of the port defining the operation
    string port;

    #! the operation object
    WSDL::WSOperation operation;
}

#! Poll operation for async WSDL retrieval and schema imports
/** Uses only non-blocking I/O for WSDL and XSD retrieval

    @since %WSDL 0.5.8
*/
public class WsdlPollOperation inherits Qore::AbstractPollOperation {
    public {
        #! Get WSDL state
        const SPS_GET_WSDL = "get-wsdl";

        #! Get XSD import state
        const SPS_GET_IMPORT = "get-import";

        #! Build WebService state
        const SPS_BUILD = "build-wsdl";

        #! Complete state
        const SPS_COMPLETE = "complete";
    }

    private {
        string wsdl_url;
        *string def_path;
        *hash<auto> http_opts;
        *hash<auto> http_headers;
        *AbstractPollOperation poller;
        string state;
        bool goal_reached = False;
        auto output;
        string wsdl_text;
        string current_location;
        hash<string, string> xsd_cache();
        *Logger::LoggerInterface logger;
    }

    constructor(string wsdl_url, *hash<auto> http_opts, *hash<auto> http_headers,
            *Logger::LoggerInterface logger) {
        self.wsdl_url = wsdl_url;
        self.http_opts = http_opts;
        self.http_headers = http_headers;
        self.logger = logger;

        if (wsdl_url =~ /^</) {
            log("INFO", "WSDL async build start: inline data");
            wsdl_text = wsdl_url;
            state = SPS_BUILD;
        } else {
            state = SPS_GET_WSDL;
            log("INFO", "WSDL async fetch start: %y", wsdl_url);
            startFetch(normalizeWsdlLocation(wsdl_url));
        }
    }

    string getGoal() {
        return "wsdl";
    }

    string getState() {
        return state + (poller ? ("-" + poller.getState()) : NOTHING);
    }

    bool goalReached() {
        return goal_reached;
    }

    *hash<SocketPollInfo> continuePoll() {
        while (True) {
            if (poller) {
                *hash<SocketPollInfo> info = poller.continuePoll();
                if (info) {
                    return info;
                }
                handlePollComplete();
                continue;
            }

            if (state == SPS_BUILD) {
                try {
                    output = new WebService(wsdl_text, {
                        "def_path": def_path,
                        "http_headers": http_headers,
                        "xsd_cache": xsd_cache,
                        "async_only": True,
                    });
                    goal_reached = True;
                    state = SPS_COMPLETE;
                    log("INFO", "WSDL async build complete");
                    return;
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err != "WSDL-ASYNC-IMPORT") {
                        rethrow;
                    }
                    string loc = ex.arg;
                    if (!loc) {
                        throw "WSDL-ASYNC-IMPORT", "missing async import location in exception";
                    }
                    log("DEBUG", "WSDL async import required: %y", loc);
                    current_location = loc;
                    state = SPS_GET_IMPORT;
                    startFetch(loc);
                    continue;
                }
            }

            return;
        }
    }

    auto getOutput() {
        return output;
    }

    abort() {
        if (poller) {
            poller.abort();
        }
    }

    private handlePollComplete() {
        if (state == SPS_GET_WSDL) {
            wsdl_text = parseResponseToString(poller.getOutput());
            state = SPS_BUILD;
            log("INFO", "WSDL async fetch complete");
            poller = NOTHING;
            return;
        }

        if (state == SPS_GET_IMPORT) {
            xsd_cache{current_location} = parseResponseToString(poller.getOutput());
            state = SPS_BUILD;
            log("INFO", "WSDL async import fetch complete: %y", current_location);
            poller = NOTHING;
            return;
        }

        poller = NOTHING;
    }

    private startFetch(string location) {
        if (location =~ /^https?:/) {
            HTTPClient hc((http_opts ?? {}) + {"url": location});
            # HTTPClient does not support setLogger()
            string path;
            hash<UrlInfo> u = parse_url(location);
            path = u.path ?? "/";
            if (u.query) {
                path += "?" + u.query;
            }
            poller = hc.startPollSendRecv("GET", path, NOTHING, http_headers);
        } else {
            poller = FileLocationHandler::getIoPollerForLocation(location);
        }
        log("DEBUG", "WSDL async fetch queued: %y", location);
    }

    private string normalizeWsdlLocation(string location) {
        string normalized = WSDLLib::normalizeLocation(location, "file", NOTHING);
        if (normalized =~ /^file:/) {
            hash<UrlInfo> u = parse_url(normalized);
            string path;
            if (u.host) {
                path = u.host;
            }
            if (u.path) {
                if (path) {
                    path += DirSep;
                }
                path += u.path;
            }
            def_path = dirname(path);
        }
        return normalized;
    }

    private string parseResponseToString(auto resp) {
        if (resp.typeCode() == NT_HASH && exists resp.code) {
            if ((resp.code / 100) != 2) {
                log("ERROR", "WSDL async fetch failed: code=%d url=%y", resp.code, wsdl_url);
                throw "WSDL-ASYNC-ERROR", sprintf("HTTP code %d returned for %y", resp.code, wsdl_url);
            }
            return resp."response-body" ? resp."response-body".toString(resp.info.charset ?? "ISO-8859-1") : "";
        }
        if (resp.typeCode() == NT_HASH && exists resp.data) {
            auto data = resp.data;
            if (data.typeCode() == NT_BINARY) {
                return data.toString();
            }
            if (data.typeCode() == NT_STRING) {
                return normalizeXmlString(data);
            }
            return data;
        }
        if (resp.typeCode() == NT_HASH && exists resp."response-body") {
            return resp."response-body".toString(resp.info.charset ?? "ISO-8859-1");
        }
        if (resp.typeCode() == NT_STRING) {
            return normalizeXmlString(resp);
        }
        if (resp.typeCode() == NT_BINARY) {
            return resp.toString();
        }
        return resp;
    }

    private log(string level, string msg, ...) {
        if (logger) {
            logger.logArgs(level, msg, argv);
        }
    }

    private string normalizeXmlString(string xml) {
        string enc = "UTF-8";
        if (xml =~ x/<\?xml[^>]*encoding=['"]([^'"]+)['"]/i) {
            if ($1) {
                enc = $1;
            }
        }
        return xml.toString(enc);
    }
}

#! Original schema source and resolution base used for Serializable reconstruction
/** @since %WSDL 0.5.8
*/
public hashdecl XsdSourceInfo {
    #! complete original XSD document
    string xml;
    #! base used to resolve relative imports and includes
    *string base;
}

#! Encapsulates XSD schema parsing and the resulting type/element/group registry
/** This class isolates the XSD parsing logic so it can be used independently of WSDL parsing.
    @ref WebService inherits from this class to add WSDL-specific parsing on top of the XSD machinery,
    while modules that need to work with bare XSD documents (for example, industry message standards
    delivered as XSD packages) can use this class directly.

    Construct an empty schema and add documents incrementally, or pass one or more XSD documents
    to the constructor:
    @code{.py}
        XsdSchema xs();
        xs.addSchemaFile("/path/to/Header.xsd");
        xs.addSchemaDir("/path/to/messages/");
    @endcode

    @par Example: cache a parsed partner message schema
    @code{.py}
        XsdSchema original(xsd_text, {"async_only": True, "xsd_cache": dependency_cache});
        XsdSchema restored = Serializable::deserialize(original.serialize());
        XsdElement invoice = restored.getElement("urn:partner:invoice", "Invoice");
        AbstractDataProviderType fields = invoice.getDataProviderType();
    @endcode

    Original schema documents and successfully retrieved dependencies are saved with the object;
    restoration rebuilds the transient type/element registries from those bytes. Import callbacks
    are not serialized. Serialized schemas created before source retention cannot reconstruct
    declarations that were not stored. Existing \c WebService objects retain their WSDL rebuild path.

    @note Add documents before sharing the schema between threads. Concurrent mutations of one
    schema are not supported. Failed additions leave previously parsed components usable.

    @since %WSDL 0.5.8
*/
public class XsdSchema inherits WSDL::XsdBase {
    public {
        #! options used to parse the schema
        *hash<auto> opts;

        #! flag if the object has a "try_import" closure or call reference
        bool has_try_import = False;

        #! namespace container
        transient Namespaces nsc;

        #! map of elements keyed by namespace URI then element name
        transient hash<string, hash<string, XsdElement>> emap();

        #! map of types
        transient hash<string, XsdAbstractType> tmap();

        #! map of xs:group definitions by name
        transient hash<string, XsdGroup> groupMap();

        #! map of xs:attributeGroup definitions by name
        transient hash<string, XsdAttributeGroup> attrGroupMap();

        #! global attribute declarations, keyed by expanded namespace/local name
        /** @since %WSDL 0.5.8 */
        transient hash<string, XsdAttribute> attributeMap();

        #! optional closure/call reference to try to resolve import declarations
        transient *code try_import;

        #! default path for retrieving XSD references
        /** Preserved separately from options because addSchemaFile() can set it after construction.
        */
        *string def_path;
    }

    private {
        #! issue #4449: map of imports used while parsing
        transient hash<string, bool> import_map();

        # Active source identities also recognize a root supplied as XML when a dependency imports it.
        transient hash<string, bool> active_schemas();

        # Temporary DFS states while resolving the complete simple type dependency graph.
        transient hash<string, bool> resolving_simple();
        transient hash<string, bool> resolved_simple();
        transient hash<string, bool> valid_list_items();

        # Original documents and their bases reconstruct transient component registries.
        list<hash<XsdSourceInfo>> schema_sources();

        # Successfully retrieved dependency bytes, indexed by normalized absolute location.
        hash<string, string> schema_dependencies();
    }

    private:internal deserializeMembers(hash<auto> members) {
        if (!exists members.schema_sources && !(self instanceof WebService)) {
            throw "DESERIALIZATION-ERROR", "serialized XsdSchema has no source documents; recreate it from the original XSD";
        }
        initOptions(members.opts);
        def_path = members.def_path ?? opts.def_path;
        has_try_import = members.has_try_import ?? False;
        nsc = new Namespaces({});
        nsc.opt_empty_string_is_nothing = opts.compat_empty_string_is_nothing
            || global_compat_empty_string_is_nothing;
        emap = {};
        tmap = {};
        groupMap = {};
        attrGroupMap = {};
        attributeMap = {};
        import_map = {};
        schema_sources = ();
        schema_dependencies = members.schema_dependencies ?? {};
        *string saved_base = def_path;
        on_exit def_path = saved_base;
        foreach hash<XsdSourceInfo> source in (members.schema_sources) {
            def_path = source.base;
            addSchemaString(source.xml);
        }
    }

    #! creates an empty XsdSchema
    /** Use this constructor when you intend to add XSD documents incrementally via @ref addSchemaString,
        @ref addSchemaFile, or @ref addSchemaDir, or when this class is used as a base class.
    */
    constructor() {
        nsc = new Namespaces({});
    }

    #! creates an XsdSchema by parsing one or more XSD source documents
    /** @param xsd a single XSD document string, or a list of XSD document strings (parsed in order)
        @param opts an optional hash of options:
        - \c "def_path": default path for retrieving referenced XSD imports
        - \c "try_import": call reference or closure to resolve XSD imports without a scheme; takes a
          string argument (the resource name) and returns a string (the resource data)
        - \c "http_client": HTTPClient object for retrieving XSD imports
        - \c "http_headers": hash of HTTP headers for XSD imports
        - \c "xsd_cache": hash mapping schema locations to cached schema data
        - \c "async_only": if @ref True then external imports must be satisfied by xsd_cache
        - \c "compat_empty_string_is_nothing": deserialize empty strings to NOTHING instead of ""
    */
    constructor(softlist<string> xsd, *hash<auto> opts) {
        initOptions(opts);
        nsc = new Namespaces({});
        if (opts.compat_empty_string_is_nothing || global_compat_empty_string_is_nothing) {
            nsc.opt_empty_string_is_nothing = True;
        }
        foreach string s in (xsd) {
            addSchemaString(s);
        }
    }

    #! adds an XSD document to the schema and parses its types
    /** @param xsd an XSD document string

        Multiple schemas with their own \c targetNamespace can be added via repeated calls.
        @throw XSD-ERROR invalid schema document root
        @throw WSDL-NAMESPACE-ERROR unresolved namespace prefix
        @throw WSDL-ERROR unresolved or duplicate schema component
        @throw XSD-SIMPLETYPE-ERROR malformed facet declaration or invalid numeric restriction
        @throw WSDL-ASYNC-IMPORT an external schema is absent from the asynchronous cache
        @note A failed addition does not retain declarations or dependency marks from that document.
    */
    addSchemaString(string xsd) {
        validateSchemaRoot(xsd, "XSD-ERROR");
        hash<auto> h = parse_xml(xsd);
        validateSchemaGrammar(xsd);
        if (h.size() != 1) {
            throw "XSD-ERROR", sprintf("expecting a single root element in XSD; got: %y", h.keys());
        }
        string root_key = h.firstKey();
        if (root_key !~ /(?:^|:)schema$/) {
            throw "XSD-ERROR", sprintf("expected XSD root element <schema> or <prefix:schema>; got <%s>",
                root_key);
        }
        # Registry updates are atomic: failed documents must not leave declarations or import marks.
        hash<string, hash<string, XsdElement>> old_elements = emap;
        hash<string, XsdAbstractType> old_types = tmap;
        hash<string, XsdGroup> old_groups = groupMap;
        hash<string, XsdAttributeGroup> old_attribute_groups = attrGroupMap;
        hash<string, XsdAttribute> old_attributes = attributeMap;
        hash<string, bool> old_imports = import_map;
        hash<string, string> old_dependencies = schema_dependencies;
        list<hash<XsdSourceInfo>> old_sources = schema_sources;
        on_error {
            emap = old_elements;
            tmap = old_types;
            groupMap = old_groups;
            attrGroupMap = old_attribute_groups;
            attributeMap = old_attributes;
            import_map = old_imports;
            schema_dependencies = old_dependencies;
            schema_sources = old_sources;
        }

        # Use a fresh namespace context for the schema being added so that target/default namespaces
        # set during parsing persist after parseTypes' NamespacePrefixHelper unwinds (mirroring the
        # XSD-import logic in parseTypes()).
        Namespaces n_nsc = nsc;
        *hash<auto> root_attrs = h{root_key}."^attributes^";
        nsc = new Namespaces(root_attrs ?? {}, n_nsc);
        nsc.opt_empty_string_is_nothing = n_nsc.opt_empty_string_is_nothing;
        nsc.opt_allow_any_header = n_nsc.opt_allow_any_header;
        on_exit nsc = n_nsc;
        on_success n_nsc.merge(nsc);

        string source_key = schemaSourceKey(xsd, nsc.getTargetNamespaceUri(), def_path);
        active_schemas{source_key} = True;
        on_exit remove active_schemas{source_key};
        parseTypes(h, opts.http_client instanceof HTTPClient ? opts.http_client : NOTHING, opts.http_headers);
        hash<XsdSourceInfo> source = <XsdSourceInfo>{"xml": xsd, "base": def_path};
        schema_sources += source;
    }

    #! parses an XSD file and adds its type information to this schema
    /** @param path the XSD file to read
        @throw XSD-ERROR invalid schema root
        @throw WSDL-ERROR invalid schema declarations or dependency graph
        @note Dependencies always resolve relative to this file. An existing default base is restored;
        the first successful file addition establishes the default if none was configured.
        Failed additions restore the original default base.
    */
    addSchemaFile(string path) {
        *string previous_base = def_path;
        def_path = dirname(path);
        on_error def_path = previous_base;
        on_success {
            if (previous_base) {
                def_path = previous_base;
            }
        }
        File f();
        f.open2(path, O_RDONLY);
        addSchemaString(f.read(-1));
    }

    #! parses every matching XSD file in the given directory (non-recursive)
    /** @param dir the directory containing XSD files
        @param regex regex anchored against each file name (default matches filenames ending in \c .xsd)

        Sets @ref def_path to \a dir if not already set. Individual files retain their own resolution bases.
        @throw XSD-ERROR an invalid schema root
        @throw WSDL-ERROR invalid schema declarations or dependency graph
        @note A failed call restores the original default base. Files successfully added before a later
        file fails remain available; each file addition is atomic.
    */
    addSchemaDir(string dir, string regex = "\\.xsd$") {
        *string previous_base = def_path;
        on_error def_path = previous_base;
        if (!def_path) {
            def_path = dir;
        }
        Dir d();
        d.chdir(dir);
        list<string> files = d.listFiles(regex);
        foreach string f in (sort(files)) {
            addSchemaFile(dir + DirSep + f);
        }
    }

    #! returns the list of namespace URIs in which top-level elements are declared
    list<string> getElementNamespaces() {
        return keys emap;
    }

    #! returns the names of all top-level elements declared in the given namespace
    /** @param ns the namespace URI; if not provided, returns names from all namespaces
    */
    list<string> getElementNames(*string ns) {
        if (exists ns) {
            return keys (emap{ns} ?? {});
        }
        list<string> result = ();
        foreach string n in (keys emap) {
            result += keys emap{n};
        }
        return result;
    }

    #! returns the top-level element by namespace and local name, or NOTHING if not found
    *XsdElement getElement(string ns, string name) {
        return emap{ns}{name};
    }

    #! returns a global attribute by expanded name
    /** @param ns the namespace URI, or an empty string for no namespace
        @param name the local attribute name
        @return the declaration, or NOTHING if it does not exist
        @since %WSDL 0.5.8
    */
    *XsdAttribute getAttribute(string ns, string name) {
        return attributeMap{type_qname(ns, name)};
    }

    #! validates a retained XML value against its global element declaration
    /** @param value a complete XML element
        @return the same immutable value after native decode and encode checks
        @throw SOAP-SERIALIZATION-ERROR no matching global declaration or rejected content
        @since %WSDL 0.5.8
    */
    XsdXmlValue validateXmlValue(XsdXmlValue value) {
        *XsdElement element = getElement(value.getNamespaceUri(), value.getLocalName());
        if (!element) {
            throw SOAP_SERIALIZATION_ERROR, sprintf("no global element declaration for XML value %Y",
                value.getExpandedName());
        }
        element.validateXmlValue(value, nsc, tmap);
        return value;
    }

    #! creates a validated retained XML value
    /** @param xml a complete XML element document
        @return an immutable XML value checked against its global declaration
        @throw PARSE-XML-EXCEPTION malformed XML
        @throw SOAP-SERIALIZATION-ERROR no matching declaration or rejected content
        @since %WSDL 0.5.8
    */
    XsdXmlValue getXmlValue(string xml) {
        return validateXmlValue(new XsdXmlValue(xml));
    }

    #! returns an opt-in provider type for a retained XML element
    /** @param namespace_uri the global element namespace, or an empty string
        @param local_name the global element's local name
        @return a provider that validates and retains XsdXmlValue instances
        @throw WSDL-ERROR the global element does not exist
        @note Ordinary getDataProviderType() methods continue to describe native values.
        @since %WSDL 0.5.8
    */
    AbstractDataProviderType getXmlDataProviderType(string namespace_uri, string local_name) {
        *XsdElement element = getElement(namespace_uri, local_name);
        if (!element) {
            throw WSDL_ERROR, sprintf("no global element declaration %Y", type_qname(namespace_uri, local_name));
        }
        return new XsdXmlValueDataType(self, namespace_uri, local_name);
    }

    #! looks up a type by name; returns NOTHING if not found
    *XsdAbstractType findType(string name) {
        return tmap{name};
    }

    #! returns the underlying type map (name -> XsdAbstractType)
    hash<string, XsdAbstractType> getTypeMap() {
        return tmap;
    }

    #! returns a hash value that can be used to serialize a value as a particular type
    hash<auto> getType(string name, auto v) {
        return ("^type^": tmap_get(tmap, name), "^val^": v);
    }

    private string schemaSourceKey(string xml, *string uri, *string base) {
        # getLocationBase() returns directory URLs without the optional trailing separator.
        if (base) {
            base = WSDLLib::resolveLocation(".", base);
            base =~ s{/+$}{};
        }
        return sprintf("%Y:%Y:%s", uri ?? "", base ?? "", xml.toSHA512());
    }

    private validateSchemaRoot(string xml, string error) {
        XmlReader reader(xml);
        while (reader.read()) {
            if (reader.nodeType() == XML_NODE_TYPE_ELEMENT) {
                if (reader.namespaceUri() != XSD_NS || reader.localName() != "schema") {
                    throw error, sprintf("expected XSD schema root, got {%s}%s", reader.namespaceUri() ?? "",
                        reader.localName());
                }
                return;
            }
        }
        throw error, "missing XSD schema root";
    }

    # Check the ordered schema grammar before parseTypes groups declarations by name.
    private validateSchemaGrammar(string xml) {
        XmlReader reader(xml);
        XsdFacetGrammarHelper facet_grammar();
        int schema_depth = -1;
        bool declared = False;
        bool definitions = False;
        bool types = False;
        const string wsdl_namespace = "http://schemas.xmlsoap.org/wsdl/";
        const hash<string, bool> declarations = {"simpleType": True, "complexType": True, "group": True,
            "attributeGroup": True, "element": True, "attribute": True, "notation": True};
        while (reader.read()) {
            int depth = reader.depth();
            int kind = reader.nodeType();
            if (schema_depth >= 0) {
                facet_grammar.consume(reader);
            }
            if (kind == XML_NODE_TYPE_END_ELEMENT) {
                if (depth == schema_depth) {
                    schema_depth = -1;
                }
                if (depth == 1) {
                    types = False;
                }
                continue;
            }
            if (kind != XML_NODE_TYPE_ELEMENT) {
                continue;
            }
            *string uri = reader.namespaceUri();
            string local = reader.localName();
            if (depth == 0) {
                definitions = uri == wsdl_namespace && local == "definitions";
            }
            if (depth == 1) {
                types = definitions && uri == wsdl_namespace && local == "types";
            }
            if (uri == XSD_NS && local == "schema" && (depth == 0 || (depth == 2 && types))) {
                schema_depth = reader.isEmptyElement() ? -1 : depth;
                declared = False;
            } else if (schema_depth >= 0 && depth == schema_depth + 1) {
                if (uri != XSD_NS) {
                    throw WSDL_ERROR, sprintf("schema grammar: unexpected child {%s}%s", uri ?? "", local);
                }
                if (local == "import" || local == "include" || local == "redefine") {
                    if (declared) {
                        throw WSDL_ERROR, sprintf("schema grammar: %s must precede component declarations", local);
                    }
                } else if (declarations{local}) {
                    declared = True;
                } else if (local != "annotation") {
                    throw WSDL_ERROR, sprintf("schema grammar: unexpected child {%s}%s", uri, local);
                }
            }
        }
    }

    #! parse \a opts into XSD-specific state
    private initOptions(*hash<auto> opts) {
        self.opts = opts;
        try_import = opts.try_import;
        if (try_import) {
            remove self.opts.try_import;
            has_try_import = True;
        }
        def_path = opts.def_path;
    }

    private XsdBaseType getBaseType(string t) {
        return nsc.getBaseType(t);
    }

    private resolveType(XsdSimpleType t) {
        string key = t.uniqueHash();
        if (resolved_simple{key}) {
            return;
        }
        if (resolving_simple{key}) {
            throw WSDL_ERROR, sprintf("cyclic simple type dependency involving %Y", t.name);
        }
        resolving_simple{key} = True;
        on_exit remove resolving_simple{key};
        if (t.listItemTypeInfo || t.listItemType) {
            if (!t.listItemType) {
                t.listItemType = resolveType(t.listItemTypeInfo);
            }
            resolveSimpleDependency(t.listItemType);
            if (!validListItemType(t.listItemType)) {
                throw WSDL_ERROR, sprintf("list item type %Y must be atomic or a union of atomic types",
                    t.listItemType.name);
            }
        } else if (t.union || t.unionTypes) {
            list<XsdAbstractType> members();
            foreach hash<auto> typeinfo in (t.union) {
                members += resolveType(typeinfo);
            }
            members += t.unionTypes ?? ();
            foreach XsdAbstractType member in (members) {
                resolveSimpleDependency(member);
            }
            t.unionTypes = members;
            t.union = ();
        } else {
            if (!t.type && t.typeinfo) {
                t.type = resolveType(t.typeinfo);
            }
            resolveSimpleDependency(t.type);
            if (t.type instanceof XsdBaseType && t.type.name == "anySimpleType") {
                throw WSDL_ERROR, "a simpleType restriction requires a base with atomic, list, or union variety";
            }
        }
        t.finalizeResolved();
        resolved_simple{key} = True;
    }

    private resolveSimpleDependency(XsdAbstractType type) {
        if (type instanceof XsdSimpleType) {
            resolveType(cast<XsdSimpleType>(type));
        } else if (!(type instanceof XsdBaseType) || type.name == "anyType") {
            throw WSDL_ERROR, sprintf("simple type dependency %Y must be a simple type", type.name);
        }
    }

    private bool validListItemType(XsdAbstractType type) {
        string key = type.uniqueHash();
        if (!valid_list_items.hasKey(key)) {
            valid_list_items{key} = validListItemTypeIntern(type);
        }
        return valid_list_items{key};
    }

    private bool validListItemTypeIntern(XsdAbstractType type) {
        if (type instanceof XsdSimpleType) {
            XsdSimpleType simple = cast<XsdSimpleType>(type);
            if (simple.listItemType) {
                return False;
            }
            if (simple.unionTypes) {
                foreach XsdAbstractType member in (simple.unionTypes) {
                    if (!validListItemType(member)) {
                        return False;
                    }
                }
                return True;
            }
            return validListItemType(simple.type);
        }
        return type.name != "anySimpleType" && type.name != "IDREFS" && type.name != "ENTITIES"
            && type.name != "NMTOKENS";
    }

    private resolveType(XsdElement xe) {
        if (xe.ref) {
            # find element
            #printf("DEBUG resolveType(XsdElement), ref_ns: %y ref: %y\n", xe.ref_ns, xe.ref);
            XsdElement e = emap_get(emap, xe.ref_ns, xe.ref);
            if (!e.type)
                resolveType(e);
            #printf("resolveType(XsdElement), resolved to e: %y type: %y\n", e.name, e.type.name);
            xe.assimilate(e);
            #throw "OOPS", sprintf("e: %y", xe);
        } else if (!xe.type) {
            xe.type = resolveType(xe.typeinfo);
            #printf("resolveType(XsdElement), %y\n", xe.type.name);
        }
    }

    private resolveType(XsdAttribute xd) {
        *XsdAttribute declaration;
        if (xd.refInfo) {
            string key = type_qname(xd.refInfo.uri, xd.refInfo.val);
            declaration = attributeMap{key};
            if (!declaration) {
                throw WSDL_ERROR, sprintf("no such global attribute %Y", key);
            }
            resolveType(declaration);
            xd.type = declaration.type;
            xd.namespaceUri = declaration.namespaceUri;
        } else if (!xd.type) {
            xd.type = resolveType(xd.typeinfo);
        }
        xd.validateType();
        resolveSimpleDependency(xd.type);
        xd.resolveConstraints(declaration);
    }

    private resolveType(XsdComplexType ct) {
        if (ct.baseTypeInfo) {
            # Simple-content bases finalize after scalar references and attributes are resolved.
            return;
        }
        if (ct.simpleTypeInfo) {
            ct.simpleType = resolveType(ct.simpleTypeInfo);
        }
        #printf("resolveType(XsdComplexType), %y\n", ct.simpleTypeInfo);
    }

    private resolveType(XsdArrayType t) {
        t.elementType = resolveType(t.typeinfo);
    }

    private XsdAbstractType resolveType(hash<auto> v) {
        if (exists v.uri) {
            if (v.uri == XSD_NS) {
                return getBaseType(v.val);
            }
            return tmap_get(tmap, type_qname(v.uri, v.val));
        }
        # Legacy serialized type info predating namespace-URI capture.
        XsdAbstractType rv;
        if (exists v.ns && nsc.isSchema(v.ns)) {
            rv = getBaseType(v.val);
        } else {
            # Prefer namespace-qualified lookup when an output prefix is available; this is
            # required for correctness when multiple namespaces declare the same local type name.
            if (exists v.ns) {
                *string uri = nsc.getOutputNamespaceUri(v.ns);
                if (uri) {
                    *XsdAbstractType qt = tmap_try_get(tmap, make_qname(uri, v.val));
                    if (qt) {
                        return qt;
                    }
                }
            }
            # Fall back to local-name lookup (matches legacy single-namespace WSDL behavior).
            rv = tmap_get(tmap, v.val);
        }
        #printf("resolveType(hash), ns: %y, val: %y -> %y\n", v.ns, v.val, rv.name);
        return rv;
    }

    #! parses an XSD schema referenced by an \c import or \c include statement
    /** @param schema_location the value of the \c schemaLocation attribute
        @param namespace_uri the required imported namespace or the including schema's namespace
        @param nph the namespace prefix helper for the schema making the reference (for error messages)
        @param http_client an optional HTTPClient object to use to retrieve external schemas
        @param http_headers any HTTP headers to send with requests when retrieving external schemas
        @param include True for inclusion, allowing a no-namespace schema to adopt namespace_uri
        @param unresolved resolver shared by the complete dependency graph
    */
    private parseExternalSchema(string schema_location, *string namespace_uri, NamespacePrefixHelper nph,
            auto http_client, auto http_headers, bool include, XsdLateResolverHelper unresolved) {
        # relative locations must be resolved against the location of the referencing document and not
        # against the location of the top-level WSDL document
        string loc = WSDLLib::resolveLocation(schema_location, def_path);

        bool async_only = opts.async_only ?? False;
        *hash<auto> xsd_cache = opts.xsd_cache;
        # the async cache key must be a location that the poller can fetch directly
        string cache_key = async_only ? WSDLLib::normalizeLocation(loc, "file", NOTHING) : loc;
        string dependency_key = WSDLLib::normalizeLocation(loc, "file", NOTHING);
        string expected_ns = namespace_uri ?? "";
        string identity = sprintf("%Y:%Y", dependency_key, expected_ns);
        string reference_key = sprintf("ref:%s:%y:%Y", identity, include, namespace_uri);
        # An identical reference has already passed namespace checks. A different include/import mode
        # must still be validated, even when it reuses the same instantiated components.
        if (import_map{reference_key}) {
            return;
        }

        # the base location for locations relative to the external schema
        *string new_def_path;
        string xsd;
        hash<auto> h = parse_url(loc);
        if (exists schema_dependencies{dependency_key}) {
            xsd = schema_dependencies{dependency_key};
            new_def_path = WSDLLib::getLocationBase(loc);
        } else if (async_only) {
            if (xsd_cache && exists xsd_cache{cache_key}) {
                xsd = xsd_cache{cache_key};
            } else {
                throw "WSDL-ASYNC-IMPORT", sprintf("missing async import %y", cache_key), cache_key;
            }
            new_def_path = WSDLLib::getLocationBase(loc);
        } else if (!h.protocol && try_import) {
            xsd = call_function(try_import, schema_location);
            new_def_path = WSDLLib::getLocationBase(loc);
        } else {
            xsd = WSDLLib::getFileFromURL(loc, "file", http_client, http_headers, NOTHING, NOTHING, \new_def_path);
            if (!new_def_path) {
                new_def_path = WSDLLib::getLocationBase(loc);
            }
        }

        validateSchemaRoot(xsd, WSDL_ERROR);
        # parse XML to Qore data structure ignoring XML element order
        hash<auto> xh = parse_xml(xsd);
        validateSchemaGrammar(xsd);

        # parse namespace definitions in schema attributes
        if (xh.size() != 1) {
            throw WSDL_ERROR, sprintf("%s: expecting a single element indicating an XSD schema in %y; got instead: "
                "%y", nph.getDesc(), schema_location, xh.keys());
        }

        # get schema member name
        string sk = xh.firstKey();

        *hash<auto> schema_attrs = xh{sk}."^attributes^";
        string declared_ns = schema_attrs.targetNamespace ?? "";
        if ((include && declared_ns && declared_ns != expected_ns)
                || (!include && ((exists schema_attrs.targetNamespace) != (exists namespace_uri)
                    || declared_ns != expected_ns))) {
            throw WSDL_ERROR, sprintf("%s namespace mismatch for %Y: expected %Y, got %Y",
                include ? "include" : "import", schema_location, expected_ns, declared_ns);
        }
        import_map{reference_key} = True;
        # Validate every reference, including an import of bytes previously loaded as a chameleon include.
        if (import_map{identity}) {
            return;
        }
        import_map{identity} = True;
        schema_dependencies{dependency_key} = xsd;
        string source_key = schemaSourceKey(xsd, expected_ns, new_def_path);
        if (active_schemas{source_key}) {
            return;
        }
        active_schemas{source_key} = True;
        on_exit remove active_schemas{source_key};

        # use temporary Namespaces object for the external schema
        Namespaces n_nsc = nsc;
        nsc = new Namespaces(schema_attrs ?? {}, n_nsc, include ? namespace_uri : NOTHING);
        on_exit
            nsc = n_nsc;
        on_success
            n_nsc.merge(nsc);

        # verify that the top-level key indicates an XSD schema definition
        (*string ns, *string mem) = (sk =~ x/^([^:]+):([^:]+)$/);
        if (ns && !nsc.isSchema(ns)) {
            throw WSDL_ERROR, sprintf("%s: expecting the schema definition in %y to be in XSD namespace %y, got "
                "%y: %y instead", nph.getDesc(), schema_location, XSD_NS, ns, nsc.getInputNamespaceUri(ns));
        }

        # nested relative locations are resolved against the location of the external schema
        *string old_def_path = def_path;
        def_path = new_def_path;
        on_exit
            def_path = old_def_path;

        # HTTP info must be passed on when parsing nested schemas
        parseTypes(xh, http_client, http_headers, unresolved);
    }

    # parse XSD schema types
    private parseTypes(*hash<auto> data, auto http_client, auto http_headers, *XsdLateResolverHelper resolver) {
        on_exit {
            if (!resolver) {
                resolving_simple = {};
                resolved_simple = {};
                valid_list_items = {};
            }
        }
        #printf("DEBUG: parseTypes data: %y, http_client: %y, http_headers: %y\n", keys data, http_client, http_headers);
        WSDL::XsdBase::removeNS(\data);

        XsdLateResolverHelper unresolved = resolver ?? new XsdLateResolverHelper();

        foreach *hash<auto> schema in (data.schema) {
            *hash<auto> sa = schema."^attributes^";
            if (exists sa.targetNamespace && !trim(sa.targetNamespace)) {
                throw WSDL_ERROR, "targetNamespace must be omitted for a schema without a namespace";
            }
            #if (!sa)
            #    throw "OOPS";
            NamespacePrefixHelper nph(nsc, sa, True);

            string previous_attribute_form = nsc.attribute_form_default;
            on_exit nsc.attribute_form_default = previous_attribute_form;
            nsc.attribute_form_default = sa.attributeFormDefault ?? "unqualified";
            if (nsc.attribute_form_default != "qualified" && nsc.attribute_form_default != "unqualified") {
                throw WSDL_ERROR, sprintf("invalid attributeFormDefault %Y", nsc.attribute_form_default);
            }

            bool usedocns = sa.elementFormDefault == "qualified";
            if (exists sa.elementFormDefault && sa.elementFormDefault != "qualified"
                    && sa.elementFormDefault != "unqualified") {
                throw WSDL_ERROR, sprintf("invalid elementFormDefault %Y", sa.elementFormDefault);
            }

            #printf("DEBUG: schema sa: %y\n", sa);
            #printf("DEBUG: schema tn: %y\n", schema."^attributes^"."targetNamespace");
            WSDL::XsdBase::removeNS(\schema);
            #printf("DEBUG: WebService::parseTypes() schema: %y\n", schema);

            *hash<string, bool> previous_reference_namespaces = nsc.schema_reference_namespaces;
            on_exit nsc.schema_reference_namespaces = previous_reference_namespaces;
            hash<string, bool> reference_namespaces = {XSD_NS: True};
            reference_namespaces{nsc.getTargetNamespaceUri() ?? ""} = True;
            if (schema.hasKey("import")) {
                foreach *hash<auto> declaration in (schema.import ?? (NOTHING,)) {
                    *string uri = declaration."^attributes^"."namespace";
                    if (!exists uri || uri) {
                        # An absent namespace attribute grants no-namespace references; an explicit empty URI does not.
                        reference_namespaces{uri ?? ""} = True;
                    }
                }
            }
            nsc.schema_reference_namespaces = reference_namespaces;

            foreach string kind in ("element", "attribute", "simpleType", "complexType", "group", "attributeGroup") {
                if (schema.hasKey(kind) && !schema{kind}) {
                    throw WSDL_ERROR, sprintf("global %s declaration requires a name", kind);
                }
                foreach auto declaration in (schema{kind}) {
                    nsc.validateDeclarationName(declaration."^attributes^".name);
                }
            }

            # process XSD import if present
            if (schema.hasKey("import") && !schema.import && !nsc.getTargetNamespaceUri()) {
                throw WSDL_ERROR, "a no-namespace schema cannot import its own absent namespace";
            }
            foreach hash<auto> import in (schema.import) {
                *hash<auto> a = import."^attributes^";
                *string imported_ns = a."namespace";
                *string own_ns = nsc.getTargetNamespaceUri();
                if ((!exists imported_ns && !exists own_ns)
                        || (exists imported_ns && exists own_ns && imported_ns == own_ns)) {
                    throw WSDL_ERROR, "an import must reference a different target namespace";
                }
                # import file
                if (a.schemaLocation) {
                    parseExternalSchema(a.schemaLocation, a."namespace", nph, http_client, http_headers, False,
                        unresolved);
                }
            }

            # Includes either share the target namespace or adopt it as chameleon documents.
            if (schema.hasKey("include") && !schema.include) {
                throw WSDL_ERROR, "include requires a schemaLocation";
            }
            foreach hash<auto> inc in (schema.include) {
                *hash<auto> a = inc."^attributes^";
                if (!a.schemaLocation) {
                    throw WSDL_ERROR, "include requires a schemaLocation";
                }
                parseExternalSchema(a.schemaLocation, nsc.getTargetNamespaceUri(), nph, http_client,
                    http_headers, True, unresolved);
            }

            *string tns_uri = nsc.getTargetNamespaceUri();
            if (schema.hasKey("attribute") && !schema.attribute) {
                throw WSDL_ERROR, "global attribute declaration requires a name";
            }
            foreach auto declaration in (schema.attribute) {
                if (declaration.typeCode() != NT_HASH) {
                    throw WSDL_ERROR, "global attribute declaration requires a name";
                }
                XsdAttribute attribute(declaration, nsc, NOTHING, unresolved, True);
                string key = type_qname(tns_uri, attribute.name);
                if (attributeMap{key}) {
                    throw WSDL_ERROR, sprintf("global attribute %Y declared twice", key);
                }
                attributeMap{key} = attribute;
            }
            foreach hash<auto> st in (schema.simpleType) {
                XsdSimpleType t(st, nsc, unresolved, usedocns);
                # Key types by "{nsUri}localName" so identifiers reused across different target
                # namespaces (UN/CEFACT-style multi-namespace XSD packages) do not collide.
                string qname = type_qname(tns_uri, t.name);
                if (tmap{qname}) {
                    throw WSDL_ERROR, sprintf("%s: type (simpleType) %y declared twice", nph.getDesc(), qname);
                }
                tmap{qname} = t;
                # Backward-compat: keep a local-name entry pointing at the first occurrence so that
                # public consumers (and existing tests) that look up types by bare local name keep
                # working for single-namespace WSDLs.
                if (!tmap{t.name}) {
                    tmap{t.name} = t;
                }
            }
            foreach hash<auto> ct in (schema.complexType) {
                XsdComplexType t(ct, nsc, unresolved, usedocns);
                string qname = type_qname(tns_uri, t.name);
                if (tmap{qname}) {
                    throw WSDL_ERROR, sprintf("%s: type (complexType) %y declared twice", nph.getDesc(), qname);
                }
                # If the complexType is purely an array wrapper, store the XsdArrayType directly
                XsdAbstractType stored = t.array ?? t;
                tmap{qname} = stored;
                if (!tmap{t.name}) {
                    tmap{t.name} = stored;
                }
            }
            # parse xs:group definitions
            foreach hash<auto> g in (schema.group) {
                XsdGroup grp(g, nsc, unresolved, usedocns);
                string qualifiedName = type_qname(grp.nsUri, grp.name);
                if (groupMap{qualifiedName}) {
                    throw WSDL_ERROR, sprintf("%s: group %y declared twice", nph.getDesc(), qualifiedName);
                }
                groupMap{qualifiedName} = grp;
                if (!grp.nsUri) {
                    groupMap{grp.name} = grp;
                }
            }
            # parse xs:attributeGroup definitions
            foreach hash<auto> ag in (schema.attributeGroup) {
                XsdAttributeGroup attrGrp(ag, nsc, unresolved);
                string qualifiedName = type_qname(attrGrp.nsUri, attrGrp.name);
                if (attrGroupMap{qualifiedName}) {
                    throw WSDL_ERROR, sprintf("%s: attributeGroup %y declared twice", nph.getDesc(), qualifiedName);
                }
                attrGroupMap{qualifiedName} = attrGrp;
                if (!attrGrp.nsUri) {
                    attrGroupMap{attrGrp.name} = attrGrp;
                }
            }
            # make element map
            foreach hash<auto> el in (schema.element) {
                XsdElement element(el, nsc, NOTHING, unresolved, usedocns, True);
                # Global element names always belong to the target namespace; elementFormDefault
                # was passed to the constructor for local declarations in an anonymous type.
                element.usedocns = boolean(element.ns);

                if (emap{element.ns}{element.name}) {
                    throw WSDL_ERROR, sprintf("%s: element %y declared twice in namespace %y", nph.getDesc(), element.name, element.ns);
                }
                emap{element.ns}{element.name} = element;
                #printf("DEBUG: added element %s -> %s\n", element.ns, element.name);
            }
        }

        if (resolver) {
            return;
        }
        # Resolve only after every document has contributed its declarations, allowing dependency cycles.
        map resolveType($1), unresolved.getList();
        unresolved.clearResolved();

        # Undefined/cyclic groups are errors even when no complex type references them.
        map $1.resolveNestedGroups(groupMap), groupMap.iterator();
        map $1.resolveNestedGroups(attrGroupMap, nsc), attrGroupMap.iterator();

        # finalize complex types with group resolution
        map cast<XsdComplexType>($1).finalize(tmap, nsc, groupMap, attrGroupMap, unresolved), tmap.iterator(), $1 instanceof XsdComplexType;

        # finalize array types
        map cast<XsdArrayType>($1).finalize(tmap, nsc, groupMap, attrGroupMap, unresolved), tmap.iterator(), $1 instanceof XsdArrayType;

        map (map cast<XsdComplexType>($1.type).finalize(tmap, nsc, groupMap, attrGroupMap, unresolved), $1.iterator(), $1.type instanceof XsdComplexType), emap.iterator();

        # Nested anonymous simple-content types are not necessarily entries in tmap or emap.
        map cast<XsdComplexType>($1).finalize(tmap, nsc, groupMap, attrGroupMap, unresolved), unresolved.getList(),
            $1 instanceof XsdComplexType;

        map resolveType($1), unresolved.getList();
        unresolved.validateElementConstraints();
    }
}

#! main class representing a parsed WSDL file
/** This is the main class for handling SOAP communication and is based on a WSDL file

@par Thread Safety
This class is designed to be thread-safe for read operations once constructed. Multiple threads
can safely use the same WebService object for SOAP serialization and deserialization operations.
However, the class should not be modified after construction in a multi-threaded context.

@par Usage Example
@code{.py}
WebService ws(wsdl_string, {"def_path": "/path/to/schemas"});
# Get all available operations
list<string> ops = ws.listOperations();
# Serialize a SOAP request
hash<auto> msg = ws.serializeRequest(op_name, args);
@endcode
*/
public class WebService inherits WSDL::XsdSchema {
    public {
        #! the WSDL string
        string wsdl;

        #! a cryptographic hash for the WSDL source
        string wsdl_hash;

        #! the name of the WebService
        /** @since %WSDL 0.5
        */
        string name;

        #! the digest of the WSDL source
        /** @since %WSDL 0.5
        */
        string hash_str;

        #! list of services in this WSDL
        transient list<string> wsdl_services();

        #! a hash of element names to XsdElement objects for top-level document-style bindings
        transient hash<string, XsdElement> idocmap();

        #! hash of messages names to messages
        transient hash<string, WSMessage> messages();

        #! hash of port names to port type information hashes
        transient hash<string, hash<PortTypeInfo>> portType();
    }

    private {
        # service definitions; name -> service info hash
        hash<string, hash<WSDL::ServiceInfo>> services();

        # service bindings; name -> Binding
        hash<string, Binding> binding();
    }

    #! creates the WebService object
    /** @param str the XML string representing the WSDL
        @param opts an optional hash of options with the following possible keys:
        - \c "compat_allow_any_header": allow any SOAP header to be sent without checking the WSDL
        - \c "compat_empty_string_is_nothing": deserialize empty strings to \c NOTHING instead of an empty string
        - \c "def_path": the default path to use when retrieving referenced XSDs
        - \c "try_import": a call reference or closure to be passed a string name for XSD imports without any scheme to retrieve the data, must take a string argument (the resource name) and return a string (the resource data)
        - \c "http_client": a HTTPClient object for retrieving data from import commands
        - \c "http_headers": a hash of optional HTTP header info to use when retrieving data from import commands
        - \c "xsd_cache": a hash mapping schema locations to cached schema data for async parsing
        - \c "async_only": if @ref True then external imports must be satisfied by \c "xsd_cache" and no blocking
          I/O is performed

        @since 0.3.7 added the \c "compat_empty_string_is_nothing" and \c "compat_allow_any_header" options for backwards compatibility
    */
    constructor(string str, *hash<auto> opts) {
        doInit(str, opts);
    }

    #! returns the name of the service
    /** @return the name of the service

        @since %WSDL 0.5
    */
    string getName() {
        return name;
    }

    #! returns a unique hash for the WSDL that can be used to compare schemas for equality
    /** @return a unique hash for the WSDL that can be used to compare schemas for equality

        @since %WSDL 0.5
    */
    synchronized string getHash() {
        if (!hash_str) {
            hash_str = digest("sha256", wsdl).toHex();
        }
        return hash_str;
    }

    #! returns the given operation or throws an exception if it cannot be found; operations are searched in portTypes in the order they are declared
    /** @throw WSDL-OPERATION-ERROR if the operation is unknown
    */
    WSDL::WSOperation getOperation(string opname) {
        @assert(opname, "operation name is required");
        foreach hash<auto> pt in (portType.iterator()) {
            if (pt.operations{opname})
                return pt.operations{opname};
        }
        throw "WSDL-OPERATION-ERROR", sprintf("cannot retrieve operation %y; known operations: %y", opname,
            (foldl $1 + $2, (map $1.operations.keys(), portType.iterator())));
    }

    #! returns a list of known operation names
    softlist<string> getOperationNames() {
        return foldl $1 + $2, (map keys $1.operations, portType.iterator());
    }

    #! returns the given operation for particular porttype or throws an exception if it cannot be found
    WSDL::WSOperation getPortTypeOperation(string ptname, string opname) {
        @assert(ptname, "port type name is required");
        @assert(opname, "operation name is required");
        *WSOperation op = portType{ptname}.operations{opname};
        if (op)
            return op;
        if (!portType{ptname})
            throw "WSDL-OPERATION-ERROR", sprintf("port %y is not a defined port; known ports: %y", ptname, portType.keys());
        throw "WSDL-OPERATION-ERROR", sprintf("operation %y is not known in port %y; known operations: %y", opname, ptname, portType{ptname}.operations.keys());
    }

    #! returns the given operation for particular binding or throws an exception if it cannot be found
    WSDL::WSOperation getBindingOperation(*string bname, string opname) {
        @assert(opname, "operation name is required");
        if (!exists bname) {
            return getOperation(opname);
        } else {
            WSDL::Binding b = getBinding(bname);
            @assert(b, "binding %y must exist", bname);
            return getPortTypeOperation(b.getPort(), opname);
        }
    }

    #! returns a list of hashes giving supported operation names for each port in the WSDL
    /** @return a list of hashes giving supported operation names for each port in the WSDL; each hash<auto> has the following keys:
        - \c "port": the name of the port defining the operation
        - \c "operation": the @ref WSDL::WSOperation object for the operation
     */
    list<hash<OperationInfo>> listOperations() {
        list<hash<OperationInfo>> l();
        foreach hash<auto> ph in (portType.pairIterator()) {
            foreach WSOperation op in (ph.value.operations.iterator()) {
                l += cast<hash<OperationInfo>>((
                    "port": ph.key,
                    "operation": op,
                ));
            }
        }
        return l;
    }

    #! return a @ref WSDL::Binding object describing the requested binding
    /** @param name the name of the binding

        @return a @ref WSDL::Binding object

        @throw WSDL-BINDING-ERROR unknown binding
     */
    WSDL::Binding getBinding(string name) {
        *Binding b = binding{name};
        if (!b)
            throw "WSDL-BINDING-ERROR", sprintf("binding %y is not a known binding; known bindings: %y", name, binding.keys());
        return b;
    }

    #! returns a list of services defined in the WSDL
    /** @return a list of hashes of services defined in the WSDL; each hash<auto> has the following keys:
        - \c "name": the name of the service
        - \c "port": a hash of port information; the keys are port names and the values have the following keys:
          - \c "address": the location of the port
          - \c "binding": the binding of the port
     */
    list<hash<WSDL::ServiceInfo>> listServices() {
        return map cast<hash<WSDL::ServiceInfo>>($1), services.iterator();
        #return cast<list<hash<WSDL::ServiceInfo>>>(services.values());
    }

    #! returns a hash describing the requested service
    /** @param name the name of the service
        @return a hash describing the service with the following keys:
        - \c "name": the name of the service
        - \c "port": a hash of port information; where each hash<auto> is keyed by port name and the values have the following keys:
          - \c "address": the location of the port
          - \c "binding": the binding of the port

        @throw WSDL-SERVICE-ERROR the service is not known
     */
    hash<WSDL::ServiceInfo> getService(string name) {
        *hash<WSDL::ServiceInfo> h = services{name};
        if (!h)
            throw "WSDL-SERVICE-ERROR", sprintf("service %y is not a known service; known services: %y", name, services.keys());
        return h;
    }

    private parseMessages(*softlist<auto> message) {
        # parse messages
        foreach hash<auto> m in (message) {
            WSMessage msg(m, emap, tmap, nsc);
            foreach string arg in (keys msg.args) {
                #printf("DEBUG: WebService::parseMessages(): %y: %y\n", arg, msg);
                #printf("DEBUG: WebService::parseMessages(): %y: %y\n", arg, msg.args{arg}.type);
                if (exists msg.args{arg}.type && !(msg.args{arg}.type instanceof XsdData))
                    msg.args{arg}.type = resolveType(msg.args{arg}.type);
            }
            messages.(msg.name) = msg;
        }
    }

    private parseService(*softlist<auto> svcs) {
        foreach hash<auto> svc in (svcs) {
            WSDL::XsdBase::removeNS(\svc);
            string svcname = svc."^attributes^".name;
            foreach hash<auto> port in (svc.port) {
                WSDL::XsdBase::removeNS(\port);
                hash<auto> pa = port."^attributes^";
                string name = pa.name;

                if (!pa.binding)
                    throw WSDL_ERROR, sprintf("service %y port %y has no binding", svcname, name);
                (*string ns, *string bind) = pa.binding =~ x/(?:([^:]+):)?([^:]+)/;
                if (!bind)
                    throw WSDL_ERROR, sprintf("cannot parse service %y port %y binding: %y", svcname, name, pa.binding);

                if (!binding{bind})
                    throw WSDL_ERROR, sprintf("service %y port %y refers to non-existant binding %y; known bindings: %y", svcname, name, bind, binding.keys());

                # create the ServiceInfo hash if necessary
                if (!services{svcname})
                    services{svcname} = new hash<WSDL::ServiceInfo>(("name": svcname));

                # add the port to the service
                services{svcname}.port{name} = pa + (
                    "address": port.address."^attributes^".location,
                    "binding": binding{bind},
                );
            }
        }
    }

    private parsePortType(*softlist<auto> data) {
        # setup list of services defined in this WSDL
        foreach hash<auto> port in (data) {
            WSDL::XsdBase::removeNS(\port);
            #printf("DEBUG: portType: %y\n", port);
            string name = port."^attributes^".name;
            wsdl_services += name;
            foreach hash<auto> p in (port.operation) {
                WSOperation op(p, nsc, messages);
                if (!portType{name})
                    portType{name} = new hash<PortTypeInfo>();
                portType{name}.operations.(op.name) = op;
            }
        }
    }

    private parseBinding(*softlist<auto> bindings) {
        foreach hash<auto> data in (bindings) {
            WSDL::Binding b(data, nsc, \portType, \idocmap, messages);
            binding.(b.getName()) = b;
        }
    }

    #! returns True if the WSDL describes a SOAP 1.2 service
    /** @return True if the WSDL describes a SOAP 1.2 service
    */
    bool isSoap12() {
        return nsc.hasSoap12();
    }

    #! returns the XML string for the WSDL
    /** @return the XML string for the WSDL
    */
    string getWSDL() {
        return wsdl;
    }

    #! returns a cryptographic hash for the WSDL source
    /** @return a cryptographic hash for the WSDL source
    */
    string getWSDLHash() {
        return wsdl_hash;
    }

    #! returns the XML string for the WSDL, adjusting the URLs for binding locations depending on the caller
    /** @param base_url the url to be prepended before the service name;
                        it must include all the handler prefixes (like \c /SOAP)
                        to produce valid URL
        @return the XML string for the WSDL
     */
    string getWSDL(string base_url) {
        string wstr = wsdl;

        foreach hash<WSDL::ServiceInfo> sh in (services.iterator()) {
            foreach hash<auto> ph in (sh.port.iterator()) {
                wstr = replace(wstr, ph.address, base_url + "/" + sh.name);
            }
        }

        return wstr;
    }

    private string getOperationParams(WSMessage msg) {
        return sprintf("%s(%s)", msg.name, (foldl $1 + "," + $2, (keys msg.args)));
    }

    #! prepare a WebService report enumerating the services and operations of the WSDL, outputs to the output stream given as the first argument
    /** @param stream the output stream for the report data
        @param wsdl_name name of the WSDL, typically a file name

        @note The human-readable report is written to the supplied stream.
    */
    getReport(StringOutputStream stream, *string wsdl_name) {
        StreamWriter w(stream);
        w.printf("wsdl: %s\n", wsdl_name);
        foreach hash<WSDL::ServiceInfo> svc in (listServices()) {
            w.printf("  service: %s\n", svc.name);
            foreach string port in (keys svc.port) {
                w.printf("    port: %s\n", port);
                w.printf("      binding: %s\n", svc.port{port}.binding.name);
                w.printf("      address: %s\n", svc.port{port}.address);
                hash<auto> pt = portType{svc.port{port}.binding.getPort()};
                w.printf("      operations:\n");
                foreach string name in (keys pt.operations) {
                    WSOperation op = pt.operations{name};
                    w.printf("        %s\n", name);
                    if (op.input) {
                        w.printf("          input: %s\n", getOperationParams(op.input));
                    }
                    if (op.output) {
                        w.printf("          output: %s\n", getOperationParams(op.output));
                    }
                }
            }
        }
    }

    #! prepare a WebService report enumerating the services and operations of the WSDL
    /** @param wsdl_name name of the WSDL, typically a file name

        @return human readable text report
    */
    string getReport(*string wsdl_name) {
        StringOutputStream stream();
        getReport(stream, wsdl_name);
        return stream.getData();
    }

    #! supports the constructor and deserialization
    /** @since %WSDL 0.4
    */
    private:internal doInit(string str, *hash<auto> opts) {
        hash<auto> h = parse_xml(str);
        validateSchemaGrammar(str);

        # save WSDL text
        wsdl = str;
        wsdl_hash = str.toSHA512();

        # save options
        self.opts = opts;

        try_import = opts.try_import;
        if (try_import) {
            remove self.opts.try_import;
            has_try_import = True;
        }

        def_path = opts.def_path;

        # remove namespace (normally "wsdl:") prefix from keys if present
        WSDL::XsdBase::removeNS(\h);
        WSDL::XsdBase::removeNS(\h.definitions);

        # set name
        name = h.definitions.service."^attributes^".name ?? "unnamed-soap-service";

        nsc = new Namespaces(h.definitions."^attributes^");
        if (opts.compat_empty_string_is_nothing || global_compat_empty_string_is_nothing) {
            nsc.opt_empty_string_is_nothing = True;
        }
        if (opts.compat_allow_any_header || global_compat_allow_any_header) {
            nsc.opt_allow_any_header = True;
        }
        #getNSPrefixes(h.definitions."^attributes^");
        #printf("%y\n", h.definitions.types);

        if (exists h.definitions.types) {
            parseTypes(h.definitions.types, opts.http_client instanceof HTTPClient ? opts.http_client : NOTHING,
                opts.http_headers);
        }

        if (exists h.definitions.message) {
            parseMessages(h.definitions.message);
        }

        if (exists h.definitions.portType) {
            parsePortType(h.definitions.portType);
        }

        if (exists h.definitions.binding) {
            parseBinding(h.definitions.binding);
        }

        if (exists h.definitions.service) {
            parseService(h.definitions.service);
        }
    }

    #! can be used to create a WebService object from a hash created with serialize()
    /** @return a WebService object from the argument hash created with serialize()
    */
    private:internal deserializeMembers(hash<auto> members) {
        # initialize empty transient members
        wsdl_services = ();
        idocmap = {};
        emap = {};
        messages = {};
        tmap = {};
        portType = {};

        # Options now belong to XsdSchema and have already been restored by its hook.
        # Accept locally stored options from older WebService serializations as well.
        doInit(members.wsdl, members.opts ?? opts);
    }
}

#! helper class implementing sample message generation
/** This is the class for generating sample SOAP messages based on a WSDL file
*/
public class WSMessageHelper {
    private {
        WebService ws;
        hash<auto> opts;
    }

    const DefaultOpts = (
        "comments": False,
        "choices": False,
        "max_items": 3,
    );

    #! creates the WebService object
    /** @param ws the object representing the WSDL
        @param opts an optional hash of options with the following possible keys:
        - \c "comments": (bool) generate comments as values with ^comment^ key, default: False
        - \c "choices": (bool) generate choices as sub hashes ^choices^ key, default: False
        - \c "max_items" (int): max.number of array elements to output, default: 3
    **/
    constructor(WebService ws, *hash<auto> opts) {
        self.ws := ws;
        *hash<auto> h = opts;
        map remove h{$1}, keys DefaultOpts;
        if (h) {
           throw "WSDL-HELPER-ERROR", sprintf("unknown options %y (known values: %y)", keys h, keys DefaultOpts);
        }
        self.opts = DefaultOpts + opts;
        if (self.opts.max_items < 1) {
           throw "WSDL-HELPER-ERROR", sprintf("invalid 'max_items' value %y (condition: >=1)", self.opts.max_items);
        }
    }

    private hash<auto> getTypeInfo(XsdBaseType t) {
        hash res = {
            'xtype': t.name,
        };
        switch (t.name) {
            case "string":
            case "normalizedString":
            case "token":
            case "language":
            case "Name":
            case "NCName":
            case "QName":
            case "NMTOKEN":
            case "NMTOKENS":
            case "ID":
            case "IDREF":
            case "IDREFS":
            case "ENTITY":
            case "ENTITIES":
                res += {
                    "type": "string",
                    "value": "abc",
                };
                break;
            # note: the XSD type is "anyURI"; "anyUri" is accepted as well for backwards compatibility
            case "anyUri":
            case "anyURI":
                res += {
                    "type": "string",
                    "value": "http://www.qore.com",
                };
                break;
            case "anyType":
            case "anySimpleType":
                res += {
                    "type": "string",
                    "value": "abc",
                };
                break;
            case "byte":
            case "int":
            case "integer":
            case "long":
            case "negativeInteger":
            case "nonNegativeInteger":
            case "positiveInteger":
            case "nonPositiveInteger":
            case "short":
            case "unsignedLong":
            case "unsignedInt":
            case "unsignedShort":
            case "unsignedByte":
                res += {
                    "type": "int",
                    "value": t.name == "negativeInteger" || t.name == "nonPositiveInteger" ? -123 : 123,
                };
                break;
            case "boolean":
                res += {
                    "type": "bool",
                    "value": True,
                };
                break;
            case "base64Binary":
            case "hexBinary":
                res += {
                    "type": "binary",
                    "value": <0feba023ffdca62910>,
                };
                break;
            case "decimal":
                res += {
                    "type": "number",
                    "value": 123.456,
                };
                break;
            case "float":
            case "double":
                res += {
                    "type": "float",
                    "value": XsdIeeeLexicalHelper::decode(t.name, "123.456", "XSD-SAMPLE-ERROR"),
                };
                break;
            case "date":
                res += {
                    "type": "date",
                    "value": XsdCalendarLexicalHelper::decode("date", XsdCalendarLexicalHelper::Samples.date,
                        "XSD-SAMPLE-ERROR"),
                };
                break;
            case "gYear":
            case "gYearMonth":
            case "gMonthDay":
            case "gMonth":
            case "gDay":
                res += {"type": "string", "value": XsdCalendarLexicalHelper::Samples{t.name}};
                break;
            case "dateTime":
                res += {
                    "type": "date",
                    "value": 2015-01-31T10:20:30+01:00,
                };
                break;
            case "time":
                res += {
                    "type": "date",
                    "value": 10:20:30Z,
                };
                break;
            case "duration":
                res += {
                    "type": "date",
                    "value": P5Y2M10DT15H,   # TODO
                };
                break;
            case "binary":
                res += {
                    "type": "binary",
                    "value": <abcd>,
                };
                break;
            default:
                res += {
                    "type": t.name,
                    "value": sprintf("unknown type %y", t.name),
                };
                break;
        }
        return res;
    }

    private hash<auto> getTypeInfo(XsdSimpleType t) {
        hash<auto> res;
        if (t.type) {
            res = getTypeInfo(t.type);
            res.xtype = t.name;
            if (t.enumValues) {
                switch (res.type) {
                case "string":
                    res.value = (keys t.enumValues)[0];
                    break;
                case "int":
                    res.value = sprintf("%s", (keys t.enumValues)[0]);
                    break;
                default:
                    res.value = sprintf("%s", (keys t.enumValues)[0]);
                }
                res.comment = sprintf("Enum: %s",  (keys t.enumValues).join(','));
                if (res.type == "int" || res.type == "number" || res.type == "float" || res.type == "string"
                        || res.type == "list" || res.type == "binary" || res.type == "date") {
                    res.value = t.getSampleValue(res.value);
                }
            } else {
                # issue #5411: generate a value satisfying the type's constraining facets; otherwise the generated
                # example message cannot be serialized, as the placeholder value for the base type does not
                # normally satisfy them
                auto sample = t.getSampleValue(res.value);
                if (exists sample) {
                    res.value = sample;
                    *list<string> pl = XsdSimpleType::getPatterns(t);
                    if (pl) {
                        res.comment = sprintf("Pattern: %s", pl.join(" | "));
                    }
                }
            }
        } else if (t.listItemType) {
            res = getTypeInfo(t.listItemType);
            res.xtype = t.name;
            res.type = "list";
            res.value = (res.value,);
        } else if (t.unionTypes) {
            # union types have no single base type; use the first member type for the example value
            res = getTypeInfo(t.unionTypes[0]);
            res.xtype = t.name;
        } else {
            res.xtype = t.name;
        }
        return res;
    }

    private hash<auto> getTypeInfo(XsdComplexType t) {
        hash<auto> res;
        if (t.elementmap) {
            res.type = "hash";
        } else if (t.simpleType) {
            res = getTypeInfo(t.simpleType);
        }
        res.attrs = exists t.attrs;
        return res;
    }

    private hash<auto> getFieldMessage(string field, XsdElement elem, *softlist<auto> comments) {
        return {field: getMessage(elem, comments){elem.name}};
    }

    hash<auto> getMessage(XsdElement elem, *softlist<auto> comments) {
        hash<auto> vi = getTypeInfo(elem.type);
        auto val;

        if (opts.comments) {
            if (elem.minOccurs == 0) {
                comments += "optional";
            }
            if (elem.minOccurs > 1) {
                comments += sprintf("minOccurs:%d", elem.minOccurs);
            }
            if (elem.maxOccurs > 1 || elem.maxOccurs < 0) {
                comments += sprintf("maxOccurs:%d", elem.maxOccurs);
            }
        }
        if (vi.type) {
            if (vi.type == 'hash') {
                val = {};
                if (elem.type instanceof XsdComplexType) {
                    XsdComplexType ct = cast<XsdComplexType>(elem.type);
                    if (ct.isChoice()) {
                        # the complexType is a choice itself; only one of its members may be serialized
                        if (opts.choices) {
                            hash<auto> ch;
                            foreach string name2 in (keys ct.elementmap) {
                                ch += getFieldMessage(name2, ct.elementmap{name2},
                                    opts.comments ? sprintf("choice[%d]", $# + 1) : NOTHING);
                            }
                            val."^choices1^" = ch;
                        } else if (ct.elementmap) {
                            val += getFieldMessage(ct.elementmap.firstKey(), ct.elementmap.firstValue(),
                                opts.comments ? sprintf("choice[1/%d]", ct.elementmap.size()) : NOTHING);
                        }
                    } else {
                        foreach string name2 in (keys ct.elementmap) {
                            val += getFieldMessage(name2, ct.elementmap{name2});
                        }
                    }
                    foreach hash<ChoiceInfo> choice in (ct.choices) {
                        if (opts.choices) {
                            hash<auto> ch;
                            int j = 1;
                            foreach string name2 in (keys choice.elementmap) {
                                ch += getFieldMessage(name2, choice.elementmap{name2},
                                    opts.comments ? sprintf("choice[%d]", j) : NOTHING);
                                j++;
                            }
                            val{sprintf("^choices%d^", $#+1)} = ch;
                        } else {
                            val += getFieldMessage(choice.elementmap.firstKey(), choice.elementmap.firstValue(),
                                opts.comments ? sprintf("choice[1/%d]", ct.choices.size()) : NOTHING);
                        }
                    }
                }
            } else {
                if (opts.comments && vi.comment) {
                    comments += vi.comment;
                }
                val = vi.value;
            }
        }

        auto v;
        if (comments || vi.attrs) {
            v = hash();
            if (comments) {
                v{'^comment^'} = comments.join(';');
            }
            if (vi.attrs) {
                foreach string name2 in (keys cast<XsdComplexType>(elem.type).attrs) {
                    XsdAttribute attr = cast<XsdComplexType>(elem.type).attrs{name2};
                    if (attr.hasValueConstraint()) {
                        v{'^attributes^'}{name2} = attr.getDefaultValue();
                        continue;
                    }
                    hash<auto> vi2 = getTypeInfo(attr.type);
                    if (vi2.type) {
                        v{'^attributes^'}{name2} = vi2.value;
                    }
                }
            }
            if (exists val) {
                if (vi.type == 'hash') {
                    v += val;
                } else {
                    v{'^value^'} = val;
                }
            }
        } else {
            v = val;
        }
        *softint n = elem.maxOccurs;
        if (n == -1 || n > opts.max_items) {
            n = opts.max_items;
        }
        if (n > 1) {
            list<auto> l;
            int i = 1;
            while (i <= n) {
                if (comments) {
                    v{'^comment^'} = (list(sprintf("#%d", i)) + comments).join(';');
                }
                push l, v;
                i++;
            }
            return (elem.name: l);
        } else {
            return (elem.name: v);
        }
    }

    #! prepare sample message
    /** @param name message name

        @return a hash representing message
    */
    hash<auto> getMessage(string name) {
        *XsdElement e = ws.idocmap{name};
        if (!e)
            throw "MESSAGE-ERROR", sprintf("cannot map message %y to a known element; known elements: %y", ws.idocmap.keys());
        return getMessage(e);
    }

    #! generates validated retained XML examples keyed by WSDL part name
    /** @param msg the message containing element-based parts
        @return one immutable XML value for each part
        @throw MESSAGE-ERROR a part is type-based rather than element-based
        @throw SOAP-SERIALIZATION-ERROR generated content fails existing schema checks
        @note Ordinary getMessage() calls keep their native representations. The returned values can
        be used with element-based literal SOAP bindings and explicit XML provider types.
        @since %WSDL 0.5.8
    */
    hash<string, XsdXmlValue> getXmlMessage(WSMessage msg) {
        hash<string, XsdXmlValue> result();
        Namespaces namespaces = ws.nsc.copy();
        foreach string part in (keys msg.pmap) {
            hash<ArgInfo> arg = msg.args{msg.pmap{part}};
            if (!arg.element) {
                throw "MESSAGE-ERROR", sprintf("part %Y requires an element declaration for a retained XML example", part);
            }
            XsdElement element = arg.element;
            auto example = getMessage(element){element.name};
            auto serialized = element.serializeValue(namespaces, example, True, part, msg.name);
            hash<auto> content();
            if (serialized.typeCode() == NT_HASH) {
                content += serialized;
            } else {
                content."^value^" = serialized;
            }
            string root = element.getXmlName(namespaces);
            content."^attributes^" += namespaces.getOutputNamespaceHash(NOTHING);
            if (element.getExpandedName() == type_qname("", element.name)) {
                content."^attributes^".xmlns = "";
            }
            XsdXmlValue value(make_xml({root: content}));
            element.validateXmlValue(value, namespaces, ws.getTypeMap());
            result{part} = value;
        }
        return result;
    }

    #! prepare sample message
    /** @param msg WSMessage object

        @return the existing single-part sample, or a hash keyed by every part name for a multipart message
    */
    auto getMessage(WSMessage msg) {
        if (msg.pmap.size() > 1) {
            hash<auto> result();
            foreach string part in (keys msg.pmap) {
                hash<ArgInfo> arg = msg.args{msg.pmap{part}};
                result{part} = arg.element ? getMessage(arg.element){arg.element.name} : getTypeInfo(arg.type).value;
            }
            return result;
        }
        auto t = msg.args.firstValue();
        if (t.element)
            return getMessage(t.element);
        if (t.type)
            return getTypeInfo(t.type).value;
    }
}
}
