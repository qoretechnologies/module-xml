    }
    private:internal deserializeMembers(hash<auto> members) {
        if (!(members.declared instanceof XsdElement) || members.types.typeCode() != NT_HASH
                || members.declarations.typeCode() != NT_HASH || members.values.typeCode() != NT_HASH
                || !members.values || members.optional.typeCode() != NT_BOOLEAN) {
            throw "DESERIALIZATION-ERROR", "an element provider requires its declaration, type map, values and optionality";
        }
        foreach auto value in (members.values.iterator()) {
            if (!(value instanceof AbstractDataProviderType)) {
                throw "DESERIALIZATION-ERROR", "element alternatives require native value providers";
            }
        }
        foreach auto type in (members.types.iterator()) {
            if (!(type instanceof XsdAbstractType)) {
                throw "DESERIALIZATION-ERROR", "an element provider requires schema type definitions";
            }
        }
        foreach hash<string, auto> entry in (members.declarations.pairIterator()) {
            if (!(entry.value instanceof XsdElement) || !members.values.hasKey(entry.key)) {
                throw "DESERIALIZATION-ERROR", "each concrete element declaration requires a native value provider";
            }
        }
        declared = members.declared;
        types = members.types;
        declarations = members.declarations;
        values = members.values;
        optional = members.optional;
    }
    #! returns the element name and representation
    /** @return the provider name */
    string getName() {
        return declared.name + " with selected elements";
    }
    #! describes element selection
    /** @return a description of the wrapper contract */
    string getDesc() {
        return "Accepts the declared native value or `^element^` / `^val^` selecting a concrete substitution member "
            "by `XsdQNameValue`. The selected member supplies its value type and instance constraints. "
            "The provider retains the alternatives available when it was created.";
    }
    #! requires schema-aware conversion
    /** @return NOTHING */
    *Type getValueType() {
        return;
    }
    #! prevents native assignment from bypassing declaration checks
    /** @return an empty map */
    *hash<string, bool> getDirectTypeHash() {
        return {};
    }
    #! returns no common list item type
    /** @return NOTHING */
    *AbstractDataProviderType getElementType() {
        return;
    }
    #! returns no common fields across native and wrapper values
    /** @return NOTHING; inspect getInfo() or getSelectedElementType() */
    *hash<string, AbstractDataField> getFields() {
        return;
    }
    #! reports omission support
    /** @return whether the provider is optional */
    bool isOrNothingType() {
        return optional;
    }
    #! reports requiredness
    /** @return whether a value must be supplied */
    bool isMandatory() {
        return !optional;
    }
    #! returns accepted native representations
    /** @param simple whether simplified names are requested
        @return declared native types and the wrapper hash form
    */
    hash<string, bool> getAcceptTypeHash(*bool simple) {
        hash<string, bool> result = declared.isAbstract() ? {} : values{declared.getExpandedName()}.getAcceptTypeHash(simple);
        result.hash = True;
        if (optional) {
            result.nothing = True;
        } else {
            remove result.nothing;
            remove result.null;
        }
        return result;
    }
    #! returns produced native representations
    /** @param simple whether simplified names are requested
        @return declared native types and the wrapper hash form
    */
    hash<string, bool> getReturnTypeHash(*bool simple) {
        hash<string, bool> result = declared.isAbstract() ? {} : values{declared.getExpandedName()}.getReturnTypeHash(simple);
        result.hash = True;
        if (optional) {
            result.nothing = True;
        } else {
            remove result.nothing;
            remove result.null;
        }
        return result;
    }
    #! returns a concrete member's value provider
    /** @param selected the member's expanded QName
        @return its native provider, including selected types when capture is enabled
        @throw SOAP-SERIALIZATION-ERROR the member is not admitted by the receiving head
    */
    AbstractDataProviderType getSelectedElementType(XsdQNameValue selected) {
        auto wrapper = {"^element^": selected, "^val^": NOTHING};
        XsdElement member = XsdElementValueHelper::select(declared, \wrapper, declarations);
        return values{member.getExpandedName()};
    }
    #! describes the native form and each concrete selected element
    /** @param simple whether simplified names are requested
        @return union metadata with expanded element examples and member value types
    */
    hash<DataTypeInfo> getInfo(*bool simple) {
        hash<DataTypeInfo> result = AbstractDataProviderType::getInfo(simple);
        if (!result.recursive) {
            if (!declared.isAbstract()) {
                result.union_types += values{declared.getExpandedName()}.getInfo(simple);
            }
            foreach XsdElement member in (declarations.iterator()) {
                HashDataType wrapper("Selected element " + member.getExpandedName());
                XsdQNameValue identity(member.getNamespaceUri(), member.name);
                wrapper.addField(new XsdQNameDataField({"name": "^element^", "display_name": "Selected Element",
                    "type": new XsdQNameDataType(), "example_value": identity,
                    "allowed_values": (<AllowedValueInfo>{"value": identity,
                        "display_name": "Element " + member.getExpandedName()},),
                    "desc": "Expanded name selecting this concrete element when the message is stored or forwarded."}));
                wrapper.addQoreFields({
                    "^val^": {"display_name": "Value", "type": values{member.getExpandedName()},
                        "desc": "Native value checked against the selected element, including its required fields."},
                });
                result.union_types += wrapper.getInfo(simple);
            }
        }
        return result;
    }
    #! generates a native value using a concrete element declaration
    /** @param emap declarations visited on the current example path
        @param fname optional field context
        @return the declared native value, or a selected member wrapper for an abstract head
        @throw XSD-SAMPLE-ERROR no concrete instance declaration is available
    */
    auto getExampleValue(*hash<string, bool> emap, *string fname) {
        if (optional) {
            return;
        }
        if (!declared.isAbstract()) {
            return values{declared.getExpandedName()}.getExampleValue(emap, fname);
        }
        list<string> names = XsdElementFieldHelper::getPreferredInstanceNames(declared, declarations);
        if (!names) {
            throw "XSD-SAMPLE-ERROR", sprintf("element %Y has no concrete instance declaration", declared.getExpandedName());
        }
        XsdElement selected = declarations{names[0]};
        return XsdElementValueHelper::retain(declared, selected,
            values{names[0]}.getExampleValue(emap, fname));
    }
    #! converts a value using its selected element without discarding the wrapper
    /** @param value an ordinary value or element wrapper
        @return the converted value retaining the selected element and any explicit type
        @throw MISSING-VALUE-ERROR an omitted mandatory value
        @throw RUNTIME-TYPE-ERROR invalid selection or member content
    */
    auto acceptsValue(auto value) {
        bool check_identity = !(IdentityChecksSuspended ?? False);
        XsdIdentitySuspendScope identity_preparation();
        if (!exists value) {
            if (optional) {
                return;
            }
            throw "MISSING-VALUE-ERROR", sprintf("element value %Y must be supplied", getName());
        }
        bool wrapped = XsdElementValueHelper::isWrapper(value);
        auto native = value;
        try {
            XsdElement selected = XsdElementValueHelper::select(declared, \native, declarations);
            native = values{selected.getExpandedName()}.acceptsValue(native);
            XsdNativeTypeOutputScope type_scope(types);
            Namespaces namespaces = selected.type.nsc.copy();
            XsdQNameOutputScope output_scope(namespaces);
            *XsdIdentityDocumentScope identity_document = check_identity ? new XsdIdentityDocumentScope() : NOTHING;
            selected.serializeOccurrence(namespaces, native, True, selected.name, getName());
        } catch (hash<ExceptionInfo> error) {
            if (error.err == SOAP_SERIALIZATION_ERROR) {
                rethrow "RUNTIME-TYPE-ERROR", error.desc, error.arg;
            }
            rethrow;
        }
        if (wrapped) {
            value."^val^" = native;
            return value;
        }
        return native;
    }
    #! returns an optional copy
    /** @return a provider accepting omission */
    AbstractDataProviderType getOrNothingType() {
        XsdElementDataType result = self.copy();
        result.optional = True;
        return result;
    }
    #! returns a mandatory copy
    /** @return a provider requiring a value */
    AbstractDataProviderType getMandatoryType() {
        XsdElementDataType result = self.copy();
        result.optional = False;
        return result;
    }
    #! returns a copy with soft native conversion for each member
    /** @return a provider retaining all element selection and instance constraints */
    AbstractDataProviderType getSoftType() {
        XsdElementDataType result = self.copy();
        foreach string identity in (keys values) {
            result.values{identity} = values{identity}.getSoftType();
        }
        return result;
    }
}

#! Provider accepting native values and explicit selected-type wrappers
/** The provider resolves selected types in its receiving schema and validates their native fields.
    @note Instances are created by XsdSchema::getNativeDataProviderType() or WSMessage::getDataProviderType(True).
    @par Example
    Store a shipment's selected part subtype through a provider without losing the subtype's extra fields.
    @since %WSDL 0.5.8
*/
public class XsdNativeTypeDataType inherits AbstractDataProviderType {
    private {
        XsdNativeTypeProviderDefinition definition;
        *XsdElement element;
        *bool optional;
        bool softened = False;
    }
    #! creates a provider for a resolved schema boundary
    /** @param definition the receiving schema's completed provider graph
        @param element the element declaration, or NOTHING for a WSDL type part
        @note The schema and message factories construct the graph before returning this provider.
    */
    constructor(XsdNativeTypeProviderDefinition definition, *XsdElement element) {
        self.definition = definition;
        self.element = element;
    }
    private:internal deserializeMembers(hash<auto> members) {
        if (!(members.definition instanceof XsdNativeTypeProviderDefinition)
                || (exists members.element && !(members.element instanceof XsdElement))
                || (exists members.optional && members.optional.typeCode() != NT_BOOLEAN)
                || members.softened.typeCode() != NT_BOOLEAN) {
            throw "DESERIALIZATION-ERROR", "a native provider requires a definition, element and boolean type flags";
        }
        definition = members.definition;
        element = members.element;
        optional = members.optional;
        softened = members.softened;
    }
    private AbstractDataProviderType nativeType() {
        *AbstractDataProviderType result = softened ? definition.soft_native_type : definition.native_type;
        @assert(result, "native provider graph must be complete");
        return result;
    }
    #! returns the declared type's name
    /** @return the schema name with an explicit capture label */
    string getName() {
        return definition.declared.name + " with selected types";
    }
    #! describes the two supported native forms
    /** @return a description of native values and portable selected type wrappers */
    string getDesc() {
        return "Accepts native values or `^type^` / `^val^` wrappers. Selected definitions are resolved and "
            "validated in the receiving schema, preserving derived fields when messages are stored or forwarded.";
    }
    #! prevents native assignment from bypassing selection and instance checks
    /** @return NOTHING; native type compatibility is insufficient */
    *Type getValueType() {
        return;
    }
    #! prevents containers from bypassing validation
    /** @return an empty native assignment map */
    *hash<string, bool> getDirectTypeHash() {
        return {};
    }
    #! returns no common outer list item type
    /** @return NOTHING; the wrapper is not a list */
    *AbstractDataProviderType getElementType() {
        return;
    }
    #! returns no common fields for the two representations
    /** @return NOTHING; getInfo() describes each alternative separately */
    *hash<string, AbstractDataField> getFields() {
        return;
    }
    #! returns whether omission is accepted
    /** @return the explicit override or the declared native type's optionality */
    bool isOrNothingType() {
        return optional ?? (definition.native_type ? definition.native_type.isOrNothingType() : False);
    }
    #! returns whether a value is mandatory
    /** @return the inverse of isOrNothingType() */
    bool isMandatory() {
        return !isOrNothingType();
    }
    #! returns accepted native type names
    /** @param simple whether simplified names are requested
        @return declared native names plus the wrapper hash form
    */
    hash<string, bool> getAcceptTypeHash(*bool simple) {
        hash<string, bool> result = nativeType().getAcceptTypeHash(simple) + {"hash":True};
        if (element && element.nillable) {
            result += new QoreDataType(new Type("WSDL::XsdNilValue")).getAcceptTypeHash(simple);
        }
        if (element && element.getValueConstraint()) {
            result += new QoreDataType(new Type("WSDL::XsdDefaultValue")).getAcceptTypeHash(simple);
        }
        if (isOrNothingType()) {
            result.nothing = True;
        } else {
            remove result.nothing;
            remove result.null;
        }
        return result;
    }
    #! returns produced native type names
    /** @param simple whether simplified names are requested
        @return declared native names plus the wrapper hash form
    */
    hash<string, bool> getReturnTypeHash(*bool simple) {
        hash<string, bool> result = nativeType().getReturnTypeHash(simple) + {"hash":True};
        if (element && element.nillable) {
            result += new QoreDataType(new Type("WSDL::XsdNilValue")).getReturnTypeHash(simple);
        }
        if (element && element.getValueConstraint()) {
            result += new QoreDataType(new Type("WSDL::XsdDefaultValue")).getReturnTypeHash(simple);
        }
        if (isOrNothingType()) {
            result.nothing = True;
        } else {
            remove result.nothing;
            remove result.null;
        }
        return result;
    }
    #! returns native and selected wrapper metadata
    /** @param simple whether simplified type names are requested
        @return a union description retaining the declared native fields
        @note Anonymous declarations use their resolved component as the wrapper example;
        abstract declarations use a permitted concrete type and matching value.
        @throw XSD-SAMPLE-ERROR an abstract declaration has no permitted concrete example
    */
    hash<DataTypeInfo> getInfo(*bool simple) {
        hash<DataTypeInfo> result = AbstractDataProviderType::getInfo(simple);
        if (!result.recursive) {
            auto wrapper_example = definition.declared.isAbstract() ? getMandatoryType().getExampleValue() : NOTHING;
            HashDataType wrapper("Selected XSD type");
            wrapper.addQoreFields({
                "^type^":{"display_name":"Selected Type", "type":new QoreUnionDataType((
                    new QoreDataType(new Type("WSDL::XsdQNameValue")),
                    new QoreDataType(new Type("WSDL::XsdAbstractType")))),
                    "example_value":wrapper_example."^type^" ?? (definition.declared.hasRealName()
                        ? new XsdQNameValue(definition.declared.ons
                        ? definition.declared.nsc.getOutputNamespaceUri(definition.declared.ons) : "",
                            definition.declared.name) : definition.declared),
                    "desc":"Expanded type name or resolved schema component selecting the value definition."},
                "^val^":{"display_name":"Value", "type":AbstractDataProviderTypeMap.any,
                    "example_value":wrapper_example."^val^",
                    "desc":"Native value validated using the selected definition; use `getSelectedValueType()` "
                        "to inspect its fields."},
            });
            result.union_types = definition.declared.isAbstract() ? (wrapper.getInfo(simple),)
                : (nativeType().getInfo(simple), wrapper.getInfo(simple));
            if (element && element.nillable && !definition.declared.isAbstract()) {
                push result.union_types, new QoreDataType(new Type("WSDL::XsdNilValue")).getInfo(simple);
            }
            if (element && element.getValueConstraint() && !definition.declared.isAbstract()) {
                push result.union_types, new QoreDataType(new Type("WSDL::XsdDefaultValue")).getInfo(simple);
            }
        }
        return result;
    }
    #! returns an example of the declared native representation
    /** @param emap declarations already visited on the current example path
        @param fname optional field context
        @return the declared provider's example, or a concrete selected alternative for an abstract type;
        recursive optional fields may be omitted
        @throw XSD-SAMPLE-ERROR an abstract type has no permitted concrete alternative
    */
    auto getExampleValue(*hash<string, bool> emap, *string fname) {
        if (isOrNothingType()) {
            return;
        }
        if (!definition.declared.isAbstract()) {
            if (element && element.getValueConstraint().fixed) {
                return new XsdFixedElementDataType(element, nativeType()).getMandatoryType().getExampleValue(emap, fname);
            }
            return nativeType().getMandatoryType().getExampleValue(emap, fname);
        }
        foreach XsdAbstractType candidate in (definition.owner.types.iterator()) {
            *AbstractDataProviderType selected;
            try {
                selected = getSelectedValueType(candidate);
            } catch (hash<ExceptionInfo> error) {
                if (error.err != SOAP_SERIALIZATION_ERROR) {
                    rethrow;
                }
                continue;
            }
            return {"^type^":new XsdQNameValue(candidate.ons
                ? candidate.nsc.getOutputNamespaceUri(candidate.ons) : "", candidate.name),
                "^val^":selected.getMandatoryType().getExampleValue(emap, fname)};
        }
        throw "XSD-SAMPLE-ERROR", sprintf("abstract type %Y has no permitted concrete example", definition.declared.name);
    }
    #! returns the selected definition's native field provider
    /** @param selected an expanded QName or a resolved schema component
        @return the native provider with selected types supported in nested elements
        @throw SOAP-SERIALIZATION-ERROR unknown, foreign, abstract or incompatible selected definition,
        or a nonidentical anonymous type that cannot supply xsi:type
    */
    AbstractDataProviderType getSelectedValueType(auto selected) {
        if (!(selected instanceof XsdQNameValue) && !(selected instanceof XsdAbstractType)) {
            throw SOAP_SERIALIZATION_ERROR, "a selected provider type requires an expanded QName or schema component";
        }
        XsdNativeTypeOutputScope scope(definition.owner.types);
        XsdAbstractType type = XsdNativeTypeValueHelper::resolve(selected, definition.declared);
        if (type !== definition.declared && !type.hasRealName()) {
            throw SOAP_SERIALIZATION_ERROR, "an anonymous selected type cannot supply xsi:type";
        }
        XsdTypeSubstitutionHelper::check(type, definition.declared, definition.declared.name,
            SOAP_SERIALIZATION_ERROR, element ? element.getBlockedSubstitutions() : NOTHING);
        XsdNativeTypeProviderDefinition target = definition.owner.getDefinition(type);
        return softened ? target.soft_native_type : target.native_type;
    }
    #! validates and converts the supplied native representation
    /** @param value an ordinary native value or selected-type wrapper
        @return the converted value retaining its representation and selected type
        @throw MISSING-VALUE-ERROR an omitted mandatory value
        @throw RUNTIME-TYPE-ERROR invalid selection, native fields or XML instance requirements
        @note Exceptions from custom conversions, including cancellation, propagate unchanged.
    */
    auto acceptsValue(auto value) {
        bool check_identity = !(IdentityChecksSuspended ?? False);
        XsdIdentitySuspendScope identity_preparation();
        if (!exists value) {
            if (isOrNothingType()) {
                return;
            }
            throw "MISSING-VALUE-ERROR", sprintf("native value %Y must be supplied", getName());
        }
        XsdNativeTypeOutputScope type_scope(definition.owner.types);
        Namespaces namespaces = definition.declared.nsc.copy();
        XsdQNameOutputScope output_scope(namespaces);
        try {
            if (value.typeCode() == NT_HASH && (value.hasKey("^type^") || value.hasKey("^val^"))
                    && !XsdNativeTypeValueHelper::isWrapper(value)) {
                throw SOAP_SERIALIZATION_ERROR, "a type wrapper requires ^type^ as an expanded QName or schema "
                    "component and a ^val^ member";
            }
            if (XsdNativeTypeValueHelper::isWrapper(value)) {
                XsdNativeTypeValueHelper::checkWrapper(value);
                AbstractDataProviderType selected = getSelectedValueType(value."^type^");
                if (!(value."^val^" instanceof XsdNilValue) && !(value."^val^" instanceof XsdDefaultValue)
                        && (exists value."^val^" || !(element && element.nillable))) {
                    value."^val^" = selected.acceptsValue(value."^val^");
                }
            } else if (!(value instanceof XsdNilValue) && !(value instanceof XsdDefaultValue)) {
                value = nativeType().acceptsValue(value);
            }
            *XsdIdentityDocumentScope identity_document = check_identity ? new XsdIdentityDocumentScope() : NOTHING;
            if (element) {
                element.serializeOccurrence(namespaces, value, True, element.name, getName());
            } else {
                XsdDocumentValueHelper::serializePartValue(definition.declared, namespaces, value, True);
            }
        } catch (hash<ExceptionInfo> error) {
            if (error.err == SOAP_SERIALIZATION_ERROR) {
                rethrow "RUNTIME-TYPE-ERROR", error.desc, error.arg;
            }
            rethrow;
        }
        return value;
    }
    #! returns an optional variant retaining the schema graph
    /** @return an optional copy */
    AbstractDataProviderType getOrNothingType() {
        XsdNativeTypeDataType result = self.copy();
        result.optional = True;
        return result;
    }
    #! returns a mandatory variant retaining the schema graph
    /** @return a mandatory copy */
    AbstractDataProviderType getMandatoryType() {
        XsdNativeTypeDataType result = self.copy();
        result.optional = False;
        return result;
    }
    #! returns a soft native-field variant retaining all instance checks
    /** @return a soft copy */
    AbstractDataProviderType getSoftType() {
        if (softened) {
            return self;
        }
        XsdNativeTypeDataType result = self.copy();
        result.softened = True;
        return result;
    }
}

#! Field retaining native type wrappers while comparing underlying scalar choices
/** @note Value conversion and schema checks belong to XsdNativeTypeDataType. Finite choices use
    the existing schema-specific field comparator after removing only the outer type wrapper.
    @par Example
    An enumerated shipment status keeps its selected subtype while matching the permitted status value.
    @since %WSDL 0.5.8
*/
public class XsdNativeTypeDataField inherits QoreDataField {
    private {
        QoreDataField comparison;
    }
    private static hash<auto> withoutChoices(hash<auto> info) {
        remove info.allowed_values;
        remove info.element_allowed_values;
        return info;
    }
    #! constructs a field with wrapper-aware choice checking
    /** @param schema the declared schema type
        @param info the ordinary field metadata with a native type provider
        @throw XSD-SIMPLETYPE-ERROR invalid schema choice metadata
    */
    constructor(XsdAbstractType schema, hash<auto> info) : QoreDataField(XsdNativeTypeDataField::withoutChoices(info)) {
        bool repeated = info.type instanceof ListDataType;
        info.type = AbstractDataProviderTypeMap.any;
        XsdAbstractType scalar = schema;
        if (scalar instanceof XsdComplexType && !cast<XsdComplexType>(scalar).attrs
                && !exists cast<XsdComplexType>(scalar).getAttributeWildcard()
                && cast<XsdComplexType>(scalar).simpleType) {
            scalar = cast<XsdComplexType>(scalar).simpleType;
        }
        XsdAbstractType base = scalar;
        while (base instanceof XsdSimpleType && cast<XsdSimpleType>(base).type) {
            base = cast<XsdSimpleType>(base).type;
        }
        if (base instanceof XsdBaseType && base.name == "QName") {
            # QName choice strings need the declaration's lexical bindings even after the
            # selected value itself has been resolved. The comparator owns that context.
            XsdQNameDataType value_type = cast<XsdQNameDataType>(scalar.getDataProviderType());
            info.type = new XsdQNameDataType(value_type.getNamespaceBindings());
            if (repeated) {
                info.type = new ListDataType(info.type);
            }
        }
        if (base instanceof XsdBaseType && base.name == "NOTATION") {
            XsdNotationDataType value_type = cast<XsdNotationDataType>(scalar.getDataProviderType());
            info.type = new XsdNotationDataType(value_type.getDeclarations(), value_type.getNamespaceBindings());
            if (repeated) {
                info.type = new ListDataType(info.type);
            }
        }
        remove info.default_value;
        comparison = XsdDataFieldHelper::create(schema, info);
        allowed_values = comparison.getAllowedValues() ?? ();
        allowed_values_creatable = comparison.getAllowedValuesCreatable();
        element_allowed_values = comparison.getElementAllowedValues() ?? ();
        element_allowed_values_creatable = comparison.getElementAllowedValuesCreatable();
    }
    private:internal deserializeMembers(hash<auto> members) {
        if (!(members.comparison instanceof QoreDataField)) {
            throw "DESERIALIZATION-ERROR", "a native provider field requires its scalar choice comparator";
        }
        comparison = members.comparison;
    }
    #! changes complete-value choices without changing the source field's copies
    /** @param choices permitted scalar values or AllowedValueInfo entries
        @param creatable whether additional values are permitted
        @return this field
        @throw XSD-SIMPLETYPE-ERROR invalid choice values
    */
    AbstractDataField setAllowedValues(list<auto> choices, *bool creatable) {
        QoreDataField next = comparison.copy();
        next.setAllowedValues(choices, creatable);
        comparison = next;
        allowed_values = next.getAllowedValues() ?? ();
        allowed_values_creatable = next.getAllowedValuesCreatable();
        return self;
    }
    #! changes choices for each occurrence without changing copied fields
    /** @param choices permitted occurrence values or AllowedValueInfo entries
        @param creatable whether additional values are permitted
        @return this field
        @throw XSD-SIMPLETYPE-ERROR invalid choice values
    */
    AbstractDataField setElementAllowedValues(list<auto> choices, *bool creatable) {
        QoreDataField next = comparison.copy();
        next.setElementAllowedValues(choices, creatable);
        comparison = next;
        element_allowed_values = next.getElementAllowedValues() ?? ();
        element_allowed_values_creatable = next.getElementAllowedValuesCreatable();
        return self;
    }
    #! converts values and compares choices without discarding their selected types
    /** @param value an ordinary value, wrapper or occurrence list
        @return the converted value with its selected types
        @throw MISSING-VALUE-ERROR an omitted mandatory value
        @throw RUNTIME-TYPE-ERROR invalid value or selected definition
        @throw FIELD-VALUE-ERROR a value outside the permitted choices
    */
    auto acceptsValue(auto value) {
        if (!exists value && exists (auto fallback = getDefaultValue())) {
            value = fallback;
        }
        on_error rethrow $1.err, sprintf("%s (while setting field %Y)", $1.desc, getName()), $1.arg;
        value = getType().acceptsValue(value);
        auto native = XsdNativeTypeProviderHelper::unwrap(value);
        if (exists native && (allowed_values || element_allowed_values)) {
            if (element_allowed_values && native.typeCode() == NT_LIST) {
                native = map XsdNativeTypeProviderHelper::unwrap($1), native,
                    exists XsdNativeTypeProviderHelper::unwrap($1);
            }
            comparison.acceptsValue(native);
        }
        return value;
    }
}

#! explicit provider type for a retained XML element
/** Native schema/provider field types remain unchanged. This opt-in type validates and returns an
    immutable XsdXmlValue, retaining its lexical text, namespaces and ordered XML.

    @par Example
    An invoice connector can accept a complete XML invoice without converting its retained quantity
    spelling or namespace-qualified extension fields into flat provider fields.

    @since %WSDL 0.5.8
*/
public class XsdXmlValueDataType inherits QoreDataType {
    private {
        XsdSchema schema_owner;
        string element_namespace;
        string element_name;
        transient XsdElement element;
        transient Namespaces namespaces;
        transient hash<string, XsdAbstractType> types;
    }

    #! constructs an explicit XML provider type for a global element
    /** @param schema the schema containing the global declaration
        @param namespace_uri the global element namespace, or an empty string
        @param local_name the global element's local name
        @throw WSDL-ERROR the global element does not exist
        @note Retains validation state strongly. Serializable reconstruction uses the schema's saved
        source documents instead of serializing internal component metadata.
    */
    constructor(XsdSchema schema, string namespace_uri, string local_name)
            : QoreDataType(ObjectType, NOTHING, NOTHING, NOTHING,
                <NameDescInfo>{"name": "XML " + local_name, "display_name": "XML " + local_name,
                 "short_desc": "Complete XML element with retained values and namespace context",
                 "desc": "Accepts a complete XML element as `XsdXmlValue`, preserving lexical values, namespace "
                    "bindings and ordered content after schema checks."}) {
        schema_owner = schema;
        element_namespace = namespace_uri;
        element_name = local_name;
        initValidation();
    }

    private:internal deserializeMembers(hash<auto> members) {
        if (!(members.schema_owner instanceof XsdSchema) || members.element_namespace.typeCode() != NT_STRING
                || members.element_name.typeCode() != NT_STRING) {
            throw "DESERIALIZATION-ERROR", "an XML provider type requires a schema and an expanded element name";
        }
        schema_owner = members.schema_owner;
        element_namespace = members.element_namespace;
        element_name = members.element_name;
        initValidation();
    }

    private initValidation() {
        *XsdElement declaration = schema_owner.getElement(element_namespace, element_name);
        if (!declaration) {
            throw WSDL_ERROR, sprintf("no global element declaration %Y", type_qname(element_namespace, element_name));
        }
        element = declaration;
        namespaces = schema_owner.nsc;
        types = schema_owner.getTypeMap();
    }

    #! validates and retains an explicit XML value
    /** @param value the retained XML element
        @return the same immutable XsdXmlValue after validation, or NOTHING for an omitted optional value
        @throw RUNTIME-TYPE-ERROR the supplied value is not XsdXmlValue
        @throw SOAP-SERIALIZATION-ERROR wrong root or rejected XML/schema content
    */
    auto acceptsValue(auto value) {
        # Honor optional/mandatory copies and their base metadata before checking the XML carrier.
        value = QoreDataType::acceptsValue(value);
        if (!exists value) {
            return;
        }
        if (!(value instanceof XsdXmlValue)) {
            throw "RUNTIME-TYPE-ERROR", sprintf("XML element %Y requires XsdXmlValue; got %s",
                element.getExpandedName(), value.type());
        }
        element.validateXmlValue(value, namespaces, types);
        return value;
    }
}

#! provider type for native values of a complete WSDL message
/** Field metadata and native conversion follow HashDataType. Each accepted part also satisfies
    its schema instance requirements, including selected ENTITY/ENTITIES declarations.

    @par Example
    Validate an invoice request before enqueuing it for a SOAP client. An ENTITY name that has
    valid spelling still fails when its containing message cannot supply an unparsed declaration.

    @since %WSDL 0.5.8
*/
public class XsdMessageDataType inherits HashDataType {
    private {
        Namespaces namespaces;
        hash<string, XsdAbstractType> types;
        bool preserve_types = False;
        hash<string, hash<ArgInfo>> parts;
    }

    #! constructs a message provider retaining its part validation context
    /** @param message the resolved WSDL message
        @param preserve_types True to accept portable selected-type wrappers at element and type-part boundaries
        @note The namespace registry is copied for each value check; prefix allocations are private.
    */
    constructor(WSMessage message, bool preserve_types = False) : HashDataType(message.name) {
        self.preserve_types = preserve_types;
        types = message.tmap;
        *XsdNativeTypeProviderContext owner = preserve_types ? new XsdNativeTypeProviderContext(types) : NOTHING;
        XsdNativeTypeProviderScope scope(owner);
        namespaces = message.nsc;
        parts = message.args;
        foreach hash<ArgInfo> arg in (parts.iterator()) {
            hash<auto> info = {"name": arg.name,
                "type": arg.type ? (owner ? new XsdNativeTypeDataType(owner.getDefinition(arg.type), NOTHING)
                    : arg.type.getDataProviderType()) : (XsdElementValueHelper::needsSelection(arg.element)
                        ? new XsdElementDataType(arg.element, types) : arg.element.getDataProviderType()),
                "allowed_values": arg.type ? arg.type.getDataProviderAllowedValues()
                    : arg.element.getDataProviderAllowedValues()};
            addField(arg.type ? XsdDataFieldHelper::create(arg.type, info)
                : XsdDataFieldHelper::create(arg.element, info));
        }
        if (owner) {
            owner.complete();
        }
    }

    private:internal deserializeMembers(hash<auto> members) {
        if (!(members.namespaces instanceof Namespaces) || members.parts.typeCode() != NT_HASH
                || (exists members.types && members.types.typeCode() != NT_HASH)
                || (exists members.preserve_types && members.preserve_types.typeCode() != NT_BOOLEAN)
                || (members.preserve_types && !exists members.types)) {
            throw "DESERIALIZATION-ERROR", "a WSDL message provider requires part and namespace metadata";
        }
        hash<string, hash<ArgInfo>> restored();
        hash<string, bool> names();
        foreach hash<auto> row in (members.parts.pairIterator()) {
            if (row.value.typeCode() != NT_HASH || row.value.name.typeCode() != NT_STRING
                    || !row.value.name || row.value.part.typeCode() != NT_STRING
                    || (exists row.value.element && !(row.value.element instanceof XsdElement))
                    || (exists row.value.type && !(row.value.type instanceof XsdAbstractType))
                    || (boolean(row.value.element) == boolean(row.value.type))) {
                throw "DESERIALIZATION-ERROR", "a WSDL message part requires a name and exactly one element or type";
            }
            hash<ArgInfo> part = new hash<ArgInfo>(row.value);
            if (names{part.name}) {
                throw "DESERIALIZATION-ERROR", sprintf("duplicate WSDL message provider field %Y", part.name);
            }
            names{part.name} = True;
            restored{row.key} = part;
        }
        foreach auto type in (members.types.iterator()) {
            if (!(type instanceof XsdAbstractType)) {
                throw "DESERIALIZATION-ERROR", "a WSDL message provider type map requires schema definitions";
            }
        }
        types = members.types ?? {};
        preserve_types = members.preserve_types ?? False;
        namespaces = members.namespaces;
        parts = restored;
    }

    #! requires instance checks even for native hashes
    /** @return NOTHING; native type compatibility alone cannot validate a message */
    *Type getValueType() {
        return;
    }
    #! returns whether this record must be supplied
    /** @return False for an optional provider copy */
    bool isMandatory() {
        return !or_nothing_type;
    }
    #! returns whether this record can be omitted
    /** @return True for an optional provider copy */
    bool isOrNothingType() {
        return or_nothing_type;
    }

    #! prevents enclosing providers from bypassing message validation
    /** @return an empty map */
    *hash<string, bool> getDirectTypeHash() {
        return {};
    }

    #! converts fields and validates the resulting XML part values
    /** @param input the message hash keyed by part name
        @return converted fields, or NOTHING for an optional omitted message
        @throw MISSING-VALUE-ERROR a mandatory message field is absent
        @throw RUNTIME-TYPE-ERROR a field or its document requirements reject the value
    */
    auto acceptsValue(auto input) {
        if (!exists input && !or_nothing_type) {
            throw "MISSING-VALUE-ERROR", sprintf("XML record %Y must be supplied", getName());
        }
        bool check_identity = !(IdentityChecksSuspended ?? False);
        XsdIdentitySuspendScope identity_preparation();
        auto value = HashDataType::acceptsValue(input);
        if (!exists value) {
            return;
        }
        Namespaces validation_namespaces = namespaces.copy();
        XsdQNameOutputScope output_scope(validation_namespaces);
        XsdNativeTypeOutputScope type_scope(types);
        *XsdIdentityDocumentScope identity_document = check_identity ? new XsdIdentityDocumentScope() : NOTHING;
        foreach hash<ArgInfo> part in (parts.iterator()) {
            *AbstractDataField field = getField(part.name);
            # Explicit optional projections may omit a part. A supplied value still
            # has the selected type's instance requirements.
            if (!field || (!exists value{part.name} && !field.isMandatory())) {
                continue;
            }
            try {
                if (part.element) {
                    auto native = value{part.name};
                    XsdElement selected = XsdElementValueHelper::select(part.element, \native);
                    selected.serializeValue(validation_namespaces, native, True, part.name, getName());
                } else {
                    XsdDocumentValueHelper::serializePartValue(part.type, validation_namespaces, value{part.name}, True);
                }
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err == SOAP_SERIALIZATION_ERROR) {
                    rethrow "RUNTIME-TYPE-ERROR", sprintf("WSDL message part %Y: %s", part.name, ex.desc), ex.arg;
                }
                rethrow;
            }
        }
        return value;
    }

    #! returns a soft-field copy retaining the message's document requirements
    /** @return a message provider with soft fields and the same validation context */
    AbstractDataProviderType getSoftType() {
        if (soft_type) {
            return self;
        }
        XsdMessageDataType result = self.copy();
        foreach AbstractDataField field in (getFields().iterator()) {
            result.replaceField(field.getSoftType());
        }
        if (*AbstractDataProviderType other = getDefaultOtherFieldType()) {
            result.setDefaultOtherFieldType(other.getSoftType());
        }
        result.soft_type = True;
        return result;
    }
}

#! Record provider validating ordered element wildcards
/** Declared fields retain their metadata and conversion. Additional fields contain XML data,
    retained XML elements or explicit type wrappers and are assessed by the receiving content model.
    @par Example
    A shipment connector accepts a partner's namespace-qualified quantity extension alongside its
    declared tracking fields, rejecting extensions that violate the receiving schema.
    @since %WSDL 0.5.8
*/
public class XsdWildcardContentDataType inherits HashDataType {
    private {
        XsdComplexType component;
    }
    #! constructs a provider for a resolved complex type
    /** @param component receiving content model and declaration context */
    constructor(XsdComplexType component) : HashDataType(component.name) {
        self.component = component;
        setDefaultOtherFieldType(AbstractDataProviderType::get(AbstractDataProviderType::anyType));
    }
    private:internal deserializeMembers(hash<auto> members) {
        if (!(members.component instanceof XsdComplexType)) {
            throw "DESERIALIZATION-ERROR", "a wildcard content provider requires its complex type";
        }
        component = members.component;
    }
    #! describes the record's declared and wildcard fields
    /** @return a description of native fields and retained XML extensions */
    string getDesc() {
        return "Declared fields use their schema types. Wildcard fields use expanded names such as "
            "`{urn:partner}quantity` and preserve XML data. Use `XsdXmlValue` to retain a complete extension "
            "with its namespace context and ordered content.";
    }
    #! requires instance validation for hash values
    /** @return NOTHING */
    *Type getValueType() {
        return;
    }
    #! returns whether this record must be supplied
    /** @return False for an optional provider copy */
    bool isMandatory() {
        return !or_nothing_type;
    }
    #! returns whether this record can be omitted
    /** @return True for an optional provider copy */
    bool isOrNothingType() {
        return or_nothing_type;
    }
    #! prevents enclosing providers from bypassing wildcard validation
    /** @return an empty map */
    *hash<string, bool> getDirectTypeHash() {
        return {};
    }
    #! converts declared fields and validates the complete content model
    /** @param input the native record
        @return converted declared fields and preserved wildcard values
        @throw RUNTIME-TYPE-ERROR invalid content, wildcard namespace or assessed value
        @throw MISSING-VALUE-ERROR an absent mandatory value
    */
    auto acceptsValue(auto input) {
        if (!exists input && !or_nothing_type) {
            throw "MISSING-VALUE-ERROR", sprintf("XML record %Y must be supplied", getName());
        }
        bool check_identity = !(IdentityChecksSuspended ?? False);
        XsdIdentitySuspendScope identity_preparation();
        auto value = HashDataType::acceptsValue(input);
        if (!exists value) {
            return;
        }
        Namespaces output = component.nsc.copy();
        XsdQNameOutputScope output_scope(output);
        try {
            *XsdIdentityDocumentScope identity_document = check_identity ? new XsdIdentityDocumentScope() : NOTHING;
            component.serializeValue(output, value, True);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == SOAP_SERIALIZATION_ERROR || ex.err == "XSD-PARTICLE-ERROR") {
                rethrow "RUNTIME-TYPE-ERROR", ex.desc, ex.arg;
            }
            rethrow;
        }
        return value;
    }
    #! returns a copy retaining complete validation with soft declared fields
    /** @return a soft-field provider */
    AbstractDataProviderType getSoftType() {
        XsdWildcardContentDataType result = self.copy();
        foreach AbstractDataField field in (getFields().iterator()) {
            result.replaceField(field.getSoftType());
        }
        result.soft_type = True;
        return result;
    }
    #! generates a bounded example through the receiving content model
    /** @param emap enclosing example context
        @param fname optional field context
        @return a native record, or NOTHING for an optional provider
        @throw XSD-SAMPLE-ERROR no valid instance is available within the sample bounds
    */
    auto getExampleValue(*hash<string, bool> emap, *string fname) {
        return isOrNothingType() ? NOTHING : WSMessageHelper::getTypeExample(component);
    }
}

#! Record provider preserving text and typed children in XML order
/** Content keys keep their insertion order. Character fragments use \c ^value^ or \c ^cdata^,
    with numbered variants for later fragments. A child occurring again after other content uses
    \c name^1, \c name^2 and so on. Each segment of an XSD list-valued child is one occurrence.
    Declared field metadata and conversions remain available through the ordinary provider API.
    @par Example
    A product description retains text before and after a typed product reference through a connector.
    @since %WSDL 0.5.8
*/
public class XsdMixedContentDataType inherits HashDataType {
    private {
        XsdComplexType component;
    }
    #! constructs a provider for a resolved mixed content model
    /** @param component receiving mixed type and declaration context */
    constructor(XsdComplexType component) : HashDataType(component.name) {
        self.component = component;
        setDefaultOtherFieldType(AbstractDataProviderTypeMap.any);
    }
    private:internal deserializeMembers(hash<auto> members) {
        if (!(members.component instanceof XsdComplexType)) {
            throw "DESERIALIZATION-ERROR", "a mixed content provider requires its complex type";
        }
        component = members.component;
    }
    #! describes the ordered native representation
    /** @return the field, character-fragment and repeated-segment contract */
    string getDesc() {
        return "An ordered hash of typed children and XML text. Text, CDATA and comments use `^value^`, `^cdata^` "
            "and `^comment^` keys with numbered variants. Repeated child segments use `name^1`, `name^2`, etc. "
            "Each segment of an XSD list-valued child is one occurrence.";
    }
    #! requires complete content-model validation for each assignment
    /** @return NOTHING */
    *Type getValueType() {
        return;
    }
    #! returns whether a complete record must be supplied
    /** @return False for an optional provider copy */
    bool isMandatory() {
        return !or_nothing_type;
    }
    #! returns whether the complete record can be omitted
    /** @return True for an optional provider copy */
    bool isOrNothingType() {
        return or_nothing_type;
    }
    #! prevents enclosing providers from bypassing ordered-content validation
    /** @return an empty map */
    *hash<string, bool> getDirectTypeHash() {
        return {};
    }
    #! converts each content segment without changing its position
    /** @param input an ordered native hash
        @return the converted hash, or NOTHING for an optional omission
        @throw RUNTIME-TYPE-ERROR invalid fields, values, metadata, order or occurrences
        @throw MISSING-VALUE-ERROR an omitted mandatory value or attribute
        @throw REQUIRED-FIELD-GROUP-ERROR a caller-defined required group has no value
        @note Cancellation and unrelated exceptions propagate unchanged.
    */
    auto acceptsValue(auto input) {
        bool check_identity = !(IdentityChecksSuspended ?? False);
        XsdIdentitySuspendScope identity_preparation();
        if (!exists input) {
            if (isOrNothingType()) {
                return;
            }
            throw "MISSING-VALUE-ERROR", sprintf("mixed content %Y must be supplied", getName());
        }
        if (input.typeCode() != NT_HASH) {
            throw "RUNTIME-TYPE-ERROR", sprintf("mixed content %Y requires an ordered hash", getName());
        }
        *XsdParticle particle = component.getParticle();
        *hash<string, hash<XsdParticleOccurrenceRange>> ranges = particle ? particle.getElementOccurrenceRanges() : NOTHING;
        hash<string, XsdElement> declarations = particle
            ? XsdElementFieldHelper::getParticleDeclarations(particle, ranges) : new hash<string, XsdElement>();
        hash<string, string> fields = XsdElementFieldHelper::getFieldNames(declarations);
        hash<string, string> identities = map {$1.value: $1.key}, fields.pairIterator();
        hash<auto> result();
        hash<string, bool> supplied();
        foreach string key in (keys input) {
            string base = key;
            base =~ s/\^[0-9]+$//;
            string identity = identities{base} ?? base;
            *XsdElement declaration = declarations{identity};
            string field_name = declaration ? fields{identity} : key;
            *AbstractDataField field = getField(field_name);
            auto value = input{key};
            if (field) {
                bool repeated = declaration && (!exists ranges{identity}.maximum
                    || XsdIntegerLexicalHelper::compare(ranges{identity}.maximum, "1") > 0);
                bool single = repeated && (declaration.type.hasNativeListValue() || value.typeCode() != NT_LIST);
                try {
                    value = field.acceptsValue(single ? (value,) : value);
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err == "FIELD-VALUE-ERROR") {
                        rethrow "RUNTIME-TYPE-ERROR", ex.desc, ex.arg;
                    }
                    rethrow;
                }
                if (single) {
                    value = value[0];
                }
                if (exists value && value.val()) {
                    supplied{field_name} = True;
                }
            } else if (!key.startsWith("^") && !key.startsWith(".")) {
                if (*AbstractDataProviderType other = getDefaultOtherFieldType()) {
                    value = other.acceptsValue(value);
                }
            }
            result{key} = value;
        }
        # Attribute defaults add no content position. Child defaults cannot invent a
        # position in an ordered model; required child occurrences are assessed below.
        if (!input.hasKey("^attributes^") && (*AbstractDataField attributes = getField("^attributes^"))) {
            auto value = attributes.acceptsValue(NOTHING);
            if (exists value) {
                result."^attributes^" = value;
                supplied."^attributes^" = value.val();
            }
        }
        foreach list<string> group in (getRequiredGroups()) {
            if (!(select group, supplied{$1})) {
                throw "REQUIRED-FIELD-GROUP-ERROR", sprintf("mixed content %Y requires a value in group %Y",
                    getName(), group);
            }
        }
        Namespaces output = component.nsc.copy();
        XsdQNameOutputScope output_scope(output);
        try {
            *XsdIdentityDocumentScope identity_document = check_identity ? new XsdIdentityDocumentScope() : NOTHING;
            component.serializeValue(output, result, True);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == SOAP_SERIALIZATION_ERROR || ex.err == "XSD-PARTICLE-ERROR") {
                rethrow "RUNTIME-TYPE-ERROR", ex.desc, ex.arg;
            }
            rethrow;
        }
        return result;
    }
    #! returns a copy retaining order and occurrence validation with soft fields
    /** @return a provider with soft declared-field conversions */
    AbstractDataProviderType getSoftType() {
        if (soft_type) {
            return self;
        }
        XsdMixedContentDataType result = self.copy();
        foreach AbstractDataField field in (getFields().iterator()) {
            result.replaceField(field.getSoftType());
        }
        if (*AbstractDataProviderType other = getDefaultOtherFieldType()) {
            result.setDefaultOtherFieldType(other.getSoftType());
        }
        result.soft_type = True;
        return result;
    }
    #! generates a bounded example through the receiving model
    /** @param emap enclosing example context
        @param fname optional field context
        @return an ordered native record, or NOTHING for an optional provider
        @throw XSD-SAMPLE-ERROR no valid instance is available within the sample bounds
    */
    auto getExampleValue(*hash<string, bool> emap, *string fname) {
        return isOrNothingType() ? NOTHING : WSMessageHelper::getTypeExample(component);
    }
}

#! Attribute map provider enforcing namespace and processContents constraints
/** Declared fields retain their existing metadata. Other fields use expanded attribute names and
    resolve available global declarations before conversion. Unassessed values retain their XML text
    and namespace context as XsdScopedLexicalValue.
    @par Example
    A shipment extension can accept a partner's declared quantity attribute while rejecting an
    out-of-range quantity or an attribute outside the permitted partner namespace.
    @since %WSDL 0.5.8
*/
public class XsdAttributeMapDataType inherits HashDataType {
    private {
        Namespaces namespaces;
        hash<XsdAttributeWildcardInfo> wildcard;
        hash<string, XsdAttribute> declared;
    }
    #! constructs an attribute provider with its effective wildcard
    /** @param name descriptive owner name
        @param namespaces receiving declaration namespace context and global registry
        @param wildcard resolved wildcard namespace and processing constraints
        @param declared the containing type's declared attribute uses
        @throw XSD-SIMPLETYPE-ERROR invalid wildcard metadata
    */
    constructor(string name, Namespaces namespaces, hash<XsdAttributeWildcardInfo> wildcard,
            hash<string, XsdAttribute> declared) : HashDataType(name) {
        XsdAttributeWildcardHelper::validateMetadata(wildcard, "XSD-SIMPLETYPE-ERROR");
        self.namespaces = namespaces;
        self.wildcard = wildcard;
        self.declared = declared;
    }
    private:internal deserializeMembers(hash<auto> members) {
        if (!(members.namespaces instanceof Namespaces) || members.wildcard.typeCode() != NT_HASH
                || members.declared.typeCode() != NT_HASH) {
            throw "DESERIALIZATION-ERROR", "an attribute map provider requires its namespace context and wildcard";
        }
        foreach auto attribute in (members.declared.iterator()) {
            if (!(attribute instanceof XsdAttribute)) {
                throw "DESERIALIZATION-ERROR", "an attribute map provider requires declared attribute uses";
            }
        }
        XsdAttributeWildcardHelper::validateMetadata(members.wildcard, "DESERIALIZATION-ERROR");
        declared = members.declared;
        namespaces = members.namespaces;
        wildcard = members.wildcard;
    }
    #! returns the effective namespace and processing constraints
    /** @return a copy of the wildcard component; changing it does not alter validation */
    hash<XsdAttributeWildcardInfo> getAttributeWildcard() {
        return wildcard;
    }
    #! requires field-name validation for native hashes
    /** @return NOTHING */
    *Type getValueType() {
        return;
    }
    #! returns whether this record must be supplied
    /** @return False for an optional provider copy */
    bool isMandatory() {
        return !or_nothing_type;
    }
    #! returns whether this record can be omitted
    /** @return True for an optional provider copy */
    bool isOrNothingType() {
        return or_nothing_type;
    }
    #! prevents enclosing providers from bypassing wildcard admission
    /** @return an empty map */
    *hash<string, bool> getDirectTypeHash() {
        return {};
    }
    #! converts declared and wildcard attribute values
    /** @param input native attribute values keyed by field or expanded name
        @return converted attributes, or NOTHING for optional omission
        @throw RUNTIME-TYPE-ERROR invalid attribute name, namespace, declaration or value
        @throw MISSING-VALUE-ERROR an absent required attribute
    */
    auto acceptsValue(auto input) {
        if (!exists input && !or_nothing_type) {
            throw "MISSING-VALUE-ERROR", sprintf("XML record %Y must be supplied", getName());
        }
        if (input.typeCode() == NT_HASH) {
            hash<string, string> fields();
            foreach string field in (keys declared) {
                XsdAttribute attribute = declared{field};
                fields{type_qname(attribute.namespaceUri, attribute.name)} = field;
            }
            hash<auto> normalized();
            hash<string, bool> seen();
            foreach string key in (keys input) {
                *XsdAttribute attribute = declared{key};
                string identity;
                if (attribute) {
                    identity = type_qname(attribute.namespaceUri, attribute.name);
                } else {
                    XsdQNameValue qname = XsdWildcardAttributeHelper::name(key, "RUNTIME-TYPE-ERROR");
                    identity = type_qname(qname.getNamespaceUri(), qname.getLocalName());
                    attribute = declared{fields{identity}};
                }
                if (seen{identity}) {
                    throw "RUNTIME-TYPE-ERROR", sprintf("duplicate XML attribute %Y", identity);
                }
                seen{identity} = True;
                if (attribute && attribute.use == "prohibited") {
                    throw "RUNTIME-TYPE-ERROR", sprintf("prohibited XML attribute %Y", identity);
                }
                normalized{fields{identity} ?? identity} = input{key};
            }
            input = normalized;
        }
        auto value = HashDataType::acceptsValue(input);
        if (!exists value) {
            return;
        }
        Namespaces output = namespaces.copy();
        XsdQNameOutputScope output_scope(output);
        list<string> wildcard_names();
        foreach string key in (keys value) {
            if (declared.hasKey(key)) {
                continue;
            }
            try {
                XsdQNameValue identity = XsdWildcardAttributeHelper::name(key, SOAP_SERIALIZATION_ERROR);
                push wildcard_names, type_qname(identity.getNamespaceUri(), identity.getLocalName());
                *XsdAttribute attribute = XsdWildcardAttributeHelper::declaration(namespaces, wildcard, identity,
                    SOAP_SERIALIZATION_ERROR);
                if (attribute) {
                    AbstractDataProviderType provider = attribute.type.getDataProviderType();
                    if (soft_type) {
                        provider = provider.getSoftType();
                    }
                    value{key} = provider.acceptsValue(value{key});
                }
                auto checked = XsdWildcardAttributeHelper::encode(namespaces, output, wildcard, identity, value{key});
                if (!attribute) {
                    value{key} = checked;
                }
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err == SOAP_SERIALIZATION_ERROR) {
                    rethrow "RUNTIME-TYPE-ERROR", ex.desc, ex.arg;
                }
                rethrow;
            }
        }
        XsdWildcardAttributeHelper::checkIds(namespaces, wildcard, declared, wildcard_names, "RUNTIME-TYPE-ERROR");
        return value;
    }
    #! returns a soft copy retaining wildcard validation
    /** @return the same constraints with soft native field conversion */
    AbstractDataProviderType getSoftType() {
        XsdAttributeMapDataType result = self.copy();
        foreach AbstractDataField field in (getFields().iterator()) {
            result.replaceField(field.getSoftType());
        }
        result.soft_type = True;
        return result;
    }
}

#! provider type enforcing attribute-use presence independently of the scalar type
/** Attribute uses can be required even when their scalar representation accepts NOTHING, for example
    \c anySimpleType or a union. This type preserves the scalar conversion while enforcing that requirement.

    @since %WSDL 0.5.8

    @par Example
    A required invoice currency attribute remains mandatory even when its schema omits an explicit type.
    Optional boolean attributes keep XSD boolean conversion, so the string \c "false" remains false.
*/
public class XsdAttributeDataType inherits QoreDataType {
    private {
        AbstractDataProviderType value_type;
        bool required;
    }

    #! wraps a scalar provider type with the attribute use's requiredness
    /** @param value_type provider type used to convert supplied values
        @param required whether the attribute use requires a supplied value
    */
    constructor(AbstractDataProviderType value_type, bool required)
            : QoreDataType(required ? (value_type.getValueType() ?? AutoType)
                : (value_type.getValueType() ?? AutoType).getOrNothingType()) {
        self.value_type = value_type;
        self.required = required;
    }

    #! returns whether the attribute must be supplied
    /** @return the requiredness of the attribute use */
    bool isMandatory() {
        return required;
    }

    #! returns whether the attribute can be omitted
    /** @return True for optional attribute uses */
    bool isOrNothingType() {
        return !required;
    }

    #! converts a supplied value after checking attribute presence
    /** @param value the caller's attribute value
        @return the converted value, or NOTHING for an omitted optional attribute
        @throw MISSING-VALUE-ERROR a required attribute was omitted
        @throw RUNTIME-TYPE-ERROR the scalar provider type rejects the value
    */
    auto acceptsValue(auto value) {
        if (!exists value) {
            if (required) {
                throw "MISSING-VALUE-ERROR", "A required XML attribute must be supplied";
            }
            return;
        }
        return value_type.acceptsValue(value);
    }

    #! returns an optional equivalent without modifying this type
    /** @return an equivalent type accepting omitted values */
    AbstractDataProviderType getOrNothingType() {
        return required ? new XsdAttributeDataType(value_type, False) : self;
    }

    #! returns a mandatory equivalent without modifying this type
    /** @return an equivalent type requiring a supplied value */
    AbstractDataProviderType getMandatoryType() {
        return required ? self : new XsdAttributeDataType(value_type, True);
    }

    #! Returns the scalar validator wrapped by this attribute use
    /** @return the underlying provider, independently of attribute presence
        @since %WSDL 0.5.8
    */
    AbstractDataProviderType getWrappedType() {
        return value_type;
    }

    #! returns the item type for list-valued attributes
    /** @return the scalar provider's element type, or NOTHING */
    *AbstractDataProviderType getElementType() {
        return value_type.getElementType();
    }
}

#! provider type for the scalar and structured representations of attributed simple content
/** Scalar inputs keep their scalar representation when all attributes are optional. Hash inputs use
    \c ^value^ and \c ^attributes^ and are validated as that structure without a scalar fallback.

    @since %WSDL 0.5.8
*/
public class XsdSimpleContentDataType inherits AbstractDataProviderType {
    private {
        string name;
        QoreDataField value_field;
        HashDataType structured_type;
        bool allow_scalar;
        bool optional;
    }

    #! constructs the two supported representations of attributed simple content
    /** @param name schema type name
        @param value_field scalar field with its conversion and finite choices
        @param structured_type fields for the existing structured representation
        @param allow_scalar whether scalar inputs can omit all attributes
        @param optional whether the complete value may be omitted
    */
    constructor(string name, QoreDataField value_field, HashDataType structured_type, bool allow_scalar,
            bool optional = False) {
        self.name = name;
        self.value_field = value_field;
        self.structured_type = structured_type;
        self.allow_scalar = allow_scalar;
        self.optional = optional;
    }

    #! returns the schema type name
    /** @return the name supplied at construction */
    string getName() {
        return name;
    }

    #! returns the Qore representation shared by the supported alternatives
    /** @return AutoType when scalar inputs are supported; otherwise the appropriate hash type */
    *Type getValueType() {
        return allow_scalar ? AutoType : (optional ? AutoHashOrNothingType : AutoHashType);
    }

    #! returns whether the complete value must be supplied
    /** @return False only for an optional variant */
    bool isMandatory() {
        return !optional;
    }

    #! returns whether the complete value may be omitted
    /** @return True only for an optional variant */
    bool isOrNothingType() {
        return optional;
    }

    #! returns no outer list element type
    /** @return NOTHING; list-valued simple content is described by the scalar field */
    *AbstractDataProviderType getElementType() {
        return;
    }

    #! returns the fields of the structured representation
    /** @return the ^value^ and ^attributes^ fields */
    *hash<string, AbstractDataField> getFields() {
        return structured_type.getFields();
    }

    #! returns the input type names for the supported alternatives
    /** @param simple request simplified type names
        @return accepted scalar/hash type names and optionality
    */
    hash<string, bool> getAcceptTypeHash(*bool simple) {
        hash<string, bool> rv = structured_type.getAcceptTypeHash(simple);
        if (allow_scalar) {
            rv += value_field.getType().getAcceptTypeHash(simple);
        }
        if (optional) {
            rv.nothing = True;
        } else {
            delete rv.nothing;
        }
        return rv;
    }

    #! returns the output type names for the supported alternatives
    /** @param simple request simplified type names
        @return returned scalar/hash type names and optionality
    */
    hash<string, bool> getReturnTypeHash(*bool simple) {
        hash<string, bool> rv = structured_type.getReturnTypeHash(simple);
        if (allow_scalar) {
            rv += value_field.getType().getReturnTypeHash(simple);
        }
        if (optional) {
            rv.nothing = True;
        } else {
            delete rv.nothing;
        }
        return rv;
    }

    #! converts the selected representation without changing its shape
    /** @param value a scalar or a hash with a ^value^ member and optional ^attributes^
        @return the converted scalar, converted hash, or NOTHING for an omitted optional value
        @throw MISSING-VALUE-ERROR a required value or attribute container is omitted
        @throw RUNTIME-TYPE-ERROR invalid structured fields or scalar conversion
        @throw FIELD-VALUE-ERROR the scalar value violates its finite choices
    */
    auto acceptsValue(auto value) {
        if (!exists value) {
            if (optional) {
                return;
            }
            throw "MISSING-VALUE-ERROR", sprintf("Simple-content value %Y must be supplied", name);
        }
        if (value.typeCode() == NT_HASH) {
            if (!value.hasKey("^value^")) {
                throw "MISSING-VALUE-ERROR", sprintf("Structured simple content %Y requires a ^value^ field", name);
            }
            return structured_type.acceptsValue(value);
        }
        if (!allow_scalar) {
            throw "MISSING-VALUE-ERROR", sprintf("Simple content %Y requires an ^attributes^ field", name);
        }
        return value_field.acceptsValue(value);
    }

    #! returns an optional equivalent without weakening requirements of a supplied hash
    /** @return an optional variant sharing the field definitions */
    AbstractDataProviderType getOrNothingType() {
        return optional ? self : new XsdSimpleContentDataType(name, value_field, structured_type, allow_scalar, True);
    }

    #! returns a mandatory equivalent without changing the source type
    /** @return a mandatory variant sharing the field definitions */
    AbstractDataProviderType getMandatoryType() {
        return optional ? new XsdSimpleContentDataType(name, value_field, structured_type, allow_scalar) : self;
    }
}

# Per-thread traversal state exists only for the dynamic extent of one union operation.
# Nested calls with different values use independent state and restore their caller's context.
hashdecl XsdUnionTrialResult {
    bool accepted;
    auto value;
    *hash<XsdUnionValueIdentity> identity;
    *string lexical;
    # The selected leaf member controls normalization before union-owned patterns.
    *string white_space;
    bool owner = False;
    bool namespace_sensitive = False;
}

class XsdUnionTrialContext {
    public {
        auto input;
        *hash<string, string> namespace_bindings;
        hash<string, bool> active();
        hash<string, hash<XsdUnionTrialResult>> results();
    }
    constructor(auto input, *hash<string, string> namespace_bindings) {
        self.input = input;
        self.namespace_bindings = namespace_bindings;
    }
}

class XsdUnionInputHelper {
    static bool sameInput(auto left, auto right) {
        if (left.typeCode() != right.typeCode()) {
            return False;
        }
        switch (left.typeCode()) {
            case NT_NUMBER:
                if (left.prec() != right.prec()) {
                    return False;
                }
                # fall through: NaN is a stable input, and signed zero retains its lexical distinction
            case NT_FLOAT:
                if (left.nanp() || right.nanp()) {
                    return left.nanp() && right.nanp();
                }
                return left === right && (left != 0 || left.toStringRoundTrip() == right.toStringRoundTrip());
            case NT_LIST:
                if (left.size() != right.size()) {
                    return False;
                }
                foreach auto item in (left) {
                    if (!sameInput(item, right[$#])) {
                        return False;
                    }
                }
                return True;
            case NT_HASH:
                if (left.size() != right.size()) {
                    return False;
                }
                foreach string key in (keys left) {
                    if (!right.hasKey(key) || !sameInput(left{key}, right{key})) {
                        return False;
                    }
                }
                return True;
            case NT_DATE:
                return left === right && left.toString() == right.toString();
        }
        return left === right;
    }
}

#! Computed XSD value identity retained by a union or element constraint
/** The value-space family keeps distinct primitive values separate even when
    their lexical spellings match. Public visibility permits Serializable to
    reconstruct provider graphs containing resolved element constraints.
    @since %WSDL 0.5.8
*/
public hashdecl XsdUnionValueIdentity {
    #! Temporary canonical constraint spelling captured during schema construction
    /** Numeric, boolean, binary, IEEE and complete calendar members use canonical text;
        other members retain their lexical context.
        This metadata does not participate in value equality or replace the declared value.
        @since %WSDL 0.5.8
    */
    *string constraint_lexical;
    #! The primitive family, list variety or custom native conversion identity
    string family;
    #! The already computed comparable value
    auto value;
    #! Unparsed entity names requiring containing-document declarations
    /** These instance obligations are independent of primitive value equality. */
    *list<string> entities;
    #! Selected ID tokens, separate from primitive value equality
    *list<string> ids;
    #! Selected IDREF tokens requiring a binding in the containing validation root
    *list<string> idrefs;
}

#! Builtin value metadata retained by a union provider
/** Contains the builtin spelling rules and corresponding provider without retaining the source schema.
    Builtin NMTOKENS, IDREFS and ENTITIES use this descriptor for their text representation and ordered list identity.
    @since %WSDL 0.5.8
*/
public hashdecl XsdUnionAtomicInfo {
    #! Builtin local name
    string builtin;
    #! Effective XML whitespace rule
    string white_space;
    #! Whether an inherited pattern requires the accepted spelling
    bool preserve_lexical;
    #! Member provider identity, absent for schema-only value comparisons
    *AbstractDataProviderType provider;
}

#! List member value metadata retained by a union provider
/** Describes each atomic item's primitive value without retaining the source schema.
    @since %WSDL 0.5.8
*/
public hashdecl XsdUnionListInfo {
    #! Primitive conversion and restrictions when the item type is atomic
    *hash<XsdUnionAtomicInfo> item;
    #! Whether each item selects a member of an atomic union; excludes \c item metadata
    bool union_items = False;
    #! Member provider identity, absent for schema-only value comparisons
    *AbstractDataProviderType provider;
}

# Retain the actual item's selected value; a second conversion could call custom
# validators again or choose a different member after native conversion.
class XsdSchemaUnionItemCapture {
    public {
        XsdAbstractType target;
        *hash<XsdUnionValueIdentity> identity;
    }
    constructor(XsdAbstractType target) {
        self.target = target;
    }
}

class XsdProviderUnionItemCapture {
    public {
        AbstractDataProviderType target;
        list<hash<XsdUnionTrialResult>> items();
        int depth = 0;
    }
    constructor(AbstractDataProviderType target) {
        self.target = target;
    }
}

thread_local *XsdSchemaUnionItemCapture SchemaUnionItemCapture;
thread_local *XsdSchemaUnionItemCapture SchemaUnionListCapture;
thread_local *XsdProviderUnionItemCapture ProviderUnionItemCapture;

# Conversion of an element/attribute value has an instance context. These APIs
# cannot carry DTD declarations; detached simple-type operations remain datatype-only.
# Scoped to retained XML validation; no namespace allocations reach shared schema state.
thread_local *Namespaces RetainedXmlValidationNamespaces;

#! An explicitly present empty element assessed using its declaration's constraint
/** The native value accompanies the empty-element state. Use this carrier when
    serialization must preserve default application, including fixed constraints
    whose canonical value has a different actual type.
    @par Example
    Preserve an empty partner status that becomes a string through xsi:type,
    while its original union declaration has a boolean fixed value.
    @since %WSDL 0.5.8
*/
public final class XsdDefaultValue inherits Serializable {
    private {
        auto value;
    }
    #! retains the native value of a defaulted empty occurrence
    /** @param value the complete converted native value, including any attributes
        @throw XSD-DEFAULT-VALUE-ERROR nested default or nil carriers are not allowed
    */
    constructor(auto value) {
        initialize(value, "XSD-DEFAULT-VALUE-ERROR");
    }
    private initialize(auto value, string error) {
        if (value instanceof XsdDefaultValue || value instanceof XsdNilValue) {
            throw error, "an empty default carrier requires an ordinary native value";
        }
        self.value = value;
    }
    private:internal deserializeMembers(hash<auto> members) {
        # Serializable omits members whose value is NOTHING. That is a valid
        # native projection of an empty lexical value, checked by its receiver.
        if (members.size() > 1 || (members && !members.hasKey("value"))) {
            throw "DESERIALIZATION-ERROR", "an empty default carrier contains invalid members";
        }
        initialize(members.value, "DESERIALIZATION-ERROR");
    }
    #! returns the native value assessed under the actual type
    /** @return the retained scalar, list or complete record */
    auto getValue() {
        return value;
    }
}

class XsdEmptyElementDefaultHelper {
    static bool empty(auto value) {
        if (!exists value) {
            return True;
        }
        if (value.typeCode() != NT_HASH) {
            return value.typeCode() == NT_STRING && value == "";
        }
        foreach string key in (keys value) {
            if (key == "^attributes^" || key == ".ns" || key.startsWith("^comment")) {
                continue;
            }
            if ((!key.startsWith("^value") && !key.startsWith("^cdata"))
                    || (exists value{key} && (value{key}.typeCode() != NT_STRING || value{key} != ""))) {
                return False;
            }
        }
        return True;
    }

    static auto apply(XsdAbstractType selected, auto value, string lexical,
            hash<string, string> namespaces) {
        bool scoped = True;
        if (selected instanceof XsdComplexType) {
            XsdComplexType complex_type = cast<XsdComplexType>(selected);
            if (!complex_type.allowsElementValueConstraint()) {
                throw SOAP_DESERIALIZATION_ERROR, "an empty element default requires simple or emptiable mixed content";
            }
            scoped = exists complex_type.simpleType;
        } else if (XsdGenericValueHelper::isGeneric(selected)) {
            scoped = False;
        }
        auto text = scoped ? new XsdScopedLexicalValue(lexical, namespaces) : lexical;
        if (value.typeCode() != NT_HASH) {
            return text;
        }
        foreach string key in (keys value) {
            if (key.startsWith("^value") || key.startsWith("^cdata")) {
                remove value{key};
            }
        }
        value."^value^" = text;
        return value;
    }
}

class XsdFixedValueHelper {
    static string text(auto data, string error) {
        if (data.typeCode() != NT_HASH) {
            return exists data ? XsdUnionValueHelper::text(data, error) : "";
        }
        list<string> fragments();
        foreach string key in (keys data) {
            if (key == "^attributes^" || key == ".ns" || key.startsWith("^comment")) {
                continue;
            }
            if (!key.startsWith("^value") && !key.startsWith("^cdata")) {
                throw error, "an element with a fixed value cannot contain child elements";
            }
            if (exists data{key}) {
                fragments += XsdUnionValueHelper::text(data{key}, error);
            }
        }
        return fragments.join("");
    }
}

# A validation owns bindings; element scopes carry owner identities without
# retaining input trees. Only selected, successfully converted values contribute.
class XsdIdentityBindings {
    static bool contains(XsdAbstractType type) {
        list<XsdAbstractType> pending = (type,);
        hash<string, bool> visited();
        while (pending) {
            XsdAbstractType current = pop pending;
            string key = current.uniqueHash();
            if (visited{key}) {
                continue;
            }
            visited{key} = True;
            if (current instanceof XsdBaseType && (current.name == "ID" || current.name == "IDREF"
                    || current.name == "IDREFS" || current.name == "anyType")) {
                return True;
            }
            if (current instanceof XsdSimpleType) {
                XsdSimpleType simple = cast<XsdSimpleType>(current);
                if (simple.type) {
                    push pending, simple.type;
                }
                if (simple.listItemType) {
                    push pending, simple.listItemType;
                }
                pending += simple.unionTypes ?? ();
            }
            if (current instanceof XsdComplexType) {
                XsdComplexType complex = cast<XsdComplexType>(current);
                if (exists complex.getAttributeWildcard() || complex.hasElementWildcard()) {
                    return True;
                }
                if (complex.simpleType) {
                    push pending, complex.simpleType;
                }
                foreach XsdAttribute attribute in (complex.attrs.iterator()) {
                    push pending, attribute.type;
                }
                foreach XsdElement element in (complex.elementmap.iterator()) {
                    if (element.getIdentityConstraints()) {
                        return True;
                    }
                    push pending, element.type;
                }
                if (complex.getParticle()) {
                    foreach XsdElement element in (XsdElementFieldHelper::getParticleDeclarations(
                            complex.getParticle(), complex.getParticle().getElementOccurrenceRanges()).iterator()) {
                        if (element.getIdentityConstraints()) {
                            return True;
                        }
                        push pending, element.type;
                    }
                }
            }
        }
        return False;
    }
    private {
        hash<string, int> bindings();
        int next_owner = 0;
    }
    int owner() {
        if (next_owner == 9223372036854775807) {
            throw "XSD-IDENTITY-ERROR", "element identity counter exhausted";
        }
        return ++next_owner;
    }
    record(hash<XsdUnionValueIdentity> value, int owner) {
        foreach string token in (value.idrefs) {
            if (!bindings.hasKey(token)) {
                bindings{token} = 0;
            }
        }
        foreach string token in (value.ids) {
            if (!bindings.hasKey(token) || !bindings{token}) {
                bindings{token} = owner;
            } else if (owner && bindings{token} != owner) {
                bindings{token} = -1;
            }
        }
    }
    check(string error) {
        foreach string token in (keys bindings) {
            if (!bindings{token}) {
                throw error, sprintf("ID/IDREF value %Y has no ID binding in the validation root (cvc-id.1)", token);
            }
            if (bindings{token} == -1) {
                throw error, sprintf("ID value %Y identifies more than one element in the validation root (cvc-id.2)", token);
            }
        }
    }
}

class XsdIdentityFrame {
    public {
        XsdIdentityBindings bindings;
        int owner;
        int parent;
    }
    constructor(*XsdIdentityFrame previous) {
        bindings = previous ? previous.bindings : new XsdIdentityBindings();
        parent = previous ? previous.owner : 0;
        owner = bindings.owner();
    }
    record(hash<XsdUnionValueIdentity> value, bool attribute) {
        bindings.record(value, attribute ? owner : parent);
    }
}

thread_local *XsdIdentityFrame IdentityElement;
thread_local bool IdentityChecksSuspended;

class XsdIdentityElementScope {
    private {
        *XsdIdentityFrame previous;
        *XsdIdentityFrame frame;
        bool active = False;
    }
    constructor(bool only_if_missing = False) {
        if (IdentityChecksSuspended || (only_if_missing && IdentityElement)) {
            return;
        }
        previous = IdentityElement;
        frame = new XsdIdentityFrame(previous);
        IdentityElement = frame;
        active = True;
    }
    destructor() {
        if (active) {
            IdentityElement = previous;
        }
    }
    finish(string error) {
        if (active && !previous) {
            frame.bindings.check(error);
        }
    }
}

# Conversion checks that will be repeated on the complete value do not create
# independent validation roots or contribute a second set of element owners.
class XsdIdentitySuspendScope {
    private {
        bool previous;
    }
    constructor() {
        previous = IdentityChecksSuspended ?? False;
        IdentityChecksSuspended = True;
    }
    destructor() {
        IdentityChecksSuspended = previous;
    }
}

# Public complete-document calls are independent even when invoked by a custom
# converter during another document's assessment.
class XsdIdentityDocumentScope {
    private {
        *XsdIdentityFrame previous;
        bool suspended;
        *XsdIdentityTupleNode previous_tuple;
    }
    constructor() {
        previous_tuple = IdentityTupleNode;
        IdentityTupleNode = NOTHING;
        previous = IdentityElement;
        suspended = IdentityChecksSuspended ?? False;
        IdentityElement = NOTHING;
        IdentityChecksSuspended = False;
    }
    destructor() {
        IdentityElement = previous;
        IdentityTupleNode = previous_tuple;
        IdentityChecksSuspended = suspended;
    }
}

# Copyright (C) 2026 Qore Technologies, s.r.o.
# Instance-local state, retained only while an owning constraint needs its subtree.
class XsdIdentityTupleNode {
    public {
        string namespace_uri;
        string local_name;
        bool attribute = False;
        bool nillable = False;
        bool simple = False;
        *hash<XsdUnionValueIdentity> value;
        list<XsdIdentityTupleNode> children();
        list<XsdIdentityTupleNode> attributes();
        list<XsdIdentityConstraint> definitions();
        hash<string, hash<string, string>> tables();
    }
    constructor(string namespace_uri, string local_name) {
        self.namespace_uri = namespace_uri;
        self.local_name = local_name;
    }
    static bool simpleType(XsdAbstractType type) {
        return type instanceof XsdComplexType ? exists cast<XsdComplexType>(type).simpleType
            : !XsdTypeSubstitutionHelper::builtin(type, "anyType");
    }
    static bool matches(XsdIdentityTupleNode node, hash<XsdIdentityStepInfo> step) {
        return (!exists step.namespace_uri || step.namespace_uri == node.namespace_uri)
            && (!exists step.local_name || step.local_name == node.local_name);
    }
    list<XsdIdentityTupleNode> select(list<hash<XsdIdentityPathInfo>> alternatives) {
        hash<string, XsdIdentityTupleNode> result();
        foreach hash<XsdIdentityPathInfo> path in (alternatives) {
            hash<string, XsdIdentityTupleNode> current = {self.uniqueHash(): self};
            if (path.descendants) {
                list<XsdIdentityTupleNode> pending = children;
                while (pending) {
                    XsdIdentityTupleNode child = pop pending;
                    current{child.uniqueHash()} = child;
                    pending += child.children;
                }
            }
            foreach hash<XsdIdentityStepInfo> step in (path.steps) {
                if (step.axis == XsdIdentityAxis::Self) {
                    continue;
                }
                hash<string, XsdIdentityTupleNode> following();
                foreach XsdIdentityTupleNode cursor in (current.iterator()) {
                    foreach XsdIdentityTupleNode child in (step.axis == XsdIdentityAxis::Attribute
                            ? cursor.attributes : cursor.children) {
                        if (matches(child, step)) {
                            following{child.uniqueHash()} = child;
                        }
                    }
                }
                current = following;
            }
            result += current;
        }
        list<XsdIdentityTupleNode> selected();
        foreach XsdIdentityTupleNode item in (result.iterator()) {
            selected += item;
        }
        return selected;
    }
    private hash<string, string> tuples(XsdIdentityConstraint definition, string error) {
        hash<string, string> result();
        bool key = definition.getCategory() == XsdIdentityCategory::Key;
        foreach XsdIdentityTupleNode row in (select(definition.getSelectorPaths())) {
            list<string> parts();
            bool complete = True;
            foreach list<hash<XsdIdentityPathInfo>> paths in (definition.getFieldPaths()) {
                list<XsdIdentityTupleNode> selected = row.select(paths);
                if (selected.size() > 1) {
                    throw error, sprintf("identity constraint %Y field %d selects multiple nodes",
                        definition.getExpandedName(), $# + 1);
                }
                if (!selected) {
                    complete = False;
                    continue;
                }
                XsdIdentityTupleNode field = selected[0];
                if (!field.simple) {
                    throw error, sprintf("identity constraint %Y field %d requires a simple typed value",
                        definition.getExpandedName(), $# + 1);
                }
                if (key && !field.attribute && field.nillable) {
                    throw error, sprintf("key %Y selects a nillable element declaration",
                        definition.getExpandedName());
                }
                if (!field.value) {
                    complete = False;
                    continue;
                }
                string value_key = XsdUnionValueHelper::key(field.value);
                parts += sprintf("%d:%s", value_key.length(), value_key);
            }
            if (!complete) {
                if (key) {
                    throw error, sprintf("key %Y requires every field value", definition.getExpandedName());
                }
                continue;
            }
            string tuple = parts.join("");
            if (result.hasKey(tuple) && definition.getCategory() != XsdIdentityCategory::KeyRef) {
                throw error, sprintf("identity constraint %Y has duplicate field values",
                    definition.getExpandedName());
            }
            result{tuple} = row.uniqueHash();
        }
        return result;
    }
    validate(string error) {
        # An empty owner marks a conflict between distinct descendant nodes.
        hash<string, hash<string, bool>> conflicts();
        foreach XsdIdentityTupleNode child in (children) {
            # A child has already checked its local keyrefs. Its tables belong
            # to this scope now; retain its nodes and values for ancestor XPath
            # selection without retaining a table copy at every tree level.
            if (!tables) {
                tables = remove child.tables;
                continue;
            }
            foreach string name in (keys child.tables) {
                foreach string tuple in (keys child.tables{name}) {
                    string owner = child.tables{name}{tuple};
                    if (!tables{name}.hasKey(tuple)) {
                        tables{name}{tuple} = owner;
                    } else if (tables{name}{tuple} != owner) {
                        tables{name}{tuple} = "";
                        conflicts{name}{tuple} = True;
                    }
                }
            }
            remove child.tables;
        }
        foreach XsdIdentityConstraint definition in (definitions) {
            if (definition.getCategory() != XsdIdentityCategory::KeyRef) {
                hash<string, string> local = tuples(definition, error);
                # Local entries take precedence over conflicting inherited entries.
                tables{definition.getExpandedName()} += local;
            }
        }
        # Revisit only collisions: rescanning every inherited entry at every
        # ancestor makes a deep tree quadratic even when no local keys exist.
        foreach string name in (keys conflicts) {
            foreach string tuple in (keys conflicts{name}) {
                if (!tables{name}{tuple}) {
                    remove tables{name}{tuple};
                }
            }
        }
        foreach XsdIdentityConstraint definition in (definitions) {
            if (definition.getCategory() == XsdIdentityCategory::KeyRef) {
                hash<string, string> references = tuples(definition, error);
                foreach string tuple in (keys references) {
                    if (!tables{definition.getReferencedName()}.hasKey(tuple)) {
                        throw error, sprintf("keyref %Y has no matching %Y value in its element scope",
                            definition.getExpandedName(), definition.getReferencedName());
                    }
                }
            }
        }
    }
}

thread_local *XsdIdentityTupleNode IdentityTupleNode;

class XsdIdentityTupleScope {
    private {
        *XsdIdentityTupleNode previous;
        *XsdIdentityTupleNode node;
    }
    constructor(XsdElement declaration) {
        if (IdentityChecksSuspended || (!IdentityTupleNode && !declaration.getIdentityConstraints())) {
            return;
        }
        previous = IdentityTupleNode;
        node = new XsdIdentityTupleNode(declaration.getNamespaceUri(), declaration.name);
        node.nillable = declaration.isNillable();
        node.definitions = declaration.getIdentityConstraints();
        IdentityTupleNode = node;
    }
    constructor(string identity) {
        if (IdentityChecksSuspended || !IdentityTupleNode) {
            return;
        }
        previous = IdentityTupleNode;
        XsdQNameValue name = XsdWildcardAttributeHelper::name(identity, SOAP_DESERIALIZATION_ERROR);
        node = new XsdIdentityTupleNode(name.getNamespaceUri(), name.getLocalName());
        IdentityTupleNode = node;
    }
    static unassessedAttribute(string identity, auto value) {
        if (IdentityTupleNode && !IdentityChecksSuspended) {
            XsdQNameValue name = XsdWildcardAttributeHelper::name(identity, SOAP_DESERIALIZATION_ERROR);
            XsdIdentityTupleNode child(name.getNamespaceUri(), name.getLocalName());
            child.attribute = True;
            child.simple = True;
            child.value = <XsdUnionValueIdentity>{"family":"string", "value":
                value instanceof XsdScopedLexicalValue ? value.getLexicalValue() : string(value)};
            IdentityTupleNode.attributes += child;
        }
    }
    destructor() {
        if (node) {
            IdentityTupleNode = previous;
        }
    }
    # Capture only actual XML attributes. The selected type or nil state does not
    # imply that an xsi attribute was present on the element.
    instanceAttributes(auto value, string error, *Namespaces output) {
        if (!node || value.typeCode() != NT_HASH) {
            return;
        }
        try {
            *hash<auto> attributes = value."^attributes^";
            if (output) {
                attributes = XsdQNameContextHelper::attributes(output.getReferencedNamespaceMap() ?? {})
                    + (attributes ?? {});
            }
            XsdQNameNamespaceScope scope(attributes, exists output);
            hash<auto> expanded = XsdBase::getExpandedAttributes(attributes);
            foreach string local in ("type", "nil", "schemaLocation", "noNamespaceSchemaLocation") {
                string name = type_qname(XSI_NS, local);
                if (!expanded.hasKey(name)) {
                    continue;
                }
                auto lexical = expanded{name};
                if (lexical instanceof XsdScopedLexicalValue) {
                    lexical = lexical.getLexicalValue();
                }
                hash<XsdUnionValueIdentity> identity;
                if (local == "type") {
                    XsdQNameValue qname = XsdQNameValueHelper::resolve(lexical, error, QNameInputNamespaces);
                    identity = <XsdUnionValueIdentity>{"family":"QName",
                        "value":(qname.getNamespaceUri(), qname.getLocalName())};
                } else if (local == "nil") {
                    identity = <XsdUnionValueIdentity>{"family":"boolean",
                        "value":XsdBooleanLexicalHelper::decode(lexical, error)};
                } else if (local == "schemaLocation") {
                    list<string> items();
                    foreach string token in (XsdListValueHelper::tokens(lexical)) {
                        items += XsdUnionValueHelper::key(<XsdUnionValueIdentity>{"family":"anyURI",
                            "value":XsdTextLexicalHelper::lexical("anyURI", token, error)});
                    }
                    identity = <XsdUnionValueIdentity>{"family":"list", "value":items};
                } else {
                    identity = <XsdUnionValueIdentity>{"family":"anyURI",
                        "value":XsdTextLexicalHelper::lexical("anyURI", lexical, error)};
                }
                XsdIdentityTupleNode attribute(XSI_NS, local);
                attribute.attribute = True;
                attribute.simple = True;
                attribute.value = identity;
                node.attributes += attribute;
            }
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == SOAP_DESERIALIZATION_ERROR && error == SOAP_SERIALIZATION_ERROR) {
                rethrow error, ex.desc, ex.arg;
            }
            rethrow;
        }
    }
    bool captures() {
        return exists node;
    }
    value(XsdAbstractType type, *hash<XsdUnionValueIdentity> identity) {
        if (node) {
            node.simple = XsdIdentityTupleNode::simpleType(type);
            node.value = identity;
        }
    }
    finish(string error) {
        if (node) {
            node.validate(error);
            if (previous) {
                previous.children += node;
            }
        }
    }
    static attribute(XsdAttribute declaration, *hash<XsdUnionValueIdentity> identity) {
        if (IdentityTupleNode && !IdentityChecksSuspended) {
            XsdIdentityTupleNode node(declaration.namespaceUri, declaration.name);
            node.attribute = True;
            node.simple = True;
            node.value = identity;
            IdentityTupleNode.attributes += node;
        }
    }
}

class XsdDocumentValueResult {
    public {
        *hash<XsdUnionValueIdentity> identity;
        *XsdAbstractType actual_type;
        bool simple_only;
    }
    constructor(bool simple_only = False) {
        self.simple_only = simple_only;
    }
}

thread_local *XsdDocumentValueResult GenericDocumentValueResult;

class XsdDocumentValueHelper {
    static hash<auto> typeAttributes(XsdAbstractType type, Namespaces output, *string local_name) {
        string uri = type.ons ? type.nsc.getOutputNamespaceUri(type.ons) : "";
        string prefix = uri ? output.getOutputNamespacePrefix(uri) : "";
        return {output.getOutputNamespacePrefix(XSI_NS) + ":type":
            (prefix ? prefix + ":" : "") + (local_name ?? type.name)};
    }

    static auto serializeValue(XsdAbstractType type, Namespaces nsc, auto value, *softbool omitType,
            *XsdDocumentValueResult captured, bool attribute = False) {
        if (type.isAbstract()) {
            throw SOAP_SERIALIZATION_ERROR, sprintf("abstract type %Y cannot validate an instance", type.name);
        }
        *XsdDocumentValueResult caller = GenericDocumentValueResult;
        on_exit GenericDocumentValueResult = caller;
        GenericDocumentValueResult = XsdGenericValueHelper::isGeneric(type) ? captured : NOTHING;
        XsdDocumentValueCapture capture(type);
        auto converted = type.serializeValue(nsc, value, omitType);
        capture.validate(value, converted, SOAP_SERIALIZATION_ERROR, attribute, True);
        if (captured) {
            if (!captured.actual_type) {
                captured.actual_type = type;
            }
            if (!captured.identity && (!captured.simple_only
                    || XsdIdentityTupleNode::simpleType(captured.actual_type))) {
                captured.identity = capture.valueIdentity(value, converted, SOAP_SERIALIZATION_ERROR, True);
            }
        }
        return converted;
    }

    static auto serializePartValue(XsdAbstractType type, Namespaces nsc, auto value, *softbool omitType) {
        XsdIdentityElementScope identity_scope();
        on_success identity_scope.finish(SOAP_SERIALIZATION_ERROR);
        *hash<auto> annotation;
        if (XsdNativeTypeValueHelper::isWrapper(value)) {
            XsdNativeTypeValueHelper::checkWrapper(value);
            XsdAbstractType selected = XsdNativeTypeValueHelper::resolve(value."^type^", type);
            XsdTypeSubstitutionHelper::check(selected, type, type.name, SOAP_SERIALIZATION_ERROR);
            if (!XsdTypeDerivationHelper::sameType(selected, type)) {
                if (!selected.hasRealName()) {
                    throw SOAP_SERIALIZATION_ERROR, "an anonymous selected type cannot supply xsi:type";
                }
                annotation = typeAttributes(selected, nsc);
            } else {
                selected = type;
            }
            type = selected;
            value = value."^val^";
        }
        auto converted = serializeValue(type, nsc, value, omitType);
        if (annotation) {
            if (converted.typeCode() != NT_HASH) {
                return {"^value^": converted, "^attributes^": annotation};
            }
            converted."^attributes^" += annotation;
        }
        return converted;
    }

    static auto deserializeValue(XsdAbstractType type, string name, hash<string, XsdAbstractType> tmap,
            *hash<auto> references, auto value, bool retain_selection = False,
            *XsdDocumentValueResult captured, bool attribute = False) {
        *XsdIdentityElementScope identity_scope = retain_selection ? new XsdIdentityElementScope() : NOTHING;
        on_success {
            if (identity_scope) {
                identity_scope.finish(SOAP_DESERIALIZATION_ERROR);
            }
        }
        XsdQNameNamespaceScope scope(value.typeCode() == NT_HASH ? value."^attributes^" : NOTHING);
        XsdAbstractType declared = type;
        type = XsdTypeSubstitutionHelper::select(\value, type, tmap, name);
        *XsdScopedLexicalContext lexical_scope;
        if (!(type instanceof XsdComplexType) && !XsdGenericValueHelper::isGeneric(type)
                && value.typeCode() == NT_HASH && value."^value^" instanceof XsdScopedLexicalValue) {
            XsdBase::validateSimpleAttributes(value."^attributes^", type.name);
            value = value."^value^";
        }
        if (value instanceof XsdScopedLexicalValue) {
            lexical_scope = new XsdScopedLexicalContext(value, NOTHING);
            value = value.getLexicalValue();
        }
        XsdDocumentValueCapture capture(type);
        auto converted = type.deserializeValue(name, tmap, references, value);
        capture.validate(value, converted, SOAP_DESERIALIZATION_ERROR, attribute);
        if (captured) {
            captured.actual_type = type;
            if (!captured.simple_only || XsdIdentityTupleNode::simpleType(type)) {
                captured.identity = capture.valueIdentity(value, converted, SOAP_DESERIALIZATION_ERROR);
            }
        }
        # Generic XML decoding assesses the complete content. Re-encoding its
        # retained lexical tree would duplicate that assessment at every depth.
        if (RetainedXmlValidationNamespaces && !XsdGenericValueHelper::isGeneric(type)) {
            *XsdComplexType complex_type = type instanceof XsdComplexType ? cast<XsdComplexType>(type) : NOTHING;
            if (!complex_type || Class::getClass(complex_type).getPathName() != "WSDL::XsdComplexType"
                    || !complex_type.getParticle() || complex_type.array) {
                XsdIdentitySuspendScope identity_check();
                serializeValue(type, RetainedXmlValidationNamespaces, converted, True);
            }
        }
        return retain_selection ? XsdNativeTypeValueHelper::retain(declared, type, converted) : converted;
    }
}

# Capture the actual chosen member spelling only while compiling value constraints.
# A second validation must not replace the original computed value or the identity
# supplied by the first validation. Ordinary instance/provider trials do not
# compute canonical spellings.
thread_local bool CaptureConstraintLexical;
class XsdConstraintLexicalScope {
    private {
        bool previous;
    }
    constructor() {
        previous = CaptureConstraintLexical ?? False;
        CaptureConstraintLexical = True;
    }
    destructor() {
        CaptureConstraintLexical = previous;
    }
}

class XsdDocumentValueCapture {
    private {
        XsdAbstractType type;
        *XsdSchemaUnionItemCapture item;
        *XsdSchemaUnionItemCapture list;
        *XsdSchemaUnionItemCapture caller_item;
        *XsdSchemaUnionItemCapture caller_list;
    }

    constructor(XsdAbstractType type) {
        if (type instanceof XsdComplexType && cast<XsdComplexType>(type).simpleType) {
            type = cast<XsdComplexType>(type).simpleType;
        }
        self.type = type;
        caller_item = SchemaUnionItemCapture;
        caller_list = SchemaUnionListCapture;
        if (XsdUnionValueHelper::schemaUnionItem(type)) {
            item = caller_item && caller_item.target === type ? caller_item : new XsdSchemaUnionItemCapture(type);
        }
        *XsdSimpleType list_type = XsdUnionValueHelper::listType(type);
        if (list_type && XsdUnionValueHelper::schemaUnionItem(list_type.listItemType)) {
            list = caller_list && caller_list.target === list_type ? caller_list
                : new XsdSchemaUnionItemCapture(list_type);
        }
        SchemaUnionItemCapture = item;
        SchemaUnionListCapture = list;
    }

    destructor() {
        SchemaUnionItemCapture = caller_item;
        SchemaUnionListCapture = caller_list;
    }

    *hash<XsdUnionValueIdentity> valueIdentity(auto input, auto converted, string error, bool serialized = False) {
        # Mixed/generic content can have multiple independent text fragments.
        # Only simple values use one scoped lexical carrier as their entire value.
        bool simple = !XsdGenericValueHelper::isGeneric(type)
            && !(type instanceof XsdComplexType && cast<XsdComplexType>(type).hasMixedContent());
        *XsdScopedLexicalValue scoped = !simple ? NOTHING : input instanceof XsdScopedLexicalValue ? input
            : input.typeCode() == NT_HASH && input."^value^" instanceof XsdScopedLexicalValue ? input."^value^" : NOTHING;
        *XsdScopedLexicalContext lexical_scope;
        if (scoped) {
            lexical_scope = new XsdScopedLexicalContext(scoped, NOTHING);
            input = scoped.getLexicalValue();
        }
        if (item || list) {
            return item ? item.identity : list.identity;
        }
        *hash<XsdUnionAtomicInfo> atomic = XsdUnionValueHelper::describeAtomic(type);
        if (atomic) {
            return XsdUnionValueHelper::atomicIdentity(atomic, input, converted, error);
        }
        *hash<XsdUnionListInfo> info = XsdUnionValueHelper::describeList(type);
        if (info) {
            return XsdUnionValueHelper::listIdentity(info, input, converted, error);
        }
        if (XsdGenericValueHelper::isGeneric(type)
                || (type instanceof XsdComplexType && cast<XsdComplexType>(type).hasMixedContent())) {
            return <XsdUnionValueIdentity>{"family": "string", "value":
                XsdFixedValueHelper::text(input, error)};
        }
        if (type instanceof XsdBaseType && XsdUnionValueHelper::supports(type.name)) {
            # Custom native conversions still exchange the declared builtin's XML
            # value space. Assess that XML without invoking the custom converter again.
            hash<XsdUnionAtomicInfo> builtin_info = <XsdUnionAtomicInfo>{"builtin":type.name, "white_space":type.getWhiteSpace(),
                "preserve_lexical":False};
            auto lexical = serialized ? converted : input;
            return XsdUnionValueHelper::atomicIdentity(builtin_info, lexical, lexical, error);
        }
        return <XsdUnionValueIdentity>{"family": "native:" + Class::getClass(type).getPathName()
            + ":" + type_qname(type.ons ? type.nsc.getOutputNamespaceUri(type.ons) : "", type.name),
            "value": serialized ? input : converted};
    }

    validate(auto input, auto converted, string error, bool attribute = False, bool serialized = False) {
        # Mixed/generic content can have multiple independent text fragments.
        # Only simple values use one scoped lexical carrier as their entire value.
        bool simple = !XsdGenericValueHelper::isGeneric(type)
            && !(type instanceof XsdComplexType && cast<XsdComplexType>(type).hasMixedContent());
        *XsdScopedLexicalValue scoped = !simple ? NOTHING : input instanceof XsdScopedLexicalValue ? input
            : input.typeCode() == NT_HASH && input."^value^" instanceof XsdScopedLexicalValue ? input."^value^" : NOTHING;
        *XsdScopedLexicalContext lexical_scope;
        if (scoped) {
            lexical_scope = new XsdScopedLexicalContext(scoped, NOTHING);
            input = scoped.getLexicalValue();
        }
        if (IdentityElement && !IdentityChecksSuspended) {
            *hash<XsdUnionValueIdentity> identity = item ? item.identity : list ? list.identity : NOTHING;
            if (!item && !list) {
                *hash<XsdUnionAtomicInfo> atomic = XsdUnionValueHelper::describeAtomic(type);
                *hash<XsdUnionListInfo> info = atomic ? NOTHING : XsdUnionValueHelper::describeList(type);
                *string builtin = atomic ? atomic.builtin : info ? info.item.builtin
                    : type instanceof XsdBaseType ? type.name : NOTHING;
                if (builtin == "ID" || builtin == "IDREF" || builtin == "IDREFS") {
                    identity = valueIdentity(input, converted, error, serialized);
                }
            }
            if (identity && (identity.ids || identity.idrefs)) {
                IdentityElement.record(identity, attribute);
            }
        }
        *list<string> entities = item ? item.identity.entities : list ? list.identity.entities : NOTHING;
        if (!item && !list) {
            *hash<XsdUnionAtomicInfo> atomic = XsdUnionValueHelper::describeAtomic(type);
            *hash<XsdUnionListInfo> info = atomic ? NOTHING : XsdUnionValueHelper::describeList(type);
            if (atomic && (atomic.builtin == "ENTITY" || atomic.builtin == "ENTITIES")) {
                entities = XsdUnionValueHelper::atomicIdentity(atomic, input, converted, error).entities;
            } else if (info && info.item.builtin == "ENTITY") {
                entities = XsdUnionValueHelper::listIdentity(info, input, converted, error).entities;
            }
        }
        if (entities) {
            throw error, sprintf("ENTITY value %Y requires an unparsed-entity declaration in the containing "
                "document; this XML value context has no DTD declarations", entities[0]);
        }
    }
}

# Value comparison is separate from native input identity. Integer and decimal
# members share a value space; boolean and string values remain distinct from it.
class XsdUnionValueHelper {
    const StringFamily = {"string": True, "normalizedString": True, "token": True, "language": True,
        "Name": True, "NCName": True, "NMTOKEN": True, "ID": True, "IDREF": True, "ENTITY": True};

    static bool supports(string builtin) {
        return builtin == "QName" || builtin == "NOTATION" || builtin == "anyURI" || builtin == "anySimpleType" || XsdNumericFacetHelper::isType(builtin) || builtin == "boolean" || builtin == "duration" || builtin == "hexBinary"
            || builtin == "base64Binary" || StringFamily{builtin} || XsdBuiltinListHelper::isType(builtin)
            || XsdCalendarLexicalHelper::isType(builtin);
    }

    # Returns exact identities for the scalar families with completed value rules.
    # Other kinds are described by their own datatype conversion paths.
    static *hash<XsdUnionValueIdentity> atomicIdentity(XsdAbstractType member, auto input, auto converted,
            string error) {
        *hash<XsdUnionAtomicInfo> info = describeAtomic(member);
        return info ? atomicIdentity(info, input, converted, error) : NOTHING;
    }

    static auto serializeInput(XsdAbstractType member, auto input) {
        if (input.typeCode() == NT_STRING) {
            *hash<XsdUnionAtomicInfo> info = describeAtomic(member);
            if (info && XsdBinaryLexicalHelper::isType(info.builtin)) {
                # Union strings retain XML lexical values for member reselection.
                # Explicitly distinguish them from atomic binary serializer raw strings.
                string lexical = XsdBinaryLexicalHelper::lexical(info.builtin, input, SOAP_SERIALIZATION_ERROR);
                return new XsdBinaryValue(info.builtin, lexical);
            }
        }
        return input;
    }

    static *XsdSimpleType listType(XsdAbstractType member) {
        hash<string, bool> visited();
        while (member instanceof XsdSimpleType) {
            if (Class::getClass(member).getPathName() != "WSDL::XsdSimpleType") {
                return;
            }
            string key = member.uniqueHash();
            if (visited{key}) {
                throw "XSD-SIMPLETYPE-ERROR", "cyclic union list member metadata";
            }
            visited{key} = True;
            XsdSimpleType simple = cast<XsdSimpleType>(member);
            if (simple.listItemType) {
                return simple;
            }
            if (!simple.type) {
                return;
            }
            member = simple.type;
        }
    }

    static *hash<XsdUnionListInfo> describeList(XsdAbstractType member, *AbstractDataProviderType provider) {
        *XsdSimpleType list = listType(member);
        if (!list) {
            return;
        }
        if (schemaUnionItem(list.listItemType)) {
            return <XsdUnionListInfo>{"union_items": True, "provider": provider};
        }
        *hash<XsdUnionAtomicInfo> item = describeAtomic(list.listItemType,
            provider ? provider.getElementType() : NOTHING);
        return item ? <XsdUnionListInfo>{"item": item, "provider": provider} : NOTHING;
    }

    static bool schemaUnionItem(XsdAbstractType item) {
        hash<string, bool> visited();
        while (item instanceof XsdSimpleType) {
            if (Class::getClass(item).getPathName() != "WSDL::XsdSimpleType") {
                return False;
            }
            string key = item.uniqueHash();
            if (visited{key}) {
                throw "XSD-SIMPLETYPE-ERROR", "cyclic list item union metadata";
            }
            visited{key} = True;
            XsdSimpleType simple = cast<XsdSimpleType>(item);
            if (simple.unionTypes) {
                return True;
            }
            if (!simple.type) {
                return False;
            }
            item = simple.type;
        }
        return False;
    }

    static auto listInput(auto value, string error, *hash<XsdUnionListInfo> info) {
        value = XsdScalarTextHelper::value(value, error);
        if (value instanceof XsdQNameOutputText) {
            value = value.items;
        }
        if (info && value.typeCode() == NT_LIST) {
            foreach auto item in (value) {
                if (!exists item) {
                    throw error, "an XSD list cannot contain an omitted item";
                }
                if (info.item && item.typeCode() == NT_STRING) {
                    XsdListValueHelper::checkToken(XsdSimpleType::normalizeWhiteSpace(item, info.item.white_space),
                        error);
                }
            }
        }
        return value.typeCode() == NT_STRING ? XsdListValueHelper::tokens(value) : value;
    }

    static hash<XsdUnionValueIdentity> listIdentity(hash<XsdUnionListInfo> info, auto input, auto converted,
            string error) {
        input = listInput(input, error);
        if (input.typeCode() != NT_LIST) {
            input = exists input ? (input,) : ();
        }
        *hash<string, string> bindings = (info.item.builtin == "QName" || info.item.builtin == "NOTATION") && converted.typeCode() == NT_HASH
            ? XsdBase::getElementNamespaces(converted."^attributes^") : NOTHING;
        converted = listInput(converted, error);
        list<string> values();
        list<string> constraint_tokens();
        bool complete_lexical = CaptureConstraintLexical ?? False;
        *list<string> entities;
        *list<string> ids;
        *list<string> idrefs;
        foreach auto item in (input) {
            auto converted_item = converted.typeCode() == NT_LIST ? converted[$#] : converted;
            if (exists bindings) {
                converted_item = XsdQNameValueHelper::resolve(converted_item, error, bindings);
            }
            hash<XsdUnionValueIdentity> identity = atomicIdentity(info.item, item, converted_item, error);
            push values, key(identity);
            if (complete_lexical) {
                if (exists identity.constraint_lexical) {
                    push constraint_tokens, identity.constraint_lexical;
                } else {
                    complete_lexical = False;
                }
            }
            if (identity.entities) {
                entities += identity.entities;
            }
            if (identity.ids) {
                ids += identity.ids;
            }
            if (identity.idrefs) {
                idrefs += identity.idrefs;
            }
        }
        return <XsdUnionValueIdentity>{"family": "list", "value": values, "entities": entities,
            "constraint_lexical": complete_lexical ? constraint_tokens.join(" ") : NOTHING,
            "ids": ids, "idrefs": idrefs};
    }

    static *hash<XsdUnionValueIdentity> schemaListIdentity(hash<XsdUnionListInfo> info, XsdAbstractType member,
            auto input, auto converted, string error, hash<string, hash<XsdUnionValueIdentity>> identities) {
        if (info.union_items) {
            *XsdSimpleType list = listType(member);
            @assert(list);
            return identities{list.uniqueHash()};
        }
        return listIdentity(info, input, converted, error);
    }

    static string listLexical(hash<XsdUnionListInfo> info, list<auto> converted) {
        list<string> tokens();
        foreach auto item in (converted) {
            string token = item.typeCode() == NT_STRING
                ? XsdSimpleType::normalizeWhiteSpace(item, info.item.white_space) : lexical(info.item, item);
            XsdListValueHelper::checkToken(token, "RUNTIME-TYPE-ERROR");
            push tokens, token;
        }
        return tokens.join(" ");
    }

    static *hash<XsdUnionValueIdentity> capturedIdentity(list<*hash<XsdUnionValueIdentity>> identities) {
        list<string> values();
        list<string> constraint_tokens();
        bool complete_lexical = CaptureConstraintLexical ?? False;
        *list<string> entities;
        *list<string> ids;
        *list<string> idrefs;
        foreach *hash<XsdUnionValueIdentity> identity in (identities) {
            if (!identity) {
                return;
            }
            push values, key(identity);
            if (complete_lexical) {
                if (exists identity.constraint_lexical) {
                    push constraint_tokens, identity.constraint_lexical;
                } else {
                    complete_lexical = False;
                }
            }
            if (identity.entities) {
