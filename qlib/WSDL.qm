# make sure we have the required qore version
%requires qore >= 3.0

# requires XML functionality
%requires xml

# need mime definitions
%requires Mime >= 1.4.2

%requires(reexport) DataProvider
%requires FileLocationHandler

%modern

# allow the use of the := weak reference assignment operator
%allow-weak-references

%disable-warning unreferenced-variable

module WSDL {
    version = "0.5.8";
    desc = "WSDL module providing functionality for SOAP";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
}

/*
    WSDL classes
    provides some minimal WSDL and XSD support for SOAP messaging used by the SoapClient class and the SoapHandler

    not complete, needs namespace verification, improved XSD support, element groups, etc
*/

/** @mainpage WSDL Module

    @tableofcontents

    @section wsdlintro Introduction to the WSDL Module

    The %WSDL module provides functionality for <a href="http://en.wikipedia.org/wiki/SOAP">SOAP</a> 1.1 and 1.2.

    The main purpose of this module is to provide the infrastructure for developing SOAP client and server services.

    The main components of this module are as follows:
    - @ref WSDL::WebService "WebService": represents a WSDL file; an easy way to get an object of this type from a URL
      is by calling WSDL::WSDLLib::getWSDL()
    - @ref WSDL::WSDLLib "WSDLLib": a class of static functions providing helper functions for the module
    - @ref WSDL::WSOperation "WSOperation": a class representing a single operation from a SOAP web service
    - @ref WSDL::WSMessageHelper "WSMessageHelper": a class to create sample messages used by SOAP operations

    See the following for modules using the %WSDL module:
    - <a href="../../SoapClient/html/index.html">SoapClient user module</a>
    - <a href="../../SoapHandler/html/index.html">SoapHandler user module</a>

    @section wsdlrelnotes WSDL Module Release Notes

    @subsection wsdl_0_5_8 WSDL v0.5.8
    - union patterns use the selected leaf member's whitespace normalization through nested unions;
      generated union examples decode candidate text before serialization to preserve the selected value
    - binary restrictions compare enumeration/fixed/finite choices by octets and retain every inherited
      length and lexical pattern through reconstructed providers, lists, unions and generated examples
    - added \c XsdBinaryValue, \c XsdBinaryFacetInfo, \c XsdBinaryRestrictionDataType and \c XsdBinaryDataField;
      patterned binary decoding can return an immutable carrier exposing the accepted text and exact bytes,
      including internal base64 spacing; ordinary binary values retain their native representation
    - hexBinary and base64Binary decoding validates complete XSD lexical forms, including base64 padding
      positions and unused bits; XML whitespace between base64 characters is accepted
    - binary serialization preserves raw string bytes, including whitespace and the string's original encoding;
      added \c XsdBinaryDataType for validated encoded-text conversion, optionality and provider reconstruction
    - duration bounds and enumerations use the XSD four-reference-date relation with exact Gregorian arithmetic
      and arbitrary decimal fractions; fixed attributes, finite choices, lists and unions share this value identity
    - added \c XsdDurationRestrictionDataType, \c XsdDurationFacetInfo and \c XsdDurationDataField;
      reconstructed providers preserve inherited restrictions and examples validate every generated candidate
    - duration values validate XSD 1.0 grammar and retain arbitrary component sizes and fractional digits;
      native relative dates retain microseconds and use one leading sign, while absolute dates and
      opposing month/second component signs reject instead of producing invalid XML
    - added \c XsdDurationDataType for validated duration conversion in reconstructed and optional providers;
      duration decoding returns exact XML text and never coerces unrelated native categories
    - date, gYear, gYearMonth, gMonthDay, gMonth and gDay validate exact XML calendar grammar, Gregorian
      limits, signed extended years and whole-minute timezones within 14 hours of UTC
    - date decoding returns a native date only for an explicitly zoned value within the native year range;
      unzoned and arbitrary-year dates remain validated strings, and partial calendars remain strings;
      callers must handle this lossless string alternative instead of assuming every date is native
    - calendar serialization retains timezone offsets; bounds use the XSD partial order, with missing
      timezones kept distinct from UTC; enumerations, fixed values, lists and unions use exact calendar identity
    - added calendar provider types and finite-choice fields with validated reconstruction and optionality;
      calendar examples satisfy inherited facets and lexical patterns or raise XSD-SAMPLE-ERROR
    - float and double scalars validate complete XML numeric spellings and round directly to binary32 or
      binary64, including subnormals, overflow, signed zero and special values; serialization retains
      valid input text and emits round-trip-safe text for native values
    - added \c XsdIeeeDataType for strict IEEE provider validation, optional values and reconstructed
      provider lists; example generation supplies a numeric value for both IEEE builtins
    - IEEE bounds, enumerations, fixed attributes and finite field choices compare rounded target values;
      NaN uses XSD identity and partial ordering, and list/union comparisons retain primitive type identity
    - numeric provider metadata exposes \c getBuiltinName() and rejects conflicting builtin precision;
      IEEE examples retain lexical patterns and can select adjacent representable values at exclusive bounds
    - XSD patterns use structural matching with exact repetition counts and state sets for ordinary closures,
      avoiding backend compilation and backtracking limits; reconstructed schemas and providers retain the
      original expressions, and older serialized PCRE constraints remain readable
    - XSD patterns validate their own grammar and translate Unicode character-class unions, complements,
      ranges and nested subtraction consistently; the wildcard excludes both carriage return and newline
    - regex sample generation bounds repetition before native integer conversion and checks a bounded
      character alphabet against intersecting pattern restrictions
    - decimal values validate XML syntax before conversion and retain exact precision and noncanonical
      lexical forms as strings when native floats cannot reproduce them; decimal providers validate before conversion
    - native decimal float/number inputs use Qore 3.0 round-trip formatting without exponent notation;
      WSDL now requires Qore 3.0
    - decimal/integer restrictions compare bounds and enumeration exactly and count digits from the value;
      numeric providers and fields retain these constraints and equivalent lexical forms after reconstruction
    - numeric examples use exact bounded grid values, including restricted list items; impossible or unsupported
      numeric examples raise XSD-SAMPLE-ERROR instead of producing invalid sample messages
    - numeric restriction declarations reject malformed, inapplicable, widening, contradictory and changed fixed
      facets before use; XML namespace and annotation order checks preserve the schema grammar
    - totalDigits and fractionDigits retain exact arbitrary-size counts as XsdFacetCount, including provider
      reconstruction and generated examples
    - string restrictions normalize whitespace before inherited checks and compare enumeration values in the
      base value space; provider fields offer only choices that satisfy the complete restriction
    - length facets count Unicode characters, binary octets, or list items and validate exact arbitrary-size
      bounds, narrowing, applicability and fixed declarations; builtin token lists require at least one item
    - XsdSizedRestrictionDataType retains string and length constraints after reconstruction and optional/list
      wrapping; repeated list-valued elements preserve their separate occurrence and item lists
    - string, list-length and binary-length examples are validated against all inherited restrictions;
      bounded generation reports XSD-SAMPLE-ERROR when it cannot construct a valid example
    - lists of string, boolean, decimal and integer items compare enumeration choices as ordered values;
      whole-list patterns preserve item spellings through binding and provider reconstruction
    - native list items reject empty or XML-whitespace-containing lexical forms that cannot retain one item;
      list provider fields validate replacement choices before publishing them
    - generated list examples satisfy item constraints and inherited length, pattern and enumeration facets,
      or report XSD-SAMPLE-ERROR when bounded generation cannot find a valid value
    - union scalar serialization retains comment wrappers; union restrictions reject ordered bounds,
      and members retain their own string/token whitespace semantics
    - element-only schema and SOAP container validation accepts preserved XML formatting whitespace
      while rejecting non-whitespace text and retaining scalar values
    - union providers validate each value inside repeated lists and preserve explicit requiredness after
      reconstruction; member trials propagate cancellation and unexpected errors in providers and XML conversion
    - schema union serialization, deserialization and native-list metadata queries visit shared members once
      per conversion context, reject cycles, and keep nested rejection diagnostics bounded
    - union provider operations cache shared nested alternatives for each call and reject cyclic metadata;
      reentrant inputs and concurrent threads retain independent traversal state
    - boolean, integer/decimal, text and binary union members retain lexical input when native conversion
      would change the selected primitive value; union patterns validate the XML spelling
    - union enumerations and provider field choices compare primitive values, including equivalent
      decimal spellings and distinct boolean/integer values; detached providers retain these constraints
    - union members containing atomic lists retain item order and primitive families, accept lexical lists,
      preserve ambiguous item spellings, and compare list enumerations and field choices by exact item values
    - lists whose items select atomic union members retain each selected primitive value for enclosing union
      enumeration and field choices, including reconstructed providers and restricted item unions
    - list-owned enumeration, pattern and length facets also apply to union-valued items, preserving lexical
      tokens, inherited restrictions, generated examples and detached field validation
    - QName lexical conversion validates both NCName components using the XSD 1.0 character rules, collapses
      XML whitespace and rejects empty or malformed names; reconstructed providers retain grammar and pattern
      checks, and generated examples validate their lexical restrictions without applying deprecated length facets
    - builtin NMTOKENS, IDREFS and ENTITIES lists retain ordered value identity in unions and apply their own
      normalized enumeration, pattern and count facets in schema conversion, providers and generated examples
    - added immutable \c XsdQNameValue namespace/local identities and explicit-context \c XsdQNameDataType
      providers with lexical retention, reserved-binding validation and Serializable reconstruction
    - detached schema types and elements retain their declaration namespace context across schema destruction,
      incremental additions, imports and Serializable reconstruction
    - QName enumeration declarations retain each literal's namespace scope, reject unbound prefixes and
      invalid inherited restrictions, and preserve distinct values with identical prefix spellings
    - Name, NCName, NMTOKEN and their derived name types validate the XSD 1.0 Unicode character productions;
      builtin list items and regular-expression name escapes use the same character rules
    - builtin date and binary parse failures use SOAP validation errors so union selection can try later members
    - boolean restrictions retain lexical spellings for patterns across serialization and reconstructed providers;
      fixed attribute and field choices compare boolean values, and schema declarations reject inapplicable facets
    - boolean examples validate all inherited patterns against the four legal spellings and report
      XSD-SAMPLE-ERROR when no valid value exists
    - boolean values accept only the four XML spellings after XML whitespace collapse, native booleans,
      and numeric zero/one; provider lists validate before conversion and reject null or invalid spellings
    - integer builtins enforce exact ranges before conversion and retain values beyond signed 64-bit
      range as strings; native integral float/number values produce exact integer text
    - added \c XsdIntegerDataType for integer provider validation, including lists, optional values and
      Serializable reconstruction; generated negative-integer examples satisfy the builtin bounds
    - integer values reject invalid XML lexical forms before native conversion, including empty text,
      fractional/exponent spellings, trailing data and signed unsigned values; XML whitespace normalization
      replaces only TAB, LF and CR and collapses SPACE where required
    - retained XML values preserve inherited xml:lang, xml:space and resolved xml:base context separately
      from authored root attributes; child extraction, Serializable, XML generation and SOAP consumers
      retain that context, and incompatible retained siblings report a serialization error
    - unwrapped document arguments include nested choice fields and explicit element wildcard values;
      message-name containers remain supported, and selection preserves other parts and declared headers
    - ambiguous multipart document values require explicit part/element wrappers; attribute wildcards and
      absent zero/zero element particles do not claim unwrapped child values
    - element declarations reject contradictory type/default/fixed specifications and invalid local/global
      properties; declaration booleans accept all XSD spellings, and empty type names report namespace errors
    - resolved ID-derived attributes and element content cannot have value constraints; complex types reject
      multiple ID-derived attribute uses, including inherited and grouped uses
    - message parts resolve element QNames in their actual message/part namespace scope; parts referring
      to different element namespaces can share a local name, including body/header separation
    - multipart message examples now include every part, using the same part names as provider fields;
      document output uses the referenced element name, including roots in no namespace
    - element fields with the same local name in different namespaces now use expanded-name keys;
      inherited/grouped declarations, choices, provider fields and generated examples retain each identity,
      while unambiguous fields keep their existing local names
    - document message bodies and declared SOAP headers now match element namespace URIs as well as local
      names; wrong qualification and unbound prefixes fail before schema value conversion
    - added \c XsdBase::expandElementNamespaces() and \c XsdBase::restoreElementNamespaces() for parsed
      XML element identities and namespace-safe wildcard output, preserving repeated values and order
    - one-way SOAP calls return NOTHING for an absent response instead of requiring an output binding description
    - element-based literal SOAP parts accept explicit XML values after existing decode/encode checks;
      XML request/response APIs, schema XML providers and XML examples preserve native API defaults
    - retained SOAP XML rejects DOCTYPEs and processing instructions; comments, CDATA, lexical text and
      inherited namespace declarations remain available in received body and header values
    - added \c XsdXmlValue for retaining lexical text, namespace contexts and complete ordered XML;
      provides an XML reader, a data view and XML generator integration, and reconstructs its views from
      the authoritative XML during Serializable deserialization
    - fixed declaration-local namespace resolution for element and simple type QNames, including
      default-namespace resets and shadowed prefixes; internal type resolution uses expanded names
      without falling back to unrelated local-name aliases
    - standalone \c XsdSchema objects now retain source documents and retrieved dependency bytes for
      Serializable reconstruction; unsuccessful additions restore their component registries
    - fixed no-target-namespace type identity and retained global element attributes during type resolution
    - schema construction now rejects imports after component declarations and unexpected schema children,
      including in external and WSDL-inline schemas
    - complex-content derivation bases retain expanded namespace identity and resolve builtin \c anyType;
      empty extensions inherit base members/attributes, restrictions retain their own particle, and cyclic
      derivations fail with a schema error
    - attribute declarations resolve global references and anonymous simple types, use \c anySimpleType when
      no type is declared, and reject contradictory declarations or complex attribute types; required and
      prohibited attribute uses are checked even when the value has no attribute hash
    - simple-content derivations retain namespace-local base identity, inherited attributes and restricted
      scalar facets; false, zero and empty content return the same scalar representation as other values,
      and bare document messages accept the existing \c ^value^ / \c ^attributes^ representation
    - attribute restrictions preserve requiredness, fixed constraints and simple-type ancestry; extensions
      reject duplicate expanded attribute uses, and inline simple-content types must restrict the base content type
    - simple-content restrictions accept named mixed bases whose particles are emptiable, preserving inherited
      attributes and applying inline types and outer facets; nested group references are validated even in optional
      branches, and empty extensions preserve the effective mixed content of their base
    - attribute wildcard construction preserves namespace and processContents constraints through groups and
      derivation; restrictions reject newly introduced attributes outside the base wildcard, incompatible namespace
      subsets and weaker processing, while non-expressible XSD 1.0 wildcard combinations are schema errors
    - schema construction retains element declarations before field-map merging and rejects conflicting types
      for one expanded element name, including nested/reused groups and extensions; references to one anonymous
      declaration remain reusable, while absent particles contribute no declaration
    - schema references require imports in their own source document even when components were loaded elsewhere;
      import checks distinguish absent namespace attributes from explicit empty values, preserve that distinction
      in reference caches, and reject empty targetNamespace declarations
    - schema imports/includes resolve their complete dependency graph before types are finalized; chameleon
      includes acquire distinct components in each namespace, cycles reuse loaded sources, and mismatched
      imported/included target namespaces are rejected
    - inline schemas without a target namespace no longer inherit the WSDL target namespace; builtin input
      prefixes must be declared, builtin names and declaration names are validated, and local element form
      overrides control serialized qualification
    - simple-type dependency cycles and complex dependencies are rejected; forward union members preserve
      declaration order, inline restrictions resolve correctly, and invalid list item varieties are rejected
    - group and attribute-group references retain declaration-local namespaces and reject undefined or cyclic
      references; whitespace in reference QNames no longer leaks into public element/attribute field names
    - attribute defaults/fixed values are typed, inherited through global refs and checked in both directions;
      absent optional attributes receive their constraint value, required fixed attributes require explicit
      values, and bare complex messages preserve their attribute hashes
    - attribute input/output names use declaration namespace URIs, including inherited instance prefixes and
      local form overrides; unknown attributes are rejected and colliding local names use expanded field keys
    - adding schema files from multiple directories resolves imports relative to each file, preserves their
      bases through reconstruction, and restores the previous default base when an addition fails
    - complex element-content and empty-content provider types expose \c ^attributes^ fields with requiredness,
      typed defaults, fixed/enumerated choices and expanded collision keys; generated attribute examples honor
      fixed/default values, including on simple content
    - attributed simple-content providers accept the existing \c ^value^ / \c ^attributes^ representation and
      expose its fields, while retaining scalar inputs/outputs when all attributes are optional; scalar choices
      apply to the value field and invalid structured inputs cannot fall back to scalar conversion
    - child element type/reference QNames inherit namespace declarations on \c sequence, \c choice and \c all,
      including nested/default scopes, choice alternatives and legacy array element sequences
    - encoded array item types use the \c wsdl:arrayType declaration's namespace scope and canonical type
      identity during finalization; user-defined array types retain their own schema namespace
    - imported and added schema contexts reserve enclosing output prefixes before allocating their own,
      preserving type names when schemas have colliding preferred prefixes
    - fixed serializing values in the upper half of the \c xs:unsignedShort and \c xs:unsignedInt ranges;
      the limits are now 65535 and 4294967295 respectively
    - fixed serializing native IEEE floating-point infinities and NaN as XSD \c INF, \c -INF, and \c NaN;
      decoded special values previously produced invalid lowercase XML values
    - added offline regression tests using W3C XML Schema Databinding WSDLs and SOAP messages, plus an
      optional corpus survey with independent XSD validation
    - added support for the XSD \c include statement
    - fixed resolving relative \c schemaLocation values; they are now resolved against the location of the document
      containing the reference and not against the location of the top-level WSDL
    - fixed handling element \c ref attributes with no namespace prefix
    - fixed handling element declarations with no type information; such elements now have type \c xs:anyType
    - fixed handling \c simpleType \c union definitions with more than one anonymous member type definition
    - fixed resolving \c simpleType \c restriction base types declared after the restricting type in the schema
    - fixed serializing XSD attribute values; attribute values are now serialized according to their type like
      element values, so dates, booleans, and binary values are written in their XSD representation
    - fixed serializing \c xs:boolean values given as strings; \c "false" and \c "0" are now serialized as
      \c "false" instead of \c "true"
    - fixed handling \c complexType \c choice definitions declared with \c minOccurs="0"; such choices no longer
      require a member to be present
    - fixed a runtime error serializing a \c complexType \c choice with no member supplied; a descriptive
      exception is now thrown if the choice is required
    - fixed a runtime error retrieving the data provider type for a \c complexType \c choice definition
    - fixed deserializing messages whose parts are split between the SOAP header and the SOAP body; the body parts
      are now taken from the \c parts attribute of the \c soap:body element, or, if that attribute is not present,
      from the message parts not bound to a SOAP header
    - fixed reporting enumeration values for numeric, boolean, and date types; they were always reported as strings,
      which also caused an error when retrieving the data provider type for such a type
    - data provider types for scalar XSD types are now soft types (ex: \c softint), matching the values accepted
      when serializing
    - fixed the data provider type for \c xs:boolean; string values are now parsed according to the XSD boolean
      lexical space, so that \c "false" and \c "0" are converted to @ref False "False"
    - fixed generating example messages for \c complexType \c choice definitions and \c simpleType \c union
      definitions
      (<a href="https://github.com/qoretechnologies/qore/issues/5405">issue 5405</a>)
    - added support for async schema import caching for polling operations
    - extracted the XSD schema parsing infrastructure from \c WebService into a new public
      @ref WSDL::XsdSchema class so that bare XSD documents (for example, industry message
      standards delivered as XSD packages) can be parsed and queried without a WSDL wrapper;
      \c WebService now inherits from \c XsdSchema with no API change to existing callers
    - fixed the type registry to support XSDs that reuse the same local type name across
      different target namespaces (for example, UN/CEFACT \c PictureType is defined in both
      \c UnqualifiedDataType:37 and \c ReusableAggregateBusinessInformationEntity:37). Types
      are now keyed by \c "{namespace_uri}local_name" alongside a backward-compatible local-name
      fallback entry. Type resolution prefers namespace-qualified lookup when the input
      namespace prefix is known. Single-namespace WSDLs continue to work unchanged. New helper
      @ref WSDL::make_qname() exposes the qualified-key construction.
    - fixed handling nested XSD model groups; elements declared in an \c xs:sequence, \c xs:choice, or \c xs:all
      nested in another model group were silently dropped from the type, so they could neither be serialized nor
      deserialized
    - added support for \c xs:choice alternatives declared as nested model groups; all the elements of a single
      alternative can now be serialized and deserialized together
    - fixed the data provider type for a \c complexType with a \c sequence containing a \c choice block; the
      members of the choice were not reported as fields
      (<a href="https://github.com/qoretechnologies/qore/issues/5410">issue 5410</a>)
    - fixed combining multiple \c xs:pattern facets declared in the same restriction; they were intersected, so a
      type declaring one pattern per alternative form (ex: one per IPv6 textual form) rejected every value.  XSD
      1.0 part 2 4.3.4.3 combines sibling patterns with \c "|", so a value matching any one of them is valid;
      patterns declared in different derivation steps continue to be intersected
    - fixed anchoring \c xs:pattern facets with a top-level alternation; the pattern is now wrapped in a
      non-capturing group, so that \c "a|b" is anchored as \c "^(?:a|b)$" and no longer accepts any value merely
      starting with \c "a" or ending with \c "b"
      (<a href="https://github.com/qoretechnologies/qore/issues/5411">issue 5411</a>)
    - <b>API change</b>: renamed the XSD type \c serialize() and \c deserialize() instance
      methods on \c XsdAbstractType, \c XsdBaseType, \c XsdSimpleType, \c XsdComplexType,
      \c XsdArrayType, and \c XsdElement to \c serializeValue() and \c deserializeValue()
      respectively. The previous names collided with \c Qore::Serializable's Java-bridge
      methods, causing \c java.lang.ClassFormatError: Duplicate method name "serialize" on
      \c qoremod.WSDL.XsdAbstractType when these classes were imported through the \c jni
      module. Direct callers of these methods (for example, custom SOAP wire-format code
      and array-serialization tests) must update to the new names. \c Qore::Serializable's
      \c serialize() / \c deserialize() byte-level API on \c WebService and the surrounding
      classes is unchanged.

    @subsection wsdl_0_5_7 WSDL v0.5.7
    - moved WSDL class declarations inside the WSDL namespace for compatibility with %strong-encapsulation

    @subsection wsdl_0_5_6 WSDL v0.5.6
    <b>Namespace Handling Improvements</b>
    - fixed asymmetric namespace mapping in \c merge() that could cause lookup failures after prefix collisions
    - improved namespace prefix generation: increased from 3 to 6 characters for better readability
    - added \c tryGetInputNamespaceUri() method for safe namespace lookups without exceptions
    - added stack depth validation for \c pushTargetNamespace() / \c popTargetNamespace() and
      \c pushDefaultNamespace() / \c popDefaultNamespace() to catch mismatched push/pop errors
    - added SOAP encoding namespace validation in complexType array and extension handling
    - added @@assert() statements for precondition checking in namespace methods:
      - \c getUniquePrefix(): validates URI is provided
      - \c getOutputNamespaceUri(): validates prefix is provided
      - \c getOutputNamespacePrefix(): validates namespace URI is provided
      - \c getInputNamespaceUri(): validates namespace prefix is provided
      - \c doType(): validates type name and namespace prefix existence
      - push/pop namespace methods: validates stack integrity

    @subsection wsdl_0_5_5 WSDL v0.5.5
    - added length validation for dateTime and time value parsing to prevent crashes on malformed data
    - added thread-safety documentation to the @ref WSDL::WebService "WebService" class

    @subsection wsdl_0_5_4 WSDL v0.5.4
    - fixed a bug returning data provider type info for simpleTypes with union definitions
      (<a href="https://github.com/qorelanguage/qore/issues/4480">issue 4480</a>)

    @subsection wsdl_0_5_3 WSDL v0.5.3
    - fixed a bug handling \c complexType elements with a \c sequence and and \a any element
      (<a href="https://github.com/qorelanguage/qore/issues/4452">issue 4452</a>)
    - fixed a confusing bug in the error message for
      @ref WSDL::WSDLLib::getWebServiceFromUrl() "WSDLLib::getWebServiceFromUrl()" when the file could not be read
      (<a href="https://github.com/qorelanguage/qore/issues/4451">issue 4451</a>)
    - fixed bugs loading URLs with multiple imports of the same external XSD schema
      (<a href="https://github.com/qorelanguage/qore/issues/4449">issue 4449</a>)

    @subsection wsdl_0_5_2 WSDL v0.5.2
    - fixed a bug where the web service's name was not reported correctly by the
      @ref WSDL::WebService "WebService" object
      (<a href="https://github.com/qorelanguage/qore/issues/4437">issue 4437</a>)

    @subsection wsdl_0_5_1 WSDL v0.5.1
    - added support for the FileLocationHandler module

    @subsection wsdl_0_5 WSDL v0.5
    - added support for the data provider API

    @subsection wsdl_0_4 WSDL v0.4
    - added support for serializing and deserilizing WebService objects
      (<a href="https://github.com/qorelanguage/qore/issues/2793">issue 2793</a> and
      <a href="https://github.com/qorelanguage/qore/issues/1598">issue 1598</a>)

    @subsection wsdl_0_3_8 WSDL v0.3.8
    - fixed a bug handling complexTypes as part types
      (<a href="https://github.com/qorelanguage/qore/issues/2900">issue 2900</a>)
    - fixed bugs handling array types
      (<a href="https://github.com/qorelanguage/qore/issues/2899">issue 2899</a>)
    - added support for \c token and \c normalizedString types
      (<a href="https://github.com/qorelanguage/qore/issues/2859">issue 2859</a>)
    - fixed @ref WSDL::WSDLLib::getWSDL when passed a WSDL string with no XML preamble
      (<a href="https://github.com/qorelanguage/qore/issues/2857">issue 2857</a>)
    - fixed handling of XSD attribute names with non-word characters
      (<a href="https://github.com/qorelanguage/qore/issues/2856">issue 2856</a>)
    - fixed handling of \c simpleType definitions with \c union members
      (<a href="https://github.com/qorelanguage/qore/issues/2855">issue 2855</a>)

    @subsection wsdl_0_3_7 WSDL v0.3.7
    - implemented supoprt for handling SOAP faults in response messages with SOAP bindings
      (<a href="https://github.com/qorelanguage/qore/issues/2804">issue 2804</a>)
    - fixed an error in namespace resolution with nested namespaces
      (<a href="https://github.com/qorelanguage/qore/issues/2786">issue 2786</a>)
    - fixed a type error in example message generation that resulted in failed example message generation
      (<a href="https://github.com/qorelanguage/qore/issues/2782">issue 2782</a>)
    - fixed a bug in example message generation that resulted in invalid messages
      (<a href="https://github.com/qorelanguage/qore/issues/2752">issue 2752</a>)
    - implemented the @ref WSDL::wsdl_set_global_compat_empty_string_is_nothing()
    "wsdl_set_global_compat_empty_string_is_nothing"
      function and the \c "compat_empty_string_is_nothing" option for the
      @ref WSDL::WebService "WebService" class for backwards compatibility with older versions of the WSDL
      module (<a href="https://github.com/qorelanguage/qore/issues/2754">issue 2754</a>)
    - implemented the @ref WSDL::wsdl_set_global_compat_empty_string_is_nothing()
    "wsdl_set_global_compat_allow_any_header"
      function and the \c "compat_allow_any_header" option for the @ref WSDL::WebService "WebService" class
      for backwards compatibility with older versions of the WSDL module
      (<a href="https://github.com/qorelanguage/qore/issues/2765">issue 2765</a>)

    @subsection wsdl_0_3_6 WSDL v0.3.6
    - reimplmented operation to support multi binding, operation can be assigned to more bindings
    - support for HTTP binding and content-types, "^content-type^" attribute can identify content type to be used
    - extended SOAP binding serialization and deserialization with support to both body and header

    @subsection wsdl_0_3_5_1 WSDL v0.3.5.1
    - supress emitting a SOAPAction header in requests if the binding gives an empty string (<a href="https://github.com/qorelanguage/qore/issues/1226">issue 1226</a>)
    - updated @ref WSDL::WSOperation::serializeRequest() to allow the SOAPAction header to be overridden in each request (<a href="https://github.com/qorelanguage/qore/issues/1226">issue 1226</a>)
    - respect XML generation flags in request generation
    - fixed parsing empty base64Binary and hexBinary elements (<a href="https://github.com/qorelanguage/qore/issues/1227">issue 1227</a>)

    @subsection wsdl_0_3_5 WSDL v0.3.5
    - fixed many message serialization and deserialization issues
    - added @ref WSDL::WebService::getOperation()
    - allow for environment variable substitution in WSDLLib::getWSDL() when retrieving files
    - fixed charset=... header value
    - added @ref WSDL::WSMessageHelper
    - added @ref WSDL::WebService::getReport()

    @subsection wsdl_0_3_4 WSDL v0.3.4
    - updated to a user module

    @subsection wsdl_0_3_3 WSDL v0.3.3
    - added initial support for the anyAttribute element of complexType
    - added initial support for SOAP header processing
    - added initial support for multiple portType and bindings in a WSDL

    @subsection wsdl_0_3_2 WSDL v0.3.2
    - fixed bugs de/serializing negative values for "int" and "short"

    @subsection wsdl_0_3_1 WSDL v0.3.1
    - improved XSD imports and namespace handling

    @subsection wsdl_0_3_0 WSDL v0.3.0
    - implemented WSDLLib class of helper functions
    - implemented support for xsd import statements in WSDLs

    @subsection wsdl_0_2_0 WSDL v0.2.0
    - use parseXMLAsData() instead of parseXML()
    - implemented initial simpleType support
    - fixed xsd:date serialization and deserialization
*/

#! main WSDL namespace
public namespace WSDL {
#! this WSDL implementation version
public const version     = "0.3.6";

#! SOAP 1.1 envelope URI
public const SOAP_11_ENV  = "http://schemas.xmlsoap.org/soap/envelope/";
#! SOAP 1.2 envelope URI
public const SOAP_12_ENV  = "http://www.w3.org/2003/05/soap-envelope";

#! SOAP 1.1 namespace URI
public const SOAP_11_NS   = "http://schemas.xmlsoap.org/wsdl/soap/";

#! SOAP 1.2 namespace URI
public const SOAP_12_NS   = "http://schemas.xmlsoap.org/wsdl/soap12/";

#! XSD namespace URI
public const XSD_NS       = "http://www.w3.org/2001/XMLSchema";
#! XSI namespace URI
public const XSI_NS       = "http://www.w3.org/2001/XMLSchema-instance";

#! HTTP namespace URI
public const HTTP_NS      = "http://schemas.xmlsoap.org/wsdl/http/";
#! MIME namespace URI
public const MIME_NS      = "http://schemas.xmlsoap.org/wsdl/mime/";

#! soap 1.1 envelope namespaces
public const ENVELOPE_11_NS = (
    "soapenv:Envelope": (
        "^attributes^": (
            "xmlns:soapenv": SOAP_11_ENV,
            "xmlns:xsd": XSD_NS,
            "xmlns:xsi": XSI_NS,
        ),
    ),
);

#! soap 1.2 envelope namespaces
public const ENVELOPE_12_NS = (
    "soapenv:Envelope": (
        "^attributes^": (
            "xmlns:soapenv": SOAP_12_ENV,
          "xmlns:xsd": XSD_NS,
          "xmlns:xsi": XSI_NS,
        ),
    ),
);

#! SOAP "use" to "encoded" mappings
public const SoapUseMap = (
    "encoded": True,
    "literal": False,
);

#! SOAP "style" to "document" mappings
public const SoapStyleMap = (
    "document": True,
    "rpc": False,
);

#! soap encoding URI
public const SOAP_ENCODING = "http://schemas.xmlsoap.org/soap/encoding/";

#! mapping from Qore types to xsd types for xsd type "anyType"
public const any_type_map = (
    Type::String      : "string",
    Type::Int         : "long",
    Type::Boolean     : "boolean",
    Type::Date        : "dateTime",
    Type::Float       : "decimal",
    Type::NothingType : "string",
    Type::NullType    : "string",
    Type::Binary      : "base64Binary",
);

# error codes
const SOAP_SERIALIZATION_ERROR = "SOAP-SERIALIZATION-ERROR";
const SOAP_DESERIALIZATION_ERROR = "SOAP-DESERIALIZATION-ERROR";
const WSDL_ERROR = "WSDL-ERROR";

#! SOAP HTTP transport URI
const SOAP_TRANSPORT_HTTP = "http://schemas.xmlsoap.org/soap/http";

#! known/supported transports
public const SOAP_TRANSPORT = (
    SOAP_TRANSPORT_HTTP: True,
);

#! XOP (XML-binary Optimized Packaging) namespace URI
public const XOP_NS = "http://www.w3.org/2004/08/xop/include";

#! MTOM (Message Transmission Optimization Mechanism) content type
public const MTOM_CONTENT_TYPE = "application/xop+xml";

#! Minimum size in bytes for binary data to be optimized with MTOM
public const MTOM_THRESHOLD = 1024;

#! range of "byte" values (8 bits, signed)
public const RANGE_BYTE = (-128, 127);

#! range of "short" values (16 bits)
public const RANGE_SHORT = (-32768, 32767);

#! range of "int" values (32 bits)
public const RANGE_INT = (-2147483648, 2147483647);

# private global variables
our bool global_compat_empty_string_is_nothing;
our bool global_compat_allow_any_header;

#! sets the \c global_compat_empty_string_is_nothing variable to the given value to force the WSDL module to return a blank value for a required string field when the associated XML element is present as no value instead of an empty string for backwards compatibility with xml module 1.3
public sub wsdl_set_global_compat_empty_string_is_nothing(softbool val) {
    global_compat_empty_string_is_nothing = val;
}

#! sets the \c global_compat_allow_any_header variable to the given value to force the WSDL module to allow any SOAP header to be sent in SOAP messages for backwards compatibility with xml module 1.3
public sub wsdl_set_global_compat_allow_any_header(softbool val) {
    global_compat_allow_any_header = val;
}

#! contains helper methods for retrieving WSDLs from a URL
public class WSDLLib {
    #! Mime types recognized as SOAP messages
    const SoapMimeTypes = (MimeTypeSoapXml, MimeTypeXml, MimeTypeXmlApp);

    static string getSoapMimeType12(bool soap12) {
        return soap12 ? MimeTypeSoapXml : MimeTypeXml;
    }

    #! retrieves a local file and returns the file's contents as a string
    /** called by WSDLLib::getFileFromURL() in case the scheme is "file"
    */
    static data getFile(string fn, bool as_string = True) {
        *data rv = as_string ? ReadOnlyFile::readTextFile(fn) : ReadOnlyFile::readBinaryFile(fn);
        if (!exists rv) {
            throw "WSDL-LIB-ERROR", sprintf("file %y is empty or could not be read as a normal file", fn);
        }

        return rv;
    }

    #! normalizes a location to a scheme-prefixed string
    /** @note Applies environment variable substitution and default path resolution for file locations

        @since %WSDL 0.5.8
    */
    static string normalizeLocation(string url, string def_protocol = "file", *string def_path) {
        if (url =~ /^\w+:\/\//) {
            return url;
        }
        if (def_protocol != "file") {
            return def_protocol + "://" + url;
        }
        string path = url;
        # do environment variable substitution
        map path = replace(path, "\$" + $1, ENV.$1), (path =~ x/\$(\w+)/g);
        if (def_path && !absolute_path(path)) {
            path = def_path + DirSep + path;
        }
        return "file://" + path;
    }

    #! returns @ref True "True" if the given location has a URL scheme (ex: \c "http://...")
    /** @since %WSDL 0.5.8
    */
    static bool hasScheme(string location) {
        return location =~ /^[a-zA-Z][-+.a-zA-Z0-9]*:\/\//;
    }

    #! returns the base location to use when resolving locations relative to the given location
    /** @param location the location of a WSDL or XSD document

        @return the directory of the given path, or, if the location is a URL, the URL with the last path component
        removed

        @since %WSDL 0.5.8
    */
    static string getLocationBase(string location) {
        if (WSDLLib::hasScheme(location)) {
            # only the path component of the URL may be truncated; the authority must be kept intact
            (*string scheme, *string rest) = (location =~ x/^([a-zA-Z][-+.a-zA-Z0-9]*:\/\/)(.*)$/);
            *string base = (rest =~ x/^(.*)\/[^\/]*$/)[0];
            return exists base ? scheme + base : location;
        }
        return dirname(location);
    }

    #! resolves a possibly-relative location against a base location
    /** relative locations in \c schemaLocation and \c location attributes must be resolved against the location of
        the document containing the attribute and not against the location of the top-level WSDL document

        @param location the location to resolve; if it has a URL scheme or is an absolute path, it is returned
        unchanged
        @param base the base location as returned by
        @ref WSDL::WSDLLib::getLocationBase() "WSDLLib::getLocationBase()"; if not present, then \a location is
        returned unchanged

        @return the resolved location

        @since %WSDL 0.5.8
    */
    static string resolveLocation(string location, *string base) {
        if (!base || WSDLLib::hasScheme(location) || absolute_path(location)) {
            return location;
        }
        if (WSDLLib::hasScheme(base)) {
            # resolve relative to the base URL; only the path component of the URL may be normalized
            (*string scheme, *string rest) = (base =~ x/^([a-zA-Z][-+.a-zA-Z0-9]*:\/\/)(.*)$/);
            (*string authority, *string path) = (rest =~ x/^([^\/]*)(\/.*)?$/);
            return scheme + authority + normalize_dir((path ?? "") + "/" + location, "/");
        }
        return normalize_dir(base + DirSep + location);
    }

    #! retrieves a file from a URL with HTTP and returns the file's contents as a string
    /** called by WSDLLib::getFileFromURL() in case the scheme is "http"
    */
    static string getHTTP(string url, *string path, *HTTPClient hc, *hash<auto> headers, bool as_string = True) {
        if (hc) {
            hc.setURL(url);
        } else {
            hc = new HTTPClient(("url": url));
        }
        string body;
        try {
            body = hc.get(path ? path : "/", headers);
        } catch (hash<ExceptionInfo> ex) {
            throw ex.err, sprintf("error loading WSDL from %y: %s", url, ex.desc), ex.arg;
        }
        return as_string ? body : binary(body);
    }

    #! retrieves a file from a URL with the FTP protocol and returns the file's contents as binary or string data
    /** called by WSDLLib::getFileFromURL() in case the scheme is "ftp"
    */
    static data getFTP(string url, string path, bool as_string = True) {
        string file = basename(path);
        if (!file) {
            throw "WSDL-LIB-ERROR", sprintf("missing file name in URL %y", url);
        }

        FtpClient f(url);
        f.connect();

        string dir = dirname(path);
        if (dir) {
            f.cwd(dir);
        }

        return as_string ? f.getAsString(file) : f.getAsBinary(file);
    }

    #! retrieves a file from a URL
    /** in case the URL is actually a file path, environment variable substitution
        is performed on the path string

        @note uses the \c FileLocationHandler module to retrieve file data for all schemes except \c "file://" and
        \c "http(s)://", which uses @ref WSDL::WSDLLib::getFileFromURL() "WSDLLib::getFileFromURL()" and
        @ref WSDL::WSDLLib::getHTTP() "WSDLLib::getHTTP()" respectively for backwards compatibility
     */
    static data getFileFromURL(string url, string def_protocol = "file", *HTTPClient http_client,
            *hash<auto> http_headers, bool as_string = True, *string def_path, *reference new_def_path) {
        try {
            return WSDLLib::getFileFromURL(url, parse_url(url), def_protocol, http_client, http_headers, as_string,
                def_path, \new_def_path);
        } catch (hash<ExceptionInfo> ex) {
            # re-throw HTTP errors - don't fall back to FileLocationHandler for these
            if (ex.err =~ /^HTTP/) {
                rethrow;
            }
            # see if a scheme is given in the location
            if (url !~ /^\w+:\/\//) {
                url = def_protocol + "://" + url;
            }
            return FileLocationHandler::getFileFromLocation(as_string, url);
        }
    }

    #! retrieves a file from an already-parsed URL
    /** in case the URL is actually a file path, environment variable substitution
        is performed on the path string

        @note uses the \c FileLocationHandler module to retrieve file data for all schemes except \c "file://" and
        \c "http(s)://", which uses @ref WSDL::WSDLLib::getFileFromURL() "WSDLLib::getFileFromURL()" and
        @ref WSDL::WSDLLib::getHTTP() "WSDLLib::getHTTP()" respectively for backwards compatibility
     */
    static data getFileFromURL(string url, hash<auto> u, string def_protocol = "file", *HTTPClient http_client,
            *hash<auto> http_headers, bool as_string = False, *string def_path, *reference new_def_path) {
        bool used_def_protocol;
        if (!exists u.protocol) {
            u.protocol = def_protocol;
            used_def_protocol = True;
        }

        switch (u.protocol) {
            case "file": {
                string path;
                if (u.host) {
                    path = u.host;
                }
                if (u.path) {
                    if (path) {
                        path += DirSep;
                    }
                    path += u.path;
                }
                # do environment variable substitution
                map path = replace(path, "\$" + $1, ENV.$1), (path =~ x/\$(\w+)/g);

                if (def_path && !absolute_path(path)) {
                    path = normalize_dir(def_path + DirSep + path);
                }
                # the base location must always be updated, otherwise nested relative references in
                # externally-referenced schemas are resolved against the wrong directory
                new_def_path = dirname(path);
                return WSDLLib::getFile(path, as_string);
            }

            case /^http(s)?$/:
                # allow relative references in externally-referenced schemas to be resolved
                new_def_path = WSDLLib::getLocationBase(url);
                return WSDLLib::getHTTP(url, u.path, http_client, http_headers, as_string);

            default:
                if (used_def_protocol) {
                    url = def_protocol + "://" + url;
                }
                return FileLocationHandler::getFileFromLocation(as_string, url);
        }
    }

    #! returns the argument
    static WebService getWSDL(WebService wsdl) {
        return wsdl;
    }

    #! returns a WSDL string from a file name, optional HTTPClient object and optional header hash
    /** in case the \a wsdl argument is actually a file path, environment variable substitution
        is performed on the path string
     */
    static string getWSDL(string wsdl, *HTTPClient http_client, *hash<auto> http_headers, *reference new_def_path) {
        if (wsdl =~ /^</) {
            return wsdl;
        }
        return WSDLLib::getFileFromURL(wsdl, "file", http_client, http_headers, NOTHING, NOTHING, \new_def_path);
    }

    #! returns a WebService object from a URL and other optional arguments
    /** @param url the URL to use to retrieve the file, the \c "file://", \c "http://", \c "https://", and \c "ftp://" schemes are supported, if no scheme is present, then \c "file://" is assumed
        @param http_client an optional HTTPClient object to use to retrieve external schemas, if no HTTPClient object is passed and one is needed, an HTTPClient object will be created implicitly
        @param http_headers any HTTP headers to send with requests when retrieving external XSD schemas
    */
    static WebService getWebServiceFromUrl(string url, *HTTPClient http_client, *hash<auto> http_headers) {
        string def_path;
        string wsdl = WSDLLib::getWSDL(url, http_client, http_headers, \def_path);
        return new WebService(wsdl, {"def_path": def_path, "http_client": http_client, "http_headers": http_headers});
    }

    #! takes a hash representation of a SOAP message and handles multipart messages, checks the content-type, and handles hrefs in the message
    static hash<auto> parseMultiPartSOAPMessage(hash<auto> msg) {
        if (exists msg."_qore_multipart") {
            if (msg."_qore_multipart" != "related") {
                throw "SOAP-MESSAGE-ERROR", sprintf("don't understand multipart/%s messages; expected multipart/related", msg."_qore_multipart");
            }

            auto bdry = msg."_qore_multipart_boundary";
            if (!bdry.val()) {
                throw "SOAP-MESSAGE-ERROR", sprintf("multipart message received without multipart boundary; headers: %y", msg - "body");
            }

            hash<auto> mpmsg;
            list<string> l = split("\r\n--" + bdry, msg.body);

            for (int i = 1; i < (elements l - 1); ++i) {
                string m = l[i];

                int ie = index(m, "\r\n\r\n");
                if (ie == -1) {
                    throw "SOAP-MESSAGE-ERROR", sprintf("part %d has no headers: %y", i, m);
                }
                hash<auto> hh;
                foreach string hl in (split("\r\n", substr(m, 2, ie))) {
                    trim hl;
                    (string hi, auto ignore, string ha) = hl =~ x/^(.*):([ \t])*(.*)$/;
                    hi = tolower(hi);
                    #printf("hl: %y hi: %y ha: %y\n", hl, hi, ha);exit();
                    hh{hi} = ha;
                }
                if (!exists hh."content-id") {
                    throw "SOAP-MESSAGE-ERROR", sprintf("expecting part header Content-ID in part %d; headers: %y",
                        i, hh);
                }

                auto b;
                if (hh."content-transfer-encoding" == "binary") {
                    # unfortunately we have to do some tricks to get the binary data out here
                    # FIXME: tricks probably not necessary with qore 0.8.1+
                    m = force_encoding(m, "ascii");
                    # recalculate byte offset
                    ie = index(m, "\r\n\r\n");
                    #printf("ie: %d m: %d\n", ie, strlen(m));exit();
                    b = binary(substr(m, ie + 4));

                    #File f(); f.open2("t.bin", O_CREAT|O_WRONLY|O_TRUNC); f.write(b); exit();
                } else {
                    b = substr(m, ie + 4);

                    if (hh."content-type" =~ /charset=/) {
                        string c = (hh."content-type" =~ x/charset=([^;]+)/)[0];
                        b = force_encoding(b, c);
                    }
                }

                if (hh."content-id" !~ /^\<.*\>$/) {
                    throw "SOAP-MESSAGE-ERROR", sprintf("expected part ID to have the following format: <id>, "
                        "instead got %s", hh."content-id");
                }

                hash<auto> p = (
                    "hdr": hh,
                    "body": b,
                );

                if ((!exists msg."_qore_multipart_start" && i == 1)
                    || (exists msg."_qore_multipart_start" && msg."_qore_multipart_start" == hh."content-id")) {
                    mpmsg.body = p;
                } else {
                    string id = substr(hh."content-id", 1, -1);
                    mpmsg.part{id} = p;
                }
            }

            # Detect MTOM/XOP messages
            bool is_mtom = mpmsg.body.hdr."content-type" =~ /application\/xop\+xml/i;

            return {
                'content-type': mpmsg.body.hdr."content-type",
                'header': msg.header + mpmsg.body.hdr,
                'body': mpmsg.body.body,
                'parts': mpmsg.part,
                'is_mtom': is_mtom,
            };
        } else {
            return {
                'content-type': msg."_qore_orig_content_type",
                'header': msg.header,
                'body': msg.body,
            };
        }
    }

    #! Checks if an element is an xop:Include element by verifying the namespace
    /** @param key the element key (may include prefix like "xop:Include")
        @param node the element node (hash with attributes)
        @return True if this is a valid xop:Include element
    */
    private static bool isXopIncludeElement(string key, auto node) {
        # Determine local name and optional prefix from the element key
        string prefix;
        string local;
        if (key =~ /^([^:]+):(.*)$/) {
            prefix = ($1)[0];
            local = ($1)[1];
        } else {
            prefix = "";
            local = key;
        }

        if (local != "Include") {
            return False;
        }

        if (!node || node.typeCode() != NT_HASH) {
            return False;
        }

        *hash<auto> attrs = node."^attributes^";
        if (!attrs) {
            return False;
        }

        # If there is a prefix, require a matching xmlns:<prefix> declaration
        if (prefix) {
            string ns_attr = "xmlns:" + prefix;
            return attrs{ns_attr} == XOP_NS;
        }

        # No prefix: require default namespace to be the XOP namespace
        return attrs{"xmlns"} == XOP_NS;
    }

    #! Resolves xop:Include references in an XML data structure
    /** @param data reference to the XML data structure to process
        @param parts hash of MIME parts keyed by content-id
    */
    static substXopInclude(reference<auto> data, hash<auto> parts) {
        if (data.typeCode() == NT_HASH) {
            # Check for xop:Include element
            foreach string key in (keys data) {
                if ((key =~ /:Include$/ || key == "Include") && isXopIncludeElement(key, data{key})) {
                    # This is a verified xop:Include element
                    *hash<auto> attrs = data{key}."^attributes^";
                    if (attrs && attrs.href) {
                        string href = attrs.href;
                        if (href =~ /^cid:/) {
                            # Extract content-id from cid: URI
                            string cid = substr(href, 4);  # Remove "cid:" prefix
                            if (parts{cid}) {
                                # Replace the xop:Include with the binary data
                                data = parts{cid}.body;
                                return;
                            }
                        }
                    }
                } else {
                    # Recursively process nested structures
                    WSDLLib::substXopInclude(\data{key}, parts);
                }
            }
        } else if (data.typeCode() == NT_LIST) {
            for (int i = 0; i < data.size(); ++i) {
                WSDLLib::substXopInclude(\data[i], parts);
            }
        }
    }

    #! Creates an MTOM/XOP multipart message from XML and binary attachments
    /** @param xml the XML SOAP message body
        @param attachments list of hashes with keys: 'cid' (content-id), 'content_type', 'data' (binary)
        @param boundary optional multipart boundary string
        @return hash with 'content_type' and 'body' keys for the multipart message
    */
    static hash<auto> packageMtom(string xml, list<hash<auto>> attachments, *string boundary) {
        if (!boundary) {
            boundary = "----=_Part_" + get_random_string(20);
        }

        # Build the root part (XOP document)
        string root_cid = "root.message@qore.org";

        # Build all parts into a list and join at the end
        list<auto> parts = ();

        # Root part header and content
        string root_header = "--" + boundary + "\r\n";
        root_header += "Content-Type: application/xop+xml; charset=utf-8; type=\"text/xml\"\r\n";
        root_header += "Content-Transfer-Encoding: 8bit\r\n";
        root_header += "Content-ID: <" + root_cid + ">\r\n";
        root_header += "\r\n";
        root_header += xml + "\r\n";
        parts += root_header;

        # Add each binary attachment
        foreach hash<auto> att in (attachments) {
            string att_header = "--" + boundary + "\r\n";
            att_header += "Content-Type: " + (att.content_type ?? "application/octet-stream") + "\r\n";
            att_header += "Content-Transfer-Encoding: binary\r\n";
            att_header += "Content-ID: <" + att.cid + ">\r\n";
            att_header += "\r\n";
            parts += att_header;
            parts += att.data;
            parts += "\r\n";
        }

        # Close the multipart message
        parts += "--" + boundary + "--\r\n";

        # Join all parts - convert to binary if any binary parts exist
        bool has_binary = False;
        foreach auto p in (parts) {
            if (p.typeCode() == NT_BINARY) {
                has_binary = True;
                break;
            }
        }

        auto body;
        if (has_binary) {
            body = binary();
            foreach auto p in (parts) {
                if (p.typeCode() == NT_BINARY) {
                    body += p;
                } else {
                    body += binary(p);
                }
            }
        } else {
            body = parts.join("");
        }

        return {
            "content_type": sprintf("multipart/related; boundary=\"%s\"; type=\"application/xop+xml\"; start=\"<%s>\"",
                boundary, root_cid),
            "body": body,
        };
    }

    #! returns True is the message has a SOAP mime type
    static bool isSOAPMessage(hash<auto> msg) {
        return WsdlLibPriv::isContentType(msg."content-type", SoapMimeTypes);
    }

    #! returns True if the message is an MTOM/XOP message
    static bool isMtomMessage(hash<auto> msg) {
        return msg."content-type" =~ /application\/xop\+xml/i;
    }

    /**!
    takes a hash representation returned by parseMultiPartSOAPMessage and parses it to a Qore data structure, checks the content-type, and handles hrefs in the message.
    Operation is not yet known if SoapAction header is not presented
    */
    static *hash<auto> parseSOAPMessage(hash<auto> msg) {
        if (!msg.body) {
            hash<auto> h."content-type" = msg."content-type" ?? "text/plain";
            h.body = NOTHING;
            return h;
        } else if (WSDLLib::isSOAPMessage(msg) || WSDLLib::isMtomMessage(msg)) {
            hash<auto> xmldata;
            if (msg.body) {
                xmldata = parse_xml(msg.body);
            }
            if (msg.parts) {
                # For MTOM messages, resolve xop:Include references
                if (msg.is_mtom) {
                    WSDLLib::substXopInclude(\xmldata, msg.parts);
                } else {
                    # For traditional multipart messages, parse entire data structure to find "href"s
                    WSDLLib::substHref(\xmldata, msg.parts);
                }
            }
            return xmldata;
        } else {
            string ct = msg."content-type";
            hash<auto> h."content-type" = (ct =~ x/^([^;]+)/)[0];
            if (ct =~ /charset=/) {
                string c = (ct =~ x/charset=([^;]+)/)[0];
                h.body = force_encoding(msg.body, c);
            } else {
                h.body = binary(msg.body);  # needed or is it already ?
            }
            return h;
        }
    }

    private static processHref(reference xmldata, string hr, hash<auto> parts) {
        if (hr !~ /^cid:/)
            throw "SOAP-MESSAGE-ERROR", sprintf("messages references non-local part %y; cannot handle non-local parts", hr);
        hr = substr(hr, 4);
        if (!exists parts{hr})
            throw "SOAP-MESSAGE-ERROR", sprintf("message references non-existent part %y", hr);
        xmldata = parts{hr}.body;
    }

    private static substHref(reference xmldata, hash<auto> parts) {
        foreach string k in (keys xmldata) {
            if (exists xmldata{k}."^attributes^".href)
                WSDLLib::processHref(\xmldata{k}, xmldata{k}."^attributes^".href, parts);
            else if (exists xmldata{k}.href)
                WSDLLib::processHref(\xmldata{k}, xmldata{k}.href, parts);
            else if (xmldata{k}.typeCode() == NT_LIST) {
                foreach auto e in (\xmldata{k})
                    WSDLLib::substHref(\e, parts);
            } else if (xmldata{k}.typeCode() == NT_HASH)
                WSDLLib::substHref(\xmldata{k}, parts);
        }
    }
}

# private, nmon-exported class
class WsdlLibPriv {
    static bool isContentType(string ct, list<auto> MimeTypes) {
        ct = ltrim(ct);
        foreach string sct in (MimeTypes) {
            # Content-Type := type "/" subtype *[";" parameter] ... so we can test if string is starting at index 0
            if (bindex(ct, sct) == 0)
                return True;
        }
        return False;
    }

    static checkContentType(string ct, list<auto> MimeTypes) {
        if (!WsdlLibPriv::isContentType(ct, MimeTypes)) {
            throw "SOAP-MESSAGE-ERROR", sprintf("don't know how to handle content-type %y (expecting one of: %y)", ct, MimeTypes);
        }
    }
}

#! base class with helper methods for XSD data processing
public class XsdBase inherits Qore::Serializable {
    #! obtains the in-scope prefixes declared by an XML attribute hash
    /** @param attributes XML attributes including namespace declarations
        @param inherited prefixes from enclosing XML elements
        @return prefix-to-URI mappings, including the implicit xml prefix
        @throw SOAP-DESERIALIZATION-ERROR an invalid namespace declaration or reserved binding
        @since %WSDL 0.5.8
    */
    static hash<string, string> getAttributeNamespaces(*hash<auto> attributes, *hash<string, string> inherited) {
        hash<string, string> namespaces = {"xml": "http://www.w3.org/XML/1998/namespace"};
        namespaces += inherited;
        foreach string prefix in (keys namespaces) {
            validateAttributeNamespace(prefix, namespaces{prefix});
        }
        foreach string key in (keys attributes) {
            if (key =~ /^xmlns:/) {
                string prefix = substr(key, 6);
                validateAttributeNamespace(prefix, attributes{key});
                namespaces{prefix} = attributes{key};
            }
        }
        return namespaces;
    }

    private static validateAttributeNamespace(string prefix, auto uri) {
        if (uri.typeCode() != NT_STRING || !uri || !Namespaces::isNCName(prefix) || prefix == "xmlns"
                || uri == "http://www.w3.org/2000/xmlns/"
                || ((prefix == "xml") != (uri == "http://www.w3.org/XML/1998/namespace"))) {
            throw SOAP_DESERIALIZATION_ERROR, sprintf("invalid XML namespace binding %Y to %Y", prefix, uri);
        }
    }

    #! makes inherited prefix declarations available at attributed XML descendants
    /** @param value parsed XML data, updated through the reference
        @param inherited prefixes from the enclosing XML element
        @note Scoped updates restore prefix bindings on exit; sibling rebindings remain independent.
        Only bindings used by attribute names are materialized at descendants.
        @throw SOAP-DESERIALIZATION-ERROR invalid namespace declaration
        @since %WSDL 0.5.8
    */
    static inheritAttributeNamespaces(reference<auto> value, *hash<string, string> inherited) {
        hash<string, string> namespaces = getAttributeNamespaces(NOTHING, inherited);
        inheritAttributeNamespacesIntern(\value, \namespaces);
    }

    private static inheritAttributeNamespacesIntern(reference<auto> value,
            reference<hash<string, string>> namespaces) {
        if (value.typeCode() == NT_LIST) {
            foreach auto child in (\value) {
                inheritAttributeNamespacesIntern(\child, \namespaces);
            }
            return;
        }
        if (value.typeCode() != NT_HASH) {
            return;
        }
        hash<string, string> previous();
        list<string> added();
        on_exit {
            foreach string prefix in (keys previous) {
                namespaces{prefix} = previous{prefix};
            }
            map remove namespaces{$1}, added;
        }
        foreach string key in (keys value."^attributes^") {
            if (key =~ /^xmlns:/) {
                string prefix = substr(key, 6);
                validateAttributeNamespace(prefix, value."^attributes^"{key});
                if (namespaces.hasKey(prefix)) {
                    previous{prefix} = namespaces{prefix};
                } else {
                    added += prefix;
                }
                namespaces{prefix} = value."^attributes^"{key};
            }
        }
        # Materialize only bindings used by attribute names. Copying every ancestor declaration
        # onto every descendant would grow quadratically on deeply nested namespace scopes.
        foreach string key in (keys value."^attributes^") {
            *string prefix = (key =~ x/^([^:]+):[^:]+$/)[0];
            if (prefix && prefix != "xmlns" && prefix != "xml" && namespaces{prefix}) {
                value."^attributes^"{"xmlns:" + prefix} = namespaces{prefix};
            }
        }
        foreach string key in (keys value) {
            if (key == "^value^" || key !~ /^[\^.]/) {
                inheritAttributeNamespacesIntern(\value{key}, \namespaces);
            }
        }
    }

    #! resolves XML attribute names to their expanded namespace/local identities
    /** @param attributes the XML attribute hash with its in-scope prefix declarations
        @return attribute values keyed by expanded names, excluding namespace declarations and internal metadata
        @throw SOAP-DESERIALIZATION-ERROR an unbound prefix or duplicate expanded name
        @since %WSDL 0.5.8
    */
    static hash<auto> getExpandedAttributes(*hash<auto> attributes) {
        hash<string, string> namespaces = getAttributeNamespaces(attributes);
        hash<auto> expanded();
        foreach string key in (keys attributes) {
            if (key == "xmlns" || key =~ /^(xmlns:|\^)/) {
                continue;
            }
            string identity;
            if (key =~ /^\{/) {
                identity = key;
            } else {
                (*string prefix, *string local) = key =~ x/^([^:]+):([^:]+)$/;
                if (prefix) {
                    if (!namespaces{prefix}) {
                        throw SOAP_DESERIALIZATION_ERROR, sprintf("unbound XML attribute prefix %Y", prefix);
                    }
                    identity = type_qname(namespaces{prefix}, local);
                } else {
                    identity = type_qname("", key);
                }
            }
            if (expanded.hasKey(identity)) {
                throw SOAP_DESERIALIZATION_ERROR, sprintf("duplicate expanded attribute %Y", identity);
            }
            expanded{identity} = attributes{key};
        }
        return expanded;
    }

    #! returns in-scope XML namespaces, including the default namespace under an empty key
    /** @param attributes namespace declarations on the current element
        @param inherited namespace bindings from the parent
        @return validated prefix-to-URI bindings, including the implicit xml prefix
        @throw SOAP-DESERIALIZATION-ERROR an invalid or reserved namespace binding
        @since %WSDL 0.5.8
    */
    static hash<string, string> getElementNamespaces(*hash<auto> attributes,
            *hash<string, string> inherited) {
        hash<string, string> prefixes = inherited ?? {};
        *string default_ns = remove prefixes{""};
        hash<string, string> namespaces = getAttributeNamespaces(attributes, prefixes);
        if (attributes.hasKey("xmlns")) {
            if (attributes.xmlns.typeCode() != NT_STRING) {
                throw SOAP_DESERIALIZATION_ERROR, "the default XML namespace must be a string";
            }
            default_ns = attributes.xmlns;
        }
        if (exists default_ns) {
            if (default_ns == "http://www.w3.org/XML/1998/namespace"
                    || default_ns == "http://www.w3.org/2000/xmlns/") {
                throw SOAP_DESERIALIZATION_ERROR, sprintf("reserved default XML namespace %Y", default_ns);
            }
            namespaces{""} = default_ns;
        }
        return namespaces;
    }

    #! resolves parsed XML element keys before schema matching
    /** @param value a parsed XML document or element-content hash
        @param inherited namespace bindings from its enclosing element
        @return a separate hash keyed by expanded names; attributes and lexical values are retained
        @note Unqualified element names use the in-scope default namespace. Namespace declarations on an
        element apply to its own name. Repeated names retain their values and insertion order, including
        the XML parser's occurrence suffixes. The input is not modified.
        @throw SOAP-DESERIALIZATION-ERROR an unbound prefix, malformed name or invalid namespace declaration
        @par Example
        @code{.py}
        hash<auto> elements = XsdBase::expandElementNamespaces(parse_xml("<p:price xmlns:p='urn:invoice'>009</p:price>"));
        string lexical = elements."{urn:invoice}price"."^value^";
        @endcode
        @since %WSDL 0.5.8
    */
    static hash<auto> expandElementNamespaces(hash<auto> value, *hash<string, string> inherited) {
        hash<string, string> namespaces = getElementNamespaces(NOTHING, inherited);
        string unused_name;
        return expandElementNamespacesIntern("", value, \namespaces, \unused_name);
    }

    private static auto expandElementNamespacesIntern(string name, auto value,
            reference<hash<string, string>> namespaces, reference<string> expanded_name) {
        if (value.typeCode() == NT_HASH && exists value."^attributes^"
                && value."^attributes^".typeCode() != NT_HASH) {
            throw SOAP_DESERIALIZATION_ERROR, "XML attributes must be represented by a hash";
        }
        hash<string, string> declared = getElementNamespaces(value."^attributes^");
        hash<string, string> previous();
        list<string> added();
        on_exit {
            foreach string prefix in (keys previous) {
                namespaces{prefix} = previous{prefix};
            }
            map remove namespaces{$1}, added;
        }
        foreach string prefix in (keys declared) {
            if (namespaces.hasKey(prefix)) {
                previous{prefix} = namespaces{prefix};
            } else {
                added += prefix;
            }
            namespaces{prefix} = declared{prefix};
        }
        if (name) {
            name =~ s/\^[0-9]+$//;
            list<string> parts = name.split(":");
            if (parts.size() > 2 || name =~ /(^:|:$)/ || (select parts, !Namespaces::isNCName($1))) {
                throw SOAP_DESERIALIZATION_ERROR, sprintf("invalid XML element name %Y", name);
            }
            string uri;
            if (parts.size() == 2) {
                if (!namespaces{parts[0]} || parts[0] == "xmlns") {
                    throw SOAP_DESERIALIZATION_ERROR, sprintf("unbound XML element prefix %Y", parts[0]);
                }
                uri = namespaces{parts[0]};
            } else {
                uri = namespaces{""} ?? "";
            }
            expanded_name = type_qname(uri, parts[-1]);
        }
        if (value.typeCode() != NT_HASH) {
            return value;
        }
        # Keep the bindings used by attributes available after their enclosing scope is detached.
        # Copying every inherited declaration onto every descendant would grow quadratically.
        foreach string key in (keys value."^attributes^") {
            *string prefix = (key =~ x/^([^:]+):[^:]+$/)[0];
            if (prefix && prefix != "xmlns" && prefix != "xml" && namespaces{prefix}) {
                value."^attributes^"{"xmlns:" + prefix} = namespaces{prefix};
            }
        }
        getExpandedAttributes(value."^attributes^");
        hash<auto> result();
        hash<string, int> occurrences();
        foreach string key in (keys value) {
            if (key =~ /^[\^.]/) {
                result{key} = value{key};
                continue;
            }
            list<auto> children = value{key}.typeCode() == NT_LIST ? value{key} : (value{key},);
            if (!children) {
                throw SOAP_DESERIALIZATION_ERROR, sprintf("empty XML element occurrence list for %Y", key);
            }
            foreach auto child in (children) {
                string identity;
                auto content = expandElementNamespacesIntern(key, child, \namespaces, \identity);
                string last_key = result.lastKey() ?? "";
                string last_identity = last_key;
                last_identity =~ s/\^[0-9]+$//;
                if (last_identity == identity) {
                    if (result{last_key}.typeCode() != NT_LIST) {
                        list<auto> repeated();
                        repeated += (result{last_key},);
                        result{last_key} = repeated;
                    }
                    result{last_key} += (content,);
                } else if (result.hasKey(identity)) {
                    result{identity + "^" + (++occurrences{identity})} = content;
                } else {
                    result{identity} = content;
                }
            }
        }
        return result;
    }

    #! prepares expanded XML element names for the XML generator
    /** @param value XML data with expanded element keys and retained namespace declarations
        @return XML generator data with local, non-conflicting prefix declarations
        @note Prefix allocation preserves retained bindings and lexical values. An empty-namespace element
        explicitly resets a default namespace. Existing lexical element keys remain supported.
        @throw SOAP-SERIALIZATION-ERROR a malformed expanded element name
        @par Example
        @code{.py}
        string xml = make_xml(XsdBase::restoreElementNamespaces({"{urn:invoice}price": "009"}));
        @endcode
        @since %WSDL 0.5.8
    */
    static hash<auto> restoreElementNamespaces(hash<auto> value) {
        hash<string, bool> reserved();
        collectElementNamespacePrefixes(value, \reserved);
        hash<string, string> prefixes();
        int next_prefix = 0;
        return restoreElementNamespacesIntern(value, \reserved, \prefixes, \next_prefix);
    }

    private static collectElementNamespacePrefixes(auto value, reference<hash<string, bool>> reserved) {
        if (value.typeCode() == NT_HASH) {
            foreach string key in (keys value) {
                if (key =~ /^xmlns:/) {
                    reserved{substr(key, 6)} = True;
                }
                collectElementNamespacePrefixes(key, \reserved);
                collectElementNamespacePrefixes(value{key}, \reserved);
            }
        } else if (value.typeCode() == NT_LIST) {
            foreach auto child in (value) {
                collectElementNamespacePrefixes(child, \reserved);
            }
        } else if (value.typeCode() == NT_STRING) {
            # Also avoid creating a new meaning for a lexical QName using an undeclared prefix.
            foreach string prefix in (value =~ x/(qorexml[0-9]+):/g) {
                reserved{prefix} = True;
            }
        }
    }

    private static auto restoreElementNamespacesIntern(auto value, reference<hash<string, bool>> reserved,
            reference<hash<string, string>> prefixes, reference<int> next_prefix) {
        if (value.typeCode() == NT_LIST) {
            list<auto> result();
            foreach auto child in (value) {
                result += (restoreElementNamespacesIntern(child, \reserved, \prefixes, \next_prefix),);
            }
            return result;
        }
        if (value.typeCode() != NT_HASH) {
            return value;
        }
        hash<auto> result();
        foreach string key in (keys value) {
            if (key == "^attributes^") {
                result{key} = value{key};
                continue;
            }
            auto child = restoreElementNamespacesIntern(value{key}, \reserved, \prefixes, \next_prefix);
            if (key !~ /^\{/) {
                result{key} = child;
                continue;
            }
            (*string uri, *string local, *string suffix) = key =~ x/^\{([^}]*)\}([^\^]+)(\^[0-9]+)?$/;
            if (!exists uri || !exists local || !Namespaces::isNCName(local)) {
                throw SOAP_SERIALIZATION_ERROR, sprintf("invalid expanded XML element name %Y", key);
            }
            string prefix;
            if (uri == "http://www.w3.org/2000/xmlns/") {
                throw SOAP_SERIALIZATION_ERROR, "XML element names cannot use the xmlns namespace";
            }
            if (uri == "http://www.w3.org/XML/1998/namespace") {
                prefix = "xml";
            } else if (uri) {
                if (!prefixes.hasKey(uri)) {
                    do {
                        prefix = "qorexml" + next_prefix++;
                    } while (reserved{prefix});
                    prefixes{uri} = prefix;
                    reserved{prefix} = True;
                }
                prefix = prefixes{uri};
            }
            list<auto> children = child.typeCode() == NT_LIST ? child : (child,);
            list<auto> prepared();
            foreach auto content in (children) {
                hash<auto> node();
                if (content.typeCode() == NT_HASH) {
                    node += content;
                } else {
                    node."^value^" = content;
                }
                node."^attributes^"{prefix ? "xmlns:" + prefix : "xmlns"} = uri;
                prepared += (node,);
            }
            string name = (prefix ? prefix + ":" : "") + local + (suffix ?? "");
            if (result.hasKey(name)) {
                throw SOAP_SERIALIZATION_ERROR, sprintf("duplicate XML generator key %Y", name);
            }
            result{name} = child.typeCode() == NT_LIST ? prepared : prepared[0];
        }
        return result;
    }

    #! returns whether an expanded attribute belongs to schema-instance or SOAP encoding metadata
    /** @param identity the expanded attribute name
        @return True for recognized infrastructure namespaces
        @since %WSDL 0.5.8
    */
    static bool isInstanceAttribute(string identity) {
        return identity == type_qname(XSI_NS, "type") || identity == type_qname(XSI_NS, "nil")
            || identity == type_qname(XSI_NS, "schemaLocation") || identity == type_qname(XSI_NS, "noNamespaceSchemaLocation")
            || identity == type_qname(SOAP_ENCODING, "arrayType") || identity == type_qname(SOAP_ENCODING, "offset")
            || identity == type_qname(SOAP_ENCODING, "position") || identity == type_qname(SOAP_ENCODING, "root");
    }

    #! rejects ordinary XML attributes on a simple type value
    /** @param attributes the XML attribute hash and namespace declarations
        @param type_name the type name used in diagnostics
        @throw SOAP-DESERIALIZATION-ERROR an ordinary attribute or unresolved prefix
        @since %WSDL 0.5.8
    */
    static validateSimpleAttributes(*hash<auto> attributes, string type_name) {
        foreach string identity in (keys getExpandedAttributes(attributes)) {
            if (!isInstanceAttribute(identity)) {
                throw SOAP_DESERIALIZATION_ERROR, sprintf("simple type %Y cannot contain attribute %Y", type_name,
                    identity);
            }
        }
    }

    static removeNS(reference v) {
        foreach hash<auto> h in (\v) {
            foreach string k in (keys h) {
                (*string ns, *string name) = k =~ x/([^:]+):([^:]+)/;
                if (ns) {
                    switch (h{k}.typeCode()) {
                        case NT_HASH: h{k}.ns = ns; break;
                        case NT_LIST: h{k} = map $1 + ("ns": ns), h{k}; break;
                    }
                    if (h{name}) {
                        softlist<auto> l = h{name};
                        l += remove h{k};
                        h{name} = l;
                    } else
                        h{name} = remove h{k};
                }
            }
        }
    }

    static removeNS2(reference v) {
        foreach hash<auto> h in (\v) {
            foreach string k in (keys h) {
                if (k =~ /^[\^.{]/) {
                    continue;
                }
                (*string ns, *string name) = k =~ x/^([^:]+):([^:]+)$/;
                if (ns) {
                    switch (h{k}.typeCode()) {
                        case NT_HASH: h{k}.".ns" = ns; break;
                        case NT_LIST: h{k} = map $1 + (".ns": ns), h{k}; break;
                    }
                    if (h.hasKey(name)) {
                        softlist<auto> l = h{name};
                        l += remove h{k};
                        h{name} = l;
                    } else {
                        h{name} = remove h{k};
                    }
                }
            }
        }
    }

    #! Removes namespace prefixes from all keys in the given hash
    /** This function is designed for flat attribute hashes where values may be strings.
        Unlike removeNS(), this processes keys directly regardless of value types.
    */
    static removeNSKeys(reference<*hash<auto>> h) {
        if (!h) {
            return;
        }
        foreach string k in (keys h) {
            (*string ns, *string name) = k =~ x/([^:]+):([^:]+)/;
            if (ns && name) {
                if (exists h{name}) {
                    # If the unqualified key already exists, make it a list
                    softlist<auto> l = h{name};
                    l += remove h{k};
                    h{name} = l;
                } else {
                    h{name} = remove h{k};
                }
            }
        }
    }
}

#! An explicit SOAP message result retaining each XML payload and header
/** This type is returned only by the XML decoding APIs. Ordinary SOAP decoding keeps its native
    scalar and record values. Body keys are WSDL part names; bound headers are keyed by message
    name, then part name. Unbound headers retain their original order in a separate list.
    @since %WSDL 0.5.8
*/
public hashdecl SoapXmlMessageInfo {
    #! Body XML values keyed by WSDL part name
    hash<string, XsdXmlValue> body = {};
    #! Bound SOAP header values keyed by WSDL message name and part name
    hash<string, hash<string, XsdXmlValue>> headers = {};
    #! Headers without a matching WSDL binding declaration, in document order
    list<XsdXmlValue> unbound_headers = ();
    #! SOAP 1.1 extension elements following Body, in document order
    list<XsdXmlValue> extensions = ();
}

#! An explicit XML value retaining lexical text, namespaces and ordered content
/** Unlike a native scalar or flat record, this value retains the complete supplied XML document.
    getXmlDataView() exposes parse_xml()'s ordered data representation for convenient access to
    namespace declarations, attribute text, mixed text and repeated children. getReader() provides
    a separate XmlReader for the complete XML stream, including processing instructions and whitespace.

    This class represents XML; constructing it does not validate the document against an XSD type.
    XML generator integration requires xml 2.3.0 or later.
    Existing native WSDL values are not implicitly converted to this representation.

    @par Example
    @code{.py}
    XsdXmlValue quantity("<quantity unit='kg'>009.00</quantity>");
    string lexical = quantity.getElementData()."^value^";
    @endcode

    @since %WSDL 0.5.8
*/
public final class XsdXmlValue inherits Serializable {
    private {
        string xml;
        hash<string, string> inherited_xml_attributes;
        transient hash<auto> data;
        transient string root_name;
        transient string root_namespace;
        transient string root_local_name;
        transient hash<string, string> xml_context;
    }

    #! constructs a value from a complete XML element document
    /** @param xml the XML document, including all required namespace declarations
        @param inherited_xml_attributes the parent's effective \c xml:lang, \c xml:space and \c xml:base
        attributes, when the document element was extracted from a containing document
        @throw PARSE-XML-EXCEPTION malformed XML
        @throw XML-CONTEXT-ERROR unknown context attributes, invalid XML characters or an invalid xml:space value
        @note Numeric spellings, QName text and child order are retained. XML parsing still applies
        XML's normal character-reference and line-ending normalization.
    */
    constructor(string xml, hash<string, string> inherited_xml_attributes = {}) {
        initInheritedAttributes(inherited_xml_attributes, "XML-CONTEXT-ERROR");
        init(xml);
    }

    private:internal deserializeMembers(hash<auto> members) {
        if (members.xml.typeCode() != NT_STRING) {
            throw "DESERIALIZATION-ERROR", "serialized XsdXmlValue requires an XML string";
        }
        initInheritedAttributes(members.hasKey("inherited_xml_attributes") ? members.inherited_xml_attributes : {},
            "DESERIALIZATION-ERROR");
        init(members.xml);
    }

    private initInheritedAttributes(auto attributes, string error) {
        if (attributes.typeCode() != NT_HASH) {
            throw error, "inherited XML attributes must be a hash of strings";
        }
        foreach string key in (keys attributes) {
            if (attributes{key}.typeCode() != NT_STRING
                    || (key != "xml:lang" && key != "xml:space" && key != "xml:base")) {
                throw error, "inherited XML context accepts only xml:lang, xml:space and xml:base strings";
            }
        }
        if (attributes.hasKey("xml:space") && attributes."xml:space" != "default"
                && attributes."xml:space" != "preserve") {
            throw error, "xml:space must be default or preserve";
        }
        if (attributes) {
            # Validate XML characters as well as names/types before publishing context state.
            try {
                hash<auto> validated = parse_xml(make_xml({"parent": {"^attributes^": attributes}}));
                @assert(validated.parent."^attributes^" == attributes, "inherited XML attributes must serialize exactly");
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err == "PROGRAM-INTERRUPTED" || ex.err == "THREAD-CANCELLED") {
                    rethrow;
                }
                throw error, sprintf("invalid inherited XML attributes: %s", ex.desc);
            }
        }
        inherited_xml_attributes = attributes;
    }

    private init(string xml) {
        self.xml = xml;
        data = parse_xml(xml, XPF_PRESERVE_ORDER | XPF_ADD_COMMENTS);
        XmlReader reader(xml);
        while (reader.read()) {
            if (reader.nodeType() == XML_NODE_TYPE_ELEMENT) {
                root_name = reader.name();
                root_local_name = reader.localName();
                root_namespace = reader.namespaceUri() ?? "";
                xml_context = inherited_xml_attributes;
                hash<auto> attributes = getElementData()."^attributes^" ?? {};
                foreach string key in ("xml:lang", "xml:space") {
                    if (attributes.hasKey(key)) {
                        xml_context{key} = attributes{key};
                    }
                }
                if (attributes.hasKey("xml:base")) {
                    if (inherited_xml_attributes.hasKey("xml:base")) {
                        xml_context."xml:base" = XsdXmlBaseHelper::resolve(inherited_xml_attributes."xml:base",
                            attributes."xml:base");
                    } else {
                        xml_context."xml:base" = attributes."xml:base";
                    }
                }
                return;
            }
        }
        throw "PARSE-XML-EXCEPTION", "an XML value requires a document element";
    }

    #! returns the XML module's ordered data view of the document
    /** @return a copy-on-write hash; editing it does not modify this value
        @note This data view uses XPF_PRESERVE_ORDER and XPF_ADD_COMMENTS. The XML module does not
        represent processing instructions or whitespace-only content in hashes. Use getXml() or
        getReader() for the complete XML.
    */
    hash<auto> getXmlDataView() {
        return data;
    }

    #! returns the document element's XML data
    /** @return its scalar or ordered hash, including attributes and mixed text when present
    */
    auto getElementData() {
        return data{root_name};
    }

    #! returns the document element's expanded name
    /** @return a string in \c {namespace-uri}local-name form, including \c {}local-name for no namespace
    */
    string getExpandedName() {
        return type_qname(root_namespace, root_local_name);
    }

    #! returns the document element's namespace URI
    /** @return its namespace URI, or an empty string for no namespace */
    string getNamespaceUri() {
        return root_namespace;
    }

    #! returns the document element's local name
    /** @return the local name without a prefix */
    string getLocalName() {
        return root_local_name;
    }

    #! returns the effective XML attributes of the original parent
    /** @return a copy-on-write map limited to \c xml:lang, \c xml:space and \c xml:base
        @note Empty xml:lang is retained as an explicit language reset. These attributes are
        separate from the root's authored attributes and are not added to getXml().
    */
    hash<string, string> getInheritedXmlAttributes() {
        return inherited_xml_attributes;
    }

    #! returns the effective XML context at the document element
    /** @return inherited attributes with root overrides applied; relative xml:base values are resolved
        against the inherited base URI
        @note Missing keys indicate absent context. Descendant contexts can be obtained by extracting
        child values. getReader() reads the standalone XML without this separate inherited context.
    */
    hash<string, string> getXmlContext() {
        return xml_context;
    }

    #! resolves a lexical QName using the document element's namespace declarations
    /** @param qname the lexical QName to resolve
        @return its expanded name, including an empty namespace when applicable
        @throw WSDL-NAMESPACE-ERROR malformed QName or unbound prefix
        @note This method uses the document element's scope; descendant declarations remain available
        in getXmlDataView() and can establish different scopes.
    */
    string resolveQName(string qname) {
        hash<auto> declarations = getElementData()."^attributes^" ?? {};
        declarations."xmlns:xml" = "http://www.w3.org/XML/1998/namespace";
        Namespaces namespaces(declarations);
        hash<auto> identity = namespaces.getTypeHash(qname);
        return type_qname(identity.uri, identity.val);
    }

    #! returns the immediate element children as independent XML values
    /** @return child elements in document order, with inherited namespace declarations materialized
        on each root; text and other nodes between those children remain available in this value
        @throw XML-READER-ERROR if an XML subtree cannot be read
        @throw PARSE-XML-EXCEPTION if a subtree cannot be represented as an XML document
        @throw XML-CONTEXT-ERROR if inherited XML attributes cannot be represented
        @note All namespace bindings are retained, including prefixes used only by QName text.
        Local namespace declarations override inherited bindings. Inherited XML attributes are retained
        separately in getInheritedXmlAttributes(), preserving the child's authored root attributes.
        This method does not validate XSD.
        @par Example
        @code{.py}
        XsdXmlValue batch("<batch xmlns:t='urn:types'><item>t:Stock</item></batch>");
        XsdXmlValue item = batch.getChildValues()[0];
        string identity = item.resolveQName("t:Stock");
        @endcode
    */
    list<XsdXmlValue> getChildValues() {
        hash<string, string> inherited();
        XmlReader reader = getReader();
        list<XsdXmlValue> result();
        while (reader.read()) {
            if (reader.nodeType() != XML_NODE_TYPE_ELEMENT || reader.depth() > 1) {
                continue;
            }
            int depth = reader.depth();
            string child_name = reader.name();
            hash<string, string> attributes = depth ? inherited : {};
            int count = reader.attributeCount();
            for (int i = 0; i < count; ++i) {
                reader.moveToAttributeOffset(i);
                string attribute_name = reader.name();
                if (depth || attribute_name == "xmlns" || attribute_name.startsWith("xmlns:")) {
                    attributes{attribute_name} = reader.value();
                }
            }
            if (count) {
                reader.moveToElement();
            }
            if (!depth) {
                inherited = attributes;
                continue;
            }
            string inner = reader.getInnerXml() ?? "";
            # Generate the empty root to escape attribute values, then append the original ordered
            # inner XML. Only the known generated empty-tag suffix is changed; source XML is not scanned.
            XmlReader root_reader(make_xml({child_name: {"^attributes^": attributes}}));
            while (root_reader.read() && root_reader.nodeType() != XML_NODE_TYPE_ELEMENT) {
            }
            string root = root_reader.getOuterXml();
            @assert(root.endsWith("/>"), "generated attribute-only root must be an empty element");
            if (inner) {
                root = substr(root, 0, root.length() - 2) + ">" + inner + "</" + child_name + ">";
            }
            result += new XsdXmlValue(root, xml_context);
        }
        return result;
    }

    #! returns the retained XML document
    /** @return the supplied XML document, preserving lexical values, namespace declarations and node order
    */
    string getXml() {
        return xml;
    }

    #! returns data for embedding the document element with make_xml()
    /** @return an XML generator hash using its validated \c ^xml^ element-fragment representation
        @note make_xml() embeds the document element and retains its namespace bindings and ordered
        content. It omits the XML declaration and nodes outside that element, and rejects DOCTYPEs.
        Inherited XML attributes are applied to the containing element, preserving the payload's authored
        root attributes. Keep these attributes when adding other attributes to the generator hash.
        This performs XML well-formedness checking, not XSD validation.
        @code{.py}
        XsdXmlValue item("<item>009.00</item>");
        string message = make_xml({"collection": item.getXmlSerializationData()});
        @endcode
    */
    hash<auto> getXmlSerializationData() {
        hash<auto> result();
        result."^xml^" = xml;
        if (inherited_xml_attributes) {
            result."^attributes^" = inherited_xml_attributes;
        }
        return result;
    }

    #! returns a separate reader for the complete XML document
    /** @return an XmlReader positioned before the first node; reading it does not modify this value
        @throw XML-READER-ERROR if a reader cannot be created
    */
    XmlReader getReader() {
        return new XmlReader(xml);
    }
}

hashdecl XsdXmlBaseInfo {
    *string scheme;
    *string authority;
    string path;
    *string query;
    *string fragment;
}

# XML Base accepts LEIRIs, whereas libxml2's URI resolver rejects non-ASCII characters.
# Resolve components without early percent encoding or decoding (XML Base 3.1; RFC 3986 5.2).
class XsdXmlBaseHelper {
    private static hash<XsdXmlBaseInfo> parts(string value) {
        hash<XsdXmlBaseInfo> result = <XsdXmlBaseInfo>{"path": ""};
        int pos = index(value, "#");
        if (pos >= 0) {
            result.fragment = substr(value, pos + 1);
            value = substr(value, 0, pos);
        }
        pos = index(value, "?");
        if (pos >= 0) {
            result.query = substr(value, pos + 1);
            value = substr(value, 0, pos);
        }
        *string scheme = (value =~ x/^([a-zA-Z][a-zA-Z0-9+.-]*):/)[0];
        if (exists scheme) {
            result.scheme = scheme;
            value = substr(value, scheme.length() + 1);
        }
        if (value.startsWith("//")) {
            pos = index(value, "/", 2);
            result.authority = pos < 0 ? substr(value, 2) : substr(value, 2, pos - 2);
            value = pos < 0 ? "" : substr(value, pos);
        }
        result.path = value;
        return result;
    }

    private static string normalizePath(string path, bool keep_relative_parents) {
        bool absolute = path.startsWith("/");
        list<string> result();
        list<string> segments = split("/", path);
        if (path.endsWith("/")) {
            segments += "";
        }
        for (int i = 0; i < segments.size(); ++i) {
            string segment = segments[i];
            if (segment == "." || segment == "..") {
                if (segment == "..") {
                    if (result && result[-1] != ".." && !(absolute && result.size() == 1)) {
                        pop result;
                        if (!result && !keep_relative_parents) {
                            # RFC dot removal retains the slash after the removed segment even
                            # for a scheme-bearing rootless path, such as g:a/../b -> g:/b.
                            absolute = True;
                            result += "";
                        }
                    } else if (!absolute && keep_relative_parents) {
                        result += "..";
                    }
                }
                if (i == segments.size() - 1 && (absolute || result)) {
                    result += "";
                }
            } else {
                result += segment;
            }
        }
        return result.join("/");
    }

    static string resolve(string base, string value) {
        if (!base) {
            return value;
        }
        hash<XsdXmlBaseInfo> parent = parts(base);
        hash<XsdXmlBaseInfo> target = parts(value);
        if (exists target.scheme) {
            target.path = normalizePath(target.path, False);
        } else {
            target.scheme = parent.scheme;
            if (exists target.authority) {
                target.path = normalizePath(target.path, False);
            } else {
                target.authority = parent.authority;
                if (!target.path) {
                    target.path = parent.path;
                    if (!exists target.query) {
                        target.query = parent.query;
                    }
                } else if (target.path.startsWith("/")) {
                    target.path = normalizePath(target.path, False);
                } else {
                    string prefix = exists parent.authority && !parent.path ? "/"
                        : substr(parent.path, 0, rindex(parent.path, "/") + 1);
                    target.path = normalizePath(prefix + target.path, !exists target.scheme && !exists target.authority);
                }
            }
        }
        return (exists target.scheme ? target.scheme + ":" : "")
            + (exists target.authority ? "//" + target.authority : "") + target.path
            + (exists target.query ? "?" + target.query : "")
            + (exists target.fragment ? "#" + target.fragment : "");
    }
}

# SOAP 1.1 section 3 and SOAP 1.2 section 5 prohibit sender processing instructions and DTDs.
class XsdSoapXmlHelper {
    static mergeContext(reference<*hash<string, string>> target, hash<string, string> attributes) {
        if (exists target && target != attributes) {
            throw SOAP_SERIALIZATION_ERROR,
                "retained sibling XML values require the same inherited XML attributes on their SOAP container";
        }
        target = attributes;
    }

    static validate(XsdXmlValue value, string error) {
        XmlReader reader = value.getReader();
        while (reader.read()) {
            if (reader.nodeType() == XML_NODE_TYPE_DOCUMENT_TYPE
                    || reader.nodeType() == XML_NODE_TYPE_PROCESSING_INSTRUCTION) {
                throw error, "SOAP XML must not contain DOCTYPEs or processing instructions";
            }
        }
    }

}

#! base class for XSD data classes
public class XsdData inherits WSDL::XsdBase {
    auto getValue(*hash<auto> mrh, auto val) {
        if (exists val."^attributes^".href) {
            string href = substr(val."^attributes^".href, 1);

            if (!exists mrh.mrh{href})
                throw "INVALID-REFERENCE", sprintf("multiRef id: %y does not exist", href);

            return mrh.mrh{href};
        }
        return val;
    }
}

#! base class for XSD classes with a "name" attribute
public class XsdNamedData inherits WSDL::XsdData {
    public {
        # name of object
        string name;
        #! input namespace prefix (if any given)
        *string ns;
        #! descriptive name flag
        bool descriptive_name;
    }

    constructor(string n_name, string n_ns) {
        name = n_name;
        ns = n_ns;
        # if the name has a space in it, then it's a descriptive name
        descriptive_name = (name =~ / /);
    }

    constructor(reference e, *string desc_name) {
        WSDL::XsdBase::removeNS(\e);
        *hash<auto> a = e."^attributes^";
        if (a.name)
            name = a.name;
        else if (a.ref) {
            # remove namespace
            (*string ns, *string n_name) = a.ref =~ x/([^:]+):([^:]+)/;
            name = n_name ?? a.ref;
        } else
            name = desc_name ?? "<unnamed type>";
        # if the name has a space in it, then it's a descriptive name
        descriptive_name = (name =~ / /);
    }

    string getName() {
        return name;
    }

    *string getInputNamespacePrefix() {
        return ns;
    }

    bool hasRealName() {
        return !descriptive_name;
    }
}

public class XsdAbstractType inherits WSDL::XsdNamedData {
    public {
        #! owned declaration namespace context
        Namespaces nsc;

        #! my namespace output prefix
        string ons;
    }

    constructor(reference e, Namespaces nsc, *string desc_name) : XsdNamedData(\e, desc_name) {
        self.nsc = nsc;
        resolveNamespace();
    }

    constructor(string name, string ns, Namespaces nsc) : XsdNamedData(name, ns) {
        self.nsc = nsc;
        resolveNamespace();
    }

    private resolveNamespace() {
        if (!ns) {
            *string tns = nsc.getTargetNamespaceUri();
            ons = tns ? nsc.getOutputNamespacePrefix(tns) : "";
        } else {
            ons = nsc.translateOutputNamespacePrefix(ns);
        }
        #printf("DEBUG: type %y ns: %y ons: %y\n", name, ns, ons);
    }

    checkExtends(XsdAbstractType t, string ename) {
        throw SOAP_SERIALIZATION_ERROR, sprintf("explicit type %y given for element %y, type %y, however the types are not compatible", name, ename, t.name);
    }

    string getNameWithNS() {
        return ons ? ons + ":" + name : name;
    }

    bool isNillable() {
        return False;
    }

    bool isRequired() {
        return True;
    }

    bool requiresValue() {
        return !isNillable() && isRequired();
    }

    string getOutputNamespacePrefix() {
        return ons;
    }

    *list<auto> getAllowedValues() {
        # this method intentionally left empty
    }

    #! returns finite choices for the complete provider value
    /** @return scalar choices, or NOTHING when the complete value has no finite choice list */
    *list<auto> getDataProviderAllowedValues() {
        return getAllowedValues();
    }

    abstract auto serializeValue(Namespaces nsc, auto val, *softbool omitType);
    abstract auto deserializeValue(string en, hash<string, XsdAbstractType> tmap, *hash<auto> mrh, auto val);
    abstract AbstractDataProviderType getDataProviderType();

    #! returns whether a native list can represent one value of this type
    /** @return True for XSD list values, including restrictions and simple content
        @since %WSDL 0.5.8
    */
    bool hasNativeListValue() {
        return False;
    }

    #! returns the \c whiteSpace processing that applies to this type
    /** @return one of \c "preserve", \c "replace", or \c "collapse"

        @since %WSDL 0.5.8
    */
    string getWhiteSpace() {
        return "preserve";
    }
}

#! obtains a scalar value from the parser's ordered text and CDATA fragments
class XsdScalarTextHelper {
    static *hash<auto> elementContent(auto data, string description) {
        if (!exists data) {
            return;
        }
        if (data.typeCode() != NT_HASH) {
            if (data.typeCode() == NT_STRING && XsdSimpleType::normalizeWhiteSpace(data, "collapse") == "") {
                return {};
            }
            throw SOAP_DESERIALIZATION_ERROR, sprintf("%s requires element content", description);
        }
        foreach string key in (keys data) {
            if (key.startsWith("^value") || key.startsWith("^cdata")) {
                if (data{key}.typeCode() != NT_STRING
                        || XsdSimpleType::normalizeWhiteSpace(data{key}, "collapse") != "") {
                    throw SOAP_DESERIALIZATION_ERROR,
                        sprintf("%s cannot contain non-whitespace text", description);
                }
                delete data{key};
            }
        }
        return data;
    }

    static auto withComments(*hash<auto> comments, auto scalar) {
        if (!comments) {
            return scalar;
        }
        if (scalar.typeCode() == NT_HASH) {
            return comments + scalar;
        }
        comments."^value^" = scalar;
        return comments;
    }

    static auto value(auto data, string error) {
        if (data.typeCode() != NT_HASH) {
            return data;
        }
        list<auto> fragments();
        foreach string key in (keys data) {
            if (key == "^attributes^" || key == ".ns" || key.startsWith("^comment")) {
                continue;
            }
            if (!key.startsWith("^value") && !key.startsWith("^cdata")) {
                throw error, sprintf("simple content cannot contain child element or metadata %Y", key);
            }
            push fragments, data{key};
        }
        if (fragments.size() == 1) {
            # A native ^value^ wrapper must retain its existing scalar type.
            return fragments[0];
        }
        list<string> text();
        foreach auto fragment in (fragments) {
            if (!exists fragment) {
                continue;
            }
            if (fragment.typeCode() != NT_STRING) {
                throw error, "multiple simple-content fragments must contain XML text";
            }
            text += fragment;
        }
        return text.join("");
    }
}

#! compares already validated scalar constraints by their XSD value identity
class XsdScalarValueHelper {
    static bool equal(XsdAbstractType type, auto left, auto right) {
        *hash<XsdListItemInfo> item = XsdListValueHelper::describeList(type);
        if (item) {
            return XsdListValueHelper::key(item, left, "XSD-SIMPLETYPE-ERROR")
                == XsdListValueHelper::key(item, right, "XSD-SIMPLETYPE-ERROR");
        }
        XsdAbstractType base = type;
        while (base instanceof XsdSimpleType && cast<XsdSimpleType>(base).type) {
            base = cast<XsdSimpleType>(base).type;
        }
        if (base instanceof XsdSimpleType && cast<XsdSimpleType>(base).unionTypes) {
            UnionDataType provider = cast<UnionDataType>(type.getDataProviderType());
            return provider.valueKey(left) == provider.valueKey(right);
        }
        if (base instanceof XsdBaseType) {
            if (XsdCalendarLexicalHelper::isType(base.name)) {
                return XsdCalendarLexicalHelper::key(base.name, left, "XSD-SIMPLETYPE-ERROR")
                    == XsdCalendarLexicalHelper::key(base.name, right, "XSD-SIMPLETYPE-ERROR");
            }
            if (XsdNumericFacetHelper::isType(base.name)) {
                return XsdNumericFacetHelper::equal(base.name, left, right, "XSD-SIMPLETYPE-ERROR");
            }
            if (base.name == "duration") {
                return XsdDurationValueHelper::key(left, "XSD-SIMPLETYPE-ERROR")
                    == XsdDurationValueHelper::key(right, "XSD-SIMPLETYPE-ERROR");
            }
            if (XsdBinaryLexicalHelper::isType(base.name)) {
                return XsdBinaryFacetHelper::key(base.name, left, "XSD-SIMPLETYPE-ERROR")
                    == XsdBinaryFacetHelper::key(base.name, right, "XSD-SIMPLETYPE-ERROR");
            }
            if (base.name == "boolean") {
                return XsdBooleanLexicalHelper::decode(left, "XSD-SIMPLETYPE-ERROR")
                    == XsdBooleanLexicalHelper::decode(right, "XSD-SIMPLETYPE-ERROR");
            }
        }
        return left == right;
    }
}

#! validates boolean lexical input before native conversion
class XsdBooleanLexicalHelper {
    static string lexical(auto value, string error) {
        bool decoded = decode(value, error);
        return value.typeCode() == NT_STRING ? XsdSimpleType::normalizeWhiteSpace(value, "collapse")
            : decoded ? "true" : "false";
    }

    static bool decode(auto value, string error) {
        switch (value.typeCode()) {
            case NT_STRING:
                value = XsdSimpleType::normalizeWhiteSpace(value, "collapse");
                if (value == "true" || value == "1") {
                    return True;
                }
                if (value == "false" || value == "0") {
                    return False;
                }
                break;
            case NT_BOOLEAN:
                return value;
            case NT_INT:
            case NT_FLOAT:
            case NT_NUMBER:
                if (value == 0 || value == 1) {
                    return value == 1;
                }
                break;
        }
        throw error, sprintf("type boolean requires true, false, 1 or 0; got %Y", value);
    }
}

#! data provider type for \c xs:boolean values
/** accepts the XML spellings \c "true", \c "false", \c "1" and \c "0" after XML whitespace collapse,
    native booleans, and numeric zero or one. Other inputs are rejected before native conversion.

    @note a plain \c softbool type cannot be used for XSD booleans, because %Qore's boolean conversion converts any
    non-empty string to @ref True "True", which would silently turn the XSD value \c "false" into \c "true"

    @par Example
    An enabled flag supplied as \c "false" returns @ref False "False", including in provider lists.
    A flag supplied as \c "yes" raises \c RUNTIME-TYPE-ERROR.

    @since %WSDL 0.5.8
*/
public class XsdBooleanDataType inherits QoreDataType {
    #! constructs a required boolean provider
    constructor() : QoreDataType(SoftBoolType) {
    }

    #! validates XML boolean input before conversion
    /** @param value an XML boolean string, boolean, or numeric zero/one
        @return a boolean, or NOTHING for an omitted optional value
        @throw MISSING-VALUE-ERROR a mandatory value is absent
        @throw RUNTIME-TYPE-ERROR the input is outside the boolean lexical/native value contract
    */
    auto acceptsValue(auto value) {
        if (!exists value) {
            value = getDefaultValue();
            if (!exists value) {
                if (isOrNothingType()) {
                    return;
                }
                throw "MISSING-VALUE-ERROR", "a boolean value must be supplied";
            }
        }
        return QoreDataType::acceptsValue(XsdBooleanLexicalHelper::decode(value, "RUNTIME-TYPE-ERROR"));
    }

    #! keeps enclosing list providers from coercing strings before validation
    /** @return NOTHING */
    *Type getValueType() {
    }

    #! returns the native output type
    /** @return NT_BOOLEAN */
    int getBaseTypeCode() {
        return NT_BOOLEAN;
    }

    #! returns the native output type name
    /** @return bool */
    string getBaseTypeName() {
        return "bool";
    }

    #! requires validation instead of bypassing the provider
    /** @return an empty map */
    *hash<string, bool> getDirectTypeHash() {
        return {};
    }

    #! returns whether a value must be supplied
    /** @return True for mandatory types */
    bool isMandatory() {
        return !isOrNothingType();
    }

    #! returns whether a value may be omitted
    /** @return True for optional types */
    bool isOrNothingType() {
        return QoreDataType::getValueType().isOrNothingType();
    }

    #! reports the input categories subject to lexical/value validation
    /** @param simple request simplified names
        @return bool/string/int/float/number, plus nothing for optional types; null is not accepted
    */
    hash<string, bool> getAcceptTypeHash(*bool simple) {
        hash<string, bool> rv = {"bool": True, "string": True, "int": True, "float": True, "number": True};
        if (isOrNothingType()) {
            rv.nothing = True;
        }
        return rv;
    }
}

#! the data provider type for \c xs:boolean values
/** @since %WSDL 0.5.8
*/
public const XsdBooleanType = new WSDL::XsdBooleanDataType();

#! resolved boolean lexical constraints
/** @since %WSDL 0.5.8 */
public hashdecl XsdBooleanFacetInfo {
    #! schema type name
    string name;
    #! compiled pattern alternatives for one restriction step
    *list<XsdPatternConstraint> patterns;
}

class XsdBooleanFacetHelper {
    static checkDefinition(hash<XsdBooleanFacetInfo> facets, AbstractDataProviderType base, string error) {
        if (!(base instanceof XsdBooleanDataType) && !(base instanceof XsdBooleanRestrictionDataType)) {
            throw error, "boolean restrictions require a boolean base provider";
        }
        foreach XsdPatternConstraint pattern in (facets.patterns) {
            try {
                bool accepts_empty = XsdPatternConstraintHelper::matches("", pattern);
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "REGEX-ERROR" && ex.err != "REGEX-COMPILATION-ERROR") {
                    rethrow;
                }
                throw error, sprintf("invalid compiled boolean pattern: %s", ex.desc);
            }
        }
    }

    static string validate(hash<XsdBooleanFacetInfo> facets, auto value, string error) {
        string lexical = XsdBooleanLexicalHelper::lexical(value, error);
        if (facets.patterns) {
            foreach XsdPatternConstraint pattern in (facets.patterns) {
                if (XsdPatternConstraintHelper::matches(lexical, pattern)) {
                    return lexical;
                }
            }
            throw error, sprintf("boolean spelling %Y does not match a pattern of %Y", lexical, facets.name);
        }
        return lexical;
    }
}

#! a boolean provider retaining accepted lexical spellings for pattern facets
/** Same-step patterns are alternatives; inherited restrictions are also required.
    Patterned values remain strings so later XML serialization retains a valid spelling.
    @par Example
    A flag constrained by pattern \c "0|1" accepts \c "0" and retains that spelling.
    Native booleans use \c "true" or \c "false" and must satisfy the same patterns.
    @since %WSDL 0.5.8
*/
public class XsdBooleanRestrictionDataType inherits AbstractDataProviderType {
    private {
        hash<XsdBooleanFacetInfo> facets;
        AbstractDataProviderType base;
    }

    #! constructs a provider for a boolean restriction
    /** @param facets the resolved scalar facet data
        @param base the base provider supplying native categories and requiredness
        @throw XSD-SIMPLETYPE-ERROR invalid boolean facet metadata
    */
    constructor(hash<XsdBooleanFacetInfo> facets, AbstractDataProviderType base) {
        XsdBooleanFacetHelper::checkDefinition(facets, base, "XSD-SIMPLETYPE-ERROR");
        self.facets = facets;
        self.base = base;
    }

    private:internal deserializeMembers(hash<auto> members) {
        if (!(members.base instanceof AbstractDataProviderType)) {
            throw "DESERIALIZATION-ERROR", "boolean restriction provider requires a base provider";
        }
        hash<XsdBooleanFacetInfo> resolved = new hash<XsdBooleanFacetInfo>(members.facets);
        XsdBooleanFacetHelper::checkDefinition(resolved, members.base, "DESERIALIZATION-ERROR");
        facets = resolved;
        base = members.base;
    }

    #! returns the restricted type name
    /** @return the XSD type name with its optionality prefix */
    string getName() {
        return (base.isOrNothingType() ? "*" : "") + "xsd:" + facets.name;
    }

    #! prevents list providers from converting values before facet validation
    /** @return NOTHING */
    *Type getValueType() {
    }

    #! returns the output category, retaining patterned values as strings
    /** @return string for this step's pattern, otherwise the base provider category */
    int getBaseTypeCode() {
        return facets.patterns ? NT_STRING : base.getBaseTypeCode();
    }

    #! returns the output category name, including retained patterned strings
    /** @return string for this step's pattern, otherwise the base provider category name */
    string getBaseTypeName() {
        return facets.patterns ? "string" : base.getBaseTypeName();
    }

    #! returns no item type for this atomic value
    /** @return NOTHING */
    *AbstractDataProviderType getElementType() {
    }

    #! returns no record fields for this atomic value
    /** @return NOTHING */
    *hash<string, AbstractDataField> getFields() {
    }

    #! requires facet validation for all values
    /** @return an empty map */
    *hash<string, bool> getDirectTypeHash() {
        return {};
    }

    #! returns accepted native categories
    /** @param simple request simplified names
        @return the base provider's accepted categories
    */
    hash<string, bool> getAcceptTypeHash(*bool simple) {
        return base.getAcceptTypeHash(simple);
    }

    #! returns converted native categories
    /** @param simple request simplified names
        @return string and optional nothing for this step's pattern, otherwise the base provider's categories
    */
    hash<string, bool> getReturnTypeHash(*bool simple) {
        if (facets.patterns) {
            hash<string, bool> result = {"string": True};
            if (base.isOrNothingType()) {
                result.nothing = True;
            }
            return result;
        }
        return base.getReturnTypeHash(simple);
    }

    #! validates the declared restriction and converts the accepted value
    /** @param value the native value or XML boolean text
        @return the validated boolean value, or NOTHING for optional omission
        @throw MISSING-VALUE-ERROR a required value is omitted
        @throw RUNTIME-TYPE-ERROR lexical input or a restriction facet is invalid
    */
    auto acceptsValue(auto value) {
        if (!exists value) {
            value = base.acceptsValue(value);
            if (!exists value) {
                return;
            }
        }
        string lexical = XsdBooleanFacetHelper::validate(facets, value, "RUNTIME-TYPE-ERROR");
        auto converted = base.acceptsValue(lexical);
        return facets.patterns ? lexical : converted;
    }

    #! returns the requiredness of the value
    /** @return True for mandatory values */
    bool isMandatory() {
        return base.isMandatory();
    }

    #! returns whether omission is accepted
    /** @return True for optional values */
    bool isOrNothingType() {
        return base.isOrNothingType();
    }

    #! returns an optional equivalent retaining the same restriction
    /** @return the optional provider */
    AbstractDataProviderType getOrNothingType() {
        return new XsdBooleanRestrictionDataType(facets, base.getOrNothingType());
    }

    #! returns a mandatory equivalent retaining the same restriction
    /** @return the mandatory provider */
    AbstractDataProviderType getMandatoryType() {
        return new XsdBooleanRestrictionDataType(facets, base.getMandatoryType());
    }
}

#! validates the XML lexical space shared by the integer family before native conversion
class XsdIntegerLexicalHelper {
    const Types = {
        "integer": True, "long": True, "int": True, "short": True, "byte": True,
        "unsignedLong": True, "unsignedInt": True, "unsignedShort": True, "unsignedByte": True,
        "positiveInteger": True, "negativeInteger": True, "nonPositiveInteger": True,
        "nonNegativeInteger": True,
    };

    const Bounds = {
        "byte": ("-128", "127"), "short": ("-32768", "32767"),
        "int": ("-2147483648", "2147483647"),
        "long": ("-9223372036854775808", "9223372036854775807"),
        "unsignedByte": ("0", "255"), "unsignedShort": ("0", "65535"),
        "unsignedInt": ("0", "4294967295"), "unsignedLong": ("0", "18446744073709551615"),
        "negativeInteger": (NOTHING, "-1"), "nonPositiveInteger": (NOTHING, "0"),
        "positiveInteger": ("1", NOTHING), "nonNegativeInteger": ("0", NOTHING),
    };

    static string canonical(string lexical) {
        bool negative = lexical[0] == "-";
        lexical =~ s/\A[+-]?0*//;
        return lexical.empty() ? "0" : (negative ? "-" : "") + lexical;
    }

    # Both operands are canonical integer strings; compare without a bounded numeric conversion.
    static int compare(string left, string right) {
        bool ln = left[0] == "-";
        bool rn = right[0] == "-";
        if (ln != rn) {
            return ln ? -1 : 1;
        }
        int result = left.size() <=> right.size();
        if (!result) {
            result = left <=> right;
        }
        return ln ? -result : result;
    }

    static string lexical(string type, auto value, string error) {
        if (value.typeCode() == NT_STRING) {
            value = XsdSimpleType::normalizeWhiteSpace(value, "collapse");
        }
        validate(type, value, error);
        string result;
        if (value.typeCode() == NT_FLOAT || value.typeCode() == NT_NUMBER) {
            if (value.nanp() || value.infp() || value != floor(value)) {
                throw error, sprintf("type %Y requires a finite integral value; got %Y", type, value);
            }
            # Fixed float output retains its stored binary value; raw number output retains
            # every integer digit even when its exponent exceeds its binary precision.
            result = value.typeCode() == NT_FLOAT ? value.format(0, ".", "") : value.toString(NF_Raw);
        } else {
            result = string(value);
        }
        string normalized = canonical(result);
        if (value.typeCode() != NT_STRING && normalized == "0") {
            result = "0";
        }
        *list<*string> bounds = Bounds{type};
        if (bounds && ((exists bounds[0] && compare(normalized, bounds[0]) < 0)
                || (exists bounds[1] && compare(normalized, bounds[1]) > 0))) {
            throw error, sprintf("value %Y is out of range for type %Y", result, type);
        }
        return result;
    }

    static auto decode(string type, string lexical) {
        string normalized = canonical(lexical);
        if (compare(normalized, "-9223372036854775808") < 0
                || compare(normalized, "9223372036854775807") > 0) {
            return lexical;
        }
        int value = int(normalized);
        # xs:integer has historically retained noncanonical spellings as strings.
        return type == "integer" && string(value) != lexical ? lexical : value;
    }

    static validate(string type, auto value, string error) {
        if (!Types{type}) {
            return;
        }
        # An absent text node is an empty lexical value, not the integer zero.
        if (!exists value || (value.typeCode() != NT_STRING && value.typeCode() != NT_INT
                && value.typeCode() != NT_FLOAT && value.typeCode() != NT_NUMBER)) {
            throw error, sprintf("type %Y requires an integer lexical or numeric value; got %s", type, value.type());
        }
        if (value.typeCode() == NT_STRING) {
            # XSD 1.0 unsigned builtins allow digits only; other integer types allow a sign.
            # Absolute anchors reject trailing newlines/control characters after whitespace normalization.
            bool valid = type =~ /^unsigned/ ? value =~ /\A[0-9]+\z/ : value =~ /\A[+-]?[0-9]+\z/;
            if (!valid) {
                throw error, sprintf("value %Y is not in the XML lexical space of type %Y", value, type);
            }
        }
    }
}

#! provider type for exact XSD integer values
/** Numeric strings are validated before conversion. Values within Qore's signed 64-bit range
    use native integers; larger values use strings, including unsignedLong above 2^63-1.
    Noncanonical xs:integer strings retain their existing string representation.

    @par Example
    An unsignedLong invoice identifier of 18446744073709551615 remains an exact string
    instead of being clamped during provider conversion.

    @since %WSDL 0.5.8
*/
public class XsdIntegerDataType inherits AbstractDataProviderType {
    private {
        string datatype;
        bool optional;
    }

    #! constructs an integer type with explicit requiredness
    /** @param datatype the XSD integer builtin local name
        @param optional whether NOTHING is accepted
        @throw WSDL-ERROR the name is not an integer builtin
    */
    constructor(string datatype, bool optional = False) {
        if (!XsdIntegerLexicalHelper::Types{datatype}) {
            throw WSDL_ERROR, sprintf("unknown integer builtin %Y", datatype);
        }
        self.datatype = datatype;
        self.optional = optional;
    }

    private:internal deserializeMembers(hash<auto> members) {
        if (members.datatype.typeCode() != NT_STRING || !XsdIntegerLexicalHelper::Types{members.datatype}
                || members.optional.typeCode() != NT_BOOLEAN) {
            throw "DESERIALIZATION-ERROR", "integer provider requires a builtin name and boolean requiredness";
        }
        datatype = members.datatype;
        optional = members.optional;
    }

    #! returns the XSD builtin underlying this numeric provider
    /** @return the builtin local name, retaining the IEEE precision when applicable
        @since %WSDL 0.5.8
    */
    string getBuiltinName() {
        return datatype;
    }

    #! returns the provider type name
    /** @return XSD builtin name with an optionality prefix */
    string getName() {
        return (optional ? "*" : "") + "xsd:" + datatype;
    }

    #! keeps input conversion in the XML integer validator
    /** @return NOTHING; a native soft type would convert strings before lexical/range validation */
    *Type getValueType() {
    }

    private bool canReturnString() {
        return datatype == "integer" || datatype == "unsignedLong" || datatype =~ /Integer\z/;
    }

    #! returns the native output category when one category is sufficient
    /** @return NT_INT for bounded integer output, otherwise NT_ALL for int/string output */
    int getBaseTypeCode() {
        return canReturnString() ? NT_ALL : NT_INT;
    }

    #! returns the native output category name
    /** @return int for bounded integer output, otherwise all for int/string output */
    string getBaseTypeName() {
        return canReturnString() ? "all" : "int";
    }

    #! returns NOTHING because an integer has no element type
    /** @return NOTHING */
    *AbstractDataProviderType getElementType() {
    }

    #! returns NOTHING because an integer has no fields
    /** @return NOTHING */
    *hash<string, AbstractDataField> getFields() {
    }

    #! requires validation even for native integers
    /** @return an empty map; range checks must not be bypassed */
    *hash<string, bool> getDirectTypeHash() {
        return {};
    }

    #! returns accepted scalar type names
    /** @param simple request simplified names
        @return string/int/float/number, plus nothing for optional types
    */
    hash<string, bool> getAcceptTypeHash(*bool simple) {
        hash<string, bool> rv = {"string": True, "int": True, "float": True, "number": True};
        if (optional) {
            rv.nothing = True;
        }
        return rv;
    }

    #! returns the exact output alternatives
    /** @param simple request simplified names
        @return int, string when necessary, and nothing for optional types
    */
    hash<string, bool> getReturnTypeHash(*bool simple) {
        hash<string, bool> rv = {"int": True};
        if (canReturnString()) {
            rv.string = True;
        }
        if (optional) {
            rv.nothing = True;
        }
        return rv;
    }

    #! validates integer syntax and bounds before conversion
    /** @param value a numeric scalar or XML integer lexical string
        @return an exact integer or string; NOTHING for an omitted optional value
        @throw MISSING-VALUE-ERROR a mandatory value is absent
        @throw RUNTIME-TYPE-ERROR invalid syntax, range, nonintegral or nonfinite numeric input
    */
    auto acceptsValue(auto value) {
        if (!exists value) {
            if (optional) {
                return;
            }
            throw "MISSING-VALUE-ERROR", sprintf("integer value %Y must be supplied", datatype);
        }
        return XsdIntegerLexicalHelper::decode(datatype,
            XsdIntegerLexicalHelper::lexical(datatype, value, "RUNTIME-TYPE-ERROR"));
    }

    #! returns whether a value is required
    /** @return True for mandatory types */
    bool isMandatory() {
        return !optional;
    }

    #! returns whether a value can be omitted
    /** @return True for optional types */
    bool isOrNothingType() {
        return optional;
    }

    #! returns the optional equivalent
    /** @return an optional integer provider with the same builtin constraints */
    AbstractDataProviderType getOrNothingType() {
        if (optional) {
            return self;
        }
        XsdIntegerDataType rv = self.copy();
        rv.optional = True;
        return rv;
    }

    #! returns the mandatory equivalent
    /** @return a mandatory integer provider with the same builtin constraints */
    AbstractDataProviderType getMandatoryType() {
        if (!optional) {
            return self;
        }
        XsdIntegerDataType rv = self.copy();
        rv.optional = False;
        return rv;
    }
}

#! validates IEEE lexical input and preserves authored spellings for subsequent pattern validation
class XsdIeeeLexicalHelper {
    static bool isType(string builtin) {
        return builtin == "float" || builtin == "double";
    }

    static float decode(string builtin, auto value, string error) {
        @assert(isType(builtin));
        try {
            return convert_xsd_float(value, builtin == "double");
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "XSD-FLOAT-LEXICAL-ERROR") {
                rethrow error, ex.desc, ex.arg;
            }
            rethrow;
        }
    }

    static *int compare(string builtin, auto left, auto right, string error) {
        float first = decode(builtin, left, error);
        float second = decode(builtin, right, error);
        if (first != first || second != second) {
            return first != first && second != second ? 0 : NOTHING;
        }
        return first < second ? -1 : first > second ? 1 : 0;
    }

    static string key(string builtin, auto value, string error) {
        float rounded = decode(builtin, value, error);
        return rounded == 0.0 ? "0" : rounded.toStringRoundTrip();
    }

    # Every finite operation below produces an exactly representable target value.
    # logb extracts the binary exponent; log2 could round to the wrong binade.
    static float adjacent(string builtin, float value, bool upward) {
        bool wide = builtin == "double";
        int minimum = wide ? -1022 : -126;
        int fraction = wide ? 52 : 23;
        float maximum = wide ? 1.7976931348623157e308 : 3.4028234663852886e38;
        if (value != value) {
            return value;
        }
        if (value == 0.0) {
            float least = exp2(float(minimum - fraction));
            return upward ? least : -least;
        }
        bool negative = value < 0.0;
        bool increase = negative ? !upward : upward;
        float magnitude = abs(value);
        if (magnitude == @inf@) {
            return increase ? value : negative ? -maximum : maximum;
        }
        if (increase && magnitude == maximum) {
            return negative ? -@inf@ : @inf@;
        }
        int exponent = int(logb(magnitude));
        float unit = exp2(float((exponent < minimum ? minimum : exponent) - fraction));
        if (!increase && exponent > minimum && magnitude == exp2(float(exponent))) {
            unit /= 2.0;
        }
        magnitude = increase ? magnitude + unit : magnitude - unit;
        return negative ? -magnitude : magnitude;
    }

    static string lexical(string builtin, auto value, string error) {
        # Convert the original native value directly: rendering it first can change midpoint rounding.
        float rounded = decode(builtin, value, error);
        return value.typeCode() == NT_STRING ? XsdSimpleType::normalizeWhiteSpace(value, "collapse")
            : rounded.toStringRoundTrip();
    }
}

#! provider for XSD float and double values with strict XML lexical validation
/** Both datatypes return a native Qore float. For xs:float the value is rounded to
    IEEE binary32, exactly carried by the native binary64 value. xs:double uses binary64.
    Numeric input rounds directly to the target precision with nearest, ties-to-even rounding.
    Text input must be a complete XSD numeric spelling or INF, -INF or NaN.

    @par Example
    A sensor reading declared as xs:float and supplied as "16777217" returns 16777216.0.
    A reading declared as xs:double retains 16777217.0. The string "1.25 volts" is rejected.

    @since %WSDL 0.5.8
*/
public class XsdIeeeDataType inherits AbstractDataProviderType {
    private {
        string datatype;
        bool optional;
    }

    #! constructs an IEEE type with explicit requiredness
    /** @param datatype the XSD builtin local name, float or double
        @param optional whether NOTHING is accepted
        @throw WSDL-ERROR the name is not an IEEE builtin
    */
    constructor(string datatype, bool optional = False) {
        if (!XsdIeeeLexicalHelper::isType(datatype)) {
            throw WSDL_ERROR, sprintf("unknown IEEE builtin %Y", datatype);
        }
        self.datatype = datatype;
        self.optional = optional;
    }

    private:internal deserializeMembers(hash<auto> members) {
        if (members.datatype.typeCode() != NT_STRING || !XsdIeeeLexicalHelper::isType(members.datatype)
                || members.optional.typeCode() != NT_BOOLEAN) {
            throw "DESERIALIZATION-ERROR", "IEEE provider requires a builtin name and boolean requiredness";
        }
        datatype = members.datatype;
        optional = members.optional;
    }

    #! returns the XSD builtin underlying this numeric provider
    /** @return the builtin local name, retaining the IEEE precision when applicable
        @since %WSDL 0.5.8
    */
    string getBuiltinName() {
        return datatype;
    }

    #! returns the provider type name
    /** @return XSD builtin name with an optionality prefix */
    string getName() {
        return (optional ? "*" : "") + "xsd:" + datatype;
    }

    #! keeps input conversion in the XML IEEE validator
    /** @return NOTHING; a native soft type would convert strings before lexical/range validation */
    *Type getValueType() {
    }

    #! returns the native IEEE carrier category
    /** @return NT_FLOAT; binary32 values are exactly representable in the binary64 carrier */
    int getBaseTypeCode() {
        return NT_FLOAT;
    }

    #! returns the native output category name
    /** @return float */
    string getBaseTypeName() {
        return "float";
    }

    #! returns NOTHING because an IEEE scalar has no element type
    /** @return NOTHING */
    *AbstractDataProviderType getElementType() {
    }

    #! returns NOTHING because an IEEE scalar has no fields
    /** @return NOTHING */
    *hash<string, AbstractDataField> getFields() {
    }

    #! requires validation even for native floating-point values
    /** @return an empty map; lexical validation and target-precision rounding must not be bypassed */
    *hash<string, bool> getDirectTypeHash() {
        return {};
    }

    #! returns accepted scalar type names
    /** @param simple request simplified names
        @return string/int/float/number, plus nothing for optional types
    */
    hash<string, bool> getAcceptTypeHash(*bool simple) {
        hash<string, bool> rv = {"string": True, "int": True, "float": True, "number": True};
        if (optional) {
            rv.nothing = True;
        }
        return rv;
    }

    #! returns the exact output alternatives
    /** @param simple request simplified names
        @return float, plus nothing for optional types
    */
    hash<string, bool> getReturnTypeHash(*bool simple) {
        hash<string, bool> rv = {"float": True};
        if (optional) {
            rv.nothing = True;
        }
        return rv;
    }

    #! validates XML syntax and rounds directly to the declared precision
    /** @param value a numeric scalar or XML IEEE lexical string
        @return a native IEEE value; NOTHING for an omitted optional value
        @throw MISSING-VALUE-ERROR a mandatory value is absent
        @throw RUNTIME-TYPE-ERROR invalid lexical syntax or an unsupported native input category
    */
    auto acceptsValue(auto value) {
        if (!exists value) {
            if (optional) {
                return;
            }
            throw "MISSING-VALUE-ERROR", sprintf("IEEE value %Y must be supplied", datatype);
        }
        return XsdIeeeLexicalHelper::decode(datatype, value, "RUNTIME-TYPE-ERROR");
    }

    #! returns whether a value is required
    /** @return True for mandatory types */
    bool isMandatory() {
        return !optional;
    }

    #! returns whether a value can be omitted
    /** @return True for optional types */
    bool isOrNothingType() {
        return optional;
    }

    #! returns the optional equivalent
    /** @return an optional IEEE provider with the same builtin constraints */
    AbstractDataProviderType getOrNothingType() {
        if (optional) {
            return self;
        }
        XsdIeeeDataType rv = self.copy();
        rv.optional = True;
        return rv;
    }

    #! returns the mandatory equivalent
    /** @return a mandatory IEEE provider with the same builtin constraints */
    AbstractDataProviderType getMandatoryType() {
        if (!optional) {
            return self;
        }
        XsdIeeeDataType rv = self.copy();
        rv.optional = False;
        return rv;
    }
}

#! validates exact decimal text and formats native numbers for the decimal binding
class XsdDecimalLexicalHelper {
    # A value key for validated decimal text; lexical spelling is retained separately.
    static string canonical(string lexical) {
        bool negative = lexical[0] == "-";
        lexical =~ s/\A[+-]//;
        list<string> parts = lexical.split(".");
        string whole = parts[0];
        string fraction = parts[1] ?? "";
        whole =~ s/\A0+//;
        fraction =~ s/0+\z//;
        if (whole.empty() && fraction.empty()) {
            return "0";
        }
        return (negative ? "-" : "") + (whole.empty() ? "0" : whole)
            + (fraction.empty() ? "" : "." + fraction);
    }

    # Both operands have already passed decimal/integer lexical validation.
    static int compare(string left, string right) {
        left = canonical(left);
        right = canonical(right);
        bool negative = left[0] == "-";
        if (negative != (right[0] == "-")) {
            return negative ? -1 : 1;
        }
        if (negative) {
            splice left, 0, 1;
            splice right, 0, 1;
        }
        list<string> lhs = left.split(".");
        list<string> rhs = right.split(".");
        int result = lhs[0].size() <=> rhs[0].size();
        if (!result) {
            result = lhs[0] <=> rhs[0];
        }
        if (!result) {
            # Canonical fractions have no trailing zeros, so a shorter equal prefix is smaller.
            string left_fraction = lhs[1] ?? "";
            string right_fraction = rhs[1] ?? "";
            # Qore orders empty strings after nonempty strings; numeric zero comes first here.
            result = left_fraction.empty() || right_fraction.empty()
                ? int(!left_fraction.empty()) <=> int(!right_fraction.empty())
                : left_fraction <=> right_fraction;
        }
        return negative ? -result : result;
    }

    # Returns the smallest positive grid value at or above the magnitude of the input.
    static string ceilingMagnitude(string value, int scale, bool exclusive) {
        @assert(scale >= 0);
        value = canonical(value);
        value =~ s/\A-//;
        list<string> parts = value.split(".");
        string fraction = parts[1] ?? "";
        string coefficient = parts[0] + fraction.substr(0, scale);
        if (fraction.size() < scale) {
            coefficient += strmul("0", scale - fraction.size());
        }
        coefficient = XsdIntegerLexicalHelper::canonical(coefficient);
        if (fraction.size() > scale || exclusive) {
            int position = coefficient.size() - 1;
            while (position >= 0 && coefficient[position] == "9") {
                --position;
            }
            coefficient = position < 0 ? "1" + strmul("0", coefficient.size())
                : coefficient.substr(0, position) + chr(ord(coefficient[position]) + 1)
                    + strmul("0", coefficient.size() - position - 1);
        }
        if (scale) {
            if (coefficient.size() <= scale) {
                coefficient = strmul("0", scale + 1 - coefficient.size()) + coefficient;
            }
            int point = coefficient.size() - scale;
            coefficient = coefficient.substr(0, point) + "." + coefficient.substr(point);
        }
        return canonical(coefficient);
    }

    static string lexical(auto value, string error) {
        switch (value.typeCode()) {
            case NT_STRING:
                value = XsdSimpleType::normalizeWhiteSpace(value, "collapse");
                if (value =~ /\A[+-]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)\z/) {
                    return value;
                }
                break;
            case NT_INT:
                return string(value);
            case NT_FLOAT:
            case NT_NUMBER:
                if (!value.nanp() && !value.infp()) {
                    return value.toStringRoundTrip();
                }
                break;
        }
        throw error, sprintf("type decimal requires finite numeric input or XML decimal text; got %Y", value);
    }

    static auto decode(string lexical) {
        float value = float(lexical);
        # Keep the familiar float result only when serialization can reproduce every authored digit.
        # All other values, including noncanonical spellings used by patterns, remain exact strings.
        return !value.infp() && value.toStringRoundTrip() == lexical ? value : lexical;
    }
}

# Exact signed integer arithmetic for duration component and Gregorian-cycle calculations.
# Base-10^9 limbs keep every intermediate below 10^18. No floating-point conversion is used.
hashdecl XsdDurationDivisionInfo {
    string quotient;
    int remainder;
}

class XsdDurationIntegerHelper {
    const Base = 1000000000;

    private static list<int> limbs(string value) {
        # Lexical validation already restricted the input to ASCII. Fixed-width
        # encoding makes each backwards substring operation constant-time.
        value = convert_encoding(value, "ASCII");
        list<int> result();
        for (int end = value.size(); end > 0; end -= 9) {
            push result, int(value.substr(max(0, end - 9), min(9, end)));
        }
        return result;
    }

    private static string render(list<int> value, bool negative) {
        while (value.size() > 1 && !value[value.size() - 1]) {
            pop value;
        }
        list<string> pieces();
        for (int index = value.size() - 1; index >= 0; --index) {
            push pieces, index == value.size() - 1 ? string(value[index]) : sprintf("%09d", value[index]);
        }
        string result = pieces.join("");
        return negative && result != "0" ? "-" + result : result;
    }

    static string negate(string value) {
        return value == "0" ? value : value[0] == "-" ? value.substr(1) : "-" + value;
    }

    static string add(string left, string right) {
        bool ln = left[0] == "-";
        bool rn = right[0] == "-";
        left = ln ? left.substr(1) : left;
        right = rn ? right.substr(1) : right;
        bool same_sign = ln == rn;
        if (!same_sign && XsdIntegerLexicalHelper::compare(left, right) < 0) {
            string swap = left;
            left = right;
            right = swap;
            ln = rn;
        }
        list<int> lhs = limbs(left);
        list<int> rhs = limbs(right);
        list<int> result();
        int carry = 0;
        for (int index = 0; index < max(lhs.size(), rhs.size()); ++index) {
            int total = (lhs[index] ?? 0) + (same_sign ? (rhs[index] ?? 0) : -(rhs[index] ?? 0)) + carry;
            carry = total < 0 ? -1 : total / Base;
            push result, total < 0 ? total + Base : total % Base;
        }
        @assert(carry >= 0);
        if (carry) {
            push result, carry;
        }
        return render(result, ln);
    }

    static string multiply(string value, int factor) {
        @assert(factor >= 0 && factor < Base);
        bool negative = value[0] == "-";
        list<int> source = limbs(negative ? value.substr(1) : value);
        list<int> result();
        int carry = 0;
        foreach int limb in (source) {
            int total = limb * factor + carry;
            push result, total % Base;
            carry = total / Base;
        }
        if (carry) {
            push result, carry;
        }
        return render(result, negative);
    }

    # Euclidean division: the remainder is always nonnegative, including negative durations.
    static hash<XsdDurationDivisionInfo> divide(string value, int divisor) {
        @assert(divisor > 0 && divisor < Base);
        bool negative = value[0] == "-";
        list<int> source = limbs(negative ? value.substr(1) : value);
        list<int> quotient = source;
        int remainder = 0;
        for (int index = source.size() - 1; index >= 0; --index) {
            int total = remainder * Base + source[index];
            quotient[index] = total / divisor;
            remainder = total % divisor;
        }
        string text = render(quotient, negative);
        if (negative && remainder) {
            text = add(text, "-1");
            remainder = divisor - remainder;
        }
        return <XsdDurationDivisionInfo>{"quotient": text, "remainder": remainder};
    }
}

hashdecl XsdDurationComponents {
    bool negative;
    string months;
    string seconds;
    string fraction;
}

hashdecl XsdDurationInstant {
    string whole;
    string fraction;
}

class XsdDurationValueHelper {
    const Anchors = ((1696, 9), (1697, 2), (1903, 3), (1903, 7));
    const MonthStarts = (0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334);

    private static hash<XsdDurationComponents> components(auto value, string error) {
        string text = XsdDurationLexicalHelper::lexical(value, error);
        list<*string> fields = text =~ x/\A(-)?P(?:([0-9]+)Y)?(?:([0-9]+)M)?(?:([0-9]+)D)?(?:T(?:([0-9]+)H)?(?:([0-9]+)M)?(?:([0-9]+)(?:\.([0-9]+))?S)?)?\z/;
        @assert(fields);
        list<string> numbers();
        for (int index = 1; index <= 6; ++index) {
            push numbers, XsdIntegerLexicalHelper::canonical(fields[index] ?? "0");
        }
        string months = XsdDurationIntegerHelper::add(XsdDurationIntegerHelper::multiply(numbers[0], 12), numbers[1]);
        string seconds = XsdDurationIntegerHelper::add(XsdDurationIntegerHelper::multiply(numbers[2], 24), numbers[3]);
        seconds = XsdDurationIntegerHelper::add(XsdDurationIntegerHelper::multiply(seconds, 60), numbers[4]);
        seconds = XsdDurationIntegerHelper::add(XsdDurationIntegerHelper::multiply(seconds, 60), numbers[5]);
        string fraction = fields[7] ?? "";
        fraction =~ s/0+\z//;
        return <XsdDurationComponents>{"negative": boolean(fields[0]), "months": months, "seconds": seconds,
            "fraction": fraction};
    }

    private static list<hash<XsdDurationInstant>> instants(auto value, string error) {
        hash<XsdDurationComponents> parts = components(value, error);
        string months = parts.negative ? XsdDurationIntegerHelper::negate(parts.months) : parts.months;
        string seconds = parts.negative ? XsdDurationIntegerHelper::negate(parts.seconds) : parts.seconds;
        string fraction = parts.fraction;
        if (parts.negative && fraction.size()) {
            seconds = XsdDurationIntegerHelper::add(seconds, "-1");
            string complement = XsdDurationIntegerHelper::add("1" + strmul("0", fraction.size()),
                XsdDurationIntegerHelper::negate(XsdIntegerLexicalHelper::canonical(fraction)));
            fraction = strmul("0", fraction.size() - complement.size()) + complement;
            fraction =~ s/0+\z//;
        }
        list<hash<XsdDurationInstant>> result();
        foreach list<int> anchor in (Anchors) {
            string month = XsdDurationIntegerHelper::add(months, string(anchor[0] * 12 + anchor[1] - 1));
            hash<XsdDurationDivisionInfo> cycle = XsdDurationIntegerHelper::divide(month, 4800);
            int year = cycle.remainder / 12;
            int month_index = cycle.remainder % 12;
            int prior = year - 1;
            # Appendix E adds numeric years, including intermediate year zero.
            # Every 400-year cycle has exactly 146097 days. Residual years fit int.
            int day = year ? 365 * prior + prior / 4 - prior / 100 + prior / 400 : -366;
            day += MonthStarts[month_index];
            if (month_index > 1 && !(year % 4) && ((year % 100) || !(year % 400))) {
                ++day;
            }
            string whole = XsdDurationIntegerHelper::add(
                XsdDurationIntegerHelper::multiply(cycle.quotient, 146097), string(day));
            whole = XsdDurationIntegerHelper::add(XsdDurationIntegerHelper::multiply(whole, 86400), seconds);
            push result, <XsdDurationInstant>{"whole": whole, "fraction": fraction};
        }
        return result;
    }

    static string key(auto value, string error) {
        return (map $1.whole + "." + $1.fraction, instants(value, error)).join(":");
    }

    static *int compare(auto left, auto right, string error) {
        list<hash<XsdDurationInstant>> lhs = instants(left, error);
        list<hash<XsdDurationInstant>> rhs = instants(right, error);
        *int result;
        for (int index = 0; index < 4; ++index) {
            int relation = XsdIntegerLexicalHelper::compare(lhs[index].whole, rhs[index].whole);
            if (!relation) {
                # Qore sorts an empty string after nonempty strings; a zero
                # fractional part must sort before every positive fraction.
                relation = lhs[index].fraction.empty() || rhs[index].fraction.empty()
                    ? int(!lhs[index].fraction.empty()) <=> int(!rhs[index].fraction.empty())
                    : lhs[index].fraction <=> rhs[index].fraction;
            }
            if (exists result && relation != result) {
                return;
            }
            result = relation;
        }
        return result;
    }

    static int fractionDigits(string value) {
        return components(value, "XSD-SIMPLETYPE-ERROR").fraction.size();
    }

    static list<string> nearby(string value, int scale) {
        hash<XsdDurationComponents> parts = components(value, "XSD-SIMPLETYPE-ERROR");
        @assert(scale > parts.fraction.size());
        string months = parts.negative ? XsdDurationIntegerHelper::negate(parts.months) : parts.months;
        string grid = XsdIntegerLexicalHelper::canonical(parts.seconds + parts.fraction
            + strmul("0", scale - parts.fraction.size()));
        if (parts.negative) {
            grid = XsdDurationIntegerHelper::negate(grid);
        }
        list<string> candidates();
        foreach int direction in (-1, 1) {
            *string candidate = render(months, XsdDurationIntegerHelper::add(grid, string(direction)), scale);
            if (exists candidate) {
                push candidates, candidate;
            }
            candidate = render(XsdDurationIntegerHelper::add(months, string(direction)), grid, scale);
            if (exists candidate) {
                push candidates, candidate;
            }
        }
        # A duration has one sign. Close values on the other side of a pure
        # negative month endpoint may need a day/second spelling. Each anchor's
        # elapsed seconds supplies a bounded candidate, checked by the caller.
        list<hash<XsdDurationInstant>> anchored = instants(value, "XSD-SIMPLETYPE-ERROR");
        list<hash<XsdDurationInstant>> zero = instants("PT0S", "XSD-SIMPLETYPE-ERROR");
        for (int index = 0; index < 4; ++index) {
            string elapsed = XsdDurationIntegerHelper::add(anchored[index].whole,
                XsdDurationIntegerHelper::negate(zero[index].whole));
            string whole_grid = elapsed == "0" ? "0" : elapsed + strmul("0", scale);
            string fraction_grid = XsdIntegerLexicalHelper::canonical(anchored[index].fraction
                + strmul("0", scale - anchored[index].fraction.size()));
            string base_grid = XsdDurationIntegerHelper::add(whole_grid, fraction_grid);
            foreach int direction in (-1, 0, 1) {
                push candidates, render("0", XsdDurationIntegerHelper::add(base_grid, string(direction)), scale);
            }
        }
        return candidates;
    }

    private static *string render(string months, string grid, int scale) {
        bool negative = months != "0" ? months[0] == "-" : grid[0] == "-";
        if (months != "0" && grid != "0" && (months[0] == "-") != (grid[0] == "-")) {
            return;
        }
        months = months[0] == "-" ? months.substr(1) : months;
        grid = grid[0] == "-" ? grid.substr(1) : grid;
        grid = strmul("0", max(0, scale + 1 - grid.size())) + grid;
        string whole = grid.substr(0, grid.size() - scale);
        string fraction = grid.substr(grid.size() - scale);
        fraction =~ s/0+\z//;
        return (negative ? "-P" : "P") + (months == "0" ? "" : months + "M")
            + "T" + whole + (fraction.empty() ? "" : "." + fraction) + "S";
    }

}

#! an immutable binary value retaining an XSD lexical spelling
/** Native octets alone cannot retain uppercase hex or spaced base64 required by a pattern.
    This value carries the encoding, validated XML text and decoded bytes.
    @par Example
    \c XsdBinaryValue("hexBinary", "FF") preserves uppercase text while representing one 255 octet.
    @note Ordinary serializer strings retain their existing raw-byte meaning; use this class for encoded text.
    @since %WSDL 0.5.8
*/
public final class XsdBinaryValue inherits Serializable {
    private {
        string builtin;
        string lexical;
        transient binary bytes;
    }

    #! constructs a retained binary spelling
    /** @param builtin hexBinary or base64Binary
        @param lexical encoded XML text, normalized and validated with the builtin whitespace rule
        @throw XSD-BINARY-VALUE-ERROR unknown encoding or malformed text
    */
    constructor(string builtin, string lexical) {
        initialize(builtin, lexical, "XSD-BINARY-VALUE-ERROR");
    }

    private initialize(string builtin, string lexical, string error) {
        if (!XsdBinaryLexicalHelper::isType(builtin)) {
            throw error, sprintf("unknown XML binary encoding %Y", builtin);
        }
        string validated = XsdBinaryLexicalHelper::lexical(builtin, lexical, error);
        binary decoded = XsdBinaryLexicalHelper::decode(builtin, validated, error);
        self.builtin = builtin;
        self.lexical = validated;
        bytes = decoded;
    }

    private:internal deserializeMembers(hash<auto> members) {
        if (members.builtin.typeCode() != NT_STRING || members.lexical.typeCode() != NT_STRING) {
            throw "DESERIALIZATION-ERROR", "a retained binary value requires encoding and lexical strings";
        }
        initialize(members.builtin, members.lexical, "DESERIALIZATION-ERROR");
    }

    #! returns the primitive binary encoding
    /** @return hexBinary or base64Binary */
    string getBuiltinName() {
        return builtin;
    }

    #! returns the validated XML spelling
    /** @return normalized XML text retaining case and internal base64 spacing */
    string getLexicalValue() {
        return lexical;
    }

    #! returns the exact octets independently of their spelling
    /** @return native binary content */
    binary getBinaryValue() {
        return bytes;
    }
}

class XsdBinaryLexicalHelper {
    static bool isType(string builtin) {
        return builtin == "hexBinary" || builtin == "base64Binary";
    }

    static string lexical(string builtin, string value, string error) {
        @assert(isType(builtin));
        string text = XsdSimpleType::normalizeWhiteSpace(value, "collapse");
        bool invalid;
        if (builtin == "hexBinary") {
            invalid = text =~ /[^0-9a-fA-F]/;
        } else {
            invalid = text =~ /[^A-Za-z0-9+\/= ]/;
        }
        if (invalid) {
            throw error, sprintf("invalid %s alphabet in %Y", builtin, value);
        }
        # XML encodings describe characters, not encoded octets. Native decoders
        # receive the validated ASCII alphabet even when input text uses UTF-16.
        string compact = convert_encoding(text, "ASCII");
        if (builtin == "hexBinary") {
            if (compact.size() % 2) {
                throw error, "hexBinary requires exactly two hexadecimal digits per octet";
            }
        } else {
            compact =~ s/ //g;
            if (compact.size() % 4) {
                throw error, "base64Binary requires complete four-character encoding units";
            }
            int padding = compact.endsWith("==") ? 2 : compact.endsWith("=") ? 1 : 0;
            string data = compact.substr(0, compact.size() - padding);
            if (data =~ /=/ || (padding == 2 && data[data.size() - 1] !~ /[AQgw]/)
                    || (padding == 1 && data[data.size() - 1] !~ /[AEIMQUYcgkosw048]/)) {
                throw error, "base64Binary has misplaced padding or nonzero unused bits";
            }
        }
        return text;
    }

    static binary decode(string builtin, auto value, string error) {
        if (value instanceof XsdBinaryValue) {
            XsdBinaryValue retained = cast<XsdBinaryValue>(value);
            if (retained.getBuiltinName() != builtin) {
                throw error, "retained binary value uses a different primitive encoding";
            }
            return retained.getBinaryValue();
        }
        if (value.typeCode() == NT_BINARY) {
            return value;
        }
        # A present empty XML scalar can arrive without a text node. Provider
        # requiredness is checked before calling this wire-value conversion.
        if (!exists value) {
            return binary();
        }
        if (value.typeCode() != NT_STRING) {
            throw error, sprintf("type %Y requires encoded XML text or binary octets; got %Y", builtin, value.type());
        }
        string text = convert_encoding(lexical(builtin, value, error), "ASCII");
        if (builtin == "base64Binary") {
            text =~ s/ //g;
        }
        return text.empty() ? binary() : builtin == "hexBinary" ? parse_hex_string(text) : parse_base64_string(text);
    }

    static string encode(string builtin, auto value, string error) {
        @assert(isType(builtin));
        if (value instanceof XsdBinaryValue) {
            XsdBinaryValue retained = cast<XsdBinaryValue>(value);
            if (retained.getBuiltinName() != builtin) {
                throw error, "retained binary value uses a different primitive encoding";
            }
            return retained.getLexicalValue();
        }
        if (!exists value) {
            return "";
        }
        if (value.typeCode() != NT_BINARY && value.typeCode() != NT_STRING) {
            throw error, sprintf("type %Y serializes binary octets or raw string bytes; got %Y", builtin, value.type());
        }
        # Preserve the existing raw-string input convention. Whitespace belongs
        # to those bytes; it is not XML lexical whitespace until after encoding.
        return builtin == "hexBinary" ? make_hex_string(value) : make_base64_string(value);
    }
}

#! provider validating encoded XML binary text before decoding octets
/** Encoded strings follow the complete XSD hexBinary or base64Binary grammar, including base64 padding bits.
    Native binary values and XsdBinaryValue carriers retain every octet. XML whitespace and character encoding
    are handled before decoding. Carriers must use this provider's primitive binary encoding.
    @par Example
    A base64 attachment fragment \c "A A = =" decodes to one zero octet; \c "AB==" rejects nonzero padding bits.
    @since %WSDL 0.5.8
*/
public class XsdBinaryDataType inherits AbstractDataProviderType {
    private {
        string datatype;
        bool optional;
    }

    #! constructs a binary provider with an explicit XML encoding
    /** @param datatype hexBinary or base64Binary
        @param optional whether NOTHING is accepted
        @throw WSDL-ERROR unknown binary encoding
    */
    constructor(string datatype, bool optional = False) {
        if (!XsdBinaryLexicalHelper::isType(datatype)) {
            throw WSDL_ERROR, sprintf("unknown XML binary encoding %Y", datatype);
        }
        self.datatype = datatype;
        self.optional = optional;
    }

    private:internal deserializeMembers(hash<auto> members) {
        if (members.datatype.typeCode() != NT_STRING || !XsdBinaryLexicalHelper::isType(members.datatype)
                || members.optional.typeCode() != NT_BOOLEAN) {
            throw "DESERIALIZATION-ERROR", "binary provider requires an XML encoding and boolean optionality";
        }
        datatype = members.datatype;
        optional = members.optional;
    }

    #! returns the XSD builtin underlying this provider
    /** @return hexBinary or base64Binary */
    string getBuiltinName() {
        return datatype;
    }

    #! returns the provider type name
    /** @return the XML encoding name with an optionality prefix when appropriate */
    string getName() {
        return (optional ? "*" : "") + "xsd:" + datatype;
    }

    #! requires validation before conversion by an enclosing list
    /** @return NOTHING */
    *Type getValueType() {
    }

    #! returns the exact output category
    /** @return NT_BINARY */
    int getBaseTypeCode() {
        return NT_BINARY;
    }

    #! returns the native output category name
    /** @return binary */
    string getBaseTypeName() {
        return "binary";
    }

    #! returns no item type for an atomic binary value
    /** @return NOTHING */
    *AbstractDataProviderType getElementType() {
    }

    #! returns no record fields for an atomic binary value
    /** @return NOTHING */
    *hash<string, AbstractDataField> getFields() {
    }

    #! requires validation of every supplied binary value
    /** @return an empty map */
    *hash<string, bool> getDirectTypeHash() {
        return {};
    }

    #! reports accepted native categories
    /** @param simple request simplified names
        @return string/binary/object, plus nothing for optional types; only XsdBinaryValue objects are accepted
    */
    hash<string, bool> getAcceptTypeHash(*bool simple) {
        hash<string, bool> result = {"string": True, "binary": True, "object": True};
        if (optional) {
            result.nothing = True;
        }
        return result;
    }

    #! reports exact output categories
    /** @param simple request simplified names
        @return binary, plus nothing for optional types
    */
    hash<string, bool> getReturnTypeHash(*bool simple) {
        hash<string, bool> result = {"binary": True};
        if (optional) {
            result.nothing = True;
        }
        return result;
    }

    #! validates encoded text and returns its exact octets
    /** @param value encoded XML text, native binary octets or an XsdBinaryValue carrier
        @return binary data, or NOTHING for optional omission
        @throw MISSING-VALUE-ERROR a required value is absent
        @throw RUNTIME-TYPE-ERROR invalid encoded text or unsupported native category
    */
    auto acceptsValue(auto value) {
        if (!exists value) {
            if (optional) {
                return;
            }
            throw "MISSING-VALUE-ERROR", sprintf("a %s value must be supplied", datatype);
        }
        return XsdBinaryLexicalHelper::decode(datatype, value, "RUNTIME-TYPE-ERROR");
    }

    #! returns whether a binary value must be supplied
    /** @return True for mandatory providers */
    bool isMandatory() {
        return !optional;
    }

    #! returns whether omission is allowed
    /** @return True for optional providers */
    bool isOrNothingType() {
        return optional;
    }

    #! creates the optional equivalent
    /** @return an optional binary value provider */
    AbstractDataProviderType getOrNothingType() {
        if (optional) {
            return self;
        }
        XsdBinaryDataType result = self.copy();
        result.optional = True;
        return result;
    }

    #! creates the mandatory equivalent
    /** @return a mandatory binary value provider */
    AbstractDataProviderType getMandatoryType() {
        if (!optional) {
            return self;
        }
        XsdBinaryDataType result = self.copy();
        result.optional = False;
        return result;
    }
}

class XsdDurationLexicalHelper {
    static string lexical(auto value, string error) {
        if (value.typeCode() == NT_DATE) {
            return native(value, error);
        }
        if (value.typeCode() != NT_STRING) {
            throw error, sprintf("type duration requires XML duration text or a relative date; got %Y", value.type());
        }
        string text = XsdSimpleType::normalizeWhiteSpace(value, "collapse");
        if (text !~ /\A-?P(?:[0-9]+Y)?(?:[0-9]+M)?(?:[0-9]+D)?(?:T(?:[0-9]+H)?(?:[0-9]+M)?(?:[0-9]+(?:\.[0-9]+)?S)?)?\z/
                || text =~ /\A-?P\z/ || text =~ /T\z/) {
            throw error, sprintf("invalid XML duration spelling %Y", text);
        }
        return text;
    }

    private static string native(date value, string error) {
        if (!value.relative()) {
            throw error, "type duration requires a relative date; an absolute date is not a duration";
        }
        # Native component fields are signed 32-bit integers. Combining months
        # and whole seconds separately stays in the signed 64-bit integer range;
        # multiplying a large day count by microseconds would overflow.
        int months = get_years(value) * 12 + get_months(value);
        int seconds = ((get_days(value) * 24 + get_hours(value)) * 60 + get_minutes(value)) * 60
            + get_seconds(value);
        int micros = get_microseconds(value);
        seconds += micros / 1000000;
        micros %= 1000000;
        @assert(abs(micros) < 1000000);
        if (seconds > 0 && micros < 0) {
            --seconds;
            micros += 1000000;
        } else if (seconds < 0 && micros > 0) {
            ++seconds;
            micros -= 1000000;
        }
        int second_sign = seconds ? seconds <=> 0 : micros <=> 0;
        if (months && second_sign && (months <=> 0) != second_sign) {
            throw error, "XML duration cannot represent opposing month and second component signs";
        }
        bool negative = months < 0 || second_sign < 0;
        months = abs(months);
        seconds = abs(seconds);
        micros = abs(micros);
        string result = negative ? "-P" : "P";
        if (months / 12) {
            result += sprintf("%dY", months / 12);
        }
        if (months % 12) {
            result += sprintf("%dM", months % 12);
        }
        if (seconds / 86400) {
            result += sprintf("%dD", seconds / 86400);
        }
        seconds %= 86400;
        if (seconds || micros) {
            result += "T";
            if (seconds / 3600) {
                result += sprintf("%dH", seconds / 3600);
            }
            seconds %= 3600;
            if (seconds / 60) {
                result += sprintf("%dM", seconds / 60);
            }
            seconds %= 60;
            if (seconds || micros) {
                result += string(seconds);
                if (micros) {
                    string fraction = sprintf("%06d", micros);
                    fraction =~ s/0+\z//;
                    result += "." + fraction;
                }
                result += "S";
            }
        }
        return result == "P" ? "PT0S" : result;
    }
}


#! provider preserving exact XML duration text and native relative-date components
/** XML duration text retains arbitrary component sizes, fractional precision and lexical spelling
    after whitespace collapse. Native relative dates are normalized to one XSD sign without dropping
    microseconds. Absolute dates and opposing month/second signs cannot represent an XSD duration.
    @par Example
    A processing interval of one microsecond becomes \c "PT0.000001S"; the string
    \c "PT0.00000000000000001S" retains every fractional digit.
    @since %WSDL 0.5.8
*/
public class XsdDurationDataType inherits AbstractDataProviderType {
    private {
        bool optional;
    }

    #! constructs a duration provider
    /** @param optional whether NOTHING is accepted */
    constructor(bool optional = False) {
        self.optional = optional;
    }

    private:internal deserializeMembers(hash<auto> members) {
        if (members.optional.typeCode() != NT_BOOLEAN) {
            throw "DESERIALIZATION-ERROR", "duration provider requires boolean optionality";
        }
        optional = members.optional;
    }

    #! returns the XSD builtin underlying this provider
    /** @return duration */
    string getBuiltinName() {
        return "duration";
    }

    #! returns the provider type name
    /** @return xsd:duration with an optionality prefix when appropriate */
    string getName() {
        return (optional ? "*" : "") + "xsd:duration";
    }

    #! requires validation before conversion by an enclosing list
    /** @return NOTHING */
    *Type getValueType() {
    }

    #! returns the exact output category
    /** @return NT_STRING */
    int getBaseTypeCode() {
        return NT_STRING;
    }

    #! returns the native output category name
    /** @return string */
    string getBaseTypeName() {
        return "string";
    }

    #! returns no item type for an atomic duration
    /** @return NOTHING */
    *AbstractDataProviderType getElementType() {
    }

    #! returns no record fields for an atomic duration
    /** @return NOTHING */
    *hash<string, AbstractDataField> getFields() {
    }

    #! requires validation of every supplied duration
    /** @return an empty map */
    *hash<string, bool> getDirectTypeHash() {
        return {};
    }

    #! reports accepted native categories
    /** @param simple request simplified names
        @return string/date, plus nothing for optional types
    */
    hash<string, bool> getAcceptTypeHash(*bool simple) {
        hash<string, bool> result = {"string": True, "date": True};
        if (optional) {
            result.nothing = True;
        }
        return result;
    }

    #! reports exact output categories
    /** @param simple request simplified names
        @return string, plus nothing for optional types
    */
    hash<string, bool> getReturnTypeHash(*bool simple) {
        hash<string, bool> result = {"string": True};
        if (optional) {
            result.nothing = True;
        }
        return result;
    }

    #! validates and converts duration input
    /** @param value XML duration text or a native relative date
        @return validated XML text, or NOTHING for optional omission
        @throw MISSING-VALUE-ERROR a required value is absent
        @throw RUNTIME-TYPE-ERROR invalid syntax, unsupported category, an absolute date or opposing component signs
    */
    auto acceptsValue(auto value) {
        if (!exists value) {
            if (optional) {
                return;
            }
            throw "MISSING-VALUE-ERROR", "a duration value must be supplied";
        }
        return XsdDurationLexicalHelper::lexical(value, "RUNTIME-TYPE-ERROR");
    }

    #! returns whether a duration must be supplied
    /** @return True for mandatory providers */
    bool isMandatory() {
        return !optional;
    }

    #! returns whether omission is allowed
    /** @return True for optional providers */
    bool isOrNothingType() {
        return optional;
    }

    #! creates the optional equivalent
    /** @return an optional duration provider */
    AbstractDataProviderType getOrNothingType() {
        if (optional) {
            return self;
        }
        XsdDurationDataType result = self.copy();
        result.optional = True;
        return result;
    }

    #! creates the mandatory equivalent
    /** @return a mandatory duration provider */
    AbstractDataProviderType getMandatoryType() {
        if (!optional) {
            return self;
        }
        XsdDurationDataType result = self.copy();
        result.optional = False;
        return result;
    }
}

# Calendar fields retain their XML lexical value independently of native epoch limits.
hashdecl XsdCalendarValueInfo {
    string lexical;
    string year = "2000";
    int month = 1;
    int day = 1;
    *int offset;
}

hashdecl XsdCalendarInstantInfo {
    string year;
    int month;
    int day;
    int minute;
}

class XsdCalendarLexicalHelper {
    const Types = {"date": True, "gYear": True, "gYearMonth": True,
        "gMonthDay": True, "gMonth": True, "gDay": True};
    const Formats = {"date": "YYYY-MM-DD", "gYear": "YYYY", "gYearMonth": "YYYY-MM",
        "gMonthDay": "--MM-DD", "gMonth": "--MM", "gDay": "---DD"};
    const Samples = {"date": "2000-01-01Z", "gYear": "2000Z", "gYearMonth": "2000-01Z",
        "gMonthDay": "--01-01Z", "gMonth": "--01Z", "gDay": "---01Z"};
    const MonthDays = (31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31);

    static bool isType(string builtin) {
        return boolean(Types{builtin});
    }

    static string lexical(string builtin, auto value, string error) {
        return parse(builtin, value, error).lexical;
    }

    static hash<XsdCalendarValueInfo> parse(string builtin, auto value, string error) {
        if (!isType(builtin)) {
            throw error, sprintf("unknown calendar builtin %Y", builtin);
        }
        if (value.typeCode() == NT_DATE) {
            if (value.relative()) {
                throw error, sprintf("type %Y requires an absolute calendar date", builtin);
            }
            int seconds = value.getUtcOffset();
            if (seconds % 60 || abs(seconds) > 50400) {
                throw error, sprintf("type %Y requires a timezone in whole minutes within -14:00 to +14:00", builtin);
            }
            value = value.format(Formats{builtin}) + (seconds
                ? sprintf("%s%02d:%02d", seconds < 0 ? "-" : "+", abs(seconds) / 3600, (abs(seconds) % 3600) / 60)
                : "Z");
        }
        if (value.typeCode() != NT_STRING) {
            throw error, sprintf("type %Y requires XML calendar text or an absolute date; got %Y", builtin, value.type());
        }
        string text = XsdSimpleType::normalizeWhiteSpace(value, "collapse");
        hash<XsdCalendarValueInfo> result = <XsdCalendarValueInfo>{"lexical": text};
        *string zone = (text =~ x/(Z|[+-][0-9]{2}:[0-9]{2})\z/)[0];
        if (exists zone) {
            result.offset = 0;
            if (zone != "Z") {
                int hour = int(zone.substr(1, 2));
                int minute = int(zone.substr(4, 2));
                if (hour > 14 || minute > 59 || (hour == 14 && minute)) {
                    throw error, sprintf("invalid timezone %Y for type %Y", zone, builtin);
                }
                result.offset = (zone[0] == "-" ? -1 : 1) * (hour * 60 + minute);
            }
            text = text.substr(0, text.size() - zone.size());
        }
        *list<string> fields;
        switch (builtin) {
            case "date":
                fields = text =~ x/\A(-?[0-9]{4,})-([0-9]{2})-([0-9]{2})\z/;
                if (fields) {
                    result.year = fields[0];
                    result.month = int(fields[1]);
                    result.day = int(fields[2]);
                }
                break;
            case "gYearMonth":
                fields = text =~ x/\A(-?[0-9]{4,})-([0-9]{2})\z/;
                if (fields) {
                    result.year = fields[0];
                    result.month = int(fields[1]);
                }
                break;
            case "gYear":
                fields = text =~ x/\A(-?[0-9]{4,})\z/;
                if (fields) {
                    result.year = fields[0];
                }
                break;
            case "gMonthDay":
                fields = text =~ x/\A--([0-9]{2})-([0-9]{2})\z/;
                if (fields) {
                    result.month = int(fields[0]);
                    result.day = int(fields[1]);
                }
                break;
            case "gMonth":
                fields = text =~ x/\A--([0-9]{2})\z/;
                if (fields) {
                    result.month = int(fields[0]);
                }
                break;
            case "gDay":
                fields = text =~ x/\A---([0-9]{2})\z/;
                if (fields) {
                    result.day = int(fields[0]);
                }
                break;
        }
        if (!fields) {
            throw error, sprintf("invalid XML calendar spelling %Y for type %Y", result.lexical, builtin);
        }
        string magnitude = result.year[0] == "-" ? result.year.substr(1) : result.year;
        if ((magnitude.size() > 4 && magnitude[0] == "0") || magnitude == "0000") {
            throw error, sprintf("type %Y prohibits year zero and leading zeros in extended years", builtin);
        }
        result.year = XsdIntegerLexicalHelper::canonical(result.year);
        if (result.month < 1 || result.month > 12 || result.day < 1
                || result.day > lastDay(result.year, result.month)) {
            throw error, sprintf("invalid Gregorian calendar date %Y for type %Y", result.lexical, builtin);
        }
        return result;
    }

    static int lastDay(string year, int month) {
        @assert(month >= 1 && month <= 12);
        # Divisibility by 400 depends only on the final four decimal digits.
        int cycle = int(year.substr(max(0, year.size() - 4)));
        return month == 2 && !(cycle % 4) && ((cycle % 100) || !(cycle % 400)) ? 29 : MonthDays[month - 1];
    }

    static string key(string builtin, auto value, string error) {
        hash<XsdCalendarValueInfo> fields = parse(builtin, value, error);
        hash<XsdCalendarInstantInfo> instant = normalize(fields, fields.offset ?? 0);
        return (exists fields.offset ? "Z:" : "local:") + instant.year
            + sprintf("-%02d-%02dT%04d", instant.month, instant.day, instant.minute);
    }

    static *int compare(string builtin, auto left, auto right, string error) {
        hash<XsdCalendarValueInfo> lhs = parse(builtin, left, error);
        hash<XsdCalendarValueInfo> rhs = parse(builtin, right, error);
        if ((exists lhs.offset) == (exists rhs.offset)) {
            return compareInstants(normalize(lhs, lhs.offset ?? 0), normalize(rhs, rhs.offset ?? 0));
        }
        # A missing timezone ranges from -14:00 through +14:00. Touching an
        # endpoint is indeterminate, as are overlapping possible UTC intervals.
        if (compareInstants(normalize(lhs, lhs.offset ?? -840), normalize(rhs, rhs.offset ?? 840)) < 0) {
            return -1;
        }
        if (compareInstants(normalize(lhs, lhs.offset ?? 840), normalize(rhs, rhs.offset ?? -840)) > 0) {
            return 1;
        }
    }

    private static int compareInstants(hash<XsdCalendarInstantInfo> left, hash<XsdCalendarInstantInfo> right) {
        int relation = XsdIntegerLexicalHelper::compare(left.year, right.year);
        if (!relation) {
            relation = left.month <=> right.month;
        }
        if (!relation) {
            relation = left.day <=> right.day;
        }
        return relation ? relation : left.minute <=> right.minute;
    }

    private static hash<XsdCalendarInstantInfo> normalize(hash<XsdCalendarValueInfo> fields, int offset) {
        @assert(offset >= -840 && offset <= 840);
        hash<XsdCalendarInstantInfo> instant = <XsdCalendarInstantInfo>{
            "year": fields.year, "month": fields.month, "day": fields.day, "minute": -offset,
        };
        if (instant.minute < 0) {
            instant.minute += 1440;
            --instant.day;
            if (!instant.day) {
                --instant.month;
                if (!instant.month) {
                    instant.month = 12;
                    instant.year = previousYear(instant.year);
                }
                instant.day = lastDay(instant.year, instant.month);
            }
        }
        return instant;
    }

    private static string previousYear(string year) {
        if (year == "1") {
            # XSD 1.0 labels have no year zero.
            return "-1";
        }
        bool negative = year[0] == "-";
        string magnitude = negative ? year.substr(1) : year;
        # Split the carry/borrow suffix in one anchored scan. Repeated character
        # indexing must not make extended UTF-8 year strings quadratic to process.
        *list<string> pieces = negative ? (magnitude =~ x/\A(.*[0-8])(9*)\z/)
            : (magnitude =~ x/\A(.*[1-9])(0*)\z/);
        if (!pieces) {
            @assert(negative);
            return "-1" + strmul("0", magnitude.size());
        }
        string prefix = pieces[0];
        string suffix = pieces[1] ?? "";
        string result = prefix.substr(0, prefix.size() - 1)
            + chr(ord(prefix[prefix.size() - 1]) + (negative ? 1 : -1))
            + strmul(negative ? "0" : "9", suffix.size());
        return (negative ? "-" : "") + XsdIntegerLexicalHelper::canonical(result);
    }

    static list<string> nearby(string builtin, string value) {
        hash<XsdCalendarValueInfo> fields = parse(builtin, value, "XSD-SIMPLETYPE-ERROR");
        list<string> candidates();
        foreach int direction in (-1, 1) {
            if (exists fields.offset && abs(fields.offset + direction) <= 840) {
                hash<XsdCalendarValueInfo> offset = fields;
                offset.offset += direction;
                push candidates, render(builtin, offset);
            }
            hash<XsdCalendarValueInfo> adjacent = fields;
            if (builtin == "gYear") {
                adjacent.year = shiftYear(adjacent.year, direction);
            } else if (builtin == "gMonth" || builtin == "gYearMonth") {
                adjacent.month += direction;
                adjustMonth(\adjacent);
            } else {
                adjacent.day += direction;
                if (adjacent.day < 1) {
                    --adjacent.month;
                    adjustMonth(\adjacent);
                    adjacent.day = lastDay(adjacent.year, adjacent.month);
                } else if (adjacent.day > lastDay(adjacent.year, adjacent.month)) {
                    adjacent.day = 1;
                    ++adjacent.month;
                    adjustMonth(\adjacent);
                }
            }
            push candidates, render(builtin, adjacent);
            if (exists adjacent.offset) {
                foreach int zone in (-840, 0, 840) {
                    adjacent.offset = zone;
                    push candidates, render(builtin, adjacent);
                }
                # Dates and day-based partials can express the adjacent minute
                # across the timezone limit by moving one calendar day.
                if (builtin == "date" || builtin == "gMonthDay" || builtin == "gDay") {
                    adjacent.offset = fields.offset + direction * 1439;
                    if (abs(adjacent.offset) <= 840) {
                        push candidates, render(builtin, adjacent);
                    }
                }
            }
        }
        return candidates;
    }

    private static adjustMonth(reference<hash<XsdCalendarValueInfo>> fields) {
        if (fields.month < 1) {
            fields.month = 12;
            fields.year = shiftYear(fields.year, -1);
        } else if (fields.month > 12) {
            fields.month = 1;
            fields.year = shiftYear(fields.year, 1);
        }
    }

    private static string shiftYear(string year, int direction) {
        @assert(direction == -1 || direction == 1);
        if (direction < 0) {
            return previousYear(year);
        }
        string opposite = year[0] == "-" ? year.substr(1) : "-" + year;
        string previous = previousYear(opposite);
        return previous[0] == "-" ? previous.substr(1) : "-" + previous;
    }

    private static string render(string builtin, hash<XsdCalendarValueInfo> fields) {
        string magnitude = fields.year[0] == "-" ? fields.year.substr(1) : fields.year;
        string year = (fields.year[0] == "-" ? "-" : "") + strmul("0", max(0, 4 - magnitude.size())) + magnitude;
        string text;
        switch (builtin) {
            case "date": text = year + sprintf("-%02d-%02d", fields.month, fields.day); break;
            case "gYear": text = year; break;
            case "gYearMonth": text = year + sprintf("-%02d", fields.month); break;
            case "gMonthDay": text = sprintf("--%02d-%02d", fields.month, fields.day); break;
            case "gMonth": text = sprintf("--%02d", fields.month); break;
            case "gDay": text = sprintf("---%02d", fields.day); break;
        }
        if (exists fields.offset) {
            text += fields.offset ? sprintf("%s%02d:%02d", fields.offset < 0 ? "-" : "+",
                abs(fields.offset) / 60, abs(fields.offset) % 60) : "Z";
        }
        return text;
    }

    static auto decode(string builtin, auto value, string error) {
        hash<XsdCalendarValueInfo> fields = parse(builtin, value, error);
        # Native dates always carry a timezone and have signed-int calendar components.
        # Partial calendar values and dates outside that lossless contract retain XML text.
        if (builtin != "date" || !exists fields.offset
                || XsdIntegerLexicalHelper::compare(fields.year, "-2147483648") < 0
                || XsdIntegerLexicalHelper::compare(fields.year, "2147483647") > 0) {
            return fields.lexical;
        }
        TimeZone zone(fields.offset * 60);
        return zone.date(fields.lexical);
    }
}

#! provider preserving calendar timezone absence and extended years
/** Explicitly zoned dates within the native calendar range return native dates.
    Other dates and partial calendars return validated XML strings. Absent XML timezones
    are retained and never acquire the program's timezone.
    @par Example
    The date \c "2026-09-09" remains a string; \c "2026-09-09+05:30" returns a date with that offset.
    @since %WSDL 0.5.8
*/
public class XsdCalendarDataType inherits AbstractDataProviderType {
    private {
        string datatype;
        bool optional;
    }

    #! constructs a calendar type with explicit requiredness
    /** @param datatype the calendar builtin local name
        @param optional whether NOTHING is accepted
        @throw WSDL-ERROR the name is not a calendar builtin
    */
    constructor(string datatype, bool optional = False) {
        if (!XsdCalendarLexicalHelper::isType(datatype)) {
            throw WSDL_ERROR, sprintf("unknown calendar builtin %Y", datatype);
        }
        self.datatype = datatype;
        self.optional = optional;
    }

    private:internal deserializeMembers(hash<auto> members) {
        if (members.datatype.typeCode() != NT_STRING || !XsdCalendarLexicalHelper::isType(members.datatype)
                || members.optional.typeCode() != NT_BOOLEAN) {
            throw "DESERIALIZATION-ERROR", "calendar provider requires a builtin name and boolean requiredness";
        }
        datatype = members.datatype;
        optional = members.optional;
    }

    #! returns the XSD builtin underlying this calendar provider
    /** @return the calendar builtin local name
        @since %WSDL 0.5.8
    */
    string getBuiltinName() {
        return datatype;
    }

    #! returns the provider type name
    /** @return XSD builtin name with an optionality prefix */
    string getName() {
        return (optional ? "*" : "") + "xsd:" + datatype;
    }

    #! keeps input conversion in the XML calendar validator
    /** @return NOTHING; a native soft type would convert strings before lexical/range validation */
    *Type getValueType() {
    }

    #! returns the output category
    /** @return NT_ALL for date/string output; NT_STRING for partial calendars */
    int getBaseTypeCode() {
        return datatype == "date" ? NT_ALL : NT_STRING;
    }

    #! returns the native output category name
    /** @return all for date/string output; string for partial calendars */
    string getBaseTypeName() {
        return datatype == "date" ? "all" : "string";
    }

    #! returns NOTHING because a calendar scalar has no element type
    /** @return NOTHING */
    *AbstractDataProviderType getElementType() {
    }

    #! returns NOTHING because a calendar scalar has no fields
    /** @return NOTHING */
    *hash<string, AbstractDataField> getFields() {
    }

    #! requires validation even for native dates
    /** @return an empty map; calendar and timezone validation must not be bypassed */
    *hash<string, bool> getDirectTypeHash() {
        return {};
    }

    #! returns accepted scalar type names
    /** @param simple request simplified names
        @return string/date, plus nothing for optional types
    */
    hash<string, bool> getAcceptTypeHash(*bool simple) {
        hash<string, bool> rv = {"string": True, "date": True};
        if (optional) {
            rv.nothing = True;
        }
        return rv;
    }

    #! returns the exact output alternatives
    /** @param simple request simplified names
        @return string, date for complete dates, and nothing for optional types
    */
    hash<string, bool> getReturnTypeHash(*bool simple) {
        hash<string, bool> rv = {"string": True};
        if (datatype == "date") {
            rv.date = True;
        }
        if (optional) {
            rv.nothing = True;
        }
        return rv;
    }

    #! validates XML calendar input before choosing a lossless representation
    /** @param value an absolute native date or XML calendar lexical string
        @return a native date when lossless, otherwise XML text; NOTHING for an omitted optional value
        @throw MISSING-VALUE-ERROR a mandatory value is absent
        @throw RUNTIME-TYPE-ERROR invalid lexical syntax or an unsupported native input category
    */
    auto acceptsValue(auto value) {
        if (!exists value) {
            if (optional) {
                return;
            }
            throw "MISSING-VALUE-ERROR", sprintf("calendar value %Y must be supplied", datatype);
        }
        return XsdCalendarLexicalHelper::decode(datatype, value, "RUNTIME-TYPE-ERROR");
    }

    #! returns whether a value is required
    /** @return True for mandatory types */
    bool isMandatory() {
        return !optional;
    }

    #! returns whether a value can be omitted
    /** @return True for optional types */
    bool isOrNothingType() {
        return optional;
    }

    #! returns the optional equivalent
    /** @return an optional calendar provider with the same builtin constraints */
    AbstractDataProviderType getOrNothingType() {
        if (optional) {
            return self;
        }
        XsdCalendarDataType rv = self.copy();
        rv.optional = True;
        return rv;
    }

    #! returns the mandatory equivalent
    /** @return a mandatory calendar provider with the same builtin constraints */
    AbstractDataProviderType getMandatoryType() {
        if (!optional) {
            return self;
        }
        XsdCalendarDataType rv = self.copy();
        rv.optional = False;
        return rv;
    }
}

#! provider type that preserves XML decimal values and lexical forms
/** Common canonical decimal spellings retain native float output when the float's round-trip spelling
    reproduces them exactly. Other values remain strings, including high-precision decimals and spellings
    such as \c +001.2300. Native float/number input uses the shortest significand that reconstructs the native
    binary value at its original precision; XML decimal text is never rounded.

    @par Example
    The invoice amount \c "12345678901234567890.123456789" remains a string through provider conversion.
    A native float amount of 123.45 produces the decimal text \c "123.45".
    @since %WSDL 0.5.8
*/
public class XsdDecimalDataType inherits AbstractDataProviderType {
    private {
        bool optional;
    }

    #! constructs a decimal provider
    /** @param optional whether an omitted value is accepted */
    constructor(bool optional = False) {
        self.optional = optional;
    }

    private:internal deserializeMembers(hash<auto> members) {
        if (members.optional.typeCode() != NT_BOOLEAN) {
            throw "DESERIALIZATION-ERROR", "decimal provider requires boolean requiredness";
        }
        optional = members.optional;
    }

    #! returns the XSD builtin underlying this numeric provider
    /** @return the builtin local name, retaining the IEEE precision when applicable
        @since %WSDL 0.5.8
    */
    string getBuiltinName() {
        return "decimal";
    }

    #! returns the provider name
    /** @return xsd:decimal with an optionality prefix when applicable */
    string getName() {
        return (optional ? "*" : "") + "xsd:decimal";
    }

    #! prevents enclosing lists from converting decimal text before validation
    /** @return NOTHING */
    *Type getValueType() {
    }

    #! returns the mixed output category
    /** @return NT_ALL for float/string output */
    int getBaseTypeCode() {
        return NT_ALL;
    }

    #! returns the mixed output category name
    /** @return all */
    string getBaseTypeName() {
        return "all";
    }

    #! returns the element type
    /** @return NOTHING; decimal is atomic */
    *AbstractDataProviderType getElementType() {
    }

    #! returns record fields
    /** @return NOTHING; decimal is atomic */
    *hash<string, AbstractDataField> getFields() {
    }

    #! requires validation of all native inputs
    /** @return an empty map */
    *hash<string, bool> getDirectTypeHash() {
        return {};
    }

    #! returns accepted input categories
    /** @param simple request simplified names
        @return string/int/float/number and nothing for optional types
    */
    hash<string, bool> getAcceptTypeHash(*bool simple) {
        hash<string, bool> result = {"string": True, "int": True, "float": True, "number": True};
        if (optional) {
            result.nothing = True;
        }
        return result;
    }

    #! returns output categories
    /** @param simple request simplified names
        @return float/string and nothing for optional types
    */
    hash<string, bool> getReturnTypeHash(*bool simple) {
        hash<string, bool> result = {"float": True, "string": True};
        if (optional) {
            result.nothing = True;
        }
        return result;
    }

    #! validates decimal input before choosing a lossless representation
    /** @param value decimal text or a finite native numeric value
        @return a float or exact string; NOTHING for an omitted optional value
        @throw MISSING-VALUE-ERROR a required value is omitted
        @throw RUNTIME-TYPE-ERROR invalid decimal syntax or native type/value
    */
    auto acceptsValue(auto value) {
        if (!exists value) {
            if (optional) {
                return;
            }
            throw "MISSING-VALUE-ERROR", "a decimal value must be supplied";
        }
        return XsdDecimalLexicalHelper::decode(XsdDecimalLexicalHelper::lexical(value, "RUNTIME-TYPE-ERROR"));
    }

    #! returns whether a value is required
    /** @return True for mandatory types */
    bool isMandatory() {
        return !optional;
    }

    #! returns whether a value can be omitted
    /** @return True for optional types */
    bool isOrNothingType() {
        return optional;
    }

    #! returns the optional equivalent
    /** @return an optional decimal provider */
    AbstractDataProviderType getOrNothingType() {
        if (optional) {
            return self;
        }
        XsdDecimalDataType result = self.copy();
        result.optional = True;
        return result;
    }

    #! returns the mandatory equivalent
    /** @return a mandatory decimal provider */
    AbstractDataProviderType getMandatoryType() {
        if (!optional) {
            return self;
        }
        XsdDecimalDataType result = self.copy();
        result.optional = False;
        return result;
    }
}

#! exact nonnegative facet count, using a string beyond the native integer range
/** Counts are canonical integers: native int when representable, otherwise a decimal string. totalDigits
    requires a positive count; fractionDigits permits zero. No count is clamped to a machine limit.
    @since %WSDL 0.5.8
*/
public typedef XsdFacetCount = union<int, string>;

# XSD 1.0 Part 2 explicitly references XML 1.0 Second Edition productions
# 4/5/7 and Appendix B. Keep these datatype character classes independent of
# the XML parser's newer name rules. Numeric ranges are from the normative
# https://www.w3.org/TR/2000/REC-xml-20001006#CharClasses productions 85-89.
class XsdNameLexicalHelper {
    const NCNameStartChars = '_\x{41}-\x{5A}\x{61}-\x{7A}\x{C0}-\x{D6}\x{D8}-\x{F6}\x{F8}-\x{FF}\x{100}-\x{131}\x{134}-\x{13E}'
        + '\x{141}-\x{148}\x{14A}-\x{17E}\x{180}-\x{1C3}\x{1CD}-\x{1F0}\x{1F4}-\x{1F5}\x{1FA}-\x{217}'
        + '\x{250}-\x{2A8}\x{2BB}-\x{2C1}\x{386}\x{388}-\x{38A}\x{38C}\x{38E}-\x{3A1}\x{3A3}-\x{3CE}'
        + '\x{3D0}-\x{3D6}\x{3DA}\x{3DC}\x{3DE}\x{3E0}\x{3E2}-\x{3F3}\x{401}-\x{40C}\x{40E}-\x{44F}'
        + '\x{451}-\x{45C}\x{45E}-\x{481}\x{490}-\x{4C4}\x{4C7}-\x{4C8}\x{4CB}-\x{4CC}\x{4D0}-\x{4EB}'
        + '\x{4EE}-\x{4F5}\x{4F8}-\x{4F9}\x{531}-\x{556}\x{559}\x{561}-\x{586}\x{5D0}-\x{5EA}'
        + '\x{5F0}-\x{5F2}\x{621}-\x{63A}\x{641}-\x{64A}\x{671}-\x{6B7}\x{6BA}-\x{6BE}\x{6C0}-\x{6CE}'
        + '\x{6D0}-\x{6D3}\x{6D5}\x{6E5}-\x{6E6}\x{905}-\x{939}\x{93D}\x{958}-\x{961}\x{985}-\x{98C}'
        + '\x{98F}-\x{990}\x{993}-\x{9A8}\x{9AA}-\x{9B0}\x{9B2}\x{9B6}-\x{9B9}\x{9DC}-\x{9DD}'
        + '\x{9DF}-\x{9E1}\x{9F0}-\x{9F1}\x{A05}-\x{A0A}\x{A0F}-\x{A10}\x{A13}-\x{A28}\x{A2A}-\x{A30}'
        + '\x{A32}-\x{A33}\x{A35}-\x{A36}\x{A38}-\x{A39}\x{A59}-\x{A5C}\x{A5E}\x{A72}-\x{A74}'
        + '\x{A85}-\x{A8B}\x{A8D}\x{A8F}-\x{A91}\x{A93}-\x{AA8}\x{AAA}-\x{AB0}\x{AB2}-\x{AB3}'
        + '\x{AB5}-\x{AB9}\x{ABD}\x{AE0}\x{B05}-\x{B0C}\x{B0F}-\x{B10}\x{B13}-\x{B28}\x{B2A}-\x{B30}'
        + '\x{B32}-\x{B33}\x{B36}-\x{B39}\x{B3D}\x{B5C}-\x{B5D}\x{B5F}-\x{B61}\x{B85}-\x{B8A}'
        + '\x{B8E}-\x{B90}\x{B92}-\x{B95}\x{B99}-\x{B9A}\x{B9C}\x{B9E}-\x{B9F}\x{BA3}-\x{BA4}'
        + '\x{BA8}-\x{BAA}\x{BAE}-\x{BB5}\x{BB7}-\x{BB9}\x{C05}-\x{C0C}\x{C0E}-\x{C10}\x{C12}-\x{C28}'
        + '\x{C2A}-\x{C33}\x{C35}-\x{C39}\x{C60}-\x{C61}\x{C85}-\x{C8C}\x{C8E}-\x{C90}\x{C92}-\x{CA8}'
        + '\x{CAA}-\x{CB3}\x{CB5}-\x{CB9}\x{CDE}\x{CE0}-\x{CE1}\x{D05}-\x{D0C}\x{D0E}-\x{D10}'
        + '\x{D12}-\x{D28}\x{D2A}-\x{D39}\x{D60}-\x{D61}\x{E01}-\x{E2E}\x{E30}\x{E32}-\x{E33}'
        + '\x{E40}-\x{E45}\x{E81}-\x{E82}\x{E84}\x{E87}-\x{E88}\x{E8A}\x{E8D}\x{E94}-\x{E97}\x{E99}-\x{E9F}'
        + '\x{EA1}-\x{EA3}\x{EA5}\x{EA7}\x{EAA}-\x{EAB}\x{EAD}-\x{EAE}\x{EB0}\x{EB2}-\x{EB3}\x{EBD}'
        + '\x{EC0}-\x{EC4}\x{F40}-\x{F47}\x{F49}-\x{F69}\x{10A0}-\x{10C5}\x{10D0}-\x{10F6}\x{1100}'
        + '\x{1102}-\x{1103}\x{1105}-\x{1107}\x{1109}\x{110B}-\x{110C}\x{110E}-\x{1112}\x{113C}\x{113E}'
        + '\x{1140}\x{114C}\x{114E}\x{1150}\x{1154}-\x{1155}\x{1159}\x{115F}-\x{1161}\x{1163}\x{1165}'
        + '\x{1167}\x{1169}\x{116D}-\x{116E}\x{1172}-\x{1173}\x{1175}\x{119E}\x{11A8}\x{11AB}'
        + '\x{11AE}-\x{11AF}\x{11B7}-\x{11B8}\x{11BA}\x{11BC}-\x{11C2}\x{11EB}\x{11F0}\x{11F9}'
        + '\x{1E00}-\x{1E9B}\x{1EA0}-\x{1EF9}\x{1F00}-\x{1F15}\x{1F18}-\x{1F1D}\x{1F20}-\x{1F45}'
        + '\x{1F48}-\x{1F4D}\x{1F50}-\x{1F57}\x{1F59}\x{1F5B}\x{1F5D}\x{1F5F}-\x{1F7D}\x{1F80}-\x{1FB4}'
        + '\x{1FB6}-\x{1FBC}\x{1FBE}\x{1FC2}-\x{1FC4}\x{1FC6}-\x{1FCC}\x{1FD0}-\x{1FD3}\x{1FD6}-\x{1FDB}'
        + '\x{1FE0}-\x{1FEC}\x{1FF2}-\x{1FF4}\x{1FF6}-\x{1FFC}\x{2126}\x{212A}-\x{212B}\x{212E}'
        + '\x{2180}-\x{2182}\x{3041}-\x{3094}\x{30A1}-\x{30FA}\x{3105}-\x{312C}\x{AC00}-\x{D7A3}'
        + '\x{4E00}-\x{9FA5}\x{3007}\x{3021}-\x{3029}';
    const AdditionalNameChars = '\-.\x{30}-\x{39}\x{660}-\x{669}\x{6F0}-\x{6F9}\x{966}-\x{96F}\x{9E6}-\x{9EF}\x{A66}-\x{A6F}'
        + '\x{AE6}-\x{AEF}\x{B66}-\x{B6F}\x{BE7}-\x{BEF}\x{C66}-\x{C6F}\x{CE6}-\x{CEF}\x{D66}-\x{D6F}'
        + '\x{E50}-\x{E59}\x{ED0}-\x{ED9}\x{F20}-\x{F29}\x{300}-\x{345}\x{360}-\x{361}\x{483}-\x{486}'
        + '\x{591}-\x{5A1}\x{5A3}-\x{5B9}\x{5BB}-\x{5BD}\x{5BF}\x{5C1}-\x{5C2}\x{5C4}\x{64B}-\x{652}\x{670}'
        + '\x{6D6}-\x{6DC}\x{6DD}-\x{6DF}\x{6E0}-\x{6E4}\x{6E7}-\x{6E8}\x{6EA}-\x{6ED}\x{901}-\x{903}'
        + '\x{93C}\x{93E}-\x{94C}\x{94D}\x{951}-\x{954}\x{962}-\x{963}\x{981}-\x{983}\x{9BC}\x{9BE}\x{9BF}'
        + '\x{9C0}-\x{9C4}\x{9C7}-\x{9C8}\x{9CB}-\x{9CD}\x{9D7}\x{9E2}-\x{9E3}\x{A02}\x{A3C}\x{A3E}\x{A3F}'
        + '\x{A40}-\x{A42}\x{A47}-\x{A48}\x{A4B}-\x{A4D}\x{A70}-\x{A71}\x{A81}-\x{A83}\x{ABC}'
        + '\x{ABE}-\x{AC5}\x{AC7}-\x{AC9}\x{ACB}-\x{ACD}\x{B01}-\x{B03}\x{B3C}\x{B3E}-\x{B43}'
        + '\x{B47}-\x{B48}\x{B4B}-\x{B4D}\x{B56}-\x{B57}\x{B82}-\x{B83}\x{BBE}-\x{BC2}\x{BC6}-\x{BC8}'
        + '\x{BCA}-\x{BCD}\x{BD7}\x{C01}-\x{C03}\x{C3E}-\x{C44}\x{C46}-\x{C48}\x{C4A}-\x{C4D}'
        + '\x{C55}-\x{C56}\x{C82}-\x{C83}\x{CBE}-\x{CC4}\x{CC6}-\x{CC8}\x{CCA}-\x{CCD}\x{CD5}-\x{CD6}'
        + '\x{D02}-\x{D03}\x{D3E}-\x{D43}\x{D46}-\x{D48}\x{D4A}-\x{D4D}\x{D57}\x{E31}\x{E34}-\x{E3A}'
        + '\x{E47}-\x{E4E}\x{EB1}\x{EB4}-\x{EB9}\x{EBB}-\x{EBC}\x{EC8}-\x{ECD}\x{F18}-\x{F19}\x{F35}\x{F37}'
        + '\x{F39}\x{F3E}\x{F3F}\x{F71}-\x{F84}\x{F86}-\x{F8B}\x{F90}-\x{F95}\x{F97}\x{F99}-\x{FAD}'
        + '\x{FB1}-\x{FB7}\x{FB9}\x{20D0}-\x{20DC}\x{20E1}\x{302A}-\x{302F}\x{3099}\x{309A}\x{B7}\x{2D0}'
        + '\x{2D1}\x{387}\x{640}\x{E46}\x{EC6}\x{3005}\x{3031}-\x{3035}\x{309D}-\x{309E}\x{30FC}-\x{30FE}';
    const NameStartChars = ":" + NCNameStartChars;
    const NCNameChars = NCNameStartChars + AdditionalNameChars;
    const NameChars = ":" + NCNameChars;
    const NamePattern = '\A[' + NameStartChars + '][' + NameChars + ']*\z';
    const NCNamePattern = '\A[' + NCNameStartChars + '][' + NCNameChars + ']*\z';
    const QNamePattern = '\A(?:[' + NCNameStartChars + '][' + NCNameChars + ']*:)?['
        + NCNameStartChars + '][' + NCNameChars + ']*\z';
    const NmtokenPattern = '\A[' + NameChars + ']+\z';

    static bool isType(string name) {
        return name == "Name" || name == "NCName" || name == "QName" || name == "NMTOKEN"
            || name == "ID" || name == "IDREF" || name == "ENTITY";
    }

    static string lexical(string name, auto value, string error) {
        if (!exists value || !value.strp()) {
            throw error, sprintf("name type %Y requires a string-convertible value", name);
        }
        string text = XsdSimpleType::normalizeWhiteSpace(string(value), "collapse");
        string pattern = name == "QName" ? QNamePattern
            : name == "NMTOKEN" ? NmtokenPattern : name == "Name" ? NamePattern : NCNamePattern;
        if (!XsdPatternConstraintHelper::matches(text, pattern)) {
            throw error, sprintf("value %Y is not in the lexical space of xs:%s", text, name);
        }
        return text;
    }
}

#! an immutable QName value retaining namespace identity and XML spelling
/** A prefix is a lexical alias; the namespace URI and local name identify the value.
    The original normalized text is retained for pattern restrictions.
    @note This explicit value API does not yet replace ordinary WSDL scalar conversion or allocate XML prefixes.
    @par Example
    \c XsdQNameValue("urn:catalog", "c:Product") identifies Product in the catalog namespace.
    @since %WSDL 0.5.8
*/
public final class XsdQNameValue inherits Serializable {
    private {
        string namespace_uri;
        string lexical;
        transient string local;
        transient string prefix;
    }

    #! constructs a QName with an explicit namespace identity
    /** @param namespace_uri the namespace URI, or an empty string for no namespace
        @param lexical QName text, normalized with the collapse whitespace rule
        @throw XSD-QNAME-VALUE-ERROR malformed text or an impossible reserved namespace binding
    */
    constructor(string namespace_uri, string lexical) {
        initialize(namespace_uri, lexical, "XSD-QNAME-VALUE-ERROR");
    }

    private initialize(string namespace_uri, string lexical, string error) {
        string text = XsdNameLexicalHelper::lexical("QName", lexical, error);
        list<string> parts = text.split(":");
        string pfx = parts.size() == 2 ? parts[0] : "";
        string xml_uri = "http://www.w3.org/XML/1998/namespace";
        if ((pfx && !namespace_uri) || pfx == "xmlns"
                || namespace_uri == "http://www.w3.org/2000/xmlns/"
                || ((pfx == "xml") != (namespace_uri == xml_uri))) {
            throw error, sprintf("QName %Y cannot bind prefix %Y to namespace %Y", text, pfx, namespace_uri);
        }
        if (namespace_uri =~ /[^\x{9}\x{A}\x{D}\x{20}-\x{D7FF}\x{E000}-\x{FFFD}\x{10000}-\x{10FFFF}]/) {
            throw error, "a QName namespace URI must contain XML 1.0 characters";
        }
        self.namespace_uri = namespace_uri;
        self.lexical = text;
        local = parts[-1];
        prefix = pfx;
    }

    private:internal deserializeMembers(hash<auto> members) {
        if (members.namespace_uri.typeCode() != NT_STRING || members.lexical.typeCode() != NT_STRING) {
            throw "DESERIALIZATION-ERROR", "a QName value requires namespace URI and lexical strings";
        }
        initialize(members.namespace_uri, members.lexical, "DESERIALIZATION-ERROR");
    }

    #! resolves QName text using explicit XML namespace bindings
    /** @param lexical QName text
        @param namespaces prefix-to-URI mappings, with the default namespace under an empty key
        @return a value with the resolved namespace identity and normalized text
        @throw XSD-QNAME-VALUE-ERROR invalid text, namespace declarations or an unbound prefix
    */
    static XsdQNameValue fromLexical(string lexical, hash<string, string> namespaces) {
        hash<string, string> checked = XsdQNameValueHelper::bindings(namespaces, "XSD-QNAME-VALUE-ERROR");
        return XsdQNameValueHelper::resolve(lexical, "XSD-QNAME-VALUE-ERROR", checked);
    }

    #! returns the namespace URI independently of prefix spelling
    /** @return the namespace URI, or an empty string for no namespace */
    string getNamespaceUri() {
        return namespace_uri;
    }

    #! returns the local name
    /** @return the validated NCName local part */
    string getLocalName() {
        return local;
    }

    #! returns the normalized XML spelling
    /** @return the retained QName text */
    string getLexicalValue() {
        return lexical;
    }

    #! returns the retained lexical prefix
    /** @return the prefix, or an empty string for an unprefixed QName */
    string getPrefix() {
        return prefix;
    }

    #! compares namespace and local name without comparing aliases
    /** @param other the QName to compare
        @return True when both namespace URI and local name are equal
    */
    bool equals(XsdQNameValue other) {
        return namespace_uri == other.namespace_uri && local == other.local;
    }
}

class XsdQNameValueHelper {
    static hash<string, string> bindings(auto input, string error) {
        if (input.typeCode() != NT_HASH) {
            throw error, "QName namespace bindings must be a hash";
        }
        hash<auto> attributes();
        foreach string prefix in (keys input) {
            if (input{prefix}.typeCode() != NT_STRING) {
                throw error, "QName namespace URIs must be strings";
            }
            if (input{prefix} =~ /[^\x{9}\x{A}\x{D}\x{20}-\x{D7FF}\x{E000}-\x{FFFD}\x{10000}-\x{10FFFF}]/) {
                throw error, "QName namespace URIs must contain XML 1.0 characters";
            }
            attributes{prefix ? "xmlns:" + prefix : "xmlns"} = input{prefix};
        }
        try {
            return XsdBase::getElementNamespaces(attributes);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != SOAP_DESERIALIZATION_ERROR) {
                rethrow;
            }
            throw error, ex.desc;
        }
    }

    static XsdQNameValue resolve(auto value, string error, *hash<string, string> bindings) {
        if (value instanceof XsdQNameValue) {
            return value;
        }
        string lexical = XsdNameLexicalHelper::lexical("QName", value, error);
        list<string> parts = lexical.split(":");
        string prefix = parts.size() == 2 ? parts[0] : "";
        *string uri = prefix == "xml" ? "http://www.w3.org/XML/1998/namespace" : bindings{prefix};
        if (prefix && !uri) {
            throw error, sprintf("unbound QName prefix %Y", prefix);
        }
        try {
            return new XsdQNameValue(uri ?? "", lexical);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "XSD-QNAME-VALUE-ERROR") {
                rethrow;
            }
            throw error, ex.desc;
        }
    }

    static auto native(XsdQNameValue value) {
        return !value.getNamespaceUri() || value.getNamespaceUri() == "http://www.w3.org/XML/1998/namespace"
            ? value.getLexicalValue() : value;
    }
}

#! provider converting QName text with an explicit namespace context
/** Namespace-qualified text returns immutable XsdQNameValue objects. No-namespace text and the implicit
    xml prefix retain their string representation. Existing XsdQNameValue inputs retain their object representation.
    @note Construct this provider with the namespace context of its lexical input. Ordinary WSDL schema
    providers continue to use their existing conversion path until scoped QName conversion is integrated.
    @par Example
    A catalog field constructed with \c {"c": "urn:catalog"} converts \c "c:Product" to its namespace/local value.
    @since %WSDL 0.5.8
*/
public class XsdQNameDataType inherits AbstractDataProviderType {
    private {
        hash<string, string> namespaces;
        bool optional;
    }

    #! constructs a QName provider with explicit lexical bindings
    /** @param namespaces prefix-to-URI bindings; the empty key denotes the default namespace
        @param optional whether omission is accepted
        @throw XSD-SIMPLETYPE-ERROR invalid namespace bindings
    */
    constructor(hash<string, string> namespaces = {}, bool optional = False) {
        self.namespaces = XsdQNameValueHelper::bindings(namespaces, "XSD-SIMPLETYPE-ERROR");
        self.optional = optional;
    }

    private:internal deserializeMembers(hash<auto> members) {
        if (members.optional.typeCode() != NT_BOOLEAN) {
            throw "DESERIALIZATION-ERROR", "a QName provider requires boolean optionality";
        }
        hash<string, string> checked = XsdQNameValueHelper::bindings(members.namespaces, "DESERIALIZATION-ERROR");
        namespaces = checked;
        optional = members.optional;
    }

    #! returns the provider name
    /** @return xsd:QName with an optionality prefix when applicable */
    string getName() {
        return (optional ? "*" : "") + "xsd:QName";
    }

    #! returns the builtin name
    /** @return QName */
    string getBuiltinName() {
        return "QName";
    }

    #! returns a copy of the lexical namespace bindings
    /** @return prefix-to-URI bindings, including the implicit xml prefix */
    hash<string, string> getNamespaceBindings() {
        return namespaces;
    }

    #! requires validation by enclosing providers
    /** @return NOTHING */
    *Type getValueType() {
    }

    #! returns the closest legacy scalar category
    /** @return NT_STRING; getReturnTypeHash also advertises retained QName objects */
    int getBaseTypeCode() {
        return NT_STRING;
    }

    #! returns the closest legacy scalar category name
    /** @return string */
    string getBaseTypeName() {
        return "string";
    }

    #! returns no item type for an atomic QName
    /** @return NOTHING */
    *AbstractDataProviderType getElementType() {
    }

    #! returns no record fields for an atomic QName
    /** @return NOTHING */
    *hash<string, AbstractDataField> getFields() {
    }

    #! requires validation of every supplied value
    /** @return an empty map */
    *hash<string, bool> getDirectTypeHash() {
        return {};
    }

    #! reports accepted native input categories
    /** @param simple request simplified names
        @return string-convertible scalar categories and retained QName objects, plus optional omission
    */
    hash<string, bool> getAcceptTypeHash(*bool simple) {
        hash<string, bool> result = AbstractDataProviderType::get(SoftStringType).getAcceptTypeHash(simple);
        result.object = True;
        if (optional) {
            result.nothing = True;
        }
        return result;
    }

    #! reports returned native categories
    /** @param simple request simplified names
        @return string and object, plus nothing for optional providers
    */
    hash<string, bool> getReturnTypeHash(*bool simple) {
        hash<string, bool> result = {"string": True, "object": True};
        if (optional) {
            result.nothing = True;
        }
        return result;
    }

    #! resolves and converts a QName value
    /** @param value lexical QName text, a string-convertible scalar or an XsdQNameValue
        @return a retained QName object, an unambiguous native string or optional omission
        @throw MISSING-VALUE-ERROR a required value is absent
        @throw RUNTIME-TYPE-ERROR invalid QName text, an unbound prefix or an unsupported native category
    */
    auto acceptsValue(auto value) {
        if (!exists value) {
            if (optional) {
                return;
            }
            throw "MISSING-VALUE-ERROR", "a QName value must be supplied";
        }
        if (value instanceof XsdQNameValue) {
            # An explicit no-namespace value must not become lexical text that a later
            # conversion could reinterpret under a provider's default namespace.
            return value;
        }
        return XsdQNameValueHelper::native(XsdQNameValueHelper::resolve(value, "RUNTIME-TYPE-ERROR", namespaces));
    }

    #! returns whether a value is required
    /** @return True for mandatory providers */
    bool isMandatory() {
        return !optional;
    }

    #! returns whether omission is accepted
    /** @return True for optional providers */
    bool isOrNothingType() {
        return optional;
    }

    #! creates an optional equivalent with the same namespace bindings
    /** @return the optional provider */
    AbstractDataProviderType getOrNothingType() {
        XsdQNameDataType result = self.copy();
        result.optional = True;
        return result;
    }

    #! creates a mandatory equivalent with the same namespace bindings
    /** @return the mandatory provider */
    AbstractDataProviderType getMandatoryType() {
        XsdQNameDataType result = self.copy();
        result.optional = False;
        return result;
    }
}

class XsdBuiltinListHelper {
    static bool isType(string name) {
        return name == "NMTOKENS" || name == "IDREFS" || name == "ENTITIES";
    }

    static string lexical(string name, auto value, string error) {
        if (exists value && !value.strp()) {
            throw error, sprintf("builtin list %Y requires a value convertible to text", name);
        }
        string text = XsdSimpleType::normalizeWhiteSpace(string(value), "collapse");
        if (text.empty()) {
            throw error, sprintf("builtin list %Y requires at least one item", name);
        }
        foreach string item in (text.split(" ")) {
            string checked = XsdNameLexicalHelper::lexical(name == "NMTOKENS" ? "NMTOKEN"
                : name == "IDREFS" ? "IDREF" : "ENTITY", item, error);
        }
        return text;
    }
}

class XsdFacetCountHelper {
    static XsdFacetCount parse(string name, auto value, string error = "XSD-SIMPLETYPE-ERROR") {
        string lexical = XsdIntegerLexicalHelper::lexical(name == "totalDigits" ? "positiveInteger"
            : "nonNegativeInteger", value, error);
        return XsdIntegerLexicalHelper::decode("integer", XsdIntegerLexicalHelper::canonical(lexical));
    }

    static int compare(XsdFacetCount left, XsdFacetCount right) {
        return XsdIntegerLexicalHelper::compare(
            XsdIntegerLexicalHelper::canonical(XsdSimpleType::normalizeWhiteSpace(string(left), "collapse")),
            XsdIntegerLexicalHelper::canonical(XsdSimpleType::normalizeWhiteSpace(string(right), "collapse")));
    }
}

#! resolved scalar data used to reconstruct a numeric restriction provider
/** The schema constructs this value without retaining transient namespace or component references.
    @since %WSDL 0.5.8
*/
public hashdecl XsdNumericFacetInfo {
    #! diagnostic name of the restricted type
    string name;
    #! decimal, an integer builtin, float or double from which the type is derived
    string base_name;
    #! compiled pattern alternatives for this derivation step
    *list<XsdPatternConstraint> patterns;
    #! numeric enumeration values as validated XML text
    *list<string> enumeration;
    #! inclusive/exclusive bounds as validated XML text
    hash<string, string> bounds;
    #! maximum decimal digits in the value
    *XsdFacetCount total_digits;
    #! maximum fractional decimal digits in the value
    *XsdFacetCount fraction_digits;
}

#! resolved atomic or union item conversion for an XSD list
/** The provider retains item restrictions without schema namespace references.
    @since %WSDL 0.5.8
*/
public hashdecl XsdListItemInfo {
    #! underlying atomic builtin, absent when each item selects a union member
    *string builtin;
    #! whether the item provider selects an atomic union member
    bool union_item = False;
    #! provider validating the complete item restriction
    AbstractDataProviderType provider;
    #! the atomic item's whitespace rule, or collapse for a list of union items
    string white_space;
}

hashdecl XsdListConversionInfo {
    list<auto> values();
    list<string> tokens();
    *hash<XsdUnionValueIdentity> identity;
}

class XsdListValueHelper {
    const TextTypes = {"string": True, "normalizedString": True, "token": True, "language": True,
        "Name": True, "NCName": True, "NMTOKEN": True, "ID": True, "IDREF": True, "ENTITY": True,
        "anyURI": True};

    static bool supports(string builtin) {
        return builtin == "boolean" || builtin == "duration" || XsdNumericFacetHelper::isType(builtin)
            || XsdBinaryLexicalHelper::isType(builtin) || XsdCalendarLexicalHelper::isType(builtin) || TextTypes{builtin};
    }

    static *hash<XsdListItemInfo> describe(XsdAbstractType item) {
        if (XsdUnionValueHelper::schemaUnionItem(item)) {
            return <XsdListItemInfo>{"union_item": True, "provider": item.getDataProviderType(),
                "white_space": "collapse"};
        }
        XsdAbstractType base = item;
        while (base instanceof XsdSimpleType && cast<XsdSimpleType>(base).type) {
            base = cast<XsdSimpleType>(base).type;
        }
        if (!(base instanceof XsdBaseType) || !supports(base.name)) {
            return;
        }
        return <XsdListItemInfo>{"builtin": base.name, "provider": item.getDataProviderType(),
            "white_space": item.getWhiteSpace()};
    }

    static *hash<XsdListItemInfo> describeList(XsdAbstractType schema) {
        while (schema instanceof XsdSimpleType) {
            XsdSimpleType simple = cast<XsdSimpleType>(schema);
            if (simple.listItemType) {
                return describe(simple.listItemType);
            }
            if (!simple.type) {
                return;
            }
            schema = simple.type;
        }
    }

    static check(hash<XsdListItemInfo> item, string error) {
        if (item.union_item) {
            if (exists item.builtin || !(item.provider instanceof UnionDataType)
                    || !item.provider.isMandatory() || item.white_space != "collapse") {
                throw error, "a union list item requires a mandatory union provider and collapsed list whitespace";
            }
            return;
        }
        if (!exists item.builtin || !supports(item.builtin)) {
            throw error, sprintf("invalid atomic list item metadata %Y", item.builtin);
        }
        if (item.white_space != "preserve" && item.white_space != "replace" && item.white_space != "collapse") {
            throw error, "invalid list item whitespace metadata";
        }
        XsdNumericFacetHelper::checkProvider(item.builtin, item.provider, error);
        XsdCalendarFacetHelper::checkProvider(item.builtin, item.provider, error);
        hash<string, bool> categories = item.provider.getReturnTypeHash(True);
        if (!item.provider.isMandatory() || !categories) {
            throw error, "an atomic list item requires a mandatory scalar provider";
        }
        foreach string category in (keys categories) {
            if (category != "string" && category != "int" && category != "number"
                    && category != "float" && category != "bool"
                    && !((category == "binary" || category == "object") && XsdBinaryLexicalHelper::isType(item.builtin))
                    && !(category == "date" && XsdCalendarLexicalHelper::isType(item.builtin))) {
                throw error, sprintf("invalid atomic list item output category %Y", category);
            }
        }
        if ((item.builtin != "string" && item.builtin != "normalizedString" && item.white_space != "collapse")
                || (item.builtin == "normalizedString" && item.white_space == "preserve")) {
            throw error, "list item whitespace metadata weakens its builtin rule";
        }
    }

    static list<string> tokens(string lexical) {
        lexical = XsdSimpleType::normalizeWhiteSpace(lexical, "collapse");
        return lexical.empty() ? () : lexical.split(" ");
    }

    static hash<XsdListConversionInfo> convert(hash<XsdListItemInfo> item, auto value, string error) {
        if (value.typeCode() != NT_LIST) {
            throw error, sprintf("an XSD list requires a native item list; got %Y", value.type());
        }
        if (item.union_item) {
            return convertUnion(new ListDataType(item.provider), value, error);
        }
        hash<XsdListConversionInfo> result();
        Namespaces namespaces({});
        XsdBaseType builtin = namespaces.getBaseType(item.builtin);
        foreach auto input in (value) {
            if (!exists input) {
                throw error, "an XSD list cannot contain an omitted item";
            }
            auto converted;
            string lexical;
            try {
                converted = item.provider.acceptsValue(input);
                if (input.typeCode() == NT_STRING) {
                    lexical = XsdSimpleType::normalizeWhiteSpace(input, item.white_space);
                    builtin.deserializeValue("item", new hash<string, XsdAbstractType>(), NOTHING, lexical);
                } else {
                    lexical = string(builtin.serializeValue(namespaces, converted, True));
                }
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "RUNTIME-TYPE-ERROR" && ex.err != "MISSING-VALUE-ERROR"
                        && ex.err != SOAP_SERIALIZATION_ERROR && ex.err != SOAP_DESERIALIZATION_ERROR) {
                    rethrow;
                }
                throw error, sprintf("invalid list item: %s", ex.desc);
            }
            checkToken(lexical, error);
            push result.values, converted;
            push result.tokens, lexical;
        }
        return result;
    }

    # Capture the actual base conversion once, including inherited restrictions.
    # Nested list wrappers reuse the same item capture and read their own interval.
    static hash<XsdListConversionInfo> convertUnion(AbstractDataProviderType base, auto value, string error) {
        if (value.typeCode() != NT_LIST) {
            throw error, "an XSD list requires a native item list";
        }
        *XsdProviderUnionItemCapture caller = ProviderUnionItemCapture;
        AbstractDataProviderType target = base.getElementType();
        bool owner = !caller || caller.target !== target || caller.depth;
        on_exit if (owner) {
            ProviderUnionItemCapture = caller;
        }
        if (owner) {
            ProviderUnionItemCapture = new XsdProviderUnionItemCapture(target);
        }
        XsdProviderUnionItemCapture capture = ProviderUnionItemCapture;
        int offset = capture.items.size();
        list<auto> converted;
        try {
            converted = base.acceptsValue(value);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "RUNTIME-TYPE-ERROR" && ex.err != "MISSING-VALUE-ERROR") {
                rethrow;
            }
            throw error, ex.desc;
        }
        list<hash<XsdUnionTrialResult>> selected = value.empty() ? ()
            : capture.items[offset .. capture.items.size() - 1];
        hash<XsdUnionTrialResult> result;
        try {
            result = XsdUnionValueHelper::capturedList(selected, converted);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "RUNTIME-TYPE-ERROR") {
                rethrow;
            }
            throw error, ex.desc;
        }
        hash<XsdListConversionInfo> output = <XsdListConversionInfo>{"values": converted, "identity": result.identity};
        foreach auto input in (value) {
            *string token = input.typeCode() == NT_STRING
                ? XsdSimpleType::normalizeWhiteSpace(input, "collapse") : selected[$#].lexical;
            if (!exists input || !exists token) {
                throw error, "a union list item must have a nonempty atomic lexical value";
            }
            checkToken(token, error);
            push output.tokens, token;
        }
        return output;
    }

    static checkToken(string lexical, string error) {
        if (lexical.empty() || regex(lexical, "[ \\t\\r\\n]")) {
            throw error, "a native XSD list item cannot serialize as empty text or contain XML whitespace";
        }
    }

    static string key(hash<XsdListItemInfo> item, list<auto> values, string error) {
        hash<XsdListConversionInfo> converted = convert(item, values, error);
        if (item.union_item) {
            if (!converted.identity) {
                throw error, "cannot determine the selected primitive value of a union list item";
            }
            return XsdUnionValueHelper::key(converted.identity);
        }
        string key = "";
        foreach string token in (converted.tokens) {
            if (item.builtin == "decimal" || XsdIntegerLexicalHelper::Types{item.builtin}) {
                token = XsdDecimalLexicalHelper::canonical(token);
            } else if (item.builtin == "boolean") {
                token = XsdBooleanLexicalHelper::decode(token, error) ? "true" : "false";
            } else if (XsdBinaryLexicalHelper::isType(item.builtin)) {
                token = XsdBinaryFacetHelper::key(item.builtin, token, error);
            } else if (item.builtin == "duration") {
                token = XsdDurationValueHelper::key(token, error);
            } else if (XsdCalendarLexicalHelper::isType(item.builtin)) {
                token = XsdCalendarLexicalHelper::key(item.builtin, token, error);
            } else if (XsdIeeeLexicalHelper::isType(item.builtin)) {
                token = XsdIeeeLexicalHelper::key(item.builtin, token, error);
            }
            key += sprintf("%d:%s", token.length(), token);
        }
        return key;
    }
}

#! provider for native XSD lists with validated item boundaries
/** Each item is converted and checked before the list is returned. An empty list
    is valid; an empty string item or an item containing XML whitespace cannot be
    represented without changing the list and is rejected.
    @par Example
    A list of invoice labels accepts two separate strings and rejects a single
    string containing two SPACE-separated labels.
    @since %WSDL 0.5.8
*/
public class XsdListDataType inherits AbstractDataProviderType {
    private {
        hash<XsdListItemInfo> item;
        bool optional;
    }

    #! constructs a list provider from resolved item conversion
    /** @param item the item's builtin and validating provider
        @param optional whether the list may be omitted
        @throw XSD-SIMPLETYPE-ERROR invalid item metadata
    */
    constructor(hash<XsdListItemInfo> item, bool optional = False) {
        XsdListValueHelper::check(item, "XSD-SIMPLETYPE-ERROR");
        self.item = item;
        self.optional = optional;
    }

    private:internal deserializeMembers(hash<auto> members) {
        if (members.optional.typeCode() != NT_BOOLEAN) {
            throw "DESERIALIZATION-ERROR", "list provider requires boolean requiredness";
        }
        hash<XsdListItemInfo> resolved = new hash<XsdListItemInfo>(members.item);
        XsdListValueHelper::check(resolved, "DESERIALIZATION-ERROR");
        item = resolved;
        optional = members.optional;
    }

    #! returns the list name including item restrictions
    /** @return the optionality prefix and item provider name */
    string getName() {
        return sprintf("%slist<%s>", optional ? "*" : "", item.provider.getName());
    }

    #! returns the atomic item provider
    /** @return the provider validating each item */
    *AbstractDataProviderType getElementType() {
        return item.provider;
    }

    #! returns no record fields
    /** @return NOTHING */
    *hash<string, AbstractDataField> getFields() {
    }

    #! returns accepted native categories
    /** @param simple request simplified names
        @return list, and nothing for optional lists
    */
    hash<string, bool> getAcceptTypeHash(*bool simple) {
        return optional ? {"list": True, "nothing": True} : {"list": True};
    }

    #! returns converted native categories
    /** @param simple request simplified names
        @return list, and nothing for optional lists
    */
    hash<string, bool> getReturnTypeHash(*bool simple) {
        return getAcceptTypeHash(simple);
    }

    #! requires validation in enclosing list providers
    /** @return NOTHING */
    *Type getValueType() {
    }

    #! returns the list value category
    /** @return NT_LIST */
    int getBaseTypeCode() {
        return NT_LIST;
    }

    #! returns the list value category name
    /** @return list */
    string getBaseTypeName() {
        return "list";
    }

    #! requires validation for all values
    /** @return an empty map */
    *hash<string, bool> getDirectTypeHash() {
        return {};
    }

    #! converts the items and verifies their lexical boundaries
    /** @param value the native list
        @return the converted list, or NOTHING for optional omission
        @throw MISSING-VALUE-ERROR a required list was omitted
        @throw RUNTIME-TYPE-ERROR invalid items or item boundaries
    */
    auto acceptsValue(auto value) {
        if (!exists value) {
            if (optional) {
                return;
            }
            throw "MISSING-VALUE-ERROR", "an XSD list must be supplied";
        }
        return XsdListValueHelper::convert(item, value, "RUNTIME-TYPE-ERROR").values;
    }

    #! returns whether omission is allowed
    /** @return True for optional lists */
    bool isOrNothingType() {
        return optional;
    }

    #! returns whether a list is required
    /** @return True for mandatory lists */
    bool isMandatory() {
        return !optional;
    }

    #! creates an optional list preserving item checks
    /** @return the optional list provider */
    AbstractDataProviderType getOrNothingType() {
        return new XsdListDataType(item, True);
    }

    #! creates a mandatory list preserving item checks
    /** @return the mandatory list provider */
    AbstractDataProviderType getMandatoryType() {
        return new XsdListDataType(item);
    }
}

#! scalar metadata for character, octet, and item counts and string restrictions
/** Providers retain resolved values rather than schema namespace references.
    @since %WSDL 0.5.8
*/
public hashdecl XsdSizedFacetInfo {
    #! diagnostic name of the restricted type
    string name;
    #! category whose length is measured: string, binary, list, or tokens (a builtin list kept as text)
    string kind;
    #! whitespace processing applied before inherited string restrictions
    string white_space = "preserve";
    #! builtin XML name or builtin name-list lexical validation, if applicable
    *string name_type;
    #! compiled pattern alternatives for a string restriction
    *list<XsdPatternConstraint> patterns;
    #! enumeration values in the base string value space
    *list<string> enumeration;
    #! exact number of characters, octets, or items
    *XsdFacetCount length;
    #! minimum number of characters, octets, or items
    *XsdFacetCount min_length;
    #! maximum number of characters, octets, or items
    *XsdFacetCount max_length;
}

class XsdSizedFacetHelper {
    static checkBase(hash<XsdSizedFacetInfo> facets, AbstractDataProviderType base, string error) {
        int expected = facets.kind == "binary" ? NT_BINARY : facets.kind == "list" ? NT_LIST : NT_STRING;
        if (base.getBaseTypeCode() != expected) {
            throw error, sprintf("restriction category %Y is incompatible with base provider %Y",
                facets.kind, base.getName());
        }
    }

    static checkDefinition(hash<XsdSizedFacetInfo> facets, string error) {
        if (facets.kind != "string" && facets.kind != "binary" && facets.kind != "list" && facets.kind != "tokens") {
            throw error, sprintf("invalid sized restriction category %Y", facets.kind);
        }
        if (facets.white_space != "preserve" && facets.white_space != "replace"
                && facets.white_space != "collapse") {
            throw error, sprintf("invalid whitespace processing %Y", facets.white_space);
        }
        if (facets.kind != "string" && facets.kind != "tokens"
                && (exists facets.patterns || exists facets.enumeration)) {
            throw error, "text patterns and string choices require a text-valued restriction";
        }
        if (facets.kind == "tokens" && facets.white_space != "collapse") {
            throw error, "builtin token lists require collapse whitespace processing";
        }
        if (exists facets.name_type) {
            bool list_type = XsdBuiltinListHelper::isType(facets.name_type);
            if ((!list_type && !XsdNameLexicalHelper::isType(facets.name_type))
                    || facets.kind != (list_type ? "tokens" : "string") || facets.white_space != "collapse") {
                throw error, "invalid builtin name validation metadata";
            }
        }
        foreach string key in ("length", "min_length", "max_length") {
            if (exists facets{key}) {
                XsdFacetCount checked = XsdFacetCountHelper::parse(key, facets{key}, error);
            }
        }
        if (exists facets.min_length && exists facets.max_length
                && XsdFacetCountHelper::compare(facets.min_length, facets.max_length) > 0) {
            throw error, "minimum length exceeds maximum length";
        }
        if (exists facets.length && ((exists facets.min_length
                && XsdFacetCountHelper::compare(facets.length, facets.min_length) < 0)
                || (exists facets.max_length
                && XsdFacetCountHelper::compare(facets.length, facets.max_length) > 0))) {
            throw error, "exact length is outside the permitted interval";
        }
        foreach XsdPatternConstraint pattern in (facets.patterns) {
            try {
                bool accepts_empty = XsdPatternConstraintHelper::matches("", pattern);
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "REGEX-ERROR" && ex.err != "REGEX-COMPILATION-ERROR") {
                    rethrow;
                }
                throw error, sprintf("invalid compiled string pattern: %s", ex.desc);
            }
        }
    }

    static validate(hash<XsdSizedFacetInfo> facets, auto value, hash<string, bool> enumeration, string error) {
        int size;
        switch (facets.kind) {
            case "tokens": {
                if (value.typeCode() != NT_STRING) {
                    throw error, "a builtin token list requires a string value";
                }
                string normalized = XsdSimpleType::normalizeWhiteSpace(value, "collapse");
                size = normalized.empty() ? 0 : normalized.split(" ").size();
                break;
            }
            case "string":
                if (value.typeCode() != NT_STRING) {
                    throw error, "a string restriction requires a string value";
                }
                size = value.length();
                break;
            case "binary":
                if (value.typeCode() != NT_BINARY) {
                    throw error, "an octet restriction requires a binary value";
                }
                size = value.size();
                break;
            case "list":
                if (value.typeCode() != NT_LIST) {
                    throw error, "an item-count restriction requires a list value";
                }
                size = value.size();
                break;
        }
        if ((exists facets.length && XsdFacetCountHelper::compare(size, facets.length))
                || (exists facets.min_length && XsdFacetCountHelper::compare(size, facets.min_length) < 0)
                || (exists facets.max_length && XsdFacetCountHelper::compare(size, facets.max_length) > 0)) {
            throw error, sprintf("value for simpleType %Y has length %d outside its declared restrictions",
                facets.name, size);
        }
        if (facets.kind == "string" || facets.kind == "tokens") {
            if (facets.patterns) {
                bool matched = False;
                foreach XsdPatternConstraint pattern in (facets.patterns) {
                    if (XsdPatternConstraintHelper::matches(value, pattern)) {
                        matched = True;
                        break;
                    }
                }
                if (!matched) {
                    throw error, sprintf("value %Y for simpleType %Y does not match its pattern facets",
                        value, facets.name);
                }
            }
            if (exists facets.enumeration && !enumeration{value}) {
                throw error, sprintf("value %Y is outside the enumeration for simpleType %Y", value, facets.name);
            }
        }
    }
}

#! provider enforcing exact lengths and string whitespace, patterns, and value choices
/** The base provider validates each ancestor after the most derived whitespace processing.
    Serialized providers hold scalar metadata and preserve restrictions in optional and list types.
    @par Example
    A token limited to three characters accepts \c " A  B " as \c "A B" and rejects \c "ABCD".
    @since %WSDL 0.5.8
*/
public class XsdSizedRestrictionDataType inherits AbstractDataProviderType {
    private {
        hash<XsdSizedFacetInfo> facets;
        AbstractDataProviderType base;
        transient hash<string, bool> enumeration();
    }

    #! constructs a provider using resolved facets
    /** @param facets resolved length and string constraints
        @param base provider supplying the value category and ancestor restrictions
        @throw XSD-SIMPLETYPE-ERROR invalid facet metadata
    */
    constructor(hash<XsdSizedFacetInfo> facets, AbstractDataProviderType base) {
        XsdSizedFacetHelper::checkDefinition(facets, "XSD-SIMPLETYPE-ERROR");
        XsdSizedFacetHelper::checkBase(facets, base, "XSD-SIMPLETYPE-ERROR");
        self.facets = facets;
        self.base = base;
        enumeration = (map {$1: True}, facets.enumeration) ?? {};
    }

    private:internal deserializeMembers(hash<auto> members) {
        if (!(members.base instanceof AbstractDataProviderType)) {
            throw "DESERIALIZATION-ERROR", "sized restriction requires a base provider";
        }
        hash<XsdSizedFacetInfo> resolved = new hash<XsdSizedFacetInfo>(members.facets);
        XsdSizedFacetHelper::checkDefinition(resolved, "DESERIALIZATION-ERROR");
        XsdSizedFacetHelper::checkBase(resolved, members.base, "DESERIALIZATION-ERROR");
        hash<string, bool> resolved_enumeration = (map {$1: True}, resolved.enumeration) ?? {};
        facets = resolved;
        base = members.base;
        enumeration = resolved_enumeration;
    }

    #! returns the restricted type name
    /** @return the XSD type name with its optionality prefix */
    string getName() {
        return (base.isOrNothingType() ? "*" : "") + "xsd:" + facets.name;
    }

    #! requires provider validation before conversion by an enclosing list
    /** @return NOTHING */
    *Type getValueType() {
    }

    #! returns the converted value category
    /** @return the base provider category */
    int getBaseTypeCode() {
        return base.getBaseTypeCode();
    }

    #! returns the converted value category name
    /** @return the base provider category name */
    string getBaseTypeName() {
        return base.getBaseTypeName();
    }

    #! returns the item provider for a restricted list
    /** @return the base item type or NOTHING for atomic values */
    *AbstractDataProviderType getElementType() {
        return base.getElementType();
    }

    #! returns the fields supplied by the base provider
    /** @return the base fields */
    *hash<string, AbstractDataField> getFields() {
        return base.getFields();
    }

    #! requires facet validation for every supplied value
    /** @return an empty map */
    *hash<string, bool> getDirectTypeHash() {
        return {};
    }

    #! returns accepted native categories
    /** @param simple request simplified names
        @return the base accepted categories
    */
    hash<string, bool> getAcceptTypeHash(*bool simple) {
        return base.getAcceptTypeHash(simple);
    }

    #! returns converted native categories
    /** @param simple request simplified names
        @return the base returned categories
    */
    hash<string, bool> getReturnTypeHash(*bool simple) {
        return base.getReturnTypeHash(simple);
    }

    #! validates and converts a supplied value
    /** @param value the supplied string, binary value, or list
        @return the converted value
        @throw MISSING-VALUE-ERROR a required value is omitted
        @throw RUNTIME-TYPE-ERROR the value violates a restriction
    */
    auto acceptsValue(auto value) {
        if (!exists value) {
            if (isMandatory()) {
                throw "MISSING-VALUE-ERROR", "a restricted XML value must be supplied";
            }
            return;
        }
        if (facets.kind == "string" || facets.kind == "tokens") {
            if (!value.strp()) {
                throw "RUNTIME-TYPE-ERROR", sprintf("text restriction %Y requires a string-convertible scalar; got %Y",
                    facets.name, value.type());
            }
            value = XsdSimpleType::normalizeWhiteSpace(string(value), facets.white_space);
        }
        if (facets.name_type) {
            value = XsdBuiltinListHelper::isType(facets.name_type)
                ? XsdBuiltinListHelper::lexical(facets.name_type, value, "RUNTIME-TYPE-ERROR")
                : XsdNameLexicalHelper::lexical(facets.name_type, value, "RUNTIME-TYPE-ERROR");
        }
        auto converted = base.acceptsValue(value);
        XsdSizedFacetHelper::validate(facets, converted, enumeration, "RUNTIME-TYPE-ERROR");
        return converted;
    }

    #! returns whether a value is required
    /** @return the base requiredness */
    bool isMandatory() {
        return base.isMandatory();
    }

    #! returns whether omission is accepted
    /** @return the base optionality */
    bool isOrNothingType() {
        return base.isOrNothingType();
    }

    #! creates an optional equivalent retaining the same restrictions
    /** @return the optional provider */
    AbstractDataProviderType getOrNothingType() {
        return new XsdSizedRestrictionDataType(facets, base.getOrNothingType());
    }

    #! creates a mandatory equivalent retaining the same restrictions
    /** @return the mandatory provider */
    AbstractDataProviderType getMandatoryType() {
        return new XsdSizedRestrictionDataType(facets, base.getMandatoryType());
    }
}

#! resolved whole-list facets in lexical and ordered item value spaces
/** @since %WSDL 0.5.8 */
public hashdecl XsdListFacetInfo {
    #! schema type name
    string name;
    #! exact item count
    *XsdFacetCount length;
    #! minimum item count
    *XsdFacetCount min_length;
    #! maximum item count
    *XsdFacetCount max_length;
    #! compiled whole-list pattern alternatives
    *list<XsdPatternConstraint> patterns;
    #! ordered item values of enumeration literals parsed by the base type
    *list<list<auto>> enumeration;
}

#! provider retaining list facets and whole-list lexical spellings
/** Item conversion and inherited list constraints are validated before return.
    When a whole-list pattern applies, lexical tokens remain strings so later
    serialization can satisfy that pattern without changing their values.
    @par Example
    An integer list with pattern \c "00[0-9] 00[0-9]" accepts \c ["001", "002"]
    and retains both spellings after provider reconstruction.
    @since %WSDL 0.5.8
*/
public class XsdListRestrictionDataType inherits AbstractDataProviderType {
    private {
        hash<XsdListFacetInfo> facets;
        hash<XsdListItemInfo> item;
        AbstractDataProviderType base;
        transient XsdSizedRestrictionDataType length_type;
        transient hash<string, bool> enumeration();
    }

    #! constructs a provider from resolved list restrictions
    /** @param facets the list's own facets
        @param item atomic item conversion and validation
        @param base inherited list validation
        @throw XSD-SIMPLETYPE-ERROR invalid facet or item metadata
    */
    constructor(hash<XsdListFacetInfo> facets, hash<XsdListItemInfo> item, AbstractDataProviderType base) {
        initialize(facets, item, base, "XSD-SIMPLETYPE-ERROR");
    }

    private initialize(hash<XsdListFacetInfo> facets, hash<XsdListItemInfo> item,
            AbstractDataProviderType base, string error) {
        XsdListValueHelper::check(item, error);
        if (item.union_item) {
            *AbstractDataProviderType actual_item = base.getElementType();
            if (!(actual_item instanceof UnionDataType) || !actual_item.isMandatory()) {
                throw error, "a union list restriction requires a mandatory union item in its base provider";
            }
        }
        hash<XsdSizedFacetInfo> lengths = <XsdSizedFacetInfo>{"name": facets.name, "kind": "list",
            "length": facets.length, "min_length": facets.min_length, "max_length": facets.max_length};
        XsdSizedFacetHelper::checkDefinition(lengths, error);
        XsdSizedFacetHelper::checkBase(lengths, base, error);
        foreach XsdPatternConstraint pattern in (facets.patterns) {
            try {
                bool matches_empty = XsdPatternConstraintHelper::matches("", pattern);
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "REGEX-ERROR" && ex.err != "REGEX-COMPILATION-ERROR") {
                    rethrow;
                }
                throw error, sprintf("invalid whole-list pattern: %s", ex.desc);
            }
        }
        hash<string, bool> keys_by_value();
        foreach list<auto> value in (facets.enumeration) {
            try {
                if (item.union_item) {
                    hash<XsdListConversionInfo> checked = XsdListValueHelper::convertUnion(base, value, error);
                    if (!checked.identity) {
                        throw error, "cannot determine the selected primitive value of a list enumeration item";
                    }
                    keys_by_value{XsdUnionValueHelper::key(checked.identity)} = True;
                } else {
                    list<auto> checked = base.acceptsValue(value);
                    keys_by_value{XsdListValueHelper::key(item, checked, error)} = True;
                }
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "RUNTIME-TYPE-ERROR" && ex.err != "MISSING-VALUE-ERROR") {
                    rethrow;
                }
                throw error, sprintf("invalid base value in list enumeration: %s", ex.desc);
            }
        }
        XsdSizedRestrictionDataType checked_lengths(lengths, base);
        self.facets = facets;
        self.item = item;
        self.base = base;
        length_type = checked_lengths;
        enumeration = keys_by_value;
    }

    private:internal deserializeMembers(hash<auto> members) {
        if (!(members.base instanceof AbstractDataProviderType)) {
            throw "DESERIALIZATION-ERROR", "list restriction requires a base provider";
        }
        initialize(new hash<XsdListFacetInfo>(members.facets), new hash<XsdListItemInfo>(members.item),
            members.base, "DESERIALIZATION-ERROR");
    }

    #! returns the restricted list name
    /** @return the schema name with optionality */
    string getName() {
        return (isOrNothingType() ? "*" : "") + "xsd:" + facets.name;
    }

    #! requires validation in enclosing lists
    /** @return NOTHING */
    *Type getValueType() {
    }

    #! returns the native list category
    /** @return NT_LIST */
    int getBaseTypeCode() {
        return NT_LIST;
    }

    #! returns the native list category name
    /** @return list */
    string getBaseTypeName() {
        return "list";
    }

    #! returns the provider of each atomic item
    /** @return the item provider */
    *AbstractDataProviderType getElementType() {
        return item.union_item ? base.getElementType() : item.provider;
    }

    #! returns no outer record fields
    /** @return NOTHING */
    *hash<string, AbstractDataField> getFields() {
    }

    #! requires validation before conversion
    /** @return an empty map */
    *hash<string, bool> getDirectTypeHash() {
        return {};
    }

    #! returns the accepted native categories
    /** @param simple request simplified names
        @return the inherited categories
    */
    hash<string, bool> getAcceptTypeHash(*bool simple) {
        return base.getAcceptTypeHash(simple);
    }

    #! returns the output categories
    /** @param simple request simplified names
        @return the inherited list categories
    */
    hash<string, bool> getReturnTypeHash(*bool simple) {
        return base.getReturnTypeHash(simple);
    }

    #! converts a list while preserving lexical tokens required by patterns
    /** @param value the native item list
        @return the validated item values, lexical tokens for a pattern, or optional NOTHING
        @throw MISSING-VALUE-ERROR a required list was omitted
        @throw RUNTIME-TYPE-ERROR an item or list facet is invalid
    */
    auto acceptsValue(auto value) {
        if (!exists value) {
            return length_type.acceptsValue(value);
        }
        hash<XsdListConversionInfo> lexical = item.union_item
            ? XsdListValueHelper::convertUnion(length_type, value, "RUNTIME-TYPE-ERROR")
            : XsdListValueHelper::convert(item, value, "RUNTIME-TYPE-ERROR");
        list<auto> converted = item.union_item ? lexical.values : length_type.acceptsValue(value);
        if (facets.patterns) {
            string text = lexical.tokens.join(" ");
            bool matched = False;
            foreach XsdPatternConstraint pattern in (facets.patterns) {
                if (XsdPatternConstraintHelper::matches(text, pattern)) {
                    matched = True;
                    break;
                }
            }
            if (!matched) {
                throw "RUNTIME-TYPE-ERROR", sprintf("list value for %Y does not match its whole-list patterns", facets.name);
            }
        }
        if (exists facets.enumeration) {
            *string key = item.union_item ? (lexical.identity ? XsdUnionValueHelper::key(lexical.identity) : NOTHING)
                : XsdListValueHelper::key(item, converted, "RUNTIME-TYPE-ERROR");
            if (!exists key || !enumeration{key}) {
                throw "RUNTIME-TYPE-ERROR", sprintf("list value for %Y is outside its enumeration", facets.name);
            }
        }
        return facets.patterns ? lexical.tokens : converted;
    }

    #! returns whether omission is allowed
    /** @return the base optionality */
    bool isOrNothingType() {
        return base.isOrNothingType();
    }

    #! returns whether a list must be supplied
    /** @return the base requiredness */
    bool isMandatory() {
        return base.isMandatory();
    }

    #! creates an optional equivalent preserving every constraint
    /** @return the optional provider */
    AbstractDataProviderType getOrNothingType() {
        return new XsdListRestrictionDataType(facets, item, base.getOrNothingType());
    }

    #! creates a mandatory equivalent preserving every constraint
    /** @return the mandatory provider */
    AbstractDataProviderType getMandatoryType() {
        return new XsdListRestrictionDataType(facets, item, base.getMandatoryType());
    }
}

class XsdNumericFacetHelper {
    static checkProvider(string builtin, AbstractDataProviderType provider, string error) {
        *string supplied;
        if (provider instanceof XsdIntegerDataType) {
            supplied = cast<XsdIntegerDataType>(provider).getBuiltinName();
        } else if (provider instanceof XsdDecimalDataType) {
            supplied = cast<XsdDecimalDataType>(provider).getBuiltinName();
        } else if (provider instanceof XsdIeeeDataType) {
            supplied = cast<XsdIeeeDataType>(provider).getBuiltinName();
        } else if (provider instanceof XsdNumericRestrictionDataType) {
            supplied = cast<XsdNumericRestrictionDataType>(provider).getBuiltinName();
        } else if (provider instanceof XsdBinaryDataType) {
            supplied = cast<XsdBinaryDataType>(provider).getBuiltinName();
        } else if (provider instanceof XsdBinaryRestrictionDataType) {
            supplied = cast<XsdBinaryRestrictionDataType>(provider).getBuiltinName();
        } else if (provider instanceof XsdDurationDataType || provider instanceof XsdDurationRestrictionDataType) {
            supplied = "duration";
        } else if (provider instanceof XsdCalendarDataType) {
            supplied = cast<XsdCalendarDataType>(provider).getBuiltinName();
        } else if (provider instanceof XsdCalendarRestrictionDataType) {
            supplied = cast<XsdCalendarRestrictionDataType>(provider).getBuiltinName();
        }
        if (exists supplied && supplied != builtin) {
            throw error, sprintf("numeric provider builtin %Y does not match declared builtin %Y", supplied, builtin);
        }
    }

    static bool isType(string builtin) {
        return builtin == "decimal" || XsdIntegerLexicalHelper::Types{builtin}
            || XsdIeeeLexicalHelper::isType(builtin);
    }

    static *int compare(string builtin, auto left, auto right, string error) {
        return XsdIeeeLexicalHelper::isType(builtin) ? XsdIeeeLexicalHelper::compare(builtin, left, right, error)
            : XsdDecimalLexicalHelper::compare(lexical(builtin, left, error), lexical(builtin, right, error));
    }

    static bool equal(string builtin, auto left, auto right, string error) {
        *int relation = compare(builtin, left, right, error);
        return exists relation && !relation;
    }

    static string key(string builtin, auto value, string error) {
        string text = lexical(builtin, value, error);
        return XsdIeeeLexicalHelper::isType(builtin) ? XsdIeeeLexicalHelper::key(builtin, text, error)
            : XsdDecimalLexicalHelper::canonical(text);
    }

    static checkDefinition(hash<XsdNumericFacetInfo> facets, string error) {
        if (!isType(facets.base_name)) {
            throw error, sprintf("invalid numeric restriction base %Y", facets.base_name);
        }
        if (XsdIeeeLexicalHelper::isType(facets.base_name)
                && (exists facets.total_digits || exists facets.fraction_digits)) {
            throw error, "totalDigits and fractionDigits apply only to decimal-derived types";
        }
        if (exists facets.total_digits) {
            XsdFacetCount total = XsdFacetCountHelper::parse("totalDigits", facets.total_digits, error);
        }
        if (exists facets.fraction_digits) {
            XsdFacetCount fractional = XsdFacetCountHelper::parse("fractionDigits", facets.fraction_digits, error);
            if (facets.base_name != "decimal" && XsdFacetCountHelper::compare(fractional, 0)) {
                throw error, "integer-derived types have fractionDigits fixed to zero";
            }
        }
        if (exists facets.total_digits && exists facets.fraction_digits
                && XsdFacetCountHelper::compare(facets.fraction_digits, facets.total_digits) > 0) {
            throw error, "numeric restriction requires positive totalDigits and nonnegative fractionDigits <= totalDigits";
        }
        foreach string facet in (keys facets.bounds) {
            if (facet != "minInclusive" && facet != "minExclusive" && facet != "maxInclusive"
                    && facet != "maxExclusive") {
                throw error, sprintf("unknown numeric bound facet %Y", facet);
            }
            lexical(facets.base_name, facets.bounds{facet}, error);
        }
        if ((exists facets.bounds.minInclusive && exists facets.bounds.minExclusive)
                || (exists facets.bounds.maxInclusive && exists facets.bounds.maxExclusive)) {
            throw error, "inclusive and exclusive bounds cannot coexist in the same restriction step";
        }
        checkBounds(facets.base_name, facets.bounds, error);
        checkBounds(facets.base_name, withBuiltinBounds(facets.base_name, facets.bounds), error);
        foreach string value in (facets.enumeration) {
            lexical(facets.base_name, value, error);
        }
        foreach XsdPatternConstraint pattern in (facets.patterns) {
            try {
                bool accepts_empty = XsdPatternConstraintHelper::matches("", pattern);
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "REGEX-ERROR" && ex.err != "REGEX-COMPILATION-ERROR") {
                    rethrow;
                }
                throw error, sprintf("invalid compiled numeric pattern: %s", ex.desc);
            }
        }
    }

    static hash<string, string> withBuiltinBounds(string builtin, hash<string, string> bounds) {
        if (XsdIntegerLexicalHelper::Bounds{builtin}) {
            *string minimum = XsdIntegerLexicalHelper::Bounds{builtin}[0];
            *string maximum = XsdIntegerLexicalHelper::Bounds{builtin}[1];
            if (exists minimum && !exists bounds.minInclusive) {
                bounds.minInclusive = minimum;
            }
            if (exists maximum && !exists bounds.maxInclusive) {
                bounds.maxInclusive = maximum;
            }
        }
        return bounds;
    }

    static checkBounds(string builtin, hash<string, string> bounds, string error) {
        foreach string minimum in ("minInclusive", "minExclusive") {
            foreach string maximum in ("maxInclusive", "maxExclusive") {
                if (!exists bounds{minimum} || !exists bounds{maximum}) {
                    continue;
                }
                *int comparison = compare(builtin, bounds{minimum}, bounds{maximum}, error);
                bool mixed = minimum.endsWith("Inclusive") != maximum.endsWith("Inclusive");
                if (!exists comparison || comparison > 0 || (!comparison && mixed)) {
                    throw error, sprintf("contradictory %s and %s facets", minimum, maximum);
                }
            }
        }
    }

    static string lexical(string base, auto value, string error) {
        if (!isType(base)) {
            throw error, sprintf("invalid numeric restriction base %Y", base);
        }
        if (XsdIeeeLexicalHelper::isType(base)) {
            return XsdIeeeLexicalHelper::lexical(base, value, error);
        }
        return base == "decimal" ? XsdDecimalLexicalHelper::lexical(value, error)
            : XsdIntegerLexicalHelper::lexical(base, value, error);
    }

    static string validate(hash<XsdNumericFacetInfo> facets, auto value, string error) {
        string text = lexical(facets.base_name, value, error);
        if (facets.patterns) {
            bool matched = False;
            foreach XsdPatternConstraint pattern in (facets.patterns) {
                if (XsdPatternConstraintHelper::matches(text, pattern)) {
                    matched = True;
                    break;
                }
            }
            if (!matched) {
                throw error, sprintf("value %Y for simpleType %Y does not match its pattern facets", text, facets.name);
            }
        }
        auto scalar = XsdIeeeLexicalHelper::isType(facets.base_name)
            ? XsdIeeeLexicalHelper::decode(facets.base_name, text, error) : text;
        foreach string facet in (keys facets.bounds) {
            *int compared = compare(facets.base_name, scalar, facets.bounds{facet}, error);
            bool invalid = !exists compared;
            if (!invalid) {
                switch (facet) {
                    case "minInclusive": invalid = compared < 0; break;
                    case "minExclusive": invalid = compared <= 0; break;
                    case "maxInclusive": invalid = compared > 0; break;
                    case "maxExclusive": invalid = compared >= 0; break;
                }
            }
            if (invalid) {
                throw error, sprintf("value %Y for simpleType %Y violates %s %Y", text, facets.name,
                    facet, facets.bounds{facet});
            }
        }
        if (exists facets.total_digits || exists facets.fraction_digits) {
            string normalized = XsdDecimalLexicalHelper::canonical(text);
            normalized =~ s/\A-//;
            list<string> parts = normalized.split(".");
            int fractional = (parts[1] ?? "").size();
            int total = (parts[0] == "0" ? 0 : parts[0].size()) + fractional;
            if (!total) {
                total = 1;
            }
            if (exists facets.total_digits && XsdFacetCountHelper::compare(total, facets.total_digits) > 0) {
                throw error, sprintf("value %Y for simpleType %Y has %d digits, exceeding totalDigits %Y",
                    text, facets.name, total, facets.total_digits);
            }
            if (exists facets.fraction_digits && XsdFacetCountHelper::compare(fractional, facets.fraction_digits) > 0) {
                throw error, sprintf("value %Y for simpleType %Y has %d fractional digits, exceeding fractionDigits %Y",
                    text, facets.name, fractional, facets.fraction_digits);
            }
        }
        if (facets.enumeration) {
            foreach string allowed in (facets.enumeration) {
                if (equal(facets.base_name, scalar, allowed, error)) {
                    return text;
                }
            }
            throw error, sprintf("value %Y for simpleType %Y is not in its numeric enumeration", text, facets.name);
        }
        return text;
    }
}

#! resolved facets for a duration restriction
/** @since %WSDL 0.5.8 */
public hashdecl XsdDurationFacetInfo {
    #! declared type name
    string name;
    #! duration builtin local name
    string base_name;
    #! compiled alternatives at this derivation step
    *list<XsdPatternConstraint> patterns;
    #! inclusive/exclusive lower and upper endpoints
    hash<string, string> bounds();
    #! allowed lexical values, compared by duration value
    *list<string> enumeration;
}

class XsdDurationFacetHelper {
    static checkProvider(string builtin, AbstractDataProviderType provider, string error) {
        XsdNumericFacetHelper::checkProvider(builtin, provider, error);
        *string supplied;
        if (provider instanceof XsdDurationDataType) {
            supplied = cast<XsdDurationDataType>(provider).getBuiltinName();
        } else if (provider instanceof XsdDurationRestrictionDataType) {
            supplied = cast<XsdDurationRestrictionDataType>(provider).getBuiltinName();
        }
        if (exists supplied && supplied != builtin) {
            throw error, sprintf("duration provider builtin %Y does not match declared builtin %Y", supplied, builtin);
        }
    }

    static checkDefinition(hash<XsdDurationFacetInfo> facets, string error) {
        if (facets.base_name != "duration") {
            throw error, sprintf("unknown duration restriction base %Y", facets.base_name);
        }
        foreach string facet in (keys facets.bounds) {
            if (facet != "minInclusive" && facet != "minExclusive" && facet != "maxInclusive"
                    && facet != "maxExclusive") {
                throw error, sprintf("unknown duration bound facet %Y", facet);
            }
            string checked = XsdDurationLexicalHelper::lexical(facets.bounds{facet}, error);
        }
        if ((exists facets.bounds.minInclusive && exists facets.bounds.minExclusive)
                || (exists facets.bounds.maxInclusive && exists facets.bounds.maxExclusive)) {
            throw error, "inclusive and exclusive bounds cannot coexist in the same restriction step";
        }
        checkBounds(facets.base_name, facets.bounds, error);
        foreach string value in (facets.enumeration) {
            string checked = XsdDurationLexicalHelper::lexical(value, error);
        }
        foreach XsdPatternConstraint pattern in (facets.patterns) {
            try {
                bool checked = XsdPatternConstraintHelper::matches("", pattern);
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "REGEX-ERROR" && ex.err != "REGEX-COMPILATION-ERROR") {
                    rethrow;
                }
                throw error, sprintf("invalid compiled duration pattern: %s", ex.desc);
            }
        }
    }

    static checkBounds(string builtin, hash<string, string> bounds, string error) {
        foreach string minimum in ("minInclusive", "minExclusive") {
            foreach string maximum in ("maxInclusive", "maxExclusive") {
                if (!exists bounds{minimum} || !exists bounds{maximum}) {
                    continue;
                }
                *int relation = XsdDurationValueHelper::compare(bounds{minimum}, bounds{maximum}, error);
                bool mixed = minimum.endsWith("Inclusive") != maximum.endsWith("Inclusive");
                if (!exists relation || relation > 0 || (!relation && mixed)) {
                    throw error, sprintf("contradictory duration %s and %s facets", minimum, maximum);
                }
            }
        }
    }

    static string validate(hash<XsdDurationFacetInfo> facets, auto value, string error) {
        string text = XsdDurationLexicalHelper::lexical(value, error);
        if (facets.patterns) {
            bool matched = False;
            foreach XsdPatternConstraint pattern in (facets.patterns) {
                if (XsdPatternConstraintHelper::matches(text, pattern)) {
                    matched = True;
                    break;
                }
            }
            if (!matched) {
                throw error, sprintf("duration value %Y for %Y does not match its pattern facets", text, facets.name);
            }
        }
        foreach string facet in (keys facets.bounds) {
            *int relation = XsdDurationValueHelper::compare(text, facets.bounds{facet}, error);
            bool invalid = !exists relation;
            if (!invalid) {
                switch (facet) {
                    case "minInclusive": invalid = relation < 0; break;
                    case "minExclusive": invalid = relation <= 0; break;
                    case "maxInclusive": invalid = relation > 0; break;
                    case "maxExclusive": invalid = relation >= 0; break;
                }
            }
            if (invalid) {
                throw error, sprintf("duration value %Y for %Y violates %s %Y", text, facets.name,
                    facet, facets.bounds{facet});
            }
        }
        if (facets.enumeration) {
            string key = XsdDurationValueHelper::key(text, error);
            foreach string allowed in (facets.enumeration) {
                if (key == XsdDurationValueHelper::key(allowed, error)) {
                    return text;
                }
            }
            throw error, sprintf("duration value %Y for %Y is outside its enumeration", text, facets.name);
        }
        return text;
    }
}

#! a duration provider that retains lexical patterns and exact value facets
/** Bounds use the XSD four-reference-date partial order with exact decimal seconds.
    Enumerations compare all four reference-date results. Patterns retain the XML spelling.
    @par Example
    An enumeration containing \c "P1Y" also accepts \c "P12M".
    @since %WSDL 0.5.8
*/
public class XsdDurationRestrictionDataType inherits AbstractDataProviderType {
    private {
        hash<XsdDurationFacetInfo> facets;
        AbstractDataProviderType base;
    }

    #! constructs a provider for a duration restriction
    /** @param facets the resolved scalar facet data
        @param base the base provider supplying native categories and requiredness
        @throw XSD-SIMPLETYPE-ERROR invalid duration facet metadata
    */
    constructor(hash<XsdDurationFacetInfo> facets, AbstractDataProviderType base) {
        XsdDurationFacetHelper::checkDefinition(facets, "XSD-SIMPLETYPE-ERROR");
        XsdDurationFacetHelper::checkProvider(facets.base_name, base, "XSD-SIMPLETYPE-ERROR");
        self.facets = facets;
        self.base = base;
    }

    private:internal deserializeMembers(hash<auto> members) {
        if (!(members.base instanceof AbstractDataProviderType)) {
            throw "DESERIALIZATION-ERROR", "duration restriction provider requires a base provider";
        }
        hash<XsdDurationFacetInfo> resolved = new hash<XsdDurationFacetInfo>(members.facets);
        XsdDurationFacetHelper::checkDefinition(resolved, "DESERIALIZATION-ERROR");
        XsdDurationFacetHelper::checkProvider(resolved.base_name, members.base, "DESERIALIZATION-ERROR");
        facets = resolved;
        base = members.base;
    }

    #! returns the XSD builtin underlying this duration provider
    /** @return the duration builtin local name
        @since %WSDL 0.5.8
    */
    string getBuiltinName() {
        return facets.base_name;
    }

    #! returns the restricted type name
    /** @return the XSD type name with its optionality prefix */
    string getName() {
        return (base.isOrNothingType() ? "*" : "") + "xsd:" + facets.name;
    }

    #! prevents list providers from converting values before facet validation
    /** @return NOTHING */
    *Type getValueType() {
    }

    #! returns the output category, retaining patterned values as strings
    /** @return string for this step's pattern, otherwise the base provider category */
    int getBaseTypeCode() {
        return facets.patterns ? NT_STRING : base.getBaseTypeCode();
    }

    #! returns the output category name, including retained patterned strings
    /** @return string for this step's pattern, otherwise the base provider category name */
    string getBaseTypeName() {
        return facets.patterns ? "string" : base.getBaseTypeName();
    }

    #! returns no item type for this atomic value
    /** @return NOTHING */
    *AbstractDataProviderType getElementType() {
    }

    #! returns no record fields for this atomic value
    /** @return NOTHING */
    *hash<string, AbstractDataField> getFields() {
    }

    #! requires facet validation for all values
    /** @return an empty map */
    *hash<string, bool> getDirectTypeHash() {
        return {};
    }

    #! returns accepted native categories
    /** @param simple request simplified names
        @return the base provider's accepted categories
    */
    hash<string, bool> getAcceptTypeHash(*bool simple) {
        return base.getAcceptTypeHash(simple);
    }

    #! returns converted native categories
    /** @param simple request simplified names
        @return string and optional nothing for this step's pattern, otherwise the base provider's categories
    */
    hash<string, bool> getReturnTypeHash(*bool simple) {
        if (facets.patterns) {
            hash<string, bool> result = {"string": True};
            if (base.isOrNothingType()) {
                result.nothing = True;
            }
            return result;
        }
        return base.getReturnTypeHash(simple);
    }

    #! validates the declared restriction and converts the accepted value
    /** @param value the native value or XML duration text
        @return the validated duration value, or NOTHING for optional omission
        @throw MISSING-VALUE-ERROR a required value is omitted
        @throw RUNTIME-TYPE-ERROR lexical input or a restriction facet is invalid
    */
    auto acceptsValue(auto value) {
        if (!exists value) {
            return base.acceptsValue(value);
        }
        string lexical = XsdDurationFacetHelper::validate(facets, value, "RUNTIME-TYPE-ERROR");
        auto converted = base.acceptsValue(lexical);
        return facets.patterns ? lexical : converted;
    }

    #! returns the requiredness of the value
    /** @return True for mandatory values */
    bool isMandatory() {
        return base.isMandatory();
    }

    #! returns whether omission is accepted
    /** @return True for optional values */
    bool isOrNothingType() {
        return base.isOrNothingType();
    }

    #! returns an optional equivalent retaining the same restriction
    /** @return the optional provider */
    AbstractDataProviderType getOrNothingType() {
        return new XsdDurationRestrictionDataType(facets, base.getOrNothingType());
    }

    #! returns a mandatory equivalent retaining the same restriction
    /** @return the mandatory provider */
    AbstractDataProviderType getMandatoryType() {
        return new XsdDurationRestrictionDataType(facets, base.getMandatoryType());
    }
}

#! resolved lexical and octet facets for a binary restriction
/** @since %WSDL 0.5.8 */
public hashdecl XsdBinaryFacetInfo {
    #! declared type name
    string name;
    #! hexBinary or base64Binary
    string base_name;
    #! compiled alternatives at this derivation step
    *list<XsdPatternConstraint> patterns;
    #! encoded enumeration literals, compared by decoded octets
    *list<string> enumeration;
    #! exact octet count
    *XsdFacetCount length;
    #! minimum octet count
    *XsdFacetCount min_length;
    #! maximum octet count
    *XsdFacetCount max_length;
}

class XsdBinaryFacetHelper {
    static hash<XsdSizedFacetInfo> lengths(hash<XsdBinaryFacetInfo> facets) {
        return <XsdSizedFacetInfo>{"name": facets.name, "kind": "binary", "length": facets.length,
            "min_length": facets.min_length, "max_length": facets.max_length};
    }

    static checkProvider(string builtin, AbstractDataProviderType base, string error) {
        XsdNumericFacetHelper::checkProvider(builtin, base, error);
        if (!(base instanceof XsdBinaryDataType) && !(base instanceof XsdBinaryRestrictionDataType)) {
            throw error, "a binary restriction requires a validating binary base provider";
        }
    }

    static checkDefinition(hash<XsdBinaryFacetInfo> facets, string error) {
        if (!XsdBinaryLexicalHelper::isType(facets.base_name)) {
            throw error, "invalid binary restriction builtin";
        }
        XsdSizedFacetHelper::checkDefinition(lengths(facets), error);
        foreach string lexical in (facets.enumeration) {
            string checked = XsdBinaryLexicalHelper::lexical(facets.base_name, lexical, error);
        }
        foreach XsdPatternConstraint pattern in (facets.patterns) {
            try {
                bool checked = XsdPatternConstraintHelper::matches("", pattern);
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "REGEX-ERROR" && ex.err != "REGEX-COMPILATION-ERROR") {
                    rethrow;
                }
                throw error, sprintf("invalid compiled binary pattern: %s", ex.desc);
            }
        }
    }

    static string key(string builtin, auto value, string error) {
        return make_hex_string(XsdBinaryLexicalHelper::decode(builtin, value, error));
    }

    # Provider inputs are encoded strings or native values. Serializer raw strings
    # are encoded before this helper so the two public input conventions stay distinct.
    static string validate(hash<XsdBinaryFacetInfo> facets, auto value, string error) {
        string text = XsdBinaryLexicalHelper::lexical(facets.base_name,
            value.typeCode() == NT_STRING ? value : XsdBinaryLexicalHelper::encode(facets.base_name, value, error), error);
        binary decoded = XsdBinaryLexicalHelper::decode(facets.base_name, text, error);
        XsdSizedFacetHelper::validate(lengths(facets), decoded, {}, error);
        if (facets.patterns) {
            bool matched = False;
            foreach XsdPatternConstraint pattern in (facets.patterns) {
                if (XsdPatternConstraintHelper::matches(text, pattern)) {
                    matched = True;
                    break;
                }
            }
            if (!matched) {
                throw error, sprintf("binary spelling %Y does not match a pattern of %Y", text, facets.name);
            }
        }
        if (exists facets.enumeration) {
            foreach string lexical in (facets.enumeration) {
                if (decoded == XsdBinaryLexicalHelper::decode(facets.base_name, lexical, error)) {
                    return text;
                }
            }
            throw error, sprintf("binary value for %Y is outside its enumeration", facets.name);
        }
        return text;
    }
}

#! a binary provider that retains lexical patterns and exact value facets
/** Lengths count decoded octets; enumerations compare byte content.
    Patterns retain the XML spelling in an immutable XsdBinaryValue.
    @par Example
    An enumeration containing \c "FF" also accepts \c "ff" for hexBinary.
    @since %WSDL 0.5.8
*/
public class XsdBinaryRestrictionDataType inherits AbstractDataProviderType {
    private {
        hash<XsdBinaryFacetInfo> facets;
        AbstractDataProviderType base;
    }

    #! constructs a provider for a binary restriction
    /** @param facets the resolved scalar facet data
        @param base the base provider supplying native categories and requiredness
        @throw XSD-SIMPLETYPE-ERROR invalid binary facet metadata
    */
    constructor(hash<XsdBinaryFacetInfo> facets, AbstractDataProviderType base) {
        XsdBinaryFacetHelper::checkDefinition(facets, "XSD-SIMPLETYPE-ERROR");
        XsdBinaryFacetHelper::checkProvider(facets.base_name, base, "XSD-SIMPLETYPE-ERROR");
        checkEnumeration(facets, base, "XSD-SIMPLETYPE-ERROR");
        self.facets = facets;
        self.base = base;
    }

    private:internal deserializeMembers(hash<auto> members) {
        if (!(members.base instanceof AbstractDataProviderType)) {
            throw "DESERIALIZATION-ERROR", "binary restriction provider requires a base provider";
        }
        hash<XsdBinaryFacetInfo> resolved = new hash<XsdBinaryFacetInfo>(members.facets);
        XsdBinaryFacetHelper::checkDefinition(resolved, "DESERIALIZATION-ERROR");
        XsdBinaryFacetHelper::checkProvider(resolved.base_name, members.base, "DESERIALIZATION-ERROR");
        checkEnumeration(resolved, members.base, "DESERIALIZATION-ERROR");
        facets = resolved;
        base = members.base;
    }

    private static checkEnumeration(hash<XsdBinaryFacetInfo> facets, AbstractDataProviderType base, string error) {
        foreach string lexical in (facets.enumeration) {
            try {
                auto checked = base.acceptsValue(lexical);
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "RUNTIME-TYPE-ERROR" && ex.err != "MISSING-VALUE-ERROR") {
                    rethrow;
                }
                throw error, sprintf("invalid base value in binary enumeration: %s", ex.desc);
            }
        }
    }

    #! returns the XSD builtin underlying this binary provider
    /** @return the binary builtin local name
        @since %WSDL 0.5.8
    */
    string getBuiltinName() {
        return facets.base_name;
    }

    #! returns the restricted type name
    /** @return the XSD type name with its optionality prefix */
    string getName() {
        return (base.isOrNothingType() ? "*" : "") + "xsd:" + facets.name;
    }

    #! prevents list providers from converting values before facet validation
    /** @return NOTHING */
    *Type getValueType() {
    }

    #! returns the output category, retaining patterned values as XsdBinaryValue objects
    /** @return object for this step's pattern, otherwise the base provider category */
    int getBaseTypeCode() {
        return facets.patterns ? NT_OBJECT : base.getBaseTypeCode();
    }

    #! returns the output category name, including retained patterned objects
    /** @return object for this step's pattern, otherwise the base provider category name */
    string getBaseTypeName() {
        return facets.patterns ? "object" : base.getBaseTypeName();
    }

    #! returns no item type for this atomic value
    /** @return NOTHING */
    *AbstractDataProviderType getElementType() {
    }

    #! returns no record fields for this atomic value
    /** @return NOTHING */
    *hash<string, AbstractDataField> getFields() {
    }

    #! requires facet validation for all values
    /** @return an empty map */
    *hash<string, bool> getDirectTypeHash() {
        return {};
    }

    #! returns accepted native categories
    /** @param simple request simplified names
        @return the base provider's accepted categories
    */
    hash<string, bool> getAcceptTypeHash(*bool simple) {
        return base.getAcceptTypeHash(simple);
    }

    #! returns converted native categories
    /** @param simple request simplified names
        @return object and optional nothing for this step's pattern, otherwise the base provider's categories
    */
    hash<string, bool> getReturnTypeHash(*bool simple) {
        if (facets.patterns) {
            hash<string, bool> result = {"object": True};
            if (base.isOrNothingType()) {
                result.nothing = True;
            }
            return result;
        }
        return base.getReturnTypeHash(simple);
    }

    #! validates the declared restriction and converts the accepted value
    /** @param value the native value or XML binary text
        @return the validated binary value, or NOTHING for optional omission
        @throw MISSING-VALUE-ERROR a required value is omitted
        @throw RUNTIME-TYPE-ERROR lexical input or a restriction facet is invalid
    */
    auto acceptsValue(auto value) {
        if (!exists value) {
            return base.acceptsValue(value);
        }
        string lexical = XsdBinaryFacetHelper::validate(facets, value, "RUNTIME-TYPE-ERROR");
        auto converted = base.acceptsValue(lexical);
        return facets.patterns ? new XsdBinaryValue(facets.base_name, lexical) : converted;
    }

    #! returns the requiredness of the value
    /** @return True for mandatory values */
    bool isMandatory() {
        return base.isMandatory();
    }

    #! returns whether omission is accepted
    /** @return True for optional values */
    bool isOrNothingType() {
        return base.isOrNothingType();
    }

    #! returns an optional equivalent retaining the same restriction
    /** @return the optional provider */
    AbstractDataProviderType getOrNothingType() {
        return new XsdBinaryRestrictionDataType(facets, base.getOrNothingType());
    }

    #! returns a mandatory equivalent retaining the same restriction
    /** @return the mandatory provider */
    AbstractDataProviderType getMandatoryType() {
        return new XsdBinaryRestrictionDataType(facets, base.getMandatoryType());
    }
}

#! resolved facets for a calendar restriction
/** @since %WSDL 0.5.8 */
public hashdecl XsdCalendarFacetInfo {
    #! declared type name
    string name;
    #! calendar builtin local name
    string base_name;
    #! compiled alternatives at this derivation step
    *list<XsdPatternConstraint> patterns;
    #! inclusive/exclusive lower and upper endpoints
    hash<string, string> bounds();
    #! allowed lexical values, compared by calendar value
    *list<string> enumeration;
}

class XsdCalendarFacetHelper {
    static checkProvider(string builtin, AbstractDataProviderType provider, string error) {
        XsdNumericFacetHelper::checkProvider(builtin, provider, error);
        *string supplied;
        if (provider instanceof XsdCalendarDataType) {
            supplied = cast<XsdCalendarDataType>(provider).getBuiltinName();
        } else if (provider instanceof XsdCalendarRestrictionDataType) {
            supplied = cast<XsdCalendarRestrictionDataType>(provider).getBuiltinName();
        }
        if (exists supplied && supplied != builtin) {
            throw error, sprintf("calendar provider builtin %Y does not match declared builtin %Y", supplied, builtin);
        }
    }

    static checkDefinition(hash<XsdCalendarFacetInfo> facets, string error) {
        if (!XsdCalendarLexicalHelper::isType(facets.base_name)) {
            throw error, sprintf("unknown calendar restriction base %Y", facets.base_name);
        }
        foreach string facet in (keys facets.bounds) {
            if (facet != "minInclusive" && facet != "minExclusive" && facet != "maxInclusive"
                    && facet != "maxExclusive") {
                throw error, sprintf("unknown calendar bound facet %Y", facet);
            }
            string checked = XsdCalendarLexicalHelper::lexical(facets.base_name, facets.bounds{facet}, error);
        }
        if ((exists facets.bounds.minInclusive && exists facets.bounds.minExclusive)
                || (exists facets.bounds.maxInclusive && exists facets.bounds.maxExclusive)) {
            throw error, "inclusive and exclusive bounds cannot coexist in the same restriction step";
        }
        checkBounds(facets.base_name, facets.bounds, error);
        foreach string value in (facets.enumeration) {
            string checked = XsdCalendarLexicalHelper::lexical(facets.base_name, value, error);
        }
        foreach XsdPatternConstraint pattern in (facets.patterns) {
            try {
                bool checked = XsdPatternConstraintHelper::matches("", pattern);
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "REGEX-ERROR" && ex.err != "REGEX-COMPILATION-ERROR") {
                    rethrow;
                }
                throw error, sprintf("invalid compiled calendar pattern: %s", ex.desc);
            }
        }
    }

    static checkBounds(string builtin, hash<string, string> bounds, string error) {
        foreach string minimum in ("minInclusive", "minExclusive") {
            foreach string maximum in ("maxInclusive", "maxExclusive") {
                if (!exists bounds{minimum} || !exists bounds{maximum}) {
                    continue;
                }
                *int relation = XsdCalendarLexicalHelper::compare(builtin, bounds{minimum}, bounds{maximum}, error);
                bool mixed = minimum.endsWith("Inclusive") != maximum.endsWith("Inclusive");
                if (!exists relation || relation > 0 || (!relation && mixed)) {
                    throw error, sprintf("contradictory calendar %s and %s facets", minimum, maximum);
                }
            }
        }
    }

    static string validate(hash<XsdCalendarFacetInfo> facets, auto value, string error) {
        string text = XsdCalendarLexicalHelper::lexical(facets.base_name, value, error);
        if (facets.patterns) {
            bool matched = False;
            foreach XsdPatternConstraint pattern in (facets.patterns) {
                if (XsdPatternConstraintHelper::matches(text, pattern)) {
                    matched = True;
                    break;
                }
            }
            if (!matched) {
                throw error, sprintf("calendar value %Y for %Y does not match its pattern facets", text, facets.name);
            }
        }
        foreach string facet in (keys facets.bounds) {
            *int relation = XsdCalendarLexicalHelper::compare(facets.base_name, text, facets.bounds{facet}, error);
            bool invalid = !exists relation;
            if (!invalid) {
                switch (facet) {
                    case "minInclusive": invalid = relation < 0; break;
                    case "minExclusive": invalid = relation <= 0; break;
                    case "maxInclusive": invalid = relation > 0; break;
                    case "maxExclusive": invalid = relation >= 0; break;
                }
            }
            if (invalid) {
                throw error, sprintf("calendar value %Y for %Y violates %s %Y", text, facets.name,
                    facet, facets.bounds{facet});
            }
        }
        if (facets.enumeration) {
            string key = XsdCalendarLexicalHelper::key(facets.base_name, text, error);
            foreach string allowed in (facets.enumeration) {
                if (key == XsdCalendarLexicalHelper::key(facets.base_name, allowed, error)) {
                    return text;
                }
            }
            throw error, sprintf("calendar value %Y for %Y is outside its enumeration", text, facets.name);
        }
        return text;
    }
}

