class XsdDataFieldHelper {
    static string display(auto value) {
        return value.typeCode() == NT_LIST ? (map displayScalar($1), value).join(" ") : displayScalar(value);
    }

    private static string displayScalar(auto value) {
        if (value instanceof XsdBinaryValue || value instanceof XsdQNameValue || value instanceof XsdNotationValue
                || value instanceof XsdScopedLexicalValue) {
            return value.getLexicalValue();
        }
        return value.typeCode() == NT_BINARY ? make_hex_string(value) : string(value);
    }

    static QoreDataField create(XsdElement element, hash<auto> info) {
        if (element.maxOccurs != 1 && exists info.allowed_values) {
            info.element_allowed_values = remove info.allowed_values;
        }
        return create(element.type, info);
    }

    static QoreDataField create(XsdAbstractType schema, hash<auto> info) {
        if (XsdNativeTypeProviderHelper::isNative(info.type)) {
            return new XsdNativeTypeDataField(schema, info);
        }
        if (schema instanceof XsdComplexType) {
            XsdComplexType complex = cast<XsdComplexType>(schema);
            if (!complex.attrs && !exists complex.getAttributeWildcard() && complex.simpleType) {
                schema = complex.simpleType;
            }
        }
        *hash<XsdListItemInfo> list_item = XsdListValueHelper::describeList(schema);
        if (list_item) {
            return new XsdListDataField(info, list_item);
        }
        XsdAbstractType original = schema;
        while (schema instanceof XsdSimpleType && cast<XsdSimpleType>(schema).type) {
            schema = cast<XsdSimpleType>(schema).type;
        }
        if (schema instanceof XsdSimpleType && cast<XsdSimpleType>(schema).unionTypes) {
            return new XsdUnionDataField(info, cast<UnionDataType>(original.getDataProviderType()));
        }
        if (schema instanceof XsdBaseType && XsdNumericFacetHelper::isType(schema.name)) {
            return new XsdNumericDataField(info, schema.name);
        }
        if (schema instanceof XsdBaseType && XsdCalendarLexicalHelper::isType(schema.name)) {
            return new XsdCalendarDataField(info, schema.name);
        }
        if (schema instanceof XsdBaseType && schema.name == "duration") {
            return new XsdDurationDataField(info);
        }
        if (schema instanceof XsdBaseType && XsdBinaryLexicalHelper::isType(schema.name)) {
            return new XsdBinaryDataField(info, schema.name);
        }
        if (schema instanceof XsdBaseType && schema.name == "QName") {
            return new XsdQNameDataField(info);
        }
        if (schema instanceof XsdBaseType && schema.name == "NOTATION") {
            return new XsdNotationDataField(info);
        }
        if (schema instanceof XsdBaseType && schema.name == "boolean") {
            return new XsdBooleanDataField(info);
        }
        return new QoreDataField(info);
    }
}

# Generic XML content has lexical values rather than an inferred scalar shape.
class XsdGenericValueHelper {
    static bool isGeneric(XsdAbstractType type) {
        return XsdTypeSubstitutionHelper::builtin(type, "anyType")
            || XsdTypeSubstitutionHelper::builtin(type, "anySimpleType");
    }

    static auto decode(XsdBaseType type, hash<string, XsdAbstractType> types, *hash<auto> references, auto value) {
        XsdIdentityElementScope identity_scope(True);
        on_success identity_scope.finish(SOAP_DESERIALIZATION_ERROR);
        XsdWildcardElementHelper::validateLaxContent(type.nsc, types, references, value,
            XsdBase::getExpandedAttributes(value.typeCode() == NT_HASH ? value."^attributes^" : NOTHING));
        if (value.typeCode() == NT_HASH) {
            return XsdWildcardElementHelper::retainNamespaces(value);
        }
        if (exists value && !value.strp()) {
            throw SOAP_DESERIALIZATION_ERROR, "generic XML text requires a scalar value";
        }
        # Preserve the absence of xsi:type for native forwarding. A scalar
        # supplied for anyType is inferred on output; XML data keeps its type.
        if (PreserveNativeTypes) {
            return XsdWildcardElementHelper::retainNamespaces({"^value^":string(value)});
        }
        return type.nsc.opt_empty_string_is_nothing ? value : string(value);
    }

    static hash<auto> encode(XsdBaseType type, Namespaces output, hash<auto> value, *softbool omit_type) {
        XsdIdentityElementScope identity_scope(True);
        on_success identity_scope.finish(SOAP_SERIALIZATION_ERROR);
        *XsdDocumentValueResult receiver = GenericDocumentValueResult;
        GenericDocumentValueResult = NOTHING;
        on_exit GenericDocumentValueResult = receiver;
        try {
            checkXmlData(value);
            hash<auto> wire = XsdBase::restoreElementNamespaces(value);
            hash<auto> assessed = XsdBase::expandElementNamespaces(wire);
            XsdQNameNamespaceScope scope(assessed."^attributes^", True);
            hash<string, XsdAbstractType> types = NativeTypeOutputTypes ?? type.nsc.getInstanceTypes();
            XsdNativeTypeValueScope native_projection(False);
            XsdAbstractType selected = XsdTypeSubstitutionHelper::select(\assessed, type, types, type.name);
            if (XsdTypeSubstitutionHelper::builtin(selected, "anyType")) {
                XsdWildcardElementHelper::validateLaxContent(type.nsc, types, NOTHING, assessed,
                    XsdBase::getExpandedAttributes(assessed."^attributes^"));
            } else {
                auto checked = XsdDocumentValueHelper::deserializeValue(selected, type.name, types, NOTHING, assessed,
                    False, receiver);
            }
            if (XsdQNameOutputScope::retains(output)) {
                wire = retainLexicalContext(wire);
            }
            if (!omit_type && !XsdBase::getExpandedAttributes(wire."^attributes^").hasKey(type_qname(XSI_NS, "type"))) {
                wire."^attributes^" += XsdDocumentValueHelper::typeAttributes(type, output);
            }
            return wire;
        } catch (hash<ExceptionInfo> error) {
            if (error.err == SOAP_DESERIALIZATION_ERROR || error.err == "XSD-PARTICLE-ERROR") {
                rethrow SOAP_SERIALIZATION_ERROR, error.desc, error.arg;
            }
            rethrow;
        }
    }

    private static auto retainLexicalContext(auto value) {
        XsdQNameNamespaceScope scope(value.typeCode() == NT_HASH ? value."^attributes^" : NOTHING);
        if (value.typeCode() == NT_LIST) {
            list<auto> result();
            foreach auto child in (value) {
                push result, retainLexicalContext(child);
            }
            return result;
        }
        if (value.typeCode() == NT_STRING) {
            hash<string, string> bindings = {"":QNameInputNamespaces{""} ?? ""};
            foreach string token in (XsdListValueHelper::tokens(value)) {
                int colon = token.find(":");
                if (colon > 0) {
                    string prefix = token.substr(0, colon);
                    if (QNameInputNamespaces.hasKey(prefix)) {
                        bindings{prefix} = QNameInputNamespaces{prefix};
                    }
                }
            }
            return new XsdScopedLexicalValue(value, bindings);
        }
        if (value.typeCode() != NT_HASH) {
            return value;
        }
        value = {} + value;
        foreach string key in (keys value) {
            if (key == "^attributes^") {
                hash<auto> attributes = {} + value{key};
                foreach string attribute in (keys attributes) {
                    list<string> parts = attribute.split(":");
                    string identity = attribute.startsWith("{") ? attribute
                        : type_qname(parts.size() == 2 ? QNameInputNamespaces{parts[0]} : "", parts[-1]);
                    if (attribute != "xmlns" && !attribute.startsWith("xmlns:")
                            && !XsdBase::isInstanceAttribute(identity)) {
                        attributes{attribute} = retainLexicalContext(attributes{attribute});
                    }
                }
                value{key} = attributes;
            } else if ((!key.startsWith("^") && !key.startsWith(".")) || key =~ /^\^(value|cdata)[0-9]*\^$/) {
                value{key} = retainLexicalContext(value{key});
            }
        }
        return value;
    }

    private static checkXmlData(auto value) {
        if (value.typeCode() == NT_LIST) {
            foreach auto child in (value) {
                checkXmlData(child);
            }
            return;
        }
        if (value.typeCode() != NT_HASH) {
            if (exists value && !value.strp()) {
                throw SOAP_SERIALIZATION_ERROR, "generic XML content requires text or XML data";
            }
            return;
        }
        foreach string key in (keys value) {
            if (key == "^attributes^") {
                if (value{key}.typeCode() != NT_HASH) {
                    throw SOAP_SERIALIZATION_ERROR, "generic XML attributes require a hash";
                }
                foreach auto attribute in (value{key}.iterator()) {
                    if (!attribute.strp()) {
                        throw SOAP_SERIALIZATION_ERROR, "generic XML attributes require scalar text";
                    }
                }
            } else if (key =~ /^\^(value|cdata|comment)[0-9]*\^$/) {
                if (exists value{key} && !value{key}.strp()) {
                    throw SOAP_SERIALIZATION_ERROR, "generic XML text fragments require scalar text";
                }
            } else if (key == ".ns") {
                continue;
            } else if (key.startsWith("^") || key.startsWith(".")) {
                throw SOAP_SERIALIZATION_ERROR, sprintf("invalid generic XML metadata %Y", key);
            } else {
                checkXmlData(value{key});
            }
        }
    }
}

#! Validating provider for generic XML content
/** Accepts scalar text and XML-data records with the receiving generic type's content rules.
    @par Example
    A shipment connector carries partner XML extensions in an anyType field while validating
    globally declared quantities. An anySimpleType field accepts text without child elements.
    @since %WSDL 0.5.8
*/
public class XsdGenericDataType inherits AbstractDataProviderType {
    private {
        XsdBaseType component;
        bool optional;
    }
    #! constructs a provider for a generic builtin type
    /** @param component the receiving anyType or anySimpleType definition
        @param optional whether omission is permitted
        @throw XSD-SIMPLETYPE-ERROR the component is not a generic builtin
    */
    constructor(XsdBaseType component, bool optional = False) {
        if (!XsdGenericValueHelper::isGeneric(component)) {
            throw "XSD-SIMPLETYPE-ERROR", "a generic provider requires anyType or anySimpleType";
        }
        self.component = component;
        self.optional = optional;
    }
    private:internal deserializeMembers(hash<auto> members) {
        if (!(members.component instanceof XsdBaseType) || members.optional.typeCode() != NT_BOOLEAN) {
            throw "DESERIALIZATION-ERROR", "a generic provider requires its builtin component and optionality";
        }
        component = members.component;
        optional = members.optional;
