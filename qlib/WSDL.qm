    #! returns the receiving builtin type's name
    /** @return xsd:anyType or xsd:anySimpleType with optionality */
    string getName() {
        return (optional ? "*" : "") + "xsd:" + component.name;
    }
    #! describes the generic content contract
    /** @return a description of supported XML data */
    string getDesc() {
        return component.name == "anyType"
            ? "Preserves XML text, attributes and child elements; known declarations are validated. "
                "Use `XsdXmlValue` through the XML provider to retain the complete document."
            : "Accepts XML text without child elements or ordinary XML attributes.";
    }
    #! requires validation for every value
    /** @return NOTHING */
    *Type getValueType() {
        return;
    }
    #! prevents enclosing fields from bypassing validation
    /** @return an empty map */
    *hash<string, bool> getDirectTypeHash() {
        return {};
    }
    #! returns no outer list item type
    /** @return NOTHING */
    *AbstractDataProviderType getElementType() {
        return;
    }
    #! returns no fixed record fields
    /** @return NOTHING */
    *hash<string, AbstractDataField> getFields() {
        return;
    }
    #! reports scalar and XML-data input categories
    /** @param simple request simplified names
        @return accepted categories and optional omission
    */
    hash<string, bool> getAcceptTypeHash(*bool simple) {
        hash<string, bool> result = AbstractDataProviderType::get(SoftStringType).getAcceptTypeHash(simple);
        result.hash = True;
        if (optional) {
            result.nothing = True;
        } else {
            remove result.nothing;
        }
        return result;
    }
    #! reports the preserved native categories
    /** @param simple request simplified names
        @return scalar and XML-data categories and optional omission
    */
    hash<string, bool> getReturnTypeHash(*bool simple) {
        return getAcceptTypeHash(simple);
    }
    #! validates generic text or XML data without changing the input's shape
    /** @param value a scalar or XML-data record
        @return the checked input, or optional omission
        @throw MISSING-VALUE-ERROR a required value is absent
        @throw RUNTIME-TYPE-ERROR invalid generic content or selected type
    */
    auto acceptsValue(auto value) {
        bool check_identity = !(IdentityChecksSuspended ?? False);
        XsdIdentitySuspendScope identity_preparation();
        if (!exists value) {
            if (optional) {
                return;
            }
            throw "MISSING-VALUE-ERROR", "a generic XML value must be supplied";
        }
        Namespaces output = component.nsc.copy();
        XsdQNameOutputScope output_scope(output);
        XsdNativeTypeOutputScope types(component.nsc.getInstanceTypes());
        try {
            *XsdIdentityDocumentScope identity_document = check_identity ? new XsdIdentityDocumentScope() : NOTHING;
            auto checked = XsdDocumentValueHelper::serializePartValue(component, output, value, True);
        } catch (hash<ExceptionInfo> error) {
            if (error.err == SOAP_SERIALIZATION_ERROR || error.err == "XSD-PARTICLE-ERROR") {
                rethrow "RUNTIME-TYPE-ERROR", error.desc, error.arg;
            }
            rethrow;
        }
        return value;
    }
    #! returns whether the value is required
    /** @return True for a mandatory provider */
    bool isMandatory() {
        return !optional;
    }
    #! returns whether omission is permitted
    /** @return True for an optional provider */
    bool isOrNothingType() {
        return optional;
    }
    #! returns an optional provider retaining all content rules
    /** @return the optional variant */
    AbstractDataProviderType getOrNothingType() {
        XsdGenericDataType result = self.copy();
        result.optional = True;
        return result;
    }
    #! returns a mandatory provider retaining all content rules
    /** @return the mandatory variant */
    AbstractDataProviderType getMandatoryType() {
        XsdGenericDataType result = self.copy();
        result.optional = False;
        return result;
    }
    #! returns a simple example accepted by either generic type
    /** @param emap enclosing example context
        @param fname optional field context
        @return sample text, or optional omission
    */
    auto getExampleValue(*hash<string, bool> emap, *string fname) {
        return optional ? NOTHING : "sample";
    }
}

#! class for XSD base types
public class XsdBaseType inherits WSDL::XsdAbstractType {
    public {
        #! recognized builtin type names, including the module's legacy binary transport type
        /** @since %WSDL 0.5.8 */
        const BuiltinTypes = {
            "anyType": True, "anySimpleType": True, "string": True, "boolean": True, "decimal": True,
            "float": True, "double": True, "duration": True, "dateTime": True, "time": True, "date": True,
            "gYearMonth": True, "gYear": True, "gMonthDay": True, "gDay": True, "gMonth": True,
            "hexBinary": True, "base64Binary": True, "anyURI": True, "QName": True, "NOTATION": True,
            "normalizedString": True, "token": True, "language": True, "NMTOKEN": True, "NMTOKENS": True,
            "Name": True, "NCName": True, "ID": True, "IDREF": True, "IDREFS": True, "ENTITY": True,
            "ENTITIES": True, "integer": True, "nonPositiveInteger": True, "negativeInteger": True,
            "long": True, "int": True, "short": True, "byte": True, "nonNegativeInteger": True,
            "unsignedLong": True, "unsignedInt": True, "unsignedShort": True, "unsignedByte": True,
            "positiveInteger": True, "binary": True,
        };

        #! the built-in types whose \c whiteSpace value is not \c "collapse"
        /** XSD 1.0 part 2: \c xs:string has \c whiteSpace \c "preserve" and \c xs:normalizedString has
            \c "replace"; every other built-in atomic type has \c "collapse", as does \c xs:token and all the
            types derived from it

            @since %WSDL 0.5.8
        */
        const WhiteSpaceMap = {
            "string": "preserve",
            "anyType": "preserve",
            "anySimpleType": "preserve",
            "normalizedString": "replace",
        };
    }

    #! constructs a builtin XSD type with independent input and output prefix handling
    /** @param t the builtin local type name
        @param nsc the input/output namespace registry
        @param ns an explicit input prefix, or the canonical builtin prefix xsd
        @throw WSDL-NAMESPACE-ERROR an explicit input prefix cannot be resolved
        @note The canonical xsd spelling does not require an input declaration.
    */
    constructor(string t, Namespaces nsc, string ns = "xsd") : XsdAbstractType(t, "", nsc) {
        # Builtin identity/output prefixes do not require an input declaration spelled "xsd".
        self.ns = ns;
        ons = ns == "xsd" ? nsc.getOutputNamespacePrefix(XSD_NS) : nsc.translateOutputNamespacePrefix(ns);
    }

    #! returns the \c whiteSpace processing that applies to this built-in type
    /** @since %WSDL 0.5.8
    */
    string getWhiteSpace() {
        return XsdBaseType::WhiteSpaceMap{name} ?? "collapse";
    }

    #! serializes a value using the lexical representation of this built-in XSD type
    /** @param nsc the output namespace registry
        @param val the native or lexical input
        @param omitType omit the explicit XML type attribute
        @return the serialized scalar or XML-data value/attribute/child hash
        @throw SOAP-SERIALIZATION-ERROR the value cannot be converted to this builtin
        @note anyType XML-data records retain mixed content and namespace bindings; scalar inputs infer
        an available builtin type. anySimpleType permits text and instance metadata, without ordinary
        attributes or child elements. Complete XML carriers use the explicit schema/message XML APIs.
    */
    auto serializeValue(Namespaces nsc, auto val, *softbool omitType) {
        if ((name == "anyType" || name == "anySimpleType") && val.typeCode() == NT_HASH) {
            return XsdGenericValueHelper::encode(self, nsc, val, omitType);
        }
        if ((name == "anyType" || name == "anySimpleType")
                && (val instanceof XsdNotationValue || val instanceof XsdQNameValue)) {
            XsdBaseType inferred(val instanceof XsdNotationValue ? "NOTATION" : "QName",
                new Namespaces({}, self.nsc));
            return XsdDocumentValueHelper::serializeValue(inferred, nsc, val, False, GenericDocumentValueResult);
        }
        if (name == "QName" || name == "NOTATION") {
            hash<string, string> bindings = XsdScopedLexicalContext::serializationBindings(nsc,
                val.typeCode() == NT_HASH ? val."^attributes^" : NOTHING);
            auto input = XsdScalarTextHelper::value(val, SOAP_SERIALIZATION_ERROR);
            XsdQNameValue value = name == "NOTATION"
                ? XsdNotationValueHelper::resolve(input, self.nsc.getNotationRegistry(), SOAP_SERIALIZATION_ERROR, bindings).asQName()
                : XsdQNameValueHelper::resolve(input, SOAP_SERIALIZATION_ERROR, bindings);
            hash<auto> result();
            if (val.typeCode() == NT_HASH) {
                foreach string key in (keys val) {
                    if (key.startsWith("^comment")) {
                        result{key} = val{key};
                    }
                }
            }
            auto lexical = XsdQNameOutputScope::retains(nsc) ? value : value.getLexicalValue();
            hash<auto> attributes();
            if (!XsdQNameOutputScope::retains(nsc) && value.getPrefix() != "xml" && value.getNamespaceUri()) {
                attributes{value.getPrefix() ? "xmlns:" + value.getPrefix() : "xmlns"} = value.getNamespaceUri();
            }
            if (!omitType) {
                attributes += XsdDocumentValueHelper::typeAttributes(self, nsc);
            }
            if (attributes) {
                result."^attributes^" = attributes;
            }
            if (result) {
                result."^value^" = lexical;
                return result;
            }
            return lexical;
        }
        *hash<auto> comments;
        if (val.typeCode() == NT_HASH) {
            foreach string k in (keys val) {
                if (k =~ /^\^comment/) {
                    comments{k} = val{k};
                }
            }
            val = XsdScalarTextHelper::value(val, SOAP_SERIALIZATION_ERROR);
        }
        # issue #5411: apply "whiteSpace" processing to the lexical value
        if (val.typeCode() == NT_STRING && !XsdBinaryLexicalHelper::isType(name)) {
            val = XsdSimpleType::normalizeWhiteSpace(val, getWhiteSpace());
        }
        *string type;
        # set type according to Qore type if xsd type is anyType
        if (name == "anyType") {
            # we have to specify the type in this case
            omitType = False;
            type = any_type_map{val.type()};
            if ((val.typeCode() == NT_FLOAT || val.typeCode() == NT_NUMBER) && (val.nanp() || val.infp())) {
                type = "double";
            }
            if (!type) {
                throw SOAP_SERIALIZATION_ERROR, sprintf("cannot serialize xsd type anyType from Qore type %y", val.type());
            }
        } else {
            type = name;
        }
        if (XsdIntegerLexicalHelper::Types{type}) {
            string lexical = XsdIntegerLexicalHelper::lexical(type, val, SOAP_SERIALIZATION_ERROR);
            if (val.typeCode() != NT_INT) {
                val = lexical;
            }
        }
        if (XsdBuiltinListHelper::isType(type)) {
            val = XsdBuiltinListHelper::lexical(type, val, SOAP_SERIALIZATION_ERROR);
        } else if (XsdNameLexicalHelper::isType(type)) {
            val = XsdNameLexicalHelper::lexical(type, val, SOAP_SERIALIZATION_ERROR);
        }
        if (XsdTextLexicalHelper::isType(type)) {
            val = XsdTextLexicalHelper::lexical(type, val, SOAP_SERIALIZATION_ERROR);
        }
        if (XsdCalendarLexicalHelper::isType(type)) {
            val = XsdCalendarLexicalHelper::lexical(type, val, SOAP_SERIALIZATION_ERROR);
        }
        switch (type) {
            case "anySimpleType": {
                if (exists val && !val.strp()) {
                    throw SOAP_SERIALIZATION_ERROR, sprintf("type anySimpleType requires a scalar value, got %Y",
                        val.type());
                }
                val = string(val);
                break;
            }
            case "date":
            case "dateTime":
            case "time":
                break;

            case "boolean":
                val = XsdBooleanLexicalHelper::decode(val, SOAP_SERIALIZATION_ERROR) ? "true" : "false";
                break;

            case "base64Binary":
            case "hexBinary":
                val = XsdBinaryLexicalHelper::encode(type, val, SOAP_SERIALIZATION_ERROR);
                break;

            case "binary":
                # used for HTTP binding only
                val = binary(val);
                break;

            case "token":
                if (!val.strp()) {
                    throw SOAP_SERIALIZATION_ERROR, sprintf("type %y only accepts values that are convertible to strings; type %y supplied", type, val.type());
                }
                val = XsdSimpleType::normalizeWhiteSpace(val.toString(), "collapse");
                break;

            case "normalizedString":
                if (!val.strp()) {
                    throw SOAP_SERIALIZATION_ERROR, sprintf("type %y only accepts values that are convertible to strings; type %y supplied", type, val.type());
                }
                val = XsdSimpleType::normalizeWhiteSpace(val.toString(), "replace");
                break;

            case "string":
            case "anyURI":
            case "language":
            case "Name":
            case "NCName":
            case "QName":
            case "NOTATION":
            case "NMTOKEN":
            case "NMTOKENS":
            case "ID":
            case "IDREF":
            case "IDREFS":
            case "ENTITY":
            case "ENTITIES":
            case "integer":
            case "long":
            case "int":
            case "short":
            case "byte":
            case "unsignedLong":
            case "unsignedInt":
            case "unsignedShort":
            case "unsignedByte":
            case "positiveInteger":
            case "negativeInteger":
            case "nonPositiveInteger":
            case "nonNegativeInteger":
                # pass through without transformation
                break;

            case "decimal":
                val = XsdDecimalLexicalHelper::lexical(val, SOAP_SERIALIZATION_ERROR);
                break;

            case "float":
            case "double":
                val = XsdIeeeLexicalHelper::lexical(type, val, SOAP_SERIALIZATION_ERROR);
                break;

            case "duration":
                val = XsdDurationLexicalHelper::lexical(val, SOAP_SERIALIZATION_ERROR);
                break;

            case "gYear":
            case "gYearMonth":
            case "gMonthDay":
            case "gMonth":
            case "gDay":
                break;

            default:
                throw SOAP_SERIALIZATION_ERROR, sprintf("don't know how to serialize type %y", type);
        }

        #printf("DEBUG: FORCE: type: %y, nstype: %y, val: %y\n", type, nstype, val);
        if (name == "anyType" && GenericDocumentValueResult) {
            XsdBaseType actual(type, new Namespaces({}, self.nsc));
            XsdDocumentValueCapture capture(actual);
            GenericDocumentValueResult.actual_type = actual;
            GenericDocumentValueResult.identity = capture.valueIdentity(val, val, SOAP_SERIALIZATION_ERROR, True);
        }
        if (omitType) {
            if (comments) {
                return comments + (
                    "^value^": val
                );
            } else
                return val;
        } else {
            return comments + {
                "^attributes^": XsdDocumentValueHelper::typeAttributes(self, nsc, type),
                "^value^": val,
            };
        }
    }

    #! converts a builtin lexical value to its public native representation
    /** @param en the containing element name
        @param tmap the resolved type map
        @param mrh the multireference value map
        @param val the scalar input or its XML value/attribute hash
        @return the converted builtin value, or lexical XML data for structured anyType content
        @throw SOAP-DESERIALIZATION-ERROR the value cannot be converted to this builtin
    */
    auto deserializeValue(string en, hash<string, XsdAbstractType> tmap, *hash<auto> mrh, auto val) {
        XsdQNameNamespaceScope qname_scope(val.typeCode() == NT_HASH ? val."^attributes^" : NOTHING);
        XsdAbstractType selected = XsdTypeSubstitutionHelper::select(\val, self, tmap, en);
        if (selected !== self) {
            return XsdDocumentValueHelper::deserializeValue(selected, en, tmap, mrh, val);
        }
        if (name == "anyType") {
            return XsdGenericValueHelper::decode(self, tmap, mrh, val);
        }
        string type = name;
        if (val.typeCode() == NT_HASH) {
            XsdBase::validateSimpleAttributes(val."^attributes^", name);
            val = XsdScalarTextHelper::value(val, SOAP_DESERIALIZATION_ERROR);
        }

        # issue #5411: apply "whiteSpace" processing to the lexical value
        if (val.typeCode() == NT_STRING) {
            val = XsdSimpleType::normalizeWhiteSpace(val, XsdBaseType::WhiteSpaceMap{type} ?? "collapse");
        }
        if (XsdIntegerLexicalHelper::Types{type}) {
            return XsdIntegerLexicalHelper::decode(type,
                XsdIntegerLexicalHelper::lexical(type, val, SOAP_DESERIALIZATION_ERROR));
        }
        if (XsdBuiltinListHelper::isType(type)) {
            return XsdBuiltinListHelper::lexical(type, val, SOAP_DESERIALIZATION_ERROR);
        }
        if (type == "NOTATION") {
            return XsdNotationValueHelper::resolve(val, nsc.getNotationRegistry(), SOAP_DESERIALIZATION_ERROR, QNameInputNamespaces);
        }
        if (type == "QName") {
            return XsdQNameValueHelper::native(XsdQNameValueHelper::resolve(val,
                SOAP_DESERIALIZATION_ERROR, QNameInputNamespaces));
        }
        if (XsdNameLexicalHelper::isType(type)) {
            return XsdNameLexicalHelper::lexical(type, val, SOAP_DESERIALIZATION_ERROR);
        }
        if (XsdTextLexicalHelper::isType(type)) {
            string text = XsdTextLexicalHelper::lexical(type, val, SOAP_DESERIALIZATION_ERROR);
            return nsc.opt_empty_string_is_nothing && !exists val ? NOTHING : text;
        }
        if (XsdCalendarLexicalHelper::isType(type)) {
            return XsdCalendarLexicalHelper::decode(type, val, SOAP_DESERIALIZATION_ERROR);
        }

        switch (type) {
            case "anySimpleType":
            case "string":
            case "token":
            case "normalizedString":
            case "anyURI":
            case "language":
            case "Name":
            case "NCName":
            case "QName":
            case "NOTATION":
            case "NMTOKEN":
            case "NMTOKENS":
            case "ID":
            case "IDREF":
            case "IDREFS":
            case "ENTITY":
            case "ENTITIES":
                if (exists val && !val.strp()) {
                    throw SOAP_DESERIALIZATION_ERROR, sprintf("type %y does not accept values of type %y (val: %y)", type, val.type(), val);
                }
                return nsc.opt_empty_string_is_nothing ? val : string(val);

            case "boolean":
                return XsdBooleanLexicalHelper::decode(val, SOAP_DESERIALIZATION_ERROR);

            case "decimal":
                return XsdDecimalLexicalHelper::decode(
                    XsdDecimalLexicalHelper::lexical(val, SOAP_DESERIALIZATION_ERROR));

            case "base64Binary":
            case "hexBinary":
                return XsdBinaryLexicalHelper::decode(type, val, SOAP_DESERIALIZATION_ERROR);

            case "binary":
                # used for HTTP binding only
                if (val.typeCode() == NT_BINARY) {
                    return val;
                } else {
                    return val.empty() ? binary() : binary(val);
                }

            case "float":
            case "double":
                return XsdIeeeLexicalHelper::decode(type, val, SOAP_DESERIALIZATION_ERROR);

            case "duration":
                return XsdDurationLexicalHelper::lexical(val, SOAP_DESERIALIZATION_ERROR);

            default: {
                throw SOAP_DESERIALIZATION_ERROR, sprintf("don't know how to handle type %y", name);
            }
        }
    }

    #! maps scalar types without dedicated validators to their soft provider equivalents
    /** Integer, boolean and IEEE providers validate their XML lexical spaces before conversion.
        Other scalar providers use soft equivalents to accept convertible input values.
    */
    const SoftTypeMap = {
        "int": SoftIntType,
        "float": SoftFloatType,
        "date": SoftDateType,
        "string": SoftStringType,
    };

    #! returns the data provider type used to accept values for this XSD type
    /** @return a validating scalar provider or the scalar's soft provider equivalent
        @note Integer providers preserve exact values outside signed 64-bit range as strings.
        Decimal providers preserve high precision and noncanonical lexical forms as strings.
        IEEE providers validate complete lexical input and round at the declared float/double precision.
        Duration providers retain exact XML text and validate relative-date conversion without losing microseconds.
        Text providers apply the builtin whitespace rule; builtin token lists require at least one item.
        Generic providers validate XML-data shapes and anyType's known declarations. Use explicit XML
        providers to retain complete XML metadata around an anySimpleType scalar.
    */
    AbstractDataProviderType getDataProviderType() {
        if (name == "anyType" || name == "anySimpleType") {
            return new XsdGenericDataType(self);
        }
        if (name == "QName") {
            return new XsdQNameDataType();
        }
        if (name == "NOTATION") {
            return new XsdNotationDataType(nsc.getNotationRegistry());
        }
        # XSD booleans need a type that parses string values according to the XSD boolean lexical space; a plain
        # "softbool" would convert the string "false" to True
        if (name == "boolean") {
            return XsdBooleanType;
        }
        if (name == "decimal") {
            return new XsdDecimalDataType();
        }
        if (name == "duration") {
            return new XsdDurationDataType();
        }
        if (XsdBinaryLexicalHelper::isType(name)) {
            return new XsdBinaryDataType(name);
        }
        if (XsdIntegerLexicalHelper::Types{name}) {
            return new XsdIntegerDataType(name);
        }
        if (XsdIeeeLexicalHelper::isType(name)) {
            return new XsdIeeeDataType(name);
        }
        if (XsdCalendarLexicalHelper::isType(name)) {
            return new XsdCalendarDataType(name);
        }
        if (XsdBuiltinListHelper::isType(name)) {
            return new XsdSizedRestrictionDataType(<XsdSizedFacetInfo>{
                "name": name, "kind": "tokens", "white_space": "collapse", "min_length": 1,
                "name_type": name,
            }, AbstractDataProviderType::get(SoftStringType));
        }
        Type type = getDataProviderBaseType();
        if (type == StringType && name != "anySimpleType") {
            return new XsdSizedRestrictionDataType(<XsdSizedFacetInfo>{
                "name": name, "kind": "string", "white_space": getWhiteSpace(),
                "name_type": XsdNameLexicalHelper::isType(name) ? name : NOTHING,
                "text_type": XsdTextLexicalHelper::isType(name) ? name : NOTHING,
            }, AbstractDataProviderType::get(SoftStringType));
        }
        return AbstractDataProviderType::get(SoftTypeMap{type.getName()} ?? type);
    }

    #! returns the %Qore type closest to the XSD type
    /** @return the legacy closest native type; it does not describe every lossless output alternative
        @note Use @ref WSDL::XsdBaseType::getDataProviderType() "XsdBaseType::getDataProviderType()" for the
        validated conversion contract. Calendar date providers can also return strings for missing timezones
        or years outside the native range, and scalar providers enforce XSD syntax before native conversion.
    */
    Type getDataProviderBaseType() {
        switch (name) {
            case "byte":
            case "short":
            case "int":
            case "integer":
            case "long":
            case "unsignedByte":
            case "unsignedShort":
            case "unsignedInt":
            case "unsignedLong":
            case "negativeInteger":
            case "nonNegativeInteger":
            case "nonPositiveInteger":
            case "positiveInteger":
                return IntType;

            case "decimal":
            case "float":
            case "double":
                return FloatType;

            case "date":
            case "dateTime":
            case "time":
                return DateType;

            case "boolean":
                return BoolType;

            case "string":
            case "token":
            case "normalizedString":
            case "anyURI":
            case "language":
            case "Name":
            case "NCName":
            case "QName":
            case "NOTATION":
            case "NMTOKEN":
            case "NMTOKENS":
            case "ID":
            case "IDREF":
            case "IDREFS":
            case "ENTITY":
            case "ENTITIES":
            case "duration":
            case "gYear":
            case "gYearMonth":
            case "gMonthDay":
            case "gMonth":
            case "gDay":
                return StringType;

            case "base64Binary":
                return Base64BinaryType;

            case "hexBinary":
                return HexBinaryType;

            case "binary":
                return BinaryType;
        }

        # for anyType or any unknown type
        return AbstractDataProviderType::anyType;
    }
}

#! class for XSD array types; supports single and multi-dimensional arrays
public class XsdArrayType inherits WSDL::XsdAbstractType {
    private {
        bool finalized;
        hash<string, bool> blocked_substitutions();
        bool abstract_type = False;
    }

    public {
        *hash<auto> typeinfo;
        XsdAbstractType elementType;

        #! number of dimensions for multi-dimensional arrays (1 = single dimension)
        int dimensions = 1;
    }

    #! constructs a legacy encoded array type
    /** @param t the array type name
        @param ns the input namespace prefix
        @param arrayType the encoded item type and dimension spelling
        @param nsc the declaration namespace registry
        @param unresolved the schema resolution queue
        @param final_derivations the enclosing complex type's effective final exclusions
        @param blocked_substitutions the enclosing complex type's instance exclusions
        @param abstract_type the enclosing declaration's abstract flag
        @throw WSDL-ERROR malformed or unresolved array declaration
        @throw WSDL-NAMESPACE-ERROR malformed or unbound item QName
    */
    constructor(string t, string ns, string arrayType, Namespaces nsc, XsdLateResolverHelper unresolved,
            *hash<string, bool> final_derivations, *hash<string, bool> blocked_substitutions, *bool abstract_type)
            : XsdAbstractType(t, ns, nsc, final_derivations) {
        self.blocked_substitutions = blocked_substitutions ?? {};
        self.abstract_type = abstract_type ?? False;
        # Parse array dimensions - handles both [] and [,] notation
        # SOAP 1.1 Section 5.4.2 supports:
        # - Single dimension: type[] or type[n]
        # - Multi-dimension: type[,] or type[n,m] (comma-separated)
        # - Nested arrays: type[][] (multiple bracket pairs)

        # Count dimensions from bracket notation using extract mode (x//)
        # Handle comma-separated dimensions first (e.g., [,] = 2D, [n,m] = 2D)
        # Note: use + not * to only match brackets with actual content
        *list<*string> match = (arrayType =~ x/\[([,\d]+)\]$/);
        if (match) {
            *string dimSpec = match[0];
            # Count commas + 1 for comma-separated dimensions (e.g., [,] = 2D, [,,] = 3D)
            # Use regex_subst to remove commas and calculate count from length difference
            string noCommas = regex_subst(dimSpec, ",", "", RE_Global);
            int commaCount = dimSpec.length() - noCommas.length();
            dimensions = commaCount + 1;
            # Remove the bracket suffix
            arrayType =~ s/\[([,\d]+)\]$//;
        }

        # Handle empty bracket pairs (e.g., type[][] = 2D, type[] = 1D)
        # Count all [] pairs and set dimensions to that count
        int bracketCount = 0;
        while (arrayType =~ /\[\]$/) {
            bracketCount++;
            arrayType =~ s/\[\]$//;
        }
        if (bracketCount > 0) {
            dimensions = bracketCount;
        }

        if (!nsc.doType(arrayType, \typeinfo, \elementType)) {
            unresolved.add(self);
        } else {
            finalized = True;
        }
    }

    AbstractDataProviderType getDataProviderType() {
        # Build nested list type for multi-dimensional arrays
        AbstractDataProviderType innerType = elementType.getDataProviderType();
        for (int i = 0; i < dimensions; i++) {
            innerType = new ListDataType(innerType);
        }
        return innerType;
    }

    finalize(hash<string, XsdAbstractType> tmap, Namespaces nsc, *hash<string, XsdGroup> groupMap,
            *hash<string, XsdAttributeGroup> attrGroupMap, *XsdLateResolverHelper unresolved) {
        if (finalized) {
            return;
        }
        finalized = True;
        on_error finalized = False;

        XsdAbstractType t = elementType ?? tmap_get(tmap, type_qname(typeinfo.uri, typeinfo.val));
        if (t instanceof XsdComplexType) {
            cast<XsdComplexType>(t).finalize(tmap, nsc, groupMap, attrGroupMap, unresolved);
        } else if (t instanceof XsdArrayType) {
            cast<XsdArrayType>(t).finalize(tmap, nsc, groupMap, attrGroupMap, unresolved);
        }
        elementType = t;
    }

    #! returns the enclosing complex declaration's effective instance exclusions
    /** @return an independent extension/restriction method-name set
        @since %WSDL 0.5.8
    */
    hash<string, bool> getBlockedSubstitutions() {
        return blocked_substitutions;
    }

    #! returns the enclosing declaration's abstract flag
    /** @return True when the array type cannot directly validate an instance
        @since %WSDL 0.5.8
    */
    bool isAbstract() {
        return abstract_type;
    }

    auto serializeValue(Namespaces nsc, auto val, *softbool omitType) {
        if (isAbstract()) {
            throw SOAP_SERIALIZATION_ERROR, sprintf("abstract type %Y cannot validate an instance", name);
        }
        switch (name) {
            case "binary": {
                int t = val.typeCode();
                if (t === NT_STRING) {
                    val = binary(val);
                } else if (t !== NT_BINARY) {
                    throw SOAP_SERIALIZATION_ERROR, sprintf("cannot serialize type %y from type %y; requires "
                        "string or binary", name, t);
                }
                return val;
            }

            default: {
                # this must be an untyped hash
                hash rv;
                if (!omitType) {
                    # Build arrayType attribute with proper dimension notation
                    string dimSuffix = dimensions > 1
                        ? "[" + strmul(",", dimensions - 1) + "]"
                        : "[]";
                    rv."^attributes^" = {"soapenc:arrayType": elementType.getNameWithNS() + dimSuffix};
                }
                if (val.typeCode() == NT_HASH && val.size() == 1) {
                    rv += {
                        "soapenc:" + val.firstKey(): map serializeElement(nsc, $1, omitType, dimensions),
                            val.firstValue(),
                    };
                } else {
                    rv += {
                        "^value^": (map serializeElement(nsc, $1, omitType, dimensions), val),
                    };
                }
                return rv;
            }
        }
    }

    #! Serialize a single element, handling nested dimensions for multi-dimensional arrays
    private auto serializeElement(Namespaces nsc, auto val, *softbool omitType, int remainingDims) {
        if (remainingDims > 1 && val.typeCode() == NT_LIST) {
            # For multi-dimensional arrays, recursively serialize nested lists
            return map serializeElement(nsc, $1, omitType, remainingDims - 1), val;
        }
        return XsdDocumentValueHelper::serializeValue(elementType, nsc, val, omitType);
    }

    auto deserializeValue(string en, hash<string, XsdAbstractType> tmap, *hash<auto> mrh, auto val) {
        if (isAbstract()) {
            throw SOAP_DESERIALIZATION_ERROR, sprintf("abstract type %Y cannot validate an instance", name);
        }
        XsdQNameNamespaceScope qname_scope(val.typeCode() == NT_HASH ? val."^attributes^" : NOTHING);
        switch (name) {
            case "binary": {
                if (val.typeCode() != NT_BINARY) {
                    throw SOAP_DESERIALIZATION_ERROR, sprintf("cannot deserialize type %y from type %y; requires "
                        "binary", name, val.typeName());
                }
                return val;
            }

            default: {
                # remove any namespace marker from value
                *string ns = remove val.".ns";
                softint attr = val.hasKey("^attributes^");
                if (val.typeCode() == NT_HASH) {
                    # Handle ^value^ key specially - return deserialized content directly
                    if (val.hasKey("^value^")) {
                        return map deserializeElement(en, tmap, mrh, $1, dimensions), val."^value^";
                    }
                    # For other single-key hashes, preserve the element name
                    if (val.size() == (1 + attr)) {
                        string ename = (map $1, keys val, $1 != "^attributes^")[0];
                        return {ename: (map deserializeElement(en, tmap, mrh, $1, dimensions), val{ename})};
                    }
                }
                return map deserializeElement(en, tmap, mrh, $1, dimensions), val;
            }
        }
    }

    #! Deserialize a single element, handling nested dimensions for multi-dimensional arrays
    private auto deserializeElement(string en, hash<string, XsdAbstractType> tmap, *hash<auto> mrh, auto val,
            int remainingDims) {
        if (remainingDims > 1 && val.typeCode() == NT_LIST) {
            # For multi-dimensional arrays, recursively deserialize nested lists
            return map deserializeElement(en, tmap, mrh, $1, remainingDims - 1), val;
        }
        return XsdDocumentValueHelper::deserializeValue(elementType, en, tmap, mrh, val);
    }
}

#! XSD typed data class
public class XsdTypedData inherits WSDL::XsdNamedData {
    public {
        *hash<auto> typeinfo;
        XsdAbstractType type;
    }

    constructor(reference e) : XsdNamedData(\e) {
    }
}

#! XSD attribute class
public class XsdAttribute inherits WSDL::XsdTypedData {
    public {
        string use = "optional";

        #! expanded name of a referenced global attribute, captured at the declaration
        /** @since %WSDL 0.5.8 */
        *hash<auto> refInfo;

        #! namespace URI of the attribute declaration; empty for an unqualified attribute
        /** @since %WSDL 0.5.8 */
        string namespaceUri = "";

        #! original default lexical form, if supplied or inherited from a referenced declaration
        /** @since %WSDL 0.5.8 */
        *string defaultLexical;
        #! original fixed lexical form, if supplied or inherited from a referenced declaration
        /** @since %WSDL 0.5.8 */
        *string fixedLexical;

        const AllowedUseValues = {
            "optional": True,
            "required": True,
            "prohibited": True,
        };
    }

    private {
        auto constraintValue;
        transient *hash<string, string> constraintNamespaces;
        bool constraints_resolved = False;
    }

    #! constructs an attribute declaration or reference
    /** @param attr the parsed XML attribute declaration
        @param nsc its declaration namespace context
        @param n_type an already resolved type, if supplied
        @param unresolved the schema's late resolution queue
        @param global_attribute True for a schema-level declaration
        @throw WSDL-ERROR contradictory declaration or non-simple attribute type
        @throw WSDL-NAMESPACE-ERROR invalid or unresolved QName prefix
        @throw XSD-ATTRIBUTE-ERROR invalid use value
    */
    constructor(hash<auto> attr, Namespaces nsc, *XsdAbstractType n_type, XsdLateResolverHelper unresolved,
            bool global_attribute = False) : XsdTypedData(\attr) {
        unresolved.addNotationUse(self);
        NamespacePrefixHelper declaration(nsc, attr."^attributes^");
        *hash<auto> aa = attr."^attributes^";
        if (exists aa.use) {
            if (!AllowedUseValues{aa.use}) {
                throw "XSD-ATTRIBUTE-ERROR", sprintf("attribute %Y: use %Y is unrecognized; recognized values: %Y",
                    name, aa.use, keys AllowedUseValues);
            }
            use = aa.use;
        }
        if ((!aa.name && !aa.ref) || (exists aa.name && exists aa.ref)
                || (aa.ref && (exists aa.type || exists aa.form || attr.hasKey("simpleType")))
                || (exists aa.type && attr.hasKey("simpleType"))
                || (exists aa.default && exists aa.fixed)
                || (exists aa.default && use != "optional")
                || (global_attribute && (aa.ref || exists aa.use || exists aa.form))
                || (exists aa.form && aa.form != "qualified" && aa.form != "unqualified")
                || (select keys attr, $1 != "^attributes^" && $1 != "ns" && $1 != "annotation"
                    && $1 != "simpleType")
                || (attr.hasKey("simpleType") && attr.simpleType.typeCode() != NT_HASH)) {
            throw WSDL_ERROR, sprintf("invalid or contradictory attribute declaration %Y", aa);
        }
        if (global_attribute || (aa.form ?? nsc.attribute_form_default) == "qualified") {
            namespaceUri = nsc.getTargetNamespaceUri() ?? "";
        }
        if (aa.name) {
            nsc.validateDeclarationName(aa.name);
        }
        defaultLexical = aa.default;
        fixedLexical = aa.fixed;
        if (exists defaultLexical || exists fixedLexical) {
            constraintNamespaces = XsdQNameContextHelper::capture(fixedLexical ?? defaultLexical, nsc);
        }
        if (aa.ref) {
            refInfo = nsc.getTypeHash(aa.ref);
            name = refInfo.val;
            namespaceUri = refInfo.uri;
            unresolved.add(self);
        } else {
            if (n_type) {
                type = n_type;
            } else if (exists aa.type) {
                nsc.doType(aa.type, \typeinfo, \type);
            } else if (attr.hasKey("simpleType")) {
                type = new XsdSimpleType(attr.simpleType, nsc, unresolved, False,
                    sprintf("simpleType for attribute %Y", name));
            } else {
                type = nsc.getBaseType("anySimpleType");
            }
            if (type) {
                validateType();
            } else {
                unresolved.add(self);
            }
        }
        if (exists defaultLexical || exists fixedLexical) {
            unresolved.add(self);
        }
    }

    #! verifies that the resolved attribute type is simple
    /** @throw WSDL-ERROR the attribute has no type or a complex type
        @since %WSDL 0.5.8
    */
    validateType() {
        if (!(type instanceof XsdSimpleType)
                && (!(type instanceof XsdBaseType) || type.name == "anyType")) {
            throw WSDL_ERROR, sprintf("attribute %Y requires a resolved simple type, got %Y", name,
                type ? type.name : NOTHING);
        }
    }

    #! initializes typed value constraints after resolving the attribute's simple type
    /** @param declaration a referenced global attribute declaration, if any
        @throw WSDL-ERROR an invalid constraint value or inconsistent fixed override
        @since %WSDL 0.5.8
    */
    resolveConstraints(*XsdAttribute declaration) {
        if (constraints_resolved) {
            return;
        }
        *string own_default = defaultLexical;
        *string own_fixed = fixedLexical;
        if (!exists defaultLexical && !exists fixedLexical && declaration) {
            defaultLexical = declaration.defaultLexical;
            fixedLexical = declaration.fixedLexical;
            constraintValue = declaration.constraintValue;
        }
        on_exit {
            remove constraintNamespaces;
        }
        if (hasValueConstraint() && (!declaration || exists own_default || exists own_fixed)) {
            if (XsdTypeDerivationHelper::isIdDerived(type)) {
                throw WSDL_ERROR, sprintf("ID-derived attribute %Y cannot have a default or fixed constraint", name);
            }
            try {
                XsdQNameNamespaceScope declaration_scope(XsdQNameContextHelper::attributes(constraintNamespaces ?? {}), True);
                XsdConstraintLexicalScope canonical_scope();
                XsdDocumentValueCapture capture(type);
                auto converted = type.deserializeValue(name, new hash<string, XsdAbstractType>(), NOTHING,
                    fixedLexical ?? defaultLexical);
                *hash<XsdUnionValueIdentity> identity = capture.valueIdentity(fixedLexical ?? defaultLexical,
                    converted, SOAP_DESERIALIZATION_ERROR);
                # Attribute declarations and reference uses share a-props-correct.2.
                if (exists identity.constraint_lexical && identity.constraint_lexical != (fixedLexical ?? defaultLexical)) {
                    type.deserializeValue(name, new hash<string, XsdAbstractType>(), NOTHING, identity.constraint_lexical);
                }
                constraintValue = converted;
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err == "PROGRAM-INTERRUPTED" || ex.err == "THREAD-CANCELLED") {
                    rethrow;
                }
                throw WSDL_ERROR, sprintf("invalid value constraint for attribute %Y: %s: %s", name, ex.err, ex.desc);
            }
        }
        if (declaration && exists declaration.fixedLexical
                && (exists own_default || (exists own_fixed
                    && !XsdScalarValueHelper::equal(type, constraintValue, declaration.getDefaultValue())))) {
            throw WSDL_ERROR, sprintf("attribute %Y cannot override its declaration's fixed value", name);
        }
        constraints_resolved = True;
    }

    #! returns whether this attribute has a default or fixed constraint
    /** @return True if either constraint is present, including an empty string
        @since %WSDL 0.5.8
    */
    bool hasValueConstraint() {
        return exists defaultLexical || exists fixedLexical;
    }

    #! returns the typed value supplied for an absent optional attribute
    /** @return the default/fixed value, or NOTHING when there is no constraint
        @since %WSDL 0.5.8
    */
    auto getDefaultValue() {
        return constraintValue;
    }

    #! returns an absent attribute's default after checking its instance requirements
    /** @return the compiled default/fixed value, retaining declaration QName identity
        @throw SOAP-DESERIALIZATION-ERROR the default requires an unavailable unparsed entity
        @note The default has already been resolved in its declaration namespace context.
        Instance namespace bindings cannot reinterpret its lexical prefixes.
        @par Example
        Apply an omitted catalog category attribute using its schema-defined namespace,
        while rejecting an ENTITY default that lacks a document declaration.
        @since %WSDL 0.5.8
    */
    auto getInstanceDefaultValue() {
        if (hasValueConstraint()) {
            try {
                Namespaces validation_namespaces({});
                *XsdDocumentValueResult captured = IdentityTupleNode && !IdentityChecksSuspended
                    ? new XsdDocumentValueResult() : NOTHING;
                XsdDocumentValueHelper::serializeValue(type, validation_namespaces, constraintValue, True,
                    captured, True);
                XsdIdentityTupleScope::attribute(self, captured.identity);
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err == SOAP_SERIALIZATION_ERROR) {
                    rethrow SOAP_DESERIALIZATION_ERROR, ex.desc, ex.arg;
                }
                rethrow;
            }
        }
        return constraintValue;
    }

    #! returns the output XML name for this attribute's namespace and local name
    /** @param nsc the output namespace registry
        @return an unqualified local name or an allocated prefix and local name
        @since %WSDL 0.5.8
    */
    string getXmlName(Namespaces nsc) {
        return namespaceUri ? nsc.getOutputNamespacePrefix(namespaceUri) + ":" + name : name;
    }

    #! merges attribute uses without losing colliding local names
    /** @param inherited existing attribute uses
        @param added one or more maps of attribute uses to incorporate
        @param override_existing True when derivation supplies a replacement use
        @return uses keyed by local name where unique, and by expanded name for every colliding local name
        @throw WSDL-ERROR duplicate expanded attribute uses outside derivation
        @since %WSDL 0.5.8
    */
    static hash<string, XsdAttribute> mergeMaps(hash<string, XsdAttribute> inherited,
            softlist<hash<string, XsdAttribute>> added, bool override_existing = False) {
        hash<string, XsdAttribute> expanded();
        hash<string, int> counts();
        foreach XsdAttribute attr in (inherited.iterator()) {
            expanded{type_qname(attr.namespaceUri, attr.name)} = attr;
            ++counts{attr.name};
        }
        foreach hash<string, XsdAttribute> attributes in (added) {
            foreach XsdAttribute attr in (attributes.iterator()) {
                string identity = type_qname(attr.namespaceUri, attr.name);
                if (expanded.hasKey(identity)) {
                    if (!override_existing) {
                        throw WSDL_ERROR, sprintf("duplicate attribute use %Y", identity);
                    }
                } else {
                    ++counts{attr.name};
                }
                expanded{identity} = attr;
            }
        }
        hash<string, XsdAttribute> result();
        foreach string identity in (keys expanded) {
            XsdAttribute attr = expanded{identity};
            result{counts{attr.name} == 1 ? attr.name : identity} = attr;
        }
        return result;
    }

    #! parses an attribute lexical value and checks its fixed constraint
    /** @param val the XML attribute value
        @return the typed attribute value
        @throw SOAP-DESERIALIZATION-ERROR an invalid value, fixed-value mismatch or unavailable ENTITY declaration
    */
    auto getValue(string val) {
        *XsdDocumentValueResult captured = IdentityTupleNode && !IdentityChecksSuspended
            ? new XsdDocumentValueResult() : NOTHING;
        auto result = XsdDocumentValueHelper::deserializeValue(type, name,
            new hash<string, XsdAbstractType>(), NOTHING, val, False, captured, True);
        XsdIdentityTupleScope::attribute(self, captured.identity);
        checkFixedValue(result, SOAP_DESERIALIZATION_ERROR);
        return result;
    }

    private checkFixedValue(auto value, string error) {
        if (exists fixedLexical && !XsdScalarValueHelper::equal(type, value, constraintValue)) {
            throw error, sprintf("attribute %Y must have fixed value %Y, got %Y", name, constraintValue, value);
        }
    }

    #! returns the attribute value serialized according to the attribute's type
    /** attribute values must be converted like element values; otherwise dates, booleans, and binary values are
        written to the XML message in Qore's default string representation instead of in their XSD representation

        @param nsc the namespace container for the message being serialized
        @param val the attribute value to serialize

        @return the serialized attribute value
        @throw SOAP-SERIALIZATION-ERROR the datatype or its instance requirements reject the value

        @since %WSDL 0.5.8
    */
    auto serializeAttributeValue(Namespaces nsc, auto val) {
        *XsdDocumentValueResult captured = IdentityTupleNode && !IdentityChecksSuspended
            ? new XsdDocumentValueResult() : NOTHING;
        auto serialized = XsdDocumentValueHelper::serializeValue(type, nsc, val, True, captured, True);
        XsdIdentityTupleScope::attribute(self, captured.identity);
        if (exists fixedLexical) {
            auto wire = serialized instanceof XsdQNameOutputText ? serialized.standalone() : serialized;
            auto typed = type.deserializeValue(name, new hash<string, XsdAbstractType>(), NOTHING, wire);
            checkFixedValue(typed, SOAP_SERIALIZATION_ERROR);
        }
        return serialized;
    }
}

# Internal field indexing shared by element groups and complex types.
class XsdElementFieldHelper {
    # Keep all admitted names, preferring declarations that need no xsi:type for an instance sample.
    static list<string> getPreferredInstanceNames(XsdElement element, *hash<string, XsdElement> members) {
        list<string> concrete();
        list<string> abstract_types();
        foreach hash<string, auto> entry in ((members ?? element.getInstanceDeclarations()).pairIterator()) {
            XsdElement declaration = entry.value;
            if (declaration.type.isAbstract()) {
                abstract_types += string(entry.key);
            } else {
                concrete += string(entry.key);
            }
        }
        return concrete + abstract_types;
    }

    # Index every active named declaration from the authoritative particle graph.
    # Field aliases must include alternatives not selected by a particular sample.
    static hash<string, XsdElement> getParticleDeclarations(XsdParticle particle,
            *hash<string, hash<XsdParticleOccurrenceRange>> ranges,
            *reference<hash<string, bool>> substitution_fields) {
        hash<string, XsdElement> result();
        hash<string, bool> seen();
        list<XsdParticle> pending = (particle,);
        while (pending) {
            XsdParticle node = pop pending;
            if (node.getMaxOccurs() == "0" || seen{node.uniqueHash()}) {
                continue;
            }
            seen{node.uniqueHash()} = True;
            if (node.getKind() == XsdParticleKind::Element) {
                XsdElement head = node.getElement().getDeclaration();
                hash<string, XsdElement> admitted = node.getElement().getInstanceDeclarations();
                foreach XsdElement declaration in (admitted.iterator()) {
                    string identity = declaration.getExpandedName();
                    if (ranges.hasKey(identity) && !result.hasKey(identity)) {
                        result{identity} = declaration;
                    }
                    if (exists substitution_fields && (admitted.size() > 1 || declaration != head)) {
                        substitution_fields{identity} = True;
                    }
                }
            } else if (node.getKind() == XsdParticleKind::Group) {
                @assert(node.getGroupDefinition());
                push pending, node.getGroupDefinition();
            } else {
                list<XsdParticle> children = node.getChildren();
                for (int index = children.size() - 1; index >= 0; --index) {
                    push pending, children[index];
                }
            }
        }
        return result;
    }

    # Provider shape belongs to the containing particle, not to the shared declaration.
    static AbstractDataProviderType getOccurrenceType(XsdElement element, bool optional, bool repeated) {
        AbstractDataProviderType result = NativeTypeProviderContext
            ? new XsdNativeTypeDataType(NativeTypeProviderContext.getDefinition(element.type), element)
            : element.type.getDataProviderType();
        if (!NativeTypeProviderContext && element.getValueConstraint().fixed) {
            result = new XsdFixedElementDataType(element, result);
        }
        if (!NativeTypeProviderContext && element.nillable) {
            result = new XsdNillableDataType(element, result);
        }
        if (!NativeTypeProviderContext && element.getValueConstraint()) {
            result = new XsdDefaultDataType(element, result);
        }
        if (repeated && (element.type.hasNativeListValue() || result.getBaseTypeCode() != NT_LIST)) {
            result = new SoftListDataType(result.getName(), result, False, NOTHING, result.getTags());
        }
        return optional || element.nillable ? result.getOrNothingType() : result;
    }

    # Reindex maps during schema construction before selecting compatible public field names.
    static hash<string, XsdElement> getExpandedMap(hash<string, XsdElement> element_map) {
        hash<string, XsdElement> result();
        foreach XsdElement element in (element_map.iterator()) {
            result{element.getExpandedName()} = element;
        }
        return result;
    }

    static hash<string, string> getFieldNames(softlist<hash<string, XsdElement>> maps) {
        hash<string, string> identities();
        hash<string, int> counts();
        foreach hash<string, XsdElement> element_map in (maps) {
            foreach XsdElement element in (element_map.iterator()) {
                string identity = element.getExpandedName();
                if (!identities.hasKey(identity)) {
                    identities{identity} = element.name;
                    ++counts{element.name};
                }
            }
        }
        hash<string, string> result();
        foreach string identity in (keys identities) {
            string name = identities{identity};
            result{identity} = counts{name} == 1 ? name : identity;
        }
        return result;
    }

    static hash<string, XsdElement> getFieldMap(hash<string, XsdElement> element_map,
            hash<string, string> fields) {
        hash<string, XsdElement> result();
        foreach XsdElement element in (element_map.iterator()) {
            string identity = element.getExpandedName();
            @assert(fields.hasKey(identity));
            result{fields{identity}} = element;
        }
        return result;
    }
}

# Internal construction check over declarations retained before flat field maps merge.
class XsdElementConsistencyHelper {
    static merge(reference<hash<string, XsdElement>> declarations, softlist<XsdElement> additions) {
        foreach XsdElement element in (additions) {
            string identity = element.getExpandedName();
            *XsdElement previous = declarations{identity};
            if (previous && previous.getDeclaration() != element.getDeclaration() && !(previous.ref && element.ref)
                    && !(previous.type.hasRealName() && element.type.hasRealName()
                        && previous.type == element.type)) {
                throw WSDL_ERROR, sprintf("conflicting type definitions for element %Y in one content model",
                    identity);
            }
            if (!previous) {
                declarations{identity} = element;
            }
        }
    }

    static bool isAbsent(*hash<auto> data) {
        *hash<auto> attributes = data."^attributes^";
        return XsdEmptiabilityHelper::zeroOccurs(attributes.minOccurs)
            && XsdEmptiabilityHelper::zeroOccurs(attributes.maxOccurs);
    }

    # Substitution members are implicit declarations under XSD 1.0 section 3.8.6.
    # Return child types for the schema's iterative traversal of anonymous and recursive definitions.
    static list<XsdAbstractType> validateParticle(XsdParticle particle) {
        particle.validateDeterminism();
        hash<string, XsdElement> declarations();
        list<XsdAbstractType> types();
        hash<string, bool> seen();
        list<XsdParticle> pending = (particle,);
        while (pending) {
            XsdParticle node = pop pending;
            if (node.getMaxOccurs() == "0" || seen{node.uniqueHash()}) {
                continue;
            }
            seen{node.uniqueHash()} = True;
            if (node.getKind() == XsdParticleKind::Element) {
                XsdElement element = node.getElement();
                XsdElementConsistencyHelper::merge(\declarations, (element,));
                types += element.type;
                foreach XsdElement member in (element.getInstanceDeclarations().iterator()) {
                    XsdElementConsistencyHelper::merge(\declarations, (member,));
                    types += member.type;
                }
            } else if (node.getKind() == XsdParticleKind::Group) {
                @assert(node.getGroupDefinition());
                pending += node.getGroupDefinition();
            } else {
                pending += node.getChildren();
            }
        }
        return types;
    }
}

#! An explicitly present nilled element with optional native attribute values
/** This immutable carrier distinguishes a present nilled element from an omitted optional field.
    The receiving declaration validates nillability, fixed constraints and every attribute on output.
    Type and substitution identity use the existing outer wrappers.
    @par Example
    Preserve an unavailable shipment weight and its required measurement unit:
    @code{.py}
    XsdNilValue weight({"unit": "kg"});
    @endcode
    @since %WSDL 0.5.8
*/
public final class XsdNilValue inherits Serializable {
    private {
        hash<auto> attributes;
    }
    #! constructs a present nilled value
    /** @param attributes native declared attribute fields or expanded wildcard names
        @throw XSD-NIL-VALUE-ERROR invalid attribute names or schema-instance metadata
        @note Attribute datatypes and required uses are checked by the receiving schema.
    */
    constructor(*hash<auto> attributes) {
        initialize(attributes ?? {}, "XSD-NIL-VALUE-ERROR");
    }
    private initialize(hash<auto> attributes, string error) {
        foreach string key in (keys attributes) {
            XsdQNameValue identity = XsdWildcardAttributeHelper::name(key, error);
            if (identity.getNamespaceUri() == XSI_NS) {
                throw error, "a nil carrier's attributes cannot replace schema-instance metadata";
            }
        }
        self.attributes = attributes;
    }
    private:internal deserializeMembers(hash<auto> members) {
        if (members.attributes.typeCode() != NT_HASH) {
            throw "DESERIALIZATION-ERROR", "a nilled value requires an attribute hash";
        }
        initialize(members.attributes, "DESERIALIZATION-ERROR");
    }
    #! returns the native attribute values
    /** @return a copy-on-write hash of attribute values */
    hash<auto> getAttributes() {
        return attributes;
    }
}

class XsdNilValueHelper {
    private static hash<XsdAttributeWildcardInfo> anyWildcard() {
        return <XsdAttributeWildcardInfo>{"processing": XsdWildcardProcessing::Lax};
    }
    static *hash<auto> decodeAttributes(XsdAbstractType type, *hash<auto> attributes) {
        if (type instanceof XsdComplexType) {
            return cast<XsdComplexType>(type).deserializeAttributeValues(attributes);
        }
        if (!XsdTypeSubstitutionHelper::builtin(type, "anyType")) {
            XsdBase::validateSimpleAttributes(attributes, type.name);
            return;
        }
        hash<auto> expanded = XsdBase::getExpandedAttributes(attributes);
        hash<auto> result();
        foreach string identity in (keys expanded) {
            if (!XsdBase::isInstanceAttribute(identity)) {
                result{identity} = XsdWildcardAttributeHelper::decode(type.nsc, anyWildcard(), identity,
                    expanded{identity});
            }
        }
        XsdWildcardAttributeHelper::checkIds(type.nsc, anyWildcard(), {}, keys result, SOAP_DESERIALIZATION_ERROR);
        return result;
    }
    static *hash<auto> encodeAttributes(XsdAbstractType type, Namespaces output, hash<auto> attributes) {
        if (type instanceof XsdComplexType) {
            return cast<XsdComplexType>(type).serializeAttributeValues(output, attributes);
        }
        if (!XsdTypeSubstitutionHelper::builtin(type, "anyType")) {
            if (attributes) {
                throw SOAP_SERIALIZATION_ERROR, sprintf("simple type %Y cannot contain ordinary attributes", type.name);
            }
            return;
        }
        hash<auto> result();
        hash<string, bool> identities();
        foreach string field in (keys attributes) {
            XsdQNameValue identity = XsdWildcardAttributeHelper::name(field, SOAP_SERIALIZATION_ERROR);
            string expanded = type_qname(identity.getNamespaceUri(), identity.getLocalName());
            if (identities{expanded}) {
                throw SOAP_SERIALIZATION_ERROR, sprintf("duplicate expanded attribute %Y", expanded);
            }
            identities{expanded} = True;
            string name = (identity.getNamespaceUri() ? output.getOutputNamespacePrefix(identity.getNamespaceUri())
                + ":" : "") + identity.getLocalName();
            result{name} = XsdWildcardAttributeHelper::encode(type.nsc, output, anyWildcard(), identity,
                attributes{field});
        }
        XsdWildcardAttributeHelper::checkIds(type.nsc, anyWildcard(), {}, keys identities, SOAP_SERIALIZATION_ERROR);
        return result;
    }
}

#! Resolved default or fixed value belonging to an element declaration
/** The lexical form and its declaration namespace bindings accompany the typed value.
    This distinguishes an empty constraint from the absence of a constraint and keeps
    QName meanings independent of instance namespace declarations.
    @since %WSDL 0.5.8
*/
public hashdecl XsdElementValueConstraintInfo {
    #! True for fixed, False for default
    bool fixed;
    #! The original XML attribute value
    string lexical;
    #! Namespace bindings used to interpret the declaration's lexical value
    hash<string, string> namespaces;
    #! The value converted with the resolved simple content type
    auto value;
}

hashdecl XsdMixedContentItem {
    string key;
    auto value;
    *string identity;
}

#! XSD element class
public class XsdElement inherits WSDL::XsdTypedData {
    public {
        int minOccurs = 1;
        int maxOccurs = 1;
        bool nillable = False;
        # the resolved namespace URI for any reference
        *string ref_ns;
        # the source name for any reference
        *string ref;
        bool usedocns;
    }

    private {
        *hash<XsdElementValueConstraintInfo> value_constraint;
        *hash<XsdUnionValueIdentity> constraint_identity;
        transient *Mutex constraint_mutex;
        hash<string, bool> blocked_substitutions();
        bool abstract_element = False;
        hash<string, bool> substitution_exclusions();
        *XsdQNameValue substitution_name;
        *XsdElement substitution_head;
        *XsdElement declaration_ref;
        hash<string, XsdElement> substitution_members();
        list<XsdIdentityConstraint> identity_constraints();
    }

    private:internal deserializeMembers(hash<auto> members) {
        self += members;
        # This hook restores only local state: referenced types may not yet have
        # their members restored. Legacy constraint identity is resolved on use.
        constraint_mutex = exists value_constraint ? new Mutex() : NOTHING;
        identity_constraints = members.identity_constraints ?? ();
    }

    #! constructs an element declaration or a reference to a global element
    /** @param e parsed element declaration
        @param nsc declaration namespace context
        @param n_type resolved type for an internal synthetic element, if supplied
        @param unresolved the schema construction resolver
        @param n_usedocns default local element qualification
        @param global_element True for a schema-level declaration
        @throw WSDL-ERROR contradictory declarations or properties invalid in this context
        @throw WSDL-NAMESPACE-ERROR malformed or unbound QName
        @throw XSD-SIMPLETYPE-ERROR an invalid inline simple type
        @throw XSD-ELEMENT-ERROR inconsistent occurrence limits
    */
    constructor(hash<auto> e, Namespaces nsc, *XsdAbstractType n_type, XsdLateResolverHelper unresolved,
            bool n_usedocns, bool global_element = False) : XsdTypedData(\e) {
        unresolved.addNotationUse(self);
        NamespacePrefixHelper declaration(nsc, e."^attributes^");
        usedocns = n_usedocns;
        if (!ns) {
            ns = nsc.getTargetNamespaceUri() ?? "";
        }
        if (n_type) {
            type = n_type;
            return;
        }
        *hash<auto> a = e."^attributes^";
        int type_declarations = int(exists a.type) + int(e.hasKey("simpleType")) + int(e.hasKey("complexType"));
        if ((exists a.name) == (exists a.ref) || type_declarations > 1
                || (exists a.default && exists a.fixed)
                || (exists a.form && a.form != "qualified" && a.form != "unqualified")
                || (global_element && (exists a.ref || exists a.form || exists a.minOccurs || exists a.maxOccurs))
                || (!global_element && (exists a.abstract || exists a.final || exists a.substitutionGroup))
                || (exists a.ref && (type_declarations || exists a.form || exists a.nillable || exists a.default
                    || exists a.fixed || exists a.block || e.hasKey("key") || e.hasKey("keyref") || e.hasKey("unique")))) {
            throw WSDL_ERROR, sprintf("invalid or contradictory element declaration %Y", a);
        }
        foreach string kind in ("simpleType", "complexType") {
            if (e.hasKey(kind) && ((exists e{kind} && e{kind}.typeCode() != NT_HASH)
                    || exists e{kind}."^attributes^".name)) {
                throw WSDL_ERROR, sprintf("element %Y requires one anonymous %s declaration", name, kind);
            }
        }
        foreach string category in ("key", "unique", "keyref") {
            foreach hash<auto> node in (e{category}) {
                XsdIdentityConstraint definition = XsdIdentityDeclarationHelper::parse(category, node, nsc);
                identity_constraints += definition;
                unresolved.addIdentityConstraint(definition);
            }
        }
        if (exists a.form) {
            usedocns = a.form == "qualified";
        }
        if (exists a.name) {
            nsc.validateDeclarationName(a.name);
        }
        if (exists a.minOccurs) {
            minOccurs = int(a.minOccurs);
        }
        if (exists a.maxOccurs) {
            maxOccurs = a.maxOccurs == "unbounded" ? -1 : int(a.maxOccurs);
        }
        if (maxOccurs != -1 && minOccurs > maxOccurs) {
            throw "XSD-ELEMENT-ERROR", sprintf("minOccurs (%d) > maxOccurs (%d) for element %s", minOccurs, maxOccurs,
                name);
        }
        nillable = XsdDerivationControlHelper::booleanValue(a.nillable, "nillable");
        abstract_element = XsdDerivationControlHelper::booleanValue(a.abstract, "abstract");
        if (!exists a.ref) {
            blocked_substitutions = XsdDerivationControlHelper::forBlock(a, nsc, False);
        }
        if (global_element) {
            substitution_exclusions = XsdDerivationControlHelper::forElementFinal(a, nsc);
            if (exists a.substitutionGroup) {
                hash<auto> identity = nsc.getTypeHash(a.substitutionGroup);
                substitution_name = new XsdQNameValue(identity.uri, identity.val);
            }
        }
        if (exists a.default || exists a.fixed) {
            string lexical = a.fixed ?? a.default;
            value_constraint = <XsdElementValueConstraintInfo>{"fixed": exists a.fixed, "lexical": lexical,
                "namespaces": XsdQNameContextHelper::capture(lexical, nsc)};
            constraint_mutex = new Mutex();
        }
        on_success {
            if (value_constraint) {
                unresolved.addConstrainedElement(self);
            }
        }
        if (exists a.type) {
            if (!nsc.doType(a.type, \typeinfo, \type)) {
                unresolved.add(self);
            }
        } else if (e.hasKey("simpleType")) {
            type = new XsdSimpleType(e.simpleType ?? {}, nsc, unresolved, usedocns, sprintf("simpleType for element %Y", name));
        } else if (e.hasKey("complexType")) {
            type = new XsdComplexType(e.complexType, nsc, unresolved, usedocns, sprintf("complexType for element %Y", name));
        } else if (exists a.ref) {
            hash<auto> identity = nsc.getTypeHash(a.ref);
            ref = identity.val;
            name = ref;
            ref_ns = identity.uri;
            usedocns = boolean(ref_ns);
            unresolved.add(self);
        } else if (!substitution_name) {
            type = nsc.getBaseType("anyType");
        }
    }

    #! validates and resolves an element declaration's default or fixed value
    /** @throw WSDL-ERROR the type/content does not permit a constraint, or its lexical value is invalid
        @note Called after complex and simple type finalization.
        @since %WSDL 0.5.8
    */
    validateValueConstraintType() {
        if (!value_constraint) {
            return;
        }
        AutoLock lock(constraint_mutex);
        resolveValueConstraint();
    }

    private resolveValueConstraint() {
        XsdAbstractType content = type;
        if (type instanceof XsdComplexType) {
            XsdComplexType complex_type = cast<XsdComplexType>(type);
            if (!complex_type.allowsElementValueConstraint()) {
                throw WSDL_ERROR, sprintf("element %Y requires simple or emptiable mixed content for a "
                    "default or fixed constraint", name);
            }
            content = complex_type.simpleType ?? new XsdBaseType("string", new Namespaces({}));
        } else if (XsdTypeSubstitutionHelper::builtin(type, "anyType")) {
            content = new XsdBaseType("string", new Namespaces({}));
        }
        if (XsdTypeDerivationHelper::isIdDerived(content)) {
            throw WSDL_ERROR, sprintf("ID-derived element %Y cannot have a default or fixed constraint", name);
        }
        try {
            XsdQNameNamespaceScope declaration_scope(
                XsdQNameContextHelper::attributes(value_constraint.namespaces), True);
            # Schema declarations require datatype validity. Document-dependent ENTITY
            # requirements apply when an instance uses the constraint, as for attributes.
            XsdConstraintLexicalScope canonical_scope();
            XsdDocumentValueCapture capture(content);
            auto converted = content.deserializeValue(name, new hash<string, XsdAbstractType>(), NOTHING,
                value_constraint.lexical);
            *hash<XsdUnionValueIdentity> identity = capture.valueIdentity(value_constraint.lexical, converted,
                SOAP_DESERIALIZATION_ERROR);
            # XSD 1.0 e-props-correct.2 checks canonical validity, independently of
            # the source lexical/typed value retained for the declaration's PSVI.
            if (exists identity.constraint_lexical && identity.constraint_lexical != value_constraint.lexical) {
                content.deserializeValue(name, new hash<string, XsdAbstractType>(), NOTHING, identity.constraint_lexical);
            }
            value_constraint.value = converted;
            constraint_identity = identity;
        } catch (hash<ExceptionInfo> error) {
            if (error.err == "PROGRAM-INTERRUPTED" || error.err == "THREAD-CANCELLED") {
                rethrow;
            }
            throw WSDL_ERROR, sprintf("invalid value constraint for element %Y: %s: %s", name,
                error.err, error.desc);
        }
    }

    #! returns this declaration's resolved default or fixed value
    /** @return a copy of the typed constraint and its original lexical/namespace context, or NOTHING
        @note References return their global declaration's constraint. The schema must be fully resolved.
        @par Example
        Inspect a catalog quantity's declared default without confusing it with an absent optional element.
        @since %WSDL 0.5.8
    */
    *hash<XsdElementValueConstraintInfo> getValueConstraint() {
        return declaration_ref ? declaration_ref.getValueConstraint() : value_constraint;
    }

    #! Returns identity constraints owned by this element declaration
    /** @return immutable definitions with compiled selector and ordered field paths
        @note Element references return the referenced declaration's constraints.
        @since %WSDL 0.5.8
    */
    list<XsdIdentityConstraint> getIdentityConstraints() {
        return declaration_ref ? declaration_ref.getIdentityConstraints() : identity_constraints;
    }

    private *hash<XsdUnionValueIdentity> getConstraintIdentity() {
        if (declaration_ref) {
            return declaration_ref.getConstraintIdentity();
        }
        if (!value_constraint) {
            return;
        }
        AutoLock lock(constraint_mutex);
        if (!constraint_identity) {
            # Providers saved before computed identity metadata existed retain the
            # declaration's lexical form and type graph. Resolve only after that
            # graph is fully reconstructed; publish once, and retry after errors.
            resolveValueConstraint();
        }
        return constraint_identity;
    }

    private checkFixedValue(auto content, *hash<XsdUnionValueIdentity> actual, string error) {
        if (!getValueConstraint().fixed) {
            return;
        }
        string text = XsdFixedValueHelper::text(content, error);
        if (!text.length()) {
            return;
        }
        *hash<XsdUnionValueIdentity> expected = getConstraintIdentity();
        if (!actual || !expected || !XsdUnionValueHelper::same(expected, actual)) {
            throw error, sprintf("element %Y does not match its fixed value", name);
        }
    }

    AbstractDataProviderType getDataProviderType() {
        AbstractDataProviderType value_type = XsdElementFieldHelper::getOccurrenceType(self, !minOccurs, maxOccurs != 1);
        return getIdentityConstraints() || XsdIdentityBindings::contains(type)
            ? new XsdIdentityDataType(self, value_type) : value_type;
    }

    *list<auto> getAllowedValues() {
        return type.getAllowedValues();
    }

    #! returns finite choices for the complete provider value
    /** @return the declared type's complete-value choices */
    *list<auto> getDataProviderAllowedValues() {
        return type.getDataProviderAllowedValues();
    }

    assimilate(WSDL::XsdElement other) {
        map self{$1.key} = $1.value, other.pairIterator(), !exists self{$1.key};
        # A reference uses the global declaration's properties, independently of local defaults.
        ns = other.ns;
        blocked_substitutions = other.blocked_substitutions;
        abstract_element = other.abstract_element;
        nillable = other.nillable;
        declaration_ref = other;
    }

    #! returns this element's effective final exclusions for substitution group affiliations
    /** @return a copy of the extension/restriction method-name set
        @since %WSDL 0.5.8
    */
    hash<string, bool> getSubstitutionGroupExclusions() {
        return declaration_ref ? declaration_ref.getSubstitutionGroupExclusions() : substitution_exclusions;
    }

    #! returns the expanded name of the declared substitution group head
    /** @return the captured QName, or NOTHING when this declaration has no affiliation
        @since %WSDL 0.5.8
    */
    *XsdQNameValue getSubstitutionGroupName() {
        return declaration_ref ? declaration_ref.getSubstitutionGroupName() : substitution_name;
    }

    #! returns the resolved immediate substitution group head
    /** @return the head declaration, or NOTHING when there is no affiliation
        @since %WSDL 0.5.8
    */
    *XsdElement getSubstitutionGroupAffiliation() {
        return declaration_ref ? declaration_ref.getSubstitutionGroupAffiliation() : substitution_head;
    }

    #! returns the concrete declarations that can substitute for this global declaration
    /** @return a copy of the expanded-name-to-declaration map, including this declaration when nonabstract;
        local declarations have no substitution group, while references use their global declaration
        @since %WSDL 0.5.8
    */
    hash<string, XsdElement> getSubstitutionGroup() {
        return declaration_ref ? declaration_ref.getSubstitutionGroup() : substitution_members;
    }

    #! returns the concrete declarations admitted at an occurrence of this element
    /** @return declarations keyed by expanded instance name; a local declaration admits only itself,
        while a global declaration or reference admits its concrete substitution group
        @note Instance type, value and nil constraints remain properties of the selected declaration.
        @since %WSDL 0.5.8
    */
    hash<string, XsdElement> getInstanceDeclarations() {
        if (declaration_ref) {
            return declaration_ref.getSubstitutionGroup();
        }
        if (substitution_members || abstract_element) {
            return substitution_members;
        }
        return {getExpandedName(): self};
    }

    #! resolves an expanded instance name to its validating element declaration
    /** @param name the expanded instance name in {namespace-uri}local-name form
        @return the permitted declaration, or NOTHING when the name is not admitted
        @since %WSDL 0.5.8
    */
    *XsdElement getInstanceDeclaration(string name) {
        return getInstanceDeclarations(){name};
    }

    #! returns the declaration component represented by this element or reference
    /** @return the referenced global declaration, or this declaration for a non-reference
        @since %WSDL 0.5.8
    */
    XsdElement getDeclaration() {
        return declaration_ref ?? self;
    }

    /** @cond INTERNAL */
    # Schema construction only; affiliations resolve before omitted types and local references.
    resolveSubstitutionGroupAffiliation(*XsdElement head) {
        substitution_head = head;
    }

    # Schema construction only; publish the complete membership set after type finalization.
    resolveSubstitutionGroupMembers(hash<string, XsdElement> members) {
        substitution_members = members;
    }
    /** @endcond */

    bool isRequired() {
        return minOccurs > 0;
    }

    bool isNillable() {
        return nillable;
    }

    #! returns this declaration's effective disallowed substitutions
    /** @return a copy of the extension/restriction/substitution method-name set
        @since %WSDL 0.5.8
    */
    hash<string, bool> getBlockedSubstitutions() {
        return blocked_substitutions;
    }

    #! returns whether this declaration can occur only through a substitution member
    /** @return True for abstract global element declarations and their references
        @since %WSDL 0.5.8
    */
    bool isAbstract() {
        return abstract_element;
    }

    #! returns the expanded XML name required by this element declaration
    /** @return the namespace/local identity, using an empty namespace for unqualified local elements
        @since %WSDL 0.5.8
    */
    string getExpandedName() {
        return type_qname(getNamespaceUri(), name);
    }

    #! returns the namespace of the element's XML name
    /** @return the resolved namespace URI, or an empty string for an unqualified element
        @since %WSDL 0.5.8
    */
    string getNamespaceUri() {
        return (ref ? ref_ns : (usedocns ? ns : "")) ?? "";
    }

    #! returns the XML output name for this element declaration
    /** @param namespaces the output namespace registry
        @return the declared local name, qualified with an output prefix when its namespace is nonempty
        @since %WSDL 0.5.8
    */
    string getXmlName(Namespaces namespaces) {
        string uri = getNamespaceUri();
        return uri ? namespaces.getOutputNamespacePrefix(uri) + ":" + name : name;
    }

    #! validates a retained XML element using the existing decode and encode constraints
    /** @param value a complete XML element document
        @param nsc namespace context for validating the corresponding native serialization
        @param tmap the resolved schema type map
        @return the validated native value; the retained XML is not modified
        @throw SOAP-SERIALIZATION-ERROR inadmissible expanded root, forbidden DOCTYPE or rejected schema content
        @note Checks both value conversion paths for each ordered child: serialization can enforce constraints
        that decoding does not. Complete particles are validated before native field projection; retained XML is
        not regrouped through a flat record. The root may be a concrete substitution member; its declaration
        supplies the value and type constraints. General scalar and dynamic-type rules follow native conversion.
        @since %WSDL 0.5.8
    */
    auto validateXmlValue(XsdXmlValue value, Namespaces nsc, hash<string, XsdAbstractType> tmap) {
        XsdNativeTypeValueScope native_projection(False);
        *XsdElement selected = getInstanceDeclaration(value.getExpandedName());
        if (!selected) {
            throw SOAP_SERIALIZATION_ERROR, sprintf("XML value root %Y does not match a declaration admitted by element %Y",
                value.getExpandedName(), getExpandedName());
        }
        XmlReader reader = value.getReader();
        while (reader.read()) {
            if (reader.nodeType() == XML_NODE_TYPE_DOCUMENT_TYPE) {
                throw SOAP_SERIALIZATION_ERROR, "a retained SOAP element cannot contain a DOCTYPE";
            }
            if (reader.nodeType() == XML_NODE_TYPE_ELEMENT) {
                break;
            }
        }
        try {
            # Comments do not participate in XSD content-model validation. Keep them in the carrier's
            # public view, while using the same comment-free parser projection as native SOAP decoding.
            hash<auto> expanded = XsdBase::expandElementNamespaces(
                parse_xml(value.getXml(), XPF_PRESERVE_ORDER | XPF_PRESERVE_WHITESPACE));
            # Each ordered child receives both value-conversion checks in place.
            # Re-encoding the flattened native record would group alternating
            # occurrences and could reject a valid retained XML instance.
            *Namespaces previous = RetainedXmlValidationNamespaces;
            on_exit RetainedXmlValidationNamespaces = previous;
            RetainedXmlValidationNamespaces = nsc.copy();
            return selected.deserializeValue(tmap, NOTHING, expanded{value.getExpandedName()}, True);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "PROGRAM-INTERRUPTED" || ex.err == "THREAD-CANCELLED") {
                rethrow;
            }
            throw SOAP_SERIALIZATION_ERROR, sprintf("XML value for element %Y failed validation: %s: %s",
                getExpandedName(), ex.err, ex.desc);
        }
    }

    #! serializes the declared occurrence collection, optionally selecting an explicit type
    /** @param nsc the output namespace registry
        @param h native input, or a \c ^type^ / \c ^val^ wrapper selecting an XsdAbstractType or XsdQNameValue
        @param omitType omit implicit named type annotations
        @param key the containing native field name for diagnostics
        @param typename the containing type name for diagnostics
        @param types optional resolved output types for portable QName wrappers; complete schema/message
        serializers provide their map automatically, and nested calls inherit the current map
        @return the converted value or collection with its XML metadata
        @throw SOAP-SERIALIZATION-ERROR incompatible explicit type, invalid content or occurrence count
        @note A wrapper selecting the declared type retains all value and occurrence checks. A list datatype
        still uses an outer list for repeated element occurrences. Anonymous types cannot supply a type QName.
        @par Example
        Serialize two invoice quantities with the same explicit integer type and enforce their declared count.
    */
    auto serializeValue(Namespaces nsc, auto h, *softbool omitType, string key, string typename,
            *hash<string, XsdAbstractType> types) {
        *XsdNativeTypeOutputScope type_scope;
        if (exists types) {
            type_scope = new XsdNativeTypeOutputScope(types);
        }
        return serializeOccurrences(nsc, h, omitType, key, typename, minOccurs, maxOccurs);
    }

    #! serializes one child occurrence after its containing particle has selected this declaration
    /** @param nsc namespace context for this serialization
        @param value the native value of one child, including a native list for an XSD list datatype
        @param omitType whether to omit implicit type metadata
        @param key the containing native field name for diagnostics
        @param typename the containing type name for diagnostics
        @param types optional resolved output types for portable QName wrappers; omitted maps inherit
        the complete schema or message serializer context
        @return the child's XML data, including its attributes when needed
        @throw SOAP-SERIALIZATION-ERROR an invalid scalar value, explicit type, nil or child content
        @note The containing particle validates complete occurrence counts. This method uses a local
        one-occurrence range and does not alter shared declaration limits. The caller's namespace context
        can acquire output prefixes, as with serializeValue().
        @par Example
        An invoice line selected from a repeated line group is serialized once with its own declared
        datatype; the invoice serializer checks the number and order of complete line groups separately.
        @since %WSDL 0.5.8
    */
    auto serializeOccurrence(Namespaces nsc, auto value, *softbool omitType, string key, string typename,
            *hash<string, XsdAbstractType> types) {
        *XsdNativeTypeOutputScope type_scope;
        if (exists types) {
            type_scope = new XsdNativeTypeOutputScope(types);
        }
        return serializeOccurrences(nsc, value, omitType, key, typename, 1, 1);
    }

    private auto serializeOccurrences(Namespaces nsc, auto h, *softbool omitType, string key, string typename,
            int minimum, int maximum) {
        if (XsdNativeTypeValueHelper::isWrapper(h)) {
            XsdNativeTypeValueHelper::checkWrapper(h);
            XsdAbstractType ntype = XsdNativeTypeValueHelper::resolve(h."^type^", type);
            if (XsdTypeDerivationHelper::sameType(ntype, type)) {
                ntype = type;
            }
            # Portable captured wrappers preserve presence. Legacy component-object
            # wrappers retain their established optional-omission behavior.
            auto value = h."^val^";
            if (!exists value && nillable && h."^type^" instanceof XsdQNameValue) {
                value = new XsdNilValue();
            }
            return serializeAsIntern(nsc, ntype, value, omitType, key, name, minimum, maximum);
        }

        return serializeAsIntern(nsc, type, h, omitType, key, typename, minimum, maximum);
    }

    private auto serializeAsIntern(Namespaces nsc, XsdAbstractType type, auto h, *softbool omitType, string key,
            string typename, int minOccurs, int maxOccurs) {
        #printf("DEBUG: XsdElement::serializeAsIntern() name: %y (with type: %y) h: %y key: %y typename: %y (%y) minOccurs: %y nillable: %y (%y %y)\n", name, ((!omitType || type != self.type) && type.hasRealName()), h, key, typename, type.getName(), minOccurs, nillable, !exists h, !minOccurs);

        int tc = h.typeCode();
        # Don't unwrap single-element lists for XSD list types (they need the list value)
        bool is_list_type = type.hasNativeListValue() && maxOccurs == 1;
        if (tc == NT_LIST && h.size() == 1 && !type.hasNativeListValue()) {
            h = h[0];
            tc = h.typeCode();
        }

        if (!minOccurs && (!exists h || (tc == NT_LIST && h.empty() && !is_list_type))) {
            return;
        }
        if (maxOccurs == 0) {
            throw SOAP_SERIALIZATION_ERROR, sprintf("element %Y has maxOccurs 0", name);
        }
        if (tc == NT_LIST && h.empty() && !is_list_type
                && !(maxOccurs == 1 && minOccurs == 1 && !nillable
                    && type instanceof XsdComplexType && !type.requiresValue())) {
            throw SOAP_SERIALIZATION_ERROR, sprintf("empty occurrence collection for element %Y with minOccurs %d",
                name, minOccurs);
        }
        if (abstract_element) {
            throw SOAP_SERIALIZATION_ERROR, sprintf("abstract element %Y cannot occur directly", name);
        }
        if (type !== self.type && !type.hasRealName()) {
            throw SOAP_SERIALIZATION_ERROR, sprintf("anonymous type cannot supply xsi:type for element %Y", name);
        }
        XsdTypeSubstitutionHelper::check(type, self.type, name, SOAP_SERIALIZATION_ERROR, blocked_substitutions);

        # For list types, empty lists are valid values (serialize to empty element content)
        # For non-list types, empty lists with minOccurs=0 can be skipped
        if (!exists h || (tc == NT_LIST && h.empty() && !is_list_type)) {
            if (!minOccurs)
                return;

            if (nillable) {
                if (minOccurs > 1) {
                    throw SOAP_SERIALIZATION_ERROR, sprintf("one nilled occurrence supplied for element %Y "
                        "with minOccurs %d", name, minOccurs);
                }
                *hash<auto> type_attributes;
                if ((!omitType || type != self.type) && type.hasRealName()) {
                    type_attributes = XsdDocumentValueHelper::typeAttributes(type, nsc);
                }
                return serializeTypedValue(type, nsc, new XsdNilValue(), omitType, type_attributes);
            }

            if (!type.isRequired() || !type.requiresValue()) {
                # An empty occurrence list is also the established spelling of
                # one empty element-only record; validate that record normally.
                if (tc == NT_LIST && type instanceof XsdComplexType
                        && !cast<XsdComplexType>(type).array && !cast<XsdComplexType>(type).simpleType
                        && !cast<XsdComplexType>(type).hasMixedContent()) {
                    h = {};
                }
                return serializeTypedValue(type, nsc, h, omitType, NOTHING);
            }

            throw SOAP_SERIALIZATION_ERROR, sprintf("missing element %y value for %s::%s (minOccurs: %d, type %y)", name, typename, key, minOccurs, type.getName());
        }

        *hash<auto> type_attributes;
        # anyType's converter supplies the inferred runtime type itself.
        if ((!omitType || type != self.type) && type.hasRealName()
                && !(type instanceof XsdBaseType && type.name == "anyType")) {
            type_attributes = XsdDocumentValueHelper::typeAttributes(type, nsc);
        }

        if (tc == NT_LIST) {
            # For list types (XsdSimpleType with listItemType), the list value is passed
            # directly to the type's serialize() which handles it as a space-separated value
            if (is_list_type) {
                # Let the list type handle the list value directly
                return serializeTypedValue(type, nsc, h, omitType, type_attributes);
            }

            int len = h.size();
            if (maxOccurs == 1 && len > 1) {
                throw SOAP_SERIALIZATION_ERROR, sprintf("cannot serialize element %y of type %y from a list<auto> with %d elements because maxOccurs = 1", name, type.getName(), len);
            }
            if (len > maxOccurs && maxOccurs > 0) {
                throw SOAP_SERIALIZATION_ERROR, sprintf("list<auto> for element %y of type %y has %d element%s, but maxOccurs = %d", name, type.getName(), elements h, elements h == 1 ? "" : "s", maxOccurs);
            }
            if (len < minOccurs) {
                throw SOAP_SERIALIZATION_ERROR, sprintf("list<auto> for element %y of type %y has %d element%s, but minOccurs = %d", name, type.getName(), elements h, elements h == 1 ? "" : "s", minOccurs);
            }

            list<auto> l = ();
            foreach auto e in (h) {
                push l, serializeTypedValue(type, nsc, e, omitType, type_attributes);
            }
            return l;
        }
        if (minOccurs > 1)
            throw SOAP_SERIALIZATION_ERROR, sprintf("only one element passed to element %y of type %y, but minOccurs = %d", name, type.getName(), minOccurs);

        return serializeTypedValue(type, nsc, h, omitType, type_attributes);
    }

    private auto serializeTypedValue(XsdAbstractType selected, Namespaces namespaces, auto value,
            *softbool omitType, *hash<auto> type_attributes) {
        XsdIdentityElementScope identity_scope();
        on_success identity_scope.finish(SOAP_SERIALIZATION_ERROR);
        XsdIdentityTupleScope tuples(self);
        on_success tuples.finish(SOAP_SERIALIZATION_ERROR);
        if (value instanceof XsdDefaultValue) {
            XsdDocumentValueResult captured();
            hash<auto> empty = serializeDefault(selected, namespaces, value, captured);
            tuples.value(captured.actual_type ?? selected, captured.identity);
            empty."^attributes^" += type_attributes;
            tuples.instanceAttributes(empty, SOAP_SERIALIZATION_ERROR, namespaces);
            return empty;
        }
        if (value instanceof XsdNilValue || (!exists value && nillable)) {
            tuples.value(selected, NOTHING);
            hash<auto> nil = serializeNil(selected, namespaces, value ?? new XsdNilValue());
            nil."^attributes^" += type_attributes;
            tuples.instanceAttributes(nil, SOAP_SERIALIZATION_ERROR, namespaces);
            return nil;
        }
        if (XsdTypeSubstitutionHelper::builtin(selected, "anyType") && value.typeCode() == NT_HASH) {
            # Generic XML values can carry an explicit xsi:nil and xsi:type. Assess
            # the receiving declaration before a type converter examines content.
            try {
                hash<auto> wire = XsdBase::restoreElementNamespaces(value);
                hash<auto> assessed = XsdBase::expandElementNamespaces(wire);
                XsdQNameNamespaceScope scope(assessed."^attributes^", True);
                XsdAbstractType actual = XsdTypeSubstitutionHelper::select(\assessed, selected,
                    NativeTypeOutputTypes ?? selected.nsc.getInstanceTypes(), name, blocked_substitutions);
                if (assessNil(actual, assessed)) {
                    tuples.value(actual, NOTHING);
                    tuples.instanceAttributes(wire, SOAP_SERIALIZATION_ERROR, namespaces);
                    return wire;
                }
            } catch (hash<ExceptionInfo> error) {
                if (error.err == SOAP_DESERIALIZATION_ERROR) {
                    rethrow SOAP_SERIALIZATION_ERROR, error.desc, error.arg;
                }
                rethrow;
            }
        }
        # An anonymous simple type cannot be named by xsi:type. Its restriction
        # base or union member must not be substituted for that anonymous component.
        bool omit_selected_type = omitType || (selected instanceof XsdSimpleType && !selected.hasRealName());
        *XsdDocumentValueResult captured = getValueConstraint().fixed || tuples.captures()
            ? new XsdDocumentValueResult(!getValueConstraint().fixed) : NOTHING;
        auto converted = XsdDocumentValueHelper::serializeValue(selected, namespaces, value, omit_selected_type,
            captured);
        tuples.value(captured.actual_type ?? selected, captured.identity);
        checkFixedValue(converted, captured.identity, SOAP_SERIALIZATION_ERROR);
        if (!type_attributes) {
            tuples.instanceAttributes(converted, SOAP_SERIALIZATION_ERROR, namespaces);
            return converted;
        }
        if (converted.typeCode() != NT_HASH) {
            hash<auto> wire = {"^value^": converted, "^attributes^": type_attributes};
            tuples.instanceAttributes(wire, SOAP_SERIALIZATION_ERROR, namespaces);
            return wire;
        }
        # Restriction/list/union converters may delegate to another type. The
        # element's selected component owns its annotation; retain all other
        # attributes, comments and child content without concatenating metadata.
        converted."^attributes^" += type_attributes;
        tuples.instanceAttributes(converted, SOAP_SERIALIZATION_ERROR, namespaces);
        return converted;
    }

    #! decodes an occurrence collection with optional native type retention
    /** @param tmap the resolved schema type map
        @param mrh optional SOAP reference context
        @param val parsed XML value or occurrence list
        @param present whether the XML element is present
        @param preserve_types True to wrap different selected types with their expanded QName and native
        value; False for the established projection; NOTHING inherits a containing operation's choice
        @return native values, optionally using portable \c ^type^ / \c ^val^ wrappers
        @throw SOAP-DESERIALIZATION-ERROR invalid occurrence, type selection or content
        @note Captured wrappers survive Serializable reconstruction independently of the schema.
        @par Example
        Retain a shipment part's selected subtype so a stored message can later emit its extra fields.
        @since %WSDL 0.5.8
    */
    auto deserializeValue(hash<string, XsdAbstractType> tmap, *hash<auto> mrh, auto val, bool present,
            *bool preserve_types) {
        *XsdNativeTypeValueScope type_scope;
        if (exists preserve_types) {
            type_scope = new XsdNativeTypeValueScope(preserve_types);
        }
        return deserializeOccurrences(tmap, mrh, val, present, minOccurs, maxOccurs);
    }

    #! decodes one XML child after its containing particle has checked occurrence constraints
    /** @param tmap the resolved schema types
        @param mrh SOAP reference values, if present
        @param val one child's XML data value
        @return the child's typed native value
        @throw SOAP-DESERIALIZATION-ERROR invalid element content or nil/value constraints
        @note The containing ordered particle validates counts. Shared declaration limits are not modified.
        @par Example
        After matching an invoice's ordered children, decode each quantity with its selected declaration;
        two quantity positions can have different nillability even when their expanded name is the same.
        @since %WSDL 0.5.8
    */
    auto deserializeOccurrence(hash<string, XsdAbstractType> tmap, *hash<auto> mrh, auto val) {
        return deserializeOccurrences(tmap, mrh, val, True, 1, 1);
    }

    private auto deserializeOccurrences(hash<string, XsdAbstractType> tmap, *hash<auto> mrh, auto val,
            bool present, int minOccurs, int maxOccurs) {
        if (!exists val && !present) {
            if (!minOccurs) {
                return;
            }
            throw SOAP_DESERIALIZATION_ERROR, sprintf("missing element %Y with minOccurs %d", name, minOccurs);
        }
        if (maxOccurs == 0) {
            throw SOAP_DESERIALIZATION_ERROR, sprintf("element %Y has maxOccurs 0", name);
        }
        if (val.typeCode() == NT_LIST) {
            int count = val.size();
            if ((maxOccurs != -1 && count > maxOccurs) || count < minOccurs) {
                throw SOAP_DESERIALIZATION_ERROR, sprintf("element %Y has %d occurrences outside %d..%d",
                    name, count, minOccurs, maxOccurs);
            }
            return map deserializeTypedValue(tmap, mrh, getValue(mrh, $1)), val;
        }
        if (minOccurs > 1) {
            throw SOAP_DESERIALIZATION_ERROR, sprintf("single value passed for element %Y with minOccurs %d",
                name, minOccurs);
        }
        return deserializeTypedValue(tmap, mrh, getValue(mrh, val));
    }

    private auto deserializeTypedValue(hash<string, XsdAbstractType> tmap, *hash<auto> references, auto value) {
        XsdIdentityElementScope identity_scope();
        on_success identity_scope.finish(SOAP_DESERIALIZATION_ERROR);
        XsdIdentityTupleScope tuples(self);
        on_success tuples.finish(SOAP_DESERIALIZATION_ERROR);
        if (abstract_element) {
            throw SOAP_DESERIALIZATION_ERROR, sprintf("abstract element %Y cannot occur directly", name);
        }
        XsdQNameNamespaceScope scope(value.typeCode() == NT_HASH ? value."^attributes^" : NOTHING);
        tuples.instanceAttributes(value, SOAP_DESERIALIZATION_ERROR);
        XsdAbstractType selected = XsdTypeSubstitutionHelper::select(\value, type, tmap, name, blocked_substitutions);
        if (*XsdNilValue nil = assessNil(selected, value)) {
            tuples.value(selected, NOTHING);
            # Keep the established bare and selected-type nil projections. Explicit
            # capture retains same-type presence, and attributes always need a carrier.
            auto retained = nil.getAttributes() || (PreserveNativeTypes
                && XsdTypeDerivationHelper::sameType(type, selected)) ? nil : NOTHING;
            return XsdNativeTypeValueHelper::retain(type, selected, retained);
        }
        auto original = value;
        *hash<XsdElementValueConstraintInfo> constraint = getValueConstraint();
        bool defaulted = constraint && XsdEmptyElementDefaultHelper::empty(value);
        if (defaulted) {
            string lexical = getConstraintIdentity().constraint_lexical ?? constraint.lexical;
            value = XsdEmptyElementDefaultHelper::apply(selected, value, lexical, constraint.namespaces);
        }
        *XsdDocumentValueResult captured = constraint.fixed || tuples.captures()
            ? new XsdDocumentValueResult(!constraint.fixed) : NOTHING;
        auto converted = XsdDocumentValueHelper::deserializeValue(selected, name, tmap, references, value, False,
            captured);
        tuples.value(captured.actual_type ?? selected, captured.identity);
        checkFixedValue(original, captured.identity, SOAP_DESERIALIZATION_ERROR);
        if (PreserveNativeTypes && !exists converted && selected instanceof XsdComplexType
                && !cast<XsdComplexType>(selected).simpleType && !cast<XsdComplexType>(selected).array
                && !cast<XsdComplexType>(selected).hasMixedContent()) {
            converted = {};
        }
        return XsdNativeTypeValueHelper::retain(type, selected,
            defaulted && PreserveNativeTypes ? new XsdDefaultValue(converted) : converted);
    }

    private hash<auto> serializeDefault(XsdAbstractType selected, Namespaces namespaces, XsdDefaultValue value,
            XsdDocumentValueResult actual) {
        *hash<XsdElementValueConstraintInfo> constraint = getValueConstraint();
        if (!constraint) {
            throw SOAP_SERIALIZATION_ERROR, sprintf("element %Y has no default or fixed constraint", name);
        }
        XsdAbstractType content = selected;
        if (selected instanceof XsdComplexType) {
            XsdComplexType complex_type = cast<XsdComplexType>(selected);
            if (!complex_type.allowsElementValueConstraint()) {
                throw SOAP_SERIALIZATION_ERROR, "an empty default requires simple or emptiable mixed content";
            }
            content = complex_type.simpleType ?? new XsdBaseType("string", new Namespaces({}));
        } else if (XsdGenericValueHelper::isGeneric(selected)) {
            content = new XsdBaseType("string", new Namespaces({}));
        }
        auto encoded = XsdDocumentValueHelper::serializeValue(selected, namespaces, value.getValue(), True, actual);
        # This also rules out children hidden in a supplied native mixed value.
        XsdFixedValueHelper::text(encoded, SOAP_SERIALIZATION_ERROR);
        XsdDocumentValueResult expected();
        try {
            XsdIdentitySuspendScope identity_check();
            XsdQNameNamespaceScope declaration_scope(XsdQNameContextHelper::attributes(constraint.namespaces), True);
            XsdDocumentValueHelper::deserializeValue(content, name, selected.nsc.getInstanceTypes(), NOTHING,
                getConstraintIdentity().constraint_lexical ?? constraint.lexical, False, expected);
        } catch (hash<ExceptionInfo> error) {
            if (error.err == SOAP_DESERIALIZATION_ERROR) {
                rethrow SOAP_SERIALIZATION_ERROR, error.desc, error.arg;
            }
            rethrow;
        }
        if (!actual.identity || !expected.identity || !XsdUnionValueHelper::same(actual.identity, expected.identity)) {
            throw SOAP_SERIALIZATION_ERROR, sprintf("empty element %Y would produce a different default value", name);
        }
        hash<auto> result = encoded.typeCode() == NT_HASH ? encoded : {};
        foreach string key in (keys result) {
            if (key.startsWith("^value") || key.startsWith("^cdata")) {
                remove result{key};
            }
        }
        remove result."^attributes^"{namespaces.getOutputNamespacePrefix(XSI_NS) + ":type"};
        return result;
    }

    private *XsdNilValue assessNil(XsdAbstractType selected, auto value) {
        *hash<auto> attributes = value.typeCode() == NT_HASH ? value."^attributes^" : NOTHING;
        hash<auto> expanded = XsdBase::getExpandedAttributes(attributes);
        string identity = type_qname(XSI_NS, "nil");
        if (!expanded.hasKey(identity)) {
            return;
        }
        if (!nillable) {
            throw SOAP_DESERIALIZATION_ERROR, sprintf("element %Y is not nillable", name);
        }
        if (expanded{identity}.typeCode() != NT_STRING) {
            throw SOAP_DESERIALIZATION_ERROR, "xsi:nil requires a boolean lexical value";
        }
        if (!XsdBooleanLexicalHelper::decode(expanded{identity}, SOAP_DESERIALIZATION_ERROR)) {
            return;
        }
        if (getValueConstraint().fixed) {
            throw SOAP_DESERIALIZATION_ERROR, sprintf("element %Y with a fixed value cannot be nilled", name);
        }
        XsdScalarTextHelper::requireEmpty(value, sprintf("nilled element %Y", name), SOAP_DESERIALIZATION_ERROR);
        return new XsdNilValue(XsdNilValueHelper::decodeAttributes(selected, attributes));
    }

    private hash<auto> serializeNil(XsdAbstractType selected, Namespaces namespaces, XsdNilValue value) {
        XsdIdentityElementScope identity_scope(True);
        on_success identity_scope.finish(SOAP_SERIALIZATION_ERROR);
        if (!nillable || getValueConstraint().fixed) {
            throw SOAP_SERIALIZATION_ERROR, sprintf("element %Y does not permit a nilled value", name);
        }
        hash<auto> attributes = XsdNilValueHelper::encodeAttributes(selected, namespaces, value.getAttributes()) ?? {};
        attributes{namespaces.getOutputNamespacePrefix(XSI_NS) + ":nil"} = "true";
        return {"^attributes^": attributes};
    }
}

thread_local *XsdNativeTypeProviderContext NativeTypeProviderContext;

#! Serializable definition shared by native selected-type provider boundaries
/** Internal provider graph metadata; created by schema and message provider factories.
    @since %WSDL 0.5.8
*/
public class XsdNativeTypeProviderDefinition inherits Serializable {
    public {
        #! The receiving declaration
        XsdAbstractType declared;
        #! The receiving schema and shared provider graph
        XsdNativeTypeProviderContext owner;
        #! The completed native value type
        *AbstractDataProviderType native_type;
        #! The completed soft native value type
        *AbstractDataProviderType soft_native_type;
    }
    #! creates a declaration entry before traversing its nested fields
    /** @param declared the receiving declaration
        @param owner the containing provider graph
        @note Factories finish both value types before exposing the graph.
    */
    constructor(XsdAbstractType declared, XsdNativeTypeProviderContext owner) {
        self.declared = declared;
        self.owner = owner;
    }
    private:internal deserializeMembers(hash<auto> members) {
        if (!(members.declared instanceof XsdAbstractType)
                || !(members.owner instanceof XsdNativeTypeProviderContext)
                || !(members.native_type instanceof AbstractDataProviderType)
                || !(members.soft_native_type instanceof AbstractDataProviderType)) {
            throw "DESERIALIZATION-ERROR", "a native provider definition requires its schema, owner and value types";
        }
        declared = members.declared;
        owner = members.owner;
        native_type = members.native_type;
        soft_native_type = members.soft_native_type;
    }
}

#! Serializable receiving schema and its completed native provider graph
/** Internal provider graph metadata; value validation only reads the completed graph.
    @since %WSDL 0.5.8
*/
public class XsdNativeTypeProviderContext inherits Serializable {
    public {
        #! Named type definitions in the receiving schema
        hash<string, XsdAbstractType> types;
        #! Completed native definitions indexed by component identity or canonical builtin name
        hash<string, XsdNativeTypeProviderDefinition> definitions;
        #! Component identities used to reconstruct the index after serialization
        hash<string, XsdAbstractType> components;
        #! Whether construction may add definitions
        bool building = True;
    }
    #! starts a provider graph for a receiving schema
    /** @param types resolved named definitions in the receiving schema */
    constructor(hash<string, XsdAbstractType> types) {
        self.types = types;
    }
    private:internal deserializeMembers(hash<auto> members) {
        if (members.types.typeCode() != NT_HASH || members.definitions.typeCode() != NT_HASH
                || members.components.typeCode() != NT_HASH
                || members.components.size() != members.definitions.size()
                || members.building.typeCode() != NT_BOOLEAN || members.building) {
            throw "DESERIALIZATION-ERROR", "a native provider requires a completed schema and definition graph";
        }
        foreach auto type in (members.types.iterator()) {
            if (!(type instanceof XsdAbstractType)) {
                throw "DESERIALIZATION-ERROR", "a native provider schema map requires type definitions";
            }
        }
        foreach hash<auto> row in (members.definitions.pairIterator()) {
            if (!(row.value instanceof XsdNativeTypeProviderDefinition)
                    || !(members.components{row.key} instanceof XsdAbstractType)) {
                throw "DESERIALIZATION-ERROR", "a native provider graph requires provider definitions";
            }
            # Component objects can still be initializing through a cycle. Their object identity
            # is already stable; reading their schema members here would depend on restoration order.
            XsdAbstractType component = members.components{row.key};
            string identity = index(row.key, "builtin:") == 0 ? row.key : component.uniqueHash();
            if (definitions.hasKey(identity)) {
                throw "DESERIALIZATION-ERROR", "a native provider graph cannot repeat a component identity";
            }
            definitions{identity} = row.value;
            components{identity} = component;
        }
        types = members.types;
        building = False;
    }
    private string key(XsdAbstractType type) {
        if (type instanceof XsdBaseType && Class::getClass(type).getPathName() == "WSDL::XsdBaseType"
                && type.name != "binary" && XsdBaseType::BuiltinTypes{type.name}
                && type.ons && type.nsc.getOutputNamespaceUri(type.ons) == XSD_NS) {
            return "builtin:" + type.name;
        }
        return type.uniqueHash();
    }
    #! obtains a shared definition or an intrinsic scalar adapter
    /** @param type the receiving component
        @return its native and soft value providers
        @throw SOAP-SERIALIZATION-ERROR a foreign component was supplied to a completed graph
        @note During construction, entries are inserted before nested elements are traversed.
    */
    XsdNativeTypeProviderDefinition getDefinition(XsdAbstractType type) {
        string identity = key(type);
        if (*XsdNativeTypeProviderDefinition found = definitions{identity}) {
            return found;
        }
        if (!building) {
            if (index(identity, "builtin:") == 0) {
                # Intrinsic scalar types have no recursive element graph. Build their small value
                # adapter on demand without extending the shared receiving schema's completed index.
                XsdNativeTypeProviderDefinition intrinsic(type, self);
                intrinsic.native_type = type.getDataProviderType();
                intrinsic.soft_native_type = intrinsic.native_type.getSoftType();
                return intrinsic;
            }
            throw SOAP_SERIALIZATION_ERROR, sprintf("selected type %Y is not in the provider's schema", type.name);
        }
        XsdNativeTypeProviderDefinition result(type, self);
        definitions{identity} = result;
        components{identity} = type;
        result.native_type = type.getDataProviderType();
        return result;
    }
    #! completes all named alternatives and freezes the graph before publication
    /** @note Intrinsic scalar adapters without nested elements can be created independently on demand. */
    complete() {
        foreach XsdAbstractType type in (types.iterator()) {
            getDefinition(type);
        }
        foreach XsdNativeTypeProviderDefinition definition in (definitions.iterator()) {
            @assert(definition.native_type);
            definition.soft_native_type = definition.native_type.getSoftType();
        }
        building = False;
    }
}

class XsdNativeTypeProviderScope {
    private {
        *XsdNativeTypeProviderContext previous;
    }
    constructor(*XsdNativeTypeProviderContext current) {
        previous = NativeTypeProviderContext;
        NativeTypeProviderContext = current;
    }
    destructor() {
        NativeTypeProviderContext = previous;
    }
}

class XsdNativeTypeProviderHelper {
    static XsdNativeTypeDataType create(XsdAbstractType type, hash<string, XsdAbstractType> types,
            *XsdElement element) {
        XsdNativeTypeProviderContext owner(types);
        XsdNativeTypeProviderScope scope(owner);
        XsdNativeTypeDataType result(owner.getDefinition(type), element);
        owner.complete();
        return element && (element.nillable || !element.minOccurs)
            ? cast<XsdNativeTypeDataType>(result.getOrNothingType()) : result;
    }
    static bool isNative(AbstractDataProviderType type) {
        if (type instanceof XsdNativeTypeDataType || type instanceof XsdElementDataType
                || type instanceof XsdNillableDataType || type instanceof XsdDefaultDataType) {
            return True;
        }
        return type instanceof ListDataType && (type.getElementType() instanceof XsdNativeTypeDataType
            || type.getElementType() instanceof XsdNillableDataType
            || type.getElementType() instanceof XsdDefaultDataType);
    }
    static auto unwrap(auto value) {
        if (XsdElementValueHelper::isWrapper(value)) {
            value = value."^val^";
        }
        if (XsdNativeTypeValueHelper::isWrapper(value)) {
            value = value."^val^";
        }
        return value instanceof XsdNilValue ? NOTHING : value instanceof XsdDefaultValue ? value.getValue() : value;
    }
}

#! An ordinary native value constrained by its receiving element's fixed value
/** Preserves the underlying scalar, list or record conversion and metadata, while
    validating the result against the receiving declaration before returning it.
    @par Example
    An invoice connector accepts only the schema's fixed currency, including after
    soft conversion or Serializable reconstruction.
    @since %WSDL 0.5.8
*/
public class XsdFixedElementDataType inherits AbstractDataProviderType {
    private {
        XsdElement element;
        AbstractDataProviderType value_type;
        bool optional;
    }
    #! wraps the native provider of a constrained receiving element
    /** @param element the receiving declaration
        @param value_type the ordinary native conversion provider
        @throw XSD-SIMPLETYPE-ERROR the element has no fixed constraint
    */
    constructor(XsdElement element, AbstractDataProviderType value_type) {
        if (!element.getValueConstraint().fixed) {
            throw "XSD-SIMPLETYPE-ERROR", "a fixed element provider requires a fixed constraint";
        }
        self.element = element;
        self.value_type = value_type;
        optional = value_type.isOrNothingType();
    }
    private:internal deserializeMembers(hash<auto> members) {
        if (!(members.element instanceof XsdElement) || !(members.value_type instanceof AbstractDataProviderType)
                || members.optional.typeCode() != NT_BOOLEAN) {
            throw "DESERIALIZATION-ERROR", "a fixed element provider requires its constraint, value type and optionality";
        }
        element = members.element;
        value_type = members.value_type;
        optional = members.optional;
    }
    private checkDeclaration() {
        # Referenced declarations may be restored later than this provider.
        if (!element.getValueConstraint().fixed) {
            throw "DESERIALIZATION-ERROR", "a fixed element provider requires a fixed receiving declaration";
        }
    }
    #! returns the receiving native type name
    /** @return the underlying provider's name */
    string getName() {
        return (optional ? value_type.getOrNothingType() : value_type.getMandatoryType()).getName();
    }
    #! describes the receiving value constraint
    /** @return the fixed-value contract */
    string getDesc() { return "Accepts the declared native value only when it satisfies the element's fixed value."; }
    #! preserves underlying semantic tags
    /** @return the native provider tags */
