%requires qore >= 2.0
%requires(reexport) xml
%requires(reexport) ConnectionProvider >= 2.2
%requires(reexport) WebDavClient
%requires HttpClientIo
%requires Util
%requires Logger
%requires MapperUtil

%modern

module WebDavClientIo {
    version = "1.0";
    desc = "Pure-Qore WebDAV client module with async I/O via HttpClientIo";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("webdavio", WebDavIoConnection::ConnectionScheme);
        ConnectionSchemeCache::registerScheme("webdavios", WebDavIoConnection::ConnectionScheme);
    };
}

/** @mainpage WebDavClientIo Module

    @tableofcontents

    @section webdavclientiointro Introduction to the WebDavClientIo Module

    The %WebDavClientIo module provides a WebDAV client implementation using async I/O via
    \c HttpClientIo::HttpClientConnectionManager with automatic protocol negotiation
    (HTTP/3 &rarr; HTTP/2 &rarr; HTTP/1.1) and connection pooling.

    This module is the async-I/O replacement for the @ref WebDavClient::WebDavClient class
    (which is built on the synchronous \c HTTPClient class). Asynchronous socket I/O is the
    preferred native way of performing socket I/O in Qore; new code should target this module.

    The public API matches @ref WebDavClient::WebDavClient method-for-method, so callers can
    swap one for the other with minimal changes.

    @par Example
    @code{.py}
%requires WebDavClientIo

WebDavClientIo client({"url": "https://webdav.example.com/files"});

# List directory contents
list<hash<WebDavResourceInfo>> resources = client.list("/");

# Upload a file
client.put("/test.txt", "Hello, World!");

# Download a file
*binary content = client.get("/test.txt");
    @endcode

    @section webdavclientiorelnotes Release Notes

    @subsection webdavclientio_v1_0 WebDavClientIo v1.0
    - initial release
*/

#! Main public WebDavClientIo namespace
public namespace WebDavClientIo {
}
