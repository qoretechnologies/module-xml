#!/usr/bin/env qore

# CargoXML data provider example.
#
# Lists discoverable messages from a schema directory (defaulting to the
# bundled UN/CEFACT D25A package) and demonstrates parsing and building one
# of them with optional XSD validation.
#
# Usage:
#     cargo-xml.qr list
#     cargo-xml.qr show <qname>
#     cargo-xml.qr parse <qname> <xml-file>
#     cargo-xml.qr build <qname>
#
# Where <qname> is "{namespace_uri}local_name", e.g.
#     {urn:un:unece:uncefact:data:standard:CrossIndustryDespatchAdvice:27}CrossIndustryDespatchAdvice
#
# Set CARGOXML_SCHEMA_DIR to point at a custom XSD package (e.g. an IATA
# Cargo-XML toolkit) instead of the bundled UN/CEFACT schemas.

%requires CargoXmlDataProvider
%exec-class CargoXmlExample

class CargoXmlExample {
    private {
        CargoXmlDataProvider::CargoXmlDataProvider dp;
    }

    constructor() {
        hash<auto> opts;
        if (ENV.CARGOXML_SCHEMA_DIR) {
            opts.schema_dir = ENV.CARGOXML_SCHEMA_DIR;
        }
        dp = new CargoXmlDataProvider::CargoXmlDataProvider(opts);

        if (ARGV.empty()) {
            usage();
        }
        string cmd = shift ARGV;
        switch (cmd) {
            case "list": list_cmd(); break;
            case "show": show_cmd(); break;
            case "parse": parse_cmd(); break;
            case "build": build_cmd(); break;
            default: usage();
        }
    }

    private list_cmd() {
        list<string> names = sort(dp.getChildProviderNames());
        printf("%d messages discovered in %y\n\n", names.size(), dp.schema_dir);
        foreach string n in (names) {
            printf("  %s\n", n);
        }
    }

    private show_cmd() {
        if (ARGV.empty()) {
            usage();
        }
        string qname = shift ARGV;
        *hash<CargoXmlDataProvider::CargoXmlMessageInfo> mi = dp.getMessages(){qname};
        if (!mi) {
            stderr.printf("no message %y; try `list` to see what is available\n", qname);
            exit(1);
        }
        printf("name:      %s\n", mi.name);
        printf("namespace: %s\n", mi.namespace);
        printf("xsd_file:  %s\n", mi.xsd_file);
    }

    private parse_cmd() {
        if (ARGV.size() < 2) {
            usage();
        }
        string qname = shift ARGV;
        string xml_path = shift ARGV;
        AbstractDataProvider msg = dp.getChildProviderEx(qname);

        File f();
        f.open2(xml_path, O_RDONLY);
        string xml = f.read(-1);

        hash<CargoXmlDataProvider::CargoXmlMessageRequest> req =
            <CargoXmlDataProvider::CargoXmlMessageRequest>{
                "direction": "parse",
                "xml": xml,
                "validate": True,
            };
        try {
            hash<CargoXmlDataProvider::CargoXmlMessageResponse> resp =
                cast<hash<CargoXmlDataProvider::CargoXmlMessageResponse>>(msg.doRequest(req));
            printf("VALID. Parsed payload:\n%y\n", resp.data);
        } catch (hash<ExceptionInfo> ex) {
            stderr.printf("validation failed: %s: %s\n", ex.err, ex.desc);
            exit(2);
        }
    }

    # Build a placeholder message just to demonstrate the build path.  Most
    # real CargoXML messages have many required children, so this will
    # typically fail XSD validation by design — the user is expected to
    # populate `data` with their own payload.
    private build_cmd() {
        if (ARGV.empty()) {
            usage();
        }
        string qname = shift ARGV;
        *hash<CargoXmlDataProvider::CargoXmlMessageInfo> mi = dp.getMessages(){qname};
        if (!mi) {
            stderr.printf("no message %y\n", qname);
            exit(1);
        }
        AbstractDataProvider msg = dp.getChildProviderEx(qname);

        # the simplest possible payload: one element from the message's namespace
        hash<auto> data = {
            mi.name: {
                "^attributes^": {"xmlns": mi.namespace},
            },
        };
        hash<CargoXmlDataProvider::CargoXmlMessageRequest> req =
            <CargoXmlDataProvider::CargoXmlMessageRequest>{
                "direction": "build",
                "data": data,
                "validate": False,
            };
        hash<CargoXmlDataProvider::CargoXmlMessageResponse> resp =
            cast<hash<CargoXmlDataProvider::CargoXmlMessageResponse>>(msg.doRequest(req));
        print(resp.xml + "\n");
    }

    private usage() {
        stderr.printf(
            "usage: cargo-xml.qr <command> [args]\n"
            "  list                         list discoverable messages\n"
            "  show <qname>                 show details of a message\n"
            "  parse <qname> <xml-file>     parse + XSD-validate <xml-file>\n"
            "  build <qname>                build an empty placeholder message (no validation)\n\n"
            "<qname> is \"{namespace_uri}local_name\", e.g.\n"
            "  '{urn:un:unece:uncefact:data:standard:CrossIndustryDespatchAdvice:27}CrossIndustryDespatchAdvice'\n\n"
            "Set CARGOXML_SCHEMA_DIR to point at a custom XSD package instead of the bundled\n"
            "UN/CEFACT D25A schemas.\n");
        exit(1);
    }
}
