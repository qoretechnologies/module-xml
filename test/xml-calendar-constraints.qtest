#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "Calendar constraint tests require the json module";
%else
%exec-class XmlCalendarConstraintsTest

class XmlCalendarConstraintsTest inherits QUnit::Test {
    constructor() : Test("Native canonical calendar constraint declarations", "1.0") {
        addTestCase("Default and fixed constraints require valid canonical forms", \constraints());
        addTestCase("Calendar boundaries and exact facet values use owned fields", \boundaries());
        set_return_value(main());
    }
    private static bool consume(string schema, string xml) {
        XmlReader reader(new StringInputStream(xml), {"xsd": schema});
        int roots = 0;
        while (reader.read()) {
            if (reader.nodeType() == XML_NODE_TYPE_ELEMENT && !reader.depth()) {
                ++roots;
            }
        }
        return roots == 1 && reader.isValid();
    }
    private constraints() {
        list<hash<auto>> models = parse_json(ReadOnlyFile::readTextFile(
            get_script_dir() + "/wsdl-interop/fixtures/calendar-constraints.json"));
        assertEq(306, models.size());
        foreach hash<auto> model in (models) {
            XmlDoc document(model.xml);
            if (model.valid) {
                assertTrue(consume(model.schema, model.xml), model.name);
                assertEq(parse_xml(model.xml), parse_xml_with_schema(model.xml, model.schema), model.name);
                document.validateSchema(model.schema);
                document.validateSchema(model.schema);
            } else {
                assertThrows("XSD-SYNTAX-ERROR", \consume(), (model.schema, model.xml));
                assertThrows("XSD-SYNTAX-ERROR", \parse_xml_with_schema(), (model.xml, model.schema));
                assertThrows("XSD-SYNTAX-ERROR", \document.validateSchema(), (model.schema,));
            }
        }
    }
    private check(string source, string text, bool valid) {
        string xml = make_xml({"value":text});
        XmlDoc document(xml);
        string before = document.toString();
        if (valid) {
            assertTrue(consume(source, xml));
            assertEq(parse_xml(xml), parse_xml_with_schema(xml, source));
            document.validateSchema(source);
        } else {
            assertThrows("PARSE-XML-EXCEPTION", \consume(), (source, xml));
            assertThrows("PARSE-XML-EXCEPTION", \parse_xml_with_schema(), (xml, source));
            assertThrows("XSD-ERROR", \document.validateSchema(), (source,));
        }
        assertEq(before, document.toString());
    }
    private static string facetSchema(string builtin, string facet, string value) {
        return '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"><xs:element name="value">'
            '<xs:simpleType><xs:restriction base="xs:' + builtin + '"><xs:' + facet + ' value="'
            + value + '"/></xs:restriction></xs:simpleType></xs:element></xs:schema>';
    }
    private boundaries() {
        list<hash<auto>> rows = parse_json(ReadOnlyFile::readTextFile(
            get_script_dir() + "/wsdl-interop/fixtures/calendar-constraint-boundaries.json"));
        assertEq(18, rows.size());
        foreach hash<auto> row in (rows) {
            string source = facetSchema(row.builtin, "enumeration", row.canonical);
            check(source, row.source, True);
            check(source, row.canonical, True);
        }
        foreach string builtin in ("time", "dateTime") {
            string prefix = builtin == "time" ? "" : "2000-01-01T";
            string source = facetSchema(builtin, "enumeration", prefix + "12:00:00.1234567890123456789Z");
            check(source, prefix + "13:00:00.123456789012345678900+01:00", True);
            check(source, prefix + "12:00:00.1234567890123456788Z", False);
            check(source, prefix + "12:00:00.1234567890123456790Z", False);
            check(source, prefix + "12:00:00.1234567890123456789", False);
        }
        foreach string value in ("09:39:60.22", "00:11:60.56", "23:59:60.1234567890123456789") {
            foreach string offset in ("+14:00", "-14:00") {
                foreach string facet in ("minInclusive", "maxInclusive") {
                    string source = facetSchema("time", facet, value + offset);
                    check(source, value + offset, True);
                    check(source, value, False);
                    source = facetSchema("time", facet, value);
                    check(source, value, True);
                    check(source, value + offset, False);
                }
            }
        }
        string source = facetSchema("date", "enumeration", "2000-01-01Z");
        check(source, "1900-02-29", False);
        check(source, "0000-01-01Z", False);
        check(source, "02000-01-01Z", False);
        check(source, "2000-01-01+14:01", False);
        check(source, "2000-01-01Z", True);
    }

}
%endif
