#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class WsdlDeclarationIdentityTest

class WsdlDeclarationIdentityTest inherits QUnit::Test {
    constructor() : Test("WSDL declaration identity", "1.0") {
        addTestCase("The document root has WSDL 1.1 identity", \roots());
        addTestCase("Top-level declarations cannot overwrite the same symbol", \duplicates());
        addTestCase("Part and port names are unique within their owner", \localNames());
        addTestCase("Declaration names are required XML NCNames", \names());
        addTestCase("Empty services and port types survive source and saved graphs", \empty());
        addTestCase("Distinct symbol spaces may use the same name", \spaces());
        addTestCase("Prefix aliases and whitespace preserve declaration identity", \aliases());
        addTestCase("Documentation and foreign payloads do not declare components", \payloads());
        addTestCase("Fault names belong to their operation scope", \faults());
        set_return_value(main());
    }
    private static string document(string content) {
        return '<w:definitions xmlns:w="http://schemas.xmlsoap.org/wsdl/"'
            + ' xmlns:a="http://schemas.xmlsoap.org/wsdl/" xmlns:t="urn:declarations"'
            + ' xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:s="http://schemas.xmlsoap.org/wsdl/soap/"'
            + ' targetNamespace="urn:declarations">' + content + '</w:definitions>';
    }
    private static WebService parse(string xml) {
        return new WebService(xml, {"async_only":True});
    }
    private static string binding(string name = "B") {
        return '<w:binding name="' + name + '" type="t:P">'
            + '<s:binding transport="http://schemas.xmlsoap.org/soap/http"/></w:binding>';
    }
    private roots() {
        foreach string root in ('<definitions/>', '<definitions xmlns="urn:wrong"/>',
                '<schema xmlns="http://www.w3.org/2001/XMLSchema"/>',
                '<w:service xmlns:w="http://schemas.xmlsoap.org/wsdl/" name="S"/>') {
            assertThrows("WSDL-ERROR", \parse(), (root,));
        }
        assertEq((), parse(document("")).getOperationNames() ?? ());
        WebService standard = parse('<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"/>');
        assertEq((), standard.listServices());
    }
    private duplicates() {
        foreach string component in ('<w:message name="M"/>', '<w:portType name="P"/>',
                binding(), '<w:service name="S"/>') {
            string prefix = component.startsWith('<w:binding') ? '<w:portType name="P"/>' : "";
            assertThrows("WSDL-ERROR", \parse(), (document(prefix + component + component),));
            WebService valid = parse(document(prefix + component));
            assertEq(document(prefix + component), valid.getWSDL());
        }
    }
    private localNames() {
        string part = '<w:part name="p" type="xs:string"/>';
        assertThrows("WSDL-ERROR", \parse(), (document('<w:message name="M">' + part + part
            + '</w:message>'),));
        WebService messages = parse(document('<w:message name="A">' + part + '</w:message>'
            + '<w:message name="B">' + part + '</w:message>'));
        assertEq(("A", "B"), keys messages.messages);
        assertEq(("p",), keys messages.messages.A.pmap);
        string port = '<w:port name="Endpoint" binding="t:B"><s:address location="http://example.invalid/"/></w:port>';
        string prefix = '<w:portType name="P"/>' + binding();
        assertThrows("WSDL-ERROR", \parse(), (document(prefix + '<w:service name="S">' + port + port
            + '</w:service>'),));
        WebService services = parse(document(prefix + '<w:service name="A">' + port + '</w:service>'
            + '<w:service name="B">' + port + '</w:service>'));
        assertEq(("A", "B"), map $1.name, services.listServices());
        assertTrue(services.getService("A").port.Endpoint.binding === services.getService("B").port.Endpoint.binding);
    }
    private names() {
        foreach string component in ("message", "portType", "binding", "service") {
            foreach string attributes in ("", 'name=""', 'name="1bad"', 'name="a:b"', 'name="two names"') {
                assertThrows("WSDL-ERROR", \parse(), (document('<w:' + component + ' ' + attributes + '/>'),));
            }
        }
        foreach string name in ("", "a:b", "two names") {
            assertThrows("WSDL-ERROR", \parse(),
                ('<definitions xmlns="http://schemas.xmlsoap.org/wsdl/" name="' + name + '"/>',));
        }
        WebService named = parse('<definitions xmlns="http://schemas.xmlsoap.org/wsdl/" name=" Inventory "/>');
        assertEq((), named.listServices());
        foreach string attributes in ("", 'name=""', 'name="a:b"') {
            assertThrows("WSDL-ERROR", \parse(), (document('<w:message name="M"><w:part '
                + attributes + ' type="xs:string"/></w:message>'),));
            assertThrows("WSDL-ERROR", \parse(), (document('<w:service name="S"><w:port '
                + attributes + ' binding="t:B"/></w:service>'),));
        }
    }
    private empty() {
        WebService original = parse(document('<w:portType name="P"/>' + binding() + '<w:service name="S"/>'));
        foreach WebService current in (original, Serializable::deserialize(original.serialize()),
                Serializable::deserialize(original.serializeToData())) {
            assertEq(("P",), keys current.portType);
            assertEq({}, current.portType.P.operations);
            assertEq("P", current.getBinding("B").getPort());
            assertEq(("S",), map $1.name, current.listServices());
            assertEq({}, current.getService("S").port);
            assertThrows("WSDL-OPERATION-ERROR", \current.getPortTypeOperation(), ("P", "absent"));
            StringOutputStream report();
            current.getReport(report);
            assertTrue(report.getData() =~ /service: S/);
        }
    }
    private spaces() {
        WebService current = parse(document('<w:message name="P"/><w:portType name="P"/>'
            + binding("P") + '<w:service name="P"/>'));
        assertEq(("P",), keys current.messages);
        assertEq(("P",), keys current.portType);
        assertEq("P", current.getBinding("P").getName());
        assertEq("P", current.getService("P").name);
    }
    private faults() {
        string prefix = '<w:message name="M"/><w:portType name="P">';
        string start = '<w:operation name="invoke"><w:input message="t:M"/><w:output message="t:M"/>';
        string fault = '<w:fault name="Failure" message="t:M"/>';
        assertThrows("WSDL-ERROR", \parse(), (document(prefix + start + fault + fault
            + '</w:operation></w:portType>'),));
        WebService current = parse(document(prefix + start + fault + '</w:operation>'
            + replace(start, 'name="invoke"', 'name="other"') + fault + '</w:operation></w:portType>'));
        assertTrue(current.getOperation("invoke").getFaultMessages().Failure
            === current.getOperation("other").getFaultMessages().Failure);
        foreach string invalid in ('<w:operation/>', '<w:operation name="a:b"/>') {
            assertThrows("WSDL-ERROR", \parse(), (document(prefix + invalid + '</w:portType>'),));
        }
        foreach string invalid in ('<w:fault message="t:M"/>', '<w:fault name="a:b" message="t:M"/>') {
            assertThrows("WSDL-ERROR", \parse(), (document(prefix + start + invalid
                + '</w:operation></w:portType>'),));
        }
    }
    private payloads() {
        WebService current = parse(document('<w:documentation><w:message name="not a declaration"/>'
            + '<w:message name="not a declaration"/></w:documentation>'
            + '<x:extension xmlns:x="urn:extension"><w:message name="not a declaration"/></x:extension>'
            + '<w:message name="M"/>'));
        assertEq(("M",), keys current.messages);
        assertEq({}, current.messages.M.pmap);
    }
    private aliases() {
        assertThrows("WSDL-ERROR", \parse(), (document('<w:message name="M"/><a:message name="M"/>'),));
        assertThrows("WSDL-ERROR", \parse(), (document('<w:message name="M"/><a:message name="  M &#x9;"/>'),));
        WebService current = parse(document('<a:message name="  Δεδομένα  "><a:part name=" value " type="xs:string"/>'
            + '</a:message><a:portType name=" P "/><a:service name=" S "/>'));
        assertEq(("Δεδομένα",), keys current.messages);
        assertEq(("value",), keys current.messages{"Δεδομένα"}.pmap);
        assertEq(("P",), keys current.portType);
        assertEq("S", current.getService("S").name);
    }
}
