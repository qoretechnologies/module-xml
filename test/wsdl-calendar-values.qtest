#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class CalendarValuesTest

class CalendarValuesTest inherits QUnit::Test {
    constructor() : Test("XSD calendar values", "1.0") {
        addTestCase("Calendar grammar and exact lexical output", \valid());
        addTestCase("Invalid grammar, ranges and input categories", \invalid());
        addTestCase("Timezone absence and arbitrary years retain XML text", \representation());
        addTestCase("Native absolute calendar projection keeps its offset", \native());
        addTestCase("Gregorian cycle and negative leap boundaries", \cycle());
        addTestCase("Providers preserve builtin validation and reconstruction", \providers());
        set_return_value(main());
    }

    private static XsdBaseType base(string builtin) {
        return new Namespaces({}).getBaseType(builtin);
    }

    private valid() {
        hash<string, list<string>> cases = {
            "date": ("2026-09-09", "2026-09-09Z", "2026-09-09+14:00", "2026-09-09-14:00",
                "12345-09-09Z", "-0001-01-01Z", "-0004-02-29Z", "-0400-02-29Z",
                "2147483647-12-31Z", "-2147483648-01-01Z", "2147483648-01-01Z"),
            "gYear": ("2026", "2026Z", "-0001+05:30", "12345-14:00", "2147483648"),
            "gYearMonth": ("2026-09", "-0001-01Z", "12345-12+14:00", "2026-02-00:00"),
            "gMonthDay": ("--02-29", "--12-31Z", "--01-01-14:00", "--06-30+05:30"),
            "gMonth": ("--01", "--12Z", "--02+14:00", "--03-00:00"),
            "gDay": ("---01", "---31Z", "---29+14:00", "---30-14:00"),
        };
        foreach string builtin in (keys cases) {
            XsdBaseType type = base(builtin);
            foreach string value in (cases{builtin}) {
                assertEq(value, type.serializeValue(new Namespaces({}), " \t" + value + "\r\n", True));
                auto decoded = type.deserializeValue("value", {}, NOTHING, " \t" + value + "\r\n");
                auto encoded = type.serializeValue(new Namespaces({}), decoded, True);
                foreach AbstractDataProviderType provider in (type.getDataProviderType(),
                        Serializable::deserialize(type.getDataProviderType().serialize())) {
                    assertEq(decoded, provider.acceptsValue(value));
                    assertEq(decoded, new ListDataType(provider).acceptsValue((value,))[0]);
                }
                assertEq(decoded, type.deserializeValue("value", {}, NOTHING, encoded));
                if (decoded.typeCode() == NT_STRING) {
                    assertEq(value, decoded);
                    assertEq(value, encoded);
                }
            }
        }
    }

    private invalid() {
        hash<string, list<auto>> cases = {
            "date": ("2026-09-09T00:00:00Z", "20260909", "2026-9-09", "2026-09-9", "0000-01-01",
                "-0000-01-01", "00001-01-01", "-00001-01-01", "+2026-01-01", "2026-02-29", "1900-02-29",
                "-0001-02-29", "-0100-02-29", "2026-04-31", "2026-00-01", "2026-01-00", "2026-13-01"),
            "gYear": ("0000", "-0000", "123", "+2026", "02026", "-02026", "2026-01", "2026T00:00:00"),
            "gYearMonth": ("0000-01", "2026-00", "2026-13", "2026-1", "2026-01-01", "202601", "-02026-01"),
            "gMonthDay": ("--02-30", "--04-31", "--00-01", "--13-01", "--01-00", "--1-01", "02-29"),
            "gMonth": ("--00", "--13", "--1", "--01--", "01", "--01-01"),
            "gDay": ("---00", "---32", "---1", "--01", "01", "---01T00:00:00"),
        };
        hash<string, string> good = {"date": "2026-09-09", "gYear": "2026", "gYearMonth": "2026-09",
            "gMonthDay": "--09-09", "gMonth": "--09", "gDay": "---09"};
        foreach string builtin in (keys cases) {
            XsdBaseType type = base(builtin);
            AbstractDataProviderType validated = type.getDataProviderType();
            foreach string suffix in ("+14:01", "-14:01", "+15:00", "-15:00", "+00:60", "-00:60",
                    "+1:00", "+0100", "z", "ZZ", "Ztail", "Z\ntrailing", "\u00A0") {
                push cases{builtin}, good{builtin} + suffix;
            }
            list<auto> invalid_values();
            foreach auto candidate in (cases{builtin}) {
                push invalid_values, candidate;
            }
            invalid_values += ("", " ", 2026, 1.5, True, NOTHING, (), <00>);
            foreach auto value in (invalid_values) {
                assertThrows("SOAP-SERIALIZATION-ERROR", \type.serializeValue(), (new Namespaces({}), value, True), sprintf("%Y", value));
                assertThrows("SOAP-DESERIALIZATION-ERROR", \type.deserializeValue(), ("value", {}, NOTHING, value), sprintf("%Y", value));
                assertThrows(exists value ? "RUNTIME-TYPE-ERROR" : "MISSING-VALUE-ERROR",
                    \validated.acceptsValue(), (value,));
                assertEq(good{builtin}, type.serializeValue(new Namespaces({}), good{builtin}, True));
            }
        }
    }

    private representation() {
        XsdBaseType type = base("date");
        assertEq(NT_DATE, type.deserializeValue("value", {}, NOTHING, "2026-09-09Z").typeCode());
        assertEq(NT_STRING, type.deserializeValue("value", {}, NOTHING, "2026-09-09").typeCode());
        string huge = "1" + strmul("0", 1000);
        foreach string year in (huge, "-" + huge, "2147483648", "-2147483649") {
            string value = year + "-01-01Z";
            assertEq(value, type.deserializeValue("value", {}, NOTHING, value));
            assertEq(value, type.serializeValue(new Namespaces({}), value, True));
        }
        foreach string zone in ("Z", "+00:00", "-00:00", "+05:30", "-03:30", "+14:00", "-14:00") {
            date value = type.deserializeValue("value", {}, NOTHING, "2026-09-09" + zone);
            assertEq("2026-09-09", value.format("YYYY-MM-DD"));
            assertEq(zone == "+05:30" ? 19800 : zone == "-03:30" ? -12600
                : zone == "+14:00" ? 50400 : zone == "-14:00" ? -50400 : 0, value.getUtcOffset());
        }
    }

    private native() {
        TimeZone east(19800);
        date value = east.date("2026-09-09T12:34:56.123456");
        hash<string, string> expected = {"date": "2026-09-09+05:30", "gYear": "2026+05:30",
            "gYearMonth": "2026-09+05:30", "gMonthDay": "--09-09+05:30", "gMonth": "--09+05:30",
            "gDay": "---09+05:30"};
        foreach string builtin in (keys expected) {
            XsdBaseType type = base(builtin);
            assertEq(expected{builtin}, type.serializeValue(new Namespaces({}), value, True));
            assertThrows("SOAP-SERIALIZATION-ERROR", \type.serializeValue(), (new Namespaces({}), days(1), True));
            TimeZone seconds(32);
            assertThrows("SOAP-SERIALIZATION-ERROR", \type.serializeValue(),
                (new Namespaces({}), seconds.date("2026-09-09"), True));
            TimeZone out_of_range(50460);
            assertThrows("SOAP-SERIALIZATION-ERROR", \type.serializeValue(),
                (new Namespaces({}), out_of_range.date("2026-09-09"), True));
        }
    }

    private cycle() {
        XsdBaseType type = base("date");
        foreach int sign in (-1, 1) {
            for (int year = 1; year <= 400; ++year) {
                string lexical = (sign < 0 ? "-" : "") + sprintf("%04d-02-29", year);
                bool leap = !(year % 4) && ((year % 100) || !(year % 400));
                if (leap) {
                    assertEq(lexical, type.deserializeValue("value", {}, NOTHING, lexical));
                } else {
                    assertThrows("SOAP-DESERIALIZATION-ERROR", \type.deserializeValue(), ("value", {}, NOTHING, lexical));
                }
            }
        }
    }
    private providers() {
        foreach string builtin in ("date", "gYear", "gYearMonth", "gMonthDay", "gMonth", "gDay") {
            AbstractDataProviderType original = base(builtin).getDataProviderType();
            foreach AbstractDataProviderType provider in (original, Serializable::deserialize(original.serialize()),
                    original.getOrNothingType().getMandatoryType()) {
                assertEq(builtin, cast<XsdCalendarDataType>(provider).getBuiltinName());
                assertEq("xsd:" + builtin, provider.getName());
                assertEq(NOTHING, provider.getValueType());
                assertEq({"string": True, "date": True}, provider.getAcceptTypeHash(True));
                assertEq(builtin == "date" ? {"string": True, "date": True} : {"string": True},
                    provider.getReturnTypeHash(True));
                assertEq({}, provider.getDirectTypeHash());
                assertThrows("MISSING-VALUE-ERROR", \provider.acceptsValue(), (NOTHING,));
                assertEq(NOTHING, provider.getOrNothingType().acceptsValue(NOTHING));
                assertTrue(provider.isMandatory());
                assertFalse(provider.getOrNothingType().isMandatory());
            }
        }
        assertThrows("WSDL-ERROR", sub () { new XsdCalendarDataType("string"); });
    }

}
