#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "ID binding regressions require the json module";
%else
%exec-class XmlIdBindingsTest

class XmlIdBindingsTest inherits QUnit::Test {
    private {
        list<hash<auto>> models;
    }

    constructor() : QUnit::Test("Native XSD document ID bindings", "1.0") {
        models = parse_json(ReadOnlyFile::readTextFile(
            get_script_dir() + "/wsdl-interop/fixtures/id-bindings.json")).models;
        addTestCase("IDs bind to scoped owners after actual datatype selection", \bindings());
        addTestCase("Large forward-reference tables and reader close release state", \growth());
        set_return_value(main());
    }

    private static nothing consume(string schema, string xml) {
        XmlReader reader(new StringInputStream(xml), {"xsd": schema});
        while (reader.read()) {
        }
    }

    private static nothing validate(string schema, string xml) {
        XmlDoc doc(xml);
        doc.validateSchema(schema);
    }

    private accepted(string schema, string xml) {
        hash<auto> value = parse_xml_with_schema(xml, schema);
        assertEq(parse_xml(xml), value);
        XmlDoc doc(xml);
        doc.validateSchema(schema);
        doc.validateSchema(schema);
        XmlReader reader(new StringInputStream(xml), {"xsd": schema});
        int element_count = 0;
        while (reader.read()) {
            if (reader.nodeType() == XML_NODE_TYPE_ELEMENT) {
                ++element_count;
            }
        }
        assertTrue(element_count > 0);
        assertTrue(reader.isValid());
    }

    private rejected(string schema, string xml) {
        assertThrows("PARSE-XML-EXCEPTION", \parse_xml_with_schema(), (xml, schema));
        assertThrows("PARSE-XML-EXCEPTION", \consume(), (schema, xml));
        assertThrows("XSD-ERROR", \validate(), (schema, xml));
    }

    bindings() {
        int count = 0;
        foreach hash<auto> model in (models) {
            foreach hash<auto> document in (model.documents) {
                ++count;
                if (document.valid) {
                    accepted(model.schema, document.xml);
                } else {
                    rejected(model.schema, document.xml);
                }
            }
        }
        assertEq(68, count);
    }

    growth() {
        string schema = models[0].schema;
        string refs = "";
        string ids = "";
        for (int i = 0; i < 1000; ++i) {
            refs += sprintf("<ref>entry%d</ref>", i);
            ids += sprintf("<id>entry%d</id>", i);
        }
        string valid = "<value>" + refs + ids + "</value>";
        accepted(schema, valid);
        rejected(schema, "<value>" + refs + "</value>");
        for (int i = 0; i < 8; ++i) {
            {
                XmlReader reader(new StringInputStream(valid), {"xsd": schema});
                assertTrue(reader.read());
                assertTrue(reader.read());
            }
            accepted(schema, "<value><ref>a</ref><id>a</id></value>");
            rejected(schema, "<value><ref>a</ref></value>");
        }
    }
}
%endif
