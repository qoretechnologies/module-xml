#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class FacetDeclarationTest

class FacetDeclarationTest inherits QUnit::Test {
    constructor() : Test("XSD numeric facet declarations", "1.0") {
        addTestCase("Required lexical facet values and unique declarations", \lexical());
        addTestCase("Applicable facets and builtin fixed values", \applicable());
        addTestCase("Exact bound consistency and inherited exclusive boundaries", \bounds());
        addTestCase("Derived facets narrow their base and preserve fixed constraints", \derived());
        addTestCase("Facet values satisfy the base lexical and value spaces", \baseValues());
        addTestCase("Arbitrary-size digit counts remain exact", \largeCounts());
        addTestCase("Facet XML names and attributes use the schema namespace", \namespaces());
        addTestCase("Restriction annotations and facet content preserve grammar", \grammar());
        addTestCase("Inherited opposite bounds reject equal mixed endpoints", \inheritedBounds());
        addTestCase("Failed facet additions restore schema state and reconstruction", \rollback());
        set_return_value(main());
    }

    private static XsdSchema schema(string base, string facets, *string parent) {
        string declarations = exists parent ? '<xs:simpleType name="Base"><xs:restriction base="xs:' + base + '">'
            + parent + '</xs:restriction></xs:simpleType>' : "";
        return new XsdSchema('<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:facet-declarations"
            targetNamespace="urn:facet-declarations">' + declarations + '<xs:simpleType name="Amount">
            <xs:restriction base="' + (exists parent ? "t:Base" : "xs:" + base) + '">' + facets
            + '</xs:restriction></xs:simpleType></xs:schema>', {"async_only": True});
    }

    private rejected(string base, string facets, *string parent) {
        assertThrows("XSD-SIMPLETYPE-ERROR", \schema(), (base, facets, parent));
    }

    private accepted(string base, string facets, string lexical, *string parent) {
        XsdSchema original = schema(base, facets, parent);
        foreach XsdSchema current in (original, Serializable::deserialize(original.serialize())) {
            XsdAbstractType type = current.findType(make_qname("urn:facet-declarations", "Amount"));
            Namespaces nsc({});
            auto value = type.deserializeValue("amount", current.getTypeMap(), NOTHING, lexical);
            assertEq(value, type.deserializeValue("amount", current.getTypeMap(), NOTHING,
                type.serializeValue(nsc, value, True)));
            assertEq(value, Serializable::deserialize(type.getDataProviderType().serialize()).acceptsValue(lexical));
        }
    }

    private lexical() {
        foreach string facet in ("minInclusive", "maxInclusive", "minExclusive", "maxExclusive",
                "totalDigits", "fractionDigits", "enumeration", "pattern", "whiteSpace") {
            rejected("decimal", '<xs:' + facet + '/>');
        }
        foreach string facet in ("totalDigits", "fractionDigits") {
            foreach string value in ("", "1x", "1.0", "1e2", "-1", "١") {
                rejected("decimal", '<xs:' + facet + ' value="' + value + '"/>');
            }
            rejected("decimal", '<xs:' + facet + ' value="2"/><xs:' + facet + ' value="2"/>');
        }
        rejected("decimal", '<xs:totalDigits value="0"/>');
        rejected("decimal", '<xs:minInclusive value="1"/><xs:minInclusive value="1"/>');
        rejected("decimal", '<xs:minInclusive value="1" fixed="yes"/>');
        rejected("decimal", '<xs:minInclusive value="1" extra="x"/>');
        rejected("decimal", '<xs:pattern value="["/>');
        accepted("decimal", '<xs:totalDigits value=" +0004 "/><xs:fractionDigits value="-0"/>', "12");
        accepted("decimal", '<xs:enumeration value="1"/><xs:enumeration value="+001.00"/>', "1.0");
    }

    private applicable() {
        foreach string facet in ("length", "minLength", "maxLength") {
            rejected("decimal", '<xs:' + facet + ' value="1"/>');
        }
        rejected("decimal", '<xs:unknown value="1"/>');
        rejected("decimal", '<xs:whiteSpace value="preserve"/>');
        rejected("decimal", '<xs:whiteSpace value="replace"/>');
        rejected("integer", '<xs:fractionDigits value="1"/>');
        accepted("integer", '<xs:fractionDigits value="0"/>', "9");
        accepted("decimal", '<xs:whiteSpace value="collapse" fixed="false"/>', " 1.23 ");
    }

    private bounds() {
        foreach string facets in ('<xs:minInclusive value="1"/><xs:minExclusive value="1"/>',
                '<xs:maxInclusive value="1"/><xs:maxExclusive value="1"/>',
                '<xs:minInclusive value="2"/><xs:maxInclusive value="1"/>',
                '<xs:minInclusive value="1"/><xs:maxExclusive value="1"/>',
                '<xs:minExclusive value="1"/><xs:maxInclusive value="1"/>',
                '<xs:minExclusive value="1.00000000000000000002"/><xs:maxExclusive value="1.00000000000000000001"/>') {
            rejected("decimal", facets);
        }
        accepted("decimal", '<xs:minInclusive value="+001.2300"/><xs:maxInclusive value="1.23"/>', "1.23");
        accepted("decimal", '<xs:minExclusive value="1"/>', "2", '<xs:minExclusive value="1"/>');
        accepted("decimal", '<xs:maxExclusive value="1"/>', "0", '<xs:maxExclusive value="1"/>');
        accepted("decimal", '<xs:minExclusive value="1"/>', "2",
            '<xs:minExclusive value="1"/><xs:enumeration value="2"/>');
        accepted("decimal", '<xs:minExclusive value="1.234"/>', "2",
            '<xs:minExclusive value="1.234"/><xs:fractionDigits value="0"/>');
        rejected("decimal", '<xs:minExclusive value="1"/>',
            '<xs:minExclusive value="1"/><xs:pattern value="0[0-9]"/>');
        accepted("decimal", '<xs:minExclusive value="01"/>', "02",
            '<xs:minExclusive value="1"/><xs:pattern value="0[0-9]"/>');
        # XSD 1.0 permits equal exclusive endpoints, even though the value space is empty.
        XsdSchema empty = schema("decimal", '<xs:minExclusive value="1"/><xs:maxExclusive value="1"/>');
        XsdSimpleType type = cast<XsdSimpleType>(empty.findType(make_qname("urn:facet-declarations", "Amount")));
        assertThrows("XSD-SAMPLE-ERROR", \type.getSampleValue(), "1");
    }

    private derived() {
        rejected("decimal", '<xs:totalDigits value="5"/>', '<xs:totalDigits value="4"/>');
        rejected("decimal", '<xs:fractionDigits value="3"/>', '<xs:fractionDigits value="2"/>');
        rejected("decimal", '<xs:totalDigits value="2"/><xs:fractionDigits value="3"/>');
        rejected("decimal", '<xs:totalDigits value="2"/>', '<xs:fractionDigits value="4"/>');
        rejected("decimal", '<xs:minInclusive value="0"/>', '<xs:minInclusive value="1"/>');
        rejected("decimal", '<xs:maxInclusive value="2"/>', '<xs:maxExclusive value="2"/>');
        rejected("decimal", '<xs:minInclusive value="2"/>', '<xs:minInclusive value="1" fixed="true"/>');
        rejected("decimal", '<xs:totalDigits value="2"/>', '<xs:totalDigits value="3" fixed="1"/>');
        accepted("decimal", '<xs:minInclusive value="1" fixed="false"/>', "1",
            '<xs:minInclusive value="+01.00" fixed="true"/>');
    }

    private baseValues() {
        rejected("byte", '<xs:minInclusive value="128"/>');
        rejected("decimal", '<xs:minInclusive value="NaN"/>');
        rejected("decimal", '<xs:enumeration value="1e2"/>');
        rejected("decimal", '<xs:minInclusive value="123"/>', '<xs:totalDigits value="2"/>');
        rejected("integer", '<xs:enumeration value="+0009"/>', '<xs:pattern value="00[0-9]"/>');
        rejected("integer", '<xs:minInclusive value="9"/>', '<xs:pattern value="00[0-9]"/>');
        rejected("integer", '<xs:enumeration value="2"/>', '<xs:enumeration value="1"/>');
        accepted("integer", '<xs:enumeration value="009"/>', "009", '<xs:pattern value="00[0-9]"/>');
        accepted("integer", '<xs:pattern value="00[0-9]"/><xs:enumeration value="+0009"/>', "009");
    }

    private largeCounts() {
        string huge = "9223372036854775808";
        accepted("decimal", '<xs:totalDigits value="' + huge + '"/><xs:fractionDigits value="' + huge + '"/>',
            "1.00000000000000000001");
        accepted("decimal", '<xs:totalDigits value="' + huge + '"/>', "1.23",
            '<xs:totalDigits value="9223372036854775809"/>');
        rejected("decimal", '<xs:totalDigits value="9223372036854775809"/>',
            '<xs:totalDigits value="' + huge + '"/>');
        XsdSchema original = schema("decimal", '<xs:totalDigits value=" +0' + huge + ' "/>
            <xs:fractionDigits value="' + huge + '"/>');
        foreach XsdSchema copy in (original, Serializable::deserialize(original.serialize())) {
            XsdSimpleType type = cast<XsdSimpleType>(copy.findType(make_qname("urn:facet-declarations", "Amount")));
            assertEq(huge, type.totalDigits);
            assertEq(huge, type.fractionDigits);
            auto sample = type.getSampleValue("1.23");
            assertEq(type.deserializeValue("amount", copy.getTypeMap(), NOTHING, sample),
                type.getDataProviderType().acceptsValue(sample));
        }
    }

    private namespaces() {
        foreach string prefix in ("", "x:") {
            string source = '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:x="urn:other">
                <xs:simpleType name="Amount"><' + prefix + 'restriction base="xs:decimal">
                <xs:minInclusive value="1"/></' + prefix + 'restriction></xs:simpleType></xs:schema>';
            assertThrows("XSD-SIMPLETYPE-ERROR", sub() { XsdSchema invalid(source); });
        }
        rejected("decimal", '<minInclusive value="1"/>');
        rejected("decimal", '<x:minInclusive xmlns:x="urn:other" value="1"/>');
        rejected("decimal", '<xs:minInclusive xmlns:xs="urn:other" value="1"/>');
        rejected("decimal", '<xs:minInclusive value="1" xs:extra="x"/>');
        rejected("decimal", '<xs:minInclusive value="1" xs:fixed="true"/>');
        rejected("decimal", '<xs:minInclusive xs:value="1"/>');
        rejected("decimal", '<xs:pattern value="[0-9]+" fixed="false"/>');
        rejected("decimal", '<xs:enumeration value="1" fixed="false"/>');
        accepted("decimal", '<minInclusive xmlns="http://www.w3.org/2001/XMLSchema" value="1"/>', "2");
        accepted("decimal", '<s:minInclusive xmlns:s="http://www.w3.org/2001/XMLSchema" value="1"/>', "2");
        accepted("decimal", '<xs:minInclusive xmlns:meta="urn:metadata" meta:fixed="note" value="1"/>', "2");
        accepted("decimal", '<xs:whiteSpace value="  collapse &#x9;"/>', " 1.23 ");
    }

    private grammar() {
        rejected("decimal", '<xs:minInclusive value="1">text</xs:minInclusive>');
        rejected("decimal", '<xs:minInclusive value="1"><![CDATA[text]]></xs:minInclusive>');
        rejected("decimal", '<xs:minInclusive value="1"><annotation/></xs:minInclusive>');
        rejected("decimal", '<xs:minInclusive value="1"><xs:annotation/><xs:annotation/></xs:minInclusive>');
        rejected("decimal", '<xs:minInclusive value="1"><xs:pattern value=".*"/></xs:minInclusive>');
        rejected("decimal", '<xs:minInclusive value="1"/><xs:annotation/>');
        rejected("decimal", '<xs:annotation/><xs:annotation/><xs:minInclusive value="1"/>');
        rejected("decimal", 'text<xs:minInclusive value="1"/>');
        accepted("decimal", '<xs:annotation/><xs:minInclusive value="1">
            <!-- note -->
            <xs:annotation><xs:documentation>Minimum invoice amount</xs:documentation>
            <xs:appinfo><xs:simpleType><xs:restriction><foreign/></xs:restriction></xs:simpleType></xs:appinfo>
            </xs:annotation> </xs:minInclusive>', "2");
    }

    private inheritedBounds() {
        rejected("decimal", '<xs:maxExclusive value="1"/>', '<xs:minInclusive value="1"/>');
        rejected("decimal", '<xs:minExclusive value="1"/>', '<xs:maxInclusive value="1"/>');
        rejected("byte", '<xs:minExclusive value="127"/>');
        rejected("byte", '<xs:maxExclusive value="-128"/>');
    }

    private rollback() {
        XsdSchema original = schema("decimal", '<xs:minInclusive value="1" fixed="true"/>');
        string addition = '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:facet-declarations"
            targetNamespace="urn:facet-declarations"><xs:simpleType name="Derived"><xs:restriction base="t:Amount">
            <xs:minInclusive value="2"/></xs:restriction></xs:simpleType></xs:schema>';
        assertThrows("XSD-SIMPLETYPE-ERROR", \original.addSchemaString(), addition);
        string valid = addition;
        valid =~ s/value="2"/value="+01.00"/;
        original.addSchemaString(valid);
        foreach XsdSchema copy in (original, Serializable::deserialize(original.serialize())) {
            XsdSimpleType type = cast<XsdSimpleType>(copy.findType(make_qname("urn:facet-declarations", "Derived")));
            AbstractDataProviderType provider = type.getDataProviderType();
            assertEq(1.0, provider.acceptsValue("1"));
            assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), "0");
            string grandchild = addition;
            grandchild =~ s/name="Derived"/name="Grandchild"/;
            grandchild =~ s/base="t:Amount"/base="t:Derived"/;
            assertThrows("XSD-SIMPLETYPE-ERROR", \copy.addSchemaString(), grandchild);
            grandchild =~ s/value="2"/value="1"/;
            copy.addSchemaString(grandchild);
            assertEq(1.0, copy.findType(make_qname("urn:facet-declarations", "Grandchild"))
                .getDataProviderType().acceptsValue("1"));
        }
    }
}
