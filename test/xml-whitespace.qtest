#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%exec-class XmlWhitespaceTest

class XmlWhitespaceTest inherits QUnit::Test {
    constructor() : QUnit::Test("XML character whitespace", "1.0") {
        addTestCase("Text values survive XML line-ending normalization and encodings", \textValues());
        addTestCase("CDATA carriage returns preserve character content", \cdataValues());
        addTestCase("Scalar whitespace and comments retain their positions", \scalarContent());
        addTestCase("Indentation does not change repeated-child grouping", \elementContent());
        addTestCase("Mixed content retains whitespace before and after children", \mixedContent());
        addTestCase("Inherited xml:space preserves formatting with a local default reset", \spaceAttribute());
        addTestCase("Rejected inputs and interruption leave subsequent calls usable", \failures());
        set_return_value(main());
    }

    private static string text(auto value) {
        if (value.typeCode() != NT_HASH) {
            return string(value);
        }
        string result = "";
        foreach string key in (keys value) {
            if (key =~ /^\^(value|cdata)/) {
                result += string(value{key});
            }
        }
        return result;
    }

    textValues() {
        foreach string value in ("\r", "\r\n", " \t\r\n ", "before\rčeský & <middle>\nafter\t", "\n\t ") {
            foreach int flags in (0, XGF_USE_NUMERIC_REFS, XGF_ADD_FORMATTING) {
                foreach string encoding in ("UTF-8", "ISO-8859-2", "UTF-16LE", "UTF-16BE") {
                    foreach string source in ("UTF-8", "ISO-8859-2", "UTF-16LE") {
                        string xml = make_xml({"root": convert_encoding(value, source)}, flags, encoding);
                        assertEq(value, text(parse_xml(xml).root));
                        XmlDoc doc(xml);
                        assertEq(value, doc.getRootElement().getContent());
                        assertEq(value, text(doc.toQore().root));
                        if (index(value, "\r") >= 0) {
                            assertTrue(index(xml, "&#13;") >= 0);
                        }
                    }
                }
            }
        }
        assertEq("\n\n", text(parse_xml("<root>\r\n\r</root>").root));
        assertEq("\r\r\n", text(parse_xml("<root>&#13;&#13;&#10;</root>").root));
        assertNothing(parse_xml(make_xml({"root": ""})).root);
    }

    cdataValues() {
        foreach string value in ("\r", "\r\r\n", " \t\r\n ", "český\r<raw>& text\n") {
            foreach string encoding in ("UTF-8", "ISO-8859-2", "UTF-16LE", "UTF-16BE") {
                foreach string source in ("UTF-8", "ISO-8859-2", "UTF-16LE") {
                    string xml = make_xml("root", {"^cdata^": convert_encoding(value, source)}, XGF_ADD_FORMATTING, encoding);
                    assertEq(value, text(parse_xml(xml, XPF_PRESERVE_ORDER).root));
                    XmlDoc doc(xml);
                    assertEq(value, doc.getRootElement().getContent());
                    assertTrue(index(xml, "]]>&#13;<![CDATA[") >= 0);
                }
            }
        }
    }

    scalarContent() {
        assertEq(" \t\n ", parse_xml("<root> \t\n </root>").root);
        hash<auto> expected = {"^attributes^": {"id": "1"}, "^value^": " ", "^comment^": "keep",
            "^value1^": "\t", "^cdata^": "\n", "^value2^": "\r"};
        string xml = '<root id="1"> <!--keep-->&#9;<![CDATA[' + "\n" + ']]>&#13;</root>';
        foreach int flags in (XPF_ADD_COMMENTS, XPF_ADD_COMMENTS | XPF_PRESERVE_ORDER) {
            assertEq(expected, parse_xml(xml, flags).root);
            assertEq(expected, parse_xml(make_xml("root", expected), flags).root);
        }
        assertEq(" \t\n\r", text(parse_xml(xml).root));
        assertEq(" ", parse_xml("<root><empty/> <leaf> </leaf></root>").root.leaf);
    }

    elementContent() {
        hash<auto> expected = {"a": ("1", "2"), "b": "3", "a^1": ("4", "5"), "c": {"x": ("6", "7")}};
        string xml = "<root>\n<a>1</a>\n<a>2</a>\n<b>3</b>\n<a>4</a>\n<a>5</a>\n"
            "<c>\n<x>6</x>\n<x>7</x>\n</c>\n</root>";
        assertEq(expected, parse_xml(xml, XPF_PRESERVE_ORDER).root);
        assertEq(expected, parse_xml(make_xml("root", expected, XGF_ADD_FORMATTING), XPF_PRESERVE_ORDER).root);
        assertEq({"a": ("1", "2", "4", "5"), "b": "3", "c": {"x": ("6", "7")}}, parse_xml(xml).root);
        string many = "<root>";
        foreach int i in (0 .. 999) {
            many += sprintf("\n<a>%d</a>\n<a>%d</a>\n<b/>", i, i);
        }
        many += "\n</root>";
        hash<auto> grouped = parse_xml(many, XPF_PRESERVE_ORDER).root;
        assertEq(2000, grouped.size());
        foreach int i in (0 .. 999) {
            string key = i ? sprintf("a^%d", i) : "a";
            assertEq((string(i), string(i)), grouped{key});
        }
        assertEq({"a": "1", "^comment^": "break", "a^1": "2"},
            parse_xml("<root>\n<a>1</a>\n<!--break-->\n<a>2</a>\n</root>",
                XPF_PRESERVE_ORDER | XPF_ADD_COMMENTS).root);
    }

    mixedContent() {
        hash<auto> expected = {"^value^": " ", "a": "1", "^value1^": "\t", "a^1": "2",
            "^value2^": "after", "b": NOTHING, "^value3^": "\n"};
        string xml = "<root> <a>1</a>\t<a>2</a>after<b/>\n</root>";
        assertEq(expected, parse_xml(xml, XPF_PRESERVE_ORDER).root);
        assertEq(expected, parse_xml(make_xml("root", expected), XPF_PRESERVE_ORDER).root);
        assertEq({"^value^": " ", "a": NOTHING, "^cdata^": "", "^value1^": " "},
            parse_xml("<root> <a/><![CDATA[]]> </root>", XPF_PRESERVE_ORDER).root);
    }

    spaceAttribute() {
        string xml = '<root xml:space="preserve"> <inner> <a/> <a/> </inner>'
            '<default xml:space="default"> <b/> <b/> </default> </root>';
        hash<auto> parsed = parse_xml(xml, XPF_PRESERVE_ORDER).root;
        assertEq(" ", parsed."^value^");
        assertEq(" ", parsed."^value1^");
        assertEq({"^value^": " ", "a": NOTHING, "^value1^": " ", "a^1": NOTHING, "^value2^": " "}, parsed.inner);
        assertEq({"^attributes^": {"xml:space": "default"}, "b": (NOTHING, NOTHING)}, parsed.default);
        assertEq(parsed, parse_xml(make_xml("root", parsed, XGF_ADD_FORMATTING), XPF_PRESERVE_ORDER).root);
        hash<auto> preserved = {"^attributes^": {"xml:space": "preserve"}, "a": (NOTHING, NOTHING)};
        assertEq(preserved, parse_xml(make_xml("root", preserved, XGF_ADD_FORMATTING), XPF_PRESERVE_ORDER).root);
        XmlReader reader('<root xml:space="preserve"><inner> <a/> <a/> </inner></root>');
        assertTrue(reader.read());
        assertEq(parsed.inner, reader.toQore().inner);
    }

    failures() {
        assertThrows("MAKE-XML-ERROR", \make_xml(), ("root", {"^cdata^": "before]]>after"}));
        assertThrows("MAKE-XML-ERROR", \make_xml(), ("root", {"^value^": <00>}));
        assertThrows("PARSE-XML-EXCEPTION", \parse_xml(), "<root> <a/> <b>\n</root>");
        SandboxManager manager();
        on_exit manager.clearInterrupt();
        Program program(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
        program.setSandboxManager(manager);
        program.parse("%modern\n%requires xml\n"
            "auto sub interrupted(SandboxManager manager, string kind) {\n"
            "    manager.requestInterrupt();\n"
            "    if (kind == \"parse\") { return parse_xml(\"<root> <a/> </root>\"); }\n"
            "    return make_xml(\"root\", kind == \"text\" ? {\"^value^\": \"before\\rafter\"} : {\"^cdata^\": \"before\\rafter\"});\n"
            "}\n", "xml_whitespace_cancel");
        foreach string kind in ("parse", "text", "cdata") {
            *hash<ExceptionInfo> error;
            try {
                program.callFunction("interrupted", manager, kind);
            } catch (hash<ExceptionInfo> ex) {
                error = ex;
            }
            manager.clearInterrupt();
            assertEq("PROGRAM-INTERRUPTED", error.err);
            assertEq("\r", text(parse_xml(make_xml({"root": "\r"})).root));
        }
    }
}
