#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires WSDL
%exec-class XmlDecodingTest

class XmlDecodingTest inherits QUnit::Test {
    constructor() : Test("WSDL XML root decoding", "1.0") {
        addTestCase("XML root decoding validates UTF-8 bytes", \rootEncoding());
        set_return_value(main());
    }

    private rootEncoding() {
        foreach binary bytes in (<ff>, <6100ff>, <e282>, <c080>, <eda080>, <f4908080>, <efbbbfff>) {
            foreach string ct in ("text/xml", "text/xml;charset=UTF-8") {
                assertThrows("ENCODING-CONVERSION-ERROR", \WSDLLib::getXmlMessageText(),
                    ({"body": bytes, "content-type": ct},));
            }
        }
        assertEq("", WSDLLib::getXmlMessageText({"body": binary(), "content-type": "text/xml"}));
        assertEq("é😀", WSDLLib::getXmlMessageText({"body": <efbbbfc3a9f09f9880>, "content-type": "text/xml"}));
        assertEq("ÿ", WSDLLib::getXmlMessageText({"body": <ff>, "content-type": "text/xml;charset=ISO-8859-1"}));
    }
}
