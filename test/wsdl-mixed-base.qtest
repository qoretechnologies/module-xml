#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class MixedBaseTest

class MixedBaseTest inherits QUnit::Test {
    constructor() : QUnit::Test("WSDL mixed emptiable simple-content bases", "1.0") {
        addTestCase("Named mixed bases permit scalar restrictions when emptiable", \allowed());
        addTestCase("Required particles and element-only bases reject scalar restriction", \rejected());
        addTestCase("Nested group and extension metadata retains emptiability", \groups());
        addTestCase("Derived scalar attributes providers and reconstruction agree", \consumers());
        addTestCase("Invalid group graphs and mixed declarations restore state", \recovery());
        addTestCase("Reused empty group graphs resolve without expanding every path", \sharedGraph());
        set_return_value(main());
    }

    private string schema(string content) {
        return '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:mixed"
            targetNamespace="urn:mixed">' + content + '</xs:schema>';
    }

    private string derived(string base = "t:Base", string attrs = "") {
        return '<xs:complexType name="Value"><xs:simpleContent><xs:restriction base="' + base + '">
            <xs:simpleType><xs:restriction base="xs:int"/></xs:simpleType><xs:minInclusive value="0"/>'
            + attrs + '</xs:restriction></xs:simpleContent></xs:complexType>';
    }

    private XsdSchema parse(string content) {
        return new XsdSchema(schema(content), {"async_only": True});
    }

    private XsdComplexType type(XsdSchema s) {
        return cast<XsdComplexType>(s.getTypeMap(){make_qname("urn:mixed", "Value")});
    }

    private string base(string content, string mixed = "true") {
        return '<xs:complexType name="Base" mixed="' + mixed + '">' + content + '</xs:complexType>';
    }

    allowed() {
        foreach string content in ("", '<xs:sequence/>', '<xs:choice/>', '<xs:all/>',
                '<xs:sequence><xs:element name="child" type="xs:string" minOccurs="0"/></xs:sequence>',
                '<xs:choice><xs:element name="a" type="xs:string"/><xs:element name="b" type="xs:int"
                    minOccurs="0"/></xs:choice>',
                '<xs:sequence minOccurs="0"><xs:element name="child" type="xs:string"/></xs:sequence>',
                '<xs:sequence><xs:any minOccurs="0" processContents="lax"/></xs:sequence>',
                '<xs:sequence><xs:sequence><xs:choice><xs:sequence/></xs:choice></xs:sequence></xs:sequence>') {
            XsdSchema s = parse(base(content) + derived());
            assertEq(0, type(s).deserializeValue("value", s.getTypeMap(), NOTHING, "0"));
            assertEq(0, type(s).serializeValue(s.nsc, 0, True)."^value^");
            assertThrows("SOAP-DESERIALIZATION-ERROR", \type(s).deserializeValue(),
                ("value", s.getTypeMap(), NOTHING, "-1"));
        }
    }

    rejected() {
        foreach string content in ('<xs:sequence><xs:element name="a" type="xs:string"/></xs:sequence>',
                '<xs:choice><xs:element name="a" type="xs:string"/><xs:element name="b" type="xs:int"/></xs:choice>',
                '<xs:sequence><xs:element name="a" type="xs:string" minOccurs="0"/>
                    <xs:element name="b" type="xs:int"/></xs:sequence>',
                '<xs:sequence><xs:any processContents="lax"/></xs:sequence>') {
            assertThrows("WSDL-ERROR", \parse(), (base(content) + derived(),));
        }
        assertThrows("WSDL-ERROR", \parse(), (base('<xs:sequence/>', "false") + derived(),));
        assertThrows("WSDL-ERROR", \parse(), (base('<xs:sequence/>')
            + '<xs:complexType name="Value"><xs:simpleContent><xs:restriction base="t:Base"/>
            </xs:simpleContent></xs:complexType>',));
        assertThrows("WSDL-ERROR", \parse(), (base('<xs:sequence/>')
            + '<xs:complexType name="Value"><xs:simpleContent><xs:extension base="t:Base"/>
            </xs:simpleContent></xs:complexType>',));
    }

    groups() {
        string defs = '<xs:group name="Optional"><xs:choice><xs:sequence><xs:element name="a" type="xs:int"
                minOccurs="0"/></xs:sequence><xs:element name="b" type="xs:int"/></xs:choice></xs:group>
            <xs:group name="Required"><xs:sequence><xs:element name="c" type="xs:int"/></xs:sequence></xs:group>';
        foreach string content in ('<xs:group xmlns:g="urn:mixed" ref="g:Optional"/>',
                '<xs:group ref="t:Required" minOccurs="0"/>',
                '<xs:sequence><xs:choice><xs:group ref="t:Optional"/><xs:group ref="t:Required"/>
                    </xs:choice></xs:sequence>') {
            XsdSchema s = parse(defs + base(content) + derived());
            assertEq(0, type(s).deserializeValue("value", s.getTypeMap(), NOTHING, "0"));
        }
        assertThrows("WSDL-ERROR", \parse(), (defs + base('<xs:group ref="t:Required"/>') + derived(),));
        string intermediate = '<xs:complexType name="Base"><xs:complexContent mixed="true">
            <xs:extension base="t:Ancestor"><xs:sequence><xs:element name="b" type="xs:int" minOccurs="0"/>
            </xs:sequence></xs:extension></xs:complexContent></xs:complexType>';
        XsdSchema s = parse('<xs:complexType name="Ancestor" mixed="true"><xs:sequence><xs:element name="a"
            type="xs:int" minOccurs="0"/></xs:sequence></xs:complexType>' + intermediate + derived());
        assertEq(0, type(s).deserializeValue("value", s.getTypeMap(), NOTHING, "0"));
        assertThrows("WSDL-ERROR", \parse(), ('<xs:complexType name="Ancestor" mixed="true"><xs:sequence>
            <xs:element name="a" type="xs:int"/></xs:sequence></xs:complexType>' + intermediate + derived(),));
        foreach string own in ("", '<xs:sequence/>') {
            XsdSchema empty_extension = parse('<xs:complexType name="Ancestor" mixed="true"><xs:sequence>
                <xs:element name="a" type="xs:int" minOccurs="0"/></xs:sequence></xs:complexType>
                <xs:complexType name="Base"><xs:complexContent><xs:extension base="t:Ancestor">' + own
                + '</xs:extension></xs:complexContent></xs:complexType>' + derived());
            assertEq(0, type(empty_extension).deserializeValue("v", empty_extension.getTypeMap(), NOTHING, "0"));
        }
        XsdSchema ur = parse('<xs:complexType name="Base"><xs:complexContent><xs:extension base="xs:anyType"/>
            </xs:complexContent></xs:complexType>' + derived());
        assertEq(0, type(ur).deserializeValue("v", ur.getTypeMap(), NOTHING, "0"));
    }

    consumers() {
        XsdSchema s = parse(base('<xs:sequence/><xs:attribute name="unit" type="xs:string" use="required"/>')
            + derived("t:Base", '<xs:attribute name="unit" type="xs:string" use="required" fixed="kg"/>'));
        foreach XsdSchema schema in (s, Serializable::deserialize(s.serialize())) {
            hash<auto> value = type(schema).deserializeValue("v", schema.getTypeMap(), NOTHING,
                {"^value^": "0", "^attributes^": {"unit": "kg"}});
            assertEq(0, value."^value^");
            assertEq("kg", value."^attributes^".unit);
            assertEq(value, type(schema).getDataProviderType().acceptsValue(value));
            assertThrows("SOAP-DESERIALIZATION-ERROR", \type(schema).deserializeValue(),
                ("v", schema.getTypeMap(), NOTHING, "0"));
        }
    }

    recovery() {
        foreach string bad in ('<xs:group name="A"><xs:sequence><xs:choice><xs:group ref="t:A"/>
                </xs:choice></xs:sequence></xs:group>',
                '<xs:group name="A"><xs:sequence><xs:choice><xs:group ref="t:Missing" minOccurs="0"/>
                </xs:choice></xs:sequence></xs:group>') {
            assertThrows("WSDL-ERROR", \parse(), (bad,));
        }
        foreach string bad in ("yes", "", "2") {
            assertThrows("WSDL-ERROR", \parse(), (base('<xs:sequence/>', bad) + derived(),));
        }
        XsdSchema s = parse('<xs:element name="existing" type="xs:string"/>');
        assertThrows("WSDL-ERROR", \s.addSchemaString(),
            (schema(base('<xs:sequence><xs:element name="a" type="xs:int"/></xs:sequence>') + derived()),));
        s.addSchemaString(schema(base('<xs:sequence/>', "1") + derived()));
        assertEq(0, type(s).deserializeValue("v", s.getTypeMap(), NOTHING, "0"));
        assertEq("string", s.getElement("urn:mixed", "existing").type.name);
    }

    sharedGraph() {
        string defs = '<xs:group name="G0"><xs:sequence/></xs:group>';
        for (int i = 1; i <= 32; ++i) {
            defs += sprintf('<xs:group name="G%d"><xs:choice><xs:group ref="t:G%d"/>
                <xs:group ref="t:G%d"/></xs:choice></xs:group>', i, i - 1, i - 1);
        }
        XsdSchema s = parse(defs + base('<xs:group ref="t:G32"/>') + derived());
        assertEq(0, type(s).deserializeValue("v", s.getTypeMap(), NOTHING, "0"));
        XsdSchema restored = Serializable::deserialize(s.serialize());
        assertEq(0, type(restored).deserializeValue("v", restored.getTypeMap(), NOTHING, "0"));
    }
}
