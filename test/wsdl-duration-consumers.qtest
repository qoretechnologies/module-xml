#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%requires ../qlib/SoapClient.qm
%requires ../qlib/SoapHandler.qm
%requires HttpServer
%exec-class DurationConsumersTest

class DurationConsumerCallback {
    public {
        Queue requests();
        Queue responses();
    }

    hash<auto> call(hash<auto> cx, hash<auto> request) {
        requests.push(request);
        return responses.pop(30000);
    }
}

class DurationConsumersTest inherits QUnit::Test {
    constructor() : Test("Duration SOAP consumers", "1.0") {
        addTestCase("Actual SOAP bindings retain durations over local HTTP", \httpValues());
        set_return_value(main());
    }

    private WebService service(string version) {
        return new WebService('<w:definitions xmlns:w="http://schemas.xmlsoap.org/wsdl/"
            xmlns:t="urn:duration-consumers" xmlns:s="http://schemas.xmlsoap.org/wsdl/soap'
            + (version == "12" ? "12" : "") + '/" targetNamespace="urn:duration-consumers"><w:types>
            <xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:duration-consumers">
            <xs:simpleType name="Durations"><xs:list itemType="xs:duration"/></xs:simpleType>
            <xs:simpleType name="Either"><xs:union memberTypes="xs:duration xs:string"/></xs:simpleType>
            <xs:simpleType name="Bounded"><xs:restriction base="xs:duration">
            <xs:minExclusive value="PT1.00000000000000001S"/><xs:maxExclusive value="PT1.00000000000000003S"/>
            </xs:restriction></xs:simpleType><xs:simpleType name="Cycle"><xs:restriction base="xs:duration">
            <xs:enumeration value="P400Y"/></xs:restriction></xs:simpleType>
            <xs:simpleType name="Selected"><xs:restriction base="t:Durations">
            <xs:enumeration value="P400Y PT0.000000000000000001S"/></xs:restriction></xs:simpleType>
            <xs:simpleType name="UnionCycle"><xs:restriction base="t:Either"><xs:enumeration value="P400Y"/>
            </xs:restriction></xs:simpleType><xs:complexType name="Record"><xs:sequence>
            <xs:element name="span" type="xs:duration"/><xs:element name="fraction" type="xs:duration"/>
            <xs:element name="huge" type="xs:duration"/><xs:element name="durations" type="t:Durations"/>
            <xs:element name="either" type="t:Either"/><xs:element name="bounded" type="t:Bounded"/>
            <xs:element name="cycle" type="t:Cycle"/><xs:element name="selected" type="t:Selected"/>
            <xs:element name="unionCycle" type="t:UnionCycle"/>
            </xs:sequence><xs:attribute name="timeout" type="xs:duration" use="required"/>
            <xs:attribute name="fixedCycle" type="xs:duration" fixed="P400Y"/>
            </xs:complexType><xs:element name="Submit" type="t:Record"/><xs:element name="Reply" type="t:Record"/>
            </xs:schema></w:types><w:message name="In"><w:part name="body" element="t:Submit"/></w:message>
            <w:message name="Out"><w:part name="body" element="t:Reply"/></w:message>
            <w:portType name="Port"><w:operation name="submit"><w:input message="t:In"/>
            <w:output message="t:Out"/></w:operation></w:portType><w:binding name="Soap" type="t:Port">
            <s:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
            <w:operation name="submit"><s:operation soapAction="urn:submit"/><w:input><s:body use="literal"/>
            </w:input><w:output><s:body use="literal"/></w:output></w:operation></w:binding>
            <w:service name="Service"><w:port name="Port" binding="t:Soap"><s:address location="http://example.invalid/"/>
            </w:port></w:service></w:definitions>', {"async_only": True});
    }

    private hash<auto> record(bool response) {
        return {"span": response ? microseconds(1) : days(-1) + hours(1),
            "fraction": "PT0." + strmul("0", 1000) + (response ? "2S" : "1S"),
            "huge": (response ? "-P" : "P") + strmul("9", 1000) + "D",
            "durations": (days(-1), microseconds(1), "PT1.00000000000000001S"),
            "either": response ? "label" : microseconds(1),
            "bounded": response ? "PT1.000000000000000025S" : "PT1.00000000000000002S",
            "cycle": response ? "P4800M" : "P146097D",
            "selected": (response ? "P4800M" : "P146097D", "PT0.0000000000000000010S"),
            "unionCycle": response ? "P146097D" : "P4800M",
            "^attributes^": {"timeout": response ? minutes(-1) : minutes(1),
                "fixedCycle": response ? "P4800M" : "P146097D"}};
    }

    private check(hash<auto> actual, bool response) {
        hash<auto> expected = {"span": response ? "PT0.000001S" : "-PT23H",
            "fraction": "PT0." + strmul("0", 1000) + (response ? "2S" : "1S"),
            "huge": (response ? "-P" : "P") + strmul("9", 1000) + "D",
            "durations": ("-P1D", "PT0.000001S", "PT1.00000000000000001S"),
            "either": response ? "label" : "PT0.000001S",
            "bounded": response ? "PT1.000000000000000025S" : "PT1.00000000000000002S",
            "cycle": response ? "P4800M" : "P146097D",
            "selected": (response ? "P4800M" : "P146097D", "PT0.0000000000000000010S"),
            "unionCycle": response ? "P146097D" : "P4800M",
            "^attributes^": {"timeout": response ? "-PT1M" : "PT1M",
                "fixedCycle": response ? "P4800M" : "P146097D"}};
        assertEq(expected, actual);
    }

    private httpValues() {
        foreach string version in ("11", "12") {
            WebService original = service(version);
            foreach WebService ws in (original, Serializable::deserialize(original.serialize())) {
                HttpServer server();
                on_exit server.stop();
                SoapHandler handler(new PermissiveAuthenticator());
                server.setDefaultHandler("soap", handler);
                DurationConsumerCallback callback();
                handler.addMethod(ws, ws.getBindingOperation("Soap", "submit"), \callback.call(), NOTHING,
                    NOTHING, NOTHING, "Service", NOTHING, NOTHING, "Soap");
                server.addListener(0);
                string url = sprintf("http://127.0.0.1:%d/Service", server.getListenerInfo(0).port);
                SoapClient client({"wsdl": ws, "url": url, "timeout": 30000, "connect_timeout": 30000});
                callback.responses.push(record(True));
                check(client.callOperation("submit", record(False)), True);
                check(callback.requests.pop(30000), False);
                hash<auto> invalid = record(False);
                invalid.span = "P1DT";
                assertThrows("SOAP-SERIALIZATION-ERROR", \client.callOperation(), ("submit", invalid));
                invalid = record(False);
                invalid.bounded = "PT1.00000000000000003S";
                assertThrows("SOAP-SERIALIZATION-ERROR", \client.callOperation(), ("submit", invalid));
                invalid = record(False);
                invalid."^attributes^".fixedCycle = "P146098D";
                assertThrows("SOAP-SERIALIZATION-ERROR", \client.callOperation(), ("submit", invalid));
                callback.responses.push(record(True));
                check(client.callOperation("submit", record(False)), True);
                check(callback.requests.pop(30000), False);
            }
        }
    }
}
