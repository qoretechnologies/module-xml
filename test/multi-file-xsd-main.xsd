<?xml version="1.0" encoding="UTF-8"?>
<!--
    Test fixture for XmlDoc::validateSchemaFile().
    Imports multi-file-xsd-shared.xsd via a relative schemaLocation so that the
    test exercises libxml2's file-based import resolution.
-->
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:shared="http://qoretechnologies.com/test/shared"
    targetNamespace="http://qoretechnologies.com/test/main"
    elementFormDefault="qualified">

    <xsd:import namespace="http://qoretechnologies.com/test/shared"
                schemaLocation="multi-file-xsd-shared.xsd"/>

    <xsd:element name="Order">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="Id" type="shared:Id"/>
                <xsd:element name="Qty" type="xsd:positiveInteger"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>
</xsd:schema>
