#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm

%exec-class RpcAccessorsTest

# RPC part accessors in received messages: the accessor of a type part in a literal message has no namespace (WS-I
# Basic Profile R2735), while an element part's accessor is its element and SOAP encodings leave the qualification of
# accessors open (SOAP 1.1 section 7.1; the SOAP 1.2 Primer qualifies them); an omitted accessor is an absent value in
# every message (SOAP 1.1 section 5.1, SOAP 1.2 Part 2 section 3.1.3, and for literal messages decided 2026-09-25),
# and an empty accessor is an empty value.
public class RpcAccessorsTest inherits QUnit::Test {
    private {
        const Envelope = {"11": "http://schemas.xmlsoap.org/soap/envelope/", "12": "http://www.w3.org/2003/05/soap-envelope"};
        const Encoding = {"11": "http://schemas.xmlsoap.org/soap/encoding/", "12": "http://www.w3.org/2003/05/soap-encoding"};
        const Binding = {"11": "http://schemas.xmlsoap.org/wsdl/soap/", "12": "http://schemas.xmlsoap.org/wsdl/soap12/"};
    }

    constructor() : Test("RpcAccessorsTest", "1.0") {
        addTestCase("an omitted literal accessor is an absent value", \missingLiteral());
        addTestCase("literal accessors have no namespace", \qualifiedLiteral());
        addTestCase("a literal element part's accessor is its element", \elementPart());
        addTestCase("SOAP 1.2 encoded accessors may be qualified", \qualifiedEncoded12());
        addTestCase("SOAP 1.1 encoded accessors may be qualified", \qualifiedEncoded11());
        addTestCase("an omitted encoded accessor is a missing value", \omittedEncoded());
        set_return_value(main());
    }

    static string wsdl(string version, string use) {
        string body = sprintf('use="%s" namespace="urn:rpc"%s', use,
            use == "encoded" ? sprintf(' encodingStyle="%s"', Encoding{version}) : "");
        return sprintf('<definitions xmlns="http://schemas.xmlsoap.org/wsdl/" xmlns:soap="%s"
            xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:t" targetNamespace="urn:t">
          <message name="In"><part name="name" type="xsd:string"/><part name="count" type="xsd:int"/></message>
          <message name="Out"><part name="result" type="xsd:string"/></message>
          <portType name="P"><operation name="submit"><input message="t:In"/><output message="t:Out"/></operation>
          </portType>
          <binding name="B" type="t:P"><soap:binding style="rpc" transport="http://schemas.xmlsoap.org/soap/http"/>
            <operation name="submit"><soap:operation soapAction="urn:submit"/><input><soap:body %s/></input>
            <output><soap:body %s/></output></operation></binding>
          <service name="S"><port name="p" binding="t:B"><soap:address location="http://localhost/rpc"/></port>
          </service></definitions>', Binding{version}, body, body);
    }

    # decodes a request whose wrapper element has the given attributes and content
    static auto decode(string version, string use, string wrapper_attributes, string content) {
        WebService ws(wsdl(version, use));
        WSOperation op = ws.getBindingOperation("B", "submit");
        string encoding = use == "encoded" ? sprintf(' e:encodingStyle="%s"', Encoding{version}) : "";
        string xml = sprintf('<e:Envelope xmlns:e="%s"><e:Body><w:submit xmlns:w="urn:rpc"%s%s>%s</w:submit>'
            '</e:Body></e:Envelope>', Envelope{version}, encoding, wrapper_attributes, content);
        hash<auto> msg = WSDLLib::parseMultiPartSOAPMessage({"content-type": version == "11" ? "text/xml"
            : "application/soap+xml", "body": xml}, False, True);
        return op.deserializeRequest(WSDLLib::parseSOAPMessage(msg, False, True), "B");
    }

    missingLiteral() {
        foreach string version in ("11", "12") {
            assertEq({"name": "abc", "count": 7}, decode(version, "literal", "", "<name>abc</name><count>7</count>"));
            # an omitted string accessor was decoded as an empty string, and an omitted int accessor was rejected
            assertEq({"name": NOTHING, "count": 7}, decode(version, "literal", "", "<count>7</count>"));
            assertEq({"name": "abc", "count": NOTHING}, decode(version, "literal", "", "<name>abc</name>"));
            # an empty accessor is an empty value
            assertEq({"name": "", "count": 7}, decode(version, "literal", "", "<name/><count>7</count>"));
            assertThrows("SOAP-DESERIALIZATION-ERROR", \decode(), (version, "literal", "", "<name/><count/>"));
        }
    }

    qualifiedLiteral() {
        foreach string version in ("11", "12") {
            # qualified by a prefix, by the wrapper's namespace or another one
            foreach string content in ("<w:name>abc</w:name><count>7</count>",
                    '<name>abc</name><o:count xmlns:o="urn:other">7</o:count>') {
                assertThrows("SOAP-DESERIALIZATION-ERROR", "must not be namespace-qualified", \decode(),
                    (version, "literal", "", content), content);
            }
            # qualified by a default namespace declaration
            assertThrows("SOAP-DESERIALIZATION-ERROR", "must not be namespace-qualified", \decode(),
                (version, "literal", ' xmlns="urn:rpc"', "<name>abc</name><count>7</count>"));
            # an undeclared default namespace leaves them unqualified
            assertEq({"name": "abc", "count": 7}, decode(version, "literal", ' xmlns=""',
                "<name>abc</name><count>7</count>"));
        }
    }

    elementPart() {
        string source = replace(wsdl("11", "literal"), '<part name="count" type="xsd:int"/>',
            '<part name="count" element="x:count"/>');
        source = replace(source, '<message name="In">', '<types><xsd:schema targetNamespace="urn:x" '
            'elementFormDefault="qualified"><xsd:element name="count" type="xsd:int"/></xsd:schema></types>'
            '<message name="In">');
        source = replace(source, 'xmlns:t="urn:t"', 'xmlns:t="urn:t" xmlns:x="urn:x"');
        WebService ws(source);
        WSOperation op = ws.getBindingOperation("B", "submit");
        string xml = sprintf('<e:Envelope xmlns:e="%s"><e:Body><w:submit xmlns:w="urn:rpc"><name>abc</name>'
            '<x:count xmlns:x="urn:x">7</x:count></w:submit></e:Body></e:Envelope>', Envelope."11");
        hash<auto> msg = WSDLLib::parseMultiPartSOAPMessage({"content-type": "text/xml", "body": xml}, False, True);
        assertEq({"name": "abc", "count": 7}, op.deserializeRequest(WSDLLib::parseSOAPMessage(msg, False, True),
            "B"));
    }

    qualifiedEncoded12() {
        # SOAP 1.2 Part 2 section 4.2.1 does not constrain the namespace of an edge label; the Primer qualifies them
        assertEq({"name": "abc", "count": 7}, decode("12", "encoded", "", "<name>abc</name><count>7</count>"));
        assertEq({"name": "abc", "count": 7}, decode("12", "encoded", "", "<w:name>abc</w:name><count>7</count>"));
        assertEq({"name": "abc", "count": 7}, decode("12", "encoded", ' xmlns="urn:rpc"',
            "<name>abc</name><count>7</count>"));
        # a response's rpc:result names the return value accessor
        WebService ws(wsdl("12", "encoded"));
        WSOperation op = ws.getBindingOperation("B", "submit");
        string xml = sprintf('<e:Envelope xmlns:e="%s"><e:Body><w:submitResponse xmlns:w="urn:rpc" '
            'xmlns:r="http://www.w3.org/2003/05/soap-rpc" e:encodingStyle="%s"><r:result>result</r:result>'
            '<result>done</result></w:submitResponse></e:Body></e:Envelope>', Envelope."12", Encoding."12");
        hash<auto> msg = WSDLLib::parseMultiPartSOAPMessage({"content-type": "application/soap+xml", "body": xml},
            False, True);
        assertEq("done", op.deserializeResponse(WSDLLib::parseSOAPMessage(msg, False, True), "B"));
    }

    qualifiedEncoded11() {
        # SOAP 1.1 section 7.1 does not constrain the namespace of accessors
        assertEq({"name": "abc", "count": 7}, decode("11", "encoded", "", "<w:name>abc</w:name><count>7</count>"));
        assertEq({"name": "abc", "count": 7}, decode("11", "encoded", ' xmlns="urn:rpc"',
            "<name>abc</name><count>7</count>"));
    }

    omittedEncoded() {
        foreach string version in ("11", "12") {
            assertEq({"name": NOTHING, "count": 7}, decode(version, "encoded", "", "<count>7</count>"));
        }
    }
}
