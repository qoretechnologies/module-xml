#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "IEEE constraint tests require the json module";
%else
%exec-class XmlIeeeConstraintsTest

class XmlIeeeConstraintsTest inherits QUnit::Test {
    constructor() : Test("Native canonical IEEE constraint declarations", "1.0") {
        addTestCase("Default and fixed constraints require valid canonical forms", \constraints());
        addTestCase("IEEE lexical validation rejects malformed exponents and non-XML forms", \lexicals());
        set_return_value(main());
    }
    private static bool consume(string schema, string xml) {
        XmlReader reader(new StringInputStream(xml), {"xsd": schema});
        int roots = 0;
        while (reader.read()) {
            if (reader.nodeType() == XML_NODE_TYPE_ELEMENT && !reader.depth()) {
                ++roots;
            }
        }
        return roots == 1 && reader.isValid();
    }
    private constraints() {
        list<hash<auto>> models = parse_json(ReadOnlyFile::readTextFile(
            get_script_dir() + "/wsdl-interop/fixtures/ieee-constraints.json"));
        assertEq(300, models.size());
        foreach hash<auto> model in (models) {
            XmlDoc document(model.xml);
            if (model.valid) {
                assertTrue(consume(model.schema, model.xml), model.name);
                assertEq(parse_xml(model.xml), parse_xml_with_schema(model.xml, model.schema), model.name);
                document.validateSchema(model.schema);
                document.validateSchema(model.schema);
            } else {
                assertThrows("XSD-SYNTAX-ERROR", \consume(), (model.schema, model.xml));
                assertThrows("XSD-SYNTAX-ERROR", \parse_xml_with_schema(), (model.xml, model.schema));
                assertThrows("XSD-SYNTAX-ERROR", \document.validateSchema(), (model.schema,));
            }
        }
    }
    private lexicals() {
        list<hash<auto>> models = parse_json(ReadOnlyFile::readTextFile(
            get_script_dir() + "/wsdl-interop/fixtures/ieee-lexicals.json"));
        assertEq(90, models.size());
        foreach hash<auto> model in (models) {
            string schema = "<xs:schema xmlns:xs='http://www.w3.org/2001/XMLSchema'>"
                "<xs:element name='value' type='xs:" + model.builtin + "'/></xs:schema>";
            string xml = "<value>" + model.lexical + "</value>";
            XmlDoc document(xml);
            if (model.valid) {
                assertTrue(consume(schema, xml));
                assertEq(parse_xml(xml), parse_xml_with_schema(xml, schema));
                document.validateSchema(schema);
            } else {
                assertThrows("PARSE-XML-EXCEPTION", \consume(), (schema, xml));
                assertThrows("PARSE-XML-EXCEPTION", \parse_xml_with_schema(), (xml, schema));
                assertThrows("XSD-ERROR", \document.validateSchema(), (schema,));
            }
        }
    }

}
%endif
