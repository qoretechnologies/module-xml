#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class ListValueTest

class ListValueTest inherits QUnit::Test {
    constructor() : Test("XSD list lexical forms and value equality", "1.0") {
        addTestCase("Numeric list enumeration compares ordered exact values", \numericChoices());
        addTestCase("Boolean list enumeration recognizes equivalent spellings", \booleanChoices());
        addTestCase("Whole-list patterns retain each item's lexical spelling", \patterns());
        addTestCase("List lexical boundaries reject empty and space-bearing native items", \itemBoundaries());
        addTestCase("List enumeration uses values independently of lexical pattern facets", \patternChoices());
        addTestCase("Reconstructed and optional list providers retain validation", \providers());
        addTestCase("Empty and duplicate enumeration values preserve list identity", \emptyChoices());
        addTestCase("Invalid item and inherited enumeration declarations fail", \declarations());
        addTestCase("List field choice replacements validate before publication", \fieldUpdates());
        addTestCase("List provider reconstruction rejects malformed metadata", \metadata());
        addTestCase("List conversion preserves cancellation and input values", \cancellation());
        addTestCase("List examples satisfy patterns or report generation failure", \samples());
        set_return_value(main());
    }

    private static XsdSchema schema(string builtin, string facets, *string item_facets) {
        string item = item_facets ? '<xs:simpleType name="Item"><xs:restriction base="xs:' + builtin + '">'
            + item_facets + '</xs:restriction></xs:simpleType>' : "";
        return new XsdSchema('<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:list-values"
            targetNamespace="urn:list-values">' + item + '<xs:simpleType name="Base"><xs:list itemType="'
            + (item_facets ? 't:Item' : 'xs:' + builtin) + '"/></xs:simpleType>
            <xs:simpleType name="Value"><xs:restriction base="t:Base">' + facets
            + '</xs:restriction></xs:simpleType></xs:schema>', {"async_only": True});
    }

    private static XsdSimpleType valueType(XsdSchema definition) {
        return cast<XsdSimpleType>(definition.findType(make_qname("urn:list-values", "Value")));
    }

    private numericChoices() {
        foreach string builtin in ("integer", "decimal") {
            XsdSchema original = schema(builtin, '<xs:enumeration value="01 +2"/>');
            foreach XsdSchema definition in (original, Serializable::deserialize(original.serialize())) {
                XsdSimpleType type = valueType(definition);
                list<auto> decoded = type.deserializeValue("value", definition.getTypeMap(), NOTHING, "1 2");
                assertEq(1n, number(decoded[0]));
                assertEq(2n, number(decoded[1]));
                assertEq(decoded, type.deserializeValue("value", definition.getTypeMap(), NOTHING,
                    type.serializeValue(new Namespaces({}), decoded, True)));
                assertThrows("SOAP-DESERIALIZATION-ERROR", \type.deserializeValue(),
                    ("value", definition.getTypeMap(), NOTHING, "2 1"));
                assertThrows("SOAP-SERIALIZATION-ERROR", \type.serializeValue(), (new Namespaces({}), (1, 3), True));
            }
        }
        XsdSchema exact = schema("integer", '<xs:enumeration value="18446744073709551616 2"/>');
        assertEq(("+018446744073709551616", "+02"), valueType(exact).deserializeValue("value", exact.getTypeMap(),
            NOTHING, "+018446744073709551616 +02"));
    }

    private booleanChoices() {
        XsdSchema original = schema("boolean", '<xs:enumeration value="1 0"/>');
        foreach XsdSchema definition in (original, Serializable::deserialize(original.serialize())) {
            XsdSimpleType type = valueType(definition);
            assertEq((True, False), type.deserializeValue("value", definition.getTypeMap(), NOTHING, "true false"));
            assertEq("true false", type.serializeValue(new Namespaces({}), (True, False), True));
            assertThrows("SOAP-DESERIALIZATION-ERROR", \type.deserializeValue(),
                ("value", definition.getTypeMap(), NOTHING, "true true"));
        }
    }

    private patterns() {
        XsdSchema original = schema("integer", '<xs:pattern value="00[0-9] 00[0-9]"/>',
            '<xs:minInclusive value="1"/><xs:maxInclusive value="9"/>');
        foreach XsdSchema definition in (original, Serializable::deserialize(original.serialize())) {
            XsdSimpleType type = valueType(definition);
            assertEq(("001", "002"), type.deserializeValue("value", definition.getTypeMap(), NOTHING, " 001\t002 "));
            assertEq("001 002", type.serializeValue(new Namespaces({}), ("001", "002"), True));
            assertThrows("SOAP-SERIALIZATION-ERROR", \type.serializeValue(), (new Namespaces({}), (1, 2), True));
            assertThrows("SOAP-DESERIALIZATION-ERROR", \type.deserializeValue(),
                ("value", definition.getTypeMap(), NOTHING, "001 000"));
            assertThrows("SOAP-DESERIALIZATION-ERROR", \type.deserializeValue(),
                ("value", definition.getTypeMap(), NOTHING, "1 2"));
        }
    }

    private itemBoundaries() {
        XsdSchema numeric = schema("integer", "");
        foreach XsdAbstractType type in (valueType(numeric), numeric.findType(make_qname("urn:list-values", "Base"))) {
            foreach auto invalid in (((1, 2),), {"child": "1"}) {
                assertThrows("SOAP-SERIALIZATION-ERROR", \type.serializeValue(), (new Namespaces({}), invalid, True));
                assertThrows("SOAP-DESERIALIZATION-ERROR", \type.deserializeValue(),
                    ("value", numeric.getTypeMap(), NOTHING, invalid));
            }
        }
        foreach string builtin in ("string", "normalizedString", "token") {
            XsdSchema definition = schema(builtin, "");
            XsdSimpleType type = valueType(definition);
            assertEq("A\u00a0B", type.serializeValue(new Namespaces({}), ("A\u00a0B",), True));
            assertEq("", type.serializeValue(new Namespaces({}), (), True));
            foreach string item in ("", "A B", "A\tB", "A\nB", "A\rB") {
                assertThrows("SOAP-SERIALIZATION-ERROR", \type.serializeValue(),
                    (new Namespaces({}), (item,), True));
                AbstractDataProviderType provider = type.getDataProviderType();
                assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), ((item,),));
            }
        }
    }

    private patternChoices() {
        XsdSchema definition = schema("integer", '<xs:enumeration value="01 +2"/>
            <xs:pattern value="00[0-9] 00[0-9]"/>');
        XsdSimpleType type = valueType(definition);
        assertEq(("001", "002"), type.deserializeValue("value", definition.getTypeMap(), NOTHING, "001 002"));
        assertEq("001 002", type.serializeValue(new Namespaces({}), ("001", "002"), True));
        assertThrows("SOAP-SERIALIZATION-ERROR", \type.serializeValue(), (new Namespaces({}), ("002", "001"), True));
    }

    private static AbstractDataProviderType detachedProvider() {
        XsdSchema definition = schema("integer", '<xs:enumeration value="01 +2"/>
            <xs:pattern value="00[0-9] 00[0-9]"/>');
        return valueType(definition).getDataProviderType();
    }

    private providers() {
        AbstractDataProviderType original = detachedProvider();
        foreach AbstractDataProviderType provider in (original, Serializable::deserialize(original.serialize())) {
            assertEq(("001", "002"), provider.acceptsValue(("001", "002")));
            assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (("002", "001"),));
            assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), ((1, 2),));
            AbstractDataProviderType optional = Serializable::deserialize(provider.getOrNothingType().serialize());
            assertEq(NOTHING, optional.acceptsValue(NOTHING));
            assertEq(("001", "002"), optional.acceptsValue(("001", "002")));
            AbstractDataProviderType mandatory = optional.getMandatoryType();
            assertThrows("MISSING-VALUE-ERROR", \mandatory.acceptsValue(), (NOTHING,));
            ListDataType repeated(provider);
            assertEq((("001", "002"), ("001", "002")), repeated.acceptsValue((("001", "002"), ("001", "002"))));
            assertThrows("RUNTIME-TYPE-ERROR", \repeated.acceptsValue(), ((("001", "002"), (1, 2)),));
        }
    }
    private emptyChoices() {
        foreach string builtin in ("integer", "boolean", "string") {
            XsdSchema definition = schema(builtin, '<xs:enumeration value=""/>');
            XsdSimpleType type = valueType(definition);
            assertEq((), type.deserializeValue("value", definition.getTypeMap(), NOTHING, " \t\n"));
            assertEq(((),), type.getAllowedValues());
            assertEq("", type.serializeValue(new Namespaces({}), (), True));
            AbstractDataProviderType provider = Serializable::deserialize(type.getDataProviderType().serialize());
            assertEq((), provider.acceptsValue(()));
            assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (("1",),));
        }
        XsdSchema definition = schema("integer", '<xs:enumeration value="01 +2"/><xs:enumeration value="1 02"/>');
        assertEq((("01", "+2"),), valueType(definition).getAllowedValues());
        definition = schema("boolean", '<xs:enumeration value="1 0"/><xs:enumeration value="true false"/>');
        assertEq(((True, False),), valueType(definition).getAllowedValues());
    }

    private declarations() {
        foreach hash<auto> invalid in (
                {"builtin": "integer", "value": "1 2x"},
                {"builtin": "boolean", "value": "true yes"},
                {"builtin": "decimal", "value": "1 2e0"},
                {"builtin": "int", "value": "1 0", "item": '<xs:minInclusive value="1"/>'}) {
            assertThrows("XSD-SIMPLETYPE-ERROR", \schema(),
                (invalid.builtin, '<xs:enumeration value="' + invalid.value + '"/>', invalid.item));
        }
        XsdSchema definition = schema("integer", '<xs:enumeration value="1 2"/>');
        string additional = '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:list-values"
            targetNamespace="urn:list-values"><xs:simpleType name="Invalid"><xs:restriction base="t:Value">
            <xs:enumeration value="2 1"/></xs:restriction></xs:simpleType></xs:schema>';
        assertThrows("XSD-SIMPLETYPE-ERROR", \definition.addSchemaString(), additional);
        assertEq((1, 2), valueType(definition).deserializeValue("value", definition.getTypeMap(), NOTHING, "1 2"));
    }

    private static hash<XsdListItemInfo> itemInfo(string builtin) {
        Namespaces namespaces({});
        XsdBaseType type = namespaces.getBaseType(builtin);
        return <XsdListItemInfo>{"builtin": builtin, "provider": type.getDataProviderType(),
            "white_space": type.getWhiteSpace()};
    }

    private fieldUpdates() {
        hash<XsdListItemInfo> item = itemInfo("int");
        XsdListDataType type(item);
        XsdListDataField field({"name": "invoice_lines", "type": type,
            "allowed_values": (("01", "+2"),)}, item);
        assertEq((1, 2), field.acceptsValue((1, 2)));
        assertEq("01 +2", field.getAllowedValues()[0].display_name);
        field.setAllowedValues((<AllowedValueInfo>{"value": (3, 4), "display_name": "Third and Fourth"},));
        assertEq((3, 4), field.acceptsValue(("03", "+4")));
        assertThrows("FIELD-VALUE-ERROR", \field.acceptsValue(), ((1, 2),));
        hash<SerializationInfo> before = field.serializeToData();
        foreach auto invalid in (((5, 6), (7, "x")), ((5, 6), "bad"), ((5, 6), (NOTHING,))) {
            assertThrows("XSD-SIMPLETYPE-ERROR", \field.setAllowedValues(), (invalid,));
            assertEq(before, field.serializeToData());
        }
        XsdListDataField restored = Serializable::deserialize(field.serialize());
        assertEq((3, 4), restored.acceptsValue(("03", "+4")));
        assertThrows("FIELD-VALUE-ERROR", \restored.acceptsValue(), ((1, 2),));
        field.setAllowedValues(());
        assertEq((9,), field.acceptsValue((9,)));
        XsdListDataField repeated({"name": "invoices", "type": new ListDataType(type),
            "element_allowed_values": (("01", "+2"),)}, item);
        assertEq(((1, 2), (1, 2)), repeated.acceptsValue((("01", "02"), (1, 2))));
        repeated.setElementAllowedValues(((3, 4),));
        assertEq(((3, 4),), repeated.acceptsValue((("03", "+4"),)));
        assertThrows("FIELD-VALUE-ERROR", \repeated.acceptsValue(), (((1, 2),),));
        before = repeated.serializeToData();
        assertThrows("XSD-SIMPLETYPE-ERROR", \repeated.setElementAllowedValues(), (((5, 6), (7, "x")),));
        assertEq(before, repeated.serializeToData());
        repeated.setElementAllowedValues(((3, 4),), True);
        assertEq(((1, 2),), repeated.acceptsValue(((1, 2),)));
    }

    private metadata() {
        XsdListDataType base(itemInfo("int"));
        hash<SerializationInfo> original = base.serializeToData();
        foreach hash<auto> change in ({"builtin": "float"}, {"white_space": "trim"},
                {"white_space": "preserve"}) {
            hash<SerializationInfo> state = original;
            string index = state._index."0"._class_data."WSDL::XsdListDataType".item._index;
            state._index{index}._members += change;
            assertThrows("DESERIALIZATION-ERROR", \Serializable::deserialize(), (state,));
        }
        hash<SerializationInfo> state = original;
        state._index."0"._class_data."WSDL::XsdListDataType".optional = "true";
        assertThrows("DESERIALIZATION-ERROR", \Serializable::deserialize(), (state,));
        assertEq((1, 2), Serializable::deserialize(original).acceptsValue((1, 2)));
        AbstractDataProviderType provider = detachedProvider();
        original = provider.serializeToData();
        foreach hash<auto> change in ({"length": -1}, {"min_length": "1tail"},
                {"patterns": ("[",)}, {"enumeration": (("x",),)}) {
            state = original;
            string index = state._index."0"._class_data."WSDL::XsdListRestrictionDataType".facets._index;
            state._index{index}._members += change;
            assertThrows("DESERIALIZATION-ERROR", \Serializable::deserialize(), (state,));
        }
        state = original;
        state._index."0"._class_data."WSDL::XsdListRestrictionDataType".base = NOTHING;
        assertThrows("DESERIALIZATION-ERROR", \Serializable::deserialize(), (state,));
        assertEq(("001", "002"), Serializable::deserialize(original).acceptsValue(("001", "002")));
        foreach AbstractDataProviderType invalid in (AbstractDataProviderType::get(AutoType),
                AbstractDataProviderType::get(StringOrNothingType), new ListDataType(IntType)) {
            hash<XsdListItemInfo> item = itemInfo("int");
            item.provider = invalid;
            assertThrows("XSD-SIMPLETYPE-ERROR", \newList(), item);
        }
    }

    private static AbstractDataProviderType newList(hash<XsdListItemInfo> item) {
        return new XsdListDataType(item);
    }

    private cancellation() {
        CancelListItem item_provider();
        hash<XsdListItemInfo> item = itemInfo("int");
        item.provider = item_provider;
        XsdListDataType provider(item);
        list<auto> input = (1, 2, 3);
        assertThrows("TEST-CANCELLED", \provider.acceptsValue(), (input,));
        assertEq(2, item_provider.calls);
        assertEq((1, 2, 3), input);
        item_provider.cancel = False;
        assertEq((1, 2, 3), provider.acceptsValue(input));
    }

    private samples() {
        foreach hash<auto> example in (
                {"builtin": "integer", "facets": '<xs:enumeration value="01 +2"/>', "expected": "01 +2"},
                {"builtin": "boolean", "facets": '<xs:enumeration value="true false"/><xs:pattern value="1 0"/>',
                    "expected": "1 0"},
                {"builtin": "integer", "facets": '<xs:enumeration value="01 +2"/><xs:pattern value="001 002"/>',
                    "expected": "001 002"},
                {"builtin": "integer", "facets": '<xs:enumeration value=""/>', "expected": ""}) {
            XsdSchema definition = schema(example.builtin, example.facets);
            XsdSimpleType type = valueType(definition);
            auto sample = type.getSampleValue((123,));
            assertEq(example.expected, type.serializeValue(new Namespaces({}), sample, True));
        }
        XsdSchema definition = schema("integer", '<xs:enumeration value="1 2"/><xs:length value="1"/>');
        XsdSimpleType type = valueType(definition);
        assertThrows("XSD-SAMPLE-ERROR", \type.getSampleValue(), ((123,),));
    }

}


class CancelListItem inherits XsdIntegerDataType {
    public {
        int calls;
        bool cancel = True;
    }
    constructor() : XsdIntegerDataType("int") {
    }
    auto acceptsValue(auto value) {
        if (++calls == 2 && cancel) {
            throw "TEST-CANCELLED", "controlled cancellation during list conversion";
        }
        return XsdIntegerDataType::acceptsValue(value);
    }
}
