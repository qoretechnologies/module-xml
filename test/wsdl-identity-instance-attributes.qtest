#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires ../qlib/WSDL.qm
%requires xml
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "Identity fixtures require json";
%else
%exec-class IdentityXsiTest
class IdentityXsiTest inherits QUnit::Test {
    constructor() : Test("Builtin instance attribute identity values", "1.0") {
        foreach hash<auto> model in (parse_json(ReadOnlyFile::readTextFile(get_script_dir()+"/wsdl-interop/fixtures/identity-instance-attributes.json"))) {
            addTestCase("native/" + model.name, \nativeMatrix(), (model,));
            addTestCase("wsdl/" + model.name, \matrix(), (model,));
        }
        set_return_value(main());
    }
    private auto decode(XsdSchema schema, string xml, bool native) {
        return schema.getElement("", "root").deserializeValue(schema.getTypeMap(), NOTHING,
            XsdBase::expandElementNamespaces(parse_xml(xml, XPF_PRESERVE_ORDER)){"{}root"}, True, native);
    }
    private nativeMatrix(hash<auto> model) {
        if (model.valid) {
            assertEq(parse_xml(model.xml), parse_xml_with_schema(model.xml, model.schema));
        } else {
            assertThrows("PARSE-XML-EXCEPTION", \parse_xml_with_schema(), (model.xml, model.schema));
        }
    }
    private static int instanceFieldCount(string xml, *string field) {
        auto root = XsdBase::expandElementNamespaces(parse_xml(xml, XPF_PRESERVE_ORDER)){"{}root"};
        int count = 0;
        foreach auto row in (root{"{}row"}) {
            hash<auto> attributes = XsdBase::getExpandedAttributes(row."^attributes^");
            foreach string name in ("type", "nil", "schemaLocation", "noNamespaceSchemaLocation") {
                if ((!field || field == name) && attributes.hasKey("{" + XSI_NS + "}" + name)) {
                    ++count;
                }
            }
        }
        return count;
    }
    private matrix(hash<auto> model) {
        XsdSchema original(model.schema, {"async_only":True});
        foreach XsdSchema schema in (original, Serializable::deserialize(original.serialize())) {
            foreach bool native in (False, True) {
                if (model.valid) {
                    auto decoded = decode(schema, model.xml, native);
                    assertTrue(exists decoded);
                    if (!native && model.legacy_serialization_error) {
                        assertThrows(model.legacy_serialization_error, \schema.serializeXmlValue(),
                            ("", "root", decoded));
                    } else {
                        XsdXmlValue wire = schema.serializeXmlValue("", "root", decoded);
                        assertEq(parse_xml(wire.getXml()), parse_xml_with_schema(wire.getXml(), model.schema));
                        # Missing builtin fields must stay missing. The schema
                        # oracle independently checks the resulting value tuples.
                        # Legacy scalar inference can add unrelated xsi:type;
                        # native mode preserves all builtin attribute presence.
                        *string field = native ? NOTHING : model.builtin_attribute;
                        assertEq(instanceFieldCount(model.xml, field), instanceFieldCount(wire.getXml(), field));
                        if (native) {
                            # Native providers consume the preserved native shape,
                            # including XsdNilValue rather than legacy NOTHING.
                            AbstractDataProviderType provider = schema.getNativeDataProviderType("", "root");
                            auto accepted = provider.acceptsValue(decoded);
                            XsdXmlValue emitted = schema.serializeXmlValue("", "root", accepted);
                            assertEq(instanceFieldCount(model.xml), instanceFieldCount(emitted.getXml()));
                            assertEq(parse_xml(emitted.getXml()), parse_xml_with_schema(emitted.getXml(), model.schema));
                        }
                    }
                } else {
                    assertThrows("SOAP-DESERIALIZATION-ERROR", \decode(), (schema, model.xml, native));
                }
            }
            XsdXmlValue input(model.xml);
            AbstractDataProviderType xml = schema.getXmlDataProviderType("", "root");
            foreach AbstractDataProviderType provider in (xml, Serializable::deserialize(xml.serialize())) {
                if (model.valid) {
                    XsdXmlValue accepted = provider.acceptsValue(input);
                    assertEq(model.xml, accepted.getXml());
                } else {
                    assertThrows("SOAP-SERIALIZATION-ERROR", \provider.acceptsValue(), (input,));
                }
            }
        }
    }
}
%endif
