# Message with comments and processing instructions
const AnnotatedMessage = '<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="transform.xsl"?>
<!-- Generated by Test Framework v1.0 -->
<soap:Envelope xmlns:soap="http://www.w3.org/2003/05/soap-envelope"
               xmlns:tns="http://qore.org/simpletest">
  <!-- SOAP Header is optional -->
  <soap:Header/>
  <soap:Body>
    <!-- Main request -->
    <tns:getInfo>
      <tns:GetInfo>
        <!-- Stock ticker symbol -->
        <tns:tickerSymbol>ANNOTATED</tns:tickerSymbol>
      </tns:GetInfo>
    </tns:getInfo>
  </soap:Body>
</soap:Envelope>';

# Minimal single-line SOAP message
const MinimalMessage = '<?xml version="1.0"?><soap:Envelope xmlns:soap="http://www.w3.org/2003/05/soap-envelope" xmlns:tns="http://qore.org/simpletest"><soap:Body><tns:getInfo><tns:GetInfo><tns:tickerSymbol>MINIMAL</tns:tickerSymbol></tns:GetInfo></tns:getInfo></soap:Body></soap:Envelope>';

# Default namespace (no prefix) style
const DefaultNsMessage = '<?xml version="1.0" encoding="UTF-8"?>
<Envelope xmlns="http://www.w3.org/2003/05/soap-envelope">
  <Body>
    <getInfo xmlns="http://qore.org/simpletest">
      <GetInfo>
        <tickerSymbol>DEFAULT-NS</tickerSymbol>
      </GetInfo>
    </getInfo>
  </Body>
</Envelope>';

# Multiple namespace prefixes for same namespace
const MultiPrefixMessage = '<?xml version="1.0" encoding="UTF-8"?>
<soapenv:Envelope xmlns:soapenv="http://www.w3.org/2003/05/soap-envelope"
                  xmlns:ns1="http://qore.org/simpletest"
                  xmlns:ns2="http://qore.org/simpletest"
                  xmlns:tns="http://qore.org/simpletest">
  <soapenv:Body>
    <ns1:getInfo>
      <tns:GetInfo>
        <ns2:tickerSymbol>MULTI-PREFIX</ns2:tickerSymbol>
      </tns:GetInfo>
    </ns1:getInfo>
  </soapenv:Body>
</soapenv:Envelope>';

# Namespace declared on child elements
const ChildNsMessage = '<?xml version="1.0" encoding="UTF-8"?>
<soap:Envelope xmlns:soap="http://www.w3.org/2003/05/soap-envelope">
  <soap:Body>
    <getInfo xmlns="http://qore.org/simpletest">
      <GetInfo xmlns:tns="http://qore.org/simpletest">
        <tns:tickerSymbol>CHILD-NS</tns:tickerSymbol>
      </GetInfo>
    </getInfo>
  </soap:Body>
</soap:Envelope>';

# Whitespace variations (extra whitespace)
const WhitespaceMessage = '<?xml version="1.0" encoding="UTF-8"?>
<soap:Envelope
    xmlns:soap="http://www.w3.org/2003/05/soap-envelope"
    xmlns:tns="http://qore.org/simpletest"
>
  <soap:Body>


    <tns:getInfo>
      <tns:GetInfo>
        <tns:tickerSymbol>   WHITESPACE   </tns:tickerSymbol>
      </tns:GetInfo>
    </tns:getInfo>


  </soap:Body>
</soap:Envelope>';

# SOAP Fault formats for parsing tests
const Soap12Fault = '<?xml version="1.0" encoding="utf-8"?>
<soap:Envelope xmlns:soap="http://www.w3.org/2003/05/soap-envelope"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <soap:Body>
    <soap:Fault>
      <soap:Code>
        <soap:Value>soap:Sender</soap:Value>
        <soap:Subcode>
          <soap:Value xmlns:err="http://qore.org/simpletest">err:InvalidInput</soap:Value>
        </soap:Subcode>
      </soap:Code>
      <soap:Reason>
        <soap:Text xml:lang="en">The input data was invalid.</soap:Text>
      </soap:Reason>
      <soap:Detail>
        <ErrorDetails xmlns="http://qore.org/simpletest">
          <ErrorCode>1001</ErrorCode>
          <ErrorMessage>Validation failed</ErrorMessage>
        </ErrorDetails>
      </soap:Detail>
    </soap:Fault>
  </soap:Body>
</soap:Envelope>';

const Soap11Fault = '<?xml version="1.0" encoding="UTF-8"?>
<SOAP-ENV:Envelope xmlns:SOAP-ENV="http://schemas.xmlsoap.org/soap/envelope/">
  <SOAP-ENV:Body>
    <SOAP-ENV:Fault>
      <faultcode>SOAP-ENV:Client</faultcode>
      <faultstring>Client error occurred</faultstring>
      <faultactor>http://localhost/soap/service</faultactor>
      <detail>
        <errorInfo xmlns="http://qore.org/simpletest">
          <code>2001</code>
          <message>Invalid request format</message>
        </errorInfo>
      </detail>
    </SOAP-ENV:Fault>
  </SOAP-ENV:Body>
</SOAP-ENV:Envelope>';

#############################################################################
# SOAP Version Detection Test Messages
#############################################################################

# SOAP 1.1 envelope that also declares SOAP 1.2 namespace (but doesn't use it)
# Should be treated as SOAP 1.1 since the Envelope element uses SOAP 1.1 namespace
const Soap11WithSoap12Declared = '<?xml version="1.0" encoding="UTF-8"?>
<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/"
                  xmlns:soap12="http://www.w3.org/2003/05/soap-envelope"
                  xmlns:tns="http://qore.org/simpletest">
  <soapenv:Body>
    <tns:getInfo>
      <tns:GetInfo>
        <tns:tickerSymbol>SOAP11-WITH-12-DECL</tns:tickerSymbol>
      </tns:GetInfo>
    </tns:getInfo>
  </soapenv:Body>
</soapenv:Envelope>';

# SOAP 1.2 envelope that also declares SOAP 1.1 namespace (but doesn't use it)
# Should be treated as SOAP 1.2 since the Envelope element uses SOAP 1.2 namespace
const Soap12WithSoap11Declared = '<?xml version="1.0" encoding="UTF-8"?>
<soap:Envelope xmlns:soap="http://www.w3.org/2003/05/soap-envelope"
               xmlns:soapenv11="http://schemas.xmlsoap.org/soap/envelope/"
               xmlns:tns="http://qore.org/simpletest">
  <soap:Body>
    <tns:getInfo>
      <tns:GetInfo>
        <tns:tickerSymbol>SOAP12-WITH-11-DECL</tns:tickerSymbol>
      </tns:GetInfo>
    </tns:getInfo>
  </soap:Body>
</soap:Envelope>';

# Invalid/unsupported SOAP envelope namespace (should be rejected)
const InvalidEnvelopeNs = '<?xml version="1.0" encoding="UTF-8"?>
<soap:Envelope xmlns:soap="http://invalid.soap.namespace/envelope"
               xmlns:tns="http://qore.org/simpletest">
  <soap:Body>
    <tns:getInfo>
      <tns:GetInfo>
        <tns:tickerSymbol>INVALID-NS</tns:tickerSymbol>
      </tns:GetInfo>
    </tns:getInfo>
  </soap:Body>
</soap:Envelope>';

# SOAP 1.1 with "s" prefix (like some Microsoft services)
const Soap11ShortPrefix = '<?xml version="1.0" encoding="UTF-8"?>
<s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/"
            xmlns:tns="http://qore.org/simpletest">
  <s:Body>
    <tns:getInfo>
      <tns:GetInfo>
        <tns:tickerSymbol>S-PREFIX-11</tns:tickerSymbol>
      </tns:GetInfo>
    </tns:getInfo>
  </s:Body>
</s:Envelope>';

# SOAP 1.2 with "s" prefix
const Soap12ShortPrefix = '<?xml version="1.0" encoding="UTF-8"?>
<s:Envelope xmlns:s="http://www.w3.org/2003/05/soap-envelope"
            xmlns:tns="http://qore.org/simpletest">
  <s:Body>
    <tns:getInfo>
      <tns:GetInfo>
        <tns:tickerSymbol>S-PREFIX-12</tns:tickerSymbol>
      </tns:GetInfo>
    </tns:getInfo>
  </s:Body>
</s:Envelope>';

# SOAP 1.1 default namespace (no prefix on Envelope)
const Soap11DefaultNs = '<?xml version="1.0" encoding="UTF-8"?>
<Envelope xmlns="http://schemas.xmlsoap.org/soap/envelope/">
  <Body>
    <getInfo xmlns="http://qore.org/simpletest">
      <GetInfo>
        <tickerSymbol>SOAP11-DEFAULT-NS</tickerSymbol>
      </GetInfo>
    </getInfo>
  </Body>
</Envelope>';

#############################################################################
# Test Server Setup
#############################################################################

class TestSoapHandler inherits SoapHandler {
    public {
        list<string> receivedBodies;
        string lastTickerSymbol;
    }

    constructor() : SoapHandler(new PermissiveAuthenticator()) {}
}

class TestServer inherits HttpServer {
    public {
        TestSoapHandler handler;
    }

    constructor(WebService ws) : HttpServer(<HttpServerOptionInfo>{"name": "KnownGoodTestServer"}) {
        handler = new TestSoapHandler();
        setDefaultHandler("soap", handler);

        handler.addMethod(ws, ws.getOperation("getInfo"), hash sub (hash<auto> cx, hash<auto> h) {
            handler.lastTickerSymbol = h.tickerSymbol;
            push handler.receivedBodies, h.tickerSymbol;
            return {
                "body": {"result": 99.9n},
                "docs": h.tickerSymbol,
                "logo": <bead>,
            };
        });

        addListener(0);
    }
}

#############################################################################
# Test Class
#############################################################################

class SoapKnownGoodTest inherits QUnit::Test {
    private {
        const WsdlPath = get_script_dir() + "/test.wsdl";
        WebService ws;
        TestServer server;
        string serverUrl;
        HTTPClient hc;
    }

    constructor() : QUnit::Test("SoapKnownGoodTest", "1.0") {
        ws = new WebService(ReadOnlyFile::readTextFile(WsdlPath));
        server = new TestServer(ws);
        on_exit server.stop();

        int port = server.getListenerInfo(0).port;
        serverUrl = sprintf("http://localhost:%d", port);
        hc = new HTTPClient({"url": serverUrl, "error_passthru": True});

        addTestCase("SoapUI SOAP 1.2", \soapUi12Test());
        addTestCase("SoapUI SOAP 1.1", \soapUi11Test());
        addTestCase("WCF style", \wcfStyleTest());
        addTestCase("Apache Axis style", \axisStyleTest());
        addTestCase("PHP NuSOAP style", \phpNuSoapTest());
        addTestCase("gSOAP style", \gSoapTest());
        addTestCase("Python Zeep style", \pythonZeepTest());
        addTestCase("Ruby Savon style", \rubySavonTest());
        addTestCase("Unicode characters", \unicodeTest());
        addTestCase("XML special characters", \specialCharsTest());
        addTestCase("Annotated message", \annotatedTest());
        addTestCase("Minimal message", \minimalTest());
        addTestCase("Default namespace", \defaultNsTest());
        addTestCase("Multiple prefixes", \multiPrefixTest());
        addTestCase("Child namespace", \childNsTest());
        addTestCase("Whitespace handling", \whitespaceTest());
        addTestCase("SOAP 1.2 fault parsing", \soap12FaultTest());
        addTestCase("SOAP 1.1 fault parsing", \soap11FaultTest());
        addTestCase("Client serialization validation", \clientSerializationTest());
        addTestCase("Round-trip validation", \roundTripTest());

        # SOAP version detection tests
        addTestCase("SOAP 1.1 with SOAP 1.2 declared", \soap11WithSoap12DeclaredTest());
        addTestCase("SOAP 1.2 with SOAP 1.1 declared", \soap12WithSoap11DeclaredTest());
        addTestCase("SOAP 1.1 short prefix", \soap11ShortPrefixTest());
        addTestCase("SOAP 1.2 short prefix", \soap12ShortPrefixTest());
        addTestCase("SOAP 1.1 default namespace", \soap11DefaultNsTest());
        addTestCase("Invalid envelope namespace rejected", \invalidEnvelopeNsTest());

        set_return_value(main());
    }

    # Helper to send known-good message and verify server accepts it
    private hash<auto> sendMessage(string soapXml, string expectedTicker) {
        server.handler.receivedBodies = ();
        server.handler.lastTickerSymbol = "";

        string contentType = soapXml =~ /www\.w3\.org\/2003\/05\/soap-envelope/
            ? "application/soap+xml; charset=utf-8"
            : "text/xml; charset=utf-8";

        hash<auto> info;
        string response = hc.post("/", soapXml, {"Content-Type": contentType}, \info);

        return {
            "status": info."response-headers".status_code,
            "response": response,
            "parsed_ticker": server.handler.lastTickerSymbol,
        };
    }

    soapUi12Test() {
        hash<auto> result = sendMessage(SoapUiRequest_12, "SOAPUI-12");
        assertEq(200, result.status, "SoapUI SOAP 1.2 request accepted");
        assertEq("SOAPUI-12", result.parsed_ticker, "Ticker parsed correctly");
        assertTrue(result.response =~ /99\.9/, "Response contains expected value");
    }

    soapUi11Test() {
        hash<auto> result = sendMessage(SoapUiRequest_11, "SOAPUI-11");
        assertEq(200, result.status, "SoapUI SOAP 1.1 request accepted");
        assertEq("SOAPUI-11", result.parsed_ticker, "SOAP 1.1 ticker parsed");
    }

    wcfStyleTest() {
        hash<auto> result = sendMessage(WcfStyleRequest, "WCF-TEST");
        # WCF with WS-Addressing may not be fully supported, but should not crash
        assertTrue(result.status == 200 || result.status >= 400,
                   "WCF message handled: " + string(result.status));
    }

    axisStyleTest() {
        hash<auto> result = sendMessage(AxisStyleRequest, "AXIS-TEST");
        assertEq(200, result.status, "Axis-style request accepted");
        assertEq("AXIS-TEST", result.parsed_ticker, "Axis ticker parsed");
    }

    phpNuSoapTest() {
        hash<auto> result = sendMessage(PhpNuSoapRequest, "PHP-NUSOAP");
        assertEq(200, result.status, "PHP NuSOAP request accepted");
        assertEq("PHP-NUSOAP", result.parsed_ticker, "PHP ticker parsed");
    }

    gSoapTest() {
        hash<auto> result = sendMessage(GSoapRequest, "GSOAP-TEST");
        assertEq(200, result.status, "gSOAP request accepted");
        assertEq("GSOAP-TEST", result.parsed_ticker, "gSOAP ticker parsed");
    }

    pythonZeepTest() {
        hash<auto> result = sendMessage(PythonZeepRequest, "PYTHON-ZEEP");
        assertEq(200, result.status, "Python Zeep request accepted");
        assertEq("PYTHON-ZEEP", result.parsed_ticker, "Python ticker parsed");
    }

    rubySavonTest() {
        hash<auto> result = sendMessage(RubySavonRequest, "RUBY-SAVON");
        assertEq(200, result.status, "Ruby Savon request accepted");
        assertEq("RUBY-SAVON", result.parsed_ticker, "Ruby ticker parsed");
    }

    unicodeTest() {
        hash<auto> result = sendMessage(UnicodeMessage, "日本語テスト");
        assertEq(200, result.status, "Unicode message accepted");
        assertTrue(result.parsed_ticker =~ /日本語/, "Japanese characters preserved");
        assertTrue(result.parsed_ticker =~ /Ελληνικά/, "Greek characters preserved");
        assertTrue(result.parsed_ticker =~ /العربية/, "Arabic characters preserved");
        assertTrue(result.parsed_ticker =~ /עברית/, "Hebrew characters preserved");
        assertTrue(result.parsed_ticker =~ /中文/, "Chinese characters preserved");
    }

    specialCharsTest() {
        hash<auto> result = sendMessage(SpecialCharsMessage, "<tag>");
        assertEq(200, result.status, "Special chars message accepted");
        assertTrue(result.parsed_ticker =~ /<tag>/, "Less-than preserved");
        assertTrue(result.parsed_ticker =~ /&/, "Ampersand preserved");
        assertTrue(result.parsed_ticker =~ /"/, "Quote preserved");
    }

    annotatedTest() {
        hash<auto> result = sendMessage(AnnotatedMessage, "ANNOTATED");
        assertEq(200, result.status, "Annotated message accepted");
        assertEq("ANNOTATED", result.parsed_ticker, "Comments ignored correctly");
    }

    minimalTest() {
        hash<auto> result = sendMessage(MinimalMessage, "MINIMAL");
        assertEq(200, result.status, "Minimal message accepted");
        assertEq("MINIMAL", result.parsed_ticker, "Minimal message parsed");
    }

    defaultNsTest() {
        hash<auto> result = sendMessage(DefaultNsMessage, "DEFAULT-NS");
        assertEq(200, result.status, "Default namespace message accepted");
        assertEq("DEFAULT-NS", result.parsed_ticker, "Default ns parsed");
    }

    multiPrefixTest() {
        hash<auto> result = sendMessage(MultiPrefixMessage, "MULTI-PREFIX");
        assertEq(200, result.status, "Multi-prefix message accepted");
        assertEq("MULTI-PREFIX", result.parsed_ticker, "Multi-prefix parsed");
    }

    childNsTest() {
        hash<auto> result = sendMessage(ChildNsMessage, "CHILD-NS");
        assertEq(200, result.status, "Child namespace message accepted");
        assertEq("CHILD-NS", result.parsed_ticker, "Child ns parsed");
    }

    whitespaceTest() {
        hash<auto> result = sendMessage(WhitespaceMessage, "WHITESPACE");
        assertEq(200, result.status, "Whitespace message accepted");
        # Note: whitespace handling may trim or preserve - either is acceptable
        assertTrue(result.parsed_ticker =~ /WHITESPACE/, "Whitespace handled");
    }

    soap12FaultTest() {
        # Verify SOAP 1.2 fault can be parsed
        hash<auto> parsed = parse_xml(Soap12Fault);
        assertTrue(exists parsed, "SOAP 1.2 fault is valid XML");

        string envKey = parsed.firstKey();
        assertTrue(envKey =~ /Envelope/, "Has Envelope");
        assertTrue(Soap12Fault =~ /:Fault>/, "Has Fault element");
        assertTrue(Soap12Fault =~ /soap:Code/, "Has SOAP 1.2 Code");
        assertTrue(Soap12Fault =~ /soap:Reason/, "Has SOAP 1.2 Reason");
        assertTrue(Soap12Fault =~ /soap:Detail/, "Has SOAP 1.2 Detail");
    }

    soap11FaultTest() {
        # Verify SOAP 1.1 fault can be parsed
        hash<auto> parsed = parse_xml(Soap11Fault);
        assertTrue(exists parsed, "SOAP 1.1 fault is valid XML");

        assertTrue(Soap11Fault =~ /:Fault>/, "Has Fault element");
        assertTrue(Soap11Fault =~ /faultcode/, "Has faultcode");
        assertTrue(Soap11Fault =~ /faultstring/, "Has faultstring");
        assertTrue(Soap11Fault =~ /detail/, "Has detail");
    }

    clientSerializationTest() {
        # Verify SoapClient generates messages matching known-good formats
        SoapClient sc({"wsdl": WsdlPath, "url": serverUrl});
        WSOperation op = ws.getOperation("getInfo");

        # Serialize a request
        hash<auto> req = {"tickerSymbol": "CLIENT-GENERATED"};
        hash<auto> serialized = op.serializeRequest(req);
        string body = serialized.body;

        # Validate against known-good characteristics
        assertTrue(body =~ /\?xml/, "Has XML declaration");
        assertTrue(body =~ /Envelope/, "Has Envelope");
        assertTrue(body =~ /Body/, "Has Body");
        assertTrue(body =~ /xmlns/, "Has namespace declarations");
        assertTrue(body =~ /getInfo/, "Has operation element");
        assertTrue(body =~ /CLIENT-GENERATED/, "Contains data");

        # Verify it's valid XML
        hash<auto> parsed = parse_xml(body);
        assertTrue(exists parsed, "Generated XML is parseable");

        # Verify tags are balanced
        int openEnv = (body =~ x/<[^\/][^>]*Envelope[^>]*>/gi).size();
        int closeEnv = (body =~ x/<\/[^>]*Envelope>/gi).size();
        assertEq(openEnv, closeEnv, "Envelope tags balanced");
    }

    roundTripTest() {
        # Test full round-trip: client serializes -> server parses -> returns response -> client parses
        SoapClient sc({"wsdl": WsdlPath, "url": serverUrl});
        server.handler.receivedBodies = ();

        # Send request
        hash<auto> result = sc.callOperation("getInfo", {"tickerSymbol": "ROUND-TRIP-TEST"});

        # Verify response
        assertEq(99.9, result.body.result, "Round-trip response value");
        assertEq("ROUND-TRIP-TEST", result.docs, "Round-trip docs");
        assertEq(Type::Binary, result.logo.type(), "Round-trip binary");

        # Verify server received correct data
        assertEq("ROUND-TRIP-TEST", server.handler.lastTickerSymbol, "Server parsed ticker");

        # Multiple round trips to test connection reuse
        for (int i = 0; i < 5; i++) {
            string ticker = "ROUND-TRIP-" + string(i);
            result = sc.callOperation("getInfo", {"tickerSymbol": ticker});
            assertEq(ticker, result.docs, "Round-trip " + string(i));
        }
    }

    #########################################################################
    # SOAP Version Detection Tests
    #########################################################################

    # Test that SOAP 1.1 envelope is correctly detected even when SOAP 1.2 namespace
    # is declared (but not used for the Envelope element)
    soap11WithSoap12DeclaredTest() {
        hash<auto> result = sendMessage(Soap11WithSoap12Declared, "SOAP11-WITH-12-DECL");
        assertEq(200, result.status, "SOAP 1.1 with SOAP 1.2 declared accepted");
        assertEq("SOAP11-WITH-12-DECL", result.parsed_ticker, "Ticker parsed correctly");
        # Verify response uses SOAP 1.1 envelope (not SOAP 1.2)
        assertTrue(result.response =~ /schemas\.xmlsoap\.org\/soap\/envelope/,
                   "Response uses SOAP 1.1 envelope");
    }

    # Test that SOAP 1.2 envelope is correctly detected even when SOAP 1.1 namespace
    # is declared (but not used for the Envelope element)
    soap12WithSoap11DeclaredTest() {
        hash<auto> result = sendMessage(Soap12WithSoap11Declared, "SOAP12-WITH-11-DECL");
        assertEq(200, result.status, "SOAP 1.2 with SOAP 1.1 declared accepted");
        assertEq("SOAP12-WITH-11-DECL", result.parsed_ticker, "Ticker parsed correctly");
        # Verify response uses SOAP 1.2 envelope (not SOAP 1.1)
        assertTrue(result.response =~ /www\.w3\.org\/2003\/05\/soap-envelope/,
                   "Response uses SOAP 1.2 envelope");
    }

    # Test SOAP 1.1 with short "s" prefix (Microsoft style)
    soap11ShortPrefixTest() {
        hash<auto> result = sendMessage(Soap11ShortPrefix, "S-PREFIX-11");
        assertEq(200, result.status, "SOAP 1.1 with 's' prefix accepted");
        assertEq("S-PREFIX-11", result.parsed_ticker, "Ticker parsed correctly");
        # Verify response uses SOAP 1.1 envelope
        assertTrue(result.response =~ /schemas\.xmlsoap\.org\/soap\/envelope/,
                   "Response uses SOAP 1.1 envelope");
    }

    # Test SOAP 1.2 with short "s" prefix
    soap12ShortPrefixTest() {
        hash<auto> result = sendMessage(Soap12ShortPrefix, "S-PREFIX-12");
        assertEq(200, result.status, "SOAP 1.2 with 's' prefix accepted");
        assertEq("S-PREFIX-12", result.parsed_ticker, "Ticker parsed correctly");
        # Verify response uses SOAP 1.2 envelope
        assertTrue(result.response =~ /www\.w3\.org\/2003\/05\/soap-envelope/,
                   "Response uses SOAP 1.2 envelope");
    }

    # Test SOAP 1.1 with default namespace (no prefix)
    soap11DefaultNsTest() {
        hash<auto> result = sendMessage(Soap11DefaultNs, "SOAP11-DEFAULT-NS");
        assertEq(200, result.status, "SOAP 1.1 default namespace accepted");
        assertEq("SOAP11-DEFAULT-NS", result.parsed_ticker, "Ticker parsed correctly");
        # Verify response uses SOAP 1.1 envelope
        assertTrue(result.response =~ /schemas\.xmlsoap\.org\/soap\/envelope/,
                   "Response uses SOAP 1.1 envelope");
    }

    # Negative test: Invalid/unsupported SOAP envelope namespace should be rejected
    invalidEnvelopeNsTest() {
        hash<auto> result = sendMessage(InvalidEnvelopeNs, "INVALID-NS");
        # Should return error status (500 for SOAP fault)
        assertTrue(result.status >= 400 && result.status < 600,
                   "Invalid envelope namespace rejected with error status: " + string(result.status));
        # Should contain fault message about unsupported envelope
        assertTrue(result.response =~ /unsupported SOAP envelope/i
                   || result.response =~ /Fault/,
                   "Error response contains fault information");
    }
}
