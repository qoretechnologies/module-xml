#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class WildcardElementValuesTest

class WildcardElementValuesTest inherits QUnit::Test {
    constructor() : Test("Retained wildcard XML values", "1.0") {
        addTestCase("Retained wildcard children preserve comments, CDATA and order", \retained());
        addTestCase("Scalar native fields remain compatible; XML values retain QName context", \scalar());
        addTestCase("Retained children carry inherited XML context and reject incompatible siblings", \xmlContext());
        addTestCase("Invalid XML carriers and native names are rejected with serialization errors", \invalid());
        set_return_value(main());
    }
    private XsdSchema makeSchema(string process = "skip") {
        return new XsdSchema('<xs:schema xmlns:xs="' + XSD_NS + '">'
            '<xs:element name="category" type="xs:QName"/>'
            '<xs:element name="root"><xs:complexType><xs:sequence>'
            '<xs:any processContents="' + process + '" minOccurs="1" maxOccurs="unbounded"/>'
            '</xs:sequence><xs:anyAttribute processContents="lax"/></xs:complexType></xs:element></xs:schema>');
    }
    private string encode(XsdSchema schema, auto value) {
        return schema.serializeXmlValue("", "root", value).getXml();
    }
    private retained() {
        XsdSchema schema = makeSchema();
        string child = '<p:item xmlns:p="urn:partner" xmlns:q="urn:values">a<!--between-->'
            '<![CDATA[q:Stock]]><p:part>007</p:part>b<p:part>008</p:part>c</p:item>';
        XsdXmlValue retained(child);
        string output = encode(schema, {"{urn:partner}item":retained});
        assertTrue(output.find('<!--between-->') >= 0);
        assertTrue(output.find('<![CDATA[q:Stock]]>') >= 0);
        XsdXmlValue root(output);
        assertEq(1, root.getChildValues().size());
        XsdXmlValue received = root.getChildValues()[0];
        assertEq("urn:partner", received.getNamespaceUri());
        assertEq("item", received.getLocalName());
        assertEq("{urn:values}Stock", received.resolveQName("q:Stock"));
        auto values = XsdBase::expandElementNamespaces(received.getXmlDataView())."{urn:partner}item";
        assertEq("007", values."{urn:partner}part"."^value^");
        assertEq("008", values."{urn:partner}part^1"."^value^");
        assertEq("b", values."^value1^");
        assertEq("c", values."^value2^");
    }
    private scalar() {
        XsdSchema schema = makeSchema("strict");
        string input = '<root xmlns:p="urn:products"><category>p:Stock</category></root>';
        auto expanded = XsdBase::expandElementNamespaces(parse_xml(input, XPF_PRESERVE_ORDER));
        auto native = schema.getElement("", "root").deserializeValue(schema.getTypeMap(), NOTHING, expanded."{}root", True);
        assertEq("p:Stock", native."{}category");
        XsdXmlValue complete = schema.getXmlValue(input);
        assertEq(input, complete.getXml());
        XsdXmlValue child = complete.getChildValues()[0];
        string output = encode(schema, {"{}category":child});
        XsdXmlValue received(output);
        assertEq("{urn:products}Stock", received.getChildValues()[0].resolveQName("p:Stock"));
        XsdXmlValue empty('<root xmlns="" xmlns:p="urn:products"><category>Stock</category></root>');
        assertEq("{}Stock", empty.getChildValues()[0].resolveQName("Stock"));
        schema.validateXmlValue(empty);
    }
    private xmlContext() {
        XsdSchema schema = makeSchema();
        XsdXmlValue parent('<source xml:lang="cs" xml:space="preserve" xml:base="https://example.invalid/base/">'
            '<p:item xmlns:p="urn:partner"> text </p:item></source>');
        XsdXmlValue child = parent.getChildValues()[0];
        string output = encode(schema, {"{urn:partner}item":child});
        XsdXmlValue received(output);
        assertEq("cs", received.getChildValues()[0].getInheritedXmlAttributes()."xml:lang");
        assertEq("preserve", received.getChildValues()[0].getInheritedXmlAttributes()."xml:space");
        assertEq("https://example.invalid/base/", received.getChildValues()[0].getInheritedXmlAttributes()."xml:base");
        XsdXmlValue different('<p:item xmlns:p="urn:partner">text</p:item>', {"xml:lang":"en"});
        assertThrows("SOAP-SERIALIZATION-ERROR", \encode(), (schema, {"{urn:partner}item":(child,different)}));
    }
    private invalid() {
        XsdSchema schema = makeSchema();
        foreach string xml in ('<!DOCTYPE item><item/>', '<item><?test value?></item>') {
            XsdXmlValue child(xml);
            assertThrows("SOAP-SERIALIZATION-ERROR", \encode(), (schema, {"{}item":child}));
        }
        foreach string name in ("unbound:child", "{urn:test}bad:name", "{urn:test}", "^value^") {
            assertThrows("SOAP-SERIALIZATION-ERROR", \encode(), (schema, {name:"content"}));
        }
        XsdXmlValue valid('<item>text</item>');
        assertTrue(encode(schema, {"{}item":valid}).find('text') >= 0);
        XsdXmlValue unbound('<item>xsd:Stock</item>');
        XsdXmlValue output(encode(schema, {"{}item":unbound}));
        XsdXmlValue child = output.getChildValues()[0];
        assertThrows("WSDL-NAMESPACE-ERROR", \child.resolveQName(), ("xsd:Stock",));
    }
}
