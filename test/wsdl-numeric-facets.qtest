#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class NumericFacetsTest

class NumericFacetsTest inherits QUnit::Test {
    constructor() : Test("Exact XSD numeric facets", "1.0") {
        addTestCase("Exact inclusive and exclusive decimal bounds", \bounds());
        addTestCase("Arbitrary integer and underflow bounds", \extremes());
        addTestCase("Digits constrain values and native round-trip spellings", \digits());
        addTestCase("Numeric enumerations compare values", \enumerations());
        addTestCase("Providers retain restrictions after reconstruction", \providers());
        addTestCase("Numeric examples satisfy exact bounds and digit grids", \samples());
        addTestCase("Numeric patterns retain authored lexical forms", \patterns());
        addTestCase("Provider facet metadata is validated", \metadata());
        addTestCase("Field enumeration uses values across records and repeated elements", \fields());
        addTestCase("Field choice updates validate atomically and retain metadata", \fieldUpdates());
        set_return_value(main());
    }

    private static XsdSchema schema(string base, string facets) {
        return new XsdSchema('<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:facets"
            targetNamespace="urn:facets"><xs:simpleType name="Amount"><xs:restriction base="xs:' + base + '">'
            + facets + '</xs:restriction></xs:simpleType></xs:schema>', {"async_only": True});
    }

    private check(string base, string facets, list<auto> valid, list<auto> invalid) {
        XsdSchema original = schema(base, facets);
        foreach XsdSchema definition in (original, Serializable::deserialize(original.serialize())) {
            XsdAbstractType type = definition.findType(make_qname("urn:facets", "Amount"));
            Namespaces nsc({});
            foreach auto value in (valid) {
                auto decoded = type.deserializeValue("value", definition.getTypeMap(), NOTHING, value);
                auto output = type.serializeValue(nsc, value, True);
                assertEq(decoded, type.deserializeValue("value", definition.getTypeMap(), NOTHING, output));
                assertEq(decoded, type.deserializeValue("value", definition.getTypeMap(), NOTHING,
                    type.serializeValue(nsc, decoded, True)));
            }
            foreach auto value in (invalid) {
                assertThrows("SOAP-SERIALIZATION-ERROR", \type.serializeValue(), (nsc, value, True));
                assertThrows("SOAP-DESERIALIZATION-ERROR", \type.deserializeValue(),
                    ("value", definition.getTypeMap(), NOTHING, value));
            }
        }
    }

    private bounds() {
        check("decimal", '<xs:minInclusive value="1.00000000000000000001"/>',
            ("1.00000000000000000001", "1.00000000000000000002"), ("1", "1.00000000000000000000"));
        check("decimal", '<xs:maxInclusive value="1.00000000000000000001"/>',
            ("1", "1.00000000000000000001"), ("1.00000000000000000002",));
        check("decimal", '<xs:minExclusive value="1.00000000000000000001"/>',
            ("1.00000000000000000002",), ("1", "1.00000000000000000001"));
        check("decimal", '<xs:maxExclusive value="1.00000000000000000001"/>',
            ("1",), ("1.00000000000000000001", "1.00000000000000000002"));
        check("decimal", '<xs:minInclusive value="-001.2300"/><xs:maxInclusive value="-1.2299"/>',
            ("-1.23", "-001.2300", "-1.2299"), ("-1.2301", "-1.2298", "0"));
    }

    private extremes() {
        check("integer", '<xs:minInclusive value="9223372036854775808123"/>
            <xs:maxExclusive value="9223372036854775808125"/>',
            ("9223372036854775808123", "+009223372036854775808124"),
            ("9223372036854775808122", "9223372036854775808125"));
        string tiny = "0." + strmul("0", 400) + "1";
        check("decimal", '<xs:minInclusive value="-0.00"/>', ("0", "-0.0", tiny), ("-" + tiny,));
        check("decimal", '<xs:maxInclusive value="+0"/>', ("0", "-0", "-" + tiny), (tiny,));
        string huge = strmul("9", 2000);
        check("integer", '<xs:minExclusive value="' + huge + '"/>',
            ("1" + strmul("0", 2000),), (huge,));
    }

    private digits() {
        check("decimal", '<xs:totalDigits value="4"/><xs:fractionDigits value="4"/>',
            ("0.0012", "+000.001200", "12.3400", "0.0000"), ("0.00001", "12345", "1.2345"));
        check("decimal", '<xs:totalDigits value="2"/>',
            (".12", "0012.00", "-0.00"), ("0.0012", "1.234"));
        check("decimal", '<xs:totalDigits value="10"/>',
            ("1.23456789",), (1.2345678901234567, number("1.00000000000000000001")));
        check("decimal", '<xs:fractionDigits value="5"/>',
            ("1.00000", "1.23456", 123.45n), (number("1.00000000000000000001"), 1.2345678901234567));
    }

    private enumerations() {
        check("decimal", '<xs:enumeration value="+001.2300"/><xs:enumeration value="-0.00"/>',
            ("1.23", "+001.2300", 1.23n, "-0", "+0.0", 0), ("1.23000000000000000001", "-1.23"));
        check("integer", '<xs:enumeration value="+0009"/><xs:enumeration value="18446744073709551615"/>',
            (9, "+009", "18446744073709551615"), ("8", "18446744073709551614"));
    }

    private providers() {
        XsdSchema definition = schema("decimal", '<xs:minInclusive value="1.00000000000000000001"/>
            <xs:maxInclusive value="1.00000000000000000003"/><xs:totalDigits value="21"/>');
        AbstractDataProviderType original = definition.findType(make_qname("urn:facets", "Amount")).getDataProviderType();
        foreach AbstractDataProviderType type in (original, Serializable::deserialize(original.serialize()),
                original.getOrNothingType().getMandatoryType()) {
            assertEq("1.00000000000000000002", type.acceptsValue("1.00000000000000000002"));
            assertThrows("RUNTIME-TYPE-ERROR", \type.acceptsValue(), "1");
            assertThrows("RUNTIME-TYPE-ERROR", \type.acceptsValue(), "1.00000000000000000004");
            assertThrows("MISSING-VALUE-ERROR", \type.acceptsValue(), (NOTHING,));
            AbstractDataProviderType optional = Serializable::deserialize(type.getOrNothingType().serialize());
            assertEq(NOTHING, optional.acceptsValue(NOTHING));
            assertThrows("RUNTIME-TYPE-ERROR", \optional.acceptsValue(), "1");
            ListDataType list_type("amounts", type);
            assertEq(("1.00000000000000000002",), list_type.acceptsValue(("1.00000000000000000002",)));
            assertThrows("RUNTIME-TYPE-ERROR", \list_type.acceptsValue(), (("1.00000000000000000002", "1"),));
        }
    }

    private samples() {
        string prefix = "1." + strmul("0", 79);
        foreach hash<auto> item in (
                {"base": "decimal", "facets": '<xs:minExclusive value="' + prefix + '1"/>
                    <xs:maxExclusive value="' + prefix + '3"/>'},
                {"base": "decimal", "facets": '<xs:minExclusive value="0.099"/>
                    <xs:maxInclusive value="0.2"/><xs:totalDigits value="1"/>'},
                {"base": "decimal", "facets": '<xs:minExclusive value="9.99"/>
                    <xs:maxInclusive value="10.01"/><xs:totalDigits value="2"/>'},
                {"base": "decimal", "facets": '<xs:minInclusive value="-' + prefix + '3"/>
                    <xs:maxExclusive value="-' + prefix + '1"/>'},
                {"base": "positiveInteger", "facets": '<xs:totalDigits value="1"/>'}) {
            XsdSchema definition = schema(item.base, item.facets);
            XsdSimpleType type = cast<XsdSimpleType>(definition.findType(make_qname("urn:facets", "Amount")));
            auto value = type.getSampleValue(123.456);
            Namespaces nsc({});
            auto serialized = type.serializeValue(nsc, value, True);
            assertEq(type.deserializeValue("value", definition.getTypeMap(), NOTHING, serialized),
                type.getDataProviderType().acceptsValue(value));
        }
        XsdSchema empty = schema("integer", '<xs:minExclusive value="0"/><xs:maxExclusive value="1"/>');
        XsdSimpleType type = cast<XsdSimpleType>(empty.findType(make_qname("urn:facets", "Amount")));
        assertThrows("XSD-SAMPLE-ERROR", \type.getSampleValue(), 123);
    }

    private patterns() {
        check("integer", '<xs:pattern value="00[0-9]"/><xs:maxInclusive value="9"/>',
            ("009", "001"), (9, "09", "010"));
        check("int", '<xs:pattern value="00[0-9]"/><xs:maxInclusive value="9"/>',
            ("009", "001"), (9, "09", "010"));
        check("decimal", '<xs:pattern value="[0-9]+[.][0-9]{3}"/>',
            ("123.450", "001.230"), (123.45, "123.45"));
        XsdSchema definition = schema("integer", '<xs:pattern value="00[0-9]"/><xs:enumeration value="+0009"/>');
        XsdSimpleType type = cast<XsdSimpleType>(definition.findType(make_qname("urn:facets", "Amount")));
        AbstractDataProviderType provider = Serializable::deserialize(type.getDataProviderType().serialize());
        assertEq("009", provider.acceptsValue("009"));
        assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), "9");
        assertEq("009", type.getSampleValue("009"));
        assertThrows("XSD-SAMPLE-ERROR", \type.getSampleValue(), 123);
        assertEq(NT_STRING, provider.getBaseTypeCode());
        assertEq("string", provider.getBaseTypeName());
        assertEq({"string": True}, provider.getReturnTypeHash());
        assertEq({"string": True, "nothing": True}, provider.getOrNothingType().getReturnTypeHash());
    }

    private static AbstractDataProviderType fromFacets(hash<XsdNumericFacetInfo> facets) {
        return new XsdNumericRestrictionDataType(facets, new XsdDecimalDataType());
    }

    private metadata() {
        hash<XsdNumericFacetInfo> valid = <XsdNumericFacetInfo>{
            "name": "Amount", "base_name": "decimal", "bounds": {"minInclusive": "1.23"},
            "total_digits": 3, "fraction_digits": 2,
        };
        assertEq(1.23, fromFacets(valid).acceptsValue("1.23"));
        foreach hash<auto> change in (
                {"base_name": "string"}, {"bounds": {"minimum": "0"}},
                {"bounds": {"minInclusive": "NaN"}}, {"total_digits": 0}, {"fraction_digits": -1},
                {"fraction_digits": 4}, {"enumeration": ("1e2",)}, {"patterns": ("[",)}) {
            hash<XsdNumericFacetInfo> invalid = new hash<XsdNumericFacetInfo>(valid + change);
            assertThrows("XSD-SIMPLETYPE-ERROR", \fromFacets(), invalid);
        }
    }

    private fields() {
        XsdSchema definition('<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:facets"
            targetNamespace="urn:facets">
            <xs:simpleType name="Base"><xs:restriction base="xs:int">
                <xs:pattern value="00[0-9]"/></xs:restriction></xs:simpleType>
            <xs:simpleType name="Amount"><xs:restriction base="t:Base">
                <xs:minInclusive value="001"/><xs:enumeration value="009"/></xs:restriction></xs:simpleType>
            <xs:complexType name="Record"><xs:sequence>
                <xs:element name="single" type="t:Amount"/>
                <xs:element name="repeated" type="t:Amount" maxOccurs="3"/>
                <xs:element name="optional" type="t:Amount" minOccurs="0"/>
            </xs:sequence><xs:attribute name="fixed" type="xs:decimal" fixed="+001.2300" use="required"/>
                <xs:attribute name="optional" type="xs:decimal" fixed="-0.0"/>
            </xs:complexType></xs:schema>', {"async_only": True});
        AbstractDataProviderType original = definition.findType(make_qname("urn:facets", "Record")).getDataProviderType();
        foreach AbstractDataProviderType provider in (original, Serializable::deserialize(original.serialize())) {
            hash<auto> input = {"single": "009", "repeated": ("009", "009"), "^attributes^": {"fixed": "1.23"}};
            hash<auto> result = provider.acceptsValue(input);
            assertEq("009", result.single);
            assertEq(("009", "009"), result.repeated);
            assertEq(1.23, result."^attributes^".fixed);
            assertEq(NOTHING, result.optional);
            assertEq(NOTHING, provider.getFields().optional.acceptsValue(NOTHING));
            AbstractDataField repeated = provider.getFields().repeated;
            assertEq((<AllowedValueInfo>{"value": "009", "display_name": "009"},), repeated.getElementAllowedValues());
            foreach hash<auto> change in ({"single": "008"}, {"single": "9"},
                    {"repeated": ("009", "008")}, {"repeated": ("009", "9")},
                    {"^attributes^": {"fixed": "1.23000000000000000001"}}) {
                assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (input + change,));
            }
            AbstractDataField fixed = provider.getFields()."^attributes^".getType().getFields().fixed;
            assertEq("+001.2300", fixed.getAllowedValues()[0].value);
            assertEq("+001.2300", fixed.acceptsValue("+001.2300"));
            assertThrows("MISSING-VALUE-ERROR", \fixed.acceptsValue(), (NOTHING,));
            AbstractDataField optional = provider.getFields()."^attributes^".getType().getFields().optional;
            assertEq("-0.0", optional.acceptsValue(NOTHING));
            assertEq("+0.00", optional.acceptsValue("+0.00"));
        }
    }

    private fieldUpdates() {
        XsdNumericDataField field({"name": "amount", "type": new XsdDecimalDataType()}, "decimal");
        field.setAllowedValues(("+001.2300",), False);
        assertEq(1.23, field.acceptsValue("1.23"));
        assertEq("+001.2300", field.getAllowedValues()[0].value);
        assertThrows("FIELD-VALUE-ERROR", \field.acceptsValue(), "2");
        assertThrows("XSD-SIMPLETYPE-ERROR", \field.setAllowedValues(), (("2", "NaN"), False));
        assertEq("+001.2300", field.getAllowedValues()[0].value);
        assertThrows("FIELD-VALUE-ERROR", \field.acceptsValue(), "2");
        field.setAllowedValues(("1.23",), True);
        assertEq(2.0, field.acceptsValue("2"));
        field.setAllowedValues((), False);
        assertEq(3.0, field.acceptsValue("3"));
        XsdNumericDataField repeated({"name": "amounts", "type": new ListDataType(new XsdDecimalDataType())},
            "decimal");
        repeated.setElementAllowedValues(("+001.2300", "-0.00"), False);
        assertEq((1.23, "+0.00"), repeated.acceptsValue(("1.23", "+0.00")));
        assertThrows("FIELD-VALUE-ERROR", \repeated.acceptsValue(), (("1.23", "2"),));
        assertThrows("XSD-SIMPLETYPE-ERROR", \repeated.setElementAllowedValues(), (("2", "1e2"), False));
        assertThrows("FIELD-VALUE-ERROR", \repeated.acceptsValue(), (("1.23", "2"),));
        repeated.setElementAllowedValues(("1.23",), True);
        assertEq((2.0,), repeated.acceptsValue(("2",)));
        repeated.setElementAllowedValues((), False);
        assertEq((3.0,), repeated.acceptsValue(("3",)));
    }
}
