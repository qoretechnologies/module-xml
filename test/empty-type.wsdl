<?xml version="1.0" encoding="UTF-8"?>
<!-- WSDL for testing elements declaring a complexType with empty content (issue 5465) -->
<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:xs="http://www.w3.org/2001/XMLSchema"
             xmlns:tns="urn:qore:test:empty-type"
             targetNamespace="urn:qore:test:empty-type">
    <types>
        <xs:schema targetNamespace="urn:qore:test:empty-type"
                   xmlns="urn:qore:test:empty-type" elementFormDefault="qualified">
            <!-- a complexType with no content model at all -->
            <xs:complexType name="empty-element-type"/>
            <!-- the same, declared with an annotation only -->
            <xs:complexType name="documented-empty-type">
                <xs:annotation>
                    <xs:documentation xml:lang="en">An element with empty content.</xs:documentation>
                </xs:annotation>
            </xs:complexType>
            <!-- empty content, but with an attribute -->
            <xs:complexType name="empty-attr-type">
                <xs:attribute name="id" type="xs:string"/>
            </xs:complexType>

            <xs:element name="Req">
                <xs:complexType>
                    <xs:sequence>
                        <!-- the element's presence is what carries the information -->
                        <xs:element name="default-subscription" type="empty-element-type" minOccurs="0"
                                    nillable="true"/>
                        <xs:element name="documented" type="documented-empty-type" minOccurs="0"/>
                        <xs:element name="with-attr" type="empty-attr-type" minOccurs="0"/>
                        <xs:element name="msisdn" type="xs:string" minOccurs="0"/>
                        <!-- a required element of an empty type is always serialized -->
                        <xs:element name="units" type="empty-element-type"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="Resp" type="xs:string"/>
        </xs:schema>
    </types>

    <message name="ReqM"><part name="parameters" element="tns:Req"/></message>
    <message name="RespM"><part name="parameters" element="tns:Resp"/></message>

    <portType name="EmptyTypePort">
        <operation name="Op">
            <input message="tns:ReqM"/>
            <output message="tns:RespM"/>
        </operation>
    </portType>

    <binding name="EmptyTypeBinding" type="tns:EmptyTypePort">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <operation name="Op">
            <soap:operation soapAction="Op" style="document"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>
    </binding>

    <service name="EmptyTypeService">
        <port name="EmptyTypePort" binding="tns:EmptyTypeBinding">
            <soap:address location="http://localhost:8080/empty-type"/>
        </port>
    </service>
</definitions>
