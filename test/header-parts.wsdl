<!-- WSDL for testing messages whose parts are split between the SOAP header and the SOAP body -->
<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:xs="http://www.w3.org/2001/XMLSchema"
             xmlns:tns="urn:qore:test:header-parts"
             targetNamespace="urn:qore:test:header-parts">
    <types>
        <xs:schema targetNamespace="urn:qore:test:header-parts"
                   xmlns="urn:qore:test:header-parts" elementFormDefault="qualified">
            <xs:element name="SessionId" type="xs:string"/>
            <xs:element name="Req">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="a" type="xs:string"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="Value" type="xs:string"/>
            <!-- has a child element with the same name as the header message "HdrM" -->
            <xs:element name="RespHdrConflict">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="HdrM" type="xs:string"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <!-- has a child element with the same name as the message "CollM" and its part -->
            <xs:element name="RespMsgConflict">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="CollM" type="xs:string"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="Resp">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="r" type="xs:string"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:schema>
    </types>

    <!-- the request message carries both the header part and the body part -->
    <message name="ReqM">
        <part name="SessionId" element="tns:SessionId"/>
        <part name="parameters" element="tns:Req"/>
    </message>
    <message name="RespM">
        <part name="parameters" element="tns:Resp"/>
    </message>

    <!-- the body part has the same name as the message, which also carries the header part -->
    <message name="SameNameM">
        <part name="SameNameM" element="tns:Resp"/>
        <part name="SessionId" element="tns:SessionId"/>
    </message>
    <message name="HdrM">
        <part name="SessionId" element="tns:SessionId"/>
    </message>
    <message name="HdrConflictM">
        <part name="parameters" element="tns:RespHdrConflict"/>
    </message>
    <message name="PartConflictM">
        <part name="HdrM" element="tns:Resp"/>
        <part name="other" element="tns:Value"/>
    </message>
    <message name="CollM">
        <part name="CollM" element="tns:RespMsgConflict"/>
        <part name="SessionId" element="tns:SessionId"/>
    </message>
    <message name="ScalarM">
        <part name="parameters" element="tns:Value"/>
        <part name="SessionId" element="tns:SessionId"/>
    </message>

    <portType name="HeaderPartsPort">
        <!-- the soap:body element names the body parts explicitly -->
        <operation name="OpExplicit">
            <input message="tns:ReqM"/>
            <output message="tns:RespM"/>
        </operation>
        <!-- omitted soap:body parts selects every message part, including the header-bound SessionId -->
        <operation name="OpImplicit">
            <input message="tns:ReqM"/>
            <output message="tns:RespM"/>
        </operation>
        <operation name="OpSameName">
            <input message="tns:ReqM"/>
            <output message="tns:SameNameM"/>
        </operation>
        <operation name="OpHdrConflict">
            <input message="tns:ReqM"/>
            <output message="tns:HdrConflictM"/>
        </operation>
        <operation name="OpPartConflict">
            <input message="tns:ReqM"/>
            <output message="tns:PartConflictM"/>
        </operation>
        <operation name="OpMsgConflict">
            <input message="tns:ReqM"/>
            <output message="tns:CollM"/>
        </operation>
        <operation name="OpScalar">
            <input message="tns:ReqM"/>
            <output message="tns:ScalarM"/>
        </operation>
    </portType>

    <binding name="HeaderPartsBinding" type="tns:HeaderPartsPort">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <operation name="OpExplicit">
            <soap:operation soapAction="urn:OpExplicit" style="document"/>
            <input>
                <soap:body use="literal" parts="parameters"/>
                <soap:header message="tns:ReqM" part="SessionId" use="literal"/>
            </input>
            <output>
                <soap:body use="literal"/>
            </output>
        </operation>
        <operation name="OpImplicit">
            <soap:operation soapAction="urn:OpImplicit" style="document"/>
            <input>
                <soap:body use="literal"/>
                <soap:header message="tns:ReqM" part="SessionId" use="literal"/>
            </input>
            <output>
                <soap:body use="literal"/>
            </output>
        </operation>
        <operation name="OpSameName">
            <soap:operation soapAction="urn:OpSameName" style="document"/>
            <input>
                <soap:body use="literal" parts="parameters"/>
                <soap:header message="tns:ReqM" part="SessionId" use="literal"/>
            </input>
            <output>
                <soap:body use="literal" parts="SameNameM"/>
                <soap:header message="tns:SameNameM" part="SessionId" use="literal"/>
            </output>
        </operation>
        <operation name="OpHdrConflict">
            <soap:operation soapAction="urn:OpHdrConflict" style="document"/>
            <input>
                <soap:body use="literal" parts="parameters"/>
                <soap:header message="tns:ReqM" part="SessionId" use="literal"/>
            </input>
            <output>
                <soap:body use="literal"/>
                <soap:header message="tns:HdrM" part="SessionId" use="literal"/>
            </output>
        </operation>
        <operation name="OpPartConflict">
            <soap:operation soapAction="urn:OpPartConflict" style="document"/>
            <input>
                <soap:body use="literal" parts="parameters"/>
                <soap:header message="tns:ReqM" part="SessionId" use="literal"/>
            </input>
            <output>
                <soap:body use="literal"/>
                <soap:header message="tns:HdrM" part="SessionId" use="literal"/>
            </output>
        </operation>
        <operation name="OpMsgConflict">
            <soap:operation soapAction="urn:OpMsgConflict" style="document"/>
            <input>
                <soap:body use="literal" parts="parameters"/>
                <soap:header message="tns:ReqM" part="SessionId" use="literal"/>
            </input>
            <output>
                <soap:body use="literal" parts="CollM"/>
                <soap:header message="tns:CollM" part="SessionId" use="literal"/>
            </output>
        </operation>
        <operation name="OpScalar">
            <soap:operation soapAction="urn:OpScalar" style="document"/>
            <input>
                <soap:body use="literal" parts="parameters"/>
                <soap:header message="tns:ReqM" part="SessionId" use="literal"/>
            </input>
            <output>
                <soap:body use="literal" parts="parameters"/>
                <soap:header message="tns:ScalarM" part="SessionId" use="literal"/>
            </output>
        </operation>
    </binding>

    <service name="HeaderPartsService">
        <port name="HeaderPartsPort" binding="tns:HeaderPartsBinding">
            <soap:address location="http://localhost:8080/header-parts"/>
        </port>
    </service>
</definitions>
