#
# Parsed by soap-message-limits.qtest into a sandboxed Program: each function requests an interrupt of its own
# program and then decodes, parses or loads, which must stop with PROGRAM-INTERRUPTED.

%modern
%requires xml
%requires ../qlib/WSDL.qm

# decodes a message within the given limits, optionally interrupting the program first
auto sub decode(SandboxManager manager, bool interrupt, WSOperation op, string xml, *hash<SoapMessageLimits> limits) {
    SoapMessageLimitsScope scope(limits);
    if (interrupt) {
        manager.requestInterrupt();
    }
    return op.deserializeRequest(parse_xml(xml, XPF_PRESERVE_ORDER));
}

# parses a multipart package, optionally interrupting the program first
hash<auto> sub multipart(SandboxManager manager, bool interrupt, hash<auto> message) {
    if (interrupt) {
        manager.requestInterrupt();
    }
    return WSDLLib::parseMultiPartSOAPMessage(message, False, True);
}

# loads a chain of six schemas, interrupting the program when the given one is requested
XsdSchema sub load(SandboxManager manager, int interrupt_at) {
    code document = string sub (string name) {
        int n = (name =~ x/^d([0-9]+)\.xsd$/)[0].toInt();
        if (n == interrupt_at) {
            manager.requestInterrupt();
        }
        string import = n < 5 ? sprintf('<import namespace="urn:d%d" schemaLocation="d%d.xsd"/>', n + 1, n + 1) : "";
        return sprintf('<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:d%d">%s'
            '<element name="e%d" type="string"/></schema>', n, import, n);
    };
    return new XsdSchema('<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:root">'
        '<import namespace="urn:d0" schemaLocation="d0.xsd"/></schema>', {"def_path": "/nonexistent-qore-test/",
        "try_import": document});
}
