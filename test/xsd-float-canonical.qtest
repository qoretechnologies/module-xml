#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%exec-class XsdFloatCanonicalTest

class XsdFloatCanonicalTest inherits QUnit::Test {
    constructor() : Test("Canonical XML Schema IEEE lexical API", "1.0") {
        addTestCase("Canonical scientific syntax and selected precision", \values());
        addTestCase("Invalid lexicals, embedded NULs, encoding and long input", \lexicals());
        addTestCase("Program interruption and recovery", \interruption());
        addTestCase("Concurrent canonical conversion has independent ownership", \concurrent());
        set_return_value(main());
    }
    private values() {
        foreach hash<auto> row in (
                {"source":"16777217", "narrow":"1.6777216E7", "wide":"1.6777217E7"},
                {"source":"0.1", "narrow":"1.0E-1", "wide":"1.0E-1"},
                {"source":"1.2345678901234567", "narrow":"1.2345679E0", "wide":"1.2345678901234567E0"},
                {"source":"1e-45", "narrow":"1.0E-45", "wide":"1.0E-45"},
                {"source":"5e-324", "narrow":"0.0E0", "wide":"5.0E-324"},
                {"source":"+000.000", "narrow":"0.0E0", "wide":"0.0E0"},
                {"source":"-0", "narrow":"0.0E0", "wide":"0.0E0"},
                {"source":"NaN", "narrow":"NaN", "wide":"NaN"},
                {"source":"INF", "narrow":"INF", "wide":"INF"},
                {"source":"-INF", "narrow":"-INF", "wide":"-INF"},
                {"source":"1e999999999999999999999", "narrow":"INF", "wide":"INF"},
                {"source":"-1e-999999999999999999999", "narrow":"0.0E0", "wide":"0.0E0"}) {
            foreach bool wide in (False, True) {
                string expected = wide ? row.wide : row.narrow;
                assertEq(expected, canonical_xsd_float(row.source, wide));
                assertEq(expected, canonical_xsd_float(" \t" + row.source + "\r\n", wide));
                assertEq(expected, canonical_xsd_float(expected, wide));
                float value = convert_xsd_float(expected, wide);
                if (expected == "NaN") {
                    assertTrue(value != value);
                } else {
                    assertEq(convert_xsd_float(row.source, wide), value);
                }
            }
        }
    }
    private lexicals() {
        foreach bool wide in (False, True) {
            foreach string text in ("", " \t", "1e", "1e+", "1e-", "+INF", "-NaN", "nan", "inf",
                    "1\x00", "\x001", "1\x00tail", ".", "1tail", "1,2", "1 2", "0x1p0", "١", "１", "1\u00a0") {
                assertThrows("XSD-FLOAT-LEXICAL-ERROR", \canonical_xsd_float(), (text, wide));
                assertEq("1.25E0", canonical_xsd_float("1.25", wide));
            }
            assertEq("1.25E0", canonical_xsd_float(convert_encoding(" \t+1.25\r\n", "UTF-16LE"), wide));
            assertEq("1.0E0", canonical_xsd_float("1" + strmul("0", 5000) + "e-5000", wide));
            string small = "0." + strmul("0", 4999) + "1e5000";
            assertEq(5007, small.size());
            assertEq("1.0E0", canonical_xsd_float(small, wide));
            assertEq("0.0E0", canonical_xsd_float("0e" + strmul("9", 5000), wide));
            assertThrows("XSD-FLOAT-LEXICAL-ERROR", \canonical_xsd_float(), ("1" + strmul("0", 5000) + "x", wide));
        }
    }
    private interruption() {
        SandboxManager manager();
        on_exit {
            manager.clearInterrupt();
        }
        Program program();
        program.setSandboxManager(manager);
        program.parse("%modern\n%requires xml\n"
            "string sub convert(SandboxManager manager, bool cancel) {\n"
            "    if (cancel) { manager.requestInterrupt(); }\n"
            "    return canonical_xsd_float(\"16777217\");\n"
            "}\n", get_script_dir() + "/canonical-ieee-interruption.qr");
        *hash<ExceptionInfo> error;
        try {
            program.callFunction("convert", manager, True);
        } catch (hash<ExceptionInfo> ex) {
            error = ex;
        }
        manager.clearInterrupt();
        assertEq("PROGRAM-INTERRUPTED", error.err);
        assertEq("1.6777216E7", program.callFunction("convert", manager, False));
    }
    private concurrent() {
        Queue ready();
        Queue start();
        Queue results();
        ThreadPool workers(4, 4, 4);
        on_exit {
            for (int i = 0; i < 4; ++i) {
                start.push(True);
            }
            workers.stopWait();
        }
        for (int i = 0; i < 4; ++i) {
            workers.submit(sub() {
                try {
                    ready.push(True);
                    start.get(30s);
                    list<string> values();
                    for (int repeat = 0; repeat < 50; ++repeat) {
                        push values, canonical_xsd_float("16777217");
                        push values, canonical_xsd_float("1.2345678901234567", True);
                    }
                    results.push({"values":values});
                } catch (hash<ExceptionInfo> ex) {
                    results.push({"error":ex});
                }
            });
        }
        for (int i = 0; i < 4; ++i) {
            assertTrue(ready.get(30s));
        }
        for (int i = 0; i < 4; ++i) {
            start.push(True);
        }
        for (int i = 0; i < 4; ++i) {
            hash<auto> result = results.get(30s);
            assertFalse(exists result.error, result.error);
            list<string> values = result.values;
            assertEq(100, values.size());
            foreach string value in (values) {
                assertEq($# % 2 ? "1.2345678901234567E0" : "1.6777216E7", value);
            }
        }
    }
}
