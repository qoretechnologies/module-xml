#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

# In-module module under test (relative path so we test the local source, not
# any system-installed version)
%requires ../qlib/WebContentUtil

# Qore-shipped system modules (loaded from the standard Qore module path)
%requires Util
%requires Mime
%requires HttpUtil
%requires Logger
%requires AsyncSocketIo
%requires HttpClientIo
%requires HttpServerUtil
%requires HttpServer
%requires QUnit

%exec-class WebContentUtilTest

#! Static HTML site handler for crawler integration test
class StaticSiteHandler inherits AbstractHttpRequestHandler {
    public {
        #! Captured request headers from the most recent request, indexed by
        #! request path.  Used by tests that need to assert what headers the
        #! crawler sent (e.g. WebCrawler::headers option, auth credentials).
        hash<string, hash<auto>> captured_headers = {};

        #! Page bodies served by this handler, keyed by request path (after
        #! query stripping).  Public so tests can mutate it after the server
        #! is running (e.g. inject a sitemap.xml whose contents reference the
        #! actual listening port).
        hash<string, string> pages;
    }

    private {
        Mutex hdr_mutex();
    }

    constructor(hash<string, string> pages) {
        self.pages = pages;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        string path = hdr.path ?? "";
        if (path.find("?") >= 0) {
            path = path.substr(0, path.find("?"));
        }
        if (!path.val() || path == "/") {
            path = "index.html";
        }
        # Snapshot the request headers for later inspection by tests
        {
            hdr_mutex.lock();
            on_exit hdr_mutex.unlock();
            captured_headers{path} = hdr;
        }
        if (!exists pages{path}) {
            return makeResponse({"Content-Type": "text/plain"}, 404, "not found: " + path);
        }
        # Use text/xml for .xml paths so sitemap fetches get the right
        # content type — required by SitemapParser's XML parsing path
        string ctype = path =~ /\.xml$/
            ? "application/xml; charset=utf-8"
            : "text/html; charset=utf-8";
        return makeResponse({"Content-Type": ctype}, 200, pages{path});
    }
}

