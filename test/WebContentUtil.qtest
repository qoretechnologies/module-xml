    #
    # UrlNormalizer tests
    #

    testUrlNormalizerBasic() {
        assertEq("https://example.com/path",
            UrlNormalizer::normalize("https://example.com/path"));
        assertEq("http://example.com/",
            UrlNormalizer::normalize("http://example.com/"));
    }

    testUrlNormalizerFragment() {
        assertEq("https://example.com/path",
            UrlNormalizer::normalize("https://example.com/path#section"));
        assertEq("https://example.com/page",
            UrlNormalizer::normalize("https://example.com/page#anchor-with-dash"));
    }

    testUrlNormalizerPathResolution() {
        assertEq("https://example.com/b",
            UrlNormalizer::normalize("https://example.com/a/../b"));
        assertEq("https://example.com/a/b",
            UrlNormalizer::normalize("https://example.com/a/./b"));
        assertEq("https://example.com/c",
            UrlNormalizer::normalize("https://example.com/a/b/../../c"));
        # Cannot navigate above root
        assertEq("https://example.com/x",
            UrlNormalizer::normalize("https://example.com/../x"));
    }

    testUrlNormalizerTrailingSlash() {
        # Phase B: trailing slash is stripped on non-root paths per design §5.2
        assertEq("https://example.com/dir",
            UrlNormalizer::normalize("https://example.com/dir/"));
        assertEq("https://example.com/file",
            UrlNormalizer::normalize("https://example.com/file"));
        # Root path keeps the slash
        assertEq("https://example.com/",
            UrlNormalizer::normalize("https://example.com/"));
        # Opt-in to preserve trailing slash for directory-significant URLs
        assertEq("https://example.com/dir/",
            UrlNormalizer::normalize("https://example.com/dir/",
                {"preserve_trailing_slash": True}));
    }

    testUrlNormalizerLowercaseSchemeHost() {
        # Phase B: scheme and host are lowercased; path case is preserved
        assertEq("https://example.com/Path/CaseSensitive",
            UrlNormalizer::normalize("HTTPS://Example.COM/Path/CaseSensitive"));
        assertEq("http://docs.example.org/api",
            UrlNormalizer::normalize("HTTP://DOCS.EXAMPLE.ORG/api"));
    }

    testUrlNormalizerDefaultPorts() {
        # Phase B: strip default ports
        assertEq("http://example.com/",
            UrlNormalizer::normalize("http://example.com:80/"));
        assertEq("https://example.com/api",
            UrlNormalizer::normalize("https://example.com:443/api/"));
        # Non-default ports are preserved
        assertEq("http://example.com:8080/",
            UrlNormalizer::normalize("http://example.com:8080/"));
        assertEq("https://example.com:8443/api",
            UrlNormalizer::normalize("https://example.com:8443/api"));
    }

    testUrlNormalizerPercentEncoding() {
        # Phase B: decode unreserved percent-encodings (%41 = 'A')
        assertEq("https://example.com/ABC",
            UrlNormalizer::normalize("https://example.com/%41%42%43"));
        # Lowercase hex is also decoded
        assertEq("https://example.com/abc",
            UrlNormalizer::normalize("https://example.com/%61%62%63"));
        # Reserved characters stay encoded but hex case is canonicalized to upper
        assertEq("https://example.com/%2F%3F",
            UrlNormalizer::normalize("https://example.com/%2f%3f"));
        # Unreserved punctuation: hyphen, period, underscore, tilde
        assertEq("https://example.com/-._~",
            UrlNormalizer::normalize("https://example.com/%2D%2E%5F%7E"));
    }

    testUrlNormalizerQuerySort() {
        assertEq("https://example.com/path?a=1&b=2&c=3",
            UrlNormalizer::normalize("https://example.com/path?c=3&a=1&b=2"));
        assertEq("https://example.com/path?key1=val1&key2=val2",
            UrlNormalizer::normalize("https://example.com/path?key2=val2&key1=val1"));
    }

    testUrlNormalizerPort() {
        assertEq("https://example.com:8443/api",
            UrlNormalizer::normalize("https://example.com:8443/api"));
        assertEq("http://localhost:8080/",
            UrlNormalizer::normalize("http://localhost:8080/"));
    }

    #
    # HtmlExtractor tests
    #

    testHtmlExtractorBasic() {
        string html = "<html><body><p>Hello world</p></body></html>";
        string text = HtmlExtractor::extractText(html);
        assertEq("Hello world", text);
    }

    testHtmlExtractorStripElements() {
        string html = "<html><body>"
            "<script>alert('xss')</script>"
            "<style>body { color: red; }</style>"
            "<nav>Navigation</nav>"
            "<header>Header</header>"
            "<footer>Footer</footer>"
            "<p>Real content</p>"
            "</body></html>";
        string text = HtmlExtractor::extractText(html);
        assertEq(True, text.find("Real content") >= 0);
        assertEq(-1, text.find("alert"));
        assertEq(-1, text.find("color: red"));
        assertEq(-1, text.find("Navigation"));
        assertEq(-1, text.find("Header"));
        assertEq(-1, text.find("Footer"));
    }

    testHtmlExtractorBlockTags() {
        string html = "<p>Para 1</p><p>Para 2</p><div>Div content</div>";
        string text = HtmlExtractor::extractText(html);
        # Block elements should produce newlines
        assertEq(True, text.find("Para 1") >= 0);
        assertEq(True, text.find("Para 2") >= 0);
        assertEq(True, text.find("Div content") >= 0);
        # Should be on separate lines
        assertEq(True, text.find("\n") >= 0);
    }

    testHtmlExtractorEntities() {
        string html = "<p>AT&amp;T &lt;test&gt; &quot;quoted&quot;</p>";
        string text = HtmlExtractor::extractText(html);
        assertEq(True, text.find("AT&T") >= 0);
        assertEq(True, text.find("<test>") >= 0);
        assertEq(True, text.find("\"quoted\"") >= 0);
    }

    testHtmlExtractorExtraStrip() {
        string html = "<p>Keep this</p><aside>Skip this</aside><p>And this</p>";
        string text = HtmlExtractor::extractText(html, ("aside",));
        assertEq(True, text.find("Keep this") >= 0);
        assertEq(True, text.find("And this") >= 0);
        assertEq(-1, text.find("Skip this"));
    }

    testHtmlExtractorTitle() {
        string html = "<html><head><title>Page Title</title></head><body></body></html>";
        assertEq("Page Title", HtmlExtractor::extractTitle(html));
    }

    testHtmlExtractorMissingTitle() {
        string html = "<html><body>No title</body></html>";
        assertEq(NOTHING, HtmlExtractor::extractTitle(html));
    }

    testHtmlExtractorEmpty() {
        assertEq("", HtmlExtractor::extractText(""));
        assertEq(NOTHING, HtmlExtractor::extractTitle(""));
    }

    #
    # TextChunker tests
    #

    testTextChunkerBasic() {
        string text = "First paragraph.\n\nSecond paragraph.\n\nThird paragraph.";
        list<hash<auto>> chunks = TextChunker::chunk(text, "https://example.com/", "Test");
        assertEq(1, chunks.size());
        assertEq("https://example.com/", chunks[0].source_url);
        assertEq("Test", chunks[0].title);
        assertEq(0, chunks[0].chunk_index);
        assertEq(True, chunks[0].content.find("First paragraph") >= 0);
        assertEq(True, chunks[0].content.find("Third paragraph") >= 0);
    }

    testTextChunkerOversizedParagraph() {
        # Create text exceeding default target_chars (2048)
        string para = strmul("Sentence one. Sentence two. Sentence three. ", 100);
        list<hash<auto>> chunks = TextChunker::chunk(para, "https://example.com/", "Test");
        assertGt(1, chunks.size());
        # Verify chunk indices are sequential
        int idx = 0;
        foreach hash<auto> chunk in (chunks) {
            assertEq(idx++, chunk.chunk_index);
            assertEq("https://example.com/", chunk.source_url);
            assertEq("Test", chunk.title);
        }
    }

    testTextChunkerOverlap() {
        # Build text that requires multiple chunks via paragraph boundaries
        list<string> paras;
        for (int i = 0; i < 20; ++i) {
            paras += strmul("Word ", 60) + "end-of-para-" + i;
        }
        string text = paras.join("\n\n");
        list<hash<auto>> chunks = TextChunker::chunk(text, "https://example.com/", "Test", {
            "target_tokens": 256,
            "overlap_tokens": 25,
        });
        assertGt(1, chunks.size());
    }

    testTextChunkerEmpty() {
        list<hash<auto>> chunks = TextChunker::chunk("", "https://example.com/", "Test");
        assertEq(0, chunks.size());
    }

    testTextChunkerEstimateTokens() {
        # ~4 chars/token heuristic
        assertEq(0, TextChunker::estimateTokens(""));
        assertEq(1, TextChunker::estimateTokens("abcd"));
        assertEq(25, TextChunker::estimateTokens(strmul("a", 100)));
    }

    testTextChunkerCustomOptions() {
        # Build a text where 256-token target forces multiple chunks
        string text = strmul("Paragraph block. ", 200) + "\n\n"
            + strmul("Paragraph block. ", 200) + "\n\n"
            + strmul("Paragraph block. ", 200);
        list<hash<auto>> chunks = TextChunker::chunk(text, "https://example.com/", "Test", {
            "target_tokens": 256,
            "overlap_tokens": 25,
        });
        assertGt(1, chunks.size());
    }

    #
    # LocalDocReader tests
    #

    private {
        *string tmpdir;
    }

    private string createTempDir() {
        string dir = sprintf("%s/wcu-test-%d-%d", tmp_location(), getpid(), gettid());
        mkdir(dir);
        tmpdir = dir;
        return dir;
    }

    private writeHtml(string path, string title, string body) {
        File f();
        f.open2(path, O_CREAT | O_WRONLY | O_TRUNC);
        f.write(sprintf("<html><head><title>%s</title></head><body>%s</body></html>",
            title, body));
        f.close();
    }

    private cleanup() {
        if (tmpdir) {
            removeTree(tmpdir);
            remove tmpdir;
        }
    }

    private removeTree(string dir) {
        Dir d();
        if (!d.chdir(dir)) {
            return;
        }
        *list<string> files = d.listFiles();
        if (files) {
            foreach string f in (files) {
                unlink(dir + "/" + f);
            }
        }
        *list<string> subdirs = d.listDirs();
        if (subdirs) {
            foreach string sd in (subdirs) {
                removeTree(dir + "/" + sd);
            }
        }
        rmdir(dir);
    }

    testLocalDocReaderBasic() {
        string dir = createTempDir();
        on_exit cleanup();
        writeHtml(dir + "/page1.html", "Page One",
            "<p>" + strmul("This is the first page content. ", 5) + "</p>");
        writeHtml(dir + "/page2.html", "Page Two",
            "<p>" + strmul("This is the second page content. ", 5) + "</p>");

        list<hash<auto>> pages = LocalDocReader::read(dir);
        assertEq(2, pages.size());

        # Sort by url for stable comparison
        list<hash<auto>> sorted_pages = sort(pages, int sub (hash<auto> a, hash<auto> b) {
            return a.url <=> b.url;
        });
        assertEq("Page One", sorted_pages[0].title);
        assertEq("Page Two", sorted_pages[1].title);
        assertEq(0, sorted_pages[0].url.find("file://"));
        assertEq(True, sorted_pages[0].content.find("first page content") >= 0);
    }

    testLocalDocReaderSkipDir() {
        string dir = createTempDir();
        on_exit cleanup();
        writeHtml(dir + "/keep.html", "Keep",
            "<p>" + strmul("Content to keep. ", 5) + "</p>");
        mkdir(dir + "/skipme");
        writeHtml(dir + "/skipme/skipped.html", "Skipped",
            "<p>" + strmul("Content to skip. ", 5) + "</p>");

        list<hash<auto>> pages = LocalDocReader::read(dir, {
            "skip_dir": bool sub (string dirname) {
                return dirname == "skipme";
            },
        });
        assertEq(1, pages.size());
        assertEq("Keep", pages[0].title);
    }

    testLocalDocReaderDefaultSkipDir() {
        # defaultSkipDir skips *DataProvider directories except "DataProvider" itself
        assertEq(False, LocalDocReader::defaultSkipDir("DataProvider"));
        assertEq(True, LocalDocReader::defaultSkipDir("GrpcDataProvider"));
        assertEq(True, LocalDocReader::defaultSkipDir("AvroDataProvider"));
        assertEq(False, LocalDocReader::defaultSkipDir("AvroOtherDir"));
        assertEq(False, LocalDocReader::defaultSkipDir("docs"));
    }

    testLocalDocReaderMaxPages() {
        string dir = createTempDir();
        on_exit cleanup();
        for (int i = 0; i < 5; ++i) {
            writeHtml(dir + sprintf("/page%d.html", i), sprintf("Page %d", i),
                "<p>" + strmul("Content. ", 10) + "</p>");
        }

        list<hash<auto>> pages = LocalDocReader::read(dir, {"max_pages": 3});
        assertEq(3, pages.size());
    }

    testLocalDocReaderMissingDir() {
        list<hash<auto>> pages = LocalDocReader::read("/nonexistent/path/" + get_random_string());
        assertEq(0, pages.size());
    }

    testLocalDocReaderTitleFromHtml() {
        string dir = createTempDir();
        on_exit cleanup();
        # File without <title> — title should fall back to file path
        File f();
        f.open2(dir + "/notitle.html", O_CREAT | O_WRONLY | O_TRUNC);
        f.write("<html><body><p>" + strmul("No title content here. ", 5) + "</p></body></html>");
        f.close();

        list<hash<auto>> pages = LocalDocReader::read(dir);
        assertEq(1, pages.size());
        # Title falls back to filepath when no <title> tag
        assertEq(True, pages[0].title.find("notitle.html") >= 0);
    }

    testLocalDocReaderSkipShort() {
        string dir = createTempDir();
        on_exit cleanup();
        # Below MinTextLength threshold (50 chars)
        writeHtml(dir + "/short.html", "Short", "<p>Hi</p>");
        # Above threshold
        writeHtml(dir + "/long.html", "Long",
            "<p>" + strmul("Long content here. ", 5) + "</p>");

        list<hash<auto>> pages = LocalDocReader::read(dir);
        assertEq(1, pages.size());
        assertEq("Long", pages[0].title);
    }

    #
    # WebCrawler tests (no network — just verify constants and class are loadable)
    #

    testWebCrawlerDefaults() {
        # Verify the class exists and constants are present
        assertEq(3, WebCrawler::DefaultMaxDepth);
        assertEq(500, WebCrawler::DefaultMaxPages);
        assertEq(10, WebCrawler::DefaultConcurrency);
        assertEq(50, WebCrawler::MinTextLength);
    }

    private hash<auto> startSite(hash<string, string> pages) {
        Logger lg("test", LoggerLevel::getLevelInfo());
        HttpServer srv(<HttpServerOptionInfo>{"logger": lg});
        StaticSiteHandler handler(pages);
        srv.setHandler("static", "", NOTHING, handler);
        srv.setDefaultHandler("static", handler);
        hash<auto> linfo = srv.addListener(<HttpListenerOptionInfo>{"service": 0});
        return {"server": srv, "port": linfo.port};
    }

    private string longBody(string id, list<string> links) {
        string body = "<p>" + strmul("This is page " + id + " content. ", 5) + "</p>";
        foreach string lnk in (links) {
            body += sprintf("<a href=\"%s\">link</a> ", lnk);
        }
        return sprintf("<html><head><title>Page %s</title></head><body>%s</body></html>",
            id, body);
    }

    testWebCrawlerIntegration() {
        hash<string, string> pages = {
            "index.html": longBody("Home", ("page1.html", "page2.html")),
            "page1.html": longBody("One", ("page3.html",)),
            "page2.html": longBody("Two", ("page3.html",)),
            "page3.html": longBody("Three", ()),
        };
        hash<auto> site = startSite(pages);
        on_exit site.server.stop();
        int port = site.port;

        string seed = sprintf("http://localhost:%d/", port);
        list<hash<auto>> result = WebCrawler::crawl(seed, {
            "max_depth": 5,
            "max_pages": 10,
            "concurrency": 4,
            "allow_private_ips": True,  # localhost — required after Phase A SSRF default-deny
        });

        # Should find 4 pages: index, page1, page2, page3 (visited only once)
        assertEq(4, result.size());

        # Verify each URL only appears once despite multiple referrers
        hash<string, int> url_counts;
        foreach hash<auto> pg in (result) {
            url_counts{pg.url} = (url_counts{pg.url} ?? 0) + 1;
        }
        foreach string url in (keys url_counts) {
            assertEq(1, url_counts{url}, "url visited only once: " + url);
        }

        # Verify titles were extracted
        list<string> titles = map $1.title, result;
        assertEq(True, inlist("Page Home", titles));
        assertEq(True, inlist("Page Three", titles));
    }

    testWebCrawlerMaxPages() {
        hash<string, string> pages = {
            "index.html": longBody("Home", ("a.html", "b.html", "c.html", "d.html")),
            "a.html": longBody("A", ()),
            "b.html": longBody("B", ()),
            "c.html": longBody("C", ()),
            "d.html": longBody("D", ()),
        };
        hash<auto> site = startSite(pages);
        on_exit site.server.stop();
        int port = site.port;

        list<hash<auto>> result = WebCrawler::crawl(
            sprintf("http://localhost:%d/", port),
            {"max_depth": 5, "max_pages": 3, "concurrency": 4, "allow_private_ips": True});

        assertEq(3, result.size());
    }

    testWebCrawlerMaxDepth() {
        hash<string, string> pages = {
            "index.html": longBody("Home", ("d1.html",)),
            "d1.html": longBody("D1", ("d2.html",)),
            "d2.html": longBody("D2", ("d3.html",)),
            "d3.html": longBody("D3", ()),
        };
        hash<auto> site = startSite(pages);
        on_exit site.server.stop();
        int port = site.port;

        # max_depth=1 means: seed (depth 0) + links from seed (depth 1) = 2 pages
        list<hash<auto>> result = WebCrawler::crawl(
            sprintf("http://localhost:%d/", port),
            {"max_depth": 1, "max_pages": 100, "concurrency": 4, "allow_private_ips": True});

        assertEq(2, result.size());
        list<string> titles = map $1.title, result;
        assertEq(True, inlist("Page Home", titles));
        assertEq(True, inlist("Page D1", titles));
        assertEq(False, inlist("Page D2", titles));
    }

    testWebCrawlerUrlFilter() {
        hash<string, string> pages = {
            "index.html": longBody("Home", ("good.html", "skip.html")),
            "good.html": longBody("Good", ()),
            "skip.html": longBody("Skip", ()),
        };
        hash<auto> site = startSite(pages);
        on_exit site.server.stop();
        int port = site.port;

        list<hash<auto>> result = WebCrawler::crawl(
            sprintf("http://localhost:%d/", port), {
                "max_depth": 3, "max_pages": 100, "concurrency": 4,
                "allow_private_ips": True,
                "url_filter": bool sub (string url) {
                    return url.find("/skip.html") < 0;
                },
            });

        list<string> titles = map $1.title, result;
        assertEq(True, inlist("Page Home", titles));
        assertEq(True, inlist("Page Good", titles));
        assertEq(False, inlist("Page Skip", titles));
    }

    testWebCrawlerProgress() {
        hash<string, string> pages = {
            "index.html": longBody("Home", ("a.html", "b.html")),
            "a.html": longBody("A", ()),
            "b.html": longBody("B", ()),
        };
        hash<auto> site = startSite(pages);
        on_exit site.server.stop();
        int port = site.port;

        list<int> progress_calls = ();
        WebCrawler::crawl(sprintf("http://localhost:%d/", port), {
            "max_depth": 3, "max_pages": 100, "concurrency": 4,
            "allow_private_ips": True,
            "progress": sub (int p, int q) {
                progress_calls += p;
            },
        });

        # Progress callback should have been invoked at least once
        assertGt(0, progress_calls.size());
        # Final reported page count should be 3
        assertEq(3, progress_calls[progress_calls.size() - 1]);
    }

    #
    # Phase A: SsrfFilter tests
    #

    testSsrfFilterIpv4Private() {
        # RFC 1918
        assertEq(True, SsrfFilter::isPrivateIp("10.0.0.1"));
        assertEq(True, SsrfFilter::isPrivateIp("10.255.255.254"));
        assertEq(True, SsrfFilter::isPrivateIp("172.16.0.1"));
        assertEq(True, SsrfFilter::isPrivateIp("172.31.255.254"));
        assertEq(True, SsrfFilter::isPrivateIp("192.168.0.1"));
        assertEq(True, SsrfFilter::isPrivateIp("192.168.255.254"));
        # Loopback
        assertEq(True, SsrfFilter::isPrivateIp("127.0.0.1"));
        assertEq(True, SsrfFilter::isPrivateIp("127.255.255.254"));
        # Link-local + cloud metadata endpoint
        assertEq(True, SsrfFilter::isPrivateIp("169.254.0.1"));
        assertEq(True, SsrfFilter::isPrivateIp("169.254.169.254"));
        # CGNAT
        assertEq(True, SsrfFilter::isPrivateIp("100.64.0.1"));
        assertEq(True, SsrfFilter::isPrivateIp("100.127.255.254"));
        # "this network"
        assertEq(True, SsrfFilter::isPrivateIp("0.0.0.0"));
        assertEq(True, SsrfFilter::isPrivateIp("0.255.255.254"));
        # Multicast / reserved
        assertEq(True, SsrfFilter::isPrivateIp("224.0.0.1"));
        assertEq(True, SsrfFilter::isPrivateIp("239.255.255.254"));
        assertEq(True, SsrfFilter::isPrivateIp("240.0.0.1"));
    }

    testSsrfFilterIpv4Public() {
        # 172.15 is just outside RFC 1918 (which is 172.16-31)
        assertEq(False, SsrfFilter::isPrivateIp("172.15.0.1"));
        # 172.32 is just outside
        assertEq(False, SsrfFilter::isPrivateIp("172.32.0.1"));
        # 192.169 is just outside 192.168
        assertEq(False, SsrfFilter::isPrivateIp("192.169.0.1"));
        # 11.x is just outside 10.x
        assertEq(False, SsrfFilter::isPrivateIp("11.0.0.1"));
        # 100.63 / 100.128 are just outside 100.64-127 CGNAT
        assertEq(False, SsrfFilter::isPrivateIp("100.63.0.1"));
        assertEq(False, SsrfFilter::isPrivateIp("100.128.0.1"));
        # Public IPs
        assertEq(False, SsrfFilter::isPrivateIp("8.8.8.8"));
        assertEq(False, SsrfFilter::isPrivateIp("1.1.1.1"));
        assertEq(False, SsrfFilter::isPrivateIp("142.250.80.46"));  # google.com-ish
    }

    testSsrfFilterIpv6Private() {
        assertEq(True, SsrfFilter::isPrivateIp("::1"));
        assertEq(True, SsrfFilter::isPrivateIp("0:0:0:0:0:0:0:1"));
        assertEq(True, SsrfFilter::isPrivateIp("::"));
        # Unique local fc00::/7
        assertEq(True, SsrfFilter::isPrivateIp("fc00::1"));
        assertEq(True, SsrfFilter::isPrivateIp("fd12:3456:789a::1"));
        # Link-local fe80::/10
        assertEq(True, SsrfFilter::isPrivateIp("fe80::1"));
        assertEq(True, SsrfFilter::isPrivateIp("fe80::abcd:ef01:2345:6789"));
        # Multicast
        assertEq(True, SsrfFilter::isPrivateIp("ff00::1"));
        assertEq(True, SsrfFilter::isPrivateIp("ff02::1"));
    }

    testSsrfFilterIpv6Mapped() {
        # IPv4-mapped IPv6 — must recursively check the embedded IPv4
        assertEq(True, SsrfFilter::isPrivateIp("::ffff:127.0.0.1"));
        assertEq(True, SsrfFilter::isPrivateIp("::ffff:10.0.0.1"));
        assertEq(True, SsrfFilter::isPrivateIp("::ffff:169.254.169.254"));
    }

    testSsrfFilterHostnames() {
        assertEq(True, SsrfFilter::isPrivateHostname("localhost"));
        assertEq(True, SsrfFilter::isPrivateHostname("LocalHost"));
        assertEq(True, SsrfFilter::isPrivateHostname("kubernetes.default.svc.cluster.local"));
        assertEq(True, SsrfFilter::isPrivateHostname("my-svc.production.svc.cluster.local"));
        assertEq(True, SsrfFilter::isPrivateHostname("printer.local"));
        assertEq(True, SsrfFilter::isPrivateHostname("metadata.google.internal"));
        # Public hostnames
        assertEq(False, SsrfFilter::isPrivateHostname("example.com"));
        assertEq(False, SsrfFilter::isPrivateHostname("google.com"));
        assertEq(False, SsrfFilter::isPrivateHostname("docs.qore.org"));
    }

    testSsrfFilterCheckUrlRejects() {
        # Default-deny: each of these should throw SSRF-BLOCKED
        assertThrows("SSRF-BLOCKED", sub () {
            SsrfFilter::checkUrl("http://10.0.0.1/admin");
        });
        assertThrows("SSRF-BLOCKED", sub () {
            SsrfFilter::checkUrl("http://localhost:8080/");
        });
        assertThrows("SSRF-BLOCKED", sub () {
            SsrfFilter::checkUrl("http://169.254.169.254/latest/meta-data/");
        });
        assertThrows("SSRF-BLOCKED", sub () {
            SsrfFilter::checkUrl("http://kubernetes.default.svc.cluster.local/");
        });
        assertThrows("SSRF-BLOCKED", sub () {
            SsrfFilter::checkUrl("http://[::1]:8080/");
        });
    }

    testSsrfFilterAllowPrivate() {
        # With allow_private=True, none of these should throw
        SsrfFilter::checkUrl("http://10.0.0.1/", {"allow_private": True});
        SsrfFilter::checkUrl("http://localhost:8080/", {"allow_private": True});
        SsrfFilter::checkUrl("http://169.254.169.254/", {"allow_private": True});
        # No assertion needed — passing means not throwing
        assertTrue(True);
    }

    testSsrfFilterBlockedHostnames() {
        # Even with allow_private, an explicit blocklist hit should throw
        assertThrows("SSRF-BLOCKED-HOSTNAME", sub () {
            SsrfFilter::checkUrl("https://supah.qoretechnologies.com/api", {
                "allow_private": True,
                "blocked_hostnames": ("supah.qoretechnologies.com",),
            });
        });
        # Case-insensitive
        assertThrows("SSRF-BLOCKED-HOSTNAME", sub () {
            SsrfFilter::checkUrl("https://EXAMPLE.com/", {
                "allow_private": True,
                "blocked_hostnames": ("example.com",),
            });
        });
        # Hostname not in blocklist + allow_private — passes
        SsrfFilter::checkUrl("https://example.com/", {
            "allow_private": True,
            "blocked_hostnames": ("other.com",),
        });
        assertTrue(True);
    }

    testWebCrawlerRejectsPrivateSeed() {
        # WebCrawler::crawl() should propagate the SSRF-BLOCKED exception when
        # the seed URL targets a private address and allow_private_ips is False.
        assertThrows("SSRF-BLOCKED", sub () {
            WebCrawler::crawl("http://10.0.0.1/");
        });
        assertThrows("SSRF-BLOCKED", sub () {
            WebCrawler::crawl("http://localhost:1/");
        });
    }

    #
    # Phase A: WebCrawler URL extension + scheme filters
    #

    testWebCrawlerHasBlockedScheme() {
        assertEq(True, WebCrawler::hasBlockedScheme("javascript:alert(1)"));
        assertEq(True, WebCrawler::hasBlockedScheme("JavaScript:void(0)"));
        assertEq(True, WebCrawler::hasBlockedScheme("mailto:foo@bar.com"));
        assertEq(True, WebCrawler::hasBlockedScheme("tel:+1234567890"));
        assertEq(True, WebCrawler::hasBlockedScheme("sms:+1234567890"));
        assertEq(True, WebCrawler::hasBlockedScheme("data:text/html,<h1>x</h1>"));
        assertEq(True, WebCrawler::hasBlockedScheme("file:///etc/passwd"));
        assertEq(True, WebCrawler::hasBlockedScheme("ftp://ftp.example.com/"));
        # Allowed
        assertEq(False, WebCrawler::hasBlockedScheme("http://example.com/"));
        assertEq(False, WebCrawler::hasBlockedScheme("https://example.com/"));
        assertEq(False, WebCrawler::hasBlockedScheme("/relative/path"));
        assertEq(False, WebCrawler::hasBlockedScheme("page.html"));
    }

    testWebCrawlerHasBlockedExtension() {
        hash<string, bool> blocked = {
            "pdf": True, "png": True, "css": True, "js": True,
        };
        assertEq(True, WebCrawler::hasBlockedExtension(
            "https://example.com/file.pdf", blocked));
        assertEq(True, WebCrawler::hasBlockedExtension(
            "https://example.com/path/image.PNG", blocked));
        assertEq(True, WebCrawler::hasBlockedExtension(
            "https://example.com/style.css?v=1", blocked));
        # No extension
        assertEq(False, WebCrawler::hasBlockedExtension(
            "https://example.com/page", blocked));
        # Different extension
        assertEq(False, WebCrawler::hasBlockedExtension(
            "https://example.com/page.html", blocked));
        # Trailing slash directory
        assertEq(False, WebCrawler::hasBlockedExtension(
            "https://example.com/dir/", blocked));
    }

    testWebCrawlerExtensionFilter() {
        # Site where index links to a real HTML page AND a PDF/image.
        # The crawler should fetch index + good.html but never request the PDF/image.
        hash<string, string> pages = {
            "index.html": longBody("Index", ("good.html", "doc.pdf", "logo.png")),
            "good.html": longBody("Good", ()),
        };
        hash<auto> site = startSite(pages);
        on_exit site.server.stop();
        int port = site.port;

        list<hash<auto>> result = WebCrawler::crawl(
            sprintf("http://localhost:%d/", port), {
                "max_depth": 3, "max_pages": 100, "concurrency": 4,
                "allow_private_ips": True,
            });

        list<string> titles = map $1.title, result;
        assertEq(True, inlist("Page Index", titles));
        assertEq(True, inlist("Page Good", titles));
        # PDF and PNG must NOT have been crawled even though they're linked from index
        assertEq(2, result.size());
    }

    testWebCrawlerSchemeFilter() {
        # Site with mailto and javascript links — must be skipped during link extraction.
        hash<string, string> pages = {
            "index.html": "<html><head><title>Mixed</title></head><body>"
                "<p>" + strmul("Filler text. ", 10) + "</p>"
                "<a href=\"mailto:foo@bar.com\">email</a> "
                "<a href=\"javascript:void(0)\">js</a> "
                "<a href=\"tel:+1234\">phone</a> "
                "<a href=\"good.html\">good link</a>"
                "</body></html>",
            "good.html": longBody("Good", ()),
        };
        hash<auto> site = startSite(pages);
        on_exit site.server.stop();
        int port = site.port;

        list<hash<auto>> result = WebCrawler::crawl(
            sprintf("http://localhost:%d/", port), {
                "max_depth": 3, "max_pages": 100, "concurrency": 4,
                "allow_private_ips": True,
            });

        # Should have crawled exactly 2: index + good.html (mailto/js/tel filtered out)
        assertEq(2, result.size());
        list<string> titles = map $1.title, result;
        assertEq(True, inlist("Mixed", titles));
        assertEq(True, inlist("Page Good", titles));
    }

    #
    # Phase C: RobotsTxt tests
    #

    testRobotsTxtSimpleDisallow() {
        string content = "User-agent: *\nDisallow: /admin/\nDisallow: /private/\n";
        RobotsTxt r(content);
        assertEq(False, r.isAllowed("/admin/"));
        assertEq(False, r.isAllowed("/admin/users"));
        assertEq(False, r.isAllowed("/private/data"));
        assertEq(True, r.isAllowed("/"));
        assertEq(True, r.isAllowed("/public/"));
        assertEq(True, r.isAllowed("/api/v1/users"));
    }

    testRobotsTxtAllowOverride() {
        # Allow takes precedence over Disallow when the matching prefix is longer
        string content = "User-agent: *\nDisallow: /admin/\nAllow: /admin/public/\n";
        RobotsTxt r(content);
        assertEq(False, r.isAllowed("/admin/secret"));
        assertEq(True, r.isAllowed("/admin/public/index.html"));
    }

    testRobotsTxtUserAgentMatch() {
        string content =
            "User-agent: *\n"
            "Disallow: /\n"
            "\n"
            "User-agent: MyBot\n"
            "Disallow: /admin/\n"
            "Allow: /\n";

        # Default star-only UA gets the strict global Disallow
        RobotsTxt r1(content, "OtherBot");
        assertEq(False, r1.isAllowed("/api"));

        # MyBot gets the more permissive group
        RobotsTxt r2(content, "MyBot");
        assertEq(True, r2.isAllowed("/api"));
        assertEq(False, r2.isAllowed("/admin/users"));

        # Substring match: MyBot/2.0 should match the MyBot group
        RobotsTxt r3(content, "MyBot/2.0");
        assertEq(True, r3.isAllowed("/api"));
        assertEq(False, r3.isAllowed("/admin/x"));
    }

    testRobotsTxtCrawlDelay() {
        string content = "User-agent: *\nCrawl-delay: 5\nDisallow: /admin/\n";
        RobotsTxt r(content);
        assertEq(5, r.getCrawlDelay());
    }

    testRobotsTxtSitemap() {
        string content =
            "Sitemap: https://example.com/sitemap.xml\n"
            "User-agent: *\n"
            "Disallow:\n"
            "Sitemap: https://example.com/sitemap-news.xml\n";
        RobotsTxt r(content);
        list<string> sitemaps = r.getSitemaps();
        assertEq(2, sitemaps.size());
        assertEq(True, inlist("https://example.com/sitemap.xml", sitemaps));
        assertEq(True, inlist("https://example.com/sitemap-news.xml", sitemaps));
    }

    testRobotsTxtEmptyDisallow() {
        # An empty Disallow value means "allow everything"
        string content = "User-agent: *\nDisallow:\n";
        RobotsTxt r(content);
        assertEq(True, r.isAllowed("/anything"));
        assertEq(True, r.isAllowed("/admin/secret"));
    }

    testRobotsTxtCommentsBlankLines() {
        string content =
            "# This is a comment\n"
            "\n"
            "User-agent: *  # inline comment\n"
            "\n"
            "# Block admin\n"
            "Disallow: /admin/\n"
            "\n";
        RobotsTxt r(content);
        assertEq(False, r.isAllowed("/admin/"));
        assertEq(True, r.isAllowed("/"));
    }

    testWebCrawlerRobotsDisallow() {
        # Site that serves a robots.txt blocking /blocked/, plus an index that
        # links to both an allowed page and the blocked one.
        hash<string, string> pages = {
            "robots.txt": "User-agent: *\nDisallow: /blocked.html\n",
            "index.html": longBody("Index", ("good.html", "blocked.html")),
            "good.html": longBody("Good", ()),
            "blocked.html": longBody("BlockedPage", ()),
        };
        hash<auto> site = startSite(pages);
        on_exit site.server.stop();
        int port = site.port;

        list<hash<auto>> result = WebCrawler::crawl(
            sprintf("http://localhost:%d/", port), {
                "max_depth": 3, "max_pages": 100, "concurrency": 4,
                "allow_private_ips": True,
                # respect_robots is True by default — explicit for clarity
                "respect_robots": True,
            });

        # Index + good.html, but NOT blocked.html (because of robots.txt)
        list<string> titles = map $1.title, result;
        assertEq(True, inlist("Page Index", titles));
        assertEq(True, inlist("Page Good", titles));
        assertEq(False, inlist("Page BlockedPage", titles));
        assertEq(2, result.size());
    }
}
