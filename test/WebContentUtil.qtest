#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

# In-module module under test (relative path so we test the local source, not
# any system-installed version)
%requires ../qlib/WebContentUtil

# Qore-shipped system modules (loaded from the standard Qore module path)
%requires Util
%requires Mime
%requires HttpUtil
%requires Logger
%requires AsyncSocketIo
%requires HttpClientIo
%requires HttpServerUtil
%requires HttpServer
%requires QUnit

%exec-class WebContentUtilTest

#! Static HTML site handler for crawler integration test
class StaticSiteHandler inherits AbstractHttpRequestHandler {
    private {
        hash<string, string> pages;
    }

    constructor(hash<string, string> pages) {
        self.pages = pages;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        string path = hdr.path ?? "";
        if (path.find("?") >= 0) {
            path = path.substr(0, path.find("?"));
        }
        if (!path.val() || path == "/") {
            path = "index.html";
        }
        if (!exists pages{path}) {
            return makeResponse({"Content-Type": "text/plain"}, 404, "not found: " + path);
        }
        return makeResponse({"Content-Type": "text/html; charset=utf-8"}, 200, pages{path});
    }
}

public class WebContentUtilTest inherits QUnit::Test {
    constructor() : Test("WebContentUtilTest", "1.0") {
        addTestCase("UrlNormalizer basic", \testUrlNormalizerBasic());
        addTestCase("UrlNormalizer fragment strip", \testUrlNormalizerFragment());
        addTestCase("UrlNormalizer path resolution", \testUrlNormalizerPathResolution());
        addTestCase("UrlNormalizer trailing slash", \testUrlNormalizerTrailingSlash());
        addTestCase("UrlNormalizer query sort", \testUrlNormalizerQuerySort());
        addTestCase("UrlNormalizer port", \testUrlNormalizerPort());
        # Phase B: completeness per design §5.2
        addTestCase("UrlNormalizer lowercase scheme/host",
            \testUrlNormalizerLowercaseSchemeHost());
        addTestCase("UrlNormalizer default ports",
            \testUrlNormalizerDefaultPorts());
        addTestCase("UrlNormalizer percent encoding",
            \testUrlNormalizerPercentEncoding());
        addTestCase("HtmlExtractor basic", \testHtmlExtractorBasic());
        addTestCase("HtmlExtractor strip elements", \testHtmlExtractorStripElements());
        addTestCase("HtmlExtractor block tags", \testHtmlExtractorBlockTags());
        addTestCase("HtmlExtractor entities", \testHtmlExtractorEntities());
        addTestCase("HtmlExtractor extra strip", \testHtmlExtractorExtraStrip());
        addTestCase("HtmlExtractor title", \testHtmlExtractorTitle());
        addTestCase("HtmlExtractor missing title", \testHtmlExtractorMissingTitle());
        addTestCase("HtmlExtractor empty input", \testHtmlExtractorEmpty());
        addTestCase("TextChunker basic", \testTextChunkerBasic());
        addTestCase("TextChunker oversized paragraph", \testTextChunkerOversizedParagraph());
        addTestCase("TextChunker overlap", \testTextChunkerOverlap());
        addTestCase("TextChunker empty", \testTextChunkerEmpty());
        addTestCase("TextChunker estimateTokens", \testTextChunkerEstimateTokens());
        addTestCase("TextChunker custom options", \testTextChunkerCustomOptions());
        addTestCase("LocalDocReader basic", \testLocalDocReaderBasic());
        addTestCase("LocalDocReader skip dir", \testLocalDocReaderSkipDir());
        addTestCase("LocalDocReader defaultSkipDir", \testLocalDocReaderDefaultSkipDir());
        addTestCase("LocalDocReader max pages", \testLocalDocReaderMaxPages());
        addTestCase("LocalDocReader missing dir", \testLocalDocReaderMissingDir());
        addTestCase("LocalDocReader title from html", \testLocalDocReaderTitleFromHtml());
        addTestCase("LocalDocReader skips short content", \testLocalDocReaderSkipShort());
        addTestCase("WebCrawler defaults", \testWebCrawlerDefaults());
        addTestCase("WebCrawler integration", \testWebCrawlerIntegration());
        addTestCase("WebCrawler max_pages", \testWebCrawlerMaxPages());
        addTestCase("WebCrawler max_depth", \testWebCrawlerMaxDepth());
        addTestCase("WebCrawler url_filter", \testWebCrawlerUrlFilter());
        addTestCase("WebCrawler progress callback", \testWebCrawlerProgress());
        # Phase A: SSRF + URL extension + scheme filters
        addTestCase("SsrfFilter IPv4 private ranges", \testSsrfFilterIpv4Private());
        addTestCase("SsrfFilter IPv4 public", \testSsrfFilterIpv4Public());
        addTestCase("SsrfFilter IPv6 private ranges", \testSsrfFilterIpv6Private());
        addTestCase("SsrfFilter IPv6 IPv4-mapped", \testSsrfFilterIpv6Mapped());
        addTestCase("SsrfFilter hostname patterns", \testSsrfFilterHostnames());
        addTestCase("SsrfFilter checkUrl rejects private", \testSsrfFilterCheckUrlRejects());
        addTestCase("SsrfFilter checkUrl allow_private opt-in", \testSsrfFilterAllowPrivate());
        addTestCase("SsrfFilter checkUrl blocked_hostnames", \testSsrfFilterBlockedHostnames());
        addTestCase("WebCrawler rejects private seed by default",
