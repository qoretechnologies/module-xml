#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class WsdlWhitespaceTest

class WsdlWhitespaceTest inherits QUnit::Test {
    constructor() : Test("Schema-aware XML whitespace", "1.0") {
        addTestCase("Mixed and generic values retain whitespace through schemas and saved providers", \values());
        addTestCase("Element-only models discard permitted indentation and reject non-whitespace", \elementOnly());
        set_return_value(main());
    }
    private string source(string mode) {
        return '<xs:schema xmlns:xs="' + XSD_NS + '"><xs:element name="root"'
            + (mode == "generic" ? ' type="xs:anyType"/>' : '><xs:complexType mixed="'
                + (mode == "mixed" ? 'true' : 'false') + '"><xs:sequence>'
                '<xs:element name="a" type="xs:int" maxOccurs="2"/>'
                '</xs:sequence></xs:complexType></xs:element>') + '</xs:schema>';
    }
    private auto decode(XsdSchema model, string xml, bool preserve) {
        auto data = WSDLLib::parseSOAPMessage({"content-type":"text/xml", "body":xml});
        return model.getElement("", "root").deserializeValue(model.getTypeMap(), NOTHING,
            XsdBase::expandElementNamespaces(data){"{}root"}, True, preserve);
    }
    private check(XsdXmlValue value) {
        hash<auto> data = value.getElementData();
        assertEq(" \t", data."^value^");
        assertEq("\n", data."^value1^");
        assertEq("\r", data."^value2^");
        assertEq(2, value.getChildValues().size());
        assertEq("a", value.getChildValues()[0].getLocalName());
        assertEq("a", value.getChildValues()[1].getLocalName());
    }
    private values() {
        string xml = '<root> &#9;<a>17</a>&#10;<a>23</a>&#13;</root>';
        foreach string mode in ("generic", "mixed") {
            XsdSchema model(source(mode));
            foreach bool preserve in (False, True) {
                auto value = decode(model, xml, preserve);
                XsdXmlValue output = model.serializeXmlValue("", "root", value);
                check(output);
                assertEq(output, model.validateXmlValue(output));
                value = Serializable::deserialize(Serializable::serialize(value));
                check(model.serializeXmlValue("", "root", value));
                AbstractDataProviderType provider = model.getNativeDataProviderType("", "root");
                provider = Serializable::deserialize(Serializable::serialize(provider));
                check(model.serializeXmlValue("", "root", provider.acceptsValue(value)));
            }
            XsdXmlValue original(xml);
            check(original);
            original = Serializable::deserialize(Serializable::serialize(original));
            check(original);
            assertEq(xml, model.validateXmlValue(original).getXml());
        }
        XsdSchema generic(source("generic"));
        string nested = '<root> <outer> <a/> <a/> </outer> </root>';
        XsdXmlValue output = generic.serializeXmlValue("", "root", decode(generic, nested, True));
        assertEq(" ", output.getElementData()."^value^");
        hash<auto> inner = output.getChildValues()[0].getElementData();
        assertEq(" ", inner."^value^");
        assertEq(" ", inner."^value1^");
        assertEq(" ", inner."^value2^");
    }
    private elementOnly() {
        XsdSchema model(source("elements"));
        foreach bool preserve in (False, True) {
            auto value = decode(model, '<root> <a>17</a> <a>23</a> </root>', preserve);
            assertEq((17, 23), value.a);
            assertFalse(value.hasKey("^value^"));
            model.validateXmlValue(model.serializeXmlValue("", "root", value));
            assertThrows("SOAP-DESERIALIZATION-ERROR", \decode(),
                (model, '<root>text<a>17</a></root>', preserve));
            assertThrows("SOAP-DESERIALIZATION-ERROR", \decode(),
                (model, '<root> <a>bad</a></root>', preserve));
        }
    }
}
