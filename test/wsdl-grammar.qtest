#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "WSDL grammar fixtures require json";
%else
%exec-class WsdlGrammarTest

class WsdlGrammarTest inherits QUnit::Test {
    constructor() : Test("WSDL core grammar and extension isolation", "1.0") {
        hash<auto> manifest = parse_json(ReadOnlyFile::readTextFile(get_script_dir()
            + "/wsdl-interop/regressions/wsdl-grammar/cases.json"));
        foreach hash<auto> row in (manifest.cases) {
            addTestCase(row.name, \check(), (row,));
        }
        addTestCase("Failure does not affect subsequent source and saved graphs", \recovery(), (manifest.cases[0].xml,));
        addTestCase("Unsupported bindings retain isolated extension payloads and namespace scopes",
            \metadata(), (manifest.cases[0].xml,));
        set_return_value(main());
    }

    private static WebService parse(string source) {
        return new WebService(source, {"async_only":True});
    }

    private check(hash<auto> row) {
        if (!row.valid) {
            assertThrows("WSDL-ERROR", \parse(), (row.xml,));
            return;
        }
        WebService original = parse(row.xml);
        foreach WebService ws in (original, Serializable::deserialize(original.serialize()),
                Serializable::deserialize(original.serializeToData())) {
            assertEq(row.xml, ws.getWSDL());
            assertEq(("M",), keys ws.messages);
            assertEq(("body",), keys ws.getMessage("M").pmap);
            assertEq(("call",), ws.getOperationNames());
            assertEq(("Endpoint",), keys ws.getService("S").port);
            WSOperation op = ws.getBindingOperation("B", "call");
            assertEq("urn:call", op.getBinding("B").soapAction);
            AbstractDataProviderType provider = ws.getMessage("M").getDataProviderType(True);
            hash<auto> value = {"body":"stock item"};
            assertEq(value, provider.acceptsValue(value));
            assertEq("stock item", op.deserializeRequest(parse_xml(op.serializeRequest(value).body), "B", True));
            assertEq("stock item", op.deserializeResponse(parse_xml(op.serializeResponse(value).body), "B", True));
            auto example = provider.getExampleValue();
            assertEq(example.body, op.deserializeRequest(parse_xml(op.serializeRequest(example).body), "B", True));
        }
    }

    private recovery(string source) {
        string invalid = replace(source, '<w:message name="M">', '<w:message name="M">unexpected');
        assertThrows("WSDL-ERROR", \parse(), (invalid,));
        invalid = replace(source, '<xs:schema targetNamespace="urn:grammar">',
            '<xs:schema targetNamespace="urn:grammar">unexpected');
        assertThrows("WSDL-ERROR", \parse(), (invalid,));
        check({"xml":source,"valid":True});
        string aliases = replace(replace(source, 'w:', 'alias:'), 'xmlns:w=', 'xmlns:alias=');
        check({"xml":aliases,"valid":True});
    }

    private metadata(string source) {
        source = replace(source, '<s:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>',
            '<x:operation xmlns:x="urn:local"><w:message name="payload"/></x:operation>'
            + '<c:binding xmlns:c="http://cxf.apache.org/bindings/xformat"/>');
        source = replace(source, '<w:input><s:body use="literal"/>',
            '<w:input><x:body xmlns:x="urn:body">text<x:part>nested</x:part></x:body><s:body use="literal"/>');
        source = replace(source, '<s:address location="http://example.invalid/"/>',
            '<x:address xmlns:x="urn:address" location="opaque"/><s:address location="http://example.invalid/"/>');
        WebService original = parse(source);
        foreach WebService ws in (original, Serializable::deserialize(original.serialize()),
                Serializable::deserialize(original.serializeToData())) {
            assertEq(source, ws.getWSDL());
            Binding binding = ws.getBinding("B");
            assertFalse(binding.isSupported());
            hash<auto> declaration = binding.getDeclarationData();
            assertEq("urn:extension", declaration."^attributes^"."xmlns:x");
            assertEq(1, declaration.".wsdlExtensions".size());
            hash<auto> extension = declaration.".wsdlExtensions"[0];
            assertEq("x:operation", extension.name);
            assertEq("urn:local", extension.value."^attributes^"."xmlns:x");
            assertEq("payload", extension.value."w:message"."^attributes^".name);
            extension = declaration.operation."w:input".".wsdlExtensions"[0];
            assertEq("x:body", extension.name);
            assertEq("urn:body", extension.value."^attributes^"."xmlns:x");
            assertEq("nested", extension.value."x:part");
            hash<auto> port = ws.getService("S").port.Endpoint;
            assertEq("http://example.invalid/", port.address);
            extension = port.declaration.".wsdlExtensions"[0];
            assertEq("x:address", extension.name);
            assertEq("urn:address", extension.value."^attributes^"."xmlns:x");
            assertEq("opaque", extension.value."^attributes^".location);
            Binding saved = Serializable::deserialize(binding.serialize());
            assertEq(declaration, saved.getDeclarationData());
        }
    }
}
%endif
