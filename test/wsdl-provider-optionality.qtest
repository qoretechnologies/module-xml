#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires ../qlib/WSDL.qm
%requires xml
%exec-class ProviderOptionalityTest
class ProviderOptionalityTest inherits QUnit::Test {
    constructor() : Test("Validating XML record provider optionality", "1.0") {
        addTestCase("Wildcard attributes retain outer omission metadata", \attributes());
        addTestCase("Wildcard records retain outer omission metadata", \content());
        addTestCase("Message providers retain outer omission metadata", \message());
        set_return_value(main());
    }
    private XsdSchema schema() {
        return new XsdSchema('<xs:schema xmlns:xs="' + XSD_NS + '"><xs:element name="root">'
            '<xs:complexType><xs:sequence><xs:any namespace="##local" processContents="skip" '
            'minOccurs="0" maxOccurs="unbounded"/></xs:sequence>'
            '<xs:anyAttribute namespace="##local" processContents="skip"/></xs:complexType>'
            '</xs:element></xs:schema>', {"async_only":True});
    }
    private check(AbstractDataProviderType provider, hash<auto> valid, hash<auto> invalid) {
        foreach AbstractDataProviderType original in (provider, provider.getSoftType()) {
            foreach AbstractDataProviderType current in (original, Serializable::deserialize(original.serialize())) {
                AbstractDataProviderType mandatory = current.getMandatoryType();
                AbstractDataProviderType optional = mandatory.getOrNothingType();
                assertTrue(mandatory.isMandatory());
                assertFalse(mandatory.isOrNothingType());
                assertFalse(optional.isMandatory());
                assertTrue(optional.isOrNothingType());
                assertFalse(optional.getInfo().mandatory);
                assertEq(NOTHING, optional.acceptsValue(NOTHING));
                assertThrows("MISSING-VALUE-ERROR", \mandatory.acceptsValue(), (NOTHING,));
                assertEq(NT_HASH, optional.acceptsValue(valid).typeCode());
                assertThrows("RUNTIME-TYPE-ERROR", \optional.acceptsValue(), (invalid,));
                HashDataType parent("parent");
                parent.addField(new QoreDataField({"name":"value", "type":optional}));
                assertEq({}, parent.acceptsValue({}));
                assertTrue(parent.acceptsValue({"value":valid}).hasKey("value"));
                parent.replaceField(new QoreDataField({"name":"value", "type":mandatory}));
                assertThrows("MISSING-VALUE-ERROR", \parent.acceptsValue(), ({},));
                AbstractDataProviderType restored = Serializable::deserialize(optional.serialize());
                assertTrue(restored.isOrNothingType());
                assertEq(NOTHING, restored.acceptsValue(NOTHING));
            }
        }
    }
    private attributes() {
        AbstractDataProviderType provider = schema().getElement("", "root").type.getDataProviderType();
        check(provider.getFields()."^attributes^".getType(), {}, {"{urn:forbidden}tag":"x"});
    }
    private content() {
        check(schema().getElement("", "root").type.getDataProviderType(),
            {"{}item":"text"}, {"{urn:forbidden}item":"text"});
    }
    private message() {
        XsdSchema owner = schema();
        WSMessage message({"^attributes^":{"name":"Sample"},
            "part":({"^attributes^":{"name":"payload", "type":"xs:int"}},)},
            {}, owner.getTypeMap(), owner.nsc);
        check(message.getDataProviderType(), {"payload":1}, {"payload":"not-an-integer"});
    }
}
