#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires ../qlib/WSDL.qm
%requires xml
%exec-class SoapHeaderProcessingTest

class SoapHeaderProcessingTest inherits QUnit::Test {
    private {
        string source = ReadOnlyFile::readTextFile(get_script_dir()
            + "/wsdl-interop/soap-envelope-peer/contract.wsdl");
    }
    constructor() : Test("SOAP header processing attributes", "1.0") {
        addTestCase("SOAP boolean attributes use version-specific lexical spaces", \booleans());
        addTestCase("Native attribute output and raw fragments retain lexical validation", \output());
        addTestCase("Only attributes on header blocks in the active SOAP namespace are processed", \scope());
        set_return_value(main());
    }
    private list<WebService> services() {
        WebService ws(source);
        return (ws, Serializable::deserialize(ws.serialize()), Serializable::deserialize(ws.serializeToData()));
    }
    private static string envelope(bool soap12, string header) {
        return '<e:Envelope xmlns:e="' + (soap12 ? SOAP_12_ENV : SOAP_11_ENV)
            + '" xmlns:t="urn:soap-envelope-test"><e:Header>' + header + '</e:Header>'
            + '<e:Body><t:value>invoice-71</t:value></e:Body></e:Envelope>';
    }
    private booleans() {
        foreach WebService ws in (services()) {
            ws.nsc.opt_allow_any_header = True;
            WSOperation op = ws.getOperation("echo");
            foreach bool soap12 in (False, True) {
                string binding = soap12 ? "B12" : "B11";
                string uri = soap12 ? SOAP_12_ENV : SOAP_11_ENV;
                foreach string attribute in (soap12 ? ("mustUnderstand", "relay") : ("mustUnderstand",)) {
                    foreach string lexical in ("0", "1", "true", "false", " 1 ", "&#x9;false&#xA;",
                            "", "True", "FALSE", "2", "01", "-1", "yes", "0 1", "\u00a01\u00a0") {
                        bool valid = inlist(lexical, soap12
                            ? ("0", "1", "true", "false", " 1 ", "&#x9;false&#xA;") : ("0", "1", " 1 "));
                        string xml = envelope(soap12, '<t:Context xmlns:p="' + uri + '" p:' + attribute
                            + '="' + lexical + '">tracking</t:Context>');
                        hash<auto> parsed = parse_xml(xml, XPF_PRESERVE_ORDER | XPF_PRESERVE_WHITESPACE);
                        hash<auto> before = parsed;
                        hash<auto> header = {"t:Context":{
                            "^attributes^":{"xmlns:t":"urn:soap-envelope-test","xmlns:p":uri},
                            "^value^":"tracking"}};
                        header."t:Context"."^attributes^"{"p:" + attribute}
                            = replace(replace(lexical, "&#x9;", "\t"), "&#xA;", "\n");
                        if (valid) {
                            assertEq("invoice-71", op.deserializeRequest(parsed, binding));
                            assertEq("invoice-71", op.deserializeResponse(parsed, binding));
                            assertEq(1, op.deserializeXmlRequest(xml, binding).unbound_headers.size());
                            string serialized = op.serializeRequest({"body":"invoice-71"}, header, NOTHING,
                                NOTHING, NOTHING, NOTHING, binding).body;
                            assertEq("invoice-71", op.deserializeRequest(parse_xml(serialized), binding));
                        } else {
                            assertThrows("SOAP-DESERIALIZATION-ERROR", \op.deserializeRequest(), (parsed, binding));
                            assertThrows("SOAP-DESERIALIZATION-ERROR", \op.deserializeResponse(), (parsed, binding));
                            assertThrows("SOAP-DESERIALIZATION-ERROR", \op.deserializeXmlRequest(), (xml, binding));
                            assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(),
                                ({"body":"invoice-71"}, header, NOTHING, NOTHING, NOTHING, NOTHING, binding));
                        }
                        assertEq(before, parsed);
                        assertEq("invoice-71", op.deserializeRequest(parse_xml(envelope(soap12, "")), binding));
                    }
                }
            }
        }
    }
    private output() {
        foreach WebService ws in (services()) {
            ws.nsc.opt_allow_any_header = True;
            WSOperation op = ws.getOperation("echo");
            foreach bool soap12 in (False, True) {
                string binding = soap12 ? "B12" : "B11";
                string uri = soap12 ? SOAP_12_ENV : SOAP_11_ENV;
                foreach auto value in (True, False, 0, 1, 0.0, 1.0, 2, NOTHING) {
                    hash<auto> header = {"t:Context":{"^attributes^":{
                        "xmlns:t":"urn:soap-envelope-test","xmlns:p":uri,"p:mustUnderstand":value}}};
                    if (value.typeCode() == NT_BOOLEAN || (value.typeCode() == NT_INT && value >= 0 && value <= 1)) {
                        string xml = op.serializeRequest({"body":"invoice-71"}, header, NOTHING,
                            NOTHING, NOTHING, NOTHING, binding).body;
                        assertEq(1, op.deserializeXmlRequest(xml, binding).unbound_headers.size());
                    } else {
                        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(),
                            ({"body":"invoice-71"}, header, NOTHING, NOTHING, NOTHING, NOTHING, binding));
                    }
                }
                foreach string value in ("1", "invalid") {
                    hash<auto> header = {"^xml^":'<t:Context xmlns:t="urn:soap-envelope-test" xmlns:p="'
                        + uri + '" p:mustUnderstand="' + value + '"/>'};
                    if (value == "1") {
                        string xml = op.serializeRequest({"body":"invoice-71"}, header, NOTHING,
                            NOTHING, NOTHING, NOTHING, binding).body;
                        assertEq(1, op.deserializeXmlRequest(xml, binding).unbound_headers.size());
                    } else {
                        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(),
                            ({"body":"invoice-71"}, header, NOTHING, NOTHING, NOTHING, NOTHING, binding));
                    }
                }
            }
        }
    }
    private scope() {
        foreach WebService ws in (services()) {
            WSOperation op = ws.getOperation("echo");
            foreach bool soap12 in (False, True) {
                string binding = soap12 ? "B12" : "B11";
                string other_uri = soap12 ? SOAP_11_ENV : SOAP_12_ENV;
                foreach string header in (
                        '<t:Context mustUnderstand="invalid" relay="invalid"/>',
                        '<t:Context xmlns:p="urn:other" p:mustUnderstand="invalid" p:relay="invalid"/>',
                        '<t:Context xmlns:p="' + other_uri + '" p:mustUnderstand="invalid" p:relay="invalid"/>',
                        '<t:Context><t:Child e:mustUnderstand="invalid" e:relay="invalid"/></t:Context>') {
                    string xml = envelope(soap12, header);
                    assertEq("invoice-71", op.deserializeRequest(parse_xml(xml), binding));
                    assertEq(1, op.deserializeXmlRequest(xml, binding).unbound_headers.size());
                }
                string body_attributes = replace(envelope(soap12, ""), "<t:value>",
                    '<t:value e:mustUnderstand="invalid" e:relay="invalid">');
                assertEq(soap12, WSDLLib::validateSOAPEnvelope(parse_xml(body_attributes), soap12));
                if (!soap12) {
                    assertEq("invoice-71", op.deserializeRequest(parse_xml(envelope(False,
                        '<t:Context e:relay="invalid"/>')), binding));
                }
            }
        }
    }
}
