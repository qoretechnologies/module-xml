#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%exec-class XmlElementSubstitutionTest

class XmlElementSubstitutionTest inherits QUnit::Test {
    constructor() : Test("Native XSD element substitution controls", "1.0") {
        addTestCase("Builtin restriction is included in element blocking", \builtins());
        addTestCase("Transitive groups preserve the head's complete block", \transitive());
        addTestCase("Mixed derivations combine methods in either order", \complexTypes());
        addTestCase("Union membership does not bypass a restriction exclusion", \unions());
        addTestCase("Invalid declarations preserve the reader's prior schema", \replacement());
        set_return_value(main());
    }
    private string schema(string body, string head = "head") {
        return '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">' + body
            + '<xs:element name="root"><xs:complexType><xs:sequence><xs:element ref="' + head
            + '" maxOccurs="3"/></xs:sequence></xs:complexType></xs:element></xs:schema>';
    }
    private string consume(string source, string xml) {
        XmlReader reader(new StringInputStream(xml), {"xsd": source});
        string names = "";
        while (reader.read()) {
            if (reader.nodeType() == XML_NODE_TYPE_ELEMENT && reader.depth() == 1) {
                names += reader.name() + " ";
            }
        }
        @assert(reader.isValid());
        return names;
    }
    private check(string source, bool valid, string value = "17") {
        string xml = '<root><member>' + value + '</member><member>' + value + '</member></root>';
        if (valid) {
            assertEq("member member ", consume(source, xml));
            # The DOM parser represents an empty element as NOTHING.
            *string expected = value ? value : NOTHING;
            assertEq((expected, expected), parse_xml_with_schema(xml, source).root.member);
        } else {
            assertThrows("PARSE-XML-EXCEPTION", \consume(), (source, xml));
            assertThrows("PARSE-XML-EXCEPTION", \parse_xml_with_schema(), (xml, source));
        }
        xml = '<root><wrong>' + value + '</wrong></root>';
        assertThrows("PARSE-XML-EXCEPTION", \consume(), (source, xml));
        assertThrows("PARSE-XML-EXCEPTION", \parse_xml_with_schema(), (xml, source));
    }
    builtins() {
        foreach bool identity in (False, True) {
            foreach string block in ("", "extension", "restriction", "substitution", "#all") {
                string text = schema('<xs:element name="head" type="' + (identity ? "xs:int" : "xs:decimal")
                    + '" block="' + block + '"/><xs:element name="member" type="xs:int" substitutionGroup="head"/>');
                check(text, block != "substitution" && block != "#all" && (identity || block != "restriction"));
                assertEq("head ", consume(text, "<root><head>17</head></root>"));
                assertEq("17", parse_xml_with_schema("<root><head>17</head></root>", text).root.head);
                assertThrows("PARSE-XML-EXCEPTION", \consume(), (text, "<root><member>invalid</member></root>"));
            }
        }
    }
    transitive() {
        foreach bool abstract_head in (False, True) {
            foreach string block in ("", "extension", "restriction", "substitution", "#all") {
                string text = schema('<xs:element name="head" type="xs:decimal" abstract="'
                    + (abstract_head ? "true" : "false") + '" block="' + block + '"/>'
                    + '<xs:element name="middle" type="xs:decimal" substitutionGroup="head"'
                    + ' abstract="true" block="substitution"/>'
                    + '<xs:element name="member" type="xs:int" substitutionGroup="middle"/>');
                check(text, block == "" || block == "extension");
            }
        }
    }
    complexTypes() {
        foreach string upper in ("extension", "restriction") {
            string lower = upper == "extension" ? "restriction" : "extension";
            foreach string block in ("", "extension", "restriction", "#all") {
                string text = schema('<xs:complexType name="B"/><xs:complexType name="M" block="' + block + '">'
                    '<xs:complexContent><xs:' + upper + ' base="B"/></xs:complexContent></xs:complexType>'
                    '<xs:complexType name="D" block="#all"><xs:complexContent><xs:' + lower + ' base="M"/>'
                    '</xs:complexContent></xs:complexType><xs:element name="head" type="B"/>'
                    '<xs:element name="member" type="D" substitutionGroup="head"/>');
                check(text, !block, "");
            }
        }
    }
    unions() {
        foreach string block in ("", "extension", "restriction", "substitution", "#all") {
            string text = schema('<xs:simpleType name="U"><xs:union memberTypes="xs:int xs:boolean"/></xs:simpleType>'
                '<xs:element name="head" type="U" block="' + block + '"/>'
                '<xs:element name="member" type="xs:int" substitutionGroup="head"/>');
            check(text, block == "" || block == "extension");
        }
    }
    replacement() {
        string valid = schema('<xs:element name="head" type="xs:int"/>'
            '<xs:element name="member" substitutionGroup="head"/>');
        foreach string body in (
            '<xs:element name="head" type="xs:int"/><xs:element name="member" type="xs:string" substitutionGroup="head"/>',
            '<xs:element name="head" substitutionGroup="member"/><xs:element name="member" substitutionGroup="head"/>',
            '<xs:element name="head" type="xs:decimal" final="restriction"/>'
                '<xs:element name="member" type="xs:int" substitutionGroup="head"/>'
        ) {
            XmlReader reader("<root><member>17</member></root>");
            reader.schemaValidateString(valid);
            assertThrows("XSD-SYNTAX-ERROR", \reader.schemaValidateString(), (schema(body),));
            while (reader.read()) {
            }
            assertTrue(reader.isValid());
        }
    }
}
