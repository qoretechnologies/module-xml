<?xml version="1.0" encoding="UTF-8"?>
<!-- WSDL for testing nested model group (sequence / choice / all) handling -->
<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:xs="http://www.w3.org/2001/XMLSchema"
             xmlns:tns="urn:qore:test:nested-groups"
             targetNamespace="urn:qore:test:nested-groups">
    <types>
        <xs:schema targetNamespace="urn:qore:test:nested-groups"
                   xmlns="urn:qore:test:nested-groups"
                   elementFormDefault="qualified" attributeFormDefault="unqualified">
            <xs:element name="Req">
                <xs:complexType>
                    <xs:sequence>
                        <!-- a sequence nested directly in a sequence; its elements belong to the outer sequence -->
                        <xs:element name="nested">
                            <xs:complexType>
                                <xs:sequence>
                                    <xs:sequence>
                                        <xs:element name="first" type="xs:string"/>
                                        <xs:element name="second" type="xs:string" minOccurs="0"/>
                                    </xs:sequence>
                                    <xs:element name="third" type="xs:string" minOccurs="0"/>
                                </xs:sequence>
                            </xs:complexType>
                        </xs:element>

                        <!-- a nested sequence declared with minOccurs="0": none of its members can be required -->
                        <xs:element name="optional-group" minOccurs="0">
                            <xs:complexType>
                                <xs:sequence>
                                    <xs:sequence minOccurs="0">
                                        <xs:element name="opt1" type="xs:string"/>
                                    </xs:sequence>
                                </xs:sequence>
                            </xs:complexType>
                        </xs:element>

                        <!-- a choice whose alternatives are model groups with more than one element -->
                        <xs:element name="group-choice">
                            <xs:complexType>
                                <xs:choice>
                                    <xs:sequence>
                                        <xs:element name="ga1" type="xs:string"/>
                                        <xs:element name="ga2" type="xs:string"/>
                                    </xs:sequence>
                                    <xs:sequence>
                                        <xs:element name="gb1" type="xs:string"/>
                                    </xs:sequence>
                                </xs:choice>
                            </xs:complexType>
                        </xs:element>

                        <!-- a choice block declared inside a nested sequence -->
                        <xs:element name="deep">
                            <xs:complexType>
                                <xs:sequence>
                                    <xs:sequence>
                                        <xs:element name="d1" type="xs:string"/>
                                        <xs:choice minOccurs="1">
                                            <xs:element name="dx" type="xs:string"/>
                                            <xs:element name="dy" type="xs:string"/>
                                        </xs:choice>
                                    </xs:sequence>
                                </xs:sequence>
                            </xs:complexType>
                        </xs:element>

                        <!-- an empty model group must not cause a parse error -->
                        <xs:element name="empty" minOccurs="0">
                            <xs:complexType>
                                <xs:sequence/>
                            </xs:complexType>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>

            <xs:element name="Resp">
                <xs:complexType>
                    <xs:sequence>
                        <xs:sequence>
                            <xs:element name="r1" type="xs:string"/>
                        </xs:sequence>
                        <xs:element name="r2" type="xs:string"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:schema>
    </types>

    <message name="ReqM">
        <part name="parameters" element="tns:Req"/>
    </message>
    <message name="RespM">
        <part name="parameters" element="tns:Resp"/>
    </message>

    <portType name="NestedGroupsPort">
        <operation name="Op">
            <input message="tns:ReqM"/>
            <output message="tns:RespM"/>
        </operation>
    </portType>

    <binding name="NestedGroupsBinding" type="tns:NestedGroupsPort">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <operation name="Op">
            <soap:operation soapAction="Op" style="document"/>
            <input>
                <soap:body use="literal"/>
            </input>
            <output>
                <soap:body use="literal"/>
            </output>
        </operation>
    </binding>

    <service name="NestedGroupsService">
        <port name="NestedGroupsPort" binding="tns:NestedGroupsBinding">
            <soap:address location="http://localhost:8080/nested-groups"/>
        </port>
    </service>
</definitions>
