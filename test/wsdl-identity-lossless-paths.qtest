#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires ../qlib/WSDL.qm
%requires xml
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "Identity fixtures require json";
%else
%exec-class IdentityLosslessPathsTest
class IdentityLosslessPathsTest inherits QUnit::Test {
    constructor() : Test("Lossless generic identity values", "1.0") {
        addTestCase("Native mode and XML carriers preserve distinct integer and string keys", \preserved());
        set_return_value(main());
    }
    private auto decode(XsdSchema schema, string xml) {
        return schema.getElement("", "root").deserializeValue(schema.getTypeMap(), NOTHING,
            XsdBase::expandElementNamespaces(parse_xml(xml, XPF_PRESERVE_ORDER)){"{}root"}, True, True);
    }
    private types(auto value) {
        assertEq(XSD_NS, value.a."^type^".getNamespaceUri());
        assertEq("integer", value.a."^type^".getLocalName());
        assertEq(1, value.a."^val^");
        assertEq(NT_INT, value.a."^val^".typeCode());
        assertEq(XSD_NS, value.b."^type^".getNamespaceUri());
        assertEq("string", value.b."^type^".getLocalName());
        assertEq("1", value.b."^val^");
        assertEq(NT_STRING, value.b."^val^".typeCode());
    }
    private preserved() {
        hash<auto> model;
        foreach hash<auto> candidate in (parse_json(ReadOnlyFile::readTextFile(get_script_dir()+"/wsdl-interop/fixtures/identity-tuples.json"))) {
            if (candidate.name == "dynamic/anySimpleType/integer-string") {
                model = candidate;
                break;
            }
        }
        assertTrue(exists model);
        XsdSchema original(model.schema, {"async_only":True});
        foreach XsdSchema schema in (original, Serializable::deserialize(original.serialize())) {
            auto value = decode(schema, model.xml);
            types(value);
            AbstractDataProviderType native = schema.getNativeDataProviderType("", "root");
            foreach AbstractDataProviderType provider in (native, Serializable::deserialize(native.serialize()),
                    native.getSoftType(), Serializable::deserialize(native.getSoftType().serialize())) {
                auto accepted = provider.acceptsValue(value);
                types(accepted);
                XsdXmlValue wire = schema.serializeXmlValue("", "root", accepted);
                assertEq(parse_xml(wire.getXml()), parse_xml_with_schema(wire.getXml(), model.schema));
                types(decode(schema, wire.getXml()));
            }
            XsdXmlValue input(model.xml);
            assertEq(input, schema.validateXmlValue(input));
            AbstractDataProviderType xml = schema.getXmlDataProviderType("", "root");
            foreach AbstractDataProviderType provider in (xml, Serializable::deserialize(xml.serialize())) {
                XsdXmlValue accepted = provider.acceptsValue(input);
                assertEq(model.xml, accepted.getXml());
                types(decode(schema, accepted.getXml()));
            }
        }
    }
}
%endif
