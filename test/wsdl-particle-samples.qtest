#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class ParticleSampleTest

class ParticleSampleTest inherits QUnit::Test {
    constructor() : Test("Bounded complete particle samples", "1.0") {
        addTestCase("Repeated samples contain complete groups", \groups());
        addTestCase("Choices and sequences reserve required suffixes", \choices());
        addTestCase("Exact huge counts do not expand empty iterations", \huge());
        addTestCase("Empty and impossible languages remain distinct", \empty());
        addTestCase("All groups reserve required members", \all());
        addTestCase("Wildcard sample names satisfy namespace constraints", \wildcards());
        addTestCase("Shared groups retain independent caller counts", \shared());
        addTestCase("Deep optional and required models respect output budgets", \deep());
        addTestCase("Generation validates budgets and permits cancellation reuse", \cancellation());
        addTestCase("Concurrent sampling keeps shared declarations unchanged", \concurrency());
        set_return_value(main());
    }
    private XsdParticle particle(string body, string declarations = "") {
        XsdSchema schema('<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:samples"'
            ' targetNamespace="urn:samples">' + declarations + '<xs:complexType name="Record">'
            + body + '</xs:complexType></xs:schema>');
        return cast<XsdComplexType>(schema.findType("Record")).getParticle();
    }
    private list<string> check(XsdParticle model, int repetitions, int children) {
        list<string> sample = model.getSampleElementNames(repetitions, children);
        assertTrue(model.matchesElementNames(sample));
        assertTrue(sample.size() <= children);
        assertEq(sample, model.getSampleElementNames(repetitions, children));
        return sample;
    }
    groups() {
        XsdParticle original = particle('<xs:sequence minOccurs="2" maxOccurs="4">'
            '<xs:element name="quantity" type="xs:int"/><xs:element name="note" type="xs:string"/></xs:sequence>');
        foreach XsdParticle model in (original, Serializable::deserialize(original.serialize())) {
            assertEq(("{}quantity", "{}note", "{}quantity", "{}note", "{}quantity", "{}note"), check(model, 3, 6));
            assertEq(("{}quantity", "{}note", "{}quantity", "{}note"), check(model, 3, 5));
            assertEq(8, check(model, 9, 100).size());
            assertEq(check(model, 3, 10000), model.getSampleElementNames());
            assertThrows("XSD-SAMPLE-ERROR", \model.getSampleElementNames(), (1, 100));
            assertThrows("XSD-SAMPLE-ERROR", \model.getSampleElementNames(), (3, 3));
        }
    }
    choices() {
        XsdParticle model = particle('<xs:sequence><xs:choice><xs:sequence>'
            '<xs:element name="a"/><xs:element name="b" minOccurs="0" maxOccurs="3"/></xs:sequence>'
            '<xs:element name="c"/></xs:choice><xs:element name="tail"/></xs:sequence>');
        assertEq(("{}a", "{}tail"), check(model, 3, 2));
        assertEq(("{}a", "{}b", "{}b", "{}b", "{}tail"), check(model, 3, 5));
        model = particle('<xs:choice><xs:sequence minOccurs="4" maxOccurs="4"><xs:element name="a"/>'
            '</xs:sequence><xs:element name="b"/></xs:choice>');
        assertEq(("{}b",), check(model, 3, 100));
        assertEq(("{}a", "{}a", "{}a", "{}a"), check(model, 4, 4));
        model = particle('<xs:sequence minOccurs="2" maxOccurs="3"><xs:element name="a"/>'
            '<xs:element name="b" minOccurs="0" maxOccurs="3"/></xs:sequence>');
        assertEq(("{}a", "{}a", "{}a"), check(model, 3, 5));
    }
    huge() {
        string huge = "10000000000000000000000000000000000000000000000";
        XsdParticle model = particle('<xs:sequence minOccurs="' + huge + '" maxOccurs="' + huge + '">'
            '<xs:element name="a" minOccurs="0"/></xs:sequence>');
        assertEq(("{}a", "{}a", "{}a"), check(model, 3, 100));
        assertEq((), check(model, 3, 0));
        model = particle('<xs:sequence minOccurs="' + huge + '" maxOccurs="' + huge + '"/>');
        assertEq((), check(model, 9223372036854775807, 9223372036854775807));
        model = particle('<xs:sequence minOccurs="' + huge + '" maxOccurs="' + huge + '">'
            '<xs:element name="a"/></xs:sequence>');
        assertThrows("XSD-SAMPLE-ERROR", \model.getSampleElementNames(), (9223372036854775807, 10));
    }
    empty() {
        XsdParticle model = particle('<xs:sequence/>');
        assertEq((), check(model, 1, 0));
        model = particle('<xs:choice/>');
        assertThrows("XSD-SAMPLE-ERROR", \model.getSampleElementNames(), (1, 0));
        model = particle('<xs:sequence><xs:choice minOccurs="0" maxOccurs="3"/></xs:sequence>');
        assertEq((), check(model, 3, 0));
        model = particle('<xs:choice><xs:sequence/><xs:element name="a"/></xs:choice>');
        assertEq((), check(model, 3, 100));
        model = particle('<xs:choice><xs:element name="a" minOccurs="0" maxOccurs="0"/></xs:choice>');
        assertThrows("XSD-SAMPLE-ERROR", \model.getSampleElementNames(), (3, 100));
    }
    all() {
        string body = '<xs:element name="optional" minOccurs="0"/><xs:element name="required"/>'
            '<xs:element name="absent" minOccurs="0" maxOccurs="0"/>';
        XsdParticle model = particle('<xs:all>' + body + '</xs:all>');
        assertEq(("{}required",), check(model, 1, 1));
        assertEq(("{}optional", "{}required"), check(model, 1, 2));
        assertThrows("XSD-SAMPLE-ERROR", \model.getSampleElementNames(), (1, 0));
        model = particle('<xs:all minOccurs="0">' + body + '</xs:all>');
        assertEq((), check(model, 1, 0));
        assertEq(("{}required",), check(model, 1, 1));
    }
    wildcards() {
        foreach string constraint in ("##any", "##other", "##local", "##targetNamespace", "urn:other urn:more") {
            XsdParticle original = particle('<xs:sequence><xs:any namespace="' + constraint
                + '" minOccurs="2" maxOccurs="3" processContents="skip"/></xs:sequence>');
            foreach XsdParticle model in (original, Serializable::deserialize(original.serialize())) {
                assertEq(3, check(model, 3, 3).size());
            }
        }
        XsdParticle model = particle('<xs:sequence><xs:any namespace="" minOccurs="1"/></xs:sequence>');
        assertThrows("XSD-SAMPLE-ERROR", \model.getSampleElementNames(), (3, 100));
        model = particle('<xs:sequence><xs:any namespace="" minOccurs="0"/></xs:sequence>');
        assertEq((), check(model, 3, 100));
    }
    shared() {
        XsdParticle original = particle('<xs:sequence><xs:group ref="t:Pair" minOccurs="2" maxOccurs="2"/>'
            '<xs:element name="tail"/><xs:group ref="t:Pair"/></xs:sequence>',
            '<xs:group name="Pair"><xs:sequence><xs:element name="a"/><xs:element name="b"/>'
            '</xs:sequence></xs:group>');
        foreach XsdParticle model in (original, Serializable::deserialize(original.serialize())) {
            assertEq(("{}a", "{}b", "{}a", "{}b", "{}tail", "{}a", "{}b"), check(model, 3, 7));
            assertThrows("XSD-SAMPLE-ERROR", \model.getSampleElementNames(), (3, 6));
        }
    }
    deep() {
        string body = '<xs:element name="a" minOccurs="0"/>';
        for (int index = 0; index < 80; ++index) {
            body = '<xs:sequence minOccurs="0" maxOccurs="3">' + body + '</xs:sequence>';
        }
        XsdParticle model = particle(body);
        assertEq((), check(model, 3, 0));
        assertEq(3, check(model, 3, 3).size());
        assertTrue(check(model, 3, 20).size() > 0);
        body = '<xs:element name="a"/>';
        for (int index = 0; index < 80; ++index) {
            body = '<xs:sequence minOccurs="2" maxOccurs="2">' + body + '</xs:sequence>';
        }
        model = particle(body);
        assertThrows("XSD-SAMPLE-ERROR", \model.getSampleElementNames(), (3, 20));
    }
    cancellation() {
        XsdParticle model = particle('<xs:sequence><xs:element name="item" minOccurs="2" maxOccurs="3"/></xs:sequence>');
        assertThrows("XSD-SAMPLE-ERROR", \model.getSampleElementNames(), (0, 10));
        assertThrows("XSD-SAMPLE-ERROR", \model.getSampleElementNames(), (-1, 10));
        assertThrows("XSD-SAMPLE-ERROR", \model.getSampleElementNames(), (3, -1));
        SandboxManager manager();
        on_exit manager.clearInterrupt();
        Program program(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
        program.setSandboxManager(manager);
        program.parse("%modern\n%requires ../qlib/WSDL.qm\n"
            "list<string> sub sample(XsdParticle model, SandboxManager manager, bool cancel) {\n"
            "    if (cancel) { manager.requestInterrupt(); }\n"
            "    return model.getSampleElementNames(3, 3);\n"
            "}\n", get_script_dir() + "/particle-sample-cancellation.qr");
        *hash<ExceptionInfo> error;
        try {
            program.callFunction("sample", model, manager, True);
        } catch (hash<ExceptionInfo> ex) {
            error = ex;
        }
        manager.clearInterrupt();
        assertEq("PROGRAM-INTERRUPTED", error.err);
        assertEq(("{}item", "{}item", "{}item"), program.callFunction("sample", model, manager, False));
    }
    concurrency() {
        XsdParticle model = particle('<xs:sequence minOccurs="2" maxOccurs="3">'
            '<xs:element name="a"/><xs:element name="b"/></xs:sequence>');
        Qore::Thread::Queue ready();
        Qore::Thread::Queue start();
        Qore::Thread::Queue results();
        Qore::Thread::Counter running();
        on_exit {
            for (int index = 0; index < 4; ++index) {
                start.push(True);
            }
            assertEq(0, running.waitForZero(30s));
        }
        for (int index = 0; index < 4; ++index) {
            running.inc();
            background sub () {
                on_exit running.dec();
                try {
                    ready.push(True);
                    start.get(30s);
                    results.push({"names": model.getSampleElementNames(3, 5)});
                } catch (hash<ExceptionInfo> ex) {
                    results.push({"error": ex});
                }
            }();
        }
        for (int index = 0; index < 4; ++index) {
            assertTrue(ready.get(30s));
        }
        for (int index = 0; index < 4; ++index) {
            start.push(True);
        }
        for (int index = 0; index < 4; ++index) {
            hash<auto> result = results.get(30s);
            assertFalse(exists result.error);
            assertEq(("{}a", "{}b", "{}a", "{}b"), result.names);
        }
        assertEq("2", model.getMinOccurs());
        assertEq("3", model.getMaxOccurs());
        assertEq("1", model.getChildren()[0].getMinOccurs());
        assertEq(1, model.getChildren()[0].getElement().minOccurs);
    }
}
