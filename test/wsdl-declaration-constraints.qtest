#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires ../qlib/WSDL.qm
%exec-class DeclarationConstraintsTest

class DeclarationConstraintsTest inherits QUnit::Test {
    private {
        const Xsd = "http://www.w3.org/2001/XMLSchema";
        const Ns = "urn:declaration-constraints";
        const Simple = '<xs:simpleType><xs:restriction base="xs:int"/></xs:simpleType>';
    }

    constructor() : Test("WSDL declaration constraints", "1.0") {
        addTestCase("Elements select exactly one type declaration", \typeAlternatives());
        addTestCase("Local element names and reference properties are checked", \references());
        addTestCase("Global and local declaration contexts remain distinct", \contexts());
        addTestCase("Declaration booleans retain all legal spellings", \booleans());
        addTestCase("ID-derived value constraints are schema errors", \idValues());
        addTestCase("A complex type has at most one ID attribute use", \idUses());
        addTestCase("Failures preserve parsed types and native consumers", \recovery());
        addTestCase("ID checks do not borrow a deleted type namespace", \detachedTypes());
        set_return_value(main());
    }

    private string schema(string body) {
        return sprintf('<xs:schema xmlns:xs="%s" xmlns:t="%s" targetNamespace="%s">%s</xs:schema>', Xsd, Ns, Ns, body);
    }

    private XsdSchema parse(string body) {
        return new XsdSchema(schema(body), {"async_only": True});
    }

    private string record(string content, string name = "Record") {
        return sprintf('<xs:complexType name="%s">%s</xs:complexType>', name, content);
    }

    private XsdComplexType getRecord(XsdSchema s) {
        return cast<XsdComplexType>(s.findType(make_qname(Ns, "Record")));
    }

    private string local(string declaration) {
        return record('<xs:sequence>' + declaration + '</xs:sequence>');
    }

    typeAlternatives() {
        foreach string bad in (
                '<xs:element name="value" type="xs:int">' + Simple + '</xs:element>',
                '<xs:element name="value" type="xs:int"><xs:complexType/></xs:element>',
                '<xs:element name="value">' + Simple + '<xs:complexType/></xs:element>',
                '<xs:element name="value">' + Simple + Simple + '</xs:element>',
                '<xs:element name="value"><xs:complexType/><xs:complexType/></xs:element>',
                '<xs:element name="value" default="0" fixed="0"/>',
                '<xs:element name="value"><xs:complexType name="Nested"/></xs:element>',
                '<xs:element name="value"><xs:simpleType name="Nested"><xs:restriction base="xs:int"/>
                    </xs:simpleType></xs:element>') {
            assertThrows("WSDL-ERROR", \parse(), (local(bad),));
            assertThrows("WSDL-ERROR", \parse(), (bad,));
        }
        assertThrows("WSDL-NAMESPACE-ERROR", \parse(), (local('<xs:element name="value" type=""/>'),));
        assertThrows("XSD-SIMPLETYPE-ERROR", \parse(), (local('<xs:element name="value"><xs:simpleType/></xs:element>'),));
        XsdSchema s = parse(local('<xs:element name="value">' + Simple + '</xs:element>'));
        assertEq("int", cast<XsdSimpleType>(getRecord(s).elementmap.value.type).type.name);
    }

    references() {
        foreach string bad in ('<xs:element/>', '<xs:element/><xs:element name="valid"/>') {
            assertThrows("WSDL-ERROR", \parse(), (bad,));
        }
        foreach string compositor in ("sequence", "choice", "all") {
            foreach string bad in ('<xs:element/>', '<xs:element/><xs:element name="valid"/>') {
                string content = sprintf('<xs:%s>%s</xs:%s>', compositor, bad, compositor);
                assertThrows("WSDL-ERROR", \parse(), (record(content),));
                if (compositor != "all") {
                    assertThrows("WSDL-ERROR", \parse(), ('<xs:group name="G">' + content + '</xs:group>',));
                }
            }
        }
        foreach string bad in ('<xs:element/>', '<xs:element type="xs:int"/>',
                '<xs:element name="value" ref="t:value"/>', '<xs:element/> <xs:element name="value" type="xs:int"/>') {
            assertThrows("WSDL-ERROR", \parse(), (local(bad),));
        }
        string global = '<xs:element name="value" type="xs:int"/>';
        foreach string property in ('nillable="true"', 'default="0"', 'fixed="0"', 'block="extension"') {
            assertThrows("WSDL-ERROR", \parse(), (global + local('<xs:element ref="t:value" ' + property + '/>'),));
        }
        assertThrows("WSDL-NAMESPACE-ERROR", \parse(), (local('<xs:element ref=""/>'),));
        XsdSchema s = parse(global + local('<xs:element ref="t:value" minOccurs="0" maxOccurs="2">
            <xs:annotation><xs:documentation>Customer identifier</xs:documentation></xs:annotation></xs:element>'));
        assertEq(2, getRecord(s).elementmap.value.maxOccurs);
    }

    contexts() {
        foreach string property in ('form="qualified"', 'minOccurs="1"', 'maxOccurs="1"') {
            assertThrows("WSDL-ERROR", \parse(), ('<xs:element name="value" type="xs:int" ' + property + '/>',));
        }
        foreach string property in ('abstract="false"', 'final=""', 'substitutionGroup="t:value"') {
            assertThrows("WSDL-ERROR", \parse(), (local('<xs:element name="value" type="xs:int" ' + property + '/>'),));
        }
        XsdSchema s = parse('<xs:element name="value" type="xs:int" abstract="false" final=""/>'
            + local('<xs:element name="value" type="xs:boolean" form="unqualified"/>'));
        assertEq("int", s.getElement(Ns, "value").type.name);
        assertEq("boolean", getRecord(s).elementmap.value.type.name);
    }

    booleans() {
        foreach string value in ("true", "1", "false", "0", " 1 ") {
            XsdSchema s = parse(local('<xs:element name="value" type="xs:int" nillable="' + value + '"/>'));
            assertEq(value == "true" || trim(value) == "1", getRecord(s).elementmap.value.nillable);
        }
        foreach string value in ("", "yes", "TRUE", "2") {
            assertThrows("WSDL-ERROR", \parse(), (local('<xs:element name="value" type="xs:int" nillable="' + value + '"/>'),));
        }
    }

    idValues() {
        string types = '<xs:simpleType name="Identifier"><xs:restriction base="xs:ID"/></xs:simpleType>';
        foreach string type_name in ("xs:ID", "t:Identifier") {
            foreach string constraint in ("default", "fixed") {
                assertThrows("WSDL-ERROR", \parse(), (types + '<xs:attribute name="id" type="' + type_name
                    + '" ' + constraint + '="id1"/>',));
                assertThrows("WSDL-ERROR", \parse(), (types + '<xs:element name="id" type="' + type_name
                    + '" ' + constraint + '="id1"/>',));
            }
        }
        assertThrows("WSDL-ERROR", \parse(), ('<xs:complexType name="Content"><xs:simpleContent>
            <xs:extension base="xs:ID"/></xs:simpleContent></xs:complexType>
            <xs:element name="id" type="t:Content" fixed="id1"/>',));
        XsdSchema s = parse('<xs:attribute name="ref" type="xs:IDREF" default="id1"/>'
            + '<xs:element name="id" type="xs:ID"/>');
        assertEq("ID", s.getElement(Ns, "id").type.name);
    }

    idUses() {
        string first = '<xs:attribute name="first" type="xs:ID"/>';
        string second = '<xs:attribute name="second" type="xs:ID"/>';
        assertThrows("WSDL-ERROR", \parse(), (record(first + second),));
        assertThrows("WSDL-ERROR", \parse(), (record(first, "Base") + record('<xs:complexContent>
            <xs:extension base="t:Base">' + second + '</xs:extension></xs:complexContent>'),));
        assertThrows("WSDL-ERROR", \parse(), ('<xs:attributeGroup name="G">' + first + '</xs:attributeGroup>'
            + record('<xs:attributeGroup ref="t:G"/>' + second),));
        string named = '<xs:simpleType name="Identifier"><xs:restriction base="xs:ID"/></xs:simpleType>';
        string inline_id = '<xs:attribute name="third"><xs:simpleType><xs:restriction base="t:Identifier"/>'
            + '</xs:simpleType></xs:attribute>';
        assertThrows("WSDL-ERROR", \parse(), (record(first + inline_id) + named,));
        assertThrows("WSDL-ERROR", \parse(), (record('<xs:simpleContent><xs:extension base="xs:string">'
            + first + inline_id + '</xs:extension></xs:simpleContent>') + named,));
        XsdSchema s = parse(record(first + '<xs:attribute name="reference" type="xs:IDREF"/>'));
        assertEq(("first", "reference"), keys getRecord(s).attrs);
        s = parse(record(first, "Base") + record('<xs:complexContent><xs:restriction base="t:Base">
            <xs:attribute name="first" use="prohibited"/></xs:restriction></xs:complexContent>'));
        assertEq({}, getRecord(s).attrs);
    }

    detachedTypes() {
        XsdSchema s = parse('<xs:attribute name="flag" type="xs:boolean"/>'
            + '<xs:attribute name="id" type="xs:ID"/>');
        XsdAttribute flag = s.getAttribute(Ns, "flag");
        XsdAttribute id = s.getAttribute(Ns, "id");
        delete s;
        flag.defaultLexical = "false";
        flag.resolveConstraints(NOTHING);
        assertEq(False, flag.getDefaultValue());
        id.fixedLexical = "account1";
        assertThrows("WSDL-ERROR", \id.resolveConstraints(), (NOTHING,));
    }

    recovery() {
        XsdSchema original = parse(local('<xs:element name="value" type="xs:int"/>')
            + record('<xs:attribute name="id" type="xs:ID"/>', "Base"));
        foreach XsdSchema s in (original, Serializable::deserialize(original.serialize())) {
            XsdComplexType before = getRecord(s);
            assertThrows("WSDL-ERROR", \s.addSchemaString(), (schema('<xs:element name="bad" type="xs:int">'
                + Simple + '</xs:element>'),));
            assertEq(before, getRecord(s));
            XsdComplexType base = cast<XsdComplexType>(s.findType(make_qname(Ns, "Base")));
            assertThrows("WSDL-ERROR", \s.addSchemaString(), (schema(record('<xs:complexContent>
                <xs:extension base="t:Base"><xs:attribute name="second" type="xs:ID"/></xs:extension>
                </xs:complexContent>', "Invalid")),));
            assertEq(("id",), keys base.attrs);
            assertEq(NOTHING, s.findType(make_qname(Ns, "Invalid")));
            assertThrows("WSDL-ERROR", \s.addSchemaString(), (schema('<xs:element name="invalid" fixed="id1">
                <xs:complexType><xs:simpleContent><xs:extension base="xs:ID"/></xs:simpleContent>
                </xs:complexType></xs:element>'),));
            assertEq(NOTHING, s.getElement(Ns, "invalid"));
            assertEq({"value": 0}, before.getDataProviderType().acceptsValue({"value": 0}));
            assertEq({"value": 0}, before.deserializeValue("Record", s.getTypeMap(), NOTHING, {"value": "0"}));
            s.addSchemaString(schema('<xs:element name="good" type="xs:boolean"/>'));
            assertEq("boolean", s.getElement(Ns, "good").type.name);
        }
    }
}
