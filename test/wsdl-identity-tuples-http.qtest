#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%requires ../qlib/SoapClient.qm
%requires ../qlib/SoapHandler.qm
%requires ../qlib/SoapDataProvider
%requires HttpServer
%exec-class IdentityTuplesHttpTest

class IdentityTuplesHttpTest inherits QUnit::Test {
    constructor() : Test("Scoped identity tuples through HTTP consumers", "1.0") {
        addTestCase("Clients, handlers and providers enforce key and keyref constraints in both SOAP bindings", \consumers());
        set_return_value(main());
    }
    private WebService service(string version) {
        string soap = "http://schemas.xmlsoap.org/wsdl/soap" + (version == "12" ? "12" : "") + "/";
        return new WebService('<w:definitions xmlns:w="http://schemas.xmlsoap.org/wsdl/" xmlns:s="' + soap
            + '" xmlns:xs="' + XSD_NS + '" xmlns:t="urn:qore:identity-http" targetNamespace="urn:qore:identity-http">'
            '<w:types><xs:schema targetNamespace="urn:qore:identity-http"><xs:element name="value">'
            '<xs:complexType><xs:sequence><xs:element name="ref" type="xs:string" maxOccurs="unbounded"/>'
            '<xs:element name="item" maxOccurs="unbounded"><xs:complexType>'
            '<xs:attribute name="id" type="xs:string" use="required"/></xs:complexType></xs:element>'
            '</xs:sequence></xs:complexType>'
            '<xs:key name="codeKey"><xs:selector xpath="item"/><xs:field xpath="@id"/></xs:key>'
            '<xs:keyref name="codeReference" refer="t:codeKey"><xs:selector xpath="ref"/>'
            '<xs:field xpath="."/></xs:keyref></xs:element></xs:schema></w:types>'
            '<w:message name="Input"><w:part name="body" element="t:value"/></w:message>'
            '<w:message name="Output"><w:part name="body" element="t:value"/></w:message>'
            '<w:portType name="Port"><w:operation name="submit"><w:input message="t:Input"/>'
            '<w:output message="t:Output"/></w:operation></w:portType>'
            '<w:binding name="Soap" type="t:Port"><s:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>'
            '<w:operation name="submit"><s:operation soapAction="urn:submit"/><w:input><s:body use="literal"/></w:input>'
            '<w:output><s:body use="literal"/></w:output></w:operation></w:binding>'
            '<w:service name="Service"><w:port name="Port" binding="t:Soap">'
            '<s:address location="http://example.invalid/Service"/></w:port></w:service></w:definitions>',
            {"async_only":True});
    }
    private auto saved(auto value) {
        return Serializable::deserialize(Serializable::serialize(value));
    }
    private checkValue(auto value) {
        assertEq(("a", "b"), value.ref);
        assertEq(("a", "b"), map $1."^attributes^".id, value.item);
    }
    private consumers() {
        foreach string version in ("11", "12") {
            WebService ws = saved(service(version));
            WSOperation operation = ws.getBindingOperation("Soap", "submit");
            AbstractDataProviderType input = saved(operation.input.getDataProviderType(True));
            AbstractDataProviderType output = saved(operation.output.getDataProviderType(True));
            HttpServer server();
            on_exit server.stop();
            SoapHandler handler(new PermissiveAuthenticator());
            server.setDefaultHandler("soap", handler);
            Queue observed();
            code<auto(hash<auto>, auto)> callback = auto sub(hash<auto> cx, auto value) {
                auto checked = input.acceptsValue({"body":value});
                observed.push(checked.body);
                return output.acceptsValue(checked);
            };
            handler.addMethod(ws, operation, callback, NOTHING, NOTHING, NOTHING, "Service", NOTHING,
                NOTHING, "Soap", NOTHING, False, True);
            server.addListener(0);
            string url = sprintf("http://127.0.0.1:%d/Service", server.getListenerInfo(0).port);
            SoapClient client({"wsdl":ws,"url":url,"timeout":30000,"connect_timeout":30000});
            hash<auto> value = {"ref":("a", "b"), "item":({"^attributes^":{"id":"a"}}, {"^attributes^":{"id":"b"}})};
            foreach bool preserve in (False, True) {
                checkValue(client.callOperation("submit", input.acceptsValue({"body":value}),
                    {"binding":"Soap","preserve_types":preserve}));
                checkValue(observed.pop(30000));
            }
            SoapDataProvider provider(ws, client);
            AbstractDataProvider request = provider.getChildProviderEx("submit");
            checkValue(request.doRequest({"body":value}, {"binding":"Soap"}));
            checkValue(observed.pop(30000));
            AbstractDataProviderType request_type = request.getRequestType();
            hash<auto> invalid = value;
            invalid.ref = ("a", "missing");
            assertThrows("RUNTIME-TYPE-ERROR", \request_type.acceptsValue(), ({"body":invalid},));
            assertThrows("SOAP-SERIALIZATION-ERROR", \client.callOperation(),
                ("submit", {"body":invalid}, {"binding":"Soap"}));
            hash<auto> duplicate = value;
            duplicate.item[1]."^attributes^".id = "a";
            assertThrows("RUNTIME-TYPE-ERROR", \request_type.acceptsValue(), ({"body":duplicate},));
            assertThrows("SOAP-SERIALIZATION-ERROR", \client.callOperation(),
                ("submit", {"body":duplicate}, {"binding":"Soap"}));
            hash<auto> wire = operation.serializeRequest({"body":value}, NOTHING, NOTHING, NOTHING,
                NOTHING, NOTHING, "Soap");
            string bad = replace(wire.body, 'id="b"', 'id="c"');
            assertFalse(bad == wire.body);
            HTTPClient raw({"url":url,"error_passthru":True,"timeout":30000,"connect_timeout":30000});
            hash<auto> info;
            string fault = raw.post("/Service", bad, wire.hdr, \info);
            assertEq(version == "11" ? 500 : 400, info."response-headers".status_code);
            assertTrue(fault.find("SOAP-DESERIALIZATION-ERROR") >= 0);
            string good = raw.post("/Service", wire.body, wire.hdr, \info);
            assertEq(200, info."response-headers".status_code);
            checkValue(operation.deserializeResponse(parse_xml(good, XPF_PRESERVE_ORDER), "Soap", True));
            checkValue(observed.pop(30000));
            checkValue(value);
            assertEq(0, observed.size());
            hash<auto> response = operation.serializeResponse({"body":value}, NOTHING, NOTHING, NOTHING,
                NOTHING, NOTHING, "Soap");
            string invalid_response = replace(response.body, 'id="b"', 'id="c"');
            assertFalse(invalid_response == response.body);
            HttpServer peer();
            on_exit peer.stop();
            peer.setDefaultHandler("peer", new IdentityTuplePeer(invalid_response,
                version == "11" ? "text/xml; charset=utf-8" : "application/soap+xml; charset=utf-8"));
            peer.addListener(0);
            SoapClient peer_client({"wsdl":ws,
                "url":sprintf("http://127.0.0.1:%d/Service", peer.getListenerInfo(0).port),
                "timeout":30000,"connect_timeout":30000});
            foreach bool preserve in (False, True) {
                assertThrows("SOAP-DESERIALIZATION-ERROR", \peer_client.callOperation(),
                    ("submit", {"body":value}, {"binding":"Soap", "preserve_types":preserve}));
            }
        }
    }
}

# Immutable after construction; HTTP worker threads only read the response.
class IdentityTuplePeer inherits AbstractHttpRequestHandler {
    private {
        string response;
        string content_type;
    }
    constructor(string response, string content_type) {
        self.response = response;
        self.content_type = content_type;
    }
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse({"Content-Type":content_type}, 200, response);
    }
}
