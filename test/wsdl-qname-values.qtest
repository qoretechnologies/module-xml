#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class QNameValuesTest

class InterruptQNameValueProvider inherits XsdQNameDataType {
    public {
        bool interrupt = True;
    }

    constructor() : XsdQNameDataType({"p": "urn:catalog"}) {
    }

    auto acceptsValue(auto value) {
        if (interrupt) {
            throw "PROGRAM-INTERRUPTED", "QName item conversion interrupted";
        }
        return XsdQNameDataType::acceptsValue(value);
    }
}

class QNameValuesTest inherits QUnit::Test {
    constructor() : Test("XSD QName namespace values", "1.0") {
        addTestCase("QName identity compares namespace and local name independently of aliases", \identity());
        addTestCase("Explicit namespace contexts resolve defaults and the implicit xml prefix", \contexts());
        addTestCase("Malformed QName values and reserved namespace bindings reject", \invalid());
        addTestCase("Reconstruction validates identity and derives lexical components", \reconstruction());
        addTestCase("QName providers preserve identity and advertise conversion categories", \providers());
        addTestCase("Provider namespace bindings remain immutable through optional copies", \providerContexts());
        addTestCase("Invalid provider values and reconstructed namespace maps reject", \providerErrors());
        addTestCase("Record and list fields validate QName values after reconstruction", \containers());
        addTestCase("Cancellation propagates and container conversion recovers", \cancellation());
        addTestCase("Concurrent provider copies retain their independent namespace context", \concurrency());
        set_return_value(main());
    }

    private identity() {
        XsdQNameValue product("urn:catalog", " \tc:Product\r\n");
        assertEq("urn:catalog", product.getNamespaceUri());
        assertEq("Product", product.getLocalName());
        assertEq("c", product.getPrefix());
        assertEq("c:Product", product.getLexicalValue());
        assertTrue(product.equals(new XsdQNameValue("urn:catalog", "p:Product")));
        assertTrue(product.equals(new XsdQNameValue("urn:catalog", "Product")));
        assertFalse(product.equals(new XsdQNameValue("urn:other", "c:Product")));
        assertFalse(product.equals(new XsdQNameValue("urn:catalog", "c:product")));
        assertFalse(product.equals(new XsdQNameValue("", "Product")));
        XsdQNameValue unicode("urn:中文", "é:中文");
        assertEq("中文", unicode.getLocalName());
        assertEq("é", unicode.getPrefix());
        assertTrue(unicode.equals(new XsdQNameValue("urn:中文", "a:中文")));
        assertFalse(new XsdQNameValue("urn:a}", "b").equals(new XsdQNameValue("urn:a", "b")));
        assertFalse(product.equals(new XsdQNameValue("URN:catalog", "c:Product")));
        assertFalse(product.equals(new XsdQNameValue("urn:%63atalog", "c:Product")));
        assertFalse(new XsdQNameValue("urn:one", "é").equals(new XsdQNameValue("urn:one", "e\u0301")));
        foreach string encoding in ("UTF-16LE", "UTF-16BE", "ISO-8859-1") {
            XsdQNameValue encoded(convert_encoding("urn:café", encoding), convert_encoding("é:Product", encoding));
            assertTrue(encoded.equals(new XsdQNameValue("urn:café", "p:Product")));
            assertEq("é:Product", encoded.getLexicalValue());
        }
    }

    private contexts() {
        XsdQNameValue local = XsdQNameValue::fromLexical(" Product ", {});
        assertEq("", local.getNamespaceUri());
        assertEq("Product", local.getLexicalValue());
        XsdQNameValue qualified = XsdQNameValue::fromLexical("Product", {"": "urn:catalog"});
        assertEq("urn:catalog", qualified.getNamespaceUri());
        assertEq("", qualified.getPrefix());
        hash<string, string> bindings = {"p": "urn:catalog", "q": "urn:catalog"};
        XsdQNameValue first = XsdQNameValue::fromLexical("p:Product", bindings);
        XsdQNameValue second = XsdQNameValue::fromLexical("q:Product", bindings);
        bindings.p = "urn:changed";
        assertTrue(first.equals(second));
        assertEq("urn:catalog", first.getNamespaceUri());
        assertEq("urn:changed", XsdQNameValue::fromLexical("p:Product", bindings).getNamespaceUri());
        assertEq("http://www.w3.org/XML/1998/namespace", XsdQNameValue::fromLexical("xml:lang", {}).getNamespaceUri());
        assertEq("", XsdQNameValue::fromLexical("Product", {"": ""}).getNamespaceUri());
    }

    private invalid() {
        foreach string lexical in ("", " \t\n", "a:b:c", "a:", ":Name", "0name", "a:0name", "a b") {
            assertThrows("XSD-QNAME-VALUE-ERROR", sub() { new XsdQNameValue("urn:one", lexical); });
            assertThrows("XSD-QNAME-VALUE-ERROR", \XsdQNameValue::fromLexical(), (lexical, {}));
        }
        foreach list<string> invalid in (("", "p:Name"), ("urn:one", "xml:Name"),
                ("http://www.w3.org/XML/1998/namespace", "p:Name"),
                ("http://www.w3.org/XML/1998/namespace", "Name"),
                ("http://www.w3.org/2000/xmlns/", "p:Name"), ("urn:one", "xmlns:Name"),
                ("urn:\u0000", "p:Name"), ("urn:\v", "p:Name")) {
            assertThrows("XSD-QNAME-VALUE-ERROR", sub() { new XsdQNameValue(invalid[0], invalid[1]); });
        }
        assertThrows("XSD-QNAME-VALUE-ERROR", \XsdQNameValue::fromLexical(), ("p:Name", {}));
        foreach hash<string, string> bindings in ({"p": ""}, {"xml": "urn:wrong"},
                {"xmlns": "urn:wrong"}, {"p": "http://www.w3.org/XML/1998/namespace"},
                {"": "http://www.w3.org/XML/1998/namespace"}, {"0prefix": "urn:one"}) {
            assertThrows("XSD-QNAME-VALUE-ERROR", \XsdQNameValue::fromLexical(), ("Name", bindings));
        }
        foreach string uri in ("urn:\u0000", "urn:\v", "urn:\uFFFE") {
            assertThrows("XSD-QNAME-VALUE-ERROR", \XsdQNameValue::fromLexical(), ("Name", {"unused": uri}));
        }
        assertEq("Name", XsdQNameValue::fromLexical("Name", {}).getLocalName());
    }

    private reconstruction() {
        XsdQNameValue original("urn:catalog", "p:Product");
        XsdQNameValue restored = Serializable::deserialize(original.serialize());
        assertTrue(restored.equals(original));
        assertEq("p:Product", restored.getLexicalValue());
        assertEq("p", restored.getPrefix());
        foreach hash<auto> change in ({"namespace_uri": 0}, {"lexical": 0}, {"lexical": "a:b:c"},
                {"namespace_uri": ""}, {"namespace_uri": "http://www.w3.org/XML/1998/namespace"}) {
            hash<SerializationInfo> state = original.serializeToData();
            state._index."0"._class_data."WSDL::XsdQNameValue" += change;
            assertThrows("DESERIALIZATION-ERROR", \Serializable::deserialize(), (state,));
        }
        string lexical = restored.getLexicalValue();
        lexical += "Changed";
        assertEq("p:Product", restored.getLexicalValue());
        assertEq("urn:catalog", Serializable::deserialize(original.serialize()).getNamespaceUri());
    }

    private providers() {
        XsdQNameDataType original({"p": "urn:catalog", "q": "urn:catalog"});
        foreach XsdQNameDataType provider in (original, Serializable::deserialize(original.serialize()),
                original.getOrNothingType().getMandatoryType()) {
            assertEq("xsd:QName", provider.getName());
            assertEq("QName", provider.getBuiltinName());
            assertEq(NT_STRING, provider.getBaseTypeCode());
            assertEq("string", provider.getBaseTypeName());
            assertEq(NOTHING, provider.getValueType());
            assertEq(NOTHING, provider.getElementType());
            assertEq(NOTHING, provider.getFields());
            assertEq({}, provider.getDirectTypeHash());
            assertTrue(provider.getAcceptTypeHash(True).string);
            assertTrue(provider.getAcceptTypeHash(True).object);
            assertEq({"string": True, "object": True}, provider.getReturnTypeHash(True));
            assertTrue(provider.isMandatory());
            assertFalse(provider.isOrNothingType());
            XsdQNameValue first = provider.acceptsValue(" \tp:Product\r\n");
            assertEq("p:Product", first.getLexicalValue());
            assertTrue(first.equals(provider.acceptsValue("q:Product")));
            assertEq("urn:catalog", first.getNamespaceUri());
            assertEq("Product", first.getLocalName());
            XsdQNameValue explicit("urn:other", "p:Product");
            assertEq("urn:other", provider.acceptsValue(explicit).getNamespaceUri());
            assertEq("Name", provider.acceptsValue(" Name "));
            assertEq("xml:lang", provider.acceptsValue(" xml:lang "));
            assertEq("", provider.acceptsValue(new XsdQNameValue("", "Local")).getNamespaceUri());
            assertEq("xml:space", provider.acceptsValue(new XsdQNameValue(
                "http://www.w3.org/XML/1998/namespace", "xml:space")).getLexicalValue());
            assertThrows("MISSING-VALUE-ERROR", \provider.acceptsValue(), (NOTHING,));
        }
    }

    private providerContexts() {
        hash<string, string> bindings = {"": "urn:default", "p": "urn:catalog"};
        XsdQNameDataType original(bindings);
        bindings.p = "urn:changed";
        hash<string, string> returned = original.getNamespaceBindings();
        returned.p = "urn:changed-again";
        foreach XsdQNameDataType provider in (original, original.getOrNothingType(),
                Serializable::deserialize(original.serialize()),
                Serializable::deserialize(original.getOrNothingType().serialize())) {
            assertEq("urn:catalog", provider.acceptsValue("p:Product").getNamespaceUri());
            XsdQNameValue default_value = provider.acceptsValue("Product");
            assertEq("urn:default", default_value.getNamespaceUri());
            assertEq("", default_value.getPrefix());
            assertEq("Product", default_value.getLexicalValue());
            assertEq("xml:lang", provider.acceptsValue("xml:lang"));
            XsdQNameValue explicit_local("", "Local");
            XsdQNameValue once = provider.acceptsValue(explicit_local);
            XsdQNameValue twice = provider.acceptsValue(once);
            assertEq("", once.getNamespaceUri());
            assertTrue(twice.equals(explicit_local));
            assertEq("Local", twice.getLexicalValue());
            XsdQNameDataType other_default({"": "urn:other"});
            assertTrue(other_default.acceptsValue(twice).equals(explicit_local));
            if (provider.isOrNothingType()) {
                assertEq("*xsd:QName", provider.getName());
                assertFalse(provider.isMandatory());
                assertEq(NOTHING, provider.acceptsValue(NOTHING));
                assertTrue(provider.getAcceptTypeHash(True).nothing);
                assertEq({"string": True, "object": True, "nothing": True}, provider.getReturnTypeHash(True));
                assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), ("",));
                AbstractDataProviderType mandatory = provider.getMandatoryType();
                assertThrows("MISSING-VALUE-ERROR", \mandatory.acceptsValue(), (NOTHING,));
            }
        }
        assertTrue(original.isMandatory());
        assertEq("Name", new XsdQNameDataType({"": ""}).acceptsValue(" Name "));
    }

    private providerErrors() {
        XsdQNameDataType provider({"p": "urn:catalog"});
        foreach auto value in ("", " \t\r\n", "unbound:Name", "a:b:c", "0name", "p:0name", "p:",
                "p :Name", "p:Name\u00a0", "p:Name\u0000", (), {}, 0, new Namespaces({})) {
            assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (value,));
            assertEq("urn:catalog", provider.acceptsValue("p:Name").getNamespaceUri());
        }
        foreach hash<string, string> bindings in ({"p": ""}, {"xml": "urn:wrong"}, {"xmlns": "urn:one"},
                {"": "http://www.w3.org/XML/1998/namespace"}, {"p": "http://www.w3.org/2000/xmlns/"},
                {"a:b": "urn:one"}, {"0prefix": "urn:one"}, {"unused": "urn:\v"}) {
            assertThrows("XSD-SIMPLETYPE-ERROR", sub() { new XsdQNameDataType(bindings); });
        }
        foreach auto invalid in (NOTHING, 0, "yes") {
            hash<SerializationInfo> state = provider.serializeToData();
            state._index."0"._class_data."WSDL::XsdQNameDataType".optional = invalid;
            assertThrows("DESERIALIZATION-ERROR", \Serializable::deserialize(), (state,));
        }
        foreach auto invalid in (NOTHING, 0, "namespaces", {"p": ""}, {"p": 0}, {"xml": "urn:wrong"},
                {"bad:prefix": "urn:one"}, {"unused": "urn:\v"}) {
            hash<SerializationInfo> state = provider.serializeToData();
            state._index."0"._class_data."WSDL::XsdQNameDataType".namespaces = invalid;
            assertThrows("DESERIALIZATION-ERROR", \Serializable::deserialize(), (state,));
        }
        assertEq("urn:catalog", Serializable::deserialize(provider.serialize()).acceptsValue("p:Product").getNamespaceUri());
    }

    private containers() {
        XsdQNameDataType item({"p": "urn:catalog"});
        HashDataType record("Product");
        record.addQoreFields({
            "category": {"display_name": "Category", "type": item,
                "desc": "The product category's namespace and local name."},
            "related": {"display_name": "Related Categories", "type": new ListDataType(item),
                "desc": "Related product categories in their supplied order."},
        });
        foreach AbstractDataProviderType provider in (record, Serializable::deserialize(record.serialize())) {
            hash<auto> input = {"category": "p:Product", "related": ("p:Part", "xml:lang", "Local")};
            hash<auto> result = provider.acceptsValue(input);
            assertEq("urn:catalog", result.category.getNamespaceUri());
            assertEq("Product", result.category.getLocalName());
            assertEq(3, result.related.size());
            assertEq("Part", result.related[0].getLocalName());
            assertEq("urn:catalog", result.related[0].getNamespaceUri());
            assertEq("xml:lang", result.related[1]);
            assertEq("Local", result.related[2]);
            assertEq("p:Product", input.category);
            assertEq(("p:Part", "xml:lang", "Local"), input.related);
            assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), ({"category": "p:Product",
                "related": ("p:Part", "unknown:Part")},));
            assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), ({"category": "unknown:Product",
                "related": ("Local",)},));
        }
        XsdQNameValue explicit("urn:other", "p:Part");
        list<auto> values = new ListDataType(item).acceptsValue((explicit, "p:Part"));
        assertEq("urn:other", values[0].getNamespaceUri());
        assertEq("urn:catalog", values[1].getNamespaceUri());
        assertFalse(values[0].equals(values[1]));
    }

    private cancellation() {
        InterruptQNameValueProvider item();
        ListDataType provider(item);
        assertThrows("PROGRAM-INTERRUPTED", \provider.acceptsValue(), (("p:Product", "Local"),));
        item.interrupt = False;
        list<auto> values = provider.acceptsValue(("p:Product", "Local"));
        assertEq("urn:catalog", values[0].getNamespaceUri());
        assertEq("Local", values[1]);
    }

    private concurrency() {
        XsdQNameDataType provider({"p": "urn:catalog"});
        Qore::Thread::Queue ready();
        Qore::Thread::Queue start();
        Qore::Thread::Queue results();
        Qore::Thread::Counter running();
        on_exit {
            for (int i = 0; i < 4; ++i) {
                start.push(True);
            }
            assertEq(0, running.waitForZero(30s));
        }
        for (int i = 0; i < 4; ++i) {
            running.inc();
            background sub() {
                on_exit running.dec();
                try {
                    ready.push(True);
                    start.get(30s);
                    XsdQNameDataType optional = provider.getOrNothingType();
                    hash<string, string> bindings = optional.getNamespaceBindings();
                    bindings.p = "urn:other";
                    XsdQNameDataType other(bindings);
                    results.push((provider.acceptsValue("p:Product").getNamespaceUri(),
                        optional.acceptsValue("p:Product").getNamespaceUri(),
                        other.acceptsValue("p:Product").getNamespaceUri(),
                        optional.acceptsValue(NOTHING), provider.isMandatory()));
                } catch (hash<ExceptionInfo> ex) {
                    results.push({"error": ex});
                }
            }();
        }
        for (int i = 0; i < 4; ++i) {
            ready.get(30s);
        }
        for (int i = 0; i < 4; ++i) {
            start.push(True);
        }
        for (int i = 0; i < 4; ++i) {
            assertEq(("urn:catalog", "urn:catalog", "urn:other", NOTHING, True), results.get(30s));
        }
    }
}
