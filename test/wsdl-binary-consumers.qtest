#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%requires ../qlib/SoapClient.qm
%requires ../qlib/SoapHandler.qm
%requires HttpServer
%exec-class BinaryConsumersTest

class BinaryConsumerCallback {
    public {
        Queue requests();
        Queue responses();
    }

    hash<auto> call(hash<auto> cx, hash<auto> request) {
        requests.push(request);
        return responses.pop(30000);
    }
}

class BinaryConsumersTest inherits QUnit::Test {
    constructor() : Test("Binary SOAP consumers", "1.0") {
        addTestCase("Actual SOAP bindings preserve raw and native binary bytes over HTTP", \httpValues());
        set_return_value(main());
    }

    private WebService service(string version) {
        return new WebService('<w:definitions xmlns:w="http://schemas.xmlsoap.org/wsdl/"
            xmlns:t="urn:binary-consumers" xmlns:s="http://schemas.xmlsoap.org/wsdl/soap'
            + (version == "12" ? "12" : "") + '/" targetNamespace="urn:binary-consumers"><w:types>
            <xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:binary-consumers">
            <xs:simpleType name="Items"><xs:list itemType="xs:base64Binary"/></xs:simpleType>
            <xs:simpleType name="Either"><xs:union memberTypes="xs:base64Binary xs:string"/></xs:simpleType>
            <xs:simpleType name="Upper"><xs:restriction base="xs:hexBinary"><xs:enumeration value="ff"/>
            <xs:pattern value="FF"/></xs:restriction></xs:simpleType>
            <xs:simpleType name="Spaced"><xs:restriction base="xs:base64Binary"><xs:enumeration value="AA=="/>
            <xs:pattern value="A A = ="/></xs:restriction></xs:simpleType>
            <xs:complexType name="Record"><xs:sequence>
            <xs:element name="hex" type="xs:hexBinary"/><xs:element name="base64" type="xs:base64Binary"/>
            <xs:element name="empty" type="xs:base64Binary"/><xs:element name="large" type="xs:hexBinary"/>
            <xs:element name="items" type="t:Items"/><xs:element name="either" type="t:Either"/>
            <xs:element name="upper" type="t:Upper"/><xs:element name="spaced" type="t:Spaced"/>
            </xs:sequence><xs:attribute name="tag" type="xs:hexBinary" use="required"/>
            <xs:attribute name="fixedTag" type="xs:hexBinary" fixed="FF"/>
            </xs:complexType><xs:element name="Submit" type="t:Record"/><xs:element name="Reply" type="t:Record"/>
            </xs:schema></w:types><w:message name="In"><w:part name="body" element="t:Submit"/></w:message>
            <w:message name="Out"><w:part name="body" element="t:Reply"/></w:message>
            <w:portType name="Port"><w:operation name="submit"><w:input message="t:In"/>
            <w:output message="t:Out"/></w:operation></w:portType><w:binding name="Soap" type="t:Port">
            <s:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
            <w:operation name="submit"><s:operation soapAction="urn:submit"/><w:input><s:body use="literal"/>
            </w:input><w:output><s:body use="literal"/></w:output></w:operation></w:binding>
            <w:service name="Service"><w:port name="Port" binding="t:Soap"><s:address location="http://example.invalid/"/>
            </w:port></w:service></w:definitions>', {"async_only": True});
    }

    private hash<auto> record(bool response) {
        return {"hex": response ? "\u0000\r\n\t" : " a\tb ",
            "base64": response ? <fffefd000902> : <0009ff0d0a01>, "empty": binary(),
            "large": parse_hex_string(strmul(response ? "fe" : "01", 65536)),
            "items": (<00>, <0000>, <0009ff>),
            "either": response ? "AB==" : <0009ff>,
            "upper": new XsdBinaryValue("hexBinary", "FF"),
            "spaced": new XsdBinaryValue("base64Binary", "A A = ="),
            "^attributes^": {"tag": response ? <ff00> : <00ff>, "fixedTag": <ff>}};
    }

    private check(hash<auto> actual, bool response) {
        XsdBinaryValue upper = remove actual.upper;
        XsdBinaryValue spaced = remove actual.spaced;
        assertEq("FF", upper.getLexicalValue());
        assertEq(<ff>, upper.getBinaryValue());
        assertEq("A A = =", spaced.getLexicalValue());
        assertEq(<00>, spaced.getBinaryValue());
        hash<auto> expected = {"hex": response ? <000d0a09> : <2061096220>,
            "base64": response ? <fffefd000902> : <0009ff0d0a01>, "empty": binary(),
            "large": parse_hex_string(strmul(response ? "fe" : "01", 65536)),
            "items": (<00>, <0000>, <0009ff>), "either": response ? "AB==" : <0009ff>,
            "^attributes^": {"tag": response ? <ff00> : <00ff>, "fixedTag": <ff>}};
        assertEq(expected, actual);
    }

    private httpValues() {
        foreach string version in ("11", "12") {
            WebService original = service(version);
            foreach WebService ws in (original, Serializable::deserialize(original.serialize())) {
                HttpServer server();
                on_exit server.stop();
                SoapHandler handler(new PermissiveAuthenticator());
                server.setDefaultHandler("soap", handler);
                BinaryConsumerCallback callback();
                handler.addMethod(ws, ws.getBindingOperation("Soap", "submit"), \callback.call(), NOTHING,
                    NOTHING, NOTHING, "Service", NOTHING, NOTHING, "Soap");
                server.addListener(0);
                string url = sprintf("http://127.0.0.1:%d/Service", server.getListenerInfo(0).port);
                SoapClient client({"wsdl": ws, "url": url, "timeout": 30000, "connect_timeout": 30000});
                callback.responses.push(record(True));
                check(client.callOperation("submit", record(False)), True);
                check(callback.requests.pop(30000), False);
                hash<auto> invalid = record(False);
                invalid.base64 = 0;
                assertThrows("SOAP-SERIALIZATION-ERROR", \client.callOperation(), ("submit", invalid));
                invalid = record(False);
                invalid."^attributes^" = {"tag": False};
                assertThrows("SOAP-SERIALIZATION-ERROR", \client.callOperation(), ("submit", invalid));
                invalid = record(False);
                invalid.upper = <fe>;
                assertThrows("SOAP-SERIALIZATION-ERROR", \client.callOperation(), ("submit", invalid));
                callback.responses.push(record(True));
                check(client.callOperation("submit", record(False)), True);
                check(callback.requests.pop(30000), False);
            }
        }
    }
}
