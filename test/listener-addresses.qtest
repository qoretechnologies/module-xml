#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%requires QUnit
%exec-class ListenerAddressesTest

#! A call in a test source that listens on all interfaces
hashdecl ListenerFinding {
    #! the source file, relative to the scanned directory
    string file;
    #! the line of the call
    int line;
    #! the name of the call
    string call;
    #! why the call listens on all interfaces
    string reason;
}

#! The result of scanning test sources for listeners
hashdecl ListenerScan {
    #! the number of calls that listen
    int calls = 0;
    #! the calls that listen on all interfaces
    list<hash<ListenerFinding>> findings = ();
}

#! Finds the calls in Qore test sources that listen on all interfaces
/** A test's client connects to a loopback address or to a host name, and a socket that listens on all interfaces
    shares its port with any socket that another process binds to a more specific address of the same port.  On macOS
    a port-0 bind on the IPv6 wildcard address, which is what HttpServer::addListener(0) binds, can receive a port
    that an IPv4 socket of another process already holds on 127.0.0.1, and a client connecting to 127.0.0.1 then
    reaches that socket instead of the test's server.  A test listener therefore names the host its clients connect
    to.

    The scanner recognizes:
    - \c addListener() and \c addListenerAsync() with a listener option hash literal without a \c "node" or with a
      wildcard \c "node", and with any argument that is not a hash literal (an integer port listens on all
      interfaces)
    - \c addListeners() with a bind string without a host or with a wildcard host, or with an option hash literal as
      above
    - \c bindINET() without a node, with \c NOTHING or with a wildcard address
    - \c bind() with an integer port literal or with a string literal without a host or with a wildcard host; other
      arguments are not socket binds that the scanner can tell apart from other \c bind() methods

    Comments, string literals and regular expression literals are not code, so a call written in one is ignored.
*/
class ListenerScanner {
    public {
        #! the addresses that mean all interfaces
        const Wildcards = {"": True, "*": True, "0.0.0.0": True, "::": True, "[::]": True};

        #! the calls that listen
        const Calls = ("addListener", "addListenerAsync", "addListeners", "bindINET", "bind");

        #! the source files scanned
        const Sources = ("qtest", "qr", "qc", "qm");
    }

    #! scans the Qore sources under a directory, except AOT test copies and hidden directories
    static hash<ListenerScan> scanDirectory(string dir) {
        hash<ListenerScan> rv();
        scanDirectoryIntern(dir, "", \rv);
        return rv;
    }

    #! scans one source
    /** @param file the name reported in findings
        @param text the source
        @param scan the scan result to add to
    */
    static scanSource(string file, string text, reference<hash<ListenerScan>> scan) {
        hash<auto> lexed = lex(text);
        list<string> code = lexed.code;
        list<string> bare = lexed.bare;
        string bare_text = bare.join("");
        list<hash<ListenerFinding>> findings = ();
        foreach string call in (Calls) {
            int pos = 0;
            while ((pos = bare_text.find(call, pos)) >= 0) {
                int start = pos;
                pos += call.size();
                if (start && bare[start - 1] =~ /^[A-Za-z0-9_]$/) {
                    continue;
                }
                int open = pos;
                while (open < bare.size() && bare[open] =~ /^\s$/) {
                    ++open;
                }
                if (open == bare.size() || bare[open] != "(") {
                    continue;
                }
                int close = matching(bare, open);
                list<list<int>> args = split(bare, open + 1, close, ",");
                *hash<auto> listening = check(call, code, bare, args);
                if (!listening) {
                    continue;
                }
                ++scan.calls;
                if (listening.reason) {
                    int line = 1;
                    for (int i = 0; i < start; ++i) {
                        if (bare[i] == "\n") {
                            ++line;
                        }
                    }
                    push findings, <ListenerFinding>{
                        "file": file,
                        "line": line,
                        "call": call,
                        "reason": listening.reason,
                    };
                }
            }
        }
        scan.findings += sort(findings, int sub (hash<ListenerFinding> l, hash<ListenerFinding> r) {
            return l.line <=> r.line;
        });
    }

    #! returns the source with comments blanked, and a copy with string and regular expression contents blanked too
    /** Both keep every line break and the length of the source, so an offset in either is the same place in the
        source.
    */
    static hash<auto> lex(string text) {
        list<string> src = ();
        foreach string c in (text.iterator()) {
            push src, c;
        }
        list<string> code = src;
        list<string> bare = src;
        int n = src.size();
        int i = 0;
        while (i < n) {
            string c = src[i];
            if (c == "#") {
                for (; i < n && src[i] != "\n"; ++i) {
                    code[i] = bare[i] = " ";
                }
                continue;
            }
            if (c == "/" && i + 1 < n && src[i + 1] == "*") {
                int end = i + 2;
                while (end + 1 < n && (src[end] != "*" || src[end + 1] != "/")) {
                    ++end;
                }
                for (end = min(end + 2, n); i < end; ++i) {
                    if (src[i] != "\n") {
                        code[i] = bare[i] = " ";
                    }
                }
                continue;
            }
            if (c == "\"" || c == "'") {
                i = blankDelimited(src, \bare, i + 1, c);
                continue;
            }
            if ((c == "=" || c == "!") && i + 1 < n && src[i + 1] == "~") {
                i = blankRegex(src, \bare, i + 2);
                continue;
            }
            ++i;
        }
        return {"code": code, "bare": bare};
    }

    private static scanDirectoryIntern(string dir, string prefix, reference<hash<ListenerScan>> scan) {
        Dir d();
        d.chdir(dir);
        foreach string name in (sort(d.listFiles())) {
            *string ext = (name =~ x/\.([^.]+)$/)[0];
            if (!inlist(ext, Sources) || name =~ /\.aot\.qtest$/) {
                continue;
            }
            string text = ReadOnlyFile::readTextFile(dir + DirSep + name);
            if (text =~ /(addListener|bindINET|bind)\s*\(/) {
                scanSource(prefix + name, text, \scan);
            }
        }
        foreach string name in (sort(d.listDirs())) {
            if (name !~ /^\./) {
                scanDirectoryIntern(dir + DirSep + name, prefix + name + "/", \scan);
            }
        }
    }

    #! blanks a quoted string's contents and returns the offset after its closing quote
    private static int blankDelimited(list<string> src, reference<list<string>> bare, int i, string quote) {
        int n = src.size();
        while (i < n) {
            string c = src[i];
            if (c == quote) {
                return i + 1;
            }
            if (c != "\n") {
                bare[i] = " ";
            }
            if (c == "\\" && i + 1 < n) {
                if (src[i + 1] != "\n") {
                    bare[i + 1] = " ";
                }
                i += 2;
                continue;
            }
            ++i;
        }
        return n;
    }

    #! blanks a regular expression literal after =~ or !~ and returns the offset after it
    /** A match (\c /.../ or \c x/.../) has one part and a substitution (\c s/.../.../) or transliteration
        (\c tr/.../.../) has two; the options after the last delimiter are kept.  Anything else after the operator,
        such as a variable, is code, and the offset after the operator is returned.
    */
    private static int blankRegex(list<string> src, reference<list<string>> bare, int i) {
        int n = src.size();
        while (i < n && src[i] =~ /^\s$/) {
            ++i;
        }
        int parts;
        if (i < n && src[i] == "/") {
            parts = 1;
        } else if (i + 1 < n && src[i + 1] == "/" && (src[i] == "x" || src[i] == "s")) {
            parts = src[i] == "x" ? 1 : 2;
            ++i;
        } else if (i + 2 < n && src[i] == "t" && src[i + 1] == "r" && src[i + 2] == "/") {
            parts = 2;
            i += 2;
        } else {
            return i;
        }
        for (int part = 0; part < parts; ++part) {
            i = blankDelimited(src, \bare, i + 1, "/") - 1;
        }
        return i + 1;
    }

    #! returns the offset of the bracket that closes the bracket at the given offset, or the end of the source
    private static int matching(list<string> bare, int open) {
        int depth = 0;
        for (int i = open, int n = bare.size(); i < n; ++i) {
            string c = bare[i];
            if (c == "(" || c == "[" || c == "{") {
                ++depth;
            } else if (c == ")" || c == "]" || c == "}") {
                if (!--depth) {
                    return i;
                }
            }
        }
        return bare.size();
    }

    #! splits the range at the separators outside brackets and returns the [start, end) range of each part
    private static list<list<int>> split(list<string> bare, int start, int end, string sep) {
        list<list<int>> rv = ();
        int depth = 0;
        int part = start;
        for (int i = start; i < end; ++i) {
            string c = bare[i];
            if (c == "(" || c == "[" || c == "{") {
                ++depth;
            } else if (c == ")" || c == "]" || c == "}") {
                --depth;
            } else if (!depth && c == sep) {
                push rv, (part, i);
                part = i + 1;
            }
        }
        if (part < end && trim(bare[part..end - 1].join("")) != "") {
            push rv, (part, end);
        }
        return rv;
    }

    #! returns the code of a range with surrounding whitespace removed
    private static string text(list<string> code, list<int> range) {
        return range[0] < range[1] ? trim(code[range[0]..range[1] - 1].join("")) : "";
    }

    #! returns the value of a string literal, or NOTHING if the code is not a single string literal
    private static *string literal(string code) {
        *list<*string> m = code =~ x/^"([^"\\]*)"$/;
        if (m) {
            return m[0] ?? "";
        }
        m = code =~ x/^'([^'\\]*)'$/;
        if (m) {
            return m[0] ?? "";
        }
    }

    #! returns why a listener option hash literal listens on all interfaces, or NOTHING if it names a host
    /** @return NOTHING also if the range is not a hash literal
    */
    private static *string checkOptions(list<string> code, list<string> bare, list<int> range, reference<bool> hash) {
        int i = range[0];
        while (i < range[1] && bare[i] =~ /^\s$/) {
            ++i;
        }
        if (i < range[1] && bare[i] == "<") {
            while (i < range[1] && bare[i] != ">") {
                ++i;
            }
            ++i;
            while (i < range[1] && bare[i] =~ /^\s$/) {
                ++i;
            }
        }
        if (i == range[1] || bare[i] != "{") {
            hash = False;
            return;
        }
        hash = True;
        int close = matching(bare, i);
        foreach list<int> entry in (split(bare, i + 1, close, ",")) {
            list<list<int>> kv = split(bare, entry[0], entry[1], ":");
            if (kv.size() < 2 || literal(text(code, kv[0])) != "node") {
                continue;
            }
            string value = text(code, (kv[1][0], entry[1]));
            *string address = literal(value);
            if (exists address && Wildcards{address}) {
                return sprintf("the listener's \"node\" %y is a wildcard address", address);
            }
            return;
        }
        return "the listener options have no \"node\", so it listens on all interfaces";
    }

    #! returns why a bind string listens on all interfaces, or NOTHING if it names a host
    private static *string checkBind(string bind) {
        if (bind =~ /^[0-9]+$/) {
            return sprintf("the bind %y has no host, so it listens on all interfaces", bind);
        }
        *list<*string> m = bind =~ x/^(.*):[0-9]+$/;
        if (m && Wildcards{m[0] ?? ""}) {
            return sprintf("the bind %y has a wildcard host", bind);
        }
    }

    #! returns NOTHING if the call does not listen, or a hash with the reason why it listens on all interfaces
    /** The \c reason is NOTHING if the call names its host.
    */
    private static *hash<auto> check(string call, list<string> code, list<string> bare, list<list<int>> args) {
        switch (call) {
            case "bind": {
                *string arg = args ? text(code, args[0]) : NOTHING;
                if (!exists arg) {
                    return;
                }
                if (arg =~ /^[0-9]+$/) {
                    return {"reason": sprintf("the port %s has no host, so the socket binds all interfaces", arg)};
                }
                *string bind = literal(arg);
                # another argument is not a socket bind that the scanner can tell apart from other bind() methods
                return exists bind ? {"reason": checkBind(bind)} : NOTHING;
            }
        }
        return {"reason": checkListener(call, code, bare, args)};
    }

    #! returns why a listening call other than bind() listens on all interfaces, or NOTHING if it names a host
    private static *string checkListener(string call, list<string> code, list<string> bare, list<list<int>> args) {
        switch (call) {
            case "addListener":
            case "addListenerAsync": {
                if (!args) {
                    return "the call has no listener options";
                }
                bool hash;
                *string reason = checkOptions(code, bare, args[0], \hash);
                if (!hash) {
                    return sprintf("the argument %y is not a listener option hash with a \"node\"; a port number "
                        "listens on all interfaces", text(code, args[0]));
                }
                return reason;
            }
            case "addListeners": {
                if (!args) {
                    return "the call has no bind address";
                }
                bool hash;
                *string reason = checkOptions(code, bare, args[0], \hash);
                if (hash) {
                    return reason;
                }
                *string bind = literal(text(code, args[0]));
                return exists bind ? checkBind(bind) : NOTHING;
            }
            case "bindINET": {
                if (!args) {
                    return "the call has no address, so it binds all interfaces";
                }
                string node = text(code, args[0]);
                *string address = literal(node);
                if (node == "NOTHING") {
                    return "the address NOTHING binds all interfaces";
                }
                if (exists address && Wildcards{address}) {
                    return sprintf("the address %y is a wildcard address", address);
                }
                return;
            }
        }
    }
}

public class ListenerAddressesTest inherits QUnit::Test {
    constructor() : Test("ListenerAddressesTest", "1.0") {
        addTestCase("Every way a test can listen on all interfaces is reported with its line", \wildcards());
        addTestCase("A listener that names its host, and code that is not a call, is not reported", \named());
        addTestCase("No test listens on all interfaces", \tests());
        set_return_value(main());
    }

    private hash<ListenerScan> scan(string text) {
        hash<ListenerScan> rv();
        ListenerScanner::scanSource("sample", text, \rv);
        return rv;
    }

    private list<string> describe(list<hash<ListenerFinding>> findings) {
        return map sprintf("%s:%d: %s(): %s", $1.file, $1.line, $1.call, $1.reason), findings;
    }

    wildcards() {
        list<string> lines = (
            "server.addListener(0);",
            "port = addListener(port).port;",
            "server.addListener(<HttpListenerOptionInfo>{\"service\": 0});",
            "server.addListener(<HttpListenerOptionInfo>{",
            "    \"service\": 0,",
            "    \"cert\": new SSLCertificate(ReadOnlyFile::readTextFile(dir + \"cert.pem\")),",
            "});",
            "server.addListener({\"node\": \"0.0.0.0\", \"service\": 0});",
            "server.addListener(<HttpListenerOptionInfo>{\"node\": \"::\", \"service\": 0});",
            "server.addListenerAsync(0).get();",
            "server.addListeners(\"8080\", opts);",
            "server.addListeners(\"*:8080\", opts);",
            "server.addListeners(<HttpListenerOptionInfo>{\"service\": 8080});",
            "listener.bindINET(NOTHING, 0, True);",
            "listener.bindINET(\"0.0.0.0\", 0, True);",
            "listener.bindINET(\"[::]\", 0, True);",
            "s.bind(8080);",
            "s.bind(\"*:0\");",
            "s.bind(\"0\");",
            "listener.bindINET();",
        );
        hash<ListenerScan> result = scan(lines.join("\n"));
        assertEq(17, result.calls, "every call that listens is examined");
        assertEq((
            "sample:1: addListener(): the argument \"0\" is not a listener option hash with a \"node\"; a port "
                "number listens on all interfaces",
            "sample:2: addListener(): the argument \"port\" is not a listener option hash with a \"node\"; a port "
                "number listens on all interfaces",
            "sample:3: addListener(): the listener options have no \"node\", so it listens on all interfaces",
            "sample:4: addListener(): the listener options have no \"node\", so it listens on all interfaces",
            "sample:8: addListener(): the listener's \"node\" \"0.0.0.0\" is a wildcard address",
            "sample:9: addListener(): the listener's \"node\" \"::\" is a wildcard address",
            "sample:10: addListenerAsync(): the argument \"0\" is not a listener option hash with a \"node\"; a "
                "port number listens on all interfaces",
            "sample:11: addListeners(): the bind \"8080\" has no host, so it listens on all interfaces",
            "sample:12: addListeners(): the bind \"*:8080\" has a wildcard host",
            "sample:13: addListeners(): the listener options have no \"node\", so it listens on all interfaces",
            "sample:14: bindINET(): the address NOTHING binds all interfaces",
            "sample:15: bindINET(): the address \"0.0.0.0\" is a wildcard address",
            "sample:16: bindINET(): the address \"[::]\" is a wildcard address",
            "sample:17: bind(): the port 8080 has no host, so the socket binds all interfaces",
            "sample:18: bind(): the bind \"*:0\" has a wildcard host",
            "sample:19: bind(): the bind \"0\" has no host, so it listens on all interfaces",
            "sample:20: bindINET(): the call has no address, so it binds all interfaces",
        ), describe(result.findings));
    }

    named() {
        list<string> lines = (
            "server.addListener(<HttpListenerOptionInfo>{\"node\": \"127.0.0.1\", \"service\": 0});",
            "server.addListener(<HttpListenerOptionInfo>{\"node\":\"localhost\",\"service\":0}).port;",
            "server.addListener(<HttpListenerOptionInfo>{\"node\": host, \"service\": port});",
            "server.addListener(<HttpListenerOptionInfo>{",
            "    \"node\": \"127.0.0.1\", # the client's host",
            "    \"service\": 0,",
            "    \"cert\": new SSLCertificate(ReadOnlyFile::readTextFile(dir + \"cert.pem\")),",
            "});",
            "server.addListeners(\"127.0.0.1:8080\", opts);",
            "server.addListeners(bind, opts);",
            "listener.bindINET(\"127.0.0.1\", 0, True);",
            "listener.bindINET(\"::1\", 0, True);",
            "s.bind(\"127.0.0.1:0\");",
            "ldap.bind(dn, password);",
            "# server.addListener(0);",
            "/* listener.bindINET(NOTHING, 0); */",
            "string doc = \"server.addListener(0)\";",
            "string accept = \"*/*\"; server.addListener(<HttpListenerOptionInfo>{\"node\": \"::1\", \"service\": 0});",
            "bool comment = text =~ /#\"/; server.addListener(<HttpListenerOptionInfo>{\"node\": \"::1\", \"service\": 0});",
            "text =~ s/addListener\\(0\\)/x/g;",
            "code c = \\server.reAddListener(0);",
            "server.addListenerInfo(0);",
        );
        hash<ListenerScan> result = scan(lines.join("\n"));
        assertEq(11, result.calls, "every call that listens is examined");
        assertEq((), describe(result.findings));
    }

    tests() {
        hash<ListenerScan> result = ListenerScanner::scanDirectory(get_script_dir());
        # the test servers and peers of this repository make well over a hundred listening calls, so a scan that
        # finds far fewer has stopped recognizing them
        assertGt(150, result.calls, "listening calls examined");
        assertEq((), describe(result.findings));
    }
}
