#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class AttributeConsumersTest

class AttributeConsumersTest inherits QUnit::Test {
    constructor() : QUnit::Test("WSDL attribute consumers", "1.0") {
        addTestCase("Provider fields expose attributes and mandatory uses", \fields());
        addTestCase("Provider defaults preserve false, zero and empty strings", \defaults());
        addTestCase("Required fixed attributes remain required and constrain supplied values", \requiredFixed());
        addTestCase("Provider enumeration choices retain typed values", \enumerations());
        addTestCase("Attribute presence is independent of wildcard, union and list value types", \presence());
        addTestCase("Provider fields retain colliding expanded attribute names", \collisions());
        addTestCase("Generated examples honor constraints on complex and simple content", \examples());
        addTestCase("Provider metadata and examples survive WebService reconstruction", \reconstruction());
        addTestCase("Simple-content providers expose structured fields and require declared attributes", \simpleFields());
        addTestCase("Simple-content scalar callers retain their scalar types", \simpleScalars());
        addTestCase("Structured simple content rejects invalid fields without scalar fallback", \simpleInvalid());
        addTestCase("Nested simple-content enumerations constrain the value field", \simpleEnumeration());
        set_return_value(main());
    }

    private WebService parse(string content, string declarations = "") {
        return new WebService('<definitions xmlns="http://schemas.xmlsoap.org/wsdl/" xmlns:t="urn:consumers"
            targetNamespace="urn:consumers"><types><xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
            targetNamespace="urn:consumers">' + declarations + '<xs:complexType name="Record">' + content
            + '</xs:complexType><xs:element name="record" type="t:Record"/></xs:schema></types></definitions>',
            {"async_only": True});
    }

    private AbstractDataProviderType provider(WebService ws) {
        return ws.getElement("urn:consumers", "record").getDataProviderType();
    }

    fields() {
        foreach string content in ("", '<xs:sequence><xs:element name="child" type="xs:int"/></xs:sequence>',
                '<xs:all><xs:element name="child" type="xs:int"/></xs:all>',
                '<xs:choice><xs:element name="child" type="xs:int"/></xs:choice>') {
            WebService ws = parse(content + '<xs:attribute name="code" type="xs:int" use="required"/>
                <xs:attribute name="note"/><xs:attribute name="forbidden" use="prohibited"/>');
            AbstractDataProviderType p = provider(ws);
            auto attr = p.getFields()."^attributes^";
            assertTrue(exists attr);
            assertTrue(attr.isMandatory());
            assertTrue(attr.getType().getFields().code.isMandatory());
            assertFalse(attr.getType().getFields().note.isMandatory());
            assertFalse(attr.getType().getFields().hasKey("forbidden"));
            hash<auto> value();
            value."^attributes^" = {"code": "7"};
            if (content) {
                value.child = 8;
            }
            assertEq(7, p.acceptsValue(value)."^attributes^".code);
            assertEq("7", value."^attributes^".code);
            assertThrows("MISSING-VALUE-ERROR", \p.acceptsValue(), (content ? {"child": 8} : {},));
            assertThrows("MISSING-VALUE-ERROR", \p.acceptsValue(), (NOTHING,));
            value."^attributes^".unknown = "bad";
            assertThrows("RUNTIME-TYPE-ERROR", \p.acceptsValue(), (value,));
        }
    }

    defaults() {
        WebService ws = parse('<xs:attribute name="flag" type="xs:boolean" default="false"/>
            <xs:attribute name="count" type="xs:int" default="0"/><xs:attribute name="text" default=""/>');
        AbstractDataProviderType p = provider(ws);
        hash<auto> expected = {"^attributes^": {"flag": False, "count": 0, "text": ""}};
        assertEq(expected, p.acceptsValue({}));
        assertEq(expected, p.acceptsValue({"^attributes^": {}}));
        assertEq(False, p.getFields()."^attributes^".getType().getFields().flag.getDefaultValue());
        assertFalse(p.getFields()."^attributes^".isMandatory());
        assertEq({"^attributes^": {"flag": True, "count": 2, "text": "explicit"}},
            p.acceptsValue({"^attributes^": {"flag": "true", "count": 2, "text": "explicit"}}));
        assertEq(expected, ws.getElement("urn:consumers", "record").type.deserializeValue("record",
            ws.getTypeMap(), NOTHING, {}));
    }

    requiredFixed() {
        AbstractDataProviderType p = provider(parse('<xs:attribute name="code" fixed="EUR" use="required"/>'));
        auto code = p.getFields()."^attributes^".getType().getFields().code;
        assertEq(NOTHING, code.getDefaultValue());
        assertEq("EUR", code.getExampleValue());
        assertEq(({"value": "EUR", "display_name": "EUR"},), code.getAllowedValues());
        assertTrue(code.getInfo().type.mandatory);
        assertThrows("MISSING-VALUE-ERROR", \code.getType().acceptsValue(), (NOTHING,));
        assertThrows("RUNTIME-TYPE-ERROR", \p.acceptsValue(), ({"^attributes^": {}},));
        assertThrows("RUNTIME-TYPE-ERROR", \p.acceptsValue(), ({"^attributes^": {"code": "USD"}},));
        assertEq({"^attributes^": {"code": "EUR"}}, p.acceptsValue({"^attributes^": {"code": "EUR"}}));
        AbstractDataProviderType optional = provider(parse('<xs:attribute name="flag" type="xs:boolean" fixed="false"/>'));
        assertEq(False, optional.acceptsValue({"^attributes^": {"flag": "false"}})."^attributes^".flag);
        assertThrows("RUNTIME-TYPE-ERROR", \optional.acceptsValue(), ({"^attributes^": {"flag": True}},));
    }

    enumerations() {
        AbstractDataProviderType p = provider(parse('<xs:attribute name="count"><xs:simpleType>
            <xs:restriction base="xs:int"><xs:enumeration value="0"/><xs:enumeration value="2"/>
            </xs:restriction></xs:simpleType></xs:attribute>'));
        assertEq(({"value": 0, "display_name": "0"}, {"value": 2, "display_name": "2"}),
            p.getFields()."^attributes^".getType().getFields().count.getAllowedValues());
        assertEq(0, p.acceptsValue({"^attributes^": {"count": "0"}})."^attributes^".count);
        assertThrows("RUNTIME-TYPE-ERROR", \p.acceptsValue(), ({"^attributes^": {"count": 1}},));
    }

    collisions() {
        WebService ws = parse('<xs:attribute name="code" type="xs:int" use="required"/>
            <xs:attribute ref="t:code"/>', '<xs:attribute name="code" type="xs:boolean" fixed="false"/>');
        AbstractDataProviderType p = provider(ws);
        assertEq(("{}code", "{urn:consumers}code"), keys p.getFields()."^attributes^".getType().getFields());
        assertEq({"^attributes^": {"{}code": 7, "{urn:consumers}code": False}},
            p.acceptsValue({"^attributes^": {"{}code": 7}}));
        assertThrows("RUNTIME-TYPE-ERROR", \p.acceptsValue(),
            ({"^attributes^": {"{}code": 7, "code": "ambiguous"}},));
    }

    presence() {
        foreach string declaration in ("", '<xs:simpleType><xs:union memberTypes="xs:int xs:boolean"/>
                </xs:simpleType>', '<xs:simpleType><xs:list itemType="xs:int"/></xs:simpleType>') {
            WebService ws = parse('<xs:attribute name="value" use="required">' + declaration + '</xs:attribute>');
            AbstractDataProviderType t = provider(ws).getFields()."^attributes^".getType().getFields().value.getType();
            assertTrue(t.isMandatory());
            assertThrows("MISSING-VALUE-ERROR", \t.acceptsValue(), (NOTHING,));
            AbstractDataProviderType optional = t.getOrNothingType();
            assertFalse(optional.isMandatory());
            assertEq(NOTHING, optional.acceptsValue(NOTHING));
            AbstractDataProviderType mandatory = optional.getMandatoryType();
            assertThrows("MISSING-VALUE-ERROR", \mandatory.acceptsValue(), (NOTHING,));
            assertTrue(t.isMandatory());
            if (declaration =~ /xs:list/) {
                assertEq((0, 7), t.acceptsValue(("0", "7")));
                assertEq("softint", t.getElementType().getName());
            } else {
                assertEq(7, t.acceptsValue(7));
            }
        }
    }

    examples() {
        string attributes = '<xs:attribute name="code" fixed="EUR" use="required"/>
            <xs:attribute name="flag" type="xs:boolean" fixed="false"/>
            <xs:attribute name="count" type="xs:int" default="0"/><xs:attribute name="text" default=""/>';
        foreach string content in (attributes, '<xs:sequence><xs:element name="child" type="xs:int"/>
                </xs:sequence>' + attributes,
                '<xs:simpleContent><xs:extension base="xs:string">' + attributes
                + '</xs:extension></xs:simpleContent>') {
            WebService ws = parse(content);
            XsdElement elem = ws.getElement("urn:consumers", "record");
            hash<auto> sample = new WSMessageHelper(ws).getMessage(elem).record;
            assertEq({"code": "EUR", "flag": False, "count": 0, "text": ""}, sample."^attributes^");
            hash<auto> wire = elem.type.serializeValue(ws.nsc, sample, True);
            assertEq({"code": "EUR", "flag": "false", "count": 0, "text": ""}, wire."^attributes^");
        }
    }

    reconstruction() {
        WebService original = parse('<xs:attribute name="code" fixed="EUR" use="required"/>');
        WebService restored = Serializable::deserialize(original.serialize());
        hash<auto> before = provider(original).getFields()."^attributes^".getType().getFields().code.getInfo();
        hash<auto> after = provider(restored).getFields()."^attributes^".getType().getFields().code.getInfo();
        # Provider object identities differ after reconstruction; compare the contract metadata.
        delete before.unique_key;
        delete before.type.unique_key;
        delete after.unique_key;
        delete after.type.unique_key;
        assertEq(before, after);
        hash<auto> sample = new WSMessageHelper(restored).getMessage(restored.getElement("urn:consumers", "record"));
        assertEq({"record": {"^attributes^": {"code": "EUR"}}}, sample);
        assertEq(sample.record, provider(restored).acceptsValue(sample.record));
    }

    simpleFields() {
        WebService ws = parse('<xs:simpleContent><xs:extension base="xs:int">
            <xs:attribute name="unit" use="required"/><xs:attribute name="flag" type="xs:boolean" default="false"/>
            </xs:extension></xs:simpleContent>');
        AbstractDataProviderType p = provider(ws);
        assertEq(("^value^", "^attributes^"), keys p.getFields());
        assertTrue(p.getFields()."^attributes^".isMandatory());
        assertTrue(p.getFields()."^value^".isMandatory());
        assertTrue(p.getInfo().mandatory);
        assertTrue(p.getReturnTypeHash(True).hash);
        assertFalse(p.getReturnTypeHash(True).int ?? False);
        hash<auto> input = {"^value^": "0", "^attributes^": {"unit": "cm"}};
        assertEq({"^value^": 0, "^attributes^": {"unit": "cm", "flag": False}}, p.acceptsValue(input));
        assertEq("0", input."^value^");
        assertFalse(input."^attributes^".hasKey("flag"));
        assertThrows("MISSING-VALUE-ERROR", \p.acceptsValue(), (0,));
        AbstractDataProviderType optional = p.getOrNothingType();
        assertEq(NOTHING, optional.acceptsValue(NOTHING));
        assertFalse(optional.getInfo().mandatory);
        assertTrue(optional.getReturnTypeHash(True).nothing);
        assertTrue(p.isMandatory());
        AbstractDataProviderType mandatory = optional.getMandatoryType();
        assertTrue(mandatory.isMandatory());
        assertThrows("MISSING-VALUE-ERROR", \mandatory.acceptsValue(), (NOTHING,));
        assertTrue(optional.getFields()."^attributes^".isMandatory());
        assertThrows("MISSING-VALUE-ERROR", \optional.acceptsValue(), (0,));
        WebService restored = Serializable::deserialize(ws.serialize());
        assertEq(p.acceptsValue(input), provider(restored).acceptsValue(input));
        AbstractDataProviderType restored_type = Serializable::deserialize(p.serialize());
        assertEq(p.acceptsValue(input), restored_type.acceptsValue(input));
        assertTrue(restored_type.getInfo().mandatory);
    }

    simpleScalars() {
        foreach hash<auto> c in ({"base": "xs:boolean", "input": "false", "expected": False},
                {"base": "xs:int", "input": "0", "expected": 0},
                {"base": "xs:string", "input": "", "expected": ""}) {
            WebService ws = parse('<xs:simpleContent><xs:extension base="' + c.base
                + '"><xs:attribute name="unit" default="cm"/></xs:extension></xs:simpleContent>');
            AbstractDataProviderType p = provider(ws);
            auto scalar = p.acceptsValue(c.input);
            assertEq(c.expected, scalar);
            assertEq(c.expected.typeCode(), scalar.typeCode());
            auto structured = p.acceptsValue({"^value^": c.input});
            assertEq({"^value^": c.expected, "^attributes^": {"unit": "cm"}}, structured);
            assertEq(c.expected.typeCode(), structured."^value^".typeCode());
        }
    }

    simpleInvalid() {
        AbstractDataProviderType p = provider(parse('<xs:simpleContent><xs:extension base="xs:string">
            <xs:attribute name="unit" fixed="cm"/></xs:extension></xs:simpleContent>'));
        foreach hash<auto> invalid in ({"^value^": "text", "unexpected": "child"},
                {"^value^": "text", "^attributes^": {"unit": "wrong"}},
                {"^value^": "text", "^attributes^": {"unknown": "bad"}}) {
            assertThrows("RUNTIME-TYPE-ERROR", \p.acceptsValue(), (invalid,));
        }
        assertThrows("MISSING-VALUE-ERROR", \p.acceptsValue(), ({"^attributes^": {"unit": "cm"}},));
        assertEq({"^value^": "text", "^attributes^": {"unit": "cm"}}, p.acceptsValue({"^value^": "text"}));
    }

    simpleEnumeration() {
        WebService ws = parse('<xs:sequence><xs:element name="value" type="t:Value"/></xs:sequence>',
            '<xs:simpleType name="Codes"><xs:restriction base="xs:int"><xs:enumeration value="0"/>
            <xs:enumeration value="2"/></xs:restriction></xs:simpleType><xs:complexType name="Value">
            <xs:simpleContent><xs:extension base="t:Codes"><xs:attribute name="unit" fixed="cm"/>
            </xs:extension></xs:simpleContent></xs:complexType>');
        AbstractDataProviderType p = provider(ws);
        assertEq((0, 2), ws.findType(make_qname("urn:consumers", "Value")).getAllowedValues());
        assertEq({"value": 0}, p.acceptsValue({"value": "0"}));
        assertEq({"value": {"^value^": 2, "^attributes^": {"unit": "cm"}}},
            p.acceptsValue({"value": {"^value^": "2"}}));
        assertThrows("RUNTIME-TYPE-ERROR", \p.acceptsValue(), ({"value": {"^value^": 1}},));
        assertThrows("RUNTIME-TYPE-ERROR", \p.acceptsValue(), ({"value": 1},));
        assertEq(({"value": 0, "display_name": "0"}, {"value": 2, "display_name": "2"}),
            p.getFields().value.getType().getFields()."^value^".getAllowedValues());
    }
}
