#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires HttpServer
%requires HttpServerUtil
%requires ../qlib/WSDL.qm
%requires ../qlib/SoapHandler.qm

%exec-class SoapHandlerCredentialsTest

#! The code of a restricted Program that a trusted SoapHandler calls with the request context gets it without the
#! credentials of the request (qore#7303)
/** A method, a response resource provider, an error function, a response endpoint authorizer and a header processor
    of a %Program that a sandbox that does not trust its code governs get the request without its credentials, the
    objects of the server and code or objects of another %Program, and with the SOAP keys of the handler; trusted
    code gets the request as before
*/

#! a hang guard only, never a timing assertion
const HangGuard = 20s;

class SoapHandlerCredentialsTest inherits QUnit::Test {
    public {
        #! the tenant's code: records what of the request it saw
        const TenantSource = "%modern
%requires WSDL
%requires SoapHandler
%requires HttpServer

# the keys of the request context whose values are or hold an object or code, other than soap_processing
list<string> sub objects(hash<auto> cx) {
    return select keys cx, $1 != \"soap_processing\" && holds_object(cx{$1});
}

bool sub holds_object(auto v) {
    if (v.typeCode() == NT_OBJECT || v.callp()) {
        return True;
    }
    switch (v.typeCode()) {
        case NT_HASH: foreach string k in (keys v) { if (holds_object(v{k})) { return True; } } break;
        case NT_LIST: foreach auto e in (v) { if (holds_object(e)) { return True; } } break;
    }
    return False;
}

# True if the request header field is in a header hash of the context
bool sub has_field(hash<auto> cx, string name) {
    foreach auto h in ((cx.http_header, cx.hdr, cx.\"header-info\".\"headers-raw\")) {
        foreach string k in (keys h) {
            if (k.lwr() == name) {
                return True;
            }
        }
    }
    return False;
}

hash<auto> sub seen(string what, hash<auto> cx) {
    return {
        \"what\": what,
        \"auth\": exists cx.auth,
        \"authorization\": has_field(cx, \"authorization\"),
        \"cookie\": has_field(cx, \"cookie\"),
        \"host\": exists cx.http_header.host,
        \"soap_action\": cx.soap_action,
        \"soap_processing\": exists cx.soap_processing,
        \"processing_objects\": holds_object(map $1.value, cx.soap_processing.headers),
        \"processing_values\": (map $1.value, cx.soap_processing.headers, $1.value.typeCode() == NT_STRING),
        \"http_body\": exists cx.http_body,
        \"soap_response\": cx.soap_response,
        \"addressing\": exists cx.addressing.message_id,
        \"operation\": exists cx.operation,
        \"function\": exists cx.function,
        \"cmark\": cx.cmark,
        \"objects\": objects(cx),
    };
}

# the method of the operation: an invalid price fails the serialization of the response and calls the error function
code sub get_method(Queue q) {
    return auto sub (hash<auto> cx, auto symbol) {
        q.push(seen(\"method\", cx));
        return symbol == \"BAD\" ? \"not-a-price\" : 1.5;
    };
}

code sub get_err_func(Queue q) {
    return sub (hash<auto> cx, hash<auto> ex) {
        q.push(seen(\"err_func\", cx));
    };
}

code sub get_provider(Queue q) {
    return auto sub (hash<auto> cx) {
        q.push(seen(\"provider\", cx));
        return {\"body\": 2.5};
    };
}

code sub get_authorizer(Queue q) {
    return bool sub (hash<auto> cx, hash<WsaEndpointReference> endpoint) {
        q.push(seen(\"authorizer\", cx));
        return False;
    };
}

code sub get_processor(Queue q) {
    return auto sub (hash<auto> cx, hash<SoapNodeHeader> header) {
        q.push(seen(\"processor\", cx));
        return \"probe-value\";
    };
}

# a handler of the tenant's own class
class TenantHandler inherits SoapHandler {
    public {
        Queue q;
    }

    constructor(Queue q) : SoapHandler(new PermissiveAuthenticator()) {
        self.q = q;
    }

    private nothing msglog(hash<auto> cx, hash<auto> msg) {
        if (msg.reason == \"request\") {
            q.push(seen(\"msglog\", cx) + {\"msg_authorization\": exists msg.header.authorization,
                \"msg_cookie\": exists msg.header.cookie});
        }
    }
}

# a reply receiver of the tenant's own class
class TenantReceiver inherits WsaReplyReceiver {
    public {
        Queue q;
    }

    constructor(Queue q) : WsaReplyReceiver(<WsaEndpointReference>{\"address\": \"http://127.0.0.1/reply\"}) {
        self.q = q;
    }

    bool deliver(hash<WsaReceivedMessage> message) {
        q.push({\"what\": \"receiver\", \"authorization\": exists message.headers.authorization,
            \"cookie\": exists message.headers.cookie, \"host\": exists message.headers.host,
            \"addressing\": message.addressing.relates_to[0].message_id});
        return True;
    }
}

WsaReplyReceiver sub get_receiver(Queue q) {
    return new TenantReceiver(q);
}

# a reply receiver of the WSDL module's own class that the tenant creates and waits on
WsaReplyReceiver sub get_plain_receiver() {
    WsaReplyReceiver receiver(<WsaEndpointReference>{\"address\": \"http://127.0.0.1/reply\"});
    receiver.expect(\"urn:uuid:r1\");
    return receiver;
}

hash<auto> sub wait_reply(WsaReplyReceiver receiver) {
    hash<WsaReceivedMessage> message = receiver.wait(\"urn:uuid:r1\", 20s);
    return {\"authorization\": exists message.headers.authorization, \"cookie\": exists message.headers.cookie,
        \"host\": exists message.headers.host};
}

SoapHandler sub get_handler(WebService ws, Queue q) {
    TenantHandler handler(q);
    handler.addMethod(ws, ws.getOperation(\"ask\"), get_method(q), NOTHING, NOTHING, \"tenant-mark\", \"q12\",
        get_err_func(q), NOTHING, \"B12\");
    return handler;
}
";

        const Template = '<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"
            xmlns:soap12="http://schemas.xmlsoap.org/wsdl/soap12/"
            xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:wsp="http://www.w3.org/ns/ws-policy"
            xmlns:wsam="http://www.w3.org/2007/05/addressing/metadata"
            xmlns:x="urn:quotes:xsd" xmlns:tns="urn:quotes" targetNamespace="urn:quotes">
          <types><xsd:schema targetNamespace="urn:quotes:xsd" elementFormDefault="qualified">
            <xsd:element name="Symbol" type="xsd:string"/><xsd:element name="Price" type="xsd:double"/>
          </xsd:schema></types>
          <message name="In"><part name="body" element="x:Symbol"/></message>
          <message name="Out"><part name="body" element="x:Price"/></message>
          <portType name="Quotes">
            <operation name="ask"><input message="tns:In" wsam:Action="urn:quotes:ask"/>
              <output message="tns:Out"/></operation>
          </portType>
          <binding name="B12" type="tns:Quotes"><soap12:binding style="document"
              transport="http://schemas.xmlsoap.org/soap/http"/>
            <operation name="ask"><soap12:operation/>
              <input><soap12:body use="literal"/></input><output><soap12:body use="literal"/></output></operation>
          </binding>
          <service name="S">
            <port name="P12" binding="tns:B12">{P}<soap12:address location="http://localhost/q12"/></port>
          </service></definitions>';

        const NonAnonymous = '<wsp:Policy><wsam:Addressing><wsp:Policy><wsam:NonAnonymousResponses/></wsp:Policy>'
            '</wsam:Addressing></wsp:Policy>';

        #! the credentials of the request
        const Credentials = {"Authorization": "Bearer secret", "Cookie": "session=secret"};
    }

    constructor() : Test("SoapHandlerCredentialsTest", "1.0", \ARGV) {
        addTestCase("restricted code of a trusted handler", \restrictedTest());
        addTestCase("trusted code of a trusted handler", \trustedTest());
        addTestCase("restricted code: the response endpoint authorizer", \restrictedAuthorizerTest());
        addTestCase("trusted code: the response endpoint authorizer", \trustedAuthorizerTest());
        addTestCase("a handler of a restricted Program", \restrictedSubclassTest());
        addTestCase("restricted code of a reply handler", \restrictedReplyTest());
        addTestCase("trusted code of a reply handler", \trustedReplyTest());
        addTestCase("a reply receiver that restricted code created", \restrictedPlainReceiverTest());
        addTestCase("a reply receiver that trusted code created", \trustedPlainReceiverTest());
        set_return_value(main());
    }

    #! returns the tenant's Program with the given sandbox
    private Program getTenant(*SandboxManager sm) {
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        if (sm) {
            p.setSandboxManager(sm);
        }
        p.parse(TenantSource, "tenant");
        return p;
    }

    private static WebService service(string policy = "") {
        return new WebService(replace(Template, "{P}", policy));
    }

    #! starts a server for the handler; returns its URL
    private static string serve(reference<HttpServer> server, AbstractHttpRequestHandler handler) {
        server = new HttpServer(<HttpServerOptionInfo>{});
        server.setDefaultHandler("soap", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        return sprintf("http://127.0.0.1:%d", port);
    }

    #! posts a SOAP 1.2 request with the credentials; returns the HTTP status
    private static int post(string url, string symbol, string header = "") {
        HTTPClient client({"url": url, "error_passthru": True, "timeout": HangGuard,
            "connect_timeout": HangGuard});
        hash<auto> info;
        client.post("q12", sprintf('<s:Envelope xmlns:s="%s" xmlns:wsa="http://www.w3.org/2005/08/addressing">'
            '<s:Header>%s</s:Header><s:Body><x:Symbol xmlns:x="urn:quotes:xsd">%s</x:Symbol></s:Body>'
            '</s:Envelope>', SOAP_12_ENV, header, symbol),
            Credentials + {"Content-Type": 'application/soap+xml;charset=UTF-8;action="urn:quotes:ask"'}, \info);
        return info."response-headers".status_code;
    }

    #! the header blocks of a request: one for the tenant's processor, one for a trusted processor
    const ProbeHeaders = '<p:Probe xmlns:p="urn:probe">1</p:Probe><p:Trusted xmlns:p="urn:probe">1</p:Trusted>';

    #! calls the tenant's code with a trusted handler; returns what each callback saw
    private hash<auto> callTenant(Program p, reference<list<hash<auto>>> trusted_processing) {
        Queue q();
        Queue tq();
        WebService ws = service();
        # a trusted processor whose result is an object, which restricted code never gets
        SoapProcessingNode node(<SoapNodeOptions>{"processors": {
            "{urn:probe}Probe": p.callFunction("get_processor", q),
            "{urn:probe}Trusted": auto sub (hash<auto> cx, hash<SoapNodeHeader> header) {
                tq.push({"authorization": exists cx.http_header.authorization});
                return new Mutex();
            },
        }});
        SoapHandler handler(new PermissiveAuthenticator(), NOTHING, False, NOTHING, node);
        handler.addMethod(ws, ws.getOperation("ask"), p.callFunction("get_method", q), NOTHING, NOTHING,
            "tenant-mark", "q12", p.callFunction("get_err_func", q), NOTHING, "B12");
        handler.addSoapResponseResource("/resource", ws.getOperation("ask"), p.callFunction("get_provider", q),
            "B12");
        HttpServer server;
        string url = serve(\server, handler);
        on_exit server.stop();

        hash<auto> rv;
        assertEq(200, post(url, "IBM", ProbeHeaders), "the call is served");
        rv.processor = q.get(HangGuard);
        rv.method = q.get(HangGuard);
        trusted_processing += tq.get(HangGuard);

        assertEq(500, post(url, "BAD"), "the response cannot be serialized");
        assertEq("method", q.get(HangGuard).what);
        rv.err_func = q.get(HangGuard);

        HTTPClient client({"url": url, "error_passthru": True, "timeout": HangGuard, "connect_timeout": HangGuard});
        hash<auto> info;
        client.get("resource", Credentials + {"Accept": "application/soap+xml"}, \info);
        assertEq(200, info."response-headers".status_code, "the resource is served");
        rv.provider = q.get(HangGuard);
        assertEq(0, q.size(), "no other call");
        return rv;
    }

    #! checks what restricted code saw: no credentials, no objects but its own code, the SOAP keys
    private checkFiltered(hash<auto> r, string label, list<string> own = ()) {
        assertFalse(r.auth, label + ": cx.auth");
        assertFalse(r.authorization, label + ": Authorization");
        assertFalse(r.cookie, label + ": Cookie");
        assertEq(own, r.objects, label + ": no object or code but its own");
        assertFalse(r.operation, label + ": no operation object");
        assertTrue(r.host, label + ": the other header fields");
        assertTrue(r.http_body, label + ": the body");
        assertEq("urn:quotes:ask", r.soap_action, label + ": the SOAP action");
    }

    restrictedTest() {
        list<hash<auto>> trusted_processing = ();
        hash<auto> r = callTenant(getTenant(new SandboxManager()), \trusted_processing);
        checkFiltered(r.processor, "processor");
        checkFiltered(r.method, "method", ("function",));
        checkFiltered(r.err_func, "err_func");
        assertEq("provider", r.provider.what);
        assertFalse(r.provider.auth, "provider: cx.auth");
        assertFalse(r.provider.authorization, "provider: Authorization");
        assertFalse(r.provider.cookie, "provider: Cookie");
        assertEq(("function",), r.provider.objects, "provider: no object or code but its own");
        assertTrue(r.provider.host, "provider: the other header fields");
        assertTrue(r.provider.soap_response, "provider: soap_response");
        # the method gets its own code; the error function does not get the method's
        assertTrue(r.method.function, "the method's own function");
        assertFalse(r.err_func.function, "the error function gets no code of the method");
        assertEq("tenant-mark", r.method.cmark, "the context marker");
        assertEq("tenant-mark", r.err_func.cmark, "the context marker");
        # the results of the header processors, without the trusted processor's object
        assertTrue(r.method.soap_processing, "soap_processing");
        assertFalse(r.method.processing_objects, "no object of a processor");
        assertEq(("probe-value",), r.method.processing_values, "the tenant's processor result");
        # the trusted processor of the same request gets the raw request
        assertEq(({"authorization": True},), trusted_processing, "the trusted processor");
    }

    trustedTest() {
        list<hash<auto>> trusted_processing = ();
        hash<auto> r = callTenant(getTenant(), \trusted_processing);
        foreach string what in ("processor", "method", "err_func", "provider") {
            assertTrue(r{what}.auth, what + ": cx.auth");
            assertTrue(r{what}.authorization, what + ": Authorization");
            assertTrue(r{what}.cookie, what + ": Cookie");
        }
        foreach string what in ("method", "err_func", "provider") {
            assertTrue(r{what}.operation, what + ": the operation");
            assertTrue(r{what}.function, what + ": the function");
        }
        assertTrue(r.method.processing_objects, "the trusted processor's object");
        assertEq(({"authorization": True},), trusted_processing, "the trusted processor");
    }

    #! returns what the authorizer saw
    private hash<auto> callAuthorizer(Program p) {
        Queue q();
        WebService ws = service(NonAnonymous);
        SoapHandler handler(new PermissiveAuthenticator());
        handler.addMethod(ws, ws.getOperation("ask"), p.callFunction("get_method", q), NOTHING, NOTHING, NOTHING,
            "q12", NOTHING, NOTHING, "B12");
        handler.setResponseEndpointAuthorizer(p.callFunction("get_authorizer", q));
        HttpServer server;
        string url = serve(\server, handler);
        on_exit server.stop();
        # the authorizer refuses the endpoint
        assertEq(400, post(url, "IBM", '<wsa:Action>urn:quotes:ask</wsa:Action><wsa:MessageID>urn:uuid:c1'
            '</wsa:MessageID><wsa:ReplyTo><wsa:Address>http://127.0.0.1:1/reply</wsa:Address></wsa:ReplyTo>'),
            "the endpoint is refused");
        hash<auto> rv = q.get(HangGuard);
        assertEq(0, q.size(), "no other call");
        return rv;
    }

    restrictedAuthorizerTest() {
        hash<auto> r = callAuthorizer(getTenant(new SandboxManager()));
        assertEq("authorizer", r.what);
        checkFiltered(r, "authorizer");
        assertTrue(r.addressing, "the request's addressing properties");
    }

    trustedAuthorizerTest() {
        hash<auto> r = callAuthorizer(getTenant());
        assertTrue(r.auth, "cx.auth");
        assertTrue(r.authorization, "Authorization");
        assertTrue(r.cookie, "Cookie");
        assertTrue(r.addressing, "the request's addressing properties");
    }

    #! posts a reply with the credentials to the reply handler
    private postReply(SoapReplyHandler handler) {
        HttpServer server;
        string url = serve(\server, handler);
        on_exit server.stop();
        HTTPClient client({"url": url, "error_passthru": True, "timeout": HangGuard,
            "connect_timeout": HangGuard});
        hash<auto> info;
        client.post("reply", sprintf('<s:Envelope xmlns:s="%s" xmlns:wsa="http://www.w3.org/2005/08/addressing">'
            '<s:Header><wsa:Action>urn:quotes:askResponse</wsa:Action><wsa:RelatesTo>urn:uuid:r1</wsa:RelatesTo>'
            '<p:Probe xmlns:p="urn:probe">1</p:Probe></s:Header><s:Body><x:Price xmlns:x="urn:quotes:xsd">1.5'
            '</x:Price></s:Body></s:Envelope>', SOAP_12_ENV),
            Credentials + {"Content-Type": "application/soap+xml;charset=UTF-8"}, \info);
        assertEq(202, info."response-headers".status_code, "the reply is delivered");
    }

    #! delivers a reply to a reply handler with the tenant's receiver and header processor; returns what they saw
    private hash<auto> callReplyHandler(Program p) {
        Queue q();
        SoapProcessingNode node(<SoapNodeOptions>{"processors": {
            "{urn:probe}Probe": p.callFunction("get_processor", q),
        }});
        postReply(new SoapReplyHandler(p.callFunction("get_receiver", q), new PermissiveAuthenticator(), node));
        hash<auto> rv;
        rv.processor = q.get(HangGuard);
        rv.receiver = q.get(HangGuard);
        assertEq(0, q.size(), "no other call");
        assertEq("urn:uuid:r1", rv.receiver.addressing, "the reply's relationship");
        assertTrue(rv.receiver.host, "the other header fields");
        return rv;
    }

    restrictedReplyTest() {
        hash<auto> r = callReplyHandler(getTenant(new SandboxManager()));
        assertEq("processor", r.processor.what);
        assertFalse(r.processor.auth, "processor: cx.auth");
        assertFalse(r.processor.authorization, "processor: Authorization");
        assertFalse(r.processor.cookie, "processor: Cookie");
        assertEq((), r.processor.objects, "processor: no object or code");
        assertFalse(r.receiver.authorization, "receiver: Authorization");
        assertFalse(r.receiver.cookie, "receiver: Cookie");
    }

    trustedReplyTest() {
        hash<auto> r = callReplyHandler(getTenant());
        assertTrue(r.processor.auth, "processor: cx.auth");
        assertTrue(r.receiver.authorization, "receiver: Authorization");
        assertTrue(r.receiver.cookie, "receiver: Cookie");
    }

    #! delivers a reply to a receiver of the WSDL module's class that the tenant created; returns what it got
    private hash<auto> callPlainReceiver(Program p) {
        WsaReplyReceiver receiver = p.callFunction("get_plain_receiver");
        postReply(new SoapReplyHandler(receiver, new PermissiveAuthenticator()));
        hash<auto> rv = p.callFunction("wait_reply", receiver);
        assertTrue(rv.host, "the other header fields");
        return rv;
    }

    restrictedPlainReceiverTest() {
        hash<auto> r = callPlainReceiver(getTenant(new SandboxManager()));
        assertFalse(r.authorization, "Authorization");
        assertFalse(r.cookie, "Cookie");
    }

    trustedPlainReceiverTest() {
        hash<auto> r = callPlainReceiver(getTenant());
        assertTrue(r.authorization, "Authorization");
        assertTrue(r.cookie, "Cookie");
    }

    restrictedSubclassTest() {
        Queue q();
        Program p = getTenant(new SandboxManager());
        SoapHandler handler = p.callFunction("get_handler", service(), q);
        HttpServer server;
        string url = serve(\server, handler);
        on_exit server.stop();
        assertEq(200, post(url, "IBM"), "the call is served");
        hash<auto> r = q.get(HangGuard);
        assertEq("msglog", r.what);
        assertFalse(r.msg_authorization, "the logged request: Authorization");
        assertFalse(r.msg_cookie, "the logged request: Cookie");
        assertFalse(r.authorization, "msglog: Authorization");
        assertFalse(r.cookie, "msglog: Cookie");
        r = q.get(HangGuard);
        checkFiltered(r, "method", ("function",));
        assertTrue(r.function, "the method's own function");

        assertEq(500, post(url, "BAD"), "the response cannot be serialized");
        q.get(HangGuard);
        assertEq("method", q.get(HangGuard).what);
        checkFiltered(q.get(HangGuard), "err_func");
        assertEq(0, q.size(), "no other call");
    }
}
