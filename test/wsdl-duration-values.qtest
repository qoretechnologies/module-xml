#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class DurationValuesTest

class InterruptDurationProvider inherits XsdDurationDataType {
    public {
        bool interrupt = True;
    }

    auto acceptsValue(auto value) {
        if (interrupt) {
            throw "PROGRAM-INTERRUPTED", "duration item conversion interrupted";
        }
        return XsdDurationDataType::acceptsValue(value);
    }
}

class DurationValuesTest inherits QUnit::Test {
    constructor() : Test("XSD duration lexical values", "1.0") {
        addTestCase("Complete duration grammar and XML whitespace", \valid());
        addTestCase("Malformed duration text and native categories reject", \invalid());
        addTestCase("Native relative dates retain signs and microseconds", \native());
        addTestCase("Arbitrary component and fractional precision survives", \precision());
        addTestCase("Providers retain requiredness and validation after reconstruction", \providers());
        addTestCase("Basic lists and unions validate duration conversions", \collections());
        addTestCase("Malformed provider metadata rejects without poisoning valid state", \metadata());
        addTestCase("List cancellation retains its category and recovers", \cancellation());
        set_return_value(main());
    }

    private static XsdBaseType base() {
        return new Namespaces({}).getBaseType("duration");
    }

    private check(auto input, string expected) {
        XsdBaseType type = base();
        assertEq(expected, type.serializeValue(new Namespaces({}), input, True));
        assertEq(expected, type.deserializeValue("value", {}, NOTHING, input));
        AbstractDataProviderType original = type.getDataProviderType();
        foreach AbstractDataProviderType provider in (original, Serializable::deserialize(original.serialize()),
                original.getOrNothingType().getMandatoryType()) {
            assertEq(expected, provider.acceptsValue(input));
            assertEq((expected,), new ListDataType(provider).acceptsValue((input,)));
        }
    }

    private valid() {
        foreach string text in ("P0Y", "-P0Y", "PT0S", "-PT0S", "P1Y", "P1M", "P1D", "PT1H", "PT1M",
                "PT1S", "P1Y2M3DT4H5M6.789S", "-P1Y2M3DT4H5M6.789S", "P13M", "P40D", "PT25H",
                "PT61M", "PT61S", "P0001Y00M0DT00H00M00.000S", "P1DT0S", "PT0.0000001S") {
            check(text, text);
            check(" \t" + text + "\r\n", text);
        }
    }

    private invalid() {
        XsdBaseType type = base();
        AbstractDataProviderType provider = type.getDataProviderType();
        foreach auto input in ("", " ", "P", "-P", "PT", "-PT", "P1DT", "P1YT", "PT.5S", "PT1.S",
                "PT1e2S", "P1.5D", "P١D", "PT１S", "P1D\ntrailing", "P1D\u00a0", "\u00a0P1D", "P1W",
                "P-1D", "+P1D", "p1d", "P1H", "P1D1Y", "PT1M1H", "P1Y1Y", "P1DT-1H", "P1 D",
                "P1D T1H", "PT1,5S", "PT1S Z", "PT1S+00:00", "P1D\u0000", NOTHING, NULL, True, 123,
                1.2, 1.2n, (), {}, <00>, date("2000-01-01Z"), years(1) + days(-1), years(-1) + days(1)) {
            assertThrows("SOAP-SERIALIZATION-ERROR", \type.serializeValue(),
                (new Namespaces({}), input, True), sprintf("%Y", input));
            assertThrows("SOAP-DESERIALIZATION-ERROR", \type.deserializeValue(),
                ("value", {}, NOTHING, input), sprintf("%Y", input));
            assertThrows(exists input ? "RUNTIME-TYPE-ERROR" : "MISSING-VALUE-ERROR",
                \provider.acceptsValue(), (input,), sprintf("%Y", input));
            assertEq("P1D", provider.acceptsValue("P1D"));
        }
    }

    private native() {
        foreach list<auto> pair in (
                (seconds(0), "PT0S"), (days(-1), "-P1D"),
                (microseconds(1), "PT0.000001S"), (microseconds(-1), "-PT0.000001S"),
                (microseconds(120000), "PT0.12S"), (microseconds(-120000), "-PT0.12S"),
                (years(1) + months(-1), "P11M"), (days(1) + hours(-1), "PT23H"),
                (days(-1) + hours(1), "-PT23H"),
                (seconds(-1) + microseconds(1), "-PT0.999999S"),
                (seconds(1) + microseconds(-1), "PT0.999999S"),
                (days(2147483647), "P2147483647D"), (days(-2147483648), "-P2147483648D"),
                (years(2147483647), "P2147483647Y"), (years(-2147483648), "-P2147483648Y"),
                (years(1) + months(2) + days(3) + hours(4) + minutes(5) + seconds(6) + microseconds(789012),
                    "P1Y2M3DT4H5M6.789012S"),
                (years(-1) + months(-2) + days(-3) + hours(-4) + minutes(-5) + seconds(-6) + microseconds(-789012),
                    "-P1Y2M3DT4H5M6.789012S")) {
            check(pair[0], pair[1]);
        }
    }

    private precision() {
        foreach string text in ("P" + strmul("9", 1000) + "Y", "P" + strmul("9", 1000) + "M",
                "P" + strmul("9", 1000) + "D", "PT" + strmul("9", 1000) + "H",
                "PT" + strmul("9", 1000) + "M", "PT" + strmul("9", 1000) + "S",
                "PT0." + strmul("0", 1000) + "1S", "PT1." + strmul("9", 1000) + "S",
                "PT1.00000000000000001S", "PT1.00000000000000002S") {
            check(text, text);
            check("-" + text, "-" + text);
        }
    }

    private providers() {
        AbstractDataProviderType original = base().getDataProviderType();
        foreach AbstractDataProviderType provider in (original, Serializable::deserialize(original.serialize()),
                original.getOrNothingType().getMandatoryType()) {
            assertEq("xsd:duration", provider.getName());
            assertEq(NOTHING, provider.getValueType());
            assertEq(NT_STRING, provider.getBaseTypeCode());
            assertEq("string", provider.getBaseTypeName());
            assertEq({"string": True, "date": True}, provider.getAcceptTypeHash(True));
            assertEq({"string": True}, provider.getReturnTypeHash(True));
            assertEq({}, provider.getDirectTypeHash());
            assertTrue(provider.isMandatory());
            assertFalse(provider.isOrNothingType());
            assertThrows("MISSING-VALUE-ERROR", \provider.acceptsValue(), (NOTHING,));
            AbstractDataProviderType optional = provider.getOrNothingType();
            assertEq(NOTHING, optional.acceptsValue(NOTHING));
            assertFalse(optional.isMandatory());
            assertTrue(optional.isOrNothingType());
            assertEq({"string": True, "nothing": True}, optional.getReturnTypeHash(True));
            assertEq({"string": True, "date": True, "nothing": True}, optional.getAcceptTypeHash(True));
            assertEq("P1D", Serializable::deserialize(optional.serialize()).acceptsValue("P1D"));
        }
    }

    private collections() {
        XsdSchema original('<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:duration">
            <xs:simpleType name="Durations"><xs:list itemType="xs:duration"/></xs:simpleType>
            <xs:simpleType name="Either"><xs:union memberTypes="xs:duration xs:string"/></xs:simpleType>
            </xs:schema>', {"async_only": True});
        foreach XsdSchema schema in (original, Serializable::deserialize(original.serialize())) {
            XsdAbstractType list = schema.findType(make_qname("urn:duration", "Durations"));
            list<auto> expected = ("-P1D", "PT0.000001S", "PT1.00000000000000001S");
            list<auto> input = (days(-1), microseconds(1), "PT1.00000000000000001S");
            string lexical = "-P1D PT0.000001S PT1.00000000000000001S";
            assertEq(lexical, list.serializeValue(new Namespaces({}), input, True));
            assertEq(expected, list.deserializeValue("value", {}, NOTHING, lexical));
            AbstractDataProviderType provider = list.getDataProviderType();
            assertEq(expected, provider.acceptsValue(input));
            assertEq(expected, Serializable::deserialize(provider.serialize()).acceptsValue(input));
            assertThrows("SOAP-DESERIALIZATION-ERROR", \list.deserializeValue(), ("value", {}, NOTHING, "P1D P1DT"));
            XsdAbstractType either = schema.findType(make_qname("urn:duration", "Either"));
            assertEq("PT0.000001S", either.getDataProviderType().acceptsValue(microseconds(1)));
            assertEq("label", either.getDataProviderType().acceptsValue("label"));
            assertEq("P1DT", either.getDataProviderType().acceptsValue("P1DT"));
        }
    }
    private metadata() {
        XsdDurationDataType original();
        assertEq("duration", original.getBuiltinName());
        assertThrows("XSD-SIMPLETYPE-ERROR", sub() {
            new XsdNumericRestrictionDataType(<XsdNumericFacetInfo>{"name": "Amount", "base_name": "decimal",
                "bounds": {}}, original);
        });
        assertThrows("XSD-SIMPLETYPE-ERROR", sub() {
            new XsdCalendarRestrictionDataType(<XsdCalendarFacetInfo>{"name": "Day", "base_name": "date"}, original);
        });
        assertThrows("XSD-SIMPLETYPE-ERROR", sub() {
            new XsdListDataType(<XsdListItemInfo>{"builtin": "decimal", "provider": original,
                "white_space": "collapse"});
        });
        foreach auto invalid in ("yes", 1, NOTHING, NULL) {
            hash<SerializationInfo> state = original.serializeToData();
            state._index."0"._class_data."WSDL::XsdDurationDataType".optional = invalid;
            assertThrows("DESERIALIZATION-ERROR", \Serializable::deserialize(), (state,));
        }
        assertEq("PT0.000001S", Serializable::deserialize(original.serialize()).acceptsValue(microseconds(1)));
    }

    private cancellation() {
        InterruptDurationProvider item();
        ListDataType provider(item);
        assertThrows("PROGRAM-INTERRUPTED", \provider.acceptsValue(), (("P1D", "PT1S"),));
        item.interrupt = False;
        assertEq(("P1D", "PT0.000001S"), provider.acceptsValue(("P1D", microseconds(1))));
        assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (("P1D", "P1DT"),));
        assertEq(("-P1D",), provider.acceptsValue((days(-1),)));
    }

}
