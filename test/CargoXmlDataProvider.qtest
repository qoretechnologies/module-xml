#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%requires qore >= 2.3
%modern

%requires QUnit
%requires ../qlib/WSDL.qm
%requires ../qlib/CargoXmlDataProvider

%exec-class CargoXmlDataProviderTest

class CargoXmlDataProviderTest inherits QUnit::Test {
    public {
        const Ns_CIDA = "urn:un:unece:uncefact:data:standard:CrossIndustryDespatchAdvice:27";
        const QName_CIDA = "{" + Ns_CIDA + "}CrossIndustryDespatchAdvice";

        # built into the test directory; covers schemaLocation imports
        const TestSchemaDir = get_script_dir() + "/cargo-xml-test-schemas";
    }

    constructor() : Test("CargoXmlDataProviderTest", "1.0") {
        addTestCase("bundled UN/CEFACT discovery", \testBundledDiscovery());
        addTestCase("custom schema_dir override", \testCustomSchemaDir());
        addTestCase("parse with validation rejects malformed", \testParseValidationRejects());
        addTestCase("parse without validation returns hash", \testParseNoValidation());
        addTestCase("build round-trip", \testBuildRoundTrip());
        addTestCase("unknown direction throws", \testUnknownDirection());
        addTestCase("unknown message returns NOTHING", \testUnknownMessage());
        set_return_value(main());
    }

    # The bundled UN/CEFACT D25A directory should have many discovered messages including
    # the well-known Cross-Industry Despatch Advice.
    testBundledDiscovery() {
        CargoXmlDataProvider::CargoXmlDataProvider dp();
        assertEq("cargo-xml", dp.getName());
        # bundled D25A has hundreds of messages; lower bound is conservative
        assertTrue(dp.getMessages().size() > 100);
        assertTrue(dp.getChildProviderNames().contains(QName_CIDA));

        hash<CargoXmlDataProvider::CargoXmlMessageInfo> mi = dp.getMessages(){QName_CIDA};
        assertEq("CrossIndustryDespatchAdvice", mi.name);
        assertEq(Ns_CIDA, mi.namespace);
        assertTrue(mi.xsd_file =~ /CrossIndustryDespatchAdvice_27p1\.xsd$/);
    }

    testCustomSchemaDir() {
        # set up a small custom schema dir so we don't depend on the bundled tree
        ensureCustomSchemaDir();
        CargoXmlDataProvider::CargoXmlDataProvider dp({
            "schema_dir": TestSchemaDir,
            "schema_subdir": "",
        });
        # SharedTypes.xsd has no top-level elements (only a simpleType), so only Order
        # registers as a message
        assertEq(1, dp.getMessages().size());

        string main_ns = "http://qoretechnologies.com/test/cargo/main";
        string main_qname = "{" + main_ns + "}Order";
        assertTrue(dp.getChildProviderNames().contains(main_qname));
    }

    testParseValidationRejects() {
        CargoXmlDataProvider::CargoXmlDataProvider dp();
        AbstractDataProvider msg = dp.getChildProviderEx(QName_CIDA);
        # empty CrossIndustryDespatchAdvice is missing required children -> XSD-ERROR
        hash<CargoXmlDataProvider::CargoXmlMessageRequest> req = <CargoXmlDataProvider::CargoXmlMessageRequest>{
            "direction": "parse",
            "xml": '<?xml version="1.0"?><CrossIndustryDespatchAdvice xmlns="' + Ns_CIDA + '"/>',
            "validate": True,
        };
        assertThrows("XSD-ERROR", \msg.doRequest(), req);
    }

    testParseNoValidation() {
        CargoXmlDataProvider::CargoXmlDataProvider dp();
        AbstractDataProvider msg = dp.getChildProviderEx(QName_CIDA);
        hash<CargoXmlDataProvider::CargoXmlMessageRequest> req = <CargoXmlDataProvider::CargoXmlMessageRequest>{
            "direction": "parse",
            "xml": '<?xml version="1.0"?><CrossIndustryDespatchAdvice xmlns="' + Ns_CIDA + '"/>',
            "validate": False,
        };
        hash<CargoXmlDataProvider::CargoXmlMessageResponse> resp =
            cast<hash<CargoXmlDataProvider::CargoXmlMessageResponse>>(msg.doRequest(req));
        assertTrue(exists resp.data);
        assertEq("CrossIndustryDespatchAdvice", resp.data.firstKey());
    }

    # End-to-end against the test schema pair: build a valid Order from a hash,
    # serialize, validate, parse it back, confirm the hash structure round-trips.
    testBuildRoundTrip() {
        ensureCustomSchemaDir();
        CargoXmlDataProvider::CargoXmlDataProvider dp({
            "schema_dir": TestSchemaDir,
            "schema_subdir": "",
        });
        string main_ns = "http://qoretechnologies.com/test/cargo/main";
        string qname = "{" + main_ns + "}Order";
        AbstractDataProvider msg = dp.getChildProviderEx(qname);

        hash<auto> data = {
            "m:Order": {
                "^attributes^": {"xmlns:m": main_ns},
                "m:Id": "QT-42",
                "m:Qty": 7,
            },
        };

        # build with validation
        hash<CargoXmlDataProvider::CargoXmlMessageRequest> build_req =
            <CargoXmlDataProvider::CargoXmlMessageRequest>{
                "direction": "build",
                "data": data,
                "validate": True,
            };
        hash<CargoXmlDataProvider::CargoXmlMessageResponse> build_resp =
            cast<hash<CargoXmlDataProvider::CargoXmlMessageResponse>>(msg.doRequest(build_req));
        assertTrue(exists build_resp.xml);
        assertTrue(build_resp.xml.find("QT-42") > 0);

        # parse the result back, validating
        hash<CargoXmlDataProvider::CargoXmlMessageRequest> parse_req =
            <CargoXmlDataProvider::CargoXmlMessageRequest>{
                "direction": "parse",
                "xml": build_resp.xml,
                "validate": True,
            };
        hash<CargoXmlDataProvider::CargoXmlMessageResponse> parse_resp =
            cast<hash<CargoXmlDataProvider::CargoXmlMessageResponse>>(msg.doRequest(parse_req));
        assertTrue(exists parse_resp.data);
        assertEq("QT-42", parse_resp.data."m:Order"."m:Id"."^value^" ?? parse_resp.data."m:Order"."m:Id");
    }

    testUnknownDirection() {
        CargoXmlDataProvider::CargoXmlDataProvider dp();
        AbstractDataProvider msg = dp.getChildProviderEx(QName_CIDA);
        hash<CargoXmlDataProvider::CargoXmlMessageRequest> req =
            <CargoXmlDataProvider::CargoXmlMessageRequest>{
                "direction": "transform",
                "xml": "<x/>",
            };
        assertThrows("CARGO-XML-REQUEST-ERROR", \msg.doRequest(), req);
    }

    testUnknownMessage() {
        CargoXmlDataProvider::CargoXmlDataProvider dp();
        assertEq(NOTHING, dp.getChildProvider("{no.such}Message"));
    }

    # Drop a tiny self-contained CargoXML-shaped XSD pair under the test directory so the
    # custom-schema-dir tests don't depend on the bundled D25A tree (which would also work
    # but is slower).
    ensureCustomSchemaDir() {
        Dir d();
        if (!d.chdir(TestSchemaDir)) {
            mkdir(TestSchemaDir, 0755, True);
        }
        string main_xsd = TestSchemaDir + DirSep + "Order.xsd";
        string shared_xsd = TestSchemaDir + DirSep + "SharedTypes.xsd";
        if (!is_file(main_xsd)) {
            File f();
            f.open2(main_xsd, O_CREAT | O_WRONLY | O_TRUNC, 0644);
            f.write('<?xml version="1.0"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:m="http://qoretechnologies.com/test/cargo/main"
    xmlns:s="http://qoretechnologies.com/test/cargo/shared"
    targetNamespace="http://qoretechnologies.com/test/cargo/main"
    elementFormDefault="qualified">
    <xsd:import namespace="http://qoretechnologies.com/test/cargo/shared"
                schemaLocation="SharedTypes.xsd"/>
    <xsd:element name="Order">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="Id" type="s:Id"/>
                <xsd:element name="Qty" type="xsd:positiveInteger"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>
</xsd:schema>
');
        }
        if (!is_file(shared_xsd)) {
            File f();
            f.open2(shared_xsd, O_CREAT | O_WRONLY | O_TRUNC, 0644);
            f.write('<?xml version="1.0"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    targetNamespace="http://qoretechnologies.com/test/cargo/shared"
    elementFormDefault="qualified">
    <xsd:simpleType name="Id">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="[A-Z]{2}-[0-9]+"/>
        </xsd:restriction>
    </xsd:simpleType>
</xsd:schema>
');
        }
    }
}
