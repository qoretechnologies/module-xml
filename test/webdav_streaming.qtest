#!/usr/bin/env qore

%modern

%requires qore >= 2.3
%requires HttpServer
%requires ../qlib/WebDavHandler
%requires ../qlib/WebDavClientIo
%requires QUnit
%requires FsUtil
%requires Logger

%exec-class Main

# records the protocol of each upload and whether its body was streamed
class RecordingFsWebDavHandler inherits WebDavHandler::FsWebDavHandler {
    public {
        Queue uploads();
    }

    constructor(string root) : FsWebDavHandler(root) {
    }

    private hash<HttpResponseInfo> handlePutImpl(hash<auto> cx, hash<auto> hdr, *data body) {
        record(cx, "PUT", body);
        return FsWebDavHandler::handlePutImpl(cx, hdr, body);
    }

    private hash<HttpResponseInfo> handlePostImpl(hash<auto> cx, hash<auto> hdr, *data body) {
        record(cx, "POST", body);
        return FsWebDavHandler::handlePostImpl(cx, hdr, body);
    }

    private record(hash<auto> cx, string method, *data body) {
        uploads.push({"method": method, "protocol": cx."header-info".http3 ? "h3" : cx."header-info".http2 ? "h2"
            : "h1", "streamed": !exists body});
    }
}

# Test the WebDavHandler v1.3 automatic body-streaming for PUT/POST.
#
# The framework's wantsBodyStreaming opt-in is honored only on HTTP/2 and HTTP/3 — HTTP/1.1
# bodies are framework-buffered regardless. The unit tests here exercise the policy method
# and the streamBodyToOutputStream helper directly with a mocked HTTP/2 cx hash, then a
# round-trip test confirms the buffered path is unaffected for clients that don't speak
# HTTP/2.
class Main inherits QUnit::Test {
    public {
        # Test fixtures are global so the policy and helper unit tests don't need a server.
        const TestNs = "test";
    }

    constructor() : QUnit::Test("webdav-streaming", "1.0") {
        addTestCase("wantsBodyStreaming policy matrix", \testPolicy());
        addTestCase("setBodyStreamingThreshold mutates policy", \testThresholdSetter());
        addTestCase("streamBodyToOutputStream HTTP/2 path", \testStreamHttp2());
        addTestCase("streamBodyToOutputStream HTTP/2 body limit and errors", \testStreamHttp2Errors());
        addTestCase("body read error responses", \testBodyReadErrorResponse());
        addTestCase("streamed uploads over HTTP/2 and HTTP/3", \testStreamedUploads());
        addTestCase("streamBodyToOutputStream errors with no streaming context",
            \testStreamMissingContext());
        addTestCase("buffered PUT round-trip (HTTP/1.1)", \testBufferedRoundTrip());

        set_return_value(main());
    }

    private WebDavHandler::FsWebDavHandler newHandler() {
        TmpDir tmp();
        return new WebDavHandler::FsWebDavHandler(tmp.path);
    }

    testPolicy() {
        WebDavHandler::FsWebDavHandler h = newHandler();
        # PROPFIND etc. are never streamed — body is small XML
        assertEq(False, h.wantsBodyStreaming({}, {"method": "PROPFIND",
            "transfer-encoding": "chunked"}));
        assertEq(False, h.wantsBodyStreaming({}, {"method": "GET",
            "content-length": "100000000"}));

        # PUT with no Content-Length and not chunked — buffered
        assertEq(False, h.wantsBodyStreaming({}, {"method": "PUT"}));

        # PUT with chunked Transfer-Encoding — always streams (size unknown)
        assertEq(True, h.wantsBodyStreaming({}, {"method": "PUT",
            "transfer-encoding": "chunked"}));

        # PUT with small Content-Length — stays buffered
        assertEq(False, h.wantsBodyStreaming({}, {"method": "PUT",
            "content-length": "1024"}));

        # PUT with Content-Length over the default 4MB threshold — streams
        assertEq(True, h.wantsBodyStreaming({}, {"method": "PUT",
            "content-length": sprintf("%d", 8 * 1024 * 1024)}));

        # POST follows the same policy as PUT
        assertEq(True, h.wantsBodyStreaming({}, {"method": "POST",
            "content-length": sprintf("%d", 8 * 1024 * 1024)}));
    }

    testThresholdSetter() {
        WebDavHandler::FsWebDavHandler h = newHandler();
        assertEq(WebDavHandler::AbstractWebDavHandler::BodyStreamingThreshold,
            h.getBodyStreamingThreshold());

        # Lower the threshold and verify the policy responds
        h.setBodyStreamingThreshold(2048);
        assertEq(2048, h.getBodyStreamingThreshold());
        assertEq(True, h.wantsBodyStreaming({}, {"method": "PUT",
            "content-length": "4096"}));
        assertEq(False, h.wantsBodyStreaming({}, {"method": "PUT",
            "content-length": "1024"}));

        # Threshold 0 forces streaming for every PUT/POST
        h.setBodyStreamingThreshold(0);
        assertEq(True, h.wantsBodyStreaming({}, {"method": "PUT",
            "content-length": "1"}));
    }

    # a mocked HTTP/2 request context whose register_body_queue closure, like the framework's, takes the queue;
    # the queued items are pushed when the queue is registered
    static hash<auto> http2Context(list<auto> items, *reference<Queue> registered, *int limit) {
        return {
            "header-info": {
                "http2": True,
                "stream_id": 1,
                "max_request_body_size": limit,
                "register_body_queue": sub (Queue q) {
                    registered = q;
                    map q.push($1), items;
                },
            },
        };
    }

    # the HTTP/2 path drains the queue into the output stream until the NOTHING sentinel
    testStreamHttp2() {
        BinaryOutputStream out();
        WebDavHandler::AbstractWebDavHandler::streamBodyToOutputStream(
            http2Context((<0102030405060708>, <c0deca7e>, NOTHING)), {"method": "PUT"}, out, 30s);
        assertEq(<0102030405060708> + <c0deca7e>, out.getData());
    }

    testStreamHttp2Errors() {
        # a body exceeding the server's maximum request body size: the buffered data comes first, then the error
        # record, which is raised; the queue is cancelled so the server discards the rest
        BinaryOutputStream out();
        Queue registered;
        assertThrows("HTTP-BODY-TOO-LARGE", "exceeds",
            \WebDavHandler::AbstractWebDavHandler::streamBodyToOutputStream(), (http2Context((<0102>,
            {"err": "HTTP-BODY-TOO-LARGE", "desc": "the body exceeds the maximum"}), \registered),
            {"method": "PUT"}, out, 30s));
        assertEq(<0102>, out.getData());
        assertThrows("WEBDAV-STREAMING-CANCELLED", \registered.get());
        # an unexpected value
        out = new BinaryOutputStream();
        assertThrows("WEBDAV-STREAMING-ERROR", "unexpected integer",
            \WebDavHandler::AbstractWebDavHandler::streamBodyToOutputStream(), (http2Context((1,), \registered),
            {"method": "PUT"}, out, 30s));
        assertThrows("WEBDAV-STREAMING-CANCELLED", \registered.get());
        assertThrows("WEBDAV-STREAMING-ERROR", "unexpected hash",
            \WebDavHandler::AbstractWebDavHandler::streamBodyToOutputStream(), (http2Context(({"x": 1},)),
            {"method": "PUT"}, out, 30s));
        # the handler enforces the server's maximum request body size on the streamed total: a body of exactly the
        # limit is read, a larger one fails after the data up to the limit and the read is cancelled
        out = new BinaryOutputStream();
        WebDavHandler::AbstractWebDavHandler::streamBodyToOutputStream(http2Context((<0102>, <0304>, NOTHING),
            NOTHING, 4), {"method": "PUT"}, out, 30s);
        assertEq(<01020304>, out.getData());
        out = new BinaryOutputStream();
        assertThrows("HTTP-BODY-TOO-LARGE", "maximum request body size of 4 bytes",
            \WebDavHandler::AbstractWebDavHandler::streamBodyToOutputStream(), (http2Context((<0102>, <0304>, <05>,
            NOTHING), \registered, 4), {"method": "PUT"}, out, 30s));
        assertEq(<01020304>, out.getData());
        assertThrows("WEBDAV-STREAMING-CANCELLED", \registered.get());
        # no data arrives: the read times out and is cancelled
        assertThrows("QUEUE-TIMEOUT", \WebDavHandler::AbstractWebDavHandler::streamBodyToOutputStream(),
            (http2Context((), \registered), {"method": "PUT"}, out, 1ms));
        assertThrows("WEBDAV-STREAMING-CANCELLED", \registered.get());
    }

    testBodyReadErrorResponse() {
        assertEq(<HttpResponseInfo>{"code": 413, "body": "too large"},
            WebDavHandler::AbstractWebDavHandler::getBodyReadErrorResponse(<ExceptionInfo>{
                "err": "HTTP-BODY-TOO-LARGE", "desc": "too large"}));
        foreach string err in ("QUEUE-TIMEOUT", "QUIC-STREAM-TIMEOUT") {
            assertEq(408, WebDavHandler::AbstractWebDavHandler::getBodyReadErrorResponse(<ExceptionInfo>{
                "err": err, "desc": "timeout"}).code, err);
        }
        assertEq(NOTHING, WebDavHandler::AbstractWebDavHandler::getBodyReadErrorResponse(<ExceptionInfo>{
            "err": "FILE-WRITE-ERROR", "desc": "disk full"}));
    }

    # FsWebDavHandler streams PUT and POST bodies over HTTP/2 and HTTP/3 through the framework's body readers and
    # enforces the server's maximum request body size, which HttpServer passes in cx."header-info"
    testStreamedUploads() {
        const int Limit = 256 * 1024;
        TmpDir tmp();
        RecordingFsWebDavHandler handler(tmp.path);
        handler.setBodyStreamingThreshold(0);
        HttpServer srv();
        srv.waitForAsyncIo();
        srv.setMaxRequestBodySize(Limit);
        srv.setDefaultHandler("webdavhandler", handler);
        map srv.addHttpMethod($1), handler.getHttpMethods();
        string dir = get_script_dir() + DirSep + "certs" + DirSep;
        int port = srv.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(ReadOnlyFile::readTextFile(dir + "localhost-cert.pem")),
            "key": new SSLPrivateKey(ReadOnlyFile::readTextFile(dir + "localhost-key.pem")),
            "enable_h3": True,
        }).port;
        srv.waitForAsyncIo();
        on_exit srv.stop();

        # several DATA frames' worth
        binary data = binary(strmul("0123456789abcdef", 12 * 1024));
        foreach hash<auto> protocol in ({"name": "h2", "http_version": "2.0"}, {"name": "h3", "http_version": "3.0"}) {
            HTTPClient client({"url": sprintf("https://127.0.0.1:%d", port), "http_version": protocol.http_version,
                "error_passthru": True, "timeout": 30000, "connect_timeout": 15000});
            foreach string method in ("PUT", "POST") {
                string name = sprintf("%s-%s.bin", protocol.name, method.lwr());
                string label = protocol.name + " " + method;
                hash<auto> info;
                client.send(data, method, "/" + name, {"Content-Type": "application/octet-stream"}, False, \info);
                assertEq(201, info."response-headers".status_code, label);
                assertEq({"method": method, "protocol": protocol.name, "streamed": True}, handler.uploads.get(10000),
                    label);
                assertEq(data, ReadOnlyFile::readBinaryFile(tmp.path + DirSep + name), label);
                assertFalse(is_file(tmp.path + DirSep + name + ".webdav-upload"), label);
            }
            # replacing a resource
            hash<auto> info;
            binary replacement = binary(strmul("fedcba9876543210", 4096));
            client.send(replacement, "PUT", "/" + protocol.name + "-put.bin", {"Content-Type":
                "application/octet-stream"}, False, \info);
            assertEq(204, info."response-headers".status_code, protocol.name);
            assertTrue(handler.uploads.get(10000).streamed, protocol.name);
            assertEq(replacement, ReadOnlyFile::readBinaryFile(tmp.path + DirSep + protocol.name + "-put.bin"));

            # bodies exceeding the limit: 413, and neither a partial nor a temporary file
            binary large = binary(strmul("0123456789abcdef", Limit / 16 + 1024));
            foreach string method in ("PUT", "POST") {
                string name = sprintf("%s-%s-large.bin", protocol.name, method.lwr());
                string label = protocol.name + " " + method + " over the limit";
                HTTPClient large_client({"url": sprintf("https://127.0.0.1:%d", port), "http_version":
                    protocol.http_version, "error_passthru": True, "timeout": 30000, "connect_timeout": 15000});
                large_client.send(large, method, "/" + name, {"Content-Type": "application/octet-stream"}, False,
                    \info);
                assertEq(413, info."response-headers".status_code, label);
                assertTrue(handler.uploads.get(10000).streamed, label);
                assertFalse(is_file(tmp.path + DirSep + name), label);
                assertFalse(is_file(tmp.path + DirSep + name + ".webdav-upload"), label);
            }
            # replacing an existing resource with a body over the limit leaves it unchanged
            HTTPClient large_client({"url": sprintf("https://127.0.0.1:%d", port), "http_version":
                protocol.http_version, "error_passthru": True, "timeout": 30000, "connect_timeout": 15000});
            large_client.send(large, "PUT", "/" + protocol.name + "-put.bin", {"Content-Type":
                "application/octet-stream"}, False, \info);
            assertEq(413, info."response-headers".status_code, protocol.name);
            handler.uploads.get(10000);
            assertEq(replacement, ReadOnlyFile::readBinaryFile(tmp.path + DirSep + protocol.name + "-put.bin"));
        }
        assertEq(0, handler.uploads.size());
    }

    testStreamMissingContext() {
        BinaryOutputStream out();
        # No http2/http3 markers — helper has nothing to read from
        assertThrows("WEBDAV-STREAMING-ERROR",
            \WebDavHandler::AbstractWebDavHandler::streamBodyToOutputStream(),
            ({"header-info": {}}, {"method": "PUT"}, out));
    }

    # End-to-end round-trip via HTTP/1.1 — the buffered path. The streaming PUT/POST branch
    # in FsWebDavHandler isn't exercised here because the framework buffers HTTP/1.1
    # request bodies regardless of wantsBodyStreaming(). The point of this test is to
    # confirm the streaming branch's existence didn't break the buffered path.
    testBufferedRoundTrip() {
        TmpDir tmp();
        WebDavHandler::FsWebDavHandler handler(tmp.path);
        Logger logger("test", LoggerLevel::getLevelInfo());
        HttpServer srv(<HttpServerOptionInfo>{"logger": logger, "debug": True});
        srv.setHandler("webdavhandler", "/", NOTHING, handler);
        srv.setDefaultHandler("webdavhandler", handler);
        map srv.addHttpMethod($1), handler.getHttpMethods();
        int port = srv.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        on_exit srv.stop();

        WebDavClientIo::WebDavClientIo wd({"url": "http://localhost:" + port});
        on_exit wd.close();
        # Force the policy to engage by setting threshold to 0; even so HTTP/1.1 buffers
        # everything, so we expect the buffered path to still succeed.
        handler.setBodyStreamingThreshold(0);

        # Build a 32 KB payload that would qualify for streaming on HTTP/2/3
        string text = strmul("ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789", 1024);
        binary payload = binary(text);
        wd.put("/big.bin", payload, "application/octet-stream");
        *data fetched = wd.get("/big.bin");
        assertEq(payload, binary(fetched));
    }
}
