#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class XmlContextTest

class XmlContextTest inherits QUnit::Test {
    constructor() : Test("Retained XML language, space and base context", "1.0") {
        addTestCase("Child extraction preserves inherited context separately", \childContext());
        addTestCase("Root and descendant overrides retain empty language resets", \overrides());
        addTestCase("Base URI resolution includes relative, absolute and empty values", \baseUris());
        addTestCase("Serialization preserves context and accepts previous XML-only state", \reconstruction());
        addTestCase("Generator puts inherited attributes on the parent", \generation());
        addTestCase("Invalid constructor and serialized context is rejected", \invalidContext());
        addTestCase("Returned context maps do not mutate the carrier", \isolation());
        addTestCase("Character references in authored attributes survive extraction", \attributeWhitespace());
        addTestCase("XML Base follows RFC resolution and preserves unescaped IRIs", \referenceResolution());
        set_return_value(main());
    }

    referenceResolution() {
        # RFC 3986 section 5.4 normal and abnormal reference resolution examples.
        hash<string, string> references = {
            "g:h": "g:h", "g": "http://a/b/c/g", "./g": "http://a/b/c/g", "g/": "http://a/b/c/g/",
            "/g": "http://a/g", "//g": "http://g", "?y": "http://a/b/c/d;p?y",
            "g?y": "http://a/b/c/g?y", "#s": "http://a/b/c/d;p?q#s", "g#s": "http://a/b/c/g#s",
            "g?y#s": "http://a/b/c/g?y#s", ";x": "http://a/b/c/;x", "g;x": "http://a/b/c/g;x",
            "g;x?y#s": "http://a/b/c/g;x?y#s", "": "http://a/b/c/d;p?q", ".": "http://a/b/c/",
            "./": "http://a/b/c/", "..": "http://a/b/", "../": "http://a/b/", "../g": "http://a/b/g",
            "../..": "http://a/", "../../": "http://a/", "../../g": "http://a/g", "../../../g": "http://a/g",
            "../../../../g": "http://a/g", "/./g": "http://a/g", "/../g": "http://a/g",
            "g.": "http://a/b/c/g.", ".g": "http://a/b/c/.g", "g..": "http://a/b/c/g..",
            "..g": "http://a/b/c/..g", "./../g": "http://a/b/g", "./g/.": "http://a/b/c/g/",
            "g/./h": "http://a/b/c/g/h", "g/../h": "http://a/b/c/h",
            "g;x=1/./y": "http://a/b/c/g;x=1/y", "g;x=1/../y": "http://a/b/c/y",
            "g?y/./x": "http://a/b/c/g?y/./x", "g?y/../x": "http://a/b/c/g?y/../x",
            "g#s/./x": "http://a/b/c/g#s/./x", "g#s/../x": "http://a/b/c/g#s/../x", "http:g": "http:g",
        };
        foreach string reference_uri in (keys references) {
            XsdXmlValue value(make_xml({"item": {"^attributes^": {"xml:base": reference_uri}}}),
                {"xml:base": "http://a/b/c/d;p?q"});
            assertEq(references{reference_uri}, value.getXmlContext()."xml:base", reference_uri);
        }
        foreach list<string> row in (("https://example.org/wine/", "rosé", "https://example.org/wine/rosé"),
                ("https://example.org/café/", "../a b/", "https://example.org/a b/"),
                ("https://český.example/a/", "../b/", "https://český.example/b/"),
                ("https://example.org/a%20b/", "%2e%2e/c", "https://example.org/a%20b/%2e%2e/c"),
                ("https://example.org/a//b/", "../c", "https://example.org/a//c"),
                ("https://example.org/a?old#part", "?", "https://example.org/a?"),
                ("https://example.org/a?old#part", "#", "https://example.org/a?old#"),
                ("../a/", "../b/", "../b/"),
                ("../a/", "../../b/", "../../b/"),
                ("https://example.org/a/", "a%20b/%2F?x=/../#", "https://example.org/a/a%20b/%2F?x=/../#"),
                ("", "a/../b/", "a/../b/"), ("a/", "../../b/", "../b/"),
                ("http://example.org/a/", "g:a/../b", "g:/b"),
                ("http://example.org/a/", "g:../b", "g:b"),
                ("http://example.org/a/", "g:a/..", "g:/"),
                ("http://example.org", "item", "http://example.org/item")) {
            XsdXmlValue value(make_xml({"item": {"^attributes^": {"xml:base": row[1]}, "child": NOTHING}}),
                {"xml:base": row[0]});
            assertEq(row[2], value.getXmlContext()."xml:base");
            assertEq(row[2], value.getChildValues()[0].getXmlContext()."xml:base");
            assertEq(row[2], Serializable::deserialize(value.serialize()).getXmlContext()."xml:base");
        }
        string path = "https://example.org/" + (map "part/../", (1..4096)).join("") + "café/";
        XsdXmlValue large(make_xml({"item": {"^attributes^": {"xml:base": path}}}), {"xml:base": "http://a/"});
        assertEq("https://example.org/café/", large.getXmlContext()."xml:base");
    }

    childContext() {
        XsdXmlValue root('<root xml:lang="en" xml:space="preserve" xml:base="https://example.org/a/">'
            '<item>009<inner/></item><other/></root>');
        hash<string, string> expected = {"xml:lang": "en", "xml:space": "preserve",
            "xml:base": "https://example.org/a/"};
        assertEq({}, root.getInheritedXmlAttributes());
        assertEq(expected, root.getXmlContext());
        list<XsdXmlValue> children = root.getChildValues();
        assertEq(("item", "other"), map $1.getLocalName(), children);
        foreach XsdXmlValue child in (children) {
            assertEq(expected, child.getInheritedXmlAttributes());
            assertEq(expected, child.getXmlContext());
            assertFalse(exists child.getElementData()."^attributes^"."xml:lang");
            assertFalse(exists child.getElementData()."^attributes^"."xml:space");
            assertFalse(exists child.getElementData()."^attributes^"."xml:base");
        }
        XsdXmlValue grandchild = children[0].getChildValues()[0];
        assertEq(expected, grandchild.getInheritedXmlAttributes());
        assertEq(expected, grandchild.getXmlContext());
    }

    overrides() {
        XsdXmlValue root('<root xml:lang="en" xml:space="preserve" xml:base="https://example.org/a/">'
            '<item xml:lang="" xml:space="default" xml:base="../b/"><inner xml:lang="cs"/></item></root>');
        XsdXmlValue child = root.getChildValues()[0];
        hash<string, string> expected = {"xml:lang": "", "xml:space": "default",
            "xml:base": "https://example.org/b/"};
        assertEq(expected, child.getXmlContext());
        assertEq("../b/", child.getElementData()."^attributes^"."xml:base");
        assertEq("", child.getElementData()."^attributes^"."xml:lang");
        assertEq(expected, child.getChildValues()[0].getInheritedXmlAttributes());
        expected."xml:lang" = "cs";
        assertEq(expected, child.getChildValues()[0].getXmlContext());
    }

    baseUris() {
        foreach list<string> row in (("a/", "../b/", "b/"),
                ("https://example.org/a/", "https://other.example/c/", "https://other.example/c/"),
                ("https://example.org/a/", "", "https://example.org/a/"),
                ("https://example.org/a/file?old", "?new", "https://example.org/a/file?new"),
                ("https://example.org/wine/", "rosé", "https://example.org/wine/rosé"),
                ("https://example.org/a/", "../b/file#part", "https://example.org/b/file#part"),
                ("", "../b/", "../b/")) {
            XsdXmlValue value(make_xml({"item": {"^attributes^": {"xml:base": row[1]}}}),
                {"xml:base": row[0]});
            assertEq(row[2], value.getXmlContext()."xml:base");
            assertEq(row[1], value.getElementData()."^attributes^"."xml:base");
            assertEq(value.getXmlContext(), Serializable::deserialize(value.serialize()).getXmlContext());
        }
        XsdXmlValue no_base('<item/>');
        assertFalse(no_base.getXmlContext().hasKey("xml:base"));
        XsdXmlValue empty_base('<item xml:base=""/>');
        assertTrue(empty_base.getXmlContext().hasKey("xml:base"));
        assertEq("", empty_base.getXmlContext()."xml:base");
    }

    reconstruction() {
        XsdXmlValue original('<item xml:base="../b/">009</item>', {"xml:lang": "", "xml:space": "preserve",
            "xml:base": "https://example.org/a/"});
        XsdXmlValue restored = Serializable::deserialize(original.serialize());
        assertEq(original.getXml(), restored.getXml());
        assertEq(original.getInheritedXmlAttributes(), restored.getInheritedXmlAttributes());
        assertEq(original.getXmlContext(), restored.getXmlContext());
        hash<SerializationInfo> state = original.serializeToData();
        remove state._index."0"._class_data."WSDL::XsdXmlValue".inherited_xml_attributes;
        restored = Serializable::deserialize(state);
        assertEq({}, restored.getInheritedXmlAttributes());
        assertEq({"xml:base": "../b/"}, restored.getXmlContext());
    }

    generation() {
        XsdXmlValue original('<item xml:base="../b/">009</item>', {"xml:lang": "cs", "xml:space": "preserve",
            "xml:base": "https://example.org/a/"});
        foreach XsdXmlValue value in (original, Serializable::deserialize(original.serialize())) {
            string xml = make_xml({"batch": value.getXmlSerializationData()});
            hash<auto> parsed = parse_xml(xml);
            assertEq(value.getInheritedXmlAttributes(), parsed.batch."^attributes^");
            assertEq({"xmlns": "", "xml:base": "../b/"}, parsed.batch.item."^attributes^");
            XmlReader reader(xml);
            list<string> languages();
            list<string> bases();
            while (reader.read()) {
                if (reader.nodeType() == XML_NODE_TYPE_ELEMENT) {
                    languages += reader.xmlLang();
                    bases += reader.baseUri();
                }
            }
            assertEq(("cs", "cs"), languages);
            assertEq(("https://example.org/a/", "https://example.org/b/"), bases);
            assertEq("009", parsed.batch.item."^value^");
        }
    }

    private XsdXmlValue construct(hash<string, string> attributes) {
        return new XsdXmlValue('<item/>', attributes);
    }

    invalidContext() {
        foreach hash<string, string> attributes in ({"unknown": "value"}, {"xml:id": "id"},
                {"xmlns": "urn:injected"}, {"xml:space": ""}, {"xml:space": "invalid"},
                {"xml:lang": "a\0b"}, {"xml:lang": "a\x01b"}) {
            assertThrows("XML-CONTEXT-ERROR", \construct(), (attributes,));
        }
        XsdXmlValue value('<item/>');
        foreach auto attributes in (42, NOTHING, {"xml:lang": 42}, {"xml:lang": NOTHING},
                {"unknown": "value"}, {"xml:space": "invalid"},
                {"xml:lang": "a\0b"}, {"xml:lang": "a\x01b"}) {
            hash<SerializationInfo> state = value.serializeToData();
            state._index."0"._class_data."WSDL::XsdXmlValue".inherited_xml_attributes = attributes;
            assertThrows("DESERIALIZATION-ERROR", \Serializable::deserialize(), (state,));
        }
        assertEq({"xml:lang": ""}, construct({"xml:lang": ""}).getXmlContext());
    }

    attributeWhitespace() {
        XsdXmlValue root('<batch><item label="before&#9;middle&#10;after&#13;end">009</item></batch>');
        XsdXmlValue item = root.getChildValues()[0];
        assertEq("before\tmiddle\nafter\rend", item.getElementData()."^attributes^".label);
        assertEq("before\tmiddle\nafter\rend", parse_xml(make_xml({"parent": item.getXmlSerializationData()}))
            .parent.item."^attributes^".label);
        assertEq(item.getElementData(), Serializable::deserialize(item.serialize()).getElementData());
        XsdXmlValue inherited('<item/>', {"xml:lang": "a\tb\nc\rd"});
        assertEq("a\tb\nc\rd", parse_xml(make_xml({"parent": inherited.getXmlSerializationData()}))
            .parent."^attributes^"."xml:lang");
    }

    isolation() {
        XsdXmlValue value('<item/>', {"xml:lang": "en"});
        hash<string, string> changed = value.getInheritedXmlAttributes();
        changed."xml:lang" = "cs";
        hash<string, string> effective = value.getXmlContext();
        effective."xml:lang" = "de";
        hash<auto> generator = value.getXmlSerializationData();
        generator."^attributes^"."xml:lang" = "fr";
        assertEq("cs", changed."xml:lang");
        assertEq("de", effective."xml:lang");
        assertEq("fr", generator."^attributes^"."xml:lang");
        assertEq({"xml:lang": "en"}, value.getInheritedXmlAttributes());
        assertEq({"xml:lang": "en"}, value.getXmlContext());
        assertEq({"xml:lang": "en"}, value.getXmlSerializationData()."^attributes^");
    }
}
