#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class ElementNamespacesTest

class ElementNamespacesTest inherits QUnit::Test {
    private {
        const Ns = "urn:qore:element-namespaces";
    }

    constructor() : QUnit::Test("Incoming WSDL element namespace identity", "1.0") {
        addTestCase("Document roots require their declared expanded name", \roots());
        addTestCase("Local forms require the correct namespace", \localForms());
        addTestCase("Default namespaces and descendant resets are scoped", \defaultNamespaces());
        addTestCase("Repeated aliases retain false, zero and empty values", \repeatedAliases());
        addTestCase("Namespace rejection leaves input and subsequent calls intact", \recovery());
        addTestCase("Expanded XML retains scoped identities and ordered values", \expandedValues());
        addTestCase("Malformed parsed names and bindings reject without partial updates", \malformedNames());
        addTestCase("Deep scopes retain only locally declared bindings", \deepScopes());
        addTestCase("Large repeated alias lists preserve every value in order", \largeRepeatedValues());
        addTestCase("Expanded names serialize without overwriting retained QName bindings", \restoredNames());
        addTestCase("Wildcard values retain expanded element keys through serialization", \wildcardNames());
        set_return_value(main());
    }

    private WebService service(string version, string model = "") {
        if (!model) {
            model = '<xs:sequence><xs:element name="flag" type="xs:boolean" form="qualified"/>
                <xs:element name="count" type="xs:int" form="unqualified"/></xs:sequence>';
        }
        string soap_ns = version == "11" ? "http://schemas.xmlsoap.org/wsdl/soap/"
            : "http://schemas.xmlsoap.org/wsdl/soap12/";
        return new WebService(sprintf('<w:definitions xmlns:w="http://schemas.xmlsoap.org/wsdl/"
            xmlns:t="%s" xmlns:s="%s" targetNamespace="%s"><w:types>
            <xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="%s">
            <xs:complexType name="Record">%s</xs:complexType><xs:element name="Request" type="t:Record"/>
            <xs:element name="Response" type="t:Record"/></xs:schema></w:types>
            <w:message name="In"><w:part name="body" element="t:Request"/></w:message>
            <w:message name="Out"><w:part name="body" element="t:Response"/></w:message>
            <w:portType name="Port"><w:operation name="submit"><w:input message="t:In"/>
            <w:output message="t:Out"/></w:operation></w:portType><w:binding name="Soap" type="t:Port">
            <s:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
            <w:operation name="submit"><s:operation soapAction="urn:submit"/>
            <w:input><s:body use="literal"/></w:input><w:output><s:body use="literal"/></w:output>
            </w:operation></w:binding><w:service name="Service"><w:port name="Port" binding="t:Soap">
            <s:address location="http://example.invalid/"/></w:port></w:service></w:definitions>',
            Ns, soap_ns, Ns, Ns, model), {"async_only": True});
    }

    private hash<auto> envelope(string version, string payload, string attributes = "") {
        return parse_xml(sprintf('<e:Envelope xmlns:e="%s" xmlns:t="%s" %s><e:Body>%s</e:Body></e:Envelope>',
            version == "11" ? "http://schemas.xmlsoap.org/soap/envelope/"
                : "http://www.w3.org/2003/05/soap-envelope", Ns, attributes, payload));
    }

    private auto decode(WSOperation op, bool response, hash<auto> value) {
        return response ? op.deserializeResponse(value, "Soap") : op.deserializeRequest(value, "Soap");
    }

    roots() {
        foreach string version in ("11", "12") {
            WebService ws = service(version);
            WSOperation op = ws.getBindingOperation("Soap", "submit");
            foreach bool response in (False, True) {
                string root = response ? "Response" : "Request";
                foreach string name in (root, "wrong:" + root, "t:Other") {
                    hash<auto> wire = envelope(version, sprintf('<%s xmlns:wrong="urn:wrong">
                        <t:flag>false</t:flag><count>0</count></%s>', name, name));
                    assertThrows("SOAP-DESERIALIZATION-ERROR", \decode(), (op, response, wire));
                }
                assertEq({"flag": False, "count": 0}, decode(op, response, envelope(version,
                    sprintf('<t:%s><t:flag>false</t:flag><count>0</count></t:%s>', root, root))));
            }
        }
    }

    localForms() {
        foreach string version in ("11", "12") {
            WebService ws = service(version);
            WSOperation op = ws.getBindingOperation("Soap", "submit");
            foreach bool response in (False, True) {
                string root = response ? "Response" : "Request";
                foreach string content in ('<flag>false</flag><count>0</count>',
                        '<x:flag xmlns:x="urn:wrong">false</x:flag><count>0</count>',
                        '<t:flag>false</t:flag><t:count>0</t:count>',
                        '<t:flag>false</t:flag><count>0</count><x:count xmlns:x="urn:wrong">1</x:count>') {
                    assertThrows("SOAP-DESERIALIZATION-ERROR", \decode(), (op, response,
                        envelope(version, sprintf('<t:%s>%s</t:%s>', root, content, root))));
                }
            }
        }
    }

    defaultNamespaces() {
        foreach string version in ("11", "12") {
            WebService ws = service(version);
            WSOperation op = ws.getBindingOperation("Soap", "submit");
            foreach bool response in (False, True) {
                string root = response ? "Response" : "Request";
                assertEq({"flag": False, "count": 0}, decode(op, response, envelope(version,
                    sprintf('<%s xmlns="%s"><flag>false</flag><count xmlns="">0</count></%s>', root, Ns, root))));
                assertThrows("SOAP-DESERIALIZATION-ERROR", \decode(), (op, response, envelope(version,
                    sprintf('<%s xmlns="%s"><flag>false</flag><count>0</count></%s>', root, Ns, root))));
                assertEq({"flag": False, "count": 0}, decode(op, response, envelope(version,
                    sprintf('<q:%s xmlns:q="%s"><q:flag>false</q:flag><count>0</count></q:%s>', root, Ns, root),
                    'xmlns:q="urn:outer"')));
            }
        }
    }

    repeatedAliases() {
        string model = '<xs:sequence><xs:element name="value" type="xs:string" form="qualified"
            maxOccurs="unbounded"/></xs:sequence>';
        foreach string version in ("11", "12") {
            WebService ws = service(version, model);
            WSOperation op = ws.getBindingOperation("Soap", "submit");
            foreach bool response in (False, True) {
                string root = response ? "Response" : "Request";
                hash<auto> wire = envelope(version, sprintf('<t:%s xmlns:a="%s" xmlns:b="%s">
                    <a:value></a:value><b:value>0</b:value><t:value>false</t:value></t:%s>', root, Ns, Ns, root));
                assertEq({"value": ("", "0", "false")}, decode(op, response, wire));
                assertThrows("SOAP-DESERIALIZATION-ERROR", \decode(), (op, response, envelope(version,
                    sprintf('<t:%s xmlns:a="urn:wrong"><t:value>0</t:value><a:value>false</a:value></t:%s>',
                        root, root))));
            }
        }
    }

    recovery() {
        WebService ws = service("11");
        foreach WebService current in (ws, Serializable::deserialize(ws.serialize())) {
            WSOperation op = current.getBindingOperation("Soap", "submit");
            hash<auto> broken = envelope("11", '<t:Request><t:flag>false</t:flag><t:count>0</t:count></t:Request>');
            hash<auto> original = broken;
            assertThrows("SOAP-DESERIALIZATION-ERROR", \decode(), (op, False, broken));
            assertEq(original, broken);
            hash<auto> valid = envelope("11", '<t:Request><t:flag>false</t:flag><count>0</count></t:Request>');
            original = valid;
            assertEq({"flag": False, "count": 0}, decode(op, False, valid));
            assertEq(original, valid);
        }
    }

    expandedValues() {
        hash<auto> source = parse_xml('<r xmlns="urn:outer" xmlns:p="urn:original">
            <p:item xmlns:p="urn:first">one</p:item><p:item xmlns:p="urn:second">two</p:item>
            <p:item>three</p:item><child xmlns=""><item>four</item></child>
            <p:item>five</p:item></r>', XPF_PRESERVE_ORDER);
        hash<auto> original = source;
        hash<auto> expanded = XsdBase::expandElementNamespaces(source);
        auto root = expanded."{urn:outer}r";
        assertEq(("^attributes^", "{urn:first}item", "{urn:second}item", "{urn:original}item",
            "{}child", "{urn:original}item^1"), keys root);
        assertEq("one", root."{urn:first}item"."^value^");
        assertEq("two", root."{urn:second}item"."^value^");
        assertEq("three", root."{urn:original}item");
        assertEq("four", root."{}child"."{}item");
        assertEq("five", root."{urn:original}item^1");
        assertEq(original, source);
        assertEq({"{urn:values}item": (False, 0, "")}, XsdBase::expandElementNamespaces(
            {"a:item": False, "b:item": 0, "c:item": ""}, {"a": "urn:values", "b": "urn:values", "c": "urn:values"}));
        assertEq({"{urn:Case}item": "first", "{urn:case}item": "second"},
            XsdBase::expandElementNamespaces({"a:item": "first", "b:item": "second"},
                {"a": "urn:Case", "b": "urn:case"}));
        hash<auto> attributed = XsdBase::expandElementNamespaces(parse_xml(
            '<root xmlns:p="urn:attributes"><child p:code="0"/></root>'));
        assertEq({"{urn:attributes}code": "0"},
            XsdBase::getExpandedAttributes(attributed."{}root"."{}child"."^attributes^"));
    }

    malformedNames() {
        foreach string name in ("missing:item", "a:b:c", "prefix:", ":local", "1item", "a b", "xmlns:item") {
            assertThrows("SOAP-DESERIALIZATION-ERROR", \XsdBase::expandElementNamespaces(), ({name: "value"},));
        }
        foreach hash<auto> attrs in ({"xmlns": 1}, {"xmlns:bad prefix": "urn:x"}, {"xmlns:1bad": "urn:x"},
                {"xmlns:p": ""}, {"xmlns": "http://www.w3.org/XML/1998/namespace"},
                {"xmlns": "http://www.w3.org/2000/xmlns/"}) {
            hash<auto> source = {"p:root": {"^attributes^": {"xmlns:p": "urn:changed"},
                "child": {"^attributes^": attrs}}};
            hash<auto> original = source;
            hash<string, string> inherited = {"p": "urn:original"};
            assertThrows("SOAP-DESERIALIZATION-ERROR", \XsdBase::expandElementNamespaces(), (source, inherited));
            assertEq(original, source);
            assertEq({"p": "urn:original"}, inherited);
            assertEq({"{urn:original}root": "next"}, XsdBase::expandElementNamespaces({"p:root": "next"}, inherited));
        }
        assertThrows("SOAP-DESERIALIZATION-ERROR", \XsdBase::expandElementNamespaces(),
            ({"root": {"^attributes^": "invalid"}},));
        assertThrows("SOAP-DESERIALIZATION-ERROR", \XsdBase::expandElementNamespaces(), ({"root": ()},));
    }

    deepScopes() {
        hash<auto> source = {"p:item": "leaf"};
        for (int depth = 0; depth < 128; ++depth) {
            hash<auto> parent();
            parent."^attributes^" = {"xmlns:n" + depth: "urn:depth:" + depth};
            parent.child = source;
            source = parent;
        }
        hash<auto> value = XsdBase::expandElementNamespaces(source, {"p": "urn:outer"});
        for (int depth = 0; depth < 128; ++depth) {
            assertEq(1, value."^attributes^".size());
            value = value."{}child";
        }
        assertEq({"{urn:outer}item": "leaf"}, value);
    }

    largeRepeatedValues() {
        list<auto> expected();
        list<auto> first();
        list<auto> second();
        for (int i = 0; i < 4096; ++i) {
            auto value = i % 3 == 0 ? False : (i % 3 == 1 ? i : string(i));
            expected += (value,);
            if (i < 2048) {
                first += (value,);
            } else {
                second += (value,);
            }
        }
        hash<auto> source = {"a:item": first, "b:item": second};
        hash<auto> original = source;
        hash<auto> expanded = XsdBase::expandElementNamespaces(source, {"a": "urn:items", "b": "urn:items"});
        assertEq(("{urn:items}item",), keys expanded);
        assertEq(4096, expanded."{urn:items}item".size());
        assertEq(expected, expanded."{urn:items}item");
        assertEq(original, source);
    }

    restoredNames() {
        hash<auto> value = {"{urn:record}root": {"^attributes^": {"xmlns:qorexml0": "urn:types",
            "kind": "qorexml0:Specific", "xmlns": "urn:default"}, "{}child": "0",
            "{http://www.w3.org/XML/1998/namespace}item": "text"}};
        hash<auto> original = value;
        string restored_xml = make_xml(XsdBase::restoreElementNamespaces(value));
        XmlReader restored(restored_xml);
        assertTrue(restored.read());
        assertEq("root", restored.localName());
        assertEq("urn:record", restored.namespaceUri());
        assertEq("qorexml0:Specific", restored.getAttribute("kind"));
        assertEq("urn:types", restored.lookupNamespace("qorexml0"));
        assertEq("urn:default", restored.lookupNamespace());
        auto expanded = XsdBase::expandElementNamespaces(parse_xml(restored_xml))."{urn:record}root";
        assertEq("0", expanded."{}child"."^value^");
        auto xml_item = expanded."{http://www.w3.org/XML/1998/namespace}item";
        assertEq("text", xml_item.typeCode() == NT_HASH ? xml_item."^value^" : xml_item);
        assertEq(original, value);
        string unbound_xml = make_xml(XsdBase::restoreElementNamespaces({"{urn:record}root":
            {"^attributes^": {"kind": "qorexml0:Ghost"}, "^value^": "qorexml1:Ghost"}}));
        XmlReader unbound(unbound_xml);
        assertTrue(unbound.read());
        assertEq("qorexml0:Ghost", unbound.getAttribute("kind"));
        assertEq("qorexml1:Ghost", unbound.getInnerXml());
        assertEq(NOTHING, unbound.lookupNamespace("qorexml0"));
        assertEq(NOTHING, unbound.lookupNamespace("qorexml1"));
        foreach string name in ("{urn:x}", "{urn:x}bad:name", "{urn:x}1name", "{urn:x}name^bad",
                "{http://www.w3.org/2000/xmlns/}name") {
            assertThrows("SOAP-SERIALIZATION-ERROR", \XsdBase::restoreElementNamespaces(), ({name: "text"},));
        }
    }

    wildcardNames() {
        string model = '<xs:sequence><xs:any namespace="##any" processContents="skip" maxOccurs="unbounded"/>
            </xs:sequence>';
        foreach string version in ("11", "12") {
            WebService ws = service(version, model);
            WSOperation op = ws.getBindingOperation("Soap", "submit");
            foreach bool response in (False, True) {
                string root = response ? "Response" : "Request";
                auto decoded = decode(op, response, envelope(version, sprintf('<t:%s>
                    <a:item xmlns:a="urn:first">0</a:item><b:item xmlns:b="urn:second">false</b:item>
                    <item></item></t:%s>', root, root)));
                assertEq(("{urn:first}item", "{urn:second}item", "{}item"), keys decoded);
                hash<auto> wrapped = {root: decoded};
                hash<auto> wire = response
                    ? op.serializeResponse(wrapped, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, "Soap")
                    : op.serializeRequest(wrapped, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, "Soap");
                auto repeated = decode(op, response, parse_xml(wire.body));
                assertEq(("{urn:first}item", "{urn:second}item", "{}item"), keys repeated);
                assertEq("0", repeated."{urn:first}item"."^value^");
                assertEq("false", repeated."{urn:second}item"."^value^");
                assertEq("", string(repeated."{}item"."^value^"));
            }
        }
    }
}
