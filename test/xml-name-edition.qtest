#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%exec-class XmlNameEditionTest

# XSD 1.0 Name-derived datatypes use the XML 1.0 Second Edition name characters (Appendix B), while XML 1.0 names
# in documents use the Fifth Edition characters; the bundled libxml2 2.15 validated both with the Fifth Edition ones
class XmlNameEditionTest inherits QUnit::Test {
    private {
        const Xsd = "http://www.w3.org/2001/XMLSchema";

        # values valid for Name, NCName and QName, and for NMTOKEN
        const Valid = ("Alpha", "Αλφα", "中文", "a\u0301", "a·b", "x_y-z.1");
        # U+0301 and a digit may continue but not start a name
        const TokenOnly = ("\u0301a", "1a", "-a");
        # Fifth Edition only: U+0370, U+037F, U+2070, U+2C00 and U+10000
        const FifthOnly = ("\u0370a", "a\u0370", "\u037fa", "\u2070a", "\u2c00a", "\U00010000a", "a\U00010000");
    }

    constructor() : Test("XSD name characters", "1.0") {
        addTestCase("Name-derived values accept Second Edition names", \secondEdition());
        addTestCase("Name-derived values reject Fifth Edition only characters", \fifthEdition());
        addTestCase("Lists, IDs, IDREFs and ENTITYs use the same characters", \derived());
        addTestCase("Schema documents reject Fifth Edition only component names", \schemaDocuments());
        addTestCase("XML element and attribute names keep the Fifth Edition characters", \xmlNames());
        set_return_value(main());
    }

    static string schema(string type) {
        return sprintf("<xs:schema xmlns:xs=\"%s\"><xs:element name=\"v\" type=\"xs:%s\"/></xs:schema>", Xsd, type);
    }

    # validates with every native validator and asserts that all of them give the expected result
    checkValue(string xml, string xsd, bool valid, string label) {
        code doc = sub () { XmlDoc document(xml); document.validateSchema(xsd); };
        code parse = auto sub () { return parse_xml_with_schema(xml, xsd); };
        code reader = auto sub () { XmlReader r(xml); r.schemaValidateString(xsd); return r.toQore(); };
        if (valid) {
            doc();
            # validation does not change the parsed value
            hash<auto> expected = parse_xml(xml);
            assertEq(expected, parse(), label + " (parse_xml_with_schema)");
            assertEq(expected, reader(), label + " (XmlReader)");
            return;
        }
        assertThrows("XSD-ERROR", doc, NOTHING, label + " (XmlDoc)");
        assertThrows("PARSE-XML-EXCEPTION", parse, NOTHING, label + " (parse_xml_with_schema)");
        assertThrows("PARSE-XML-EXCEPTION", reader, NOTHING, label + " (XmlReader)");
    }

    secondEdition() {
        foreach string type in ("Name", "NCName", "QName", "NMTOKEN") {
            foreach string value in (Valid) {
                checkValue(sprintf("<v>%s</v>", value), schema(type), True, type + " " + value);
            }
            # surrounding whitespace is collapsed
            checkValue(sprintf("<v> \t%s\n</v>", Valid[1]), schema(type), True, type + " whitespace");
        }
        foreach string value in (TokenOnly) {
            checkValue(sprintf("<v>%s</v>", value), schema("NMTOKEN"), True, "NMTOKEN " + value);
            foreach string type in ("Name", "NCName", "QName") {
                checkValue(sprintf("<v>%s</v>", value), schema(type), False, type + " " + value);
            }
        }
        # the colon belongs to Name and NMTOKEN, separates a QName and is not part of an NCName
        checkValue("<v>a:b</v>", schema("Name"), True, "Name a:b");
        checkValue("<v xmlns:a=\"urn:a\">a:b</v>", schema("QName"), True, "QName a:b");
        checkValue("<v>a:b</v>", schema("NCName"), False, "NCName a:b");
        checkValue("<v xmlns:Αλφα=\"urn:a\">Αλφα:中文</v>", schema("QName"), True, "QName with a Greek prefix");
    }

    fifthEdition() {
        foreach string type in ("Name", "NCName", "QName", "NMTOKEN") {
            foreach string value in (FifthOnly) {
                checkValue(sprintf("<v>%s</v>", value), schema(type), False, type + " " + value);
            }
        }
        # either part of a QName
        checkValue("<v xmlns:a=\"urn:a\">a:\u0370b</v>", schema("QName"), False, "QName local part");
        checkValue("<v xmlns:\u0370a=\"urn:a\">\u0370a:b</v>", schema("QName"), False, "QName prefix");
    }

    derived() {
        checkValue("<v>Alpha 中文 \u0301a</v>", schema("NMTOKENS"), True, "NMTOKENS");
        checkValue("<v>Alpha \u0370a</v>", schema("NMTOKENS"), False, "NMTOKENS item");
        string ids = sprintf("<xs:schema xmlns:xs=\"%s\"><xs:element name=\"r\"><xs:complexType><xs:sequence>"
            "<xs:element name=\"e\" maxOccurs=\"unbounded\"><xs:complexType>"
            "<xs:attribute name=\"id\" type=\"xs:ID\"/><xs:attribute name=\"ref\" type=\"xs:IDREF\"/>"
            "<xs:attribute name=\"refs\" type=\"xs:IDREFS\"/></xs:complexType></xs:element>"
            "</xs:sequence></xs:complexType></xs:element></xs:schema>", Xsd);
        checkValue("<r><e id=\"Αλφα\"/><e ref=\"Αλφα\" refs=\"Αλφα\"/></r>", ids, True, "ID and IDREF");
        checkValue("<r><e id=\"\u0370a\"/></r>", ids, False, "ID");
        checkValue("<r><e id=\"a\"/><e ref=\"\u0370a\"/></r>", ids, False, "IDREF");
        checkValue("<r><e id=\"a\"/><e refs=\"a \u0370a\"/></r>", ids, False, "IDREFS");
        # ENTITY values name an unparsed entity; the DTD itself accepts Fifth Edition names
        string entity = sprintf("<xs:schema xmlns:xs=\"%s\"><xs:element name=\"v\"><xs:complexType>"
            "<xs:attribute name=\"e\" type=\"xs:ENTITY\"/></xs:complexType></xs:element></xs:schema>", Xsd);
        foreach hash<auto> row in ({"name": "Αλφα", "valid": True}, {"name": "\u0370a", "valid": False}) {
            string xml = sprintf("<!DOCTYPE v [<!NOTATION n SYSTEM \"n\"><!ENTITY %s SYSTEM \"u\" NDATA n>]>"
                "<v e=\"%s\"/>", row.name, row.name);
            checkValue(xml, entity, row.valid, "ENTITY " + row.name);
        }
    }

    schemaDocuments() {
        # component names are NCNames, ids are IDs and type references are QNames; each row has a template, a valid
        # value with an instance document that the resulting schema accepts, and a Fifth Edition only value
        foreach hash<auto> row in (
                {"template": "<xs:element name=\"%s\" type=\"xs:string\"/>", "valid": "Αλφα",
                 "xml": "<Αλφα>x</Αλφα>", "invalid": "Ͱa"},
                {"template": "<xs:element name=\"v\" id=\"%s\" type=\"xs:string\"/>", "valid": "Αλφα",
                 "xml": "<v>x</v>", "invalid": "Ͱa"},
                {"template": "<xs:element name=\"v\" type=\"%s\"/><xs:simpleType name=\"Αλφα\">"
                    "<xs:restriction base=\"xs:string\"/></xs:simpleType>", "valid": "Αλφα",
                 "xml": "<v>x</v>", "invalid": "Ͱa"}) {
            checkValue(row.xml, sprintf("<xs:schema xmlns:xs=\"%s\">%s</xs:schema>", Xsd,
                sprintf(row.template, row.valid)), True, row.template);
            XmlDoc document(row.xml);
            assertThrows("XSD-SYNTAX-ERROR", \document.validateSchema(), (sprintf("<xs:schema xmlns:xs=\"%s\">%s"
                "</xs:schema>", Xsd, sprintf(row.template, row.invalid)),), row.template);
        }
    }

    xmlNames() {
        assertEq({"\u0370a": {"\U00010000b": "x"}}, parse_xml("<\u0370a><\U00010000b>x</\U00010000b></\u0370a>"));
        # a schema with a wildcard accepts Fifth Edition element names
        string xsd = sprintf("<xs:schema xmlns:xs=\"%s\"><xs:element name=\"v\"><xs:complexType><xs:sequence>"
            "<xs:any processContents=\"skip\"/></xs:sequence><xs:anyAttribute processContents=\"skip\"/>"
            "</xs:complexType></xs:element></xs:schema>", Xsd);
        checkValue("<v \u0370c=\"1\"><\u2070b/></v>", xsd, True, "wildcard content");
    }
}
