#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class BooleanLexicalTest

class BooleanLexicalTest inherits QUnit::Test {
    const Invalid = ("", " ", "TRUE", "False", "yes", "no", "truefalse", "untrue", "false-tail",
        "2", "-1", "+1", "00", "1.0", "t rue", "true\u00a0", "false\x00tail", "\x0btrue",
        NULL, NOTHING, 2, -1, 0.5, @nan@, @inf@, binary("1"), (1, 0), {"value": True});

    constructor() : Test("XSD boolean lexical and provider values", "1.0") {
        addTestCase("Only the four XML boolean spellings are accepted", \lexical());
        addTestCase("Native values and XML whitespace", \nativeValues());
        addTestCase("Provider optionality and list conversion", \providers());
        addTestCase("Attributes, lists and unions after reconstruction", \schemas());
        addTestCase("Ordered CDATA and text form one scalar lexical value", \xmlText());
        set_return_value(main());
    }

    lexical() {
        Namespaces nsc({});
        XsdBaseType type = nsc.getBaseType("boolean");
        foreach auto value in (Invalid) {
            assertThrows("SOAP-SERIALIZATION-ERROR", \type.serializeValue(), (nsc, value, True));
            assertThrows("SOAP-DESERIALIZATION-ERROR", \type.deserializeValue(), ("value", {}, NOTHING, value));
        }
        foreach string value in ("false", "true", "0", "1", " \tfalse\r\n", " \t1\r\n") {
            string normalized = XsdSimpleType::normalizeWhiteSpace(value, "collapse");
            bool expected = normalized == "true" || normalized == "1";
            assertEq(expected, type.deserializeValue("value", {}, NOTHING, value));
            assertEq(expected ? "true" : "false", type.serializeValue(nsc, value, True));
        }
    }

    nativeValues() {
        Namespaces nsc({});
        XsdBaseType type = nsc.getBaseType("boolean");
        foreach auto value in (False, True, 0, 1, 0.0, -0.0, 1.0, 0n, 1n) {
            bool expected = boolean(value);
            assertEq(expected, type.deserializeValue("value", {}, NOTHING, value));
            assertEq(expected ? "true" : "false", type.serializeValue(nsc, value, True));
        }
        AbstractDataProviderType provider = type.getDataProviderType();
        foreach number value in (2n, -1n, 0.5n, number(@nan@), number(@inf@), number(-@inf@)) {
            assertThrows("SOAP-SERIALIZATION-ERROR", \type.serializeValue(), (nsc, value, True));
            assertThrows("SOAP-DESERIALIZATION-ERROR", \type.deserializeValue(), ("value", {}, NOTHING, value));
            assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (value,));
        }
    }

    providers() {
        Namespaces nsc({});
        AbstractDataProviderType original = nsc.getBaseType("boolean").getDataProviderType();
        foreach AbstractDataProviderType type in (original, Serializable::deserialize(original.serialize()),
                original.getOrNothingType().getMandatoryType()) {
            assertEq(NT_BOOLEAN, type.getBaseTypeCode());
            assertEq(NOTHING, type.getValueType(), "list inputs must reach boolean validation before conversion");
            assertTrue(type.isMandatory());
            assertThrows("MISSING-VALUE-ERROR", \type.acceptsValue(), (NOTHING,));
            foreach auto value in (Invalid) {
                if (exists value) {
                    assertThrows("RUNTIME-TYPE-ERROR", \type.acceptsValue(), (value,));
                }
            }
            assertEq(False, type.acceptsValue("false"));
            assertEq(True, type.acceptsValue("1"));
            AbstractDataProviderType optional = type.getOrNothingType();
            assertFalse(optional.isMandatory());
            assertEq(NOTHING, optional.acceptsValue(NOTHING));
            assertThrows("RUNTIME-TYPE-ERROR", \optional.acceptsValue(), (NULL,));
            assertFalse(optional.getAcceptTypeHash().hasKey("null"));
            ListDataType list_type("flags", type);
            assertEq((False, True, False, True), list_type.acceptsValue(("false", "true", "0", "1")));
            assertThrows("RUNTIME-TYPE-ERROR", \list_type.acceptsValue(), (("false", "yes"),));
        }
    }

    schemas() {
        XsdSchema original('<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:boolean"
            targetNamespace="urn:boolean">
            <xs:complexType name="Record"><xs:simpleContent><xs:extension base="xs:boolean">
                <xs:attribute name="enabled" type="xs:boolean" use="required"/>
            </xs:extension></xs:simpleContent></xs:complexType>
            <xs:simpleType name="Flags"><xs:list itemType="xs:boolean"/></xs:simpleType>
            <xs:simpleType name="Value"><xs:union memberTypes="xs:boolean xs:int"/></xs:simpleType>
            </xs:schema>', {"async_only": True});
        foreach XsdSchema schema in (original, Serializable::deserialize(original.serialize())) {
            XsdAbstractType record = schema.findType(make_qname("urn:boolean", "Record"));
            assertEq({"^value^": False, "^attributes^": {"enabled": True}},
                record.deserializeValue("record", schema.getTypeMap(), NOTHING,
                    {"^value^": "false", "^attributes^": {"enabled": "1"}}));
            hash<auto> fragments = {"^value^": "f", "^cdata^": "al", "^value1^": "se",
                "^attributes^": {"enabled": "1"}};
            assertEq({"^value^": False, "^attributes^": {"enabled": True}},
                record.deserializeValue("record", schema.getTypeMap(), NOTHING, fragments));
            assertEq({"^value^": "false", "^attributes^": {"enabled": "true"}},
                record.serializeValue(new Namespaces({}), fragments, True));
            assertThrows("SOAP-DESERIALIZATION-ERROR", \record.deserializeValue(),
                ("record", schema.getTypeMap(), NOTHING,
                    {"^value^": "true", "^attributes^": {"enabled": "yes"}}));
            XsdAbstractType flags = schema.findType(make_qname("urn:boolean", "Flags"));
            assertEq("collapse", flags.getWhiteSpace());
            assertEq((True, False, True, False), flags.deserializeValue("flags", schema.getTypeMap(), NOTHING,
                "true false 1 0"));
            foreach string separator in (" ", "\t", "\r", "\n", " \t\r\n ") {
                assertEq((True, False, True, False), flags.deserializeValue("flags", schema.getTypeMap(), NOTHING,
                    separator + join(separator, ("true", "false", "1", "0")) + separator));
            }
            foreach string value in ("", " \t\r\n ") {
                assertEq((), flags.deserializeValue("flags", schema.getTypeMap(), NOTHING, value));
            }
            foreach string value in ("true\u00a0false", "true\x00false") {
                assertThrows("SOAP-DESERIALIZATION-ERROR", \flags.deserializeValue(),
                    ("flags", schema.getTypeMap(), NOTHING, value));
            }
            assertThrows("SOAP-DESERIALIZATION-ERROR", \flags.deserializeValue(),
                ("flags", schema.getTypeMap(), NOTHING, "true yes"));
            XsdAbstractType choice = schema.findType(make_qname("urn:boolean", "Value"));
            assertEq(False, choice.deserializeValue("choice", schema.getTypeMap(), NOTHING, "false"));
            assertEq(12, choice.deserializeValue("choice", schema.getTypeMap(), NOTHING, "12"));
            assertThrows("SOAP-DESERIALIZATION-ERROR", \choice.deserializeValue(),
                ("choice", schema.getTypeMap(), NOTHING, "truth"));
        }
    }

    xmlText() {
        Namespaces nsc({});
        foreach hash<auto> sample in ({"type": "boolean", "xml": "<![CDATA[0]]>", "value": False},
                {"type": "boolean", "xml": "f<![CDATA[al]]><!--ignore-->se", "value": False},
                {"type": "boolean", "xml": "<![CDATA[tr]]>u<![CDATA[e]]>", "value": True},
                {"type": "int", "xml": "<![CDATA[0]]>0<![CDATA[9]]>", "value": 9},
                {"type": "string", "xml": "A<![CDATA[ B]]><!--ignore--> C", "value": "A B C"},
                {"type": "anySimpleType", "xml": "A<![CDATA[ B]]> C", "value": "A B C"}) {
            XsdBaseType type = nsc.getBaseType(sample.type);
            auto input = parse_xml("<value>" + sample.xml + "</value>", XPF_PRESERVE_ORDER | XPF_ADD_COMMENTS).value;
            assertEq(sample.value, type.deserializeValue("value", {}, NOTHING, input));
            auto serialized = type.serializeValue(nsc, input, True);
            assertEq(sample.value, type.deserializeValue("value", {}, NOTHING, serialized));
        }
        XsdBaseType type = nsc.getBaseType("boolean");
        foreach string xml in ("<![CDATA[false]]>tail", "<![CDATA[true]]><child/>",
                "<![CDATA[true]]><!--ignore-->false", "<!--ignore-->", "<child/>") {
            auto input = parse_xml("<value>" + xml + "</value>", XPF_PRESERVE_ORDER | XPF_ADD_COMMENTS).value;
            assertThrows("SOAP-DESERIALIZATION-ERROR", \type.deserializeValue(), ("value", {}, NOTHING, input));
        }
        assertThrows("SOAP-DESERIALIZATION-ERROR", \type.deserializeValue(),
            ("value", {}, NOTHING, {"^value^": True, "^cdata^": "tail"}));
        assertEq(False, type.deserializeValue("value", {}, NOTHING, {"^value^": False}));
        hash<auto> named = {"^cdataStart^": "f", "^commentNote^": "ignored", "^valueEnd^": "alse"};
        assertEq(False, type.deserializeValue("value", {}, NOTHING, named));
        assertEq(False, type.deserializeValue("value", {}, NOTHING, type.serializeValue(nsc, named, True)));
        XsdSchema schema('<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:text"
            targetNamespace="urn:text"><xs:simpleType name="Flags"><xs:list itemType="xs:boolean"/>
            </xs:simpleType></xs:schema>', {"async_only": True});
        XsdAbstractType flags = schema.findType(make_qname("urn:text", "Flags"));
        auto input = parse_xml("<value><![CDATA[tr]]>ue&#9;<![CDATA[false]]></value>", XPF_PRESERVE_ORDER).value;
        assertEq((True, False), flags.deserializeValue("value", schema.getTypeMap(), NOTHING, input));
    }
}
