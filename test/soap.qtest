        auto ws = WSDLLib::getWSDL(ReadOnlyFile::readTextFile(get_script_dir() + "/test.wsdl"));
        assertEq(Type::String, ws.type());
    }

    soapTestCase() {
        WebService ws(ReadOnlyFile::readTextFile(get_script_dir() + "/test.wsdl"));
        WSOperation op = ws.getOperation("setInfo");

        hash req = (
            "body": ("name": "QORE", "id": 500),
            "test": (
                "^attributes^": ("info": "test"),
                "^value^": "test",
            ),
            "issue86": (
                "issue86_1_1": "i86_1",
                "issue86_1_2": "i86_2",
            ),
            "issue87": (
                "issue87e1": "i87",
                "choice12": "i87c12",
            ),
            "issue97": (
                "i97list": NOTHING,
            ),
            "issue468": (
                "issue468_1": NOTHING,
            ),
            "issue560": (
                "issue560_1": "A",
                "issue560_2": "A",
                "issue560_3": "A",
            ),
            "issue984": (
                "i984_empty": NOTHING,
            ),
            "issue985": ws.getType("i985_2", ("i985_e1": "test", "i985_e2": "test",)),
            "issue2190": ("^attributes^": ("attr": "val"), "^value^": "string"),
            "issue2754": (
                "i2754_e1": (
                    "i2754_2_e1": "str",
                    "i2754_2_e2": "str",
                ),
            ),
            "issue2855_1": date("2018-06-15T00:00:00+01:00"),
            "issue2855_2": "small",
            "issue2899_1": {
                "item": (
                    {"i2899_2_e1": "str", "i2899_2_e2": "str"},
                    {"i2899_2_e1": "str", "i2899_2_e2": "str"},
                ),
            },
            "issue2899_2": {
                "element": (
                    {"i2899_2_e1": "str", "i2899_2_e2": "str"},
                    {"i2899_2_e1": "str", "i2899_2_e2": "str"},
                ),
            },
            "issue2899_3": {
                "element": (
                    "str",
                    "str",
                ),
            },
            "issue2899_4": {
                "i2899_2_e1": "str",
                "i2899_2_e2": "str",
            },
            "issue3367": {
                "i3367": {
                    "^attributes^": {
                        "xmlns": "",
                    },
                },
            },
            "issue4452-1": "1",
            "issue4452-2": {"a": "1"},
            "issue4452-3": {"^cdata^": "some data"},
            "logo": binary("test"),
        );

        # negative test w/o attributes
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), req, "attr-ser-neg");

        req.body."^attributes^" = {
            "infoType": "test",
            "code": 1,
        };

        hash h = op.serializeRequest(req, NOTHING, NOTHING, NOTHING, XGF_ADD_FORMATTING, "TEST");
        assertEq("TEST", h.hdr.SOAPAction);
        hash xh = parse_xml(h.body);
        on_error printf("body: %y\n", h.body);
        # dynamically find the namespace prefix for simpletest namespace
        *string st_prefix;
        foreach hash<auto> attr in (xh.firstValue()."^attributes^".pairIterator()) {
            if (attr.value == "http://qore.org/simpletest") {
                st_prefix = (attr.key =~ x/xmlns:(.+)/)[0];
                break;
            }
        }
        assertEq(True, exists st_prefix, "simpletest namespace prefix found");
        xh."soapenv:Envelope"."soapenv:Body".(st_prefix + ":setInfo")."issue3367".(st_prefix + ":i3367")."^attributes^"."xmlns" = "";
        compareSoapMsgs("attr-ser", Req_1, xh);

        {
            hash h1 = op.serializeRequest(req, NOTHING, NOTHING, NOTHING, XGF_ADD_FORMATTING, "TEST");
            # dynamically replace using actual prefix
            string original_body = h1.body;
            h1.body = regex_subst(h1.body, "<" + st_prefix + ":i2754_2_e2(?: [^>]*)?>str</"
                + st_prefix + ":i2754_2_e2>", "<" + st_prefix + ":i2754_2_e2/>");
            assertFalse(original_body == h1.body, "the empty-string fixture replaces the selected text");
            #printf("body: %s\n", h1.body);
            hash xh1 = parse_xml(h1.body);
            #printf("xh1: %N\n", xh1);
            # test issue #2754
            h = op.deserializeRequest(xh1);
            #printf("h: %N\n", h);
            assertEq("", h.issue2754.i2754_e1.i2754_2_e2);

            {
                WebService ws1(ReadOnlyFile::readTextFile(get_script_dir() + "/test.wsdl"), ("compat_empty_string_is_nothing": True));
                WSOperation op1 = ws1.getOperation("setInfo");

                h = op1.deserializeRequest(xh1);
                assertEq(NOTHING, h.issue2754.i2754_e1.i2754_2_e2);
            }

            {
                wsdl_set_global_compat_empty_string_is_nothing(True);
                WebService ws1(ReadOnlyFile::readTextFile(get_script_dir() + "/test.wsdl"));
                WSOperation op1 = ws1.getOperation("setInfo");

                h = op1.deserializeRequest(xh1);
                assertEq(NOTHING, h.issue2754.i2754_e1.i2754_2_e2);
            }

            {
                wsdl_set_global_compat_empty_string_is_nothing(False);
                WebService ws1(ReadOnlyFile::readTextFile(get_script_dir() + "/test.wsdl"));
                WSOperation op1 = ws1.getOperation("setInfo");

                h = op1.deserializeRequest(xh1);
                assertEq("", h.issue2754.i2754_e1.i2754_2_e2);
            }
        }

        h = op.deserializeRequest(xh);
        assertEq(NOTHING, h.hdr.SOAPAction);

        hash req_r = req + (
            "issue985": (
                "i985_e1": "test", "i985_e2": "test",
            ),
            "issue3367": {
                "i3367": "",
            },
            "issue4452-1": "1",
            "issue4452-2": {"a": "1"},
            "issue4452-3": {"^cdata^": "some data"},
        );

        # A wildcard retains explicit namespace context, so its XML-data shape can
        # differ from a bare scalar while preserving exactly the same XML value.
        compareSoapValue("wildcard XML", "issue4452-2", req_r."issue4452-2", h."issue4452-2",
            SoapTest::getNamespaceMap(Req_1), SoapTest::getNamespaceMap(xh));
        assertEq(req_r - "issue4452-2", h - "issue4452-2", "attr-deser-our");

        # do negative tests to ensure that namespace handling is correct in our test code
        {
            NsMap nh = SoapTest::getNamespaceMap(Req_1);
            string ek = SoapTest::getKey(nh.se, "Envelope");
            string bk = SoapTest::getKey(nh.se, "Body");
            string pfx = nh.umap."http://qore.org/simpletest";
            string sik1 = SoapTest::getKey(pfx, "setInfo");
            string sik2 = SoapTest::getKey(pfx, "SetInfo");

            hash r1 = Req_1;

            # rename key with an undefined namespace
            r1{ek}{bk}{sik1}."xxx:SetInfo" = remove r1{ek}{bk}{sik1}{sik2};
            assertThrows("SOAP-NAMESPACE-ERROR", \compareSoapMsgs(), ("attr-ser", r1, xh), "attr-ser-neg-1");

            # rename key with a defined but incorrect namespace
            string sik = sprintf("%s:SetInfo", nh.umap."http://www.w3.org/2003/05/soap-envelope");
            r1{ek}{bk}{sik1}{sik} = remove r1{ek}{bk}{sik1}."xxx:SetInfo";
            assertThrows("TEST-EXCEPTION", \compareSoapMsgs(), ("attr-ser", r1, xh), "attr-ser-neg-2");
        }

        {
            NsMap nh = SoapTest::getNamespaceMap(xh);
            string ek = SoapTest::getKey(nh.se, "Envelope");
            string bk = SoapTest::getKey(nh.se, "Body");
            string pfx = nh.umap."http://qore.org/simpletest";
            string sik1 = SoapTest::getKey(pfx, "setInfo");
            string sik2 = SoapTest::getKey(pfx, "SetInfo");

            # rename key with an undefined namespace
            xh{ek}{bk}{sik1}."xxx:SetInfo" = remove xh{ek}{bk}{sik1}{sik2};
            assertThrows("SOAP-NAMESPACE-ERROR", \compareSoapMsgs(), ("attr-ser", Req_1, xh), "attr-ser-neg-3");

            # rename key with a defined but incorrect namespace
            pfx = nh.umap."http://www.w3.org/2003/05/soap-envelope";
            xh{ek}{bk}{sik1}{pfx} = remove xh{ek}{bk}{sik1}."xxx:SetInfo";
            assertThrows("TEST-EXCEPTION", \compareSoapMsgs(), ("attr-ser", Req_1, xh), "attr-ser-neg-4");
        }

        h = parse_xml(SoapUiReq_1, XPF_PRESERVE_ORDER);
        # Preserve the original SoapUI fixture as a negative: complex-content
        # extension requires base content before extension content (3, 2, 1).
        assertThrows("SOAP-DESERIALIZATION-ERROR", "complete particle", \op.deserializeRequest(), (h,));
        # First correct only the three issue560 child positions; the separately
        # missing required i3367 child must still be rejected.
        hash<auto> inherited = h."soap:Envelope"."soap:Body"."sim:setInfo"."sim:issue560";
        h."soap:Envelope"."soap:Body"."sim:setInfo"."sim:issue560" = {
            "sim:issue560_3": inherited."sim:issue560_3",
            "sim:issue560_2": inherited."sim:issue560_2",
            "sim:issue560_1": inherited."sim:issue560_1",
        };
        assertThrows("SOAP-DESERIALIZATION-ERROR", "complete particle", \op.deserializeRequest(), (h,));
        # Complete the valid derivative with the declared nillable child.
        h."soap:Envelope"."soap:Body"."sim:setInfo".issue3367 = {
            "sim:i3367": {"^attributes^": {"xsi:nil": "true"}},
        };
        h = op.deserializeRequest(h);

        req_r.issue3367.i3367 = NOTHING;
        req_r."issue4452-1" = NOTHING;
        req_r."issue4452-2" = NOTHING;
        req_r."issue4452-3" = NOTHING;
        # The SoapUI XML omits the zone; retain that absence independently of native date input.
        req_r.issue2855_1 = "2018-06-15";
        assertEq(req_r, h, "attr-deser-soapui");

        h = op.serializeResponse(Res_1);
