        addTestCase("XSD constraining facets", \xsdFacetTest());
        addTestCase("XSD example message generation", \xsdSampleTest());
        addTestCase("XSD Unicode block escapes", \xsdBlockTest());
        addTestCase("XSD whiteSpace processing", \xsdWhiteSpaceTest());
        addTestCase("header and body message parts", \headerPartsTest());
        addTestCase("issue 4449", \issue4449());
        addTestCase("issue 3029", \issue3029());
        addTestCase("WSDLLib", \wsdlLibTest());
        addTestCase("issue 2793", \issue2793());
        addTestCase("SoapTestCase", \soapTestCase());
        addTestCase("Test1", \test1());
        addTestCase("multi", \multiTest());
        addTestCase("dateTimeValidation", \dateTimeValidationTest());
        addTestCase("soapFaultDetection", \soapFaultDetectionTest());
        addTestCase("SOAP comparison resolves local namespace declarations", \localNamespaces());
        set_return_value(main());
    }

    soapDataProviderTest() {
        {
            SoapDataProvider provider({"schema": ReadOnlyFile::readTextFile(get_script_dir() + "/example.wsdl")});
            AbstractDataProvider p0 = provider.getChildProviderPath("sayHello");
            AbstractDataProviderType req = p0.getRequestType();
            assertEq(NT_STRING, req.getField("firstName").getType().getBaseTypeCode());
            AbstractDataProviderType resp = p0.getResponseType();
            assertEq(NT_STRING, resp.getField("greeting").getType().getBaseTypeCode());
            assertThrows("RUNTIME-TYPE-ERROR", \p0.doRequest(), 1);
        }
        {
            SoapDataProvider provider({"schema": ReadOnlyFile::readTextFile(get_script_dir() + "/test.wsdl")});
            AbstractDataProvider p0 = provider.getChildProviderPath("setInfo");
            AbstractDataProviderType req = p0.getRequestType();
            AbstractDataField test = req.getField("test");
            # This simple-content element requires an attribute, so its complete value is a hash.
            # Its scalar type and choices belong to the value field inside that hash.
            assertEq(NT_HASH, test.getType().getBaseTypeCode());
            AbstractDataField value = test.getType().getFields()."^value^";
            assertEq(NT_STRING, value.getType().getBaseTypeCode());
            assertEq(("test", "other"), map $1.value, value.getAllowedValues());
            assertEq(NOTHING, test.getAllowedValues());
            assertEq({"^value^": "test", "^attributes^": {"info": "invoice"}},
                test.acceptsValue({"^value^": "test", "^attributes^": {"info": "invoice"}}));
            assertThrows("MISSING-VALUE-ERROR", \test.acceptsValue(), ("test",));
        }
    }

    #! tests XSD "include" support and location resolution relative to the referencing document
    /** the test WSDL references its schemas as follows:
        - \c wsdl/include-test.wsdl imports \c ../schemas/include-test.xsd
        - \c schemas/include-test.xsd includes \c types/include-test-types.xsd

        the location in the second reference is relative to the schema making it and not to the WSDL, so it can only
        be resolved if the base location is updated for each document
    */
    xsdIncludeTest() {
        # location resolution helpers
        assertEq("/base/schemas/types/a.xsd", WSDLLib::resolveLocation("types/a.xsd", "/base/schemas"));
        assertEq("/base/schemas/a.xsd", WSDLLib::resolveLocation("../schemas/a.xsd", "/base/wsdl"));
        # absolute locations and locations with a scheme are not resolved against the base
        assertEq("/abs/a.xsd", WSDLLib::resolveLocation("/abs/a.xsd", "/base/wsdl"));
        assertEq("http://h/a.xsd", WSDLLib::resolveLocation("http://h/a.xsd", "/base/wsdl"));
        # relative locations are also resolved against URL bases
        assertEq("http://h/dir/types/a.xsd", WSDLLib::resolveLocation("types/a.xsd", "http://h/dir"));
        assertEq("http://h/a/s/a.xsd", WSDLLib::resolveLocation("../s/a.xsd", "http://h/a/b"));
        assertEq("http://h/a.xsd", WSDLLib::resolveLocation("a.xsd", "http://h"));
        # with no base location the location is returned unchanged
        assertEq("a.xsd", WSDLLib::resolveLocation("a.xsd"));

        assertEq("/a/b", WSDLLib::getLocationBase("/a/b/c.xsd"));
        assertEq("http://h/a/b", WSDLLib::getLocationBase("http://h/a/b/c.xsd"));
        assertEq("http://h", WSDLLib::getLocationBase("http://h/c.xsd"));
        # a URL with no path component must be returned unchanged
        assertEq("http://h", WSDLLib::getLocationBase("http://h"));

        string wsdl_path = get_script_dir() + "/wsdl-include/wsdl/include-test.wsdl";
        WebService ws = WSDLLib::getWebServiceFromUrl(wsdl_path);

        assertEq(("Create",), ws.getOperationNames());
        WSOperation op = ws.getOperation("Create");

        # "idType" and "statusType" are declared in the included schema; the elements using them are declared in the
        # including schema, so the request can only be serialized if the include was processed
        hash<auto> req = {
            "createUser": {
                "userId": "user-1",
                "status": "ERASE",
                "extra": "additional info",
            },
        };
        hash<auto> h = op.serializeRequest(req, NOTHING, NOTHING, NOTHING, XGF_ADD_FORMATTING);
        assertEq(Type::String, h.body.type());

        # parse_xml() throws an exception if a namespace prefix used in the message is not declared in the envelope
        hash<auto> xh = parse_xml(h.body);
        assertEq(req, op.deserializeRequest(xh));

        # verify that every namespace prefix used in the body is declared in the envelope
        NsMap nsmap();
        hash<auto> env = xh.firstValue();
        map nsmap.set(($1 =~ x/^xmlns:(.*)$/)[0], env."^attributes^"{$1}),
            keys env."^attributes^", $1 =~ /^xmlns:/;
        checkPrefixesDeclared(env, nsmap);

        # the union simpleType has two anonymous member types: an enumerated string and an int
        hash<auto> h2 = op.serializeRequest(req + {"createUser": req.createUser + {"status": 42}});
        assertEq(req.createUser.userId, op.deserializeRequest(parse_xml(h2.body)).createUser.userId);

        # values accepted by no union member type cannot be serialized; the value below is neither in the
        # enumeration of the first member type nor in the value range of the second ("xs:int")
        assertThrows("SOAP-SERIALIZATION-ERROR", "union types",  \op.serializeRequest(),
            (req + {"createUser": req.createUser + {"status": 4294967296}},));

        # unknown elements are rejected
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(),
            (req + {"createUser": req.createUser + {"nosuchelement": "x"}},));

        # example messages can be generated for all types used in the WSDL
        WSMessageHelper mh(ws);
        hash<auto> ex = mh.getMessage(op.input);
        assertEq(Type::String, ex.Create.createUser.userId.type());
        # the example value for a union type comes from its first member type
        assertEq("ERASE", ex.Create.createUser.status);
        # the example value for an element with no type declaration ("xs:anyType") is a string
        assertEq(Type::String, ex.Create.createUser.extra.type());

        # a reference to a schema that cannot be retrieved fails with an exception naming the resolved location,
        # which verifies that the relative location was resolved against the location of the referencing document
        assertThrows("FILE-OPEN2-ERROR", "wsdl-include/schemas/missing.xsd", sub () {
            new WebService(replace(ReadOnlyFile::readTextFile(wsdl_path), "../schemas/include-test.xsd",
                "../schemas/missing.xsd"), {"def_path": dirname(wsdl_path)});
        });
    }

    #! tests attribute value serialization and \c choice complexType handling
    attributeAndChoiceTest() {
        WebService ws = WSDLLib::getWebServiceFromUrl(get_script_dir() + "/attr-choice.wsdl");
        WSOperation op = ws.getOperation("Op");

        hash<auto> req = {
            "stamped": {
                "^attributes^": {
                    "when": 2015-01-31T10:20:30,
                    "active": False,
                    "raw": <abcd>,
                },
                "data": "x",
            },
            # a string value for an xs:boolean element must be parsed and not simply converted
            "flag": "false",
            "required-choice": {"a": "one"},
            # an optional choice with no member supplied
            "optional-choice": {},
        };

        hash<auto> h = op.serializeRequest(req, NOTHING, NOTHING, NOTHING, XGF_ADD_FORMATTING);
        hash<auto> body = parse_xml(h.body).firstValue()."soapenv:Body"."ns:Req";

        # attribute values must be written in their XSD representation and not in Qore's default representation
        hash<auto> attrs = body."ns:stamped"."^attributes^";
        # the attribute must be written in the XSD dateTime lexical form and not in Qore's default date
        # format; the timezone offset that follows depends on the local zone
        assertRegex("^2015-01-31T10:20:30", attrs.when);
        assertEq("false", attrs.active);
        assertEq(make_base64_string(<abcd>), attrs.raw);

        # "false" must not be serialized as "true" just because it is a non-empty string
        assertEq("false", body."ns:flag");

        # only the choice member supplied is serialized
        assertEq(("ns:a",), keys body."ns:required-choice");

        # values round-trip back to their Qore types
        hash<auto> rt = op.deserializeRequest(parse_xml(h.body));
        assertEq(2015-01-31T10:20:30, rt.stamped."^attributes^".when);
        assertEq(False, rt.stamped."^attributes^".active);
        assertEq(<abcd>, rt.stamped."^attributes^".raw);
        assertEq(False, rt.flag);
        assertEq({"a": "one"}, rt."required-choice");

        # all the accepted boolean representations
        foreach hash<auto> i in ((
            {"in": True, "out": "true"},
            {"in": False, "out": "false"},
            {"in": "true", "out": "true"},
            {"in": "false", "out": "false"},
            {"in": "1", "out": "true"},
            {"in": "0", "out": "false"},
        )) {
            hash<auto> bh = op.serializeRequest(req + {"flag": i.in});
            assertEq(i.out, parse_xml(bh.body).firstValue()."soapenv:Body"."ns:Req"."ns:flag",
                sprintf("boolean %y serializes as %y", i.in, i.out));
        }

        # a required choice with no member supplied must raise a descriptive error and not a runtime type error
        assertThrows("SOAP-SERIALIZATION-ERROR", "complete particle", \op.serializeRequest(),
            (req + {"required-choice": {}},));

        # more than one member of a choice cannot be serialized
        assertThrows("SOAP-SERIALIZATION-ERROR", "complete particle", \op.serializeRequest(),
            (req + {"required-choice": {"a": "one", "b": "two"}},));

        # members not belonging to the choice are rejected
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(),
            (req + {"required-choice": {"z": "one"}},));

        # unknown attributes are rejected
        assertThrows("SOAP-SERIALIZATION-ERROR", "unknown attribute", \op.serializeRequest(),
            (req + {"stamped": req.stamped + {"^attributes^": req.stamped."^attributes^" + {"bogus": 1}}},));

        # required attributes must be supplied
        assertThrows("SOAP-SERIALIZATION-ERROR", "required", \op.serializeRequest(),
            (req + {"stamped": req.stamped + {"^attributes^": req.stamped."^attributes^" - "when"}},));

        # a data provider type can be retrieved for a "choice" complexType; all its members are optional
        SoapDataProvider provider(ws);
        AbstractDataProvider p0 = provider.getChildProviderPath("Op");
        HashDataType rt0 = cast<HashDataType>(p0.getRequestType().getField("parameters").getType());
        AbstractDataProviderType ct = rt0.getField("required-choice").getType();
        assertEq(("a", "b"), keys ct.getFields());
        map assertTrue(ct.getField($1).getType().isOrNothingType(),
            sprintf("choice member %y is optional", $1)), keys ct.getFields();

        # scalar types are reported as soft types, because serialization accepts any convertible value
        assertEq(NT_BOOLEAN, rt0.getField("flag").getType().getBaseTypeCode());
        assertTrue(rt0.getField("flag").getType().getName() =~ /^\*?soft/);

        # xs:boolean values must be parsed according to the XSD boolean lexical space; a plain "softbool" type
        # converts the string "false" to True, since any non-empty string is True in Qore
        AbstractDataProviderType bt = rt0.getField("flag").getType();
        assertEq(False, bt.acceptsValue("false"));
        assertEq(False, bt.acceptsValue("0"));
        assertEq(True, bt.acceptsValue("true"));
        assertEq(True, bt.acceptsValue("1"));
        assertEq(False, bt.acceptsValue(False));
        assertEq(True, bt.acceptsValue(True));
        # the "or nothing" variant of the type must behave identically
        assertEq(False, bt.getOrNothingType().acceptsValue("false"));
        assertEq(True, bt.getOrNothingType().acceptsValue("true"));
        # "xs:int" and "xs:double" had no mapping at all and were reported as "any"
        assertEq(NT_INT, rt0.getField("count").getType().getBaseTypeCode());
        assertEq(NT_FLOAT, rt0.getField("ratio").getType().getBaseTypeCode());

        # enumeration values are reported with the value type of the restricted type and not as strings
        assertEq(NT_INT, rt0.getField("code").getType().getBaseTypeCode());
        assertEq((1, 3), map $1.value, rt0.getField("code").getAllowedValues());
        XsdComplexType req_ct = cast<XsdComplexType>(ws.getOperation("Op").input.args.Req.element.type);
        assertEq((1, 3), req_ct.elementmap.code.getAllowedValues());

        # values convertible to the declared type are accepted
        hash<auto> nh = op.serializeRequest(req + {"count": "42", "ratio": "1.5", "code": "3"});
        hash<auto> nb = parse_xml(nh.body).firstValue()."soapenv:Body"."ns:Req";
        assertEq("42", nb."ns:count");
        assertEq("1.5", nb."ns:ratio");
        assertEq("3", nb."ns:code");
        hash<auto> nrt = op.deserializeRequest(parse_xml(nh.body));
        assertEq(42, nrt.count);
        assertEq(1.5, nrt.ratio);
        assertEq(3, nrt.code);

        # values not in the enumeration are rejected
        assertThrows("SOAP-SERIALIZATION-ERROR", "enumeration", \op.serializeRequest(),
            (req + {"code": 2},));
    }

    #! tests nested model groups (ex: an \c xs:sequence declared inside another \c xs:sequence)
    nestedModelGroupTest() {
        WebService ws = WSDLLib::getWebServiceFromUrl(get_script_dir() + "/nested-groups.wsdl");
        WSOperation op = ws.getOperation("Op");

        hash<auto> req = {
            # "first" and "second" are declared in a sequence nested in the element\'s sequence
            "nested": {
                "first": "1",
                "second": "2",
                "third": "3",
            },
            # both elements of the first alternative of the choice
            "group-choice": {
                "ga1": "a1",
                "ga2": "a2",
            },
            "deep": {
                "d1": "d",
                "dx": "x",
            },
        };

        hash<auto> h = op.serializeRequest(req);
        hash<auto> body = parse_xml(h.body).firstValue()."soapenv:Body"."ns:Req";

        # elements declared in nested model groups must be serialized
        assertEq(("ns:first", "ns:second", "ns:third"), keys body."ns:nested");
        assertEq("1", body."ns:nested"."ns:first");
        assertEq("2", body."ns:nested"."ns:second");
        assertEq("3", body."ns:nested"."ns:third");

        # all the elements of a single choice alternative can be serialized together
        assertEq(("ns:ga1", "ns:ga2"), keys body."ns:group-choice");
        assertEq("a1", body."ns:group-choice"."ns:ga1");
        assertEq("a2", body."ns:group-choice"."ns:ga2");

        # a choice block declared in a nested sequence is serialized as well
        assertEq(("ns:d1", "ns:dx"), keys body."ns:deep");

        # the request must round-trip
        hash<auto> rt = op.deserializeRequest(parse_xml(h.body));
        assertEq("1", rt.nested.first);
        assertEq("2", rt.nested.second);
        assertEq("3", rt.nested.third);
        assertEq("a1", rt."group-choice".ga1);
        assertEq("a2", rt."group-choice".ga2);
        assertEq("x", rt.deep.dx);

        # the other alternative of the choice can be used on its own
        hash<auto> req2 = req + {"group-choice": {"gb1": "b1"}};
        hash<auto> h2 = op.serializeRequest(req2);
        hash<auto> body2 = parse_xml(h2.body).firstValue()."soapenv:Body"."ns:Req";
        assertEq(("ns:gb1",), keys body2."ns:group-choice");
        assertEq("b1", op.deserializeRequest(parse_xml(h2.body))."group-choice".gb1);

        # elements from different alternatives cannot be combined
        assertThrows("SOAP-SERIALIZATION-ERROR", "complete particle", \op.serializeRequest(),
            (req + {"group-choice": {"ga1": "a1", "gb1": "b1"}},));

        # deserialization also rejects elements from different alternatives
        hash<auto> xh = parse_xml(h.body);
        string env_key = xh.firstKey();
        xh{env_key}."soapenv:Body"."ns:Req"."ns:group-choice"."ns:gb1" = "b1";
        assertThrows("SOAP-DESERIALIZATION-ERROR", "complete particle", \op.deserializeRequest(), xh);

        # elements not declared in any model group are still rejected
        assertThrows("SOAP-SERIALIZATION-ERROR", "invalid member", \op.serializeRequest(),
            (req + {"nested": req.nested + {"bogus": "x"}},));

        # An explicitly supplied empty value emits its element; omitting the optional field omits it.
        hash<auto> h3 = op.serializeRequest(req + {"empty": {}});
        assertTrue(parse_xml(h3.body).firstValue()."soapenv:Body"."ns:Req".hasKey("ns:empty"));
        assertFalse(body.hasKey("ns:empty"));

        # a nested sequence declared with minOccurs="0" makes its members optional, so the enclosing element does
        # not have to be supplied at all
        assertEq(NOTHING, op.deserializeRequest(parse_xml(h.body))."optional-group");

        # data provider types must include the elements declared in nested model groups
        AbstractDataProviderType t = op.input.getDataProviderType().getFields().parameters.getType();
        assertEq(("first", "second", "third"), keys t.getFields().nested.getType().getFields());
        assertEq(("ga1", "ga2", "gb1"), keys t.getFields()."group-choice".getType().getFields());
        # all members of a choice are optional in the data provider type
        foreach AbstractDataField f in (t.getFields()."group-choice".getType().getFields().iterator()) {
            assertFalse(f.isMandatory(), sprintf("choice member %y is optional", f.getName()));
        }
        # the choice block declared in the nested sequence is included as well
        assertEq(("d1", "dx", "dy"), keys t.getFields().deep.getType().getFields());
        # the element with the empty model group is known, but it has no members
        assertTrue(exists t.getFields().empty);
        assertEq(NOTHING, t.getFields().empty.getType().getFields());

        # elements declared in a nested sequence in a response are included as well
        assertEq(("r1", "r2"),
            keys op.output.getDataProviderType().getFields().parameters.getType().getFields());
    }

    #! tests that elements are serialized in the order in which they are declared in the schema (issue #5452)
    /** The order of the elements of an \c xs:sequence is significant; a \c choice block or a nested model group
        declared between two elements must not move the elements declared after it to the front of the message
    */
    elementOrderTest() {
        WebService ws = WSDLLib::getWebServiceFromUrl(get_script_dir() + "/element-order.wsdl");

        # a choice declared before the other elements of the sequence must be serialized first
        WSOperation op = ws.getOperation("Order");
        hash<auto> req = {
            "^attributes^": {"msisdn": "tel:+436600000007"},
            "msisdn": "tel:+436600000007",
            "records": (
                {
                    "^attributes^": {"publicId": "sip:+436600000007@example.com"},
                    "publicId": "sip:+436600000007@example.com",
                    "flags": "nu",
                    "order": 100,
                },
            ),
        };
        hash<auto> h = op.serializeRequest(req);
        hash<auto> body = parse_xml(h.body).firstValue()."soapenv:Body"."ns:OrderReq";
        assertEq(("^attributes^", "ns:msisdn", "ns:records"), keys body);
        assertEq("tel:+436600000007", body."ns:msisdn");
        assertEq("tel:+436600000007", body."^attributes^".msisdn);
        # the elements of the record type keep their declared order as well
        assertEq(("^attributes^", "ns:publicId", "ns:flags", "ns:order"), keys body."ns:records");
        assertEq("100", body."ns:records"."ns:order");

        # the message round-trips with the members in the declared order
        hash<auto> rt = op.deserializeRequest(parse_xml(h.body));
        assertEq(("msisdn", "dnsname", "records", "^attributes^"), keys rt);
        assertEq("tel:+436600000007", rt.msisdn);
        assertEq(NOTHING, rt.dnsname);
        assertEq("tel:+436600000007", rt."^attributes^".msisdn);
        assertEq(100, rt.records.order);
        assertEq("sip:+436600000007@example.com", rt.records."^attributes^".publicId);

        # the other alternative of the choice is serialized in the same position
        hash<auto> h1 = op.serializeRequest({"e164": "436600000007", "dnsname": "example.com"});
        assertEq(("ns:e164", "ns:dnsname"),
            keys parse_xml(h1.body).firstValue()."soapenv:Body"."ns:OrderReq");

        # the choice is required, so a message with no member of the choice cannot be serialized
        assertThrows("SOAP-SERIALIZATION-ERROR", "does not match the complete particle", \op.serializeRequest(),
            ({"dnsname": "example.com"},));

        # only one member of the choice may be serialized
        assertThrows("SOAP-SERIALIZATION-ERROR", "does not match the complete particle", \op.serializeRequest(),
            ({"msisdn": "tel:+43", "e164": "43"},));

        # unknown elements are still rejected
        assertThrows("SOAP-SERIALIZATION-ERROR", "remains unserialized", \op.serializeRequest(),
            ({"msisdn": "tel:+43", "bogus": "x"},));
        assertThrows("SOAP-SERIALIZATION-ERROR", "invalid member", \op.serializeRequest(),
            ({"msisdn": "tel:+43", "records": {"publicId": "x", "flags": "nu", "order": 1, "bogus": "x"}},));

        # the data provider type reports the fields in the declared order; choice members are optional
        AbstractDataProviderType t = op.input.getDataProviderType().getFields().parameters.getType();
        assertEq(("msisdn", "e164", "dnsname", "records", "^attributes^"), keys t.getFields());
        assertFalse(t.getFields().msisdn.isMandatory());
        assertFalse(t.getFields().e164.isMandatory());

        # elements, choice blocks, and a nested model group interleaved in a single sequence
        WSOperation mop = ws.getOperation("Mixed");
        hash<auto> mreq = {
            "a": "A",
            "a2": "A2",
            "m": "M",
            "b": "B",
            "b2": "B2",
            "c": "C",
            "d": "D",
            "q": "Q",
            "e": "E",
        };
        hash<auto> mh = mop.serializeRequest(mreq);
        hash<auto> mbody = parse_xml(mh.body).firstValue()."soapenv:Body"."ns:MixedReq";
        assertEq(("ns:a", "ns:a2", "ns:m", "ns:b", "ns:b2", "ns:c", "ns:d", "ns:q", "ns:e"), keys mbody);
        assertEq(mreq, mop.deserializeRequest(parse_xml(mh.body)));

        # the second choice is optional, so it can be omitted without affecting the order of the other elements
        hash<auto> mh1 = mop.serializeRequest(mreq - ("q", "c", "a2"));
        assertEq(("ns:a", "ns:m", "ns:b", "ns:b2", "ns:d", "ns:e"),
            keys parse_xml(mh1.body).firstValue()."soapenv:Body"."ns:MixedReq");

        # the first choice is required
        assertThrows("SOAP-SERIALIZATION-ERROR", "does not match the complete particle", \mop.serializeRequest(),
            (mreq - "m",));

        # members of different choice blocks are serialized independently in their own positions
        hash<auto> mh2 = mop.serializeRequest(mreq - ("m", "q") + {"n": "N", "p": "P"});
        assertEq(("ns:a", "ns:a2", "ns:n", "ns:b", "ns:b2", "ns:c", "ns:d", "ns:p", "ns:e"),
            keys parse_xml(mh2.body).firstValue()."soapenv:Body"."ns:MixedReq");

        # the data provider type reports the fields of both choice blocks in the declared order
        AbstractDataProviderType mt = mop.input.getDataProviderType().getFields().parameters.getType();
        assertEq(("a", "a2", "m", "n", "b", "b2", "c", "d", "p", "q", "e"), keys mt.getFields());
        assertTrue(mt.getFields().a.isMandatory());
        assertFalse(mt.getFields().m.isMandatory());
        assertFalse(mt.getFields().p.isMandatory());

        # a choice block declared in a base type is inherited as a choice block
        WSOperation eop = ws.getOperation("Ext");
        hash<auto> eh = eop.serializeRequest({"b1": "B1", "b3": "B3", "x1": "X1"});
        assertEq(("ns:b1", "ns:b3", "ns:x1"),
            keys parse_xml(eh.body).firstValue()."soapenv:Body"."ns:ExtReq");
        assertEq({"b1": "B1", "b3": "B3", "x1": "X1"}, eop.deserializeRequest(parse_xml(eh.body)));

        # both members of the inherited choice cannot be serialized together
        assertThrows("SOAP-SERIALIZATION-ERROR", "does not match the complete particle", \eop.serializeRequest(),
            ({"b1": "B1", "b2": "B2"},));

        # the inherited choice is required
        assertThrows("SOAP-SERIALIZATION-ERROR", "does not match the complete particle", \eop.serializeRequest(),
            ({"x1": "X1"},));

        # example messages are generated in the declared order as well
        WSMessageHelper mhelper(ws);
        assertEq(("^attributes^", "msisdn", "dnsname", "records"), keys mhelper.getMessage(op.input).OrderReq);
        assertEq(("a", "a2", "m", "b", "b2", "c", "d", "p", "e"),
            keys mhelper.getMessage(mop.input).MixedReq);
    }

    #! tests \c pattern facet validation
    /** XSD 1.0 part 2 4.3.4.3: \c pattern facets declared in the same restriction are combined as if they
        appeared in a single regular expression separated by \c "|", so a value matching any one of them is
        valid; patterns declared in different derivation steps are intersected instead
    */
    xsdPatternTest() {
        WebService ws = WSDLLib::getWebServiceFromUrl(get_script_dir() + "/xsd-patterns.wsdl");
        WSOperation op = ws.getOperation("Op");

        code accepts = bool sub (string field, auto value) {
            try {
                op.serializeRequest({field: value});
                return True;
            } catch (hash<ExceptionInfo> ex) {
                assertEq("SOAP-SERIALIZATION-ERROR", ex.err, sprintf("%s %y: expected error type", field, value));
                return False;
            }
        };

        # a single pattern must match the entire value
        assertTrue(accepts("single", "imsi-232100000000007"), "single pattern: valid value");
        assertFalse(accepts("single", "abc"), "single pattern: invalid value");
        assertFalse(accepts("single", "imsi-12345"), "single pattern: too few digits");
        assertFalse(accepts("single", "x-imsi-232100000000007"), "single pattern: leading text");
        assertFalse(accepts("single", "imsi-232100000000007-x"), "single pattern: trailing text");

        # sibling patterns "[0-9]+" and "[a-z]+" are united: matching either one is enough
        assertTrue(accepts("multi", "123"), "sibling patterns: matches the 1st pattern");
        assertTrue(accepts("multi", "abc"), "sibling patterns: matches the 2nd pattern");
        assertFalse(accepts("multi", "1a!"), "sibling patterns: matches neither pattern");

        # patterns declared in different derivation steps are intersected
        assertTrue(accepts("derived", "abc"), "derivation steps: satisfies both steps");
        assertFalse(accepts("derived", "ab"), "derivation steps: fails the restricting pattern");
        assertFalse(accepts("derived", "123"), "derivation steps: fails the base pattern");

        # a top-level alternation must be anchored as a whole
        assertTrue(accepts("alt", "aaa"), "alternation: 1st branch");
        assertTrue(accepts("alt", "bbb"), "alternation: 2nd branch");
        assertFalse(accepts("alt", "aaaXXX"), "alternation: trailing text is not accepted");
        assertFalse(accepts("alt", "XXXbbb"), "alternation: leading text is not accepted");

        # a type declaring one pattern per alternative form accepts every valid form
        assertTrue(accepts("ipv6", "$2001:0db8:0000:0000:0000:0000:0000:0001"), "IPv6: full 8-group form");
        assertTrue(accepts("ipv6", "$2001:db8::1"), "IPv6: compressed form");
        assertTrue(accepts("ipv6", "$::ffff:192.0.2.1"), "IPv6: IPv4-mapped form");
        assertFalse(accepts("ipv6", "not-an-address"), "IPv6: invalid value");

        # types with no pattern facet are unaffected
        assertTrue(accepts("plain", "anything at all !@#"), "no pattern facet: any value is accepted");

        # valid values round-trip, and the same rules are applied when deserializing
        hash<auto> h = op.serializeRequest({"single": "imsi-232100000000007", "multi": "abc"});
        hash<auto> rt = op.deserializeRequest(parse_xml(h.body));
        assertEq("imsi-232100000000007", rt.single, "round-trip: single pattern value");
        assertEq("abc", rt.multi, "round-trip: sibling pattern value");

        hash<auto> xh = parse_xml(h.body);
        string env_key = xh.firstKey();
        xh{env_key}."soapenv:Body"."ns:Req"."ns:single" = "bogus";
        assertThrows("SOAP-DESERIALIZATION-ERROR", "does not match", \op.deserializeRequest(), xh);
    }

    #! tests the conversion of XSD regular expressions to PCRE
    /** the XSD regular expression language is not PCRE: \c "^" and \c "$" are ordinary characters, XSD has the
        \c "\i", \c "\I", \c "\c", and \c "\C" escapes and character class subtraction, and \c "\s",
        \c "\w", and \c "\d" denote different character sets
    */
    xsdRegexTest() {
        code m = bool sub (string xsd, string value) {
            return boolean(regex(value, "^(?:" + XsdRegexHelper::toPcre(xsd) + ")$"));
        };

        # "^" and "$" are ordinary characters in XSD, not anchors
        assertTrue(m("a^b", "a^b"), "caret is a literal character");
        assertFalse(m("a^b", "ab"), "caret is not an anchor");
        assertTrue(m("a$", "a$"), "dollar is a literal character");
        assertFalse(m("a$", "a"), "dollar is not an anchor");

        # XML name character escapes, which PCRE does not have
        assertTrue(m("\\i\\c*", "a-b.c"), "\\i\\c* matches an XML name");
        assertFalse(m("\\i\\c*", "-abc"), "\\i does not match a leading hyphen");
        assertTrue(m("\\I", "-"), "\\I matches a non-name-start character");

        # XSD "\s" is exactly space, tab, newline and carriage return; PCRE also includes form feed
        assertTrue(m("\\s", " "), "\\s matches a space");
        assertFalse(m("\\s", "\f"), "\\s does not match a form feed");

        # XSD "\w" is every character except punctuation, separators and other; PCRE "\w" is ASCII only
        assertTrue(m("\\w+", "hello"), "\\w matches ASCII letters");
        assertTrue(m("\\w+", "héllo"), "\\w matches non-ASCII letters");
        assertFalse(m("\\w+", "a.b"), "\\w does not match punctuation");

        # XSD "\d" is any Unicode decimal digit
        assertTrue(m("\\d+", "123"), "\\d matches digits");
        assertFalse(m("\\d+", "abc"), "\\d does not match letters");

        # character class subtraction, which PCRE does not support
        assertTrue(m("[a-z-[aeiou]]", "b"), "class subtraction keeps consonants");
        assertFalse(m("[a-z-[aeiou]]", "a"), "class subtraction removes vowels");

        # ordinary classes are unchanged
        assertTrue(m("[^abc]", "d"), "negated class");
        assertFalse(m("[^abc]", "a"), "negated class excludes its members");
        assertTrue(m("[$^]", "$"), "caret and dollar are literal inside a class");

        # the conversion is applied when validating
        WebService ws = WSDLLib::getWebServiceFromUrl(get_script_dir() + "/xsd-patterns.wsdl");
        WSOperation op = ws.getOperation("Op");
        assertNothing(op.serializeRequest({"dialect": "a^b$c"}).body =~ x/nothing/,
            "a pattern with literal caret and dollar serializes");
        assertThrows("SOAP-SERIALIZATION-ERROR", "does not match", \op.serializeRequest(), {"dialect": "abc"},
            "caret and dollar are not treated as anchors when validating");
        assertThrows("SOAP-SERIALIZATION-ERROR", "does not match", \op.serializeRequest(), {"subtract": "aei"},
            "class subtraction is applied when validating");
    }

    #! tests the constraining facets other than \c pattern and \c enumeration
    xsdFacetTest() {
        WebService ws = WSDLLib::getWebServiceFromUrl(get_script_dir() + "/xsd-patterns.wsdl");
        WSOperation op = ws.getOperation("Op");

        code accepts = bool sub (string field, auto value) {
            try {
                op.serializeRequest({field: value});
                return True;
            } catch (hash<ExceptionInfo> ex) {
                assertEq("SOAP-SERIALIZATION-ERROR", ex.err, sprintf("%s %y: expected error type", field, value));
                return False;
            }
        };

        # minLength / maxLength
        assertTrue(accepts("bounded", "abc"), "minLength: value at the minimum");
        assertTrue(accepts("bounded", "abcdef"), "maxLength: value at the maximum");
        assertFalse(accepts("bounded", "ab"), "minLength: value below the minimum");
        assertFalse(accepts("bounded", "abcdefg"), "maxLength: value above the maximum");

        # length
        assertTrue(accepts("exact", "abcd"), "length: exact length");
        assertFalse(accepts("exact", "abc"), "length: too short");
        assertFalse(accepts("exact", "abcde"), "length: too long");

        # minInclusive / maxInclusive
        assertTrue(accepts("ranged", 10), "minInclusive: value at the bound");
        assertTrue(accepts("ranged", 20), "maxInclusive: value at the bound");
        assertFalse(accepts("ranged", 9), "minInclusive: value below the bound");
        assertFalse(accepts("ranged", 21), "maxInclusive: value above the bound");

        # minExclusive / maxExclusive
        assertTrue(accepts("excl", 11), "minExclusive: value above the bound");
        assertFalse(accepts("excl", 10), "minExclusive: value at the bound");
        assertFalse(accepts("excl", 20), "maxExclusive: value at the bound");

        # totalDigits / fractionDigits; insignificant zeros do not count
        assertTrue(accepts("digits", "12.34"), "digits: at both maxima");
        assertTrue(accepts("digits", "0012.3400"), "digits: insignificant zeros do not count");
        assertFalse(accepts("digits", "123.45"), "totalDigits: too many digits");
        assertFalse(accepts("digits", "1.234"), "fractionDigits: too many fraction digits");

        # facets are applied when deserializing as well
        hash<auto> h = op.serializeRequest({"ranged": 15});
        hash<auto> xh = parse_xml(h.body);
        string env_key = xh.firstKey();
        xh{env_key}."soapenv:Body"."ns:Req"."ns:ranged" = "99";
        assertThrows("SOAP-DESERIALIZATION-ERROR", "maxInclusive", \op.deserializeRequest(), xh);
    }

    #! tests that generated example messages satisfy the constraining facets of their types
    xsdSampleTest() {
        WebService ws = WSDLLib::getWebServiceFromUrl(get_script_dir() + "/xsd-patterns.wsdl");
        WSOperation op = ws.getOperation("Op");
        WSMessageHelper mh(ws);

        # the generated example message must be serializable, which it can only be if every generated value
        # satisfies the facets declared for its type
        auto msg = mh.getMessage(op.input);
        hash<auto> h = op.serializeRequest(msg);
        assertTrue(exists h.body, "the generated example message serializes");

        # and it must round-trip
        assertEq(msg.Req.single, op.deserializeRequest(parse_xml(h.body)).single,
            "the generated example message round-trips");
        assertTrue(exists msg.Req.digits, "a value is generated for a type with digit facets");

        # spot-check the generated values against their facets
        assertRegex("^imsi-[0-9]{6,15}$", msg.Req.single, "sample satisfies a pattern facet");
        assertRegex("^[a-z]{3}$", msg.Req.subtract, "sample satisfies a class subtraction pattern");
        assertEq(4, msg.Req.exact.size(), "sample satisfies an exact length facet");
        assertTrue(msg.Req.bounded.size() >= 3 && msg.Req.bounded.size() <= 6, "sample satisfies length bounds");
        assertTrue(msg.Req.ranged >= 10 && msg.Req.ranged <= 20, "sample satisfies an inclusive range");
        assertTrue(msg.Req.excl > 10 && msg.Req.excl < 20, "sample satisfies an exclusive range");
        assertRegex("^[0-9]{6,}$", msg.Req.padded, "sample is extended to satisfy a length facet");
        assertRegex("^\\$", msg.Req.ipv6, "sample satisfies a 16-alternative pattern facet");
    }

    #! tests the XSD \c "\p{IsXxx}" Unicode block escapes, which PCRE does not support
    xsdBlockTest() {
        code m = bool sub (string xsd, string value) {
            return boolean(regex(value, "^(?:" + XsdRegexHelper::toPcre(xsd) + ")$"));
        };

        # block names are translated to the corresponding character range
        assertEq("[\\x{0000}-\\x{007F}]", XsdRegexHelper::toPcre("\\p{IsBasicLatin}"),
            "a block escape is translated to a character range");
        assertTrue(m("\\p{IsBasicLatin}+", "abc"), "BasicLatin accepts ASCII");
        assertFalse(m("\\p{IsBasicLatin}+", "αβ"), "BasicLatin rejects Greek");
        assertTrue(m("\\P{IsBasicLatin}+", "αβ"), "a negated block escape");
        assertFalse(m("\\P{IsBasicLatin}+", "abc"), "a negated block escape rejects its own block");
        assertTrue(m("[\\p{IsBasicLatin}]+", "abc"), "a block escape inside a character class");

        # the XSD block names come from Unicode 3.1, and names are compared ignoring case, whitespace,
        # hyphens and underscores
        assertTrue(m("\\p{IsGreek}+", "αβ"), "the Unicode 3.1 name \"Greek\"");
        assertTrue(m("\\p{IsGreekandCoptic}+", "αβ"), "the current name \"Greek and Coptic\"");
        assertTrue(m("\\p{IsLatinExtended-A}+", "Ā"), "a hyphenated block name");
        assertTrue(m("\\p{IsLatinExtendedA}+", "Ā"), "the same name without the hyphen");

        # Unicode categories and scripts are passed through to the regular expression engine unchanged
        assertEq("\\p{Lu}", XsdRegexHelper::toPcre("\\p{Lu}"), "a category is passed through unchanged");
        assertTrue(m("\\p{Nd}+", "12"), "a category still works");

        # block escapes work when validating and when generating example messages
        WebService ws = WSDLLib::getWebServiceFromUrl(get_script_dir() + "/xsd-patterns.wsdl");
        WSOperation op = ws.getOperation("Op");
        assertThrows("SOAP-SERIALIZATION-ERROR", "does not match", \op.serializeRequest(),
            {"blockLatin": "αβγ"}, "a value outside the block is rejected");
        WSMessageHelper mh(ws);
        auto msg = mh.getMessage(op.input);
        assertRegex("^[\\x{0000}-\\x{007F}]{3}$", msg.Req.blockLatin, "a sample is generated for a block escape");
        assertRegex("^[\\x{0370}-\\x{03FF}]+$", msg.Req.blockGreek,
            "a sample is generated for a block with no ASCII characters");
    }

    #! tests \c whiteSpace processing
    /** XSD 1.0 part 2 4.3.6: \c whiteSpace is a normalization facet rather than a constraint; \c "replace"
        replaces every tab, newline and carriage return with a space, and \c "collapse" additionally collapses
        runs of spaces into one and removes leading and trailing spaces
    */
    xsdWhiteSpaceTest() {
        assertEq("  a\tb\n c  ", XsdSimpleType::normalizeWhiteSpace("  a\tb\n c  ", "preserve"),
            "preserve leaves the value unchanged");
        assertEq("  a b  c  ", XsdSimpleType::normalizeWhiteSpace("  a\tb\n c  ", "replace"),
            "replace only replaces tabs, newlines and carriage returns");
        assertEq("a b c", XsdSimpleType::normalizeWhiteSpace("  a\tb\n c  ", "collapse"),
            "collapse also collapses and trims spaces");

        WebService ws = WSDLLib::getWebServiceFromUrl(get_script_dir() + "/xsd-patterns.wsdl");
        WSOperation op = ws.getOperation("Op");

        string raw = "  a\tb\n c  ";
        hash<auto> h = op.serializeRequest({
            "wsString": raw,
            "wsNorm": raw,
            "wsToken": raw,
            "wsExplicit": raw,
        });
        hash<auto> rt = op.deserializeRequest(parse_xml(h.body));

        # xs:string preserves whitespace; this is the default and must not change
        assertEq(raw, rt.wsString, "xs:string preserves whitespace");
        # xs:normalizedString replaces, xs:token collapses
        assertEq("  a b  c  ", rt.wsNorm, "xs:normalizedString replaces whitespace");
        assertEq("a b c", rt.wsToken, "xs:token collapses whitespace");
        # an explicit facet applies even when the base type preserves whitespace
        assertEq("a b c", rt.wsExplicit, "an explicit whiteSpace facet is applied");
    }

    #! tests messages whose parts are split between the SOAP header and the SOAP body
    /** the parts appearing in the body are given by the \c parts attribute of the \c soap:body element; if that
        attribute is not present, then all parts of the message appear in the body, including header-bound parts
    */
    headerPartsTest() {
        WebService ws = WSDLLib::getWebServiceFromUrl(get_script_dir() + "/header-parts.wsdl");

        # "OpExplicit" names the body parts in the soap:body element, "OpImplicit" does not
        foreach string opname in (("OpExplicit", "OpImplicit")) {
            WSOperation op = ws.getOperation(opname);
            bool implicit = opname == "OpImplicit";
            hash<auto> args = hash({"Req": {"a": "body-value"}});
            if (implicit) {
                args.SessionId = "body-session";
            }
            hash<auto> h = op.serializeRequest(args, {"SessionId": "sess-1"});
            hash<auto> env = parse_xml(h.body).firstValue();

            # Omitted parts selects every message part, independently of the header binding.
            assertEq(("ns:SessionId",), keys env."soapenv:Header", opname + ": header parts");
            assertEq(implicit ? ("ns:SessionId", "ns:Req") : ("ns:Req",), keys env."soapenv:Body", opname + ": body parts");

            hash<auto> rt = op.deserializeRequest(parse_xml(h.body));
            assertEq("body-value", implicit ? rt."^body^".parameters.a : rt.a, opname + ": body value");
            if (implicit) {
                assertEq("body-session", rt."^body^".SessionId, opname + ": body session");
            }
            assertEq("sess-1", implicit ? rt."^headers^".ReqM.SessionId : rt.ReqM.SessionId, opname + ": header value");
        }

        # elements in the body that are not body parts are still rejected
        WSOperation op = ws.getOperation("OpExplicit");
        hash<auto> h = op.serializeRequest({"Req": {"a": "body-value"}}, {"SessionId": "sess-1"});
        hash<auto> xh = parse_xml(h.body);
        string env_key = xh.firstKey();
        xh{env_key}."soapenv:Body"."ns:Bogus" = "x";
        assertThrows("SOAP-DESERIALIZATION-ERROR", "additional keys", \op.deserializeRequest(), xh);

        # issue #5453: the body part has the same name as its message, and the header part belongs to the same
        # message; the body value must not be overwritten by the header values keyed by the message name
        op = ws.getOperation("OpSameName");
        h = op.serializeResponse({"Resp": {"r": "resp-value"}}, {"SessionId": "sess-2"});
        hash<auto> env = parse_xml(h.body).firstValue();
        assertEq(("ns:SessionId",), keys env."soapenv:Header", "OpSameName: header parts");
        assertEq(("ns:Resp",), keys env."soapenv:Body", "OpSameName: body parts");
        hash<auto> rt = op.deserializeResponse(parse_xml(h.body));
        assertEq({"r": "resp-value", "SameNameM": {"SessionId": "sess-2"}}, rt, "OpSameName: response");

        # the same response with a default namespace on the body element and a different envelope prefix
        string xml = "<?xml version='1.0' encoding='UTF-8'?><S:Envelope "
            "xmlns:S=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:t=\"urn:qore:test:header-parts\">"
            "<S:Header><t:SessionId>sess-3</t:SessionId></S:Header><S:Body>"
            "<Resp xmlns=\"urn:qore:test:header-parts\"><r>other-value</r></Resp></S:Body></S:Envelope>";
        rt = op.deserializeResponse(parse_xml(xml));
        assertEq({"r": "other-value", "SameNameM": {"SessionId": "sess-3"}}, rt, "OpSameName: literal response");

        # a response without the header part still returns the body value
        xml = "<?xml version='1.0' encoding='UTF-8'?><S:Envelope "
            "xmlns:S=\"http://schemas.xmlsoap.org/soap/envelope/\"><S:Body>"
            "<Resp xmlns=\"urn:qore:test:header-parts\"><r>no-header</r></Resp></S:Body></S:Envelope>";
        assertEq({"r": "no-header"}, op.deserializeResponse(parse_xml(xml)), "OpSameName: no header");

        # the body value has a key with the same name as the header message, so it cannot be flattened
        op = ws.getOperation("OpHdrConflict");
        h = op.serializeResponse({"RespHdrConflict": {"HdrM": "body-hdrm"}}, {"SessionId": "sess-4"});
        rt = op.deserializeResponse(parse_xml(h.body));
        assertEq({
            "parameters": {"HdrM": "body-hdrm"},
            "HdrM": {"SessionId": "sess-4"},
        }, rt, "OpHdrConflict: response");

        # a body part has the same name as the header message; the body parts are returned under the message name
        op = ws.getOperation("OpPartConflict");
        h = op.serializeResponse({"Resp": {"r": "part-value"}, "Value": "other-value"}, {"SessionId": "sess-7"});
        rt = op.deserializeResponse(parse_xml(h.body));
        assertEq({
            "PartConflictM": {"HdrM": {"r": "part-value"}, "other": "other-value"},
            "HdrM": {"SessionId": "sess-7"},
        }, rt, "OpPartConflict: response");

        # the body part and a key in its value have the same name as the message, which also carries the header
        # part; all parts are returned under the message name
        op = ws.getOperation("OpMsgConflict");
        h = op.serializeResponse({"RespMsgConflict": {"CollM": "body-collm"}}, {"SessionId": "sess-5"});
        rt = op.deserializeResponse(parse_xml(h.body));
        assertEq({
            "CollM": {
                "SessionId": "sess-5",
                "CollM": {"CollM": "body-collm"},
            },
        }, rt, "OpMsgConflict: response");

        # a scalar body value cannot be flattened when there are header values, which must not be lost
        op = ws.getOperation("OpScalar");
        h = op.serializeResponse({"Value": "scalar-value"}, {"SessionId": "sess-6"});
        rt = op.deserializeResponse(parse_xml(h.body));
        assertEq({"parameters": "scalar-value", "ScalarM": {"SessionId": "sess-6"}}, rt, "OpScalar: response");
    }

    #! asserts that all namespace prefixes used in element names in \a h are declared in \a nsmap
    private checkPrefixesDeclared(hash<auto> h, NsMap nsmap) {
        foreach string key in (keys h) {
            if (key =~ /^\^/) {
                continue;
            }
            *string prefix = (key =~ x/^([^:]+):/)[0];
            if (prefix) {
                assertTrue(exists nsmap.pmap{prefix}, sprintf("prefix %y in element %y is declared", prefix, key));
            }
            if (h{key}.typeCode() == NT_HASH) {
                checkPrefixesDeclared(h{key}, nsmap);
            }
        }
    }

