        assertThrows("SOAP-DESERIALIZATION-ERROR", \op.deserializeResponse(), (TestRes_2,));
        hash<auto> declared_response = TestRes_2;
        declared_response."soap:Envelope"."^attributes^"."xmlns:enc" = SOAP_ENCODING;
        # This operation is RPC/literal. A namespace declaration cannot turn its schema-defined
        # string element into an encoded accessor. Valid encoded references are exercised through
        # an actual RPC/encoded contract in wsdl-scalar-consumers.qtest.
        assertThrows("SOAP-DESERIALIZATION-ERROR", \op.deserializeResponse(), (declared_response,));

        op = ws.getOperation("noInput");
