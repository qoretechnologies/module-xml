            assertRegex(">2026Z<", h.body, "gYear with UTC timezone serializes correctly");
        }

        # gYear with positive offset
        {
            hash<auto> req = {"gYear": "2026+01:00"};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">2026\\+01:00<", h.body, "gYear with positive offset serializes correctly");
        }

        # gYear with negative offset
        {
            hash<auto> req = {"gYear": "2026-05:00"};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">2026-05:00<", h.body, "gYear with negative offset serializes correctly");
        }

        # gYearMonth with timezone
        {
            hash<auto> req = {"gYearMonth": "2026-01Z"};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">2026-01Z<", h.body, "gYearMonth with UTC serializes correctly");
        }
    }

    # ============================================================
    # Partial Date Tests - Negative
    # ============================================================

    partialDateNegativeTests() {
        WSOperation op = ws.getOperation("testFacets");

        # gYear with invalid format
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"gYear": "26"},
            "gYear rejects 2-digit year");

        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"gYear": ""},
            "gYear rejects empty string");

        # gYearMonth with invalid format
