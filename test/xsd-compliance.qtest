    # ============================================================
    # Round-Trip Tests - Serialization
    # ============================================================

    roundTripSerializationTests() {
        WSOperation op = ws.getOperation("testFacets");

        # Multiple fields round-trip
        {
            hash<auto> req = {
                "patternStr": "XY9999",
                "positiveInt": 42,
                "percentInt": 75,
            };

            hash<auto> h = op.serializeRequest(req);
            string xml = h.body;
            hash<auto> parsed = parse_xml(xml);
            *hash<auto> result = op.deserializeRequest(parsed);

            assertEq("XY9999", result.patternStr, "round-trip preserves patternStr");
            assertEq(42, result.positiveInt, "round-trip preserves positiveInt");
            assertEq(75, result.percentInt, "round-trip preserves percentInt");
        }

        # Duration round-trip
        {
            hash<auto> req = {"duration": "P1Y2M3DT4H5M6S"};
            hash<auto> h = op.serializeRequest(req);
            hash<auto> parsed = parse_xml(h.body);
            *hash<auto> result = op.deserializeRequest(parsed);
            assertEq("P1Y2M3DT4H5M6S", result.duration, "round-trip preserves duration");
        }

        # Partial dates round-trip
        {
            hash<auto> req = {"gYear": "2026"};
            hash<auto> h = op.serializeRequest(req);
            hash<auto> parsed = parse_xml(h.body);
            *hash<auto> result = op.deserializeRequest(parsed);
            assertEq("2026", result.gYear, "round-trip preserves gYear");
        }
    }

    # ============================================================
    # Round-Trip Tests - Deserialization
    # ============================================================

    roundTripDeserializationTests() {
        WSOperation op = ws.getOperation("testFacets");

        # Float round-trip with tolerance check
        {
            hash<auto> req = {"floatVal": 2.718};
            hash<auto> h = op.serializeRequest(req);
            hash<auto> parsed = parse_xml(h.body);
            *hash<auto> result = op.deserializeRequest(parsed);

            float diff = abs(2.718 - result.floatVal);
            assertLt(0.001, diff, "float round-trip within tolerance");
        }

        # Decimal round-trip
        {
            hash<auto> req = {"twoDecimalPlaces": 123.45};
            hash<auto> h = op.serializeRequest(req);
            hash<auto> parsed = parse_xml(h.body);
            *hash<auto> result = op.deserializeRequest(parsed);

            float diff = abs(123.45 - result.twoDecimalPlaces);
            assertLt(0.001, diff, "decimal round-trip within tolerance");
        }

        # String round-trip
        {
            hash<auto> req = {"boundedStr": "test string"};
            hash<auto> h = op.serializeRequest(req);
            hash<auto> parsed = parse_xml(h.body);
            *hash<auto> result = op.deserializeRequest(parsed);
            assertEq("test string", result.boundedStr, "string round-trip exact match");
        }
    }

    # ============================================================
    # Libxml2 Cross-Validation Tests
    # ============================================================
    # These tests verify that:
    # 1. Valid data serialized by our code passes libxml2 validation
    # 2. Invalid data that our native validation rejects would also fail libxml2
    # 3. Our serialization format matches XSD standards

    libxml2CrossValidationTests() {
        WSOperation op = ws.getOperation("testFacets");
        string targetNs = "http://qore.org/xsd-facets-test";

        # Verify XSD schema was extracted and contains expected content
        assertGt(100, xsdSchema.size(), "XSD schema extracted from WSDL");
        assertRegex("targetNamespace", xsdSchema, "XSD contains targetNamespace");
        assertRegex("PatternString", xsdSchema, "XSD contains PatternString type");

        # ============================================================
        # Positive tests - valid data passes both native and libxml2
        # ============================================================

        # Pattern facet at boundaries
        assertLibxml2Accepts(op.serializeRequest({"patternStr": "AA0000"}),
            "libxml2 accepts pattern at lower boundary AA0000");
        assertLibxml2Accepts(op.serializeRequest({"patternStr": "ZZ9999"}),
            "libxml2 accepts pattern at upper boundary ZZ9999");

        # Multi-pattern (must match all patterns)
        assertLibxml2Accepts(op.serializeRequest({"multiPatternStr": "A1"}),
            "libxml2 accepts minimal multi-pattern A1");
        assertLibxml2Accepts(op.serializeRequest({"multiPatternStr": "Testing123"}),
            "libxml2 accepts multi-pattern Testing123");

        # Length facets at boundaries
        assertLibxml2Accepts(op.serializeRequest({"fixedLenStr": "0123456789"}),
            "libxml2 accepts exact length 10");
        assertLibxml2Accepts(op.serializeRequest({"minLenStr": "12345"}),
            "libxml2 accepts minLength at boundary 5");
        assertLibxml2Accepts(op.serializeRequest({"maxLenStr": "12345678901234567890"}),
            "libxml2 accepts maxLength at boundary 20");
        assertLibxml2Accepts(op.serializeRequest({"boundedStr": "abc"}),
            "libxml2 accepts bounded length at min boundary 3");

        # Numeric range facets at boundaries
        assertLibxml2Accepts(op.serializeRequest({"positiveInt": 1}),
            "libxml2 accepts minInclusive at boundary 1");
        assertLibxml2Accepts(op.serializeRequest({"percentInt": 0}),
            "libxml2 accepts percentage at min boundary 0");
        assertLibxml2Accepts(op.serializeRequest({"percentInt": 100}),
            "libxml2 accepts percentage at max boundary 100");

        # Precision facets
        assertLibxml2Accepts(op.serializeRequest({"fourDigitNum": 1234}),
            "libxml2 accepts 4 digit number");
        assertLibxml2Accepts(op.serializeRequest({"fourDigitNum": 12.34}),
            "libxml2 accepts 4 total digits with decimal");
        assertLibxml2Accepts(op.serializeRequest({"twoDecimalPlaces": 99.99}),
            "libxml2 accepts 2 decimal places");

        # List types
        assertLibxml2Accepts(op.serializeRequest({"intList": (1, 2, 3)}),
            "libxml2 accepts integer list");
        assertLibxml2Accepts(op.serializeRequest({"intList": (42,)}),
            "libxml2 accepts single-item list");
        assertLibxml2Accepts(op.serializeRequest({"stringList": ("hello", "world")}),
            "libxml2 accepts string list");

        # Duration type variations
        assertLibxml2Accepts(op.serializeRequest({"duration": "P1Y"}),
            "libxml2 accepts year-only duration");
        assertLibxml2Accepts(op.serializeRequest({"duration": "PT1H30M"}),
            "libxml2 accepts time-only duration");
        assertLibxml2Accepts(op.serializeRequest({"duration": "P1Y2M3DT4H5M6S"}),
            "libxml2 accepts full duration");
        assertLibxml2Accepts(op.serializeRequest({"duration": "PT0S"}),
            "libxml2 accepts zero duration");

        # Partial date types
        assertLibxml2Accepts(op.serializeRequest({"gYear": "2026"}),
            "libxml2 accepts gYear");
        assertLibxml2Accepts(op.serializeRequest({"gYear": "2026Z"}),
            "libxml2 accepts gYear with UTC timezone");
        assertLibxml2Accepts(op.serializeRequest({"gYear": "-0500"}),
            "libxml2 accepts negative gYear");
        assertLibxml2Accepts(op.serializeRequest({"gYearMonth": "2026-01"}),
            "libxml2 accepts gYearMonth");
        assertLibxml2Accepts(op.serializeRequest({"gMonthDay": "--01-27"}),
            "libxml2 accepts gMonthDay");
        assertLibxml2Accepts(op.serializeRequest({"gMonth": "--01"}),
            "libxml2 accepts gMonth");
        assertLibxml2Accepts(op.serializeRequest({"gDay": "---27"}),
            "libxml2 accepts gDay");

        # Float/double types including special values
        assertLibxml2Accepts(op.serializeRequest({"floatVal": 3.14159}),
            "libxml2 accepts float");
        assertLibxml2Accepts(op.serializeRequest({"floatVal": -3.14}),
            "libxml2 accepts negative float");
        assertLibxml2Accepts(op.serializeRequest({"floatVal": "INF"}),
            "libxml2 accepts INF");
        assertLibxml2Accepts(op.serializeRequest({"floatVal": "-INF"}),
            "libxml2 accepts -INF");
        assertLibxml2Accepts(op.serializeRequest({"floatVal": "NaN"}),
            "libxml2 accepts NaN");
        assertLibxml2Accepts(op.serializeRequest({"doubleVal": 2.718281828}),
            "libxml2 accepts double");

        # Combined complex request
        assertLibxml2Accepts(op.serializeRequest({
            "patternStr": "AB1234",
            "positiveInt": 42,
            "percentInt": 75,
            "duration": "P1D",
            "gYear": "2026",
            "floatVal": 3.14,
        }), "libxml2 accepts complex multi-field request");

        # ============================================================
        # Negative tests - invalid XML rejected by libxml2
        # ============================================================
        # These test that hand-crafted invalid XML is rejected by libxml2,
        # verifying our schema is correctly enforced.

        # Invalid pattern value (libxml2 enforces xs:pattern)
        string invalidPattern = sprintf(
            '<?xml version="1.0" encoding="UTF-8"?>' + "\n" +
            '<xsdfa:TestFacets xmlns:xsdfa="%s">' +
            '<xsdfa:patternStr>invalid</xsdfa:patternStr>' +
            '</xsdfa:TestFacets>', targetNs);
        assertLibxml2Rejects(invalidPattern,
            "libxml2 rejects invalid pattern 'invalid'");

        # Invalid minLength (too short)
        string tooShort = sprintf(
            '<?xml version="1.0" encoding="UTF-8"?>' + "\n" +
            '<xsdfa:TestFacets xmlns:xsdfa="%s">' +
            '<xsdfa:minLenStr>ab</xsdfa:minLenStr>' +
            '</xsdfa:TestFacets>', targetNs);
        assertLibxml2Rejects(tooShort,
            "libxml2 rejects string below minLength");

        # Invalid maxLength (too long)
        string tooLong = sprintf(
            '<?xml version="1.0" encoding="UTF-8"?>' + "\n" +
            '<xsdfa:TestFacets xmlns:xsdfa="%s">' +
            '<xsdfa:maxLenStr>123456789012345678901</xsdfa:maxLenStr>' +
            '</xsdfa:TestFacets>', targetNs);
        assertLibxml2Rejects(tooLong,
            "libxml2 rejects string above maxLength");

        # Invalid duration format
        string badDuration = sprintf(
            '<?xml version="1.0" encoding="UTF-8"?>' + "\n" +
            '<xsdfa:TestFacets xmlns:xsdfa="%s">' +
            '<xsdfa:duration>invalid</xsdfa:duration>' +
            '</xsdfa:TestFacets>', targetNs);
        assertLibxml2Rejects(badDuration,
            "libxml2 rejects invalid duration format");

        # Invalid gYear format
        string badGYear = sprintf(
            '<?xml version="1.0" encoding="UTF-8"?>' + "\n" +
            '<xsdfa:TestFacets xmlns:xsdfa="%s">' +
            '<xsdfa:gYear>26</xsdfa:gYear>' +
            '</xsdfa:TestFacets>', targetNs);
        assertLibxml2Rejects(badGYear,
            "libxml2 rejects 2-digit gYear");

        # Invalid integer in list
        string badList = sprintf(
            '<?xml version="1.0" encoding="UTF-8"?>' + "\n" +
            '<xsdfa:TestFacets xmlns:xsdfa="%s">' +
            '<xsdfa:intList>1 2 abc 4</xsdfa:intList>' +
            '</xsdfa:TestFacets>', targetNs);
        assertLibxml2Rejects(badList,
            "libxml2 rejects non-integer in int list");

        # Unknown element (schema validation)
        string unknownElem = sprintf(
            '<?xml version="1.0" encoding="UTF-8"?>' + "\n" +
            '<xsdfa:TestFacets xmlns:xsdfa="%s">' +
            '<xsdfa:unknownElement>value</xsdfa:unknownElement>' +
            '</xsdfa:TestFacets>', targetNs);
        assertLibxml2Rejects(unknownElem,
            "libxml2 rejects unknown element");

        # ============================================================
        # Agreement tests - verify native and libxml2 agree
        # ============================================================
        # These verify that values our native validation rejects
        # would also be rejected by libxml2 (if we bypassed native validation)

        # Test that boundary violations are caught consistently
        # Our native validation catches these; verify libxml2 would too

        # Pattern violation
        string patternViolation = sprintf(
            '<?xml version="1.0" encoding="UTF-8"?>' + "\n" +
            '<xsdfa:TestFacets xmlns:xsdfa="%s">' +
            '<xsdfa:patternStr>ab1234</xsdfa:patternStr>' +
            '</xsdfa:TestFacets>', targetNs);
        bool nativeRejects = False;
        try {
            op.serializeRequest({"patternStr": "ab1234"});
        } catch (hash<ExceptionInfo> ex) {
            nativeRejects = True;
        }
        assertTrue(nativeRejects, "native validation rejects lowercase pattern");
        assertLibxml2Rejects(patternViolation,
            "libxml2 also rejects lowercase pattern - validations agree");

        # Length violation
        string lengthViolation = sprintf(
            '<?xml version="1.0" encoding="UTF-8"?>' + "\n" +
            '<xsdfa:TestFacets xmlns:xsdfa="%s">' +
            '<xsdfa:fixedLenStr>short</xsdfa:fixedLenStr>' +
            '</xsdfa:TestFacets>', targetNs);
        nativeRejects = False;
        try {
            op.serializeRequest({"fixedLenStr": "short"});
        } catch (hash<ExceptionInfo> ex) {
            nativeRejects = True;
        }
        assertTrue(nativeRejects, "native validation rejects wrong length");
        assertLibxml2Rejects(lengthViolation,
            "libxml2 also rejects wrong length - validations agree");
    }

    # ============================================================
    # Element Group Resolution Tests
    # ============================================================
    # These tests verify that xs:group references are correctly resolved
    # and elements from groups are merged into complex types.

    elementGroupResolutionTests() {
        WSOperation op = ws.getOperation("testPersonAddress");

        # Verify that PersonAddress type correctly resolves elements from PersonNameGroup and AddressGroup
        # PersonNameGroup contains: firstName, lastName
        # AddressGroup contains: street, city, zipCode, country

        # Test with all elements from groups
        {
            hash<auto> req = {
                "firstName": "John",
                "lastName": "Doe",
                "street": "123 Main St",
                "city": "New York",
                "zipCode": "10001",
                "country": "USA",
            };
            hash<auto> h = op.serializeRequest(req);

            # Verify all group elements are present in serialized output
            assertRegex("<xsdfa:firstName>John</xsdfa:firstName>", h.body,
                "group element firstName serialized correctly");
            assertRegex("<xsdfa:lastName>Doe</xsdfa:lastName>", h.body,
                "group element lastName serialized correctly");
            assertRegex("<xsdfa:street>123 Main St</xsdfa:street>", h.body,
                "group element street serialized correctly");
            assertRegex("<xsdfa:city>New York</xsdfa:city>", h.body,
                "group element city serialized correctly");
            assertRegex("<xsdfa:zipCode>10001</xsdfa:zipCode>", h.body,
                "group element zipCode serialized correctly");
            assertRegex("<xsdfa:country>USA</xsdfa:country>", h.body,
                "group element country serialized correctly");
        }

        # Test serialization of partial group elements (optional elements)
        {
            # Since all elements in the groups are required by default (no minOccurs="0"),
            # we need to provide all of them
            hash<auto> req = {
                "firstName": "Jane",
                "lastName": "Smith",
                "street": "456 Oak Ave",
                "city": "Los Angeles",
                "zipCode": "90001",
                "country": "Canada",
            };
            hash<auto> h = op.serializeRequest(req);

            assertRegex("<xsdfa:firstName>Jane</xsdfa:firstName>", h.body,
                "different firstName value serialized correctly");
            assertRegex("<xsdfa:country>Canada</xsdfa:country>", h.body,
                "different country value serialized correctly");
        }
    }

    # ============================================================
    # Attribute Group Resolution Tests
    # ============================================================
    # These tests verify that xs:attributeGroup references are correctly resolved
    # and attributes from attribute groups are available in complex types.

    attributeGroupResolutionTests() {
        # Verify that groups are stored with namespace-qualified keys
        string targetNs = "http://qore.org/xsd-facets-test";
        string qualifiedGroupKey = sprintf("{%s}AddressGroup", targetNs);
        string qualifiedAttrGroupKey = sprintf("{%s}TimestampAttrs", targetNs);

        # Verify group maps use qualified keys
        assertTrue(ws.groupMap.hasKey(qualifiedGroupKey),
            "groupMap uses qualified key for AddressGroup");
        assertTrue(ws.attrGroupMap.hasKey(qualifiedAttrGroupKey),
            "attrGroupMap uses qualified key for TimestampAttrs");

        # Verify group elements are accessible via qualified key
        auto addressGroup = ws.groupMap{qualifiedGroupKey};
        assertTrue(exists addressGroup, "AddressGroup found via qualified key");
        if (addressGroup) {
            auto grpElems = addressGroup.getElements();
            assertTrue(grpElems.hasKey("street"), "AddressGroup has street element");
            assertTrue(grpElems.hasKey("city"), "AddressGroup has city element");
        }

        # Verify the PersonAddress type has attributes from TimestampAttrs attribute group
        # TimestampAttrs contains: createdAt (optional dateTime), modifiedAt (optional dateTime)

        # Access the PersonAddress type directly from the tmap
        *XsdAbstractType personAddressType = ws.tmap.PersonAddress;
        assertTrue(exists personAddressType, "PersonAddress type exists in WebService tmap");

        if (personAddressType instanceof XsdComplexType) {
            XsdComplexType ct = cast<XsdComplexType>(personAddressType);

            # Verify attributes from TimestampAttrs attribute group are resolved
            assertTrue(ct.attrs.hasKey("createdAt"),
                "PersonAddress has createdAt attribute from TimestampAttrs group");
            assertTrue(ct.attrs.hasKey("modifiedAt"),
                "PersonAddress has modifiedAt attribute from TimestampAttrs group");

            # Verify attribute properties
            assertEq("optional", ct.attrs.createdAt.use,
                "createdAt attribute has correct 'optional' use from attributeGroup");
            assertEq("optional", ct.attrs.modifiedAt.use,
                "modifiedAt attribute has correct 'optional' use from attributeGroup");
        } else {
            fail("PersonAddress should be a complex type");
        }

        # Verify VersionedDocument type has attributes from VersionAttrs attribute group
        # VersionAttrs contains: version (required int), deprecated (optional boolean)
        *XsdAbstractType versionedDocType = ws.tmap.VersionedDocument;
        assertTrue(exists versionedDocType, "VersionedDocument type exists in WebService tmap");

        if (versionedDocType instanceof XsdComplexType) {
            XsdComplexType ct = cast<XsdComplexType>(versionedDocType);

            # Verify attributes from VersionAttrs attribute group are resolved
            assertTrue(ct.attrs.hasKey("version"),
                "VersionedDocument has version attribute from VersionAttrs group");
            assertTrue(ct.attrs.hasKey("deprecated"),
                "VersionedDocument has deprecated attribute from VersionAttrs group");

            # Verify attribute properties
            assertEq("required", ct.attrs.version.use,
                "version attribute has correct 'required' use from attributeGroup");
            assertEq("optional", ct.attrs.deprecated.use,
                "deprecated attribute has correct 'optional' use from attributeGroup");
        } else {
            fail("VersionedDocument should be a complex type");
        }
    }

    # ============================================================
    # Group Round-Trip Serialization Tests
    # ============================================================
    # These tests verify that data using groups can be serialized and
    # deserialized correctly (round-trip).

    groupRoundTripTests() {
        WSOperation op = ws.getOperation("testPersonAddress");

        # Full round-trip with all elements from groups
        {
            hash<auto> req = {
                "firstName": "RoundTrip",
                "lastName": "Test",
                "street": "555 Test Blvd",
                "city": "Phoenix",
                "zipCode": "85001",
                "country": "Mexico",
            };
            hash<auto> h = op.serializeRequest(req);
            hash<auto> parsed = parse_xml(h.body);
            *hash<auto> result = op.deserializeRequest(parsed);

            assertEq("RoundTrip", result.firstName, "round-trip preserves firstName from group");
            assertEq("Test", result.lastName, "round-trip preserves lastName from group");
            assertEq("555 Test Blvd", result.street, "round-trip preserves street from group");
            assertEq("Phoenix", result.city, "round-trip preserves city from group");
            assertEq("85001", result.zipCode, "round-trip preserves zipCode from group");
            assertEq("Mexico", result.country, "round-trip preserves country from group");
        }

        # Test with different data to verify group element handling
        {
            hash<auto> req = {
                "firstName": "Unicode",
                "lastName": "Tëst",
                "street": "888 日本語 Ave",
                "city": "東京",
                "zipCode": "100-0001",
                "country": "Japan",
            };
            hash<auto> h = op.serializeRequest(req);
            hash<auto> parsed = parse_xml(h.body);
            *hash<auto> result = op.deserializeRequest(parsed);

            assertEq("Unicode", result.firstName, "round-trip preserves firstName with unicode sibling");
            assertEq("Tëst", result.lastName, "round-trip preserves lastName with unicode");
            assertEq("東京", result.city, "round-trip preserves city with unicode from group");
        }

        # Verify libxml2 accepts serialized output with groups
        {
            hash<auto> req = {
                "firstName": "LibXml",
                "lastName": "Test",
                "street": "777 Validate Ave",
                "city": "Austin",
                "zipCode": "73301",
                "country": "USA",
            };
            assertLibxml2Accepts(op.serializeRequest(req),
                "libxml2 accepts PersonAddress with resolved groups");
        }
    }

    # ============================================================
    # Byte Range Validation Tests
    # ============================================================

    byteRangeTests() {
        WSOperation op = ws.getOperation("testFacets");

        # Valid signed byte values
        {
            hash<auto> h = op.serializeRequest({"byteVal": -128});
            assertRegex(">-128<", h.body, "byte accepts -128 (minimum signed byte)");
        }
        {
            hash<auto> h = op.serializeRequest({"byteVal": 127});
            assertRegex(">127<", h.body, "byte accepts 127 (maximum signed byte)");
        }
        {
            hash<auto> h = op.serializeRequest({"byteVal": 0});
            assertRegex(">0<", h.body, "byte accepts 0");
        }
        {
            hash<auto> h = op.serializeRequest({"byteVal": -1});
            assertRegex(">-1<", h.body, "byte accepts -1");
        }

        # Invalid byte values
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"byteVal": 128},
            "byte rejects 128 (above signed byte range)");
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"byteVal": -129},
            "byte rejects -129 (below signed byte range)");
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"byteVal": 200},
            "byte rejects 200 (unsigned range, invalid for signed byte)");
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"byteVal": 255},
            "byte rejects 255 (unsigned range, invalid for signed byte)");

        # Byte deserialization round-trip
        {
            hash<auto> h = op.serializeRequest({"byteVal": -128});
            hash<auto> parsed = parse_xml(h.body);
            *hash<auto> result = op.deserializeRequest(parsed);
            assertEq(-128, result.byteVal, "byte round-trip preserves -128");
        }
        {
            hash<auto> h = op.serializeRequest({"byteVal": 127});
            hash<auto> parsed = parse_xml(h.body);
            *hash<auto> result = op.deserializeRequest(parsed);
            assertEq(127, result.byteVal, "byte round-trip preserves 127");
        }
    }

    # ============================================================
    # DateTime ISO-8601 Round-Trip Tests
    # ============================================================

    dateTimeIso8601Tests() {
        WSOperation op = ws.getOperation("testFacets");

        # dateTime serialization includes timezone
        {
            date dt = date("2026-04-03T12:30:45.123+05:00");
            hash<auto> h = op.serializeRequest({"dateTimeVal": dt});
            assertRegex("2026-04-03T12:30:45\\.123\\+05:00", h.body,
                "dateTime serializes with timezone and fractional seconds");
        }

        # dateTime round-trip preserves timezone
        {
            date dt = date("2026-04-03T12:30:45.123+05:00");
            hash<auto> h = op.serializeRequest({"dateTimeVal": dt});
            hash<auto> parsed = parse_xml(h.body);
            *hash<auto> result = op.deserializeRequest(parsed);
            assertEq(dt, result.dateTimeVal, "dateTime round-trip preserves value with timezone");
        }

        # dateTime deserialization handles full ISO-8601
        {
            date dt = date("2026-01-15T08:00:00.000+00:00");
            hash<auto> h = op.serializeRequest({"dateTimeVal": dt});
            hash<auto> parsed = parse_xml(h.body);
            *hash<auto> result = op.deserializeRequest(parsed);
            assertEq(dt, result.dateTimeVal, "dateTime round-trip preserves UTC value");
        }

        # date round-trip
        {
            hash<auto> h = op.serializeRequest({"dateVal": date("2026-04-03")});
            assertRegex(">2026-04-03<", h.body, "date serializes as YYYY-MM-DD");
            hash<auto> parsed = parse_xml(h.body);
            *hash<auto> result = op.deserializeRequest(parsed);
            assertEq(date("2026-04-03"), result.dateVal, "date round-trip preserves value");
        }
    }

    # ============================================================
    # Time Format Tests
    # ============================================================

    timeFormatTests() {
        WSOperation op = ws.getOperation("testFacets");

        # time serialization produces correct format (HH:mm:SS not hh:mm:ss)
        {
            date t = date("1970-01-01T14:30:45");
            hash<auto> h = op.serializeRequest({"timeVal": t});
            assertRegex(">14:30:45", h.body, "time serializes with correct uppercase format");
        }

        # time with milliseconds
        {
            date t = date("1970-01-01T09:15:30.500");
            hash<auto> h = op.serializeRequest({"timeVal": t});
            assertRegex(">09:15:30\\.500", h.body, "time serializes milliseconds");
        }

        # time round-trip
        {
            date t = date("1970-01-01T14:30:45");
            hash<auto> h = op.serializeRequest({"timeVal": t});
            hash<auto> parsed = parse_xml(h.body);
            *hash<auto> result = op.deserializeRequest(parsed);
            assertEq(t, result.timeVal, "time round-trip preserves value");
        }
    }

    # ============================================================
    # String-Derived XSD Type Tests
    # ============================================================

    stringDerivedTypeTests() {
        WSOperation op = ws.getOperation("testFacets");

        # anyURI serialize and round-trip
        {
            hash<auto> h = op.serializeRequest({"anyURIVal": "https://example.com/path?q=1"});
            assertRegex(">https://example.com/path", h.body, "anyURI serializes correctly");
            hash<auto> parsed = parse_xml(h.body);
            *hash<auto> result = op.deserializeRequest(parsed);
            assertEq("https://example.com/path?q=1", result.anyURIVal, "anyURI round-trip preserves value");
        }

        # language
        {
            hash<auto> h = op.serializeRequest({"languageVal": "en-US"});
            assertRegex(">en-US<", h.body, "language serializes correctly");
            hash<auto> parsed = parse_xml(h.body);
            *hash<auto> result = op.deserializeRequest(parsed);
            assertEq("en-US", result.languageVal, "language round-trip preserves value");
        }

        # NCName
        {
            hash<auto> h = op.serializeRequest({"ncNameVal": "myElement"});
            assertRegex(">myElement<", h.body, "NCName serializes correctly");
            hash<auto> parsed = parse_xml(h.body);
            *hash<auto> result = op.deserializeRequest(parsed);
            assertEq("myElement", result.ncNameVal, "NCName round-trip preserves value");
        }

        # NMTOKEN
        {
            hash<auto> h = op.serializeRequest({"nmTokenVal": "valid-token.123"});
            assertRegex(">valid-token.123<", h.body, "NMTOKEN serializes correctly");
            hash<auto> parsed = parse_xml(h.body);
            *hash<auto> result = op.deserializeRequest(parsed);
            assertEq("valid-token.123", result.nmTokenVal, "NMTOKEN round-trip preserves value");
        }

        # Name
        {
            hash<auto> h = op.serializeRequest({"nameVal": "xml:lang"});
            assertRegex(">xml:lang<", h.body, "Name serializes correctly");
            hash<auto> parsed = parse_xml(h.body);
            *hash<auto> result = op.deserializeRequest(parsed);
            assertEq("xml:lang", result.nameVal, "Name round-trip preserves value");
        }

        # ID
        {
            hash<auto> h = op.serializeRequest({"idVal": "unique-id-42"});
            assertRegex(">unique-id-42<", h.body, "ID serializes correctly");
            hash<auto> parsed = parse_xml(h.body);
            *hash<auto> result = op.deserializeRequest(parsed);
            assertEq("unique-id-42", result.idVal, "ID round-trip preserves value");
        }
    }

    # ============================================================
    # Data Provider Type Mapping Tests
    # ============================================================

    dataProviderTypeMappingTests() {
        Namespaces nsc({"xmlns:xsd": XSD_NS});

        # int maps to IntType
        {
            XsdBaseType bt("int", nsc);
            assertEq(IntType, bt.getDataProviderBaseType(), "XSD int maps to IntType");
        }

        # byte maps to IntType
        {
            XsdBaseType bt("byte", nsc);
            assertEq(IntType, bt.getDataProviderBaseType(), "XSD byte maps to IntType");
        }

        # anyURI maps to StringType
        {
            XsdBaseType bt("anyURI", nsc);
            assertEq(StringType, bt.getDataProviderBaseType(), "XSD anyURI maps to StringType");
        }

        # language maps to StringType
        {
            XsdBaseType bt("language", nsc);
            assertEq(StringType, bt.getDataProviderBaseType(), "XSD language maps to StringType");
        }

        # NCName maps to StringType
        {
            XsdBaseType bt("NCName", nsc);
            assertEq(StringType, bt.getDataProviderBaseType(), "XSD NCName maps to StringType");
        }

        # NMTOKEN maps to StringType
        {
            XsdBaseType bt("NMTOKEN", nsc);
            assertEq(StringType, bt.getDataProviderBaseType(), "XSD NMTOKEN maps to StringType");
        }

        # float maps to FloatType
        {
            XsdBaseType bt("float", nsc);
            assertEq(FloatType, bt.getDataProviderBaseType(), "XSD float maps to FloatType");
        }

        # dateTime maps to DateType
        {
            XsdBaseType bt("dateTime", nsc);
            assertEq(DateType, bt.getDataProviderBaseType(), "XSD dateTime maps to DateType");
        }
    }
}
