            "gYearMonth rejects single-digit month");

        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"gYearMonth": "2026/01"},
            "gYearMonth rejects slash separator");

        # gMonthDay with invalid format
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"gMonthDay": "-01-27"},
            "gMonthDay rejects single dash prefix");

        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"gMonthDay": "01-27"},
            "gMonthDay rejects no prefix");

        # gMonth with invalid format
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"gMonth": "-01"},
            "gMonth rejects single dash prefix");

        # gDay with invalid format
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"gDay": "--27"},
            "gDay rejects double dash prefix (needs triple)");
    }

