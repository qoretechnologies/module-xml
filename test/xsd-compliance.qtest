    # ============================================================

    precisionFacetNegativeTests() {
        WSOperation op = ws.getOperation("testFacets");

        # Too many total digits (5 instead of 4)
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"fourDigitNum": 12345},
            "totalDigits rejects 5 digit integer");

        # Too many total digits with decimal
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"fourDigitNum": 123.45},
            "totalDigits rejects 5 total digits (123.45)");

        # Too many fraction digits (3 instead of 2)
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"twoDecimalPlaces": 1.234},
            "fractionDigits rejects 3 decimal places");

        # Too many fraction digits (4 instead of 2)
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"twoDecimalPlaces": 0.1234},
            "fractionDigits rejects 4 decimal places");

        # Currency amount with negative value
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"currencyAmount": -1},
            "currency amount rejects negative value");
    }

