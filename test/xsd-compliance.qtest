    # ============================================================
    # List Type Tests - Deserialization
    # ============================================================

    listTypeDeserializationTests() {
        WSOperation op = ws.getOperation("testFacets");

        # Round-trip for integer list
        {
            hash<auto> req = {"intList": (1, 2, 3)};
            hash<auto> h = op.serializeRequest(req);
            hash<auto> parsed = parse_xml(h.body);
            *hash<auto> result = op.deserializeRequest(parsed);
            assertEq((1, 2, 3), result.intList, "intList round-trip preserves values");
        }

        # Round-trip for string list
        {
            hash<auto> req = {"stringList": ("foo", "bar")};
            hash<auto> h = op.serializeRequest(req);
            hash<auto> parsed = parse_xml(h.body);
            *hash<auto> result = op.deserializeRequest(parsed);
            assertEq(("foo", "bar"), result.stringList, "stringList round-trip preserves values");
        }
    }

    # ============================================================
    # List Type Tests - Corner Cases
    # ============================================================

    listTypeCornerCases() {
        WSOperation op = ws.getOperation("testFacets");

        # Single item list
        {
            hash<auto> req = {"intList": (42,)};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">42<", h.body, "single item list serializes correctly");
        }

        # Empty list
        {
            hash<auto> req = {"intList": ()};
            hash<auto> h = op.serializeRequest(req);
            assertRegex("intList", h.body, "empty list serializes (element present)");
        }

        # Large list
        {
            list<int> bigList = map $1, 1..100;
            hash<auto> req = {"intList": bigList};
            hash<auto> h = op.serializeRequest(req);
            assertRegex("intList", h.body, "large list (100 items) serializes");
            assertRegex("1 2 3", h.body, "large list starts correctly");
            assertRegex("98 99 100", h.body, "large list ends correctly");
        }

        # Negative numbers in list
        {
            hash<auto> req = {"intList": (-1, 0, 1)};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">-1 0 1<", h.body, "list with negative numbers serializes correctly");
        }
    }

    # ============================================================
    # Duration Type Tests - Positive
    # ============================================================

    durationTypePositiveTests() {
        WSOperation op = ws.getOperation("testFacets");

        # Full duration: P1Y2M3DT4H5M6S
        {
            hash<auto> req = {"duration": "P1Y2M3DT4H5M6S"};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">P1Y2M3DT4H5M6S<", h.body, "full duration serializes correctly");
        }

        # Simple day duration: P1D
        {
            hash<auto> req = {"duration": "P1D"};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">P1D<", h.body, "simple day duration serializes correctly");
        }

        # Time-only duration: PT1H30M
        {
            hash<auto> req = {"duration": "PT1H30M"};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">PT1H30M<", h.body, "time-only duration serializes correctly");
        }

        # Year only
        {
            hash<auto> req = {"duration": "P1Y"};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">P1Y<", h.body, "year-only duration serializes correctly");
        }

        # Month only
        {
            hash<auto> req = {"duration": "P6M"};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">P6M<", h.body, "month-only duration serializes correctly");
        }

        # Seconds with decimal
        {
            hash<auto> req = {"duration": "PT1.5S"};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">PT1.5S<", h.body, "duration with decimal seconds serializes correctly");
        }

        # Zero duration
        {
            hash<auto> req = {"duration": "PT0S"};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">PT0S<", h.body, "zero duration serializes correctly");
        }
    }

    # ============================================================
    # Duration Type Tests - Negative
    # ============================================================

    durationTypeNegativeTests() {
        WSOperation op = ws.getOperation("testFacets");

        # Missing P prefix
