            hash<auto> h = op.serializeRequest(req);
            assertRegex(">42<", h.body, "float accepts integer value");
        }

        # Negative float
        {
            hash<auto> req = {"floatVal": -3.14};
            hash<auto> h = op.serializeRequest(req);
            assertRegex("-3.14", h.body, "float serializes negative value correctly");
        }

        # Very small float
        {
            hash<auto> req = {"floatVal": 0.0000001};
            hash<auto> h = op.serializeRequest(req);
            assertRegex("floatVal", h.body, "float accepts very small value");
        }

        # Very large float
        {
            hash<auto> req = {"floatVal": 1000000000};
            hash<auto> h = op.serializeRequest(req);
            assertRegex("floatVal", h.body, "float accepts very large value");
        }
