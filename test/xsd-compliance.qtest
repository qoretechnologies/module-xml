#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# XSD Compliance Test Suite
# Copyright (C) 2026 Qore Technologies, s.r.o.
#
# Tests XSD standards compliance by validating serialized output against
# libxml2's XmlDoc::validateSchema() as an independent oracle.

%requires qore >= 2.3

%modern

%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires Util

%requires WSDL
%requires xml

%exec-class XsdComplianceTest

class XsdComplianceTest inherits QUnit::Test {
    public {
        WebService ws;
        const XsdFacetsWsdl = get_script_dir() + "/xsd-facets.wsdl";

        #! Extracted XSD schema for libxml2 validation
        string xsdSchema;
    }

    constructor() : QUnit::Test("XsdComplianceTest", "1.0") {
        addTestCase("Pattern facet positive tests", \patternFacetPositiveTests());
        addTestCase("Pattern facet negative tests", \patternFacetNegativeTests());
        addTestCase("Length facet positive tests", \lengthFacetPositiveTests());
        addTestCase("Length facet negative tests", \lengthFacetNegativeTests());
        addTestCase("Length facet corner cases", \lengthFacetCornerCases());
        addTestCase("Numeric range positive tests", \numericRangePositiveTests());
        addTestCase("Numeric range negative tests", \numericRangeNegativeTests());
        addTestCase("Numeric range boundary tests", \numericRangeBoundaryTests());
        addTestCase("Precision facet positive tests", \precisionFacetPositiveTests());
        addTestCase("Precision facet negative tests", \precisionFacetNegativeTests());
        addTestCase("List type serialization tests", \listTypeSerializationTests());
        addTestCase("List type deserialization tests", \listTypeDeserializationTests());
        addTestCase("List type corner cases", \listTypeCornerCases());
        addTestCase("Duration type positive tests", \durationTypePositiveTests());
        addTestCase("Duration type negative tests", \durationTypeNegativeTests());
        addTestCase("Partial date positive tests", \partialDatePositiveTests());
        addTestCase("Partial date with timezone tests", \partialDateTimezoneTests());
        addTestCase("Partial date negative tests", \partialDateNegativeTests());
        addTestCase("Float/double positive tests", \floatDoublePositiveTests());
        addTestCase("Float/double special values tests", \floatDoubleSpecialValuesTests());
        addTestCase("Float/double negative tests", \floatDoubleNegativeTests());
        addTestCase("Round-trip serialization tests", \roundTripSerializationTests());
        addTestCase("Round-trip deserialization tests", \roundTripDeserializationTests());
        addTestCase("Libxml2 cross-validation tests", \libxml2CrossValidationTests());
        addTestCase("Element group resolution tests", \elementGroupResolutionTests());
        addTestCase("Attribute group resolution tests", \attributeGroupResolutionTests());
        addTestCase("Group round-trip serialization tests", \groupRoundTripTests());
        addTestCase("Byte range validation tests", \byteRangeTests());
        addTestCase("DateTime ISO-8601 round-trip tests", \dateTimeIso8601Tests());
        addTestCase("Time format tests", \timeFormatTests());
        addTestCase("String-derived XSD type tests", \stringDerivedTypeTests());
        addTestCase("Data provider type mapping tests", \dataProviderTypeMappingTests());
        addTestCase("Pattern facet combination tests", \patternFacetCombinationTests());
        set_return_value(main());
    }

    globalSetUp() {
        ws = new WebService(ReadOnlyFile::readTextFile(XsdFacetsWsdl));
        xsdSchema = extractXsdFromWsdl(XsdFacetsWsdl);
    }

    #! Extract the XSD schema from a WSDL file as a standalone schema
    private string extractXsdFromWsdl(string wsdlPath) {
        string wsdlContent = ReadOnlyFile::readTextFile(wsdlPath);

        # Find the <s:schema> or <xsd:schema> element in the WSDL
        # Extract it using string operations for reliability
        int schemaStart = index(wsdlContent, "<s:schema");
        if (schemaStart == -1) {
            schemaStart = index(wsdlContent, "<xsd:schema");
        }
        if (schemaStart == -1) {
            throw "XSD-EXTRACT-ERROR", "No schema element found in WSDL";
        }

        int schemaEnd = index(wsdlContent, "</s:schema>");
        if (schemaEnd == -1) {
            schemaEnd = index(wsdlContent, "</xsd:schema>");
        }
        if (schemaEnd == -1) {
            throw "XSD-EXTRACT-ERROR", "No schema end tag found in WSDL";
        }
        schemaEnd += 11;  # Include the closing tag

        string schema = substr(wsdlContent, schemaStart, schemaEnd - schemaStart);

        # Convert s: prefix to xs: for standard compliance
        # Replace element names: <s:xxx -> <xs:xxx and </s:xxx -> </xs:xxx
        schema = regex_subst(schema, "<s:", "<xs:", Qore::RE_Global);
        schema = regex_subst(schema, "</s:", "</xs:", Qore::RE_Global);

        # Replace type references in attributes: base="s:xxx" -> base="xs:xxx"
        schema = regex_subst(schema, '="s:', '="xs:', Qore::RE_Global);

        # Replace tns: prefix references: type="tns:xxx" -> type="tns:xxx" (keep as-is)
        # No change needed for tns: prefix

        # Extract target namespace from the schema
        *list<auto> tnsMatch = regex_extract(schema, 'targetNamespace="([^"]+)"');
        string targetNs = tnsMatch ? tnsMatch[0] : "";

        # Add namespace declarations if not already present
        string nsDecls = "";
        if (index(schema, "xmlns:xs=") == -1) {
            nsDecls += ' xmlns:xs="http://www.w3.org/2001/XMLSchema"';
        }
        if (index(schema, "xmlns:tns=") == -1 && targetNs) {
            nsDecls += sprintf(' xmlns:tns="%s"', targetNs);
        }

        if (nsDecls) {
            schema = regex_subst(schema, "<xs:schema", "<xs:schema" + nsDecls);
        }

        # Add XML declaration
        return "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" + schema;
    }

    #! Extract the body element from a SOAP envelope and add namespace declarations
    private string extractSoapBody(string soapXml) {
        # Find the target namespace URI (xsdfa prefix)
        *list<auto> nsMatch = regex_extract(soapXml, 'xmlns:xsdfa="([^"]+)"');
        if (!nsMatch) {
            throw "SOAP-EXTRACT-ERROR", "No xsdfa namespace found in SOAP envelope";
        }
        string nsUri = nsMatch[0];

        # Extract the body content using string operations
        int bodyStart = index(soapXml, "<soapenv:Body>");
        if (bodyStart == -1) {
            bodyStart = index(soapXml, "<soap:Body>");
            if (bodyStart == -1) {
                throw "SOAP-EXTRACT-ERROR", "No SOAP Body element found";
            }
            bodyStart += 11;  # length of "<soap:Body>"
        } else {
            bodyStart += 14;  # length of "<soapenv:Body>"
        }

        int bodyEnd = index(soapXml, "</soapenv:Body>");
        if (bodyEnd == -1) {
            bodyEnd = index(soapXml, "</soap:Body>");
        }
        if (bodyEnd == -1) {
            throw "SOAP-EXTRACT-ERROR", "No SOAP Body end tag found";
        }

        string bodyContent = substr(soapXml, bodyStart, bodyEnd - bodyStart);

        # Add namespace declaration to the root element by inserting before first ">"
        string nsDecl = sprintf(' xmlns:xsdfa="%s"', nsUri);
        int firstTagEnd = index(bodyContent, ">");
        if (firstTagEnd > 0) {
            # Check if it's a self-closing tag
            if (bodyContent[firstTagEnd - 1] == "/") {
                bodyContent = substr(bodyContent, 0, firstTagEnd - 1) + nsDecl + "/>" +
                    substr(bodyContent, firstTagEnd + 1);
            } else {
                bodyContent = substr(bodyContent, 0, firstTagEnd) + nsDecl +
                    substr(bodyContent, firstTagEnd);
            }
        }

        # Add XML declaration
        return "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" + bodyContent;
    }

    #! Validate XML against XSD using libxml2 - returns True if valid, False if invalid
    private bool libxml2Validates(string xml, string xsd) {
        try {
            XmlDoc doc(xml);
            doc.validateSchema(xsd);
            return True;
        } catch (hash<ExceptionInfo> ex) {
            return False;
        }
    }

    #! Validate serialized SOAP body against libxml2 - returns True if valid
    private bool libxml2ValidatesSoap(string soapXml) {
        string bodyXml = extractSoapBody(soapXml);
        return libxml2Validates(bodyXml, xsdSchema);
    }

    #! Assert that serialized output passes libxml2 validation
    private assertLibxml2Accepts(hash<auto> serialized, string desc) {
        string bodyXml = extractSoapBody(serialized.body);
        XmlDoc doc(bodyXml);
        try {
            doc.validateSchema(xsdSchema);
        } catch (hash<ExceptionInfo> ex) {
            fail(sprintf("%s: libxml2 rejected: %s", desc, ex.desc));
        }
        # If we get here, validation passed - increment assertion count
        assertEq(True, True, desc);
    }

    #! Assert that manually constructed invalid XML fails libxml2 validation
    private assertLibxml2Rejects(string invalidXml, string desc) {
        XmlDoc doc(invalidXml);
        bool rejected = False;
        try {
            doc.validateSchema(xsdSchema);
        } catch (hash<ExceptionInfo> ex) {
            rejected = True;
        }
        assertTrue(rejected, desc);
    }

    # ============================================================
    # Pattern Facet Tests - Positive
    # ============================================================

    patternFacetPositiveTests() {
        WSOperation op = ws.getOperation("testFacets");

        # Test valid pattern: exactly 2 uppercase letters followed by 4 digits
        {
            hash<auto> req = {"patternStr": "AB1234"};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">AB1234<", h.body, "pattern serializes exact value AB1234");
        }

        # Test pattern at different valid values
        {
            hash<auto> req = {"patternStr": "ZZ9999"};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">ZZ9999<", h.body, "pattern serializes ZZ9999");
        }

        {
            hash<auto> req = {"patternStr": "AA0000"};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">AA0000<", h.body, "pattern serializes AA0000");
        }

        # issue #5411: sibling patterns are combined with "|", so matching either one is enough
        {
            hash<auto> req = {"multiPatternStr": "Hello123"};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">Hello123<", h.body, "multi-pattern serializes Hello123");
        }

        {
            hash<auto> req = {"multiPatternStr": "A1"};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">A1<", h.body, "multi-pattern serializes minimal A1");
        }

        {
            hash<auto> req = {"multiPatternStr": "Testing123456789"};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">Testing123456789<", h.body, "multi-pattern serializes longer string");
        }
    }

    # ============================================================
    # Pattern Facet Combination Tests (issue #5411)
    # ============================================================

    #! tests how multiple \c pattern facets are combined and how a single pattern is anchored
    /** XSD 1.0 part 2 4.3.4.3: sibling \c pattern facets declared in the same restriction are combined as if
        they appeared in a single regular expression separated by \c "|", so a value matching any one of them is
        valid.  Patterns declared in different derivation steps are intersected instead: the value must satisfy
        every step.
    */
    patternFacetCombinationTests() {
        WSOperation op = ws.getOperation("testFacets");

        code accepts = bool sub (string field, auto value) {
            try {
                op.serializeRequest({field: value});
                return True;
            } catch (hash<ExceptionInfo> ex) {
                assertEq("SOAP-SERIALIZATION-ERROR", ex.err, sprintf("%s %y: expected error type", field, value));
                return False;
            }
        };

        # sibling patterns "[A-Z].*" and ".*[0-9]" are united: matching either one is enough
        assertTrue(accepts("multiPatternStr", "Hello"), "sibling patterns: matches the 1st pattern only");
        assertTrue(accepts("multiPatternStr", "hello1"), "sibling patterns: matches the 2nd pattern only");
        assertTrue(accepts("multiPatternStr", "Hello1"), "sibling patterns: matches both patterns");
        assertFalse(accepts("multiPatternStr", "hello"), "sibling patterns: matches neither pattern");

        # patterns declared in different derivation steps are intersected: "DerivedPatternString" restricts
        # "DerivedPatternBase" ("[a-z]+") with ".{3}", so a value must satisfy both
        assertTrue(accepts("derivedPatternStr", "abc"), "derivation steps: satisfies both steps");
        assertFalse(accepts("derivedPatternStr", "ab"), "derivation steps: fails the restricting pattern");
        assertFalse(accepts("derivedPatternStr", "123"), "derivation steps: fails the base pattern");

        # a pattern with a top-level alternation must be anchored as a whole, so that partial matches at the
        # start or the end of the value are not accepted
        assertTrue(accepts("altPatternStr", "aaa"), "alternation: 1st branch");
        assertTrue(accepts("altPatternStr", "bbb"), "alternation: 2nd branch");
        assertFalse(accepts("altPatternStr", "aaaXXX"), "alternation: trailing text is not accepted");
        assertFalse(accepts("altPatternStr", "XXXbbb"), "alternation: leading text is not accepted");
        assertFalse(accepts("altPatternStr", "zzz"), "alternation: neither branch");

        # a type declaring one pattern per alternative form (16 IPv6 forms here) accepts every valid form
        assertTrue(accepts("ipv6Str", "$2001:0db8:0000:0000:0000:0000:0000:0001"), "IPv6: full 8-group form");
        assertTrue(accepts("ipv6Str", "$2001:db8::1"), "IPv6: compressed form");
        assertTrue(accepts("ipv6Str", "$::ffff:192.0.2.1"), "IPv6: IPv4-mapped form");
        assertFalse(accepts("ipv6Str", "not-an-address"), "IPv6: invalid value");

        # the same rules apply when deserializing
        hash<auto> h = op.serializeRequest({"multiPatternStr": "Hello"});
        assertEq("Hello", op.deserializeRequest(parse_xml(h.body)).multiPatternStr,
            "sibling patterns: deserializes a value matching one pattern");
    }

    # ============================================================
    # Pattern Facet Tests - Negative
    # ============================================================

    patternFacetNegativeTests() {
        WSOperation op = ws.getOperation("testFacets");

        # Invalid: lowercase letters instead of uppercase
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"patternStr": "ab1234"},
            "pattern rejects lowercase letters");

        # Invalid: wrong number of letters (3 instead of 2)
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"patternStr": "ABC1234"},
            "pattern rejects 3 letters");

        # Invalid: wrong number of digits (3 instead of 4)
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"patternStr": "AB123"},
            "pattern rejects 3 digits");

        # Invalid: special characters
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"patternStr": "AB12!4"},
            "pattern rejects special characters");

        # Invalid: empty string
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"patternStr": ""},
            "pattern rejects empty string");

        # issue #5411: "MultiPatternString" declares "[A-Z].*" and ".*[0-9]" in the same restriction, and
        # XSD 1.0 part 2 4.3.4.3 combines sibling patterns with "|"; a value is therefore only invalid if it
        # matches neither pattern
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"multiPatternStr": "hello"},
            "multi-pattern rejects a value matching neither pattern");

        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"multiPatternStr": "!!!"},
            "multi-pattern rejects punctuation matching neither pattern");

        # Invalid multi-pattern: empty
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"multiPatternStr": ""},
            "multi-pattern rejects empty string");
    }

    # ============================================================
    # Length Facet Tests - Positive
    # ============================================================

    lengthFacetPositiveTests() {
        WSOperation op = ws.getOperation("testFacets");

        # Test exact length (10 characters)
        {
            hash<auto> req = {"fixedLenStr": "0123456789"};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">0123456789<", h.body, "exact length 10 serializes correctly");
        }

        # Test minLength (>= 5) at boundary
        {
            hash<auto> req = {"minLenStr": "hello"};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">hello<", h.body, "minLength boundary (5) serializes correctly");
        }

        # Test minLength above boundary
        {
            hash<auto> req = {"minLenStr": "hello world"};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">hello world<", h.body, "minLength above boundary serializes correctly");
        }

        # Test maxLength (<= 20) at boundary
        {
            hash<auto> req = {"maxLenStr": "12345678901234567890"};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">12345678901234567890<", h.body, "maxLength boundary (20) serializes correctly");
        }

        # Test maxLength below boundary
        {
            hash<auto> req = {"maxLenStr": "short"};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">short<", h.body, "maxLength below boundary serializes correctly");
        }

        # Test bounded length (3-50) at boundaries
        {
            hash<auto> req = {"boundedStr": "abc"};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">abc<", h.body, "bounded length min boundary (3) serializes correctly");
        }
    }

    # ============================================================
    # Length Facet Tests - Negative
    # ============================================================

    lengthFacetNegativeTests() {
        WSOperation op = ws.getOperation("testFacets");

        # Too short for fixedLength (9 chars instead of 10)
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"fixedLenStr": "123456789"},
            "exact length rejects 9 chars");

        # Too long for fixedLength (11 chars instead of 10)
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"fixedLenStr": "12345678901"},
            "exact length rejects 11 chars");

        # Below minLength (4 chars, need 5)
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"minLenStr": "four"},
            "minLength rejects 4 chars");

        # Above maxLength (21 chars, max 20)
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"maxLenStr": "123456789012345678901"},
            "maxLength rejects 21 chars");

        # Below bounded min (2 chars, need 3)
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"boundedStr": "ab"},
            "bounded length rejects 2 chars");
    }

    # ============================================================
    # Length Facet Tests - Corner Cases
    # ============================================================

    lengthFacetCornerCases() {
        WSOperation op = ws.getOperation("testFacets");

        # Empty string for fixedLength (should fail)
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"fixedLenStr": ""},
            "exact length rejects empty string");

        # Empty string for minLength (should fail, need >= 5)
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"minLenStr": ""},
            "minLength rejects empty string");

        # Empty string for maxLength (should succeed, 0 <= 20)
        {
            hash<auto> req = {"maxLenStr": ""};
            hash<auto> h = op.serializeRequest(req);
            assertRegex("maxLenStr", h.body, "maxLength accepts empty string");
        }

        # Unicode characters (should count characters, not bytes)
        {
            hash<auto> req = {"fixedLenStr": "1234567890"};  # 10 ASCII chars
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">1234567890<", h.body, "length counts ASCII correctly");
        }

        # String with spaces
        {
            hash<auto> req = {"fixedLenStr": "  hello   "};  # 10 chars with spaces
            hash<auto> h = op.serializeRequest(req);
            assertRegex("fixedLenStr", h.body, "length counts spaces correctly");
        }
    }

    # ============================================================
    # Numeric Range Tests - Positive
    # ============================================================

    numericRangePositiveTests() {
        WSOperation op = ws.getOperation("testFacets");

        # minInclusive (>= 1)
        {
            hash<auto> req = {"positiveInt": 1};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">1<", h.body, "minInclusive accepts boundary value 1");
        }

        {
            hash<auto> req = {"positiveInt": 100};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">100<", h.body, "minInclusive accepts value above boundary");
        }

        # Percentage range (0-100 inclusive)
        {
            hash<auto> req = {"percentInt": 0};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">0<", h.body, "percentage accepts lower bound 0");
        }

        {
            hash<auto> req = {"percentInt": 100};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">100<", h.body, "percentage accepts upper bound 100");
        }

        {
            hash<auto> req = {"percentInt": 50};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">50<", h.body, "percentage accepts middle value 50");
        }

        # minExclusive (> 0)
        {
            hash<auto> req = {"strictPosDecimal": 0.001};
            hash<auto> h = op.serializeRequest(req);
            assertRegex("0.001", h.body, "minExclusive accepts value just above 0");
        }

        {
            hash<auto> req = {"strictPosDecimal": 1000000};
            hash<auto> h = op.serializeRequest(req);
            assertRegex("1000000", h.body, "minExclusive accepts large positive value");
        }

        # maxExclusive (< 1) with minInclusive (>= 0)
        {
            hash<auto> req = {"belowOneDecimal": 0};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">0<", h.body, "maxExclusive accepts minInclusive boundary 0");
        }

        {
            hash<auto> req = {"belowOneDecimal": 0.999};
            hash<auto> h = op.serializeRequest(req);
            assertRegex("0.999", h.body, "maxExclusive accepts value just below 1");
        }
    }

    # ============================================================
    # Numeric Range Tests - Negative
    # ============================================================

    numericRangeNegativeTests() {
        WSOperation op = ws.getOperation("testFacets");

        # Below minInclusive (0 < 1)
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"positiveInt": 0},
            "minInclusive rejects value below minimum");

        # Negative value for minInclusive
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"positiveInt": -5},
            "minInclusive rejects negative value");

        # Large negative value
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"positiveInt": -1000000},
            "minInclusive rejects large negative value");

        # Above maxInclusive (101 > 100)
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"percentInt": 101},
            "maxInclusive rejects value above maximum");

        # Below minInclusive for percentage (-1 < 0)
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"percentInt": -1},
            "percentage minInclusive rejects -1");

        # At minExclusive boundary (0 is not > 0)
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"strictPosDecimal": 0},
            "minExclusive rejects boundary value 0");

        # Negative value for minExclusive
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"strictPosDecimal": -0.001},
            "minExclusive rejects negative value");

        # At maxExclusive boundary (1 is not < 1)
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"belowOneDecimal": 1},
            "maxExclusive rejects boundary value 1");

        # Above maxExclusive
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"belowOneDecimal": 1.001},
            "maxExclusive rejects value above boundary");

        # Below minInclusive for belowOneDecimal
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"belowOneDecimal": -0.001},
            "belowOneDecimal minInclusive rejects negative");
    }

    # ============================================================
    # Numeric Range Tests - Boundary
    # ============================================================

    numericRangeBoundaryTests() {
        WSOperation op = ws.getOperation("testFacets");

        # Test exact boundary for minInclusive
        {
            hash<auto> req = {"positiveInt": 1};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">1<", h.body, "minInclusive exact boundary 1 accepted");
        }

        # Test one above boundary for minInclusive
        {
            hash<auto> req = {"positiveInt": 2};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">2<", h.body, "minInclusive one above boundary accepted");
        }

        # Test exact boundaries for percentage
        {
            hash<auto> req = {"percentInt": 0};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">0<", h.body, "percentage lower boundary 0 accepted");
        }

        {
            hash<auto> req = {"percentInt": 100};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">100<", h.body, "percentage upper boundary 100 accepted");
        }

        # Test very small value for minExclusive
        {
            hash<auto> req = {"strictPosDecimal": 0.0000001};
            hash<auto> h = op.serializeRequest(req);
            assertRegex("strictPosDecimal", h.body, "minExclusive accepts very small positive");
        }

        # Test value very close to maxExclusive
        {
            hash<auto> req = {"belowOneDecimal": 0.9999999};
            hash<auto> h = op.serializeRequest(req);
            assertRegex("belowOneDecimal", h.body, "maxExclusive accepts value very close to 1");
        }
    }

    # ============================================================
    # Precision Facet Tests - Positive
    # ============================================================

    precisionFacetPositiveTests() {
        WSOperation op = ws.getOperation("testFacets");

        # totalDigits (4) - various valid values
        {
            hash<auto> req = {"fourDigitNum": 1234};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">1234<", h.body, "totalDigits accepts 4 digit integer");
        }

        {
            hash<auto> req = {"fourDigitNum": 12.34};
            hash<auto> h = op.serializeRequest(req);
            assertRegex("12.34", h.body, "totalDigits accepts 4 total digits with decimal");
        }

        {
            hash<auto> req = {"fourDigitNum": 1.234};
            hash<auto> h = op.serializeRequest(req);
            assertRegex("1.234", h.body, "totalDigits accepts 1.234 (4 digits)");
        }

        {
            hash<auto> req = {"fourDigitNum": 1};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">1<", h.body, "totalDigits accepts single digit");
        }

        # fractionDigits (2)
        {
            hash<auto> req = {"twoDecimalPlaces": 123.45};
            hash<auto> h = op.serializeRequest(req);
            assertRegex("123.45", h.body, "fractionDigits accepts 2 decimal places");
        }

        {
            hash<auto> req = {"twoDecimalPlaces": 123.4};
            hash<auto> h = op.serializeRequest(req);
            assertRegex("123.4", h.body, "fractionDigits accepts 1 decimal place");
        }

        {
            hash<auto> req = {"twoDecimalPlaces": 123};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">123<", h.body, "fractionDigits accepts integer (0 decimals)");
        }

        # Currency amount (totalDigits=10, fractionDigits=2, minInclusive=0)
        {
            hash<auto> req = {"currencyAmount": 12345678.90n};
            hash<auto> h = op.serializeRequest(req);
            assertRegex("currencyAmount", h.body, "currency amount accepts valid value");
        }

        {
            hash<auto> req = {"currencyAmount": 0};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">0<", h.body, "currency amount accepts zero");
        }
    }

    # ============================================================
