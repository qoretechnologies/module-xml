            assertRegex(">2026<", h.body, "gYear serializes correctly");
        }

        # gYearMonth (YYYY-MM)
        {
            hash<auto> req = {"gYearMonth": "2026-01"};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">2026-01<", h.body, "gYearMonth serializes correctly");
        }

        # gMonthDay (--MM-DD)
        {
            hash<auto> req = {"gMonthDay": "--01-27"};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">--01-27<", h.body, "gMonthDay serializes correctly");
        }

        # gMonth (--MM)
        {
            hash<auto> req = {"gMonth": "--01"};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">--01<", h.body, "gMonth serializes correctly");
        }

        # gDay (---DD)
        {
            hash<auto> req = {"gDay": "---27"};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">---27<", h.body, "gDay serializes correctly");
        }

        # Historic year (negative)
        {
            hash<auto> req = {"gYear": "-0500"};
            hash<auto> h = op.serializeRequest(req);
            assertRegex(">-0500<", h.body, "gYear handles negative (historic) year");
        }
