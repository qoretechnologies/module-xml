            "duration rejects wrong order (day before month)");

        # Empty duration
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"duration": ""},
            "duration rejects empty string");

        # Just P with nothing
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"duration": "P"},
            "duration rejects bare P");

        # Invalid characters
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), {"duration": "P1X"},
            "duration rejects invalid designator X");
    }

    # ============================================================
    # Partial Date Tests - Positive
