#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%exec-class XsdFloatTest

class XsdFloatTest inherits QUnit::Test {
    constructor() : Test("Native XML Schema IEEE conversion", "1.0") {
        addTestCase("Complete lexical validation and XML whitespace", \lexical());
        addTestCase("Direct binary32 and binary64 rounding", \rounding());
        addTestCase("Signed zero, subnormals, infinity and NaN", \special());
        addTestCase("Native values retain their exact source precision", \native());
        addTestCase("Independent concurrent conversions", \concurrent());
        set_return_value(main());
    }

    lexical() {
        foreach bool wide in (False, True) {
            foreach auto value in ("", " \t\r\n", ".", "+", "-", "+.", "-.", "1tail", "1e", "1e+",
                    "1e-", "1e2e3", "1.2.3", "1 2", "1e2.0", "1\x00tail", "1\x00", "\x001", "1,2", "0x1p0",
                    "NaN-tail", "+NaN", "-NaN", "nan", "inf", "+INF", "++1", "--1", "1_0", "١", "１",
                    "\x0b1", "1\x0c", "1\u00a0", True, False, NULL, NOTHING, binary("1"), (1,), {"value": 1}) {
                assertThrows("XSD-FLOAT-LEXICAL-ERROR", \convert_xsd_float(), (value, wide));
            }
            foreach hash<auto> row in ({"text": "1.", "value": 1.0}, {"text": ".5", "value": 0.5},
                    {"text": "+001.25e+2", "value": 125.0}, {"text": "1.e-2", "value": wide ? 0.01 : 0.009999999776482582},
                    {"text": "\t -1.25 \r\n", "value": -1.25}, {"text": "0.000", "value": 0.0}) {
                assertEq(row.value, convert_xsd_float(row.text, wide));
                assertEq(row.value, convert_xsd_float(convert_encoding(row.text, "UTF-16LE"), wide));
            }
        }
        assertEq(1.0, convert_xsd_float("0" * 10000 + "1"));
        assertEq(0.0, convert_xsd_float("0e" + "9" * 10000));
        assertThrows("XSD-FLOAT-LEXICAL-ERROR", \convert_xsd_float(), ("1" + "0" * 10000 + "x",));
        assertEq(1.25, convert_xsd_float(" " * 10000 + "1.25" + "\t" * 10000));
    }

    rounding() {
        assertEq(16777216.0, convert_xsd_float("16777217"));
        assertEq(16777217.0, convert_xsd_float("16777217", True));
        assertEq(16777220.0, convert_xsd_float("16777219"));
        assertEq(1.0, convert_xsd_float("1.000000059604644775390625"));
        assertEq(1.0000001192092896, convert_xsd_float("1.00000005960464477539062500000000001"));
        assertEq(1.0, convert_xsd_float("1.00000005960464477539062499999999999"));
        assertEq(1.000000238418579, convert_xsd_float("1.000000178813934326171875"));
        assertEq(-1.0000001192092896, convert_xsd_float("-1.00000005960464477539062500000000001"));
        assertEq(1.0, convert_xsd_float("1.00000000000000011102230246251565404236316680908203125", True));
        assertEq(1.0000000000000002,
            convert_xsd_float("1.00000000000000011102230246251565404236316680908203125001", True));
        assertEq(1.0, convert_xsd_float("1.00000000000000011102230246251565404236316680908203124999", True));
        assertEq(0.10000000149011612, convert_xsd_float("0.1"));
    }

    special() {
        foreach bool wide in (False, True) {
            foreach string text in ("-0", "-0.0", "-0e+99999999999999999", "-1e-99999999999999999") {
                assertEq("-0", convert_xsd_float(text, wide).toStringRoundTrip());
            }
            foreach string text in ("0", "+0", "0e-99999999999999999", "1e-99999999999999999") {
                assertEq("0", convert_xsd_float(text, wide).toStringRoundTrip());
            }
            foreach string text in ("INF", "1e99999999999999999") {
                assertEq(@inf@, convert_xsd_float(text, wide));
            }
            foreach string text in ("-INF", "-1e99999999999999999") {
                assertEq(-@inf@, convert_xsd_float(text, wide));
            }
            float nan = convert_xsd_float(" \tNaN\r\n", wide);
            assertTrue(nan != nan);
            assertEq("NaN", nan.toStringRoundTrip());
        }
        assertEq(1.401298464324817e-45, convert_xsd_float("1.401298464324817070923729583289916131280e-45"));
        assertEq(5e-324, convert_xsd_float("4.940656458412465441765687928682213723650598026143247644255856825e-324", True));
        assertEq("-0", convert_xsd_float("-1e-50").toStringRoundTrip());
        assertEq(@inf@, convert_xsd_float("3.5e38"));
        assertEq(-@inf@, convert_xsd_float("-3.5e38"));
        assertEq(3.5e38, convert_xsd_float("3.5e38", True));
    }

    native() {
        assertEq(1.0, convert_xsd_float(1.000000059604644775390625));
        assertEq(1.0000001192092896, convert_xsd_float(number("1.00000005960464477539062500000000001")));
        assertEq(1.0, convert_xsd_float(number("1.00000005960464477539062499999999999")));
        assertEq(4611686018427387904.0, convert_xsd_float(4611686293305294848));
        assertEq(4611686568183201792.0, convert_xsd_float(4611686293305294849));
        assertEq(4611686018427387904.0, convert_xsd_float(4611686293305294847));
        assertEq(-4611686568183201792.0, convert_xsd_float(-4611686293305294849));
        foreach bool wide in (False, True) {
            foreach auto value in (1.25, 1.25n, 1) {
                assertEq(float(value), convert_xsd_float(value, wide));
            }
            foreach auto value in (@inf@, -@inf@, number(@inf@), number(-@inf@)) {
                assertEq(float(value), convert_xsd_float(value, wide));
            }
            foreach auto value in (@nan@, number(@nan@)) {
                float converted = convert_xsd_float(value, wide);
                assertTrue(converted != converted);
            }
            assertEq("-0", convert_xsd_float(-0.0, wide).toStringRoundTrip());
            assertEq("-0", convert_xsd_float(number("-0"), wide).toStringRoundTrip());
        }
    }

    concurrent() {
        Qore::Thread::Queue ready();
        Qore::Thread::Queue start();
        Qore::Thread::Queue results();
        Qore::Thread::ThreadPool workers(4, 4, 4);
        on_exit {
            for (int i = 0; i < 4; ++i) {
                start.push(True);
            }
            workers.stopWait();
        }
        for (int i = 0; i < 4; ++i) {
            workers.submit(sub() {
                try {
                    ready.push(True);
                    start.get(30s);
                    list<float> values();
                    for (int repeat = 0; repeat < 50; ++repeat) {
                        push values, convert_xsd_float("1.00000005960464477539062500000000001");
                        push values, convert_xsd_float("16777217", True);
                    }
                    results.push({"values": values});
                } catch (hash<ExceptionInfo> ex) {
                    results.push({"error": ex});
                }
            });
        }
        for (int i = 0; i < 4; ++i) {
            assertTrue(ready.get(30s));
        }
        for (int i = 0; i < 4; ++i) {
            start.push(True);
        }
        for (int i = 0; i < 4; ++i) {
            hash<auto> result = results.get(30s);
            assertFalse(exists result.error, result.error);
            list<float> values = result.values;
            assertEq(100, values.size());
            foreach float value in (values) {
                assertEq($# % 2 ? 16777217.0 : 1.0000001192092896, value);
            }
        }
    }
}
