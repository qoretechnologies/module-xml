#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class SoapProcessingPriorityTest

class SoapProcessingPriorityTest inherits QUnit::Test {
    constructor() : Test("SOAP mandatory header processing priority", "1.0") {
        addTestCase("Mandatory headers precede body faults for each version and node role", \priority());
        addTestCase("Invalid bodies still reject before known header callbacks", \callbacks());
        set_return_value(main());
    }
    private static string message(bool soap12, string body, bool mandatory = True, bool targeted = True) {
        string uri = soap12 ? SOAP_12_ENV : SOAP_11_ENV;
        string next = soap12 ? "http://www.w3.org/2003/05/soap-envelope/role/next"
            : "http://schemas.xmlsoap.org/soap/actor/next";
        return '<e:Envelope xmlns:e="'+uri+'"><e:Header><h:Track xmlns:h="urn:headers"/>'
            +'<h:Unknown xmlns:h="urn:headers" e:mustUnderstand="'+(mandatory ? "1" : "0")+'" e:'
            +(soap12 ? "role" : "actor")+'="'+(targeted ? next : "urn:other")+'"/></e:Header><e:Body>'
            +body+'</e:Body></e:Envelope>';
    }
    private static list<string> invalidBodies() {
        return ('<e:Fault/>','<e:Fault/><other xmlns="urn:application"/>','invalid body text');
    }
    private priority() {
        foreach bool ultimate in (False,True) {
            SoapProcessingNode original(<SoapNodeOptions>{"ultimate_receiver":ultimate});
            foreach SoapProcessingNode node in (original,Serializable::deserialize(original.serialize()),
                    Serializable::deserialize(original.serializeToData())) {
                foreach bool soap12 in (False,True) {
                    foreach string body in (invalidBodies()) {
                        string xml = message(soap12,body);
                        hash<auto> parsed = parse_xml(xml,XPF_PRESERVE_ORDER);
                        assertThrows("SOAP-DESERIALIZATION-ERROR",\WSDLLib::validateSOAPEnvelope(),(parsed,soap12));
                        assertEq(soap12,WSDLLib::validateSOAPEnvelope(parsed,soap12,False,True));
                        assertThrows("SOAP-MUST-UNDERSTAND",\node.processMessage(),(xml,));
                        assertThrows("SOAP-DESERIALIZATION-ERROR",\node.processMessage(),(message(soap12,body,False),));
                        assertThrows("SOAP-DESERIALIZATION-ERROR",\node.processMessage(),(message(soap12,body,True,False),));
                    }
                    hash<SoapNodeResult> result = node.processMessage(message(soap12,'<value xmlns="urn:application">ok</value>',False));
                    assertEq(ultimate,exists result.application_message);
                    assertEq(!ultimate,exists result.forward_message);
                }
            }
        }
    }
    private callbacks() {
        foreach bool soap12 in (False,True) {
            Queue processed();
            SoapProcessingNode node(<SoapNodeOptions>{"processors":{"{urn:headers}Track":
                auto sub(hash<auto> cx, hash<SoapNodeHeader> header) { processed.push(header.name); }}});
            foreach string body in (invalidBodies()) {
                assertThrows("SOAP-MUST-UNDERSTAND",\node.processMessage(),(message(soap12,body),));
                assertEq(0,processed.size());
                assertThrows("SOAP-DESERIALIZATION-ERROR",\node.processMessage(),(message(soap12,body,False),));
                assertEq(0,processed.size());
                hash<SoapNodeResult> result = node.processMessage(message(soap12,'<value xmlns="urn:application">ok</value>',False));
                assertTrue(result.headers[0].processed);
                assertEq("{urn:headers}Track",processed.get(1000));
                assertEq(0,processed.size());
            }
        }
    }
}
