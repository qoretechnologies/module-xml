<?xml version="1.0" encoding="UTF-8"?>
<!-- WSDL for testing attribute value serialization and "choice" complexType handling -->
<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:xs="http://www.w3.org/2001/XMLSchema"
             xmlns:tns="urn:qore:test:attr-choice"
             targetNamespace="urn:qore:test:attr-choice">
    <types>
        <xs:schema targetNamespace="urn:qore:test:attr-choice"
                   xmlns="urn:qore:test:attr-choice"
                   elementFormDefault="qualified" attributeFormDefault="unqualified">
            <xs:element name="Req">
                <xs:complexType>
                    <xs:sequence>
                        <!-- attribute values must be serialized according to their types -->
                        <xs:element name="stamped">
                            <xs:complexType>
                                <xs:sequence>
                                    <xs:element name="data" type="xs:string"/>
                                </xs:sequence>
                                <xs:attribute name="when" type="xs:dateTime" use="required"/>
                                <xs:attribute name="active" type="xs:boolean"/>
                                <xs:attribute name="raw" type="xs:base64Binary"/>
                            </xs:complexType>
                        </xs:element>

                        <xs:element name="flag" type="xs:boolean"/>

                        <!-- xs:int and xs:double had no data provider type mapping at all -->
                        <xs:element name="count" type="xs:int" minOccurs="0"/>
                        <xs:element name="ratio" type="xs:double" minOccurs="0"/>

                        <!-- an enumeration on a numeric base type -->
                        <xs:element name="code" type="codeType" minOccurs="0"/>

                        <!-- a complexType that is itself a choice -->
                        <xs:element name="required-choice">
                            <xs:complexType>
                                <xs:choice>
                                    <xs:element name="a" type="xs:string"/>
                                    <xs:element name="b" type="xs:string"/>
                                </xs:choice>
                            </xs:complexType>
                        </xs:element>

                        <!-- an optional choice: no member has to be supplied -->
                        <xs:element name="optional-choice">
                            <xs:complexType>
                                <xs:choice minOccurs="0">
                                    <xs:element name="c" type="xs:string"/>
                                    <xs:element name="d" type="xs:string"/>
                                </xs:choice>
                            </xs:complexType>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>

            <xs:simpleType name="codeType">
                <xs:restriction base="xs:unsignedByte">
                    <xs:enumeration value="1"/>
                    <xs:enumeration value="3"/>
                </xs:restriction>
            </xs:simpleType>

            <xs:element name="Resp">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="result" type="xs:string"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:schema>
    </types>

    <message name="ReqM">
        <part name="parameters" element="tns:Req"/>
    </message>
    <message name="RespM">
        <part name="parameters" element="tns:Resp"/>
    </message>

    <portType name="AttrChoicePort">
        <operation name="Op">
            <input message="tns:ReqM"/>
            <output message="tns:RespM"/>
        </operation>
    </portType>

    <binding name="AttrChoiceBinding" type="tns:AttrChoicePort">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <operation name="Op">
            <soap:operation soapAction="Op" style="document"/>
            <input>
                <soap:body use="literal"/>
            </input>
            <output>
                <soap:body use="literal"/>
            </output>
        </operation>
    </binding>

    <service name="AttrChoiceService">
        <port name="AttrChoicePort" binding="tns:AttrChoiceBinding">
            <soap:address location="http://localhost:8080/attr-choice"/>
        </port>
    </service>
</definitions>
