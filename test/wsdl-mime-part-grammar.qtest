#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires ../qlib/WSDL.qm
%requires ../qlib/SoapClient.qm
%requires ../qlib/SoapHandler.qm
%requires HttpServer
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "MIME grammar fixtures require json";
%else
%exec-class MimePartGrammarTest
class MimePartGrammarTest inherits QUnit::Test {
    constructor() : Test("MIME part grammar and nested SOAP headers", "1.0") {
        hash<auto> manifest = parse_json(ReadOnlyFile::readTextFile(get_script_dir()
            + "/wsdl-interop/regressions/wsdl-mime-part-grammar/cases.json"));
        foreach hash<auto> row in (manifest.cases) {
            addTestCase(row.name, \check(), (row,));
        }
        foreach hash<auto> row in (manifest.metadata_cases) {
            addTestCase(row.name, \contentAliases(), (row,));
        }
        set_return_value(main());
    }
    private static WebService parse(string source) {
        return new WebService(source, {"async_only":True});
    }
    private static WebService imported(string source) {
        return new WebService('<w:definitions xmlns:w="http://schemas.xmlsoap.org/wsdl/" targetNamespace="urn:root">'
            + '<w:import namespace="urn:mime-grammar" location="mime.wsdl"/></w:definitions>',
            {"async_only":True,"document_location":"https://example.invalid/root.wsdl",
                "xsd_cache":{"https://example.invalid/mime.wsdl":source}});
    }
    private check(hash<auto> row) {
        if (!row.valid) {
            assertThrows("WSDL-ERROR", \parse(), (row.xml,));
            assertThrows("WSDL-ERROR", \imported(), (row.xml,));
            return;
        }
        foreach WebService original in (parse(row.xml), imported(row.xml)) {
            foreach WebService ws in (original, Serializable::deserialize(original.serialize()),
                    Serializable::deserialize(original.serializeToData())) {
                WSOperation current = ws.getBindingOperation("B", "call");
                AbstractDataProviderType provider = ws.getMessage("M").getDataProviderType(True);
                assertEq({"body":"value"}, provider.acceptsValue({"body":"value"}));
                hash<auto> value = {"body":"payload", "H":{"token":"header value"}};
                foreach WSOperation op in (current, Serializable::deserialize(current.serialize())) {
                    foreach string direction in ("input","output") {
                        BindingMessageDescription description = op.getBinding("B"){direction};
                        assertEq("related", description.multipart);
                        assertEq(("body",), description.body.parts);
                        assertEq("urn:body-hint", description.body.ns);
                        assertEq("urn:format-hint", description.body.encodingStyle);
                        assertEq(1, description.getHeaders().size());
                        BindingMessageHeaderDescription header = description.getHeaders()[0];
                        assertEq("{urn:mime-grammar}H", header.msg.getExpandedName());
                        assertEq("token", header.part);
                        assertEq(row.headerfaults, header.getHeaderFaults().size());
                    }
                    string request = op.serializeRequest(value).body;
                    assertEq(value, op.deserializeRequest(parse_xml(request),"B",True));
                    string response = op.serializeResponse(value).body;
                    assertEq(value, op.deserializeResponse(parse_xml(response),"B",True));
                    hash<auto> sample = provider.getExampleValue();
                    sample.H = ws.getMessage("H").getDataProviderType(True).getExampleValue();
                    assertEq(sample, op.deserializeRequest(parse_xml(op.serializeRequest(sample).body),"B",True));
                    if (row.headerfaults) {
                        string fault = op.serializeHeaderFault(<SoapHeaderFaultInfo>{"message":"H","part":"token",
                            "value":"header failure"},"invalid session").body;
                        assertEq("header failure", op.deserializeHeaderFault(fault,"H","token","B",True,True));
                    }
                }
                HttpServer server();
                on_exit server.stop();
                SoapHandler handler(new PermissiveAuthenticator());
                server.setDefaultHandler("mime", handler);
                Queue received();
                code<auto(hash<auto>, auto)> callback = auto sub(hash<auto> cx, auto data) {
                    received.push(data);
                    return data;
                };
                handler.addMethod(ws,current,callback,NOTHING,NOTHING,NOTHING,NOTHING,NOTHING,NOTHING,"B");
                server.addListener(0);
                SoapClient client({"wsdl":ws,"service":"S","port":"Endpoint","timeout":30000,
                    "url":sprintf("http://127.0.0.1:%d/",server.getListenerInfo(0).port)});
                assertEq(value,client.callOperation("call",value));
                assertEq(value,received.get(30000));
            }
        }
    }

    private contentAliases(hash<auto> row) {
        foreach WebService original in (parse(row.xml), imported(row.xml)) {
            foreach WebService ws in (original, Serializable::deserialize(original.serialize()),
                    Serializable::deserialize(original.serializeToData())) {
                WSMessage message = ws.getMessage("M");
                assertNeq(message.pmap.first, message.pmap.second);
                assertNeq("first", message.pmap.first);
                assertNeq("second", message.pmap.second);
                hash<auto> example = message.getDataProviderType(True).getExampleValue();
                assertEq(3, example.size());
                assertTrue(example.hasKey("first"));
                assertTrue(example.hasKey("second"));
                WSOperation current = ws.getBindingOperation("B", "call");
                foreach WSOperation op in (current, Serializable::deserialize(current.serialize())) {
                    foreach string direction in ("input", "output") {
                        BindingMessageDescription description = op.getBinding("B"){direction};
                        assertEq(2, description.parts.size());
                        foreach string part in ("first", "second") {
                            assertEq(("application/octet-stream", "application/pdf"),
                                description.parts{message.pmap{part}});
                        }
                    }
                }
            }
        }
    }
}
%endif
