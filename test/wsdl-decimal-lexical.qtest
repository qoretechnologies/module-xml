#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class DecimalLexicalTest

class DecimalLexicalTest inherits QUnit::Test {
    const Invalid = ("", " ", ".", "+", "-", "+.", "-.", "1e2", "1E-2", "0x10", "0b1", "1tail",
        "1.2.3", "1 2", "--1", "+-1", "INF", "-INF", "NaN", "true", "١", "１２", "1\u00a0",
        "\x0b1", "1\x0c", "1\x00tail", NULL, NOTHING, True, False, binary("1"), (1, 2), {"child": "1"});
    const Exact = ("+001.2300", "-0.00", ".1", "1.", "+0", "001", "12345678901234567890.123456789",
        "+10000000999829292922093443563.32423442", "+100000000000000000000000000000000000000000000.00",
        "1.00000000000000000001", "0.123450000000000000000006");

    constructor() : Test("Exact XSD decimal lexical and provider values", "1.0") {
        addTestCase("Decimal lexical space", \lexical());
        addTestCase("Exact strings and compatible native floats", \precision());
        addTestCase("Native numeric round-trip spelling", \nativeValues());
        addTestCase("Provider precision, optionality and reconstruction", \providers());
        addTestCase("Attributes, ordered text, lists and unions", \schemas());
        set_return_value(main());
    }

    lexical() {
        Namespaces nsc({});
        XsdBaseType type = nsc.getBaseType("decimal");
        foreach auto value in (Invalid) {
            assertThrows("SOAP-SERIALIZATION-ERROR", \type.serializeValue(), (nsc, value, True));
            assertThrows("SOAP-DESERIALIZATION-ERROR", \type.deserializeValue(), ("value", {}, NOTHING, value));
        }
        foreach string value in ("0", "-0", "123.45", ".123", "123.", "+000.12300", " \t-001.23\r\n ") {
            string expected = XsdSimpleType::normalizeWhiteSpace(value, "collapse");
            assertEq(expected, type.serializeValue(nsc, value, True));
            auto decoded = type.deserializeValue("value", {}, NOTHING, value);
            assertEq(expected, type.serializeValue(nsc, decoded, True));
        }
    }

    precision() {
        Namespaces nsc({});
        XsdBaseType type = nsc.getBaseType("decimal");
        foreach string text in (Exact) {
            auto value = type.deserializeValue("value", {}, NOTHING, text);
            assertEq(NT_STRING, value.typeCode(), text);
            assertEq(text, value);
            assertEq(text, type.serializeValue(nsc, value, True));
        }
        foreach string text in ("0", "-0", "0.1", "123.45", "123", "1.2345678901234567") {
            auto value = type.deserializeValue("value", {}, NOTHING, text);
            assertEq(NT_FLOAT, value.typeCode(), "retain compatible float output for " + text);
            assertEq(text, type.serializeValue(nsc, value, True));
        }
        foreach string text in ("0." + strmul("0", 400) + "1", "1" + strmul("0", 400),
                "0." + strmul("1", 2000), strmul("9", 2000) + ".123456789") {
            auto value = type.deserializeValue("value", {}, NOTHING, text);
            assertEq(NT_STRING, value.typeCode());
            assertEq(text, value);
            assertEq(text, type.serializeValue(nsc, value, True));
        }
    }

    nativeValues() {
        Namespaces nsc({});
        XsdBaseType type = nsc.getBaseType("decimal");
        foreach auto value in (0, -1, 9223372036854775807, -9223372036854775807 - 1,
                0.0, -0.0, 123.45, 1e100, 5e-324, 1.7976931348623157e308,
                123.45n, 0.1n, number("1.00000000000000000001"), number("0.123450000000000000000006")) {
            string expected = value.typeCode() == NT_INT ? string(value) : value.toStringRoundTrip();
            assertEq(expected, type.serializeValue(nsc, value, True));
            auto decoded = type.deserializeValue("value", {}, NOTHING, value);
            assertEq(expected, type.serializeValue(nsc, decoded, True));
        }
        foreach auto value in (@nan@, @inf@, -@inf@, number(@nan@), number(@inf@), number(-@inf@)) {
            assertThrows("SOAP-SERIALIZATION-ERROR", \type.serializeValue(), (nsc, value, True));
            assertThrows("SOAP-DESERIALIZATION-ERROR", \type.deserializeValue(), ("value", {}, NOTHING, value));
        }
    }

    providers() {
        Namespaces nsc({});
        XsdBaseType scalar = nsc.getBaseType("decimal");
        AbstractDataProviderType original = scalar.getDataProviderType();
        foreach AbstractDataProviderType type in (original, Serializable::deserialize(original.serialize()),
                original.getOrNothingType().getMandatoryType()) {
            assertEq(NOTHING, type.getValueType());
            assertEq(NT_ALL, type.getBaseTypeCode());
            assertEq({"float": True, "string": True}, type.getReturnTypeHash());
            assertFalse(type.getAcceptTypeHash().hasKey("null"));
            assertTrue(type.isMandatory());
            assertThrows("MISSING-VALUE-ERROR", \type.acceptsValue(), (NOTHING,));
            foreach auto value in (Invalid) {
                if (exists value) {
                    assertThrows("RUNTIME-TYPE-ERROR", \type.acceptsValue(), (value,));
                }
            }
            foreach string text in (Exact) {
                assertEq(text, type.acceptsValue(text));
            }
            assertEq(123.45, type.acceptsValue("123.45"));
            assertEq("1.00000000000000000001", type.acceptsValue(number("1.00000000000000000001")));
            foreach auto value in (@nan@, @inf@, number(@nan@), number(-@inf@)) {
                assertThrows("RUNTIME-TYPE-ERROR", \type.acceptsValue(), (value,));
            }
            AbstractDataProviderType optional = Serializable::deserialize(type.getOrNothingType().serialize());
            assertFalse(optional.isMandatory());
            assertTrue(optional.getReturnTypeHash().nothing);
            assertEq(NOTHING, optional.acceptsValue(NOTHING));
            assertThrows("RUNTIME-TYPE-ERROR", \optional.acceptsValue(), (NULL,));
            ListDataType list_type("amounts", type);
            assertEq((123.45, Exact[0], Exact[-1]), list_type.acceptsValue(("123.45", Exact[0], Exact[-1])));
            assertThrows("RUNTIME-TYPE-ERROR", \list_type.acceptsValue(), (("123.45", "1e2"),));
        }
    }

    schemas() {
        XsdSchema original('<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:decimal"
            targetNamespace="urn:decimal">
            <xs:complexType name="Record"><xs:simpleContent><xs:extension base="xs:decimal">
                <xs:attribute name="amount" type="xs:decimal" use="required"/>
            </xs:extension></xs:simpleContent></xs:complexType>
            <xs:simpleType name="Amounts"><xs:list itemType="xs:decimal"/></xs:simpleType>
            <xs:simpleType name="Value"><xs:union memberTypes="xs:decimal xs:boolean"/></xs:simpleType>
            </xs:schema>', {"async_only": True});
        foreach XsdSchema schema in (original, Serializable::deserialize(original.serialize())) {
            XsdAbstractType record = schema.findType(make_qname("urn:decimal", "Record"));
            hash<auto> input = {"^value^": Exact[0], "^attributes^": {"amount": Exact[-1]}};
            auto value = record.deserializeValue("record", schema.getTypeMap(), NOTHING, input);
            assertEq(input, value);
            assertEq(input, record.serializeValue(new Namespaces({}), value, True));
            hash<auto> fragments = {"^value^": "+001.", "^cdata^": "2300", "^attributes^": {"amount": Exact[-1]}};
            assertEq(input, record.deserializeValue("record", schema.getTypeMap(), NOTHING, fragments));
            assertThrows("SOAP-DESERIALIZATION-ERROR", \record.deserializeValue(),
                ("record", schema.getTypeMap(), NOTHING, {"^value^": "1", "^attributes^": {"amount": "1e2"}}));
            XsdAbstractType amounts = schema.findType(make_qname("urn:decimal", "Amounts"));
            list<auto> expected = (123.45, Exact[0], Exact[-1]);
            string lexical = "123.45 " + Exact[0] + " " + Exact[-1];
            assertEq(expected, amounts.deserializeValue("amounts", schema.getTypeMap(), NOTHING, lexical));
            assertEq(lexical, amounts.serializeValue(new Namespaces({}), expected, True));
            assertThrows("SOAP-DESERIALIZATION-ERROR", \amounts.deserializeValue(),
                ("amounts", schema.getTypeMap(), NOTHING, "1 2e3"));
            XsdAbstractType choice = schema.findType(make_qname("urn:decimal", "Value"));
            assertEq(Exact[-1], choice.deserializeValue("choice", schema.getTypeMap(), NOTHING, Exact[-1]));
            assertEq(False, choice.deserializeValue("choice", schema.getTypeMap(), NOTHING, "false"));
            assertThrows("SOAP-DESERIALIZATION-ERROR", \choice.deserializeValue(),
                ("choice", schema.getTypeMap(), NOTHING, "1e3"));
        }
    }
}
