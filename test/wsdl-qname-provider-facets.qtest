#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires ../qlib/WSDL.qm
%exec-class QNameProviderHardeningTest

class QNameProviderHardeningTest inherits QUnit::Test {
    constructor() : Test("QName provider metadata and finite choices", "1.0") {
        addTestCase("Field choices compare expanded names and update atomically", \fields());
        addTestCase("Repeated choices and defaults preserve exact QName values", \repeated());
        addTestCase("Patterns constrain aliases independently of finite choices", \patterns());
        addTestCase("Reconstructed fields rebuild finite-choice indexes", \fieldMetadata());
        addTestCase("Malformed and cyclic reconstructed providers fail safely", \metadata());
        addTestCase("Deep inherited providers retain choices without recursive conversion", \deep());
        addTestCase("Explicit scoped inputs keep no-namespace identity across conversions", \scopedLocal());
        set_return_value(main());
    }

    private fields() {
        XsdQNameDataField original({"name": "catalog", "type": new XsdQNameDataType({"p": "urn:catalog"}),
            "allowed_values": ("p:Name",)});
        foreach XsdQNameDataField field in (original, Serializable::deserialize(original.serialize())) {
            XsdQNameValue alias("urn:catalog", "a:Name");
            assertTrue(field.acceptsValue(alias).equals(alias));
            assertTrue(field.acceptsValue("p:Name").equals(alias));
            foreach XsdQNameValue invalid in (new XsdQNameValue("urn:other", "p:Name"),
                    new XsdQNameValue("urn:catalog", "p:Other"), new XsdQNameValue("", "Name")) {
                assertThrows("FIELD-VALUE-ERROR", \field.acceptsValue(), (invalid,));
            }
            assertThrows("XSD-SIMPLETYPE-ERROR", \field.setAllowedValues(), ((alias, "missing:Name"), False));
            assertEq("p:Name", field.getAllowedValues()[0].value);
            assertTrue(field.acceptsValue(alias).equals(alias));
            field.setAllowedValues((new XsdQNameValue("urn:other", "o:Name"),), True);
            assertTrue(field.acceptsValue(alias).equals(alias));
            assertThrows("RUNTIME-TYPE-ERROR", \field.acceptsValue(), ("bad:name:again",));
        }
    }

    private repeated() {
        XsdQNameValue alias("urn:catalog", "a:Name");
        XsdQNameDataType type({"p": "urn:catalog"});
        XsdQNameDataField original({"name": "catalogs", "type": new ListDataType(type),
            "element_allowed_values": ("p:Name",)});
        foreach XsdQNameDataField field in (original, Serializable::deserialize(original.serialize())) {
            list<auto> values = field.acceptsValue((alias, "p:Name"));
            assertEq(2, values.size());
            foreach XsdQNameValue value in (values) {
                assertTrue(value.equals(alias));
            }
            XsdQNameValue other("urn:other", "p:Name");
            assertThrows("FIELD-VALUE-ERROR", \field.acceptsValue(), ((alias, other),));
            assertThrows("XSD-SIMPLETYPE-ERROR", \field.setElementAllowedValues(), ((alias, "missing:Name"), False));
            assertEq("p:Name", field.getElementAllowedValues()[0].value);
            field.setElementAllowedValues((alias,), True);
            assertTrue(field.acceptsValue((other,))[0].equals(other));
        }
        XsdQNameDataField optional({"name": "catalog", "type": type.getOrNothingType(),
            "default_value": alias, "allowed_values": ("p:Name",)});
        foreach XsdQNameDataField field in (optional, Serializable::deserialize(optional.serialize())) {
            assertTrue(field.acceptsValue(NOTHING).equals(alias));
        }
    }

    private patterns() {
        XsdQNameValue declared("urn:catalog", "p:Name");
        XsdQNameRestrictionDataType type(<XsdQNameFacetInfo>{"name": "Catalog", "patterns": ("^a:Name$",),
            "enumeration": (declared,)}, new XsdQNameDataType());
        XsdQNameDataField original({"name": "catalog", "type": type, "allowed_values": (declared,)});
        foreach XsdQNameDataField field in (original, Serializable::deserialize(original.serialize())) {
            XsdQNameValue alias("urn:catalog", "a:Name");
            assertTrue(field.acceptsValue(alias).equals(alias));
            assertThrows("RUNTIME-TYPE-ERROR", \field.acceptsValue(), (declared,));
            field.setAllowedValues((declared,), True);
            assertThrows("RUNTIME-TYPE-ERROR", \field.acceptsValue(), (declared,));
            assertThrows("RUNTIME-TYPE-ERROR", \field.acceptsValue(), (new XsdQNameValue("urn:other", "a:Name"),));
        }
    }

    private metadata() {
        XsdQNameRestrictionDataType original(<XsdQNameFacetInfo>{"name": "Base"}, new XsdQNameDataType());
        XsdQNameRestrictionDataType derived(<XsdQNameFacetInfo>{"name": "Derived"}, original);
        foreach XsdQNameRestrictionDataType source in (original, derived) {
            hash<SerializationInfo> state = source.serializeToData();
            string target = source === original ? "0"
                : state._index."0"._class_data."WSDL::XsdQNameRestrictionDataType".base._index;
            state._index{target}._class_data."WSDL::XsdQNameRestrictionDataType".base = {"_index": "0"};
            assertThrows("DESERIALIZATION-ERROR", \Serializable::deserialize(), (state,));
            assertEq("Name", Serializable::deserialize(source.serialize()).acceptsValue("Name"));
        }
        foreach hash<auto> invalid in ({"base": NOTHING}, {"facets": NOTHING}, {"facets": {}},
                {"facets": {"name": "Bad", "patterns": ()}},
                {"facets": {"name": "Bad", "enumeration": ()}},
                {"facets": {"name": "Bad", "patterns": ("[",)}}) {
            hash<SerializationInfo> state = original.serializeToData();
            state._index."0"._class_data."WSDL::XsdQNameRestrictionDataType" += invalid;
            assertThrows("DESERIALIZATION-ERROR", \Serializable::deserialize(), (state,), sprintf("%Y", invalid));
        }
    }

    private fieldMetadata() {
        XsdQNameValue value("urn:catalog", "p:Name");
        XsdQNameDataField original({"name": "catalog", "type": new XsdQNameDataType(),
            "allowed_values": (value,)});
        hash<SerializationInfo> state = original.serializeToData();
        string index = state._index."0"._class_data."DataProvider::AbstractDataField".allowed_values_map._index;
        assertTrue(exists index);
        state._index{index}._members = {};
        XsdQNameDataField field = Serializable::deserialize(state);
        assertTrue(field.acceptsValue(value).equals(value));
        assertThrows("FIELD-VALUE-ERROR", \field.acceptsValue(), (new XsdQNameValue("urn:other", "p:Name"),));
    }

    private deep() {
        XsdQNameValue name("urn:catalog", "p:Name");
        XsdQNameDataType provider = new XsdQNameRestrictionDataType(<XsdQNameFacetInfo>{"name": "Only",
            "enumeration": (name,)}, new XsdQNameDataType());
        for (int index = 0; index < 600; ++index) {
            provider = new XsdQNameRestrictionDataType(<XsdQNameFacetInfo>{"name": "Level" + index}, provider);
        }
        foreach XsdQNameDataType candidate in (provider, Serializable::deserialize(provider.serialize())) {
            assertTrue(candidate.acceptsValue(name).equals(name));
            assertTrue(candidate.getOrNothingType().getMandatoryType().acceptsValue(name).equals(name));
            assertThrows("RUNTIME-TYPE-ERROR", \candidate.acceptsValue(), (new XsdQNameValue("urn:other", "p:Name"),));
        }
    }

    private scopedLocal() {
        XsdQNameDataType base({"": "urn:other"});
        XsdQNameRestrictionDataType restriction(<XsdQNameFacetInfo>{"name": "Local",
            "enumeration": (new XsdQNameValue("", "Name"),)}, base);
        foreach XsdQNameDataType original in (base, restriction) {
            foreach XsdQNameDataType provider in (original, Serializable::deserialize(original.serialize()),
                    original.getOrNothingType().getMandatoryType()) {
                XsdScopedLexicalValue lexical("Name", {"": ""});
                auto value = provider.acceptsValue(lexical);
                assertTrue(value instanceof XsdQNameValue);
                assertEq("", value.getNamespaceUri());
                assertTrue(provider.acceptsValue(value).equals(value));
                assertTrue(new XsdQNameDataType({"": "urn:third"}).acceptsValue(value).equals(value));
            }
        }
    }
}
