#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class NotationValuesTest

class NotationValuesTest inherits QUnit::Test {
    constructor() : Test("Schema NOTATION values and providers", "1.0") {
        addTestCase("Notation carriers preserve a distinct immutable primitive identity", \values());
        addTestCase("Detached providers require declared names and preserve lexical scope", \providers());
        addTestCase("Restriction chains preserve enumeration identity and lexical patterns", \restrictions());
        addTestCase("Finite choices survive attribute wrappers and reconstruction", \fields());
        addTestCase("Atomic list union and record conversion preserves declared notation values", \conversion());
        addTestCase("NOTATION enumeration is enforced at schema component uses", \typeUses());
        addTestCase("Corrupt saved metadata rejects without affecting usable providers", \metadata());
        addTestCase("Deep schema and provider ancestry remains iterative", \deep());
        addTestCase("Generic identity wrappers retain the receiving named type map", \dynamic());
        addTestCase("Cancellation leaves provider scopes reusable", \cancellation());
        addTestCase("Concurrent detached providers keep namespace contexts independent", \concurrency());
        addTestCase("Provider examples are declared values checked against all restrictions", \examples());
        set_return_value(main());
    }

    private XsdNotationValue makeValue(string uri, string lexical) {
        return new XsdNotationValue(uri, lexical);
    }

    private XsdNotationRestrictionDataType makeRestriction(hash<XsdNotationFacetInfo> facets, XsdNotationDataType base) {
        return new XsdNotationRestrictionDataType(facets, base);
    }

    private XsdSchema makeSchema(string source) {
        return new XsdSchema(source);
    }

    private string prefix() {
        return '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:media" targetNamespace="urn:media">'
            '<xs:notation name="jpeg" public="image/jpeg"/><xs:notation name="png" system="image/png"/>'
            '<xs:simpleType name="Format"><xs:restriction base="xs:NOTATION"><xs:enumeration value="t:jpeg"/>'
            '<xs:enumeration value="t:png"/></xs:restriction></xs:simpleType>';
    }

    private XsdNotationRegistry registry() {
        XsdSchema schema(prefix() + '</xs:schema>');
        return schema.nsc.getNotationRegistry();
    }

    private checkValue(auto value, string local = "jpeg", string uri = "urn:media") {
        assertTrue(value instanceof XsdNotationValue);
        assertEq(uri, value.getNamespaceUri());
        assertEq(local, value.getLocalName());
    }

    private values() {
        XsdNotationValue original("urn:media", " a:jpeg ");
        XsdQNameDataType qname();
        foreach XsdNotationValue value in (original, Serializable::deserialize(original.serialize())) {
            checkValue(value);
            assertEq("a", value.getPrefix());
            assertEq("a:jpeg", value.getLexicalValue());
            assertTrue(value.equals(new XsdNotationValue("urn:media", "alias:jpeg")));
            assertFalse(value.equals(new XsdNotationValue("urn:other", "a:jpeg")));
            assertFalse(value instanceof XsdQNameValue);
            assertTrue(value.asQName().equals(new XsdQNameValue("urn:media", "a:jpeg")));
            assertThrows("RUNTIME-TYPE-ERROR", \qname.acceptsValue(), (value,));
        }
        foreach string bad in ("", "0jpeg", "a:b:c", "a:", ":jpeg", "two names") {
            assertThrows("XSD-NOTATION-VALUE-ERROR", \makeValue(), ("urn:media", bad));
        }
        assertThrows("XSD-NOTATION-VALUE-ERROR", \makeValue(), ("urn:wrong", "xml:lang"));
        assertThrows("XSD-NOTATION-VALUE-ERROR", \makeValue(), ("", "a:jpeg"));
        checkValue(new XsdNotationValue("", "jpeg"), "jpeg", "");
    }

    private providers() {
        XsdNotationDataType original(registry(), {"t": "urn:media"});
        foreach XsdNotationDataType provider in (original, Serializable::deserialize(original.serialize()),
                original.getOrNothingType().getMandatoryType()) {
            assertEq("NOTATION", provider.getBuiltinName());
            assertNothing(provider.getValueType());
            assertEq({}, provider.getDirectTypeHash());
            assertEq({"object": True}, provider.getReturnTypeHash());
            checkValue(provider.acceptsValue(" t:jpeg "));
            checkValue(provider.acceptsValue(new XsdQNameValue("urn:media", "a:jpeg")));
            checkValue(provider.acceptsValue(new XsdScopedLexicalValue("a:png", {"a": "urn:media"})), "png");
            checkValue(provider.withNamespaceBindings({"": "urn:media"}).acceptsValue("jpeg"));
            assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), ("jpeg",));
            assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), ("missing:jpeg",));
            assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), ("t:undeclared",));
            assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (new XsdNotationValue("urn:other", "t:jpeg"),));
            assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (new XsdScopedLexicalValue("t:jpeg", {"t": "urn:wrong"}),));
            assertThrows("MISSING-VALUE-ERROR", \provider.acceptsValue(), (NOTHING,));
            assertNothing(provider.getOrNothingType().acceptsValue(NOTHING));
            checkValue(provider.acceptsValue("t:jpeg"));
        }
        assertThrows("XSD-SIMPLETYPE-ERROR", \original.withNamespaceBindings(), ({"xml": "urn:wrong"},));
        XsdSchema local('<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"><xs:notation name="jpeg" public="image/jpeg"/>'
            '<xs:simpleType name="Format"><xs:restriction base="xs:NOTATION"><xs:enumeration value="jpeg"/>'
            '</xs:restriction></xs:simpleType><xs:element name="value" type="Format"/></xs:schema>');
        XsdNotationDataType local_type = cast<XsdNotationDataType>(local.getElement("", "value").getDataProviderType());
        foreach XsdNotationDataType provider in (local_type, Serializable::deserialize(local_type.serialize())) {
            checkValue(provider.acceptsValue("jpeg"), "jpeg", "");
            XsdNotationValue value = provider.acceptsValue("jpeg");
            checkValue(provider.withNamespaceBindings({"": "urn:other"}).acceptsValue(value), "jpeg", "");
            string xml = local.serializeXmlValue("", "value", value).getXml();
            assertEq(parse_xml(xml), parse_xml_with_schema(xml, '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">'
                '<xs:notation name="jpeg" public="image/jpeg"/><xs:simpleType name="Format"><xs:restriction base="xs:NOTATION">'
                '<xs:enumeration value="jpeg"/></xs:restriction></xs:simpleType><xs:element name="value" type="Format"/></xs:schema>'));
        }
    }

    private restrictions() {
        XsdNotationValue jpeg("urn:media", "t:jpeg");
        XsdNotationDataType base(registry(), {"t": "urn:media"});
        XsdNotationRestrictionDataType enumeration(<XsdNotationFacetInfo>{"name": "JPEG", "enumeration": (jpeg,)}, base);
        XsdNotationRestrictionDataType pattern(<XsdNotationFacetInfo>{"name": "Pattern", "patterns": ("^a:jpeg$",)}, enumeration);
        foreach XsdNotationDataType provider in (pattern, Serializable::deserialize(pattern.serialize())) {
            checkValue(provider.acceptsValue(new XsdNotationValue("urn:media", "a:jpeg")));
            assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (jpeg,));
            assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (new XsdNotationValue("urn:media", "a:png"),));
            assertNothing(provider.getOrNothingType().acceptsValue(NOTHING));
        }
        assertThrows("XSD-SIMPLETYPE-ERROR", \makeRestriction(),
            (<XsdNotationFacetInfo>{"name": "Invalid", "enumeration": (new XsdNotationValue("urn:other", "a:jpeg"),)}, base));
        assertThrows("XSD-SIMPLETYPE-ERROR", \makeRestriction(),
            (<XsdNotationFacetInfo>{"name": "Invalid", "patterns": ("[",)}, base));
    }

    private fields() {
        XsdNotationDataType base(registry(), {"t": "urn:media"});
        foreach AbstractDataProviderType type in (base, new XsdAttributeDataType(base, True)) {
            XsdNotationDataField original({"name": "format", "type": type, "allowed_values": ("t:jpeg",)});
            foreach XsdNotationDataField field in (original, Serializable::deserialize(original.serialize())) {
                assertEq("t:jpeg", field.getAllowedValues()[0].display_name);
                checkValue(field.acceptsValue(new XsdNotationValue("urn:media", "a:jpeg")));
                assertThrows("FIELD-VALUE-ERROR", \field.acceptsValue(), ("t:png",));
                assertThrows("RUNTIME-TYPE-ERROR", \field.acceptsValue(), ("t:undeclared",));
                assertThrows("XSD-SIMPLETYPE-ERROR", \field.setAllowedValues(), (("t:jpeg", "t:undeclared"), False));
                checkValue(field.acceptsValue("t:jpeg"));
            }
        }
        XsdNotationDataField repeated({"name": "formats", "type": new ListDataType(base),
            "element_allowed_values": ("t:jpeg",)});
        foreach XsdNotationDataField field in (repeated, Serializable::deserialize(repeated.serialize())) {
            list<auto> accepted = field.acceptsValue(("t:jpeg", new XsdNotationValue("urn:media", "a:jpeg")));
            checkValue(accepted[0]);
            checkValue(accepted[1]);
            assertThrows("FIELD-VALUE-ERROR", \field.acceptsValue(), (("t:png",),));
        }
    }

    private conversion() {
        foreach string variety in ("atomic", "list", "union", "record") {
            string declaration = variety == "atomic" ? "" : variety == "list"
                ? '<xs:simpleType name="Selected"><xs:list itemType="t:Format"/></xs:simpleType>'
                : variety == "union" ? '<xs:simpleType name="Selected"><xs:union memberTypes="t:Format xs:QName"/></xs:simpleType>'
                : '<xs:complexType name="Selected"><xs:sequence><xs:element name="format" type="t:Format" maxOccurs="2"/>'
                    '</xs:sequence><xs:attribute name="format" type="t:Format" use="required"/></xs:complexType>';
            string source = prefix() + declaration + '<xs:element name="value" type="t:'
                + (variety == "atomic" ? "Format" : "Selected") + '"/></xs:schema>';
            XsdSchema original(source);
            string content = variety == "record" ? '<format>a:jpeg</format><format>a:png</format>'
                : variety == "list" ? "a:jpeg a:png" : "a:jpeg";
            string xml = '<t:value xmlns:t="urn:media" xmlns:a="urn:media"'
                + (variety == "record" ? ' format="a:jpeg"' : "") + '>' + content + '</t:value>';
            foreach XsdSchema schema in (original, Serializable::deserialize(original.serialize())) {
                foreach bool preserve in (False, True) {
                    auto wire = XsdBase::expandElementNamespaces(parse_xml(xml, XPF_PRESERVE_ORDER));
                    auto value = schema.getElement("urn:media", "value").deserializeValue(schema.getTypeMap(), NOTHING,
                        wire."{urn:media}value", True, preserve);
                    auto atomic = value;
                    if (atomic.typeCode() == NT_HASH && atomic.hasKey("^val^")) {
                        atomic = atomic."^val^";
                    }
                    if (variety == "record") {
                        checkValue(atomic."^attributes^".format);
                        atomic = atomic.format;
                    }
                    if (atomic.typeCode() == NT_LIST) {
                        checkValue(atomic[1], "png");
                        atomic = atomic[0];
                    }
                    checkValue(atomic);
                    AbstractDataProviderType initial = preserve ? schema.getNativeDataProviderType("urn:media", "value")
                        : schema.getElement("urn:media", "value").getDataProviderType();
                    foreach AbstractDataProviderType provider in (initial, Serializable::deserialize(initial.serialize())) {
                        auto converted = provider.acceptsValue(value);
                        string output = schema.serializeXmlValue("urn:media", "value", converted).getXml();
                        assertEq(parse_xml(output), parse_xml_with_schema(output, source));
                    }
                }
            }
        }
    }

    private typeUses() {
        foreach string invalid in ('<xs:element name="value" type="xs:NOTATION"/>',
                '<xs:attribute name="format" type="xs:NOTATION"/>',
                '<xs:simpleType name="Bad"><xs:list itemType="xs:NOTATION"/></xs:simpleType>',
                '<xs:simpleType name="Bad"><xs:union memberTypes="xs:string xs:NOTATION"/></xs:simpleType>',
                '<xs:complexType name="Bad"><xs:simpleContent><xs:extension base="xs:NOTATION"/></xs:simpleContent>'
                    '</xs:complexType><xs:element name="value" type="t:Bad"/>') {
            assertThrows("WSDL-ERROR", \makeSchema(), (prefix() + invalid + '</xs:schema>',));
        }
        XsdSchema schema(prefix() + '<xs:simpleType name="Intermediate"><xs:restriction base="xs:NOTATION"/>'
            '</xs:simpleType><xs:element name="value" type="t:Format"/></xs:schema>');
        checkValue(schema.getElement("urn:media", "value").getDataProviderType().acceptsValue(new XsdNotationValue("urn:media", "t:jpeg")));
        assertThrows("XSD-SIMPLETYPE-ERROR", \makeSchema(), (prefix()
            + '<xs:simpleType name="Bad"><xs:restriction base="xs:NOTATION"><xs:enumeration value="t:unknown"/>'
            '</xs:restriction></xs:simpleType></xs:schema>',));
    }

    private metadata() {
        XsdNotationDataType base(registry(), {"t": "urn:media"});
        XsdNotationRestrictionDataType original(<XsdNotationFacetInfo>{"name": "JPEG",
            "enumeration": (new XsdNotationValue("urn:media", "t:jpeg"),)}, base);
        foreach hash<auto> invalid in ({"base": NOTHING}, {"facets": NOTHING}, {"facets": {}},
                {"facets": {"name": "Bad", "patterns": ()}}, {"facets": {"name": "Bad", "enumeration": ()}},
                {"facets": {"name": "Bad", "patterns": ("[",)}}) {
            hash<SerializationInfo> state = original.serializeToData();
            state._index."0"._class_data."WSDL::XsdNotationRestrictionDataType" += invalid;
            assertThrows("DESERIALIZATION-ERROR", \Serializable::deserialize(), (state,));
        }
        hash<SerializationInfo> state = original.serializeToData();
        state._index."0"._class_data."WSDL::XsdNotationRestrictionDataType".base = {"_index": "0"};
        assertThrows("DESERIALIZATION-ERROR", \Serializable::deserialize(), (state,));
        foreach hash<auto> invalid in ({"declarations": NOTHING}, {"optional": "false"}, {"namespaces": ("bad",)}) {
            state = base.serializeToData();
            state._index."0"._class_data."WSDL::XsdNotationDataType" += invalid;
            assertThrows("DESERIALIZATION-ERROR", \Serializable::deserialize(), (state,));
        }
        XsdNotationValue value("urn:media", "t:jpeg");
        state = value.serializeToData();
        state._index."0"._class_data."WSDL::XsdNotationValue".expanded = "t:jpeg";
        assertThrows("DESERIALIZATION-ERROR", \Serializable::deserialize(), (state,));
        checkValue(Serializable::deserialize(original.serialize()).acceptsValue(value));
    }

    private deep() {
        XsdNotationValue value("urn:media", "t:jpeg");
        XsdNotationDataType provider = new XsdNotationRestrictionDataType(<XsdNotationFacetInfo>{"name": "JPEG",
            "enumeration": (value,)}, new XsdNotationDataType(registry()));
        string source = prefix();
        for (int index = 0; index < 300; ++index) {
            provider = new XsdNotationRestrictionDataType(<XsdNotationFacetInfo>{"name": "Level" + index}, provider);
            source += sprintf('<xs:simpleType name="Level%d"><xs:restriction base="t:%s"/></xs:simpleType>',
                index, index ? "Level" + (index - 1) : "Format");
        }
        source += '<xs:element name="value" type="t:Level299"/></xs:schema>';
        XsdSchema schema(source);
        foreach XsdNotationDataType current in (provider, Serializable::deserialize(provider.serialize()),
                schema.getElement("urn:media", "value").getDataProviderType()) {
            checkValue(current.acceptsValue(value));
            assertThrows("RUNTIME-TYPE-ERROR", \current.acceptsValue(), (new XsdNotationValue("urn:wrong", "t:jpeg"),));
        }
    }
    private dynamic() {
        foreach string primitive in ("QName", "NOTATION") {
            string source = prefix() + '<xs:simpleType name="Selected"><xs:restriction base="xs:' + primitive
                + '"><xs:enumeration value="t:jpeg"/></xs:restriction></xs:simpleType>'
                '<xs:element name="value" type="xs:anyType"/></xs:schema>';
            XsdSchema schema(source);
            auto value = primitive == "QName" ? new XsdQNameValue("urn:media", "a:jpeg")
                : new XsdNotationValue("urn:media", "a:jpeg");
            hash<auto> selected = {"^type^": new XsdQNameValue("urn:media", "Selected"), "^val^": value};
            foreach AbstractDataProviderType original in (schema.getElement("urn:media", "value").getDataProviderType(),
                    schema.getNativeDataProviderType("urn:media", "value")) {
                foreach AbstractDataProviderType provider in (original, Serializable::deserialize(original.serialize())) {
                    auto converted = provider.acceptsValue(selected);
                    assertTrue(converted."^type^".equals(selected."^type^"));
                    assertTrue(converted."^val^".equals(value));
                    string xml = schema.serializeXmlValue("urn:media", "value", converted).getXml();
                    assertEq(parse_xml(xml), parse_xml_with_schema(xml, source));
                    hash<auto> bad = selected;
                    bad."^type^" = new XsdQNameValue("urn:other", "Selected");
                    assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (bad,));
                    assertTrue(provider.acceptsValue(selected)."^val^".equals(value));
                }
            }
        }
    }

    private cancellation() {
        XsdNotationDataType provider(registry(), {"t": "urn:media"});
        SandboxManager manager();
        on_exit manager.clearInterrupt();
        Program program(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
        program.setSandboxManager(manager);
        program.parse("%modern\n%requires ../qlib/WSDL.qm\n"
            "auto sub convert(XsdNotationDataType provider, SandboxManager manager, bool cancel) {\n"
            "    if (cancel) { manager.requestInterrupt(); }\n"
            "    return provider.acceptsValue(\"t:jpeg\");\n}\n", get_script_dir() + "/notation-interrupt.qr");
        *hash<ExceptionInfo> error;
        try {
            program.callFunction("convert", provider, manager, True);
        } catch (hash<ExceptionInfo> ex) {
            error = ex;
        }
        manager.clearInterrupt();
        assertEq("PROGRAM-INTERRUPTED", error.err);
        checkValue(program.callFunction("convert", provider, manager, False));
    }

    private concurrency() {
        XsdNotationDataType provider(registry());
        Qore::Thread::Queue ready();
        Qore::Thread::Queue start();
        Qore::Thread::Queue results();
        Qore::Thread::Counter running();
        on_exit {
            for (int i = 0; i < 4; ++i) { start.push(True); }
            assertEq(0, running.waitForZero(30s));
        }
        for (int i = 0; i < 4; ++i) {
            running.inc();
            background sub(int index) {
                on_exit running.dec();
                try {
                    XsdNotationDataType current = Serializable::deserialize(provider.serialize());
                    ready.push(True);
                    start.get(30s);
                    string prefix = "p" + index;
                    current = current.withNamespaceBindings({prefix: "urn:media"});
                    XsdNotationValue result = current.acceptsValue(prefix + ":jpeg");
                    results.push((index, result, current.getNamespaceBindings().size()));
                } catch (hash<ExceptionInfo> ex) {
                    results.push({"error": ex});
                }
            }(i);
        }
        for (int i = 0; i < 4; ++i) { ready.get(30s); }
        for (int i = 0; i < 4; ++i) { start.push(True); }
        hash<string, bool> seen();
        for (int i = 0; i < 4; ++i) {
            auto result = results.get(30s);
            assertEq(NT_LIST, result.typeCode());
            checkValue(result[1]);
            assertEq("p" + result[0], result[1].getPrefix());
            assertEq(2, result[2]);
            seen{string(result[0])} = True;
        }
        assertEq(4, seen.size());
        assertEq({"xml": "http://www.w3.org/XML/1998/namespace"}, provider.getNamespaceBindings());
    }

    private examples() {
        XsdNotationRegistry declarations = registry();
        hash<string, hash<XsdNotationInfo>> snapshot = declarations.getDeclarations();
        assertEq(2, snapshot.size());
        remove snapshot."{urn:media}jpeg";
        assertTrue(exists declarations.get("{urn:media}jpeg"));
        XsdNotationDataType base(declarations, {"a": "urn:media"});
        XsdNotationRestrictionDataType restricted(<XsdNotationFacetInfo>{"name": "JPEG",
            "enumeration": (new XsdNotationValue("urn:media", "t:jpeg"),), "patterns": ("^a:jpeg$",)}, base);
        foreach XsdNotationDataType original in (base, restricted) {
            foreach XsdNotationDataType provider in (original, Serializable::deserialize(original.serialize())) {
                auto example = provider.getExampleValue();
                assertTrue(example instanceof XsdNotationValue);
                assertTrue(provider.acceptsValue(example).equals(example));
                assertNothing(provider.getOrNothingType().getExampleValue());
            }
        }
        XsdNotationDataType empty(new XsdNotationRegistry());
        assertThrows("XSD-SAMPLE-ERROR", \empty.getExampleValue());
        XsdNotationRestrictionDataType impossible(<XsdNotationFacetInfo>{"name": "Empty", "patterns": ("^never$",)}, base);
        assertThrows("XSD-SAMPLE-ERROR", \impossible.getExampleValue());
        XsdSchema schema(prefix() + '<xs:element name="value" type="t:Format"/></xs:schema>');
        XsdSimpleType type = cast<XsdSimpleType>(schema.getElement("urn:media", "value").type);
        checkValue(type.getSampleValue(NOTHING));
        auto example = schema.getNativeDataProviderType("urn:media", "value").getExampleValue();
        assertTrue(example instanceof XsdNotationValue);
        string xml = schema.serializeXmlValue("urn:media", "value", example).getXml();
        assertTrue(exists parse_xml(xml));
    }

}
