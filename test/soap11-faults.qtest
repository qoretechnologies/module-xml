#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires xml
%requires QUnit
%requires ../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "SOAP fault conformance tests require json";
%else
%exec-class Soap11FaultTest

class Soap11FaultTest inherits QUnit::Test {
    constructor() : Test("SOAP 1.1 fault grammar", "1.0") {
        addTestCase("Fault grammar validates before projection on source and saved consumers", \grammar());
        addTestCase("Protocol fields remain distinct from qualified extensions and application siblings", \isolation());
        set_return_value(main());
    }
    private grammar() {
        list<auto> cases = parse_json(ReadOnlyFile::readTextFile(get_script_dir() + "/wsdl-interop/soap-fault-peer/soap11-cases.json")).cases;
        assertEq(45, cases.size());
        string source = ReadOnlyFile::readTextFile(get_script_dir() + "/wsdl-interop/soap-envelope-peer/contract.wsdl");
        foreach string state in ("source", "saved", "data") {
            WebService ws(source);
            if (state == "saved") { ws = Serializable::deserialize(ws.serialize()); }
            if (state == "data") { ws = Serializable::deserialize(ws.serializeToData()); }
            WSOperation op = ws.getOperation("echo");
            SoapProcessingNode node();
            foreach hash<auto> row in (cases) {
                hash<auto> data = parse_xml(row.xml, XPF_PRESERVE_ORDER | XPF_PRESERVE_WHITESPACE);
                hash<auto> before = data;
                if (row.valid) {
                    assertFalse(WSDLLib::validateSOAPEnvelope(data, False), row.name);
                    assertThrows("SOAP-SERVER-FAULT-RESPONSE", \op.deserializeResponse(), (data,"B11"));
                    assertThrows("SOAP-SERVER-FAULT-RESPONSE", \op.deserializeXmlResponse(), (row.xml,"B11"));
                    assertEq(row.xml, node.processMessage(row.xml).application_message.getXml());
                } else {
                    assertThrows("SOAP-DESERIALIZATION-ERROR", \WSDLLib::validateSOAPEnvelope(), (data,False));
                    assertThrows("SOAP-DESERIALIZATION-ERROR", \op.deserializeResponse(), (data,"B11"));
                    assertThrows("SOAP-DESERIALIZATION-ERROR", \op.deserializeXmlResponse(), (row.xml,"B11"));
                    assertThrows("SOAP-DESERIALIZATION-ERROR", \node.processMessage(), (row.xml,));
                }
                assertEq(before, data, row.name);
            }
        }
    }
    private isolation() {
        WebService ws(ReadOnlyFile::readTextFile(get_script_dir() + "/wsdl-interop/soap-envelope-peer/contract.wsdl"));
        WSOperation op = ws.getOperation("echo");
        string fault = '<e:Fault><faultcode>e:Client</faultcode><faultstring>Invoice rejected</faultstring>'
            + '<t:faultcode>tracking-71</t:faultcode></e:Fault>';
        foreach bool before in (False, True) {
            string sibling = '<t:Fault>invoice-71</t:Fault>';
            string xml = '<e:Envelope xmlns:e="' + SOAP_11_ENV + '" xmlns:t="urn:invoice"><e:Body>'
                + (before ? sibling + fault : fault + sibling) + '</e:Body></e:Envelope>';
            foreach bool retained in (False, True) {
                bool caught = False;
                try {
                    if (retained) { op.deserializeXmlResponse(xml,"B11"); }
                    else { op.deserializeResponse(parse_xml(xml),"B11"); }
                } catch (hash<ExceptionInfo> ex) {
                    caught = True;
                    assertEq("SOAP-SERVER-FAULT-RESPONSE", ex.err);
                    assertEq("e:Client", ex.arg.faultcode);
                    assertEq("Invoice rejected", ex.arg.faultstring);
                    assertEq("tracking-71", ex.arg."t:faultcode");
                    assertEq("urn:invoice", ex.arg."^attributes^"."xmlns:t");
                    assertEq(SOAP_11_ENV, ex.arg."^attributes^"."xmlns:e");
                }
                assertTrue(caught);
            }
        }
    }
}
%endif
