<?xml version="1.0" encoding="UTF-8"?>
<!-- WSDL for testing xs:choice model groups that do not require any member to be present (issue 5464) -->
<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:xs="http://www.w3.org/2001/XMLSchema"
             xmlns:tns="urn:qore:test:optional-choice"
             targetNamespace="urn:qore:test:optional-choice">
    <types>
        <xs:schema targetNamespace="urn:qore:test:optional-choice"
                   xmlns="urn:qore:test:optional-choice" elementFormDefault="qualified">
            <!-- the choice has no "minOccurs" attribute, but every alternative is optional, so the choice is
                 satisfied without any member being present -->
            <xs:complexType name="all-optional-type">
                <xs:sequence>
                    <xs:element name="allow" type="xs:boolean"/>
                    <xs:choice>
                        <xs:element name="play-announcement" type="xs:string" minOccurs="0"/>
                        <xs:element name="play-segmented-announcement" type="xs:string" nillable="true"
                                    minOccurs="0"/>
                    </xs:choice>
                    <xs:element name="status-code" type="xs:string" nillable="true" minOccurs="0"/>
                </xs:sequence>
            </xs:complexType>
            <!-- one alternative is optional, which makes the choice itself optional -->
            <xs:complexType name="one-optional-type">
                <xs:sequence>
                    <xs:element name="allow" type="xs:boolean"/>
                    <xs:choice>
                        <xs:element name="required-alt" type="xs:string"/>
                        <xs:element name="optional-alt" type="xs:string" minOccurs="0"/>
                    </xs:choice>
                </xs:sequence>
            </xs:complexType>
            <!-- every alternative is required, so one of them must be present -->
            <xs:complexType name="required-type">
                <xs:sequence>
                    <xs:element name="allow" type="xs:boolean"/>
                    <xs:choice>
                        <xs:element name="alt1" type="xs:string"/>
                        <xs:element name="alt2" type="xs:string"/>
                    </xs:choice>
                </xs:sequence>
            </xs:complexType>
            <!-- an alternative declared as a nested model group is emptiable only if all its elements are -->
            <xs:complexType name="nested-type">
                <xs:sequence>
                    <xs:element name="allow" type="xs:boolean"/>
                    <xs:choice>
                        <xs:sequence>
                            <xs:element name="n1" type="xs:string" minOccurs="0"/>
                            <xs:element name="n2" type="xs:string" minOccurs="0"/>
                        </xs:sequence>
                        <xs:element name="alt" type="xs:string"/>
                    </xs:choice>
                </xs:sequence>
            </xs:complexType>
            <!-- the same, but the nested model group requires an element, so the choice requires a member -->
            <xs:complexType name="nested-required-type">
                <xs:sequence>
                    <xs:element name="allow" type="xs:boolean"/>
                    <xs:choice>
                        <xs:sequence>
                            <xs:element name="n1" type="xs:string"/>
                            <xs:element name="n2" type="xs:string" minOccurs="0"/>
                        </xs:sequence>
                        <xs:element name="alt" type="xs:string"/>
                    </xs:choice>
                </xs:sequence>
            </xs:complexType>
            <!-- the content model of the type is a choice with only optional members -->
            <xs:complexType name="choice-type">
                <xs:choice>
                    <xs:element name="c1" type="xs:string" minOccurs="0"/>
                    <xs:element name="c2" type="xs:string" minOccurs="0"/>
                </xs:choice>
            </xs:complexType>

            <xs:element name="Req">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="all-optional" type="all-optional-type" minOccurs="0"/>
                        <xs:element name="one-optional" type="one-optional-type" minOccurs="0"/>
                        <xs:element name="required" type="required-type" minOccurs="0"/>
                        <xs:element name="nested" type="nested-type" minOccurs="0"/>
                        <xs:element name="nested-required" type="nested-required-type" minOccurs="0"/>
                        <xs:element name="choice" type="choice-type" minOccurs="0"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="Resp" type="xs:string"/>
        </xs:schema>
    </types>

    <message name="ReqM"><part name="parameters" element="tns:Req"/></message>
    <message name="RespM"><part name="parameters" element="tns:Resp"/></message>

    <portType name="OptionalChoicePort">
        <operation name="Op">
            <input message="tns:ReqM"/>
            <output message="tns:RespM"/>
        </operation>
    </portType>

    <binding name="OptionalChoiceBinding" type="tns:OptionalChoicePort">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <operation name="Op">
            <soap:operation soapAction="Op" style="document"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>
    </binding>

    <service name="OptionalChoiceService">
        <port name="OptionalChoicePort" binding="tns:OptionalChoiceBinding">
            <soap:address location="http://localhost:8080/optional-choice"/>
        </port>
    </service>
</definitions>
