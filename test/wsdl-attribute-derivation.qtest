#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class AttributeDerivationTest

class AttributeDerivationTest inherits QUnit::Test {
    constructor() : QUnit::Test("WSDL attribute derivation constraints", "1.0") {
        addTestCase("Restrictions preserve requiredness and fixed constraints", \constraints());
        addTestCase("Extensions reject duplicate expanded attribute uses", \duplicates());
        addTestCase("Builtin attribute types restrict along their XSD ancestry", \builtinTypes());
        addTestCase("Named lists unions and anonymous restrictions preserve type ancestry", \namedTypes());
        addTestCase("Inline simple content must restrict the base content type", \simpleContent());
        addTestCase("Restriction preserves base fields and restored provider constraints", \consumers());
        addTestCase("Failed derivation restores schema construction state", \rollback());
        set_return_value(main());
    }

    private string schema(string content) {
        return '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:derive"
            targetNamespace="urn:derive">' + content + '</xs:schema>';
    }

    private XsdSchema parse(string content) {
        return new XsdSchema(schema(content), {"async_only": True});
    }

    private string declarations(string base, string derived, string method = "restriction",
            bool simple = False) {
        string b = simple ? '<xs:simpleContent><xs:extension base="xs:int">' + base
            + '</xs:extension></xs:simpleContent>' : base;
        string kind = simple ? "simpleContent" : "complexContent";
        return '<xs:complexType name="Base">' + b + '</xs:complexType><xs:complexType name="Derived">'
            + sprintf('<xs:%s><xs:%s base="t:Base">%s</xs:%s></xs:%s>', kind, method, derived, method, kind)
            + '</xs:complexType>';
    }

    private XsdComplexType type(XsdSchema s) {
        return cast<XsdComplexType>(s.getTypeMap(){make_qname("urn:derive", "Derived")});
    }

    private string attribute(string type = "xs:int", string extra = "") {
        return sprintf('<xs:attribute name="a" type="%s" %s/>', type, extra);
    }

    constraints() {
        foreach bool simple in (False, True) {
            foreach string derived in (attribute(), attribute("xs:int", 'use="prohibited"')) {
                assertThrows("WSDL-ERROR", \parse(), (declarations(attribute("xs:int", 'use="required"'),
                    derived, "restriction", simple),));
            }
            foreach string derived in (attribute(), attribute("xs:int", 'default="1"'),
                    attribute("xs:int", 'fixed="2"')) {
                assertThrows("WSDL-ERROR", \parse(), (declarations(attribute("xs:int", 'fixed="1"'),
                    derived, "restriction", simple),));
            }
            XsdSchema s = parse(declarations(attribute("xs:int", 'fixed="0"'),
                attribute("xs:int", 'fixed="0" use="required"'), "restriction", simple));
            XsdComplexType t = cast<XsdComplexType>(s.getTypeMap(){make_qname("urn:derive", "Derived")});
            assertEq("required", t.attrs.a.use);
            assertEq(0, t.attrs.a.getDefaultValue());
        }
    }

    duplicates() {
        foreach bool simple in (False, True) {
            foreach string derived in (attribute(), attribute("xs:string")) {
                assertThrows("WSDL-ERROR", \parse(), (declarations(attribute(), derived, "extension", simple),));
            }
            XsdSchema s = parse(declarations(attribute(), attribute("xs:boolean", 'form="qualified"'),
                "extension", simple));
            XsdComplexType t = cast<XsdComplexType>(s.getTypeMap(){make_qname("urn:derive", "Derived")});
            assertEq(("{}a", "{urn:derive}a"), keys t.attrs);
            assertEq("boolean", t.attrs."{urn:derive}a".type.name);
        }
        assertThrows("WSDL-ERROR", \parse(), ('<xs:attribute name="a" type="xs:int"/>'
            + declarations('<xs:attribute ref="t:a"/>', '<xs:attribute ref="t:a"/>', "extension"),));
        string colliding = attribute("xs:int", 'use="required"')
            + attribute("xs:boolean", 'form="qualified" use="required"');
        assertThrows("WSDL-ERROR", \parse(), (declarations(colliding,
            attribute("xs:boolean", 'form="qualified"')),));
        XsdSchema s = parse(declarations(colliding, attribute("xs:short", 'use="required"')));
        assertEq("boolean", type(s).attrs."{urn:derive}a".type.name);
        assertEq("short", type(s).attrs."{}a".type.name);
    }

    builtinTypes() {
        foreach list<string> pair in (("decimal", "byte"), ("integer", "unsignedInt"),
                ("nonNegativeInteger", "positiveInteger"), ("string", "ID"), ("token", "language"),
                ("Name", "NCName"), ("anySimpleType", "NMTOKENS"), ("anySimpleType", "QName")) {
            XsdSchema s = parse(declarations(attribute("xs:" + pair[0]), attribute("xs:" + pair[1])));
            assertEq(pair[1], type(s).attrs.a.type.name);
        }
        foreach list<string> pair in (("int", "integer"), ("int", "string"), ("float", "double"),
                ("ID", "NCName"), ("NMTOKEN", "NMTOKENS"), ("date", "dateTime")) {
            assertThrows("WSDL-ERROR", \parse(), (declarations(attribute("xs:" + pair[0]),
                attribute("xs:" + pair[1])),));
        }
    }

    namedTypes() {
        string types = '<xs:simpleType name="BaseValue"><xs:restriction base="xs:int"/></xs:simpleType>
            <xs:simpleType name="Narrow"><xs:restriction base="t:BaseValue"><xs:minInclusive value="0"/>
            </xs:restriction></xs:simpleType>
            <xs:simpleType name="Sibling"><xs:restriction base="xs:int"/></xs:simpleType>
            <xs:simpleType name="Items"><xs:list itemType="xs:int"/></xs:simpleType>
            <xs:simpleType name="OtherItems"><xs:list itemType="xs:int"/></xs:simpleType>
            <xs:simpleType name="TwoItems"><xs:restriction base="t:Items"><xs:length value="2"/>
            </xs:restriction></xs:simpleType>
            <xs:simpleType name="Either"><xs:union memberTypes="xs:boolean t:BaseValue"/></xs:simpleType>';
        foreach list<string> pair in (("t:BaseValue", "t:Narrow"), ("t:Items", "t:TwoItems"),
                ("t:Either", "t:Narrow"), ("xs:anySimpleType", "t:Items"),
                ("xs:anySimpleType", "t:Either")) {
            XsdSchema s = parse(types + declarations(attribute(pair[0]), attribute(pair[1])));
            assertEq(pair[1].split(":")[1], type(s).attrs.a.type.name);
        }
        foreach list<string> pair in (("t:BaseValue", "t:Sibling"), ("t:Items", "t:OtherItems"),
                ("t:Items", "xs:int"), ("t:Either", "xs:string"), ("t:Narrow", "t:BaseValue")) {
            assertThrows("WSDL-ERROR", \parse(), (types + declarations(attribute(pair[0]), attribute(pair[1])),));
        }
        XsdSchema s = parse(types + declarations(attribute("t:BaseValue"), '<xs:attribute name="a">
            <xs:simpleType><xs:restriction base="t:Narrow"/></xs:simpleType></xs:attribute>'));
        assertEq("Narrow", cast<XsdSimpleType>(type(s).attrs.a.type).type.name);
    }

    simpleContent() {
        string base = '<xs:complexType name="Base"><xs:simpleContent><xs:extension base="xs:int"/>
            </xs:simpleContent></xs:complexType>';
        foreach string type in ("xs:string", "xs:integer") {
            assertThrows("WSDL-ERROR", \parse(), (base + '<xs:complexType name="Derived"><xs:simpleContent>
                <xs:restriction base="t:Base"><xs:simpleType><xs:restriction base="' + type + '"/>
                </xs:simpleType></xs:restriction></xs:simpleContent></xs:complexType>',));
        }
        XsdSchema s = parse(base + '<xs:complexType name="Derived"><xs:simpleContent><xs:restriction
            base="t:Base"><xs:simpleType><xs:restriction base="xs:short"/></xs:simpleType>
            </xs:restriction></xs:simpleContent></xs:complexType>');
        assertEq(0, s.getTypeMap(){make_qname("urn:derive", "Derived")}.deserializeValue("v", s.getTypeMap(),
            NOTHING, "0"));
    }

    consumers() {
        XsdSchema s = parse(declarations(attribute("xs:int", 'use="required"')
            + '<xs:attribute name="b" type="xs:boolean" default="false"/>',
            attribute("xs:short", 'use="required"') + '<xs:attribute name="b" use="prohibited"/>'));
        foreach XsdSchema schema in (s, Serializable::deserialize(s.serialize())) {
            XsdComplexType base = cast<XsdComplexType>(schema.getTypeMap(){make_qname("urn:derive", "Base")});
            XsdComplexType derived = cast<XsdComplexType>(schema.getTypeMap(){make_qname("urn:derive", "Derived")});
            assertEq(("a", "b"), keys base.attrs);
            assertEq(("a",), keys derived.attrs);
            assertEq("int", base.attrs.a.type.name);
            hash<auto> value = derived.deserializeValue("v", schema.getTypeMap(), NOTHING,
                {"^attributes^": {"a": "0"}});
            assertEq(0, value."^attributes^".a);
            assertEq(value, derived.getDataProviderType().acceptsValue(value));
            assertThrows("SOAP-DESERIALIZATION-ERROR", \derived.deserializeValue(),
                ("v", schema.getTypeMap(), NOTHING, {"^attributes^": {"a": "0", "b": "false"}}));
        }
    }

    rollback() {
        XsdSchema s = parse('<xs:element name="existing" type="xs:string"/>');
        assertThrows("WSDL-ERROR", \s.addSchemaString(), (schema(declarations(attribute("xs:int", 'use="required"'),
            attribute())),));
        s.addSchemaString(schema(declarations(attribute("xs:int", 'use="required"'),
            attribute("xs:short", 'use="required"'))));
        assertEq("short", type(s).attrs.a.type.name);
        assertEq("string", s.getElement("urn:derive", "existing").type.name);
    }
}
