#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires ../qlib/WSDL.qm
%exec-class AttributeWildcardsTest

class AttributeWildcardsTest inherits QUnit::Test {
    private {
        const Xsd = "http://www.w3.org/2001/XMLSchema";
        const Ns = "urn:attribute-wildcards";
    }

    constructor() : Test("WSDL attribute wildcard construction", "1.0") {
        addTestCase("Restrictions require a base wildcard for new attribute uses", \admission());
        addTestCase("Group wildcard intersections govern new restriction uses", \intersections());
        addTestCase("Extension wildcard unions are inherited by later restrictions", \unions());
        addTestCase("Restrictions preserve wildcard subset and processing strength", \restrictions());
        addTestCase("Wildcard declarations reject invalid grammar", \invalidDeclarations());
        addTestCase("Wildcard metadata preserves processing precedence and immutable views", \metadata());
        addTestCase("Imported namespace exclusions compose by XSD 1.0 rules", \imported());
        addTestCase("Wildcard failures preserve schema state and typed consumers", \recovery());
        set_return_value(main());
    }

    private string schema(string body, string ns = Ns) {
        return sprintf('<xs:schema xmlns:xs="%s" xmlns:t="%s" xmlns:f="urn:foreign" targetNamespace="%s">%s</xs:schema>',
            Xsd, ns, ns, body);
    }

    private XsdSchema parse(string body) {
        return new XsdSchema(schema(body), {"async_only": True});
    }

    private string wildcard(string namespaces = "##any", string process = "strict") {
        return sprintf('<xs:anyAttribute namespace="%s" processContents="%s"/>', namespaces, process);
    }

    private string attribute(bool qualified = False) {
        return '<xs:attribute name="flag" type="xs:boolean" use="required"'
            + (qualified ? ' form="qualified"' : '') + '/>';
    }

    private string restriction(string body, string base = "t:Base", string name = "Record") {
        return sprintf('<xs:complexType name="%s"><xs:complexContent><xs:restriction base="%s">%s'
            + '</xs:restriction></xs:complexContent></xs:complexType>', name, base, body);
    }

    private string derived(string base_content, string own) {
        return '<xs:complexType name="Base">' + base_content + '</xs:complexType>' + restriction(own);
    }

    private XsdComplexType record(XsdSchema s) {
        return cast<XsdComplexType>(s.findType(make_qname(Ns, "Record")));
    }

    admission() {
        assertThrows("WSDL-ERROR", \parse(), (derived("", attribute()),));
        assertThrows("WSDL-ERROR", \parse(), (derived('<xs:sequence><xs:any minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>', attribute()),));
        foreach string allowed in ("##any", "##local", "##local urn:foreign") {
            XsdSchema s = parse(derived(wildcard(allowed), attribute()));
            assertEq("boolean", record(s).attrs.flag.type.name);
        }
        foreach string forbidden in ("##targetNamespace", "##other", "urn:foreign") {
            assertThrows("WSDL-ERROR", \parse(), (derived(wildcard(forbidden), attribute()),));
        }
        XsdSchema s = parse(derived(wildcard("##targetNamespace"), attribute(True)));
        assertEq(Ns, record(s).attrs.flag.namespaceUri);
        assertThrows("WSDL-ERROR", \parse(), (derived(wildcard("##local"), attribute(True)),));
    }

    intersections() {
        string groups = '<xs:attributeGroup name="A">' + wildcard("##local ##targetNamespace", "skip")
            + '</xs:attributeGroup><xs:attributeGroup name="B">' + wildcard("##local", "strict")
            + '</xs:attributeGroup>';
        string refs = '<xs:attributeGroup ref="t:A"/><xs:attributeGroup ref="t:B"/>';
        XsdSchema s = parse(groups + derived(refs, attribute()));
        assertEq("boolean", record(s).attrs.flag.type.name);
        assertThrows("WSDL-ERROR", \parse(), (groups + derived(refs, attribute(True)),));
        assertThrows("WSDL-ERROR", \parse(), (groups + derived(refs + wildcard("##targetNamespace"), attribute()),));
        string nested = groups + '<xs:attributeGroup name="C">' + refs + '</xs:attributeGroup>';
        s = parse(nested + derived('<xs:attributeGroup ref="t:C"/>', attribute()));
        assertEq("boolean", record(s).attrs.flag.type.name);
    }

    unions() {
        string base = '<xs:complexType name="Root">' + wildcard("##local") + '</xs:complexType>
            <xs:complexType name="Base"><xs:complexContent><xs:extension base="t:Root">'
            + wildcard("##targetNamespace") + '</xs:extension></xs:complexContent></xs:complexType>';
        foreach bool qualified in (False, True) {
            XsdSchema s = parse(base + restriction(attribute(qualified)));
            assertEq("boolean", record(s).attrs.flag.type.name);
        }
        base = '<xs:complexType name="Root">' + wildcard("##other") + '</xs:complexType>
            <xs:complexType name="Base"><xs:complexContent><xs:extension base="t:Root">'
            + wildcard("##local") + '</xs:extension></xs:complexContent></xs:complexType>';
        assertThrows("WSDL-ERROR", \parse(), (base,));
        base = '<xs:complexType name="Root">' + wildcard("##local") + '</xs:complexType>
            <xs:complexType name="Base"><xs:complexContent><xs:extension base="t:Root"/>
            </xs:complexContent></xs:complexType>';
        XsdSchema s = parse(base + restriction(attribute()));
        assertEq("boolean", record(s).attrs.flag.type.name);
        assertThrows("WSDL-ERROR", \parse(), (base + restriction(attribute(True)),));
    }

    restrictions() {
        assertThrows("WSDL-ERROR", \parse(), (derived("", wildcard()),));
        assertThrows("WSDL-ERROR", \parse(), (derived(wildcard("##local"), wildcard("##any")),));
        foreach string process in ("skip", "lax") {
            assertThrows("WSDL-ERROR", \parse(), (derived(wildcard("##any", "strict"), wildcard("##local", process)),));
        }
        foreach string process in ("skip", "lax", "strict") {
            XsdSchema s = parse(derived(wildcard("##any", "skip"), wildcard("##local", process)));
            assertEq("Record", record(s).name);
        }
        XsdSchema s = parse(restriction(wildcard("##any", "skip"), "xs:anyType"));
        assertEq("Record", record(s).name);
        s = parse(derived(wildcard(), ""));
        assertEq("Record", record(s).name);
    }

    invalidDeclarations() {
        foreach string ns in ("##any ##local", "##other ##targetNamespace", "##invalid") {
            assertThrows("WSDL-ERROR", \parse(), ('<xs:complexType name="Record">' + wildcard(ns) + '</xs:complexType>',));
        }
        assertThrows("WSDL-ERROR", \parse(), ('<xs:complexType name="Record">' + wildcard("##any", "invalid")
            + '</xs:complexType>',));
        assertThrows("WSDL-ERROR", \parse(), ('<xs:complexType name="Record">' + wildcard() + wildcard()
            + '</xs:complexType>',));
    }

    metadata() {
        string groups = '<xs:attributeGroup name="A">' + wildcard("##local ##targetNamespace", "skip")
            + '</xs:attributeGroup><xs:attributeGroup name="B">' + wildcard("##local", "strict")
            + '</xs:attributeGroup>';
        string refs = '<xs:attributeGroup ref="t:A"/><xs:attributeGroup ref="t:B"/>';
        XsdSchema original = parse(groups + '<xs:complexType name="Base">' + refs + '</xs:complexType>'
            + '<xs:complexType name="Record"><xs:complexContent><xs:extension base="t:Base">'
            + wildcard("##targetNamespace", "lax") + '</xs:extension></xs:complexContent></xs:complexType>');
        foreach XsdSchema s in (original, Serializable::deserialize(original.serialize())) {
            XsdComplexType base = cast<XsdComplexType>(s.findType(make_qname(Ns, "Base")));
            hash<XsdAttributeWildcardInfo> before = base.getAttributeWildcard();
            assertEq(XsdWildcardProcessing::Skip, before.processing);
            assertEq({"": True}, before.namespaces);
            hash<XsdAttributeWildcardInfo> own = record(s).getAttributeWildcard();
            assertEq(XsdWildcardProcessing::Lax, own.processing);
            assertEq(XsdWildcardConstraint::Set, own.constraint);
            assertEq({"": True, Ns: True}, own.namespaces);
            own.namespaces{"urn:changed"} = True;
            assertEq({"": True, Ns: True}, record(s).getAttributeWildcard().namespaces);
            assertEq(before, base.getAttributeWildcard());
        }
        XsdSchema empty = parse('<xs:complexType name="Record">' + wildcard("") + '</xs:complexType>');
        assertEq(XsdWildcardConstraint::Set, record(empty).getAttributeWildcard().constraint);
        assertEq({}, record(empty).getAttributeWildcard().namespaces);
        XsdSchema intersect = parse('<xs:attributeGroup name="G">' + wildcard("##other")
            + '</xs:attributeGroup><xs:complexType name="Record"><xs:attributeGroup ref="t:G"/>'
            + wildcard("##local ##targetNamespace urn:foreign", "lax") + '</xs:complexType>');
        assertEq({"urn:foreign": True}, record(intersect).getAttributeWildcard().namespaces);
        assertEq(XsdWildcardProcessing::Lax, record(intersect).getAttributeWildcard().processing);
    }

    private XsdSchema importedBase() {
        return new XsdSchema(schema('<xs:complexType name="Base">' + wildcard("##other")
            + '</xs:complexType><xs:attributeGroup name="Other">' + wildcard("##other")
            + '</xs:attributeGroup>', "urn:foreign"), {"async_only": True});
    }

    imported() {
        XsdSchema s = importedBase();
        string imports = '<xs:import namespace="urn:foreign"/>';
        string extension = '<xs:complexType name="Base"><xs:complexContent><xs:extension base="f:Base">'
            + wildcard("##other") + '</xs:extension></xs:complexContent></xs:complexType>';
        s.addSchemaString(schema(imports + extension + restriction(attribute(True))));
        XsdComplexType base = cast<XsdComplexType>(s.findType(make_qname(Ns, "Base")));
        assertEq(XsdWildcardConstraint::Not, base.getAttributeWildcard().constraint);
        assertEq("", base.getAttributeWildcard().excluded_namespace);
        assertEq(Ns, record(s).attrs.flag.namespaceUri);
        assertThrows("WSDL-ERROR", \s.addSchemaString(), (schema(restriction(wildcard("##other"), "t:Base", "Broken")),));
        assertThrows("WSDL-ERROR", \s.addSchemaString(), (schema(restriction(attribute(), "t:Base", "Broken")),));
        s = importedBase();
        assertThrows("WSDL-ERROR", \s.addSchemaString(), (schema(imports
            + '<xs:complexType name="Record"><xs:attributeGroup ref="f:Other"/>' + wildcard("##other")
            + '</xs:complexType>'),));
        XsdSchema bare(sprintf('<xs:schema xmlns:xs="%s"><xs:attributeGroup name="Other">%s'
            + '</xs:attributeGroup></xs:schema>', Xsd, wildcard("##other")));
        bare.addSchemaString(schema('<xs:import/><xs:complexType name="Record"><xs:attributeGroup ref="Other"/>'
            + wildcard("##other") + '</xs:complexType>'));
        assertEq(XsdWildcardConstraint::Not, record(bare).getAttributeWildcard().constraint);
        assertEq(Ns, record(bare).getAttributeWildcard().excluded_namespace);
    }

    recovery() {
        XsdSchema original = parse(derived(wildcard("##local", "skip"), attribute()));
        foreach XsdSchema s in (original, Serializable::deserialize(original.serialize())) {
            XsdComplexType before = record(s);
            assertThrows("WSDL-ERROR", \s.addSchemaString(), (schema(restriction(attribute(True), "t:Base", "Broken")),));
            assertEq(before, record(s));
            assertEq({"^attributes^": {"flag": False}}, before.getDataProviderType().acceptsValue(
                {"^attributes^": {"flag": False}}));
            assertEq({"^attributes^": {"flag": False}}, before.deserializeValue("Record", s.getTypeMap(), NOTHING,
                {"^attributes^": {"flag": "false"}}));
        }
    }
}
