#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires xml
%requires QUnit
%requires ../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "SOAP fault conformance tests require json";
%else
%exec-class Soap12FaultTest

class Soap12FaultTest inherits QUnit::Test {
    constructor() : Test("SOAP 1.2 fault grammar", "1.0") {
        addTestCase("Fault grammar validates before projection on source and saved consumers", \grammar());
        addTestCase("Deep Subcode chains preserve ordered QName scope and reject malformed tails", \depth());
        set_return_value(main());
    }
    private grammar() {
        list<auto> cases = parse_json(ReadOnlyFile::readTextFile(get_script_dir() + "/wsdl-interop/soap-fault-peer/soap12-cases.json")).cases;
        assertEq(73, cases.size());
        string source = ReadOnlyFile::readTextFile(get_script_dir() + "/wsdl-interop/soap-envelope-peer/contract.wsdl");
        foreach string state in ("source", "saved", "data") {
            WebService ws(source);
            if (state == "saved") { ws = Serializable::deserialize(ws.serialize()); }
            if (state == "data") { ws = Serializable::deserialize(ws.serializeToData()); }
            WSOperation op = ws.getOperation("echo");
            SoapProcessingNode node();
            foreach hash<auto> row in (cases) {
                hash<auto> data = parse_xml(row.xml, XPF_PRESERVE_ORDER | XPF_PRESERVE_WHITESPACE);
                hash<auto> before = data;
                if (row.valid) {
                    assertTrue(WSDLLib::validateSOAPEnvelope(data, True), row.name);
                    assertThrows("SOAP-SERVER-FAULT-RESPONSE", \op.deserializeResponse(), (data,"B12"));
                    assertThrows("SOAP-SERVER-FAULT-RESPONSE", \op.deserializeXmlResponse(), (row.xml,"B12"));
                    assertEq(row.xml, node.processMessage(row.xml).application_message.getXml());
                } else {
                    assertThrows("SOAP-DESERIALIZATION-ERROR", \WSDLLib::validateSOAPEnvelope(), (data,True));
                    assertThrows("SOAP-DESERIALIZATION-ERROR", \op.deserializeResponse(), (data,"B12"));
                    assertThrows("SOAP-DESERIALIZATION-ERROR", \op.deserializeXmlResponse(), (row.xml,"B12"));
                    assertThrows("SOAP-DESERIALIZATION-ERROR", \node.processMessage(), (row.xml,));
                }
                assertEq(before, data, row.name);
            }
        }
    }
    private depth() {
        string code = '<s:Value>s:Sender</s:Value>';
        for (int i = 0; i < 64; ++i) {
            code += sprintf('<s:Subcode xmlns:c="urn:level:%d"><s:Value>c:Code</s:Value>', i);
        }
        string closing;
        for (int i = 0; i < 64; ++i) { closing += '</s:Subcode>'; }
        string xml = '<s:Envelope xmlns:s="' + SOAP_12_ENV + '"><s:Body><s:Fault><s:Code>' + code
            + closing + '</s:Code><s:Reason><s:Text xml:lang="en">No invoice</s:Text>'
            + '</s:Reason></s:Fault></s:Body></s:Envelope>';
        assertTrue(WSDLLib::validateSOAPEnvelope(parse_xml(xml), True));
        string broken = replace(xml, 'xmlns:c="urn:level:63"', 'xmlns:x="urn:level:63"');
        # A new prefix at the final level leaves c inherited, so explicitly remove the QName's binding instead.
        broken = replace(broken, '<s:Subcode xmlns:x="urn:level:63"><s:Value>c:Code',
            '<s:Subcode xmlns:x="urn:level:63"><s:Value>missing:Code');
        assertThrows("SOAP-DESERIALIZATION-ERROR", \WSDLLib::validateSOAPEnvelope(), (parse_xml(broken),True));
    }
}
%endif
