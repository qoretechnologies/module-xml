#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%exec-class XmlValueSpaceTest

class XmlValueSpaceTest inherits QUnit::Test {
    const Xsi = ' xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"';
    constructor() : Test("Native datatype value spaces", "1.0") {
        addTestCase("Time values normalize offsets without inventing dates", \times());
        addTestCase("Unsigned lexical forms reject signs before applying constraints", \unsignedLexical());
        addTestCase("Fixed constraints compare typed values", \fixedValues());
        addTestCase("Fixed numeric values retain precision", \precision());
        set_return_value(main());
    }
    private string schema(string components) {
        return '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:p="urn:part">'
            + components + '</xs:schema>';
    }
    private bool consume(string source, string xml) {
        XmlReader reader(new StringInputStream(xml), {"xsd":source});
        int roots = 0;
        while (reader.read()) {
            if (reader.nodeType() == XML_NODE_TYPE_ELEMENT && reader.depth() == 0) {
                ++roots;
            }
        }
        return roots == 1 && reader.isValid();
    }
    private check(string source, string xml, bool valid) {
        XmlDoc document(xml);
        if (valid) {
            assertTrue(consume(source, xml));
            assertEq(parse_xml(xml), parse_xml_with_schema(xml, source));
            document.validateSchema(source);
        } else {
            assertThrows("PARSE-XML-EXCEPTION", \consume(), (source, xml));
            assertThrows("PARSE-XML-EXCEPTION", \parse_xml_with_schema(), (xml, source));
            assertThrows("XSD-ERROR", \document.validateSchema(), (source,));
        }
    }
    private invalidSchema(string source) {
        XmlDoc document("<root/>");
        assertThrows("XSD-SYNTAX-ERROR", \consume(), (source, "<root/>"));
        assertThrows("XSD-SYNTAX-ERROR", \parse_xml_with_schema(), ("<root/>", source));
        assertThrows("XSD-SYNTAX-ERROR", \document.validateSchema(), (source,));
    }
    private times() {
        foreach hash<string, string> item in (
                {"fixed":"12:00:00Z", "equal":"14:00:00+02:00"},
                {"fixed":"23:00:00Z", "equal":"01:00:00+02:00"},
                {"fixed":"01:00:00Z", "equal":"23:00:00-02:00"},
                {"fixed":"12:00:00.123456789Z", "equal":"14:00:00.123456789+02:00"},
                {"fixed":"00:00:00", "equal":"24:00:00"}) {
            foreach bool reverse in (False, True) {
                string source = schema('<xs:element name="root" type="xs:time" fixed="'
                    + (reverse ? item.equal : item.fixed) + '"/>');
                check(source, '<root>' + (reverse ? item.fixed : item.equal) + '</root>', True);
                check(source, '<root>12:00:01Z</root>', False);
            }
        }
        string source = schema('<xs:element name="root" type="xs:time" fixed="12:00:00Z"/>');
        check(source, '<root>12:00:00</root>', False);
        check(source, '<root>14:00:00Z</root>', False);
        check(source, '<root>14:00:00+02:00</root>', True);
    }
    private unsignedLexical() {
        foreach string type in ("unsignedLong", "unsignedInt", "unsignedShort", "unsignedByte") {
            string source = schema('<xs:element name="root" type="xs:' + type + '"/>');
            foreach string value in ("+17", "-0", "+0", " +17 ", "-1") {
                check(source, '<root>' + value + '</root>', False);
            }
            foreach string value in ("17", "0017", "0", " 0 ") {
                check(source, '<root>' + value + '</root>', True);
            }
            foreach string kind in ("default", "fixed") {
                foreach string value in ("+17", "-0", "+0") {
                    invalidSchema(schema('<xs:element name="root" type="xs:' + type + '" '
                        + kind + '="' + value + '"/>'));
                }
                source = schema('<xs:element name="root" type="xs:' + type + '" ' + kind + '="0017"/>');
                check(source, '<root/>', True);
                check(source, '<root>17</root>', True);
                check(source, '<root>+17</root>', False);
            }
        }
        string source = schema('<xs:element name="root" type="xs:nonNegativeInteger" fixed="-0"/>');
        check(source, '<root>+0</root>', True);
    }
    private fixedValues() {
        foreach hash<string, string> item in (
                {"type":"int", "fixed":"+017", "equal":"17", "different":"18"},
                {"type":"decimal", "fixed":"-0.00", "equal":"0.0", "different":"0.1"},
                {"type":"boolean", "fixed":"1", "equal":"true", "different":"false"},
                {"type":"QName", "fixed":"p:Part", "equal":"q:Part", "different":"q:Other"},
                {"type":"hexBinary", "fixed":"aB01", "equal":"Ab01", "different":"AB02"},
                {"type":"base64Binary", "fixed":"YWI=", "equal":"Y W I =", "different":"YWM="},
                {"type":"duration", "fixed":"P1Y", "equal":"P12M", "different":"P365D"},
                {"type":"dateTime", "fixed":"2026-09-12T12:00:00Z", "equal":"2026-09-12T14:00:00+02:00",
                    "different":"2026-09-12T14:00:01+02:00"},
                {"type":"double", "fixed":"NaN", "equal":"NaN", "different":"INF"},
                {"type":"token", "fixed":"a b", "equal":"  a \t b  ", "different":"a c"},
                {"type":"string", "fixed":" a ", "equal":" a ", "different":"a"},
                {"type":"anySimpleType", "fixed":"17", "equal":"17", "different":"18"}) {
            string source = schema('<xs:element name="root" type="xs:' + item.type + '" fixed="' + item.fixed + '"/>');
            foreach string lexical in (item.fixed, item.equal) {
                check(source, '<root xmlns:p="urn:part" xmlns:q="urn:part">' + lexical + '</root>', True);
            }
            check(source, '<root xmlns:p="urn:part" xmlns:q="urn:part">' + item.different + '</root>', False);
        }
        foreach string fixed in ("", "17", "17 0") {
            string source = schema('<xs:simpleType name="List"><xs:list itemType="xs:int"/></xs:simpleType>'
                '<xs:element name="root" type="List" fixed="' + fixed + '"/>');
            check(source, '<root>' + fixed + '</root>', True);
            check(source, '<root/>', True);
            check(source, '<root> </root>', !fixed);
            check(source, '<root>17</root>', fixed == "17");
            check(source, '<root>17 0</root>', fixed == "17 0");
            check(source, '<root>17 0 2</root>', False);
        }
    }
    private precision() {
        string value = "123456789012345678901234567890123456789012345678901234567890";
        string source = schema('<xs:element name="root" type="xs:integer" fixed="+000' + value + '"/>');
        check(source, '<root>' + value + '</root>', True);
        check(source, '<root>' + value + '1</root>', False);
        value = "17.12345678901234567890123456789";
        source = schema('<xs:element name="root" type="xs:decimal" fixed="+00' + value + '00"/>');
        check(source, '<root>' + value + '</root>', True);
        check(source, '<root>' + value + '1</root>', False);
    }
}
