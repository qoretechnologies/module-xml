#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%exec-class XmlWildcardIdsTest

class XmlWildcardIdsTest inherits QUnit::Test {
    constructor() : Test("Native wildcard ID attribute constraints", "1.0") {
        addTestCase("DOM and readers enforce assessed wildcard IDs in every attribute order", \instances());
        addTestCase("Rejected wildcard IDs leave subsequent validation usable", \recovery());
        addTestCase("ID ancestry enforces schema constraints through base types", \schemaConstraints());
        addTestCase("Interrupted and concurrent readers permit subsequent reuse", \concurrency());
        set_return_value(main());
    }
    private string schema(string processing, bool declared, bool derived, bool qualified) {
        string type = derived ? (qualified ? "t:Identifier" : "Identifier") : "xs:ID";
        return '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:wild-id"'
            + (qualified ? ' targetNamespace="urn:wild-id"' : '') + '>'
            '<xs:simpleType name="Identifier"><xs:restriction base="xs:ID"/></xs:simpleType>'
            '<xs:attribute name="first" type="' + type + '"/><xs:attribute name="second" type="' + type + '"/>'
            '<xs:element name="root"><xs:complexType>'
            + (declared ? '<xs:attribute name="id" type="' + type + '"/>' : '')
            + '<xs:anyAttribute processContents="' + processing + '"/>'
            '</xs:complexType></xs:element></xs:schema>';
    }
    private bool consume(string source, string xml) {
        XmlReader reader(new StringInputStream(xml), {"xsd":source});
        int roots = 0;
        while (reader.read()) {
            if (reader.nodeType() == XML_NODE_TYPE_ELEMENT && reader.depth() == 0) {
                ++roots;
            }
        }
        return roots == 1 && reader.isValid();
    }
    private check(string source, string xml, bool valid) {
        if (valid) {
            assertTrue(consume(source, xml));
            assertEq(parse_xml(xml), parse_xml_with_schema(xml, source));
        } else {
            assertThrows("PARSE-XML-EXCEPTION", \consume(), (source, xml));
            assertThrows("PARSE-XML-EXCEPTION", \parse_xml_with_schema(), (xml, source));
        }
    }
    private instances() {
        foreach string processing in ("strict", "lax", "skip") {
            foreach bool declared in (False, True) {
                foreach bool derived in (False, True) {
                    foreach bool qualified in (False, True) {
                        string source = schema(processing, declared, derived, qualified);
                        string prefix = qualified ? "t:" : "";
                        foreach bool present in (declared ? (False, True) : (False,)) {
                            for (int mask = 0; mask < 4; ++mask) {
                                list<string> attributes();
                                if (mask & 1) {
                                    push attributes, prefix + 'first="one"';
                                }
                                if (mask & 2) {
                                    push attributes, prefix + 'second="two"';
                                }
                                foreach bool reverse_order in (mask == 3 ? (False, True) : (False,)) {
                                    string xml = '<' + prefix + 'root xmlns:t="urn:wild-id" '
                                        + (present ? 'id="three" ' : '')
                                        + (reverse_order ? reverse(attributes) : attributes).join(" ") + '/>';
                                    check(source, xml, processing == "skip" || (!declared && mask != 3) || !mask);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    private recovery() {
        string source = schema("strict", True, True, True);
        string valid = '<t:root xmlns:t="urn:wild-id" id="one"/>';
        for (int attempt = 0; attempt < 8; ++attempt) {
            check(source, '<t:root xmlns:t="urn:wild-id" t:first="two"/>', False);
            check(source, valid, True);
        }
    }
    private schemaConstraints() {
        string definitions = '<xs:simpleType name="Identifier"><xs:restriction base="xs:ID"/></xs:simpleType> <xs:simpleType name="DeepId"><xs:restriction base="Identifier"/></xs:simpleType> <xs:simpleType name="Text"><xs:restriction base="xs:string"/></xs:simpleType> <xs:simpleType name="IdList"><xs:list itemType="xs:ID"/></xs:simpleType> <xs:simpleType name="InlineList"><xs:list><xs:simpleType><xs:restriction base="xs:ID"/> </xs:simpleType></xs:list></xs:simpleType> <xs:simpleType name="IdUnion"><xs:union memberTypes="xs:ID xs:string"/></xs:simpleType> <xs:simpleType name="InlineUnion"><xs:union><xs:simpleType><xs:restriction base="xs:ID"/> </xs:simpleType><xs:simpleType><xs:restriction base="xs:string"/></xs:simpleType></xs:union></xs:simpleType> <xs:simpleType name="ListRestriction"><xs:restriction base="IdList"/></xs:simpleType> <xs:simpleType name="UnionRestriction"><xs:restriction base="IdUnion"/></xs:simpleType>';
        list<string> shapes = (
            '<xs:complexType name="Record"><xs:attribute name="one" type="%s"/><xs:attribute name="two" type="%s"/></xs:complexType>',
            '<xs:attributeGroup name="Group"><xs:attribute name="one" type="%s"/><xs:attribute name="two" type="%s"/></xs:attributeGroup>',
            '<xs:attribute name="a" type="%s" default="one"/>',
            '<xs:attribute name="a" type="%s"/><xs:complexType name="Record"><xs:attribute ref="a" default="one"/></xs:complexType>',
            '<xs:element name="value" type="%s" default="one"/>',
            '<xs:element name="value" default="one"><xs:complexType><xs:simpleContent><xs:extension base="%s"/></xs:simpleContent></xs:complexType></xs:element>',
            '<xs:attribute name="a" type="%s" fixed="one"/>',
            '<xs:attribute name="a" type="%s"/><xs:complexType name="Record"><xs:attribute ref="a" fixed="one"/></xs:complexType>',
            '<xs:element name="value" type="%s" fixed="one"/>',
            '<xs:element name="value" fixed="one"><xs:complexType><xs:simpleContent><xs:extension base="%s"/></xs:simpleContent></xs:complexType></xs:element>'
        );
        foreach string type in ("xs:ID", "Identifier", "DeepId", "Text", "IdList", "InlineList", "IdUnion", "InlineUnion", "ListRestriction", "UnionRestriction") {
            foreach string shape in (shapes) {
                string source = '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">' + definitions
                    + sprintf(shape, type, type) + '<xs:element name="probe" type="xs:string"/></xs:schema>';
                if (type == "xs:ID" || type == "Identifier" || type == "DeepId") {
                    assertThrows("XSD-SYNTAX-ERROR", \consume(), (source, "<probe/>"));
                    assertThrows("XSD-SYNTAX-ERROR", \parse_xml_with_schema(), ("<probe/>", source));
                    XmlReader reader("<probe/>");
                    assertThrows("XSD-SYNTAX-ERROR", \reader.schemaValidateString(), (source,));
                } else {
                    check(source, "<probe/>", True);
                }
            }
        }
    }
    concurrency() {
        string good = schema("strict", False, True, True);
        Program p();
        p.parse("%modern\n%requires xml\n"
            "bool sub validate(string schema, SandboxManager manager, bool cancel) {\n"
            "    if (cancel) { manager.requestInterrupt(); }\n"
            "    XmlReader reader(\"<t:root xmlns:t='urn:wild-id' t:first='one'/>\");\n"
            "    reader.schemaValidateString(schema); while (reader.read()) {} return reader.isValid();\n"
            "}\n", get_script_dir() + "/wildcard-id-cancellation.qr");
        SandboxManager manager();
        on_exit manager.clearInterrupt();
        p.setSandboxManager(manager);
        try {
            p.callFunction("validate", good, manager, True);
            fail("expected cancellation");
        } catch (hash<ExceptionInfo> ex) {
            assertTrue(ex.err == "THREAD-CANCELLED" || ex.err == "PROGRAM-INTERRUPTED", ex.err);
        }
        manager.clearInterrupt();
        assertTrue(p.callFunction("validate", good, manager, False));
        Qore::Thread::Queue results();
        Qore::Thread::Counter running();
        on_exit assertEq(0, running.waitForZero(30s));
        for (int worker = 0; worker < 2; ++worker) {
            running.inc();
            background sub() {
                on_exit running.dec();
                try {
                    for (int index = 0; index < 10; ++index) {
                        @assert(consume(good, "<t:root xmlns:t='urn:wild-id' t:first='one'/>"));
                    }
                    results.push(True);
                } catch (hash<ExceptionInfo> ex) {
                    results.push(ex);
                }
            }();
        }
        for (int worker = 0; worker < 2; ++worker) {
            assertEq(True, results.get(30s));
        }
    }
}
