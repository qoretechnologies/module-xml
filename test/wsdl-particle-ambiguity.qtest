#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class ParticleAmbiguityTest

class ParticleAmbiguityTest inherits QUnit::Test {
    constructor() : Test("Exact XSD particle attribution", "1.0") {
        addTestCase("Unique positions accept exact counts and disjoint alternatives", \unique());
        addTestCase("Competing positions reject without lookahead", \ambiguous());
        addTestCase("Nested count flexibility distinguishes two and three iterations", \flexibility());
        addTestCase("Weak determinism permits ambiguous repetition boundaries", \weak());
        addTestCase("Arbitrary-size count thresholds preserve adjacent integers", \largeCounts());
        addTestCase("Shared group summaries retain each reference context", \shared());
        addTestCase("Unused groups still satisfy component constraints", \unusedGroups());
        addTestCase("Extensions attribute base and added particles together", \extensions());
        addTestCase("Expanded names and element wildcards determine overlaps", \namespaces());
        addTestCase("Empty and omitted particles reduce their actual languages", \empty());
        addTestCase("Rejected models preserve existing shared declarations", \recovery());
        addTestCase("Large shared DAGs and wide alternatives stay compact", \largeGraphs());
        addTestCase("Interrupted attribution checks permit subsequent reuse", \cancellation());
        addTestCase("Concurrent attribution checks keep local state", \concurrency());
        set_return_value(main());
    }

    private string element(string name, string attributes = "") {
        return sprintf('<xs:element name="%s" type="xs:string" %s/>', name, attributes);
    }

    private XsdParticle model(string content, string declarations = "") {
        XsdSchema schema('<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:particles"
            targetNamespace="urn:particles">' + declarations + '<xs:complexType name="Record">'
            + content + '</xs:complexType></xs:schema>');
        return cast<XsdComplexType>(schema.findType("Record")).getParticle();
    }

    private bool deterministic(XsdParticle particle) {
        particle.validateDeterminism();
        return True;
    }

    private check(string content, bool valid, string declarations = "") {
        if (!valid) {
            assertThrows("WSDL-ERROR", \model(), (content, declarations), content);
            return;
        }
        XsdParticle original = model(content, declarations);
        foreach XsdParticle particle in (original, Serializable::deserialize(original.serialize())) {
            assertTrue(deterministic(particle), content);
        }
    }

    unique() {
        check('<xs:sequence>' + element("a", 'minOccurs="2" maxOccurs="2"') + element("a") + '</xs:sequence>', True);
        check('<xs:sequence>' + element("a") + element("a", 'minOccurs="0" maxOccurs="unbounded"')
            + '</xs:sequence>', True);
        check('<xs:choice><xs:sequence>' + element("a") + element("b") + '</xs:sequence><xs:sequence>'
            + element("b") + element("a") + '</xs:sequence></xs:choice>', True);
        check('<xs:all>' + element("a") + element("b", 'minOccurs="0"') + '</xs:all>', True);
    }

    ambiguous() {
        check('<xs:choice>' + element("a") + element("a") + '</xs:choice>', False);
        check('<xs:sequence>' + element("a", 'minOccurs="0"') + element("a") + '</xs:sequence>', False);
        check('<xs:sequence>' + element("a", 'minOccurs="2" maxOccurs="3"') + element("a")
            + '</xs:sequence>', False);
        check('<xs:choice><xs:sequence>' + element("a") + element("b") + '</xs:sequence><xs:sequence>'
            + element("a") + element("c") + '</xs:sequence></xs:choice>', False);
        check('<xs:sequence maxOccurs="2">' + element("a") + element("a", 'minOccurs="0"')
            + '</xs:sequence>', False);
    }

    private string counted(string count, string low = "2", string high = "3") {
        return '<xs:sequence>' + sprintf('<xs:sequence minOccurs="%s" maxOccurs="%s">', count, count)
            + element("b", 'minOccurs="0"')
            + sprintf('<xs:sequence minOccurs="%s" maxOccurs="%s">', low, high) + element("a")
            + '</xs:sequence></xs:sequence>' + element("b") + '</xs:sequence>';
    }

    flexibility() {
        check(counted("2"), True);
        check(counted("3"), False);
        check(counted("4"), False);
        check('<xs:sequence><xs:sequence minOccurs="2" maxOccurs="2">'
            + element("a", 'minOccurs="2" maxOccurs="3"') + '</xs:sequence>' + element("a")
            + '</xs:sequence>', False);
    }

    weak() {
        check('<xs:sequence minOccurs="1" maxOccurs="2">' + element("a", 'minOccurs="1" maxOccurs="2"')
            + '</xs:sequence>', True);
        check('<xs:sequence minOccurs="3" maxOccurs="4">' + element("a", 'minOccurs="0"')
            + '</xs:sequence>', True);
        check('<xs:choice minOccurs="0" maxOccurs="unbounded">' + element("a") + element("b")
            + '</xs:choice>', True);
    }

    largeCounts() {
        string low = strmul("9", 80);
        string high = "1" + strmul("0", 80);
        check(counted(low, low, high), True);
        check(counted(high, low, high), False);
        check('<xs:sequence>' + sprintf('<xs:sequence minOccurs="%s" maxOccurs="%s">', high, high)
            + element("a") + '</xs:sequence>' + element("a") + '</xs:sequence>', True);
    }

    shared() {
        string group = '<xs:group name="Fields"><xs:sequence>' + element("a") + '</xs:sequence></xs:group>';
        check('<xs:sequence><xs:group ref="t:Fields"/><xs:group ref="t:Fields"/></xs:sequence>', True, group);
        check('<xs:sequence><xs:group ref="t:Fields" minOccurs="0"/><xs:group ref="t:Fields"/></xs:sequence>', False, group);
        group = '<xs:group name="Fields"><xs:sequence>' + element("b", 'minOccurs="0"')
            + element("a", 'minOccurs="2" maxOccurs="3"') + '</xs:sequence></xs:group>';
        foreach string count in ("2", "3") {
            check('<xs:sequence><xs:group ref="t:Fields" minOccurs="2" maxOccurs="2"/>' + element("c")
                + sprintf('<xs:group ref="t:Fields" minOccurs="%s" maxOccurs="%s"/>', count, count)
                + element("b") + '</xs:sequence>', count == "2", group);
        }
    }

    namespaces() {
        check('<xs:choice>' + element("a") + element("a", 'form="qualified"') + '</xs:choice>', True);
        check('<xs:choice>' + element("a") + '<xs:any namespace="##other"/></xs:choice>', True);
        check('<xs:choice>' + element("a", 'form="qualified"') + '<xs:any namespace="##other"/></xs:choice>', True);
        check('<xs:choice>' + element("a") + '<xs:any namespace="##local"/></xs:choice>', False);
        check('<xs:choice>' + element("a", 'form="qualified"') + '<xs:any namespace="##targetNamespace"/></xs:choice>', False);
        check('<xs:choice><xs:any namespace="urn:a"/><xs:any namespace="urn:b"/></xs:choice>', True);
        check('<xs:choice><xs:any namespace="urn:a urn:b"/><xs:any namespace="urn:b"/></xs:choice>', False);
        check('<xs:choice><xs:any namespace="##any"/><xs:any namespace="##other"/></xs:choice>', False);
        XsdParticle declarations = model('<xs:sequence>' + element("a") + element("b", 'form="qualified"')
            + '</xs:sequence>');
        assertEq("", declarations.getChildren()[0].getElement().getNamespaceUri());
        assertEq("urn:particles", declarations.getChildren()[1].getElement().getNamespaceUri());
    }

    unusedGroups() {
        check('<xs:sequence/>', False, '<xs:group name="Unused"><xs:choice>' + element("a")
            + element("a") + '</xs:choice></xs:group>');
        check('<xs:sequence/>', True, '<xs:group name="Unused"><xs:sequence>'
            + element("a", 'minOccurs="2" maxOccurs="2"') + element("a") + '</xs:sequence></xs:group>');
    }

    extensions() {
        string content = '<xs:complexContent><xs:extension base="t:Base"><xs:sequence>'
            + element("a") + '</xs:sequence></xs:extension></xs:complexContent>';
        foreach string maximum in ("2", "3") {
            check(content, maximum == "2", '<xs:complexType name="Base"><xs:sequence>'
                + element("a", sprintf('minOccurs="2" maxOccurs="%s"', maximum))
                + '</xs:sequence></xs:complexType>');
        }
    }

    empty() {
        check('<xs:choice/>', True);
        check('<xs:sequence/>', True);
        check('<xs:choice><xs:sequence/>' + element("a") + '</xs:choice>', True);
        check('<xs:choice>' + element("a", 'minOccurs="0" maxOccurs="0"') + element("a") + '</xs:choice>', True);
        check('<xs:sequence><xs:choice/>' + '<xs:choice>' + element("a") + element("a")
            + '</xs:choice></xs:sequence>', False);
        check('<xs:sequence><xs:sequence minOccurs="0" maxOccurs="0"><xs:choice>'
            + element("a") + element("a") + '</xs:choice></xs:sequence>' + element("b")
            + '</xs:sequence>', True);
    }

    largeGraphs() {
        string declarations = '<xs:group name="G0"><xs:sequence>' + element("a") + '</xs:sequence></xs:group>';
        for (int index = 1; index <= 30; ++index) {
            declarations += sprintf('<xs:group name="G%d"><xs:sequence><xs:group ref="t:G%d"/>'
                '<xs:group ref="t:G%d"/></xs:sequence></xs:group>', index, index - 1, index - 1);
        }
        check('<xs:group ref="t:G30"/>', True, declarations);
        string choices;
        for (int index = 0; index < 1000; ++index) {
            choices += element("v" + index.toString());
        }
        check('<xs:choice>' + choices + '</xs:choice>', True);
        check('<xs:choice>' + choices + element("v999") + '</xs:choice>', False);
    }

    recovery() {
        string header = '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:particles"'
            ' targetNamespace="urn:particles">';
        XsdSchema original(header + '<xs:group name="Fields"><xs:sequence>' + element("a")
            + '</xs:sequence></xs:group><xs:complexType name="Record"><xs:group ref="t:Fields"/>'
            + '</xs:complexType></xs:schema>');
        foreach XsdSchema schema in (original, Serializable::deserialize(original.serialize())) {
            XsdComplexType before = cast<XsdComplexType>(schema.findType("Record"));
            assertThrows("WSDL-ERROR", \schema.addSchemaString(), (header
                + '<xs:complexType name="Broken"><xs:sequence><xs:group ref="t:Fields" minOccurs="0"/>'
                + '<xs:group ref="t:Fields"/></xs:sequence></xs:complexType></xs:schema>',));
            assertEq(1, before.elementmap.a.minOccurs);
            assertEq(1, before.elementmap.a.maxOccurs);
            assertTrue(before.elementmap.a.isRequired());
            assertEq({"a": "ok"}, before.deserializeValue("Record", schema.getTypeMap(), NOTHING, {"a": "ok"}));
            schema.addSchemaString(header + '<xs:complexType name="Added"><xs:sequence>' + element("b")
                + '</xs:sequence></xs:complexType></xs:schema>');
            assertEq("Added", schema.findType("Added").name);
        }
    }

    cancellation() {
        XsdParticle particle = model(counted("2"));
        SandboxManager manager();
        on_exit manager.clearInterrupt();
        Program program(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
        program.setSandboxManager(manager);
        program.parse("%modern\n%requires ../qlib/WSDL.qm\n"
            "bool sub check(XsdParticle particle, SandboxManager manager, bool cancel) {\n"
            "    if (cancel) { manager.requestInterrupt(); }\n"
            "    particle.validateDeterminism();\n"
            "    return True;\n"
            "}\n", get_script_dir() + "/particle-attribution-cancellation.qr");
        *hash<ExceptionInfo> error;
        try {
            program.callFunction("check", particle, manager, True);
        } catch (hash<ExceptionInfo> ex) {
            error = ex;
        }
        manager.clearInterrupt();
        assertEq("PROGRAM-INTERRUPTED", error.err);
        assertTrue(program.callFunction("check", particle, manager, False));
    }

    concurrency() {
        XsdParticle particle = model(counted("2"));
        Qore::Thread::Queue ready();
        Qore::Thread::Queue start();
        Qore::Thread::Queue results();
        Qore::Thread::Counter running();
        on_exit {
            for (int index = 0; index < 4; ++index) {
                start.push(True);
            }
            assertEq(0, running.waitForZero(30s));
        }
        for (int index = 0; index < 4; ++index) {
            running.inc();
            background sub () {
                on_exit running.dec();
                try {
                    ready.push(True);
                    start.get(30s);
                    int accepted = 0;
                    for (int call = 0; call < 5; ++call) {
                        particle.validateDeterminism();
                        ++accepted;
                    }
                    results.push({"accepted": accepted});
                } catch (hash<ExceptionInfo> ex) {
                    results.push({"error": ex});
                }
            }();
        }
        for (int index = 0; index < 4; ++index) {
            ready.get(30s);
        }
        for (int index = 0; index < 4; ++index) {
            start.push(True);
        }
        for (int index = 0; index < 4; ++index) {
            assertEq({"accepted": 5}, results.get(30s));
        }
    }
}
