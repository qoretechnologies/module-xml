%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"

%requires HttpServer
%requires WebDavHandler
%requires QUnit
%requires FsUtil
%requires Logger
%requires Mime
%requires xml

%exec-class Main

# minimal HTTP server for this test suite
class Server inherits HttpServer {
    private {
        int port;
    }

    constructor(hash<HttpServerOptionInfo> http_opts, WebDavHandler::AbstractWebDavHandler handler) : HttpServer(http_opts) {
        setHandler("webdavhandler", "/", NOTHING, handler);
        setDefaultHandler("webdavhandler", handler);

        map addHttpMethod($1), handler.getHttpMethods();

        port = addListener(<HttpListenerOptionInfo>{"service": 0}).port;
    }

    int getPort() {
        return port;
    }

} # class Server

class Client inherits HTTPClient {
    constructor(string url)
            : HTTPClient({
                "url": url,
                "additional_methods": WebDavHandler::AbstractWebDavHandler::RequestMethods,
            }) {
    }
}

class Main inherits QUnit::Test {
    constructor() : QUnit::Test("webdavhandler", "1.0") {
        addTestCase("FS webdavhandler test", \test());
        addTestCase("uploaded text retains representation bytes", \uploadedBytes());
        addTestCase("property responses declare XML media types", \xmlResponseTypes());
        addTestCase("proxy constructors and mounted routes", \proxyRoutes());
        addTestCase("path traversal is refused", \pathTraversal());

        set_return_value(main());
    }

    #! Sends an HTTP request with the request path used verbatim, so ".." components reach the server unnormalized
    /** An HTTPClient normalizes the request path before sending, which would hide path-traversal payloads, so this
        test sends the raw request line itself.
    */
    private hash<auto> rawRequest(int port, string method, string path, *hash<auto> extra_hdr, *data body) {
        Socket s();
        s.connect("127.0.0.1:" + port);
        on_exit s.close();
        string req = sprintf("%s %s HTTP/1.1\r\nHost: 127.0.0.1:%d\r\nConnection: close\r\n", method, path, port);
        foreach hash<auto> i in (extra_hdr.pairIterator()) {
            req += sprintf("%s: %s\r\n", i.key, i.value);
        }
        req += sprintf("Content-Length: %d\r\n\r\n", body ? body.size() : 0);
        s.send(req);
        if (body) {
            s.send(body);
        }
        hash<auto> resp = s.readHTTPHeader(10s);
        *data rbody;
        if (resp."content-length" && resp."content-length".toInt() > 0) {
            rbody = s.recv(resp."content-length".toInt(), 10s);
        } else if (resp."transfer-encoding" == "chunked") {
            rbody = s.readHTTPChunkedBody(10s).body;
        }
        return {"status": resp.status_code, "body": rbody};
    }

    private pathTraversal() {
        TmpDir root();
        Dir d();
        d.chdir(root.path);
        d.mkdir("base");
        d.mkdir("outside");
        string base = root.path + "/base";
        string outside = root.path + "/outside";
        {
            File f();
            f.open2(outside + "/secret.txt", O_CREAT | O_WRONLY | O_TRUNC);
            f.write("TOP-SECRET");
        }
        {
            File f();
            f.open2(base + "/inside.txt", O_CREAT | O_WRONLY | O_TRUNC);
            f.write("inside");
        }
        Dir bd();
        bd.chdir(base);
        bd.mkdir("sub");

        WebDavHandler::FsWebDavHandler handler(base);
        Server srv(<HttpServerOptionInfo>{"debug": True}, handler);
        on_exit srv.stop();
        int port = srv.getPort();

        # read traversal: the secret file outside the root must never be served, and the response must be refused
        foreach string path in ("/../outside/secret.txt", "/sub/../../outside/secret.txt", "//../outside/secret.txt") {
            hash<auto> r = rawRequest(port, "GET", path);
            assertEq(403, r.status, "GET " + path);
            assertFalse(exists r.body && r.body =~ /TOP-SECRET/, "no leak: GET " + path);
        }
        # directory listing outside the root must be refused
        assertEq(403, rawRequest(port, "PROPFIND", "/../outside", {"Depth": "1"}).status);

        # write methods outside the root must be refused and must not change the filesystem
        assertEq(403, rawRequest(port, "PUT", "/../outside/put.txt", NOTHING, "x").status);
        assertFalse(is_file(outside + "/put.txt"));
        assertEq(403, rawRequest(port, "MKCOL", "/../outside/newdir").status);
        assertFalse(is_dir(outside + "/newdir"));
        {
            File f();
            f.open2(outside + "/delme.txt", O_CREAT | O_WRONLY | O_TRUNC);
            f.write("x");
        }
        assertEq(403, rawRequest(port, "DELETE", "/../outside/delme.txt").status);
        assertTrue(is_file(outside + "/delme.txt"));

        # COPY/MOVE must enforce containment on both the source path and the Destination header
        assertEq(403, rawRequest(port, "COPY", "/inside.txt", {"Destination": "/../outside/copied.txt"}).status);
        assertFalse(is_file(outside + "/copied.txt"));
        assertEq(403, rawRequest(port, "COPY", "/../outside/secret.txt", {"Destination": "/stolen.txt"}).status);
        assertFalse(is_file(base + "/stolen.txt"));
        {
            File f();
            f.open2(base + "/tomove.txt", O_CREAT | O_WRONLY | O_TRUNC);
            f.write("m");
        }
        assertEq(403, rawRequest(port, "MOVE", "/tomove.txt", {"Destination": "/../outside/moved.txt"}).status);
        assertFalse(is_file(outside + "/moved.txt"));
        assertTrue(is_file(base + "/tomove.txt"));

        # a symbolic link inside the root that points outside it must not provide an escape hatch either
        if (PlatformOS != "Windows") {
            symlink(outside, base + "/link");
            assertEq(403, rawRequest(port, "GET", "/link/secret.txt").status);
            assertEq(403, rawRequest(port, "PUT", "/link/via-symlink.txt", NOTHING, "x").status);
            assertFalse(is_file(outside + "/via-symlink.txt"));
        }

        # legitimate requests inside the root are unaffected by the containment check
        assertEq("inside", rawRequest(port, "GET", "/inside.txt").body.toString());
        assertEq(201, rawRequest(port, "PUT", "/created.txt", NOTHING, "ok").status);
        assertTrue(is_file(base + "/created.txt"));
        assertEq(201, rawRequest(port, "MKCOL", "/sub2").status);
        assertTrue(is_dir(base + "/sub2"));
    }

    private uploadedBytes() {
        TmpDir tmp();
        WebDavHandler::FsWebDavHandler handler(tmp.path);
        Server srv(<HttpServerOptionInfo>{"debug": True}, handler);
        on_exit srv.stop();
        Client client("http://127.0.0.1:" + srv.getPort());
        foreach string method in ("PUT", "POST") {
            foreach string encoding in ("ISO-8859-1", "UTF-8") {
                binary payload = convert_encoding("café", encoding).toBinary();
                hash<auto> result = client.send(payload, method, "/upload.bin",
                    {"Content-Type": "text/plain; charset=" + encoding}, True);
                assertTrue(result.status_code == 201 || result.status_code == 200 || result.status_code == 204);
                {
                    File stored();
                    stored.open2(tmp.path + "/upload.bin", O_RDONLY);
                    assertEq(payload, stored.readBinary(payload.size() + 1));
                }
                assertEq(payload, client.send(NOTHING, "GET", "/upload.bin", NOTHING, True).body);
                client.send(NOTHING, "DELETE", "/upload.bin");
            }
        }
    }

    private xmlResponseTypes() {
        TmpDir tmp();
        WebDavHandler::FsWebDavHandler handler(tmp.path);
        Server srv(<HttpServerOptionInfo>{"debug": True}, handler);
        on_exit srv.stop();
        Client client("http://127.0.0.1:" + srv.getPort());
        assertEq(201, client.send("test", "PUT", "/resource").status_code);
        foreach *string body in (NOTHING, "<propfind xmlns='DAV:'><allprop/></propfind>") {
            hash<auto> response = client.send(body, "PROPFIND", "/resource", {"Depth": "0", "Accept-Charset": "ISO-8859-1"});
            assertEq(207, response.status_code);
            assertEq(MimeTypeXml, response."content-type".split(";")[0]);
            assertEq("text/xml; charset=UTF-8", response."_qore_orig_content_type");
            assertTrue(exists parse_xml(response.body)."DAV:multistatus"."DAV:response");
        }
        hash<auto> response = client.send("<propertyupdate xmlns='DAV:'><set><prop>"
            "<label xmlns='urn:test'>café</label></prop></set></propertyupdate>",
            "PROPPATCH", "/resource", {"Content-Type": MimeTypeXml});
        assertEq(207, response.status_code);
        assertEq(MimeTypeXml, response."content-type".split(";")[0]);
        assertTrue(exists parse_xml(response.body)."DAV:multistatus"."DAV:response");
        response = client.send("<propfind xmlns='DAV:'><prop><label xmlns='urn:test'/></prop></propfind>",
            "PROPFIND", "/resource", {"Content-Type": MimeTypeXml, "Depth": "0"});
        assertEq(207, response.status_code);
        assertEq(MimeTypeXml, response."content-type".split(";")[0]);
        assertTrue(response.body =~ /café/);
        # An ordinary resource GET must retain its own media type and bytes.
        response = client.send(NOTHING, "GET", "/resource", NOTHING, True);
        assertEq(MimeTypeOctetStream, response."content-type".split(";")[0]);
        assertEq("test".toBinary(), response.body);

        WebDavHandler::WebDavHandlerProxy proxy({"files": handler});
        Server proxy_srv(<HttpServerOptionInfo>{"debug": True}, proxy);
        on_exit proxy_srv.stop();
        Client proxy_client("http://127.0.0.1:" + proxy_srv.getPort());
        response = proxy_client.send(NOTHING, "PROPFIND", "/", {"Depth": "1"});
        assertEq(207, response.status_code);
        assertEq(MimeTypeXml, response."content-type".split(";")[0]);
        assertTrue(response.body =~ /files/);
        hash<auto> listing = parse_xml(response.body)."DAV:multistatus"."DAV:response";
        assertEq("/files", listing."DAV:href");
    }

    private proxyRoutes() {
        TmpDir tmp();
        File file();
        file.open2(tmp.path + "/resource", O_WRONLY | O_CREAT, 0600);
        file.write("mounted content");
        file.close();
        Logger logger("proxy", LoggerLevel::getLevelInfo());
        WebDavHandler::FsWebDavHandler child(tmp.path, NOTHING, "/files");
        WebDavHandler::FsWebDavHandler mounted(tmp.path, NOTHING, "/dav/files");
        foreach hash<auto> row in (
                {"handler": new WebDavHandler::WebDavHandlerProxy({"files": child}), "base": ""},
                {"handler": new WebDavHandler::WebDavHandlerProxy({"files": mounted}, "/dav"), "base": "/dav"},
                {"handler": new WebDavHandler::WebDavHandlerProxy({"files": mounted}, logger, "/dav"), "base": "/dav"}) {
            Server srv(<HttpServerOptionInfo>{"debug": True}, row.handler);
            on_exit srv.stop();
            Client client("http://127.0.0.1:" + srv.getPort());
            assertEq("mounted content".toBinary(), client.send(NOTHING, "GET", row.base + "/files/resource").body);
            hash<auto> response = client.send(NOTHING, "PROPFIND", row.base + "/", {"Depth": "1"});
            assertEq(207, response.status_code);
            assertEq(row.base + "/files", parse_xml(response.body)."DAV:multistatus"."DAV:response"."DAV:href");
            string resource = row.base + "/files/resource";
            response = client.send(NOTHING, "PROPFIND", resource, {"Depth": "0"});
            assertEq(resource, parse_xml(response.body)."DAV:multistatus"."DAV:response"."DAV:href");
            string origin = "http://127.0.0.1:" + srv.getPort();
            assertEq(201, client.send(NOTHING, "COPY", resource,
                {"Destination": origin + row.base + "/files/copy"}).status_code);
            assertEq("mounted content".toBinary(), client.send(NOTHING, "GET", row.base + "/files/copy").body);
            assertEq(201, client.send(NOTHING, "MOVE", row.base + "/files/copy",
                {"Destination": origin + row.base + "/files/moved"}).status_code);
            assertEq("mounted content".toBinary(), client.send(NOTHING, "GET", row.base + "/files/moved").body);
            assertEq(204, client.send(NOTHING, "DELETE", row.base + "/files/moved").status_code);
            assertThrows("HTTP-CLIENT-RECEIVE-ERROR", sub () {
                client.send(NOTHING, "GET", row.base + "/missing");
            });
        }
    }

    # test presence of extended HTTP methods in the server
    private test() {
        TmpDir tmp();
        WebDavHandler::FsWebDavHandler handler(tmp.path);

        Logger logger("test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new TestAppender());
        }
        hash<HttpServerOptionInfo> http_opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        };

        Server srv(http_opts, handler);
        if (m_options.verbose > 2) {
            map srv.setListenerLogOptionsID($1, -1), keys srv.getListeners();
        }

        on_exit {
            srv.stop();
        }

        date start = now();

        TmpFile tmp_file(NOTHING, ".txt", tmp.path);
        tmp_file.file.printf("test");
        tmp_file.file.close();

        Client wd("http://localhost:" + srv.getPort());

        hash<auto> info;
        on_error printf("info: %N\n", info);

        hash<auto> req = {
            "DAV:propfind": {
                "^attributes^": {
                    "xmlns:DAV": "DAV:",
                },
                "DAV:prop": {
                    "DAV:creationdate": NOTHING,
                    "DAV:getlastmodified": NOTHING,
                    "DAV:getcontentlength": NOTHING,
                },
            },
        };

        string req_xml = make_xml(req);
        string xml;
        hash<auto> wd_data;
        date creation_date;
        date last_modified_date;
        hash<auto> props;
        # GMT time zone
        TimeZone gmt(0);
        {
            on_error printf("REQUEST XML: %s\n", req_xml);
            xml = wd.send(req_xml, "PROPFIND", basename(tmp_file.path), NOTHING, NOTHING, \info).body;
            wd_data = parse_xml(xml);
            on_error
                printf("response data: %N\n", wd_data);

            props = wd_data."DAV:multistatus"."DAV:response"."DAV:propstat"."DAV:prop";
            creation_date = date(props."DAV:creationdate");
            assertGe(start, creation_date);
            last_modified_date = gmt.date(props."DAV:getlastmodified"[5..], "DD Mon YYYY HH:mm:SS");
            assertGe(start, last_modified_date);
            assertEq(4, props."DAV:getcontentlength".toInt());
        }

        req = {
            "DAV:propfind": {
                "^attributes^": {
                    "xmlns:DAV": "DAV:",
                },
                "DAV:allprop": NOTHING,
            },
        };

        req_xml = make_xml(req);
        xml = wd.send(req_xml, "PROPFIND", basename(tmp_file.path), NOTHING, NOTHING, \info).body;
        #printf("response XML: %s\n", xml);
        wd_data = parse_xml(xml);
        #printf("response data: %N\n", wd_data);

        props = wd_data."DAV:multistatus"."DAV:response"."DAV:propstat"."DAV:prop";
        creation_date = date(props."DAV:creationdate");
        assertGe(start, creation_date);
        last_modified_date = gmt.date(props."DAV:getlastmodified"[5..], "DD Mon YYYY HH:mm:SS");
        assertGe(start, last_modified_date);
        assertEq(4, props."DAV:getcontentlength".toInt());

        xml = wd.send(NOTHING, "PROPFIND", basename(tmp_file.path), NOTHING, NOTHING, \info).body;
        #printf("response XML: %s\n", xml);
        wd_data = parse_xml(xml);
        #printf("response data: %N\n", wd_data);

        props = wd_data."DAV:multistatus"."DAV:response"."DAV:propstat"."DAV:prop";
        creation_date = date(props."DAV:creationdate");
        assertGe(start, creation_date);
        last_modified_date = gmt.date(props."DAV:getlastmodified"[5..], "DD Mon YYYY HH:mm:SS");
        assertGe(start, last_modified_date);
        assertEq(4, props."DAV:getcontentlength".toInt());

        xml = wd.send(NOTHING, "PROPFIND", "/", NOTHING, NOTHING, \info).body;
        #printf("response XML: %s\n", xml);
        wd_data = parse_xml(xml);

        #printf("response data: %N\n", wd_data);

        props = wd_data."DAV:multistatus"."DAV:response"[0]."DAV:propstat"."DAV:prop";
        creation_date = date(props."DAV:creationdate");
        assertGe(start, creation_date);
        last_modified_date = gmt.date(props."DAV:getlastmodified"[5..], "DD Mon YYYY HH:mm:SS");
        assertGe(start, last_modified_date);
        assertEq(NOTHING, props."DAV:getcontentlength");

        props = wd_data."DAV:multistatus"."DAV:response"[1]."DAV:propstat"."DAV:prop";
        creation_date = date(props."DAV:creationdate");
        assertGe(start, creation_date);
        last_modified_date = gmt.date(props."DAV:getlastmodified"[5..], "DD Mon YYYY HH:mm:SS");
        assertGe(start, last_modified_date);
        assertEq(4, props."DAV:getcontentlength".toInt());

        # check our initial file
        hash<auto> resp;
        {
            on_error printf("resp: %N\n", resp);
            resp = wd.send(NOTHING, "GET", basename(tmp_file.path), NOTHING, NOTHING, \info);
            assertEq("chunked", resp."transfer-encoding");
            assertEq("test", resp.body);
        }

        # push a file to the server
        string filename = get_random_string() + ".txt";
        string content = get_random_string();
        resp = wd.send(content, "POST", filename, NOTHING, NOTHING, \info);
        assertEq(201, resp.status_code);

        # retrieve the file we just pushed
        {
            on_error printf("resp: %N\n", resp);
            resp = wd.send(NOTHING, "GET", filename, NOTHING, NOTHING, \info);
            assertEq("chunked", resp."transfer-encoding");
            assertEq(content, resp.body);
        }

        # stream a new file to the server
        filename = get_random_string() + ".txt";
        content = get_random_string();

        StringInputStream is(content);
        code send = auto sub () {
            return is.read(4096);
        };
        # HTTPClient::sendWithSendCallback handles the connection lifecycle (open, send the
        # streamed body, read the response, close as appropriate); the previous form used
        # Socket::sendHTTPMessageWithCallback inherited via the HTTPClient base, which requires
        # the underlying socket to be open already and is not the right level of abstraction
        # for a connection that's been auto-closed by previous wd.send() calls.
        resp = wd.sendWithSendCallback(send, "POST", filename, {"Transfer-Encoding": "chunked"},
            5s, True, \info);
        assertEq(201, resp.status_code);

        # retrieve the file we just pushed
        resp = wd.send(NOTHING, "GET", filename, NOTHING, NOTHING, \info);
        assertEq("chunked", resp."transfer-encoding");
        assertEq(content, resp.body);
    }
} # class Main

class TestAppender inherits LoggerAppenderWithLayout {
    constructor() : LoggerAppenderWithLayout("test", new LoggerLayoutPattern("%d T%t [%p]: %m%n")) {
        open();
    }

    processEventImpl(int type, auto params) {
        switch (type) {
            case EVENT_LOG:
                print(params);
                break;
        }
    }
}
