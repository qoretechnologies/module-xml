#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class IntegerLexicalTest

class IntegerLexicalTest inherits QUnit::Test {
    constructor() : QUnit::Test("XSD integer lexical validation", "1.0") {
        foreach string name in ("integer", "long", "int", "short", "byte", "unsignedLong", "unsignedInt",
                "unsignedShort", "unsignedByte", "positiveInteger", "negativeInteger", "nonPositiveInteger",
                "nonNegativeInteger") {
            addTestCase(name + " lexical space", \lexical(), name);
        }
        addTestCase("Attribute and simple-content reconstruction", \attributes());
        addTestCase("Integer list and union alternatives", \collections());
        addTestCase("XML whitespace excludes other spacing characters", \whitespace());
        set_return_value(main());
    }

    lexical(string name) {
        Namespaces nsc({});
        XsdBaseType type = nsc.getBaseType(name);
        hash<string, XsdAbstractType> types = {};
        foreach string value in ("", " ", "\t\r\n", "+", "-", "1.0", "1e2", "0x10", "12tail",
                "invalid", "1 2", "--1", "+-1", "INF", "NaN", "true", "١", "１２", "\x0c1", "1\x0b",
                "1\u00a0", "1\x00trailing") {
            assertThrows("SOAP-SERIALIZATION-ERROR", \type.serializeValue(), (nsc, value, True), name + " " + value);
            assertThrows("SOAP-DESERIALIZATION-ERROR", \type.deserializeValue(),
                ("value", types, NOTHING, value), name + " " + value);
        }
        list<string> valid = name == "negativeInteger" || name == "nonPositiveInteger"
            ? ("-1", "-001", " \t-001\r\n") : ("1", "001", " \t001\r\n");
        if (name !~ /^unsigned/ && name != "negativeInteger" && name != "nonPositiveInteger") {
            valid += "+001";
        }
        int expected = name == "negativeInteger" || name == "nonPositiveInteger" ? -1 : 1;
        foreach string value in (valid) {
            auto decoded = type.deserializeValue("value", types, NOTHING, value);
            if (name == "integer") {
                assertTrue(decoded.typeCode() == NT_INT || decoded.typeCode() == NT_STRING);
                assertEq(number(expected), number(decoded));
            } else {
                assertEq(expected, decoded);
            }
            assertEq(XsdSimpleType::normalizeWhiteSpace(value, "collapse"), type.serializeValue(nsc, value, True));
            assertEq(decoded, type.deserializeValue("value", types, NOTHING, type.serializeValue(nsc, value, True)));
        }
        foreach auto value in (NOTHING, NULL, True, (1, 2), binary("1"), {"child": "1"}) {
            assertThrows("SOAP-SERIALIZATION-ERROR", \type.serializeValue(), (nsc, value, True));
            assertThrows("SOAP-DESERIALIZATION-ERROR", \type.deserializeValue(), ("value", types, NOTHING, value));
        }
        if (name =~ /^unsigned/) {
            foreach string value in ("+1", "-0", "+0", "+001") {
                assertThrows("SOAP-SERIALIZATION-ERROR", \type.serializeValue(), (nsc, value, True));
                assertThrows("SOAP-DESERIALIZATION-ERROR", \type.deserializeValue(), ("value", types, NOTHING, value));
            }
        } else if (name != "negativeInteger" && name != "positiveInteger") {
            foreach string value in ("-0", "+0", "-000", "+000") {
                assertEq(0n, number(type.deserializeValue("value", types, NOTHING, value)));
                assertEq(value, type.serializeValue(nsc, value, True));
            }
        }
    }

    private XsdSchema schema(string declarations) {
        return new XsdSchema('<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:integer"
            targetNamespace="urn:integer">' + declarations + '</xs:schema>', {"async_only": True});
    }

    whitespace() {
        assertEq("1 2", XsdSimpleType::normalizeWhiteSpace(" \t1\r\n2 ", "collapse"));
        assertEq(" 1  2 ", XsdSimpleType::normalizeWhiteSpace("\t1\r\n2 ", "replace"));
        foreach string value in ("\x0b1\x0b", "\x0c1\x0c", "\u00a01\u00a0") {
            assertEq(value, XsdSimpleType::normalizeWhiteSpace(value, "collapse"));
        }
        assertEq("", XsdSimpleType::normalizeWhiteSpace("\t\r\n ", "collapse"));
        Namespaces nsc({});
        XsdBaseType token = nsc.getBaseType("token");
        string text = "\u00a0value\u00a0";
        assertEq(text, token.serializeValue(nsc, " \t" + text + " \n", True));
        assertEq(text, token.deserializeValue("token", {}, NOTHING, " \t" + text + " \n"));
        XsdBaseType normalized = nsc.getBaseType("normalizedString");
        assertEq("a b c ", normalized.serializeValue(nsc, "a\tb\rc\n", True));
    }

    attributes() {
        XsdSchema original = schema('<xs:complexType name="Quantity"><xs:simpleContent><xs:extension base="xs:int">
            <xs:attribute name="count" type="xs:unsignedInt" use="required"/>
            </xs:extension></xs:simpleContent></xs:complexType>');
        foreach XsdSchema s in (original, Serializable::deserialize(original.serialize())) {
            XsdAbstractType t = s.findType(make_qname("urn:integer", "Quantity"));
            assertEq({"^value^": 1, "^attributes^": {"count": 1}}, t.deserializeValue("Quantity", s.getTypeMap(),
                NOTHING, {"^value^": "+001", "^attributes^": {"count": "001"}}));
            foreach hash<auto> value in ({"^value^": "1tail", "^attributes^": {"count": "1"}},
                    {"^value^": "1", "^attributes^": {"count": "+1"}}) {
                assertThrows("SOAP-DESERIALIZATION-ERROR", \t.deserializeValue(),
                    ("Quantity", s.getTypeMap(), NOTHING, value));
                assertThrows("SOAP-SERIALIZATION-ERROR", \t.serializeValue(), (s.nsc, value, True));
            }
        }
    }

    collections() {
        XsdSchema s = schema('<xs:simpleType name="Items"><xs:list itemType="xs:int"/></xs:simpleType>
            <xs:simpleType name="Alternative"><xs:union memberTypes="xs:int xs:unsignedLong"/></xs:simpleType>');
        XsdAbstractType items = s.findType(make_qname("urn:integer", "Items"));
        assertEq((1, 2, -3), items.deserializeValue("items", s.getTypeMap(), NOTHING, "+01 2 -03"));
        assertThrows("SOAP-DESERIALIZATION-ERROR", \items.deserializeValue(),
            ("items", s.getTypeMap(), NOTHING, "1 2garbage 3"));
        assertThrows("SOAP-SERIALIZATION-ERROR", \items.serializeValue(), (s.nsc, (1, "2garbage", 3), True));
        XsdAbstractType alternative = s.findType(make_qname("urn:integer", "Alternative"));
        assertEq(1, alternative.deserializeValue("alternative", s.getTypeMap(), NOTHING, "001"));
        assertThrows("SOAP-DESERIALIZATION-ERROR", \alternative.deserializeValue(),
            ("alternative", s.getTypeMap(), NOTHING, "1garbage"));
        assertThrows("SOAP-SERIALIZATION-ERROR", \alternative.serializeValue(), (s.nsc, "1garbage", True));
    }
}
