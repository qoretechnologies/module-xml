#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm

%exec-class SoapAddressingMetadataTest

# P9a-02: WS-Addressing 1.0 Metadata in WSDL 1.1 descriptions: actions (section 4.4), endpoint references on ports
# (sections 4.1 and 4.3) and the wsam:Addressing policy assertions (section 3) attached with WS-Policy 1.5, with
# the WS-I Basic Profile description requirements R1156-R1158 and R2901.
public class SoapAddressingMetadataTest inherits QUnit::Test {
    private {
        const Template = '<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"
            xmlns:soap="{SOAPNS}" xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns:wsp="http://www.w3.org/ns/ws-policy" xmlns:wsp12="http://schemas.xmlsoap.org/ws/2004/09/policy"
            xmlns:wsam="http://www.w3.org/2007/05/addressing/metadata"
            xmlns:wsaw="http://www.w3.org/2006/05/addressing/wsdl" xmlns:wsa="http://www.w3.org/2005/08/addressing"
            xmlns:wsu="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd"
            xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:x="urn:quotes:xsd" xmlns:tns="{TNS}"
            targetNamespace="{TNS}">{DEFS}
          <types><xsd:schema targetNamespace="urn:quotes:xsd" elementFormDefault="qualified">
            <xsd:element name="Symbol" type="xsd:string"/><xsd:element name="Price" type="xsd:double"/>
            <xsd:element name="Error" type="xsd:string"/><xsd:element name="Note" type="xsd:string"/>
          </xsd:schema></types>
          <message name="QuoteIn">{M}<part name="body" element="x:Symbol"/></message>
          <message name="QuoteOut"><part name="body" element="x:Price"/></message>
          <message name="Invalid"><part name="body" element="x:Error"/></message>
          <message name="NotifyIn"><part name="body" element="x:Note"/></message>
          <portType name="Quotes"{PTA}>{PT}
            <operation name="getQuote">{PTOP}<input message="tns:QuoteIn"{IN}>{PTIN}</input>
              <output message="tns:QuoteOut"{OUT}/><fault name="Invalid" message="tns:Invalid"{FAULT}/></operation>
            <operation name="notify"><input message="tns:NotifyIn"{NIN}/></operation>
          </portType>
          <binding name="QuotesSoap" type="tns:Quotes"{BA}>{B}
            <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
            <operation name="getQuote">{BOP}<soap:operation soapAction="{SA}"/>
              <input>{BIN}<soap:body use="literal"/></input><output><soap:body use="literal"/></output>
              <fault name="Invalid">{BF}<soap:fault name="Invalid" use="literal"/></fault></operation>
            <operation name="notify">{BOP2}<soap:operation soapAction="{SA2}"/>
              <input><soap:body use="literal"/></input></operation>
          </binding>
          <service name="QuoteService">{S}<port name="QuotePort" binding="tns:QuotesSoap">{P}
            <soap:address location="{LOC}"/>{EPR}</port></service>
        </definitions>';

        const Defaults = {
            "TNS": "http://example.com/stock", "SOAPNS": "http://schemas.xmlsoap.org/wsdl/soap/", "DEFS": "", "PTA": "", "PT": "", "PTOP": "", "IN": "", "PTIN": "",
            "OUT": "", "FAULT": "", "NIN": "", "BA": "", "B": "", "BOP": "", "SA": "", "BIN": "", "BF": "",
            "BOP2": "", "SA2": "", "P": "", "M": "", "S": "", "LOC": "http://localhost:8080/quotes", "EPR": "",
        };

        const Required = '<wsp:Policy><wsam:Addressing><wsp:Policy/></wsam:Addressing></wsp:Policy>';
        const Optional = '<wsp:Policy><wsam:Addressing wsp:Optional="true"><wsp:Policy/></wsam:Addressing>'
            '</wsp:Policy>';
        const Anonymous = '<wsp:Policy><wsam:Addressing><wsp:Policy><wsam:AnonymousResponses/></wsp:Policy>'
            '</wsam:Addressing></wsp:Policy>';
        const NonAnonymous = '<wsp:Policy><wsam:Addressing><wsp:Policy><wsam:NonAnonymousResponses/>'
            '</wsp:Policy></wsam:Addressing></wsp:Policy>';

        const None = <WsAddressingPolicy>{};
        const RequiredAny = <WsAddressingPolicy>{"supported": True, "required": True};
    }

    constructor() : Test("SoapAddressingMetadataTest", "1.0") {
        addTestCase("default, explicit and SOAP action association", \actions());
        addTestCase("invalid action declarations", \actionErrors());
        addTestCase("policy expressions and attachment points", \policyForms());
        addTestCase("invalid policy attachments", \policyErrors());
        addTestCase("required addressing extensions", \requiredExtensions());
        addTestCase("policy references across WSDL documents", \crossDocument());
        addTestCase("endpoint references on ports", \endpointReference());
        addTestCase("effective policy queries", \policyQueries());
        addTestCase("saved graphs keep addressing metadata", \serialization());
        set_return_value(main());
    }

    static string wsdl(*hash<auto> values) {
        string result = Template;
        foreach hash<auto> item in ((Defaults + values).pairIterator()) {
            result = replace(result, "{" + item.key + "}", item.value);
        }
        return result;
    }

    static WebService service(*hash<auto> values) {
        return new WebService(wsdl(values));
    }

    static hash<WsAddressingPolicy> policy(*hash<auto> values, string operation = "getQuote", bool port = True) {
        WebService ws = service(values);
        return port
            ? ws.getAddressingPolicy(ws.getOperation(operation), NOTHING, "QuoteService", "QuotePort")
            : ws.getAddressingPolicy(ws.getOperation(operation), "QuotesSoap");
    }

    static load(*hash<auto> values) {
        service(values);
    }

    actions() {
        # WS-Addressing Metadata section 4.4.4, example 4-9: default names
        WebService ws = service({"TNS": "http://greath.example.com/2004/wsdl/resSvc"});
        WSOperation op = ws.getOperation("getQuote");
        assertEq("http://greath.example.com/2004/wsdl/resSvc/Quotes/getQuoteRequest", op.getInputAction());
        assertEq("http://greath.example.com/2004/wsdl/resSvc/Quotes/getQuoteResponse", op.getOutputAction());
        assertEq("http://greath.example.com/2004/wsdl/resSvc/Quotes/getQuote/Fault/Invalid",
            op.getFaultAction("Invalid"));
        # an empty SOAP action leaves the default; a one-way input has no suffix
        assertEq("http://greath.example.com/2004/wsdl/resSvc/Quotes/getQuoteRequest", op.getInputAction("QuotesSoap"));
        WSOperation notify = ws.getOperation("notify");
        assertEq("http://greath.example.com/2004/wsdl/resSvc/Quotes/notify", notify.getInputAction("QuotesSoap"));
        assertEq(NOTHING, notify.getOutputAction());
        assertThrows("WSDL-OPERATION-ERROR", "declares no fault", \op.getFaultAction(), "Other");
        assertThrows("WSDL-BINDING-ERROR", \op.getInputAction(), "Unknown");

        # example 4-8: explicit message names
        ws = service({"TNS": "http://greath.example.com/2004/wsdl/resSvc", "IN": ' name="CheckAvailability"',
            "OUT": ' name="Availability"'});
        op = ws.getOperation("getQuote");
        assertEq("http://greath.example.com/2004/wsdl/resSvc/Quotes/CheckAvailability", op.getInputAction());
        assertEq("http://greath.example.com/2004/wsdl/resSvc/Quotes/Availability", op.getOutputAction());

        # a target namespace ending in "/" gets no second delimiter; a URN uses ":"
        op = service({"TNS": "http://example.com/stock/"}).getOperation("getQuote");
        assertEq("http://example.com/stock/Quotes/getQuoteRequest", op.getInputAction());
        op = service({"TNS": "urn:example:stock"}).getOperation("getQuote");
        assertEq("urn:example:stock:Quotes:getQuoteRequest", op.getInputAction());
        assertEq("urn:example:stock:Quotes:getQuote:Fault:Invalid", op.getFaultAction("Invalid"));
        op = service({"TNS": "URN:Example"}).getOperation("getQuote");
        assertEq("URN:Example:Quotes:getQuoteResponse", op.getOutputAction());

        # section 4.4.1: a non-empty SOAP action supplies the input action of that binding only
        ws = service({"SA": "urn:quote:get"});
        op = ws.getOperation("getQuote");
        assertEq("urn:quote:get", op.getInputAction("QuotesSoap"));
        assertEq("http://example.com/stock/Quotes/getQuoteRequest", op.getInputAction());
        assertFalse(op.hasExplicitInputAction());

        # explicit wsam:Action, the 2006 wsaw:Action, and both with the same value
        ws = service({"IN": ' wsam:Action="urn:in"', "OUT": ' wsam:Action=" urn:out "',
            "FAULT": ' wsaw:Action="urn:fault"', "SA": "urn:in"});
        op = ws.getOperation("getQuote");
        assertTrue(op.hasExplicitInputAction());
        assertEq("urn:in", op.getInputAction("QuotesSoap"));
        assertEq("urn:in", op.getInputAction());
        assertEq("urn:out", op.getOutputAction());
        assertEq("urn:fault", op.getFaultAction("Invalid"));
        op = service({"IN": ' wsam:Action="urn:in" wsaw:Action="urn:in"'}).getOperation("getQuote");
        assertEq("urn:in", op.getInputAction());
        # an explicit action wins over an empty SOAP action
        op = service({"IN": ' wsam:Action="urn:in"'}).getOperation("getQuote");
        assertEq("urn:in", op.getInputAction("QuotesSoap"));
        # the prefix is resolved in the element's scope
        op = service({"IN": ' xmlns:m="http://www.w3.org/2007/05/addressing/metadata" m:Action="urn:scoped"'})
            .getOperation("getQuote");
        assertEq("urn:scoped", op.getInputAction());
        # an attribute named Action in another namespace is not an action
        op = service({"IN": ' x:Action="urn:ignored"'}).getOperation("getQuote");
        assertFalse(op.hasExplicitInputAction());

        # a SOAP 1.2 binding's action supplies the input action in the same way
        ws = service({"SOAPNS": "http://schemas.xmlsoap.org/wsdl/soap12/", "SA": "urn:quote:get12"});
        assertTrue(ws.getOperation("getQuote").getBinding("QuotesSoap").isSoap12());
        assertEq("urn:quote:get12", ws.getOperation("getQuote").getInputAction("QuotesSoap"));
    }

    actionErrors() {
        # wsam:Action is an xs:anyURI; a relative value is kept, and messages reject it as an [action]
        WSOperation relative = service({"IN": ' wsam:Action="relative"', "FAULT": ' wsam:Action="f"'})
            .getOperation("getQuote");
        assertEq("relative", relative.getInputAction());
        assertEq("f", relative.getFaultAction("Invalid"));
        assertThrows("WSA-SERIALIZATION-ERROR", "must be an absolute IRI", \WsAddressingHelper::validate(),
            <WsaMessageAddressing>{"action": relative.getInputAction()});
        assertThrows("WSDL-ERROR", "conflicting actions", \load(),
            {"OUT": ' wsam:Action="urn:a" wsaw:Action="urn:b"'});
        # WS-I R2901: an explicit input action equals a non-empty SOAP action
        assertThrows("WSDL-ERROR", "R2901", \load(), {"IN": ' wsam:Action="urn:in"', "SA": "urn:other"});
        assertThrows("WSDL-ERROR", "R2901", \load(), {"NIN": ' wsaw:Action="urn:in"', "SA2": "urn:other"});
        load({"IN": ' wsam:Action="urn:in"', "SA": " urn:in "});
        # WS-I Basic Profile 2.0 R2901 for wsoap12:operation
        assertThrows("WSDL-ERROR", "R2901", \load(), {"SOAPNS": "http://schemas.xmlsoap.org/wsdl/soap12/",
            "IN": ' wsam:Action="urn:in"', "SA": "urn:other"});
        # Basic Profile 2.0 compares a wsoap12:operation soapAction whenever it is present, even when empty; Basic
        # Profile 1.2 compares only a non-empty SOAP 1.1 soapAction
        hash<auto> soap12 = {"SOAPNS": "http://schemas.xmlsoap.org/wsdl/soap12/", "IN": ' wsam:Action="urn:in"'};
        assertThrows("WSDL-ERROR", "R2901", \load(), soap12 + {"SA": ""});
        assertEq("urn:in", service(soap12 + {"SA": "urn:in"}).getOperation("getQuote").getInputAction("QuotesSoap"));
        # without the attribute there is nothing to compare
        WebService absent(replace(wsdl(soap12), 'soapAction=""', ""));
        assertEq("urn:in", absent.getOperation("getQuote").getInputAction("QuotesSoap"));
        assertEq("urn:in", service({"IN": ' wsam:Action="urn:in"', "SA": ""}).getOperation("getQuote")
            .getInputAction("QuotesSoap"));
        # WS-Addressing Metadata section 4.4.1: with wsam:Addressing, a SOAP action supplying the action must be
        # absolute
        assertThrows("WSDL-ERROR", "must be an absolute IRI or the input must declare wsam:Action", \load(),
            {"B": Required, "SA": "getQuote"});
        assertThrows("WSDL-ERROR", "must be an absolute IRI or the input must declare wsam:Action", \load(),
            {"P": Optional, "SA": "getQuote"});
        load({"B": Required, "SA": "urn:quote:get"});
        load({"B": Required, "IN": ' wsam:Action="urn:in"'});
        # without the assertion a relative SOAP action is only a SOAP 1.1 action
        load({"SA": "getQuote"});
    }

    policyForms() {
        assertEq(None, policy());
        assertEq(None, policy(NOTHING, "getQuote", False));
        assertEq(RequiredAny, policy({"B": Required}));
        assertEq(RequiredAny, policy({"B": Required}, "notify", False));
        assertEq(RequiredAny, policy({"P": Required}));
        # a port policy does not apply without the port
        assertEq(None, policy({"P": Required}, "getQuote", False));
        # section 3.1.1: wsp:Optional adds an alternative without the assertion
        assertEq(<WsAddressingPolicy>{"supported": True}, policy({"B": Optional}));
        foreach string value in ("1", " true ") {
            assertEq(<WsAddressingPolicy>{"supported": True}, policy({"B": replace(Optional, '"true"',
                '"' + value + '"')}));
        }
        foreach string value in ("false", "0") {
            assertEq(RequiredAny, policy({"B": replace(Optional, '"true"', '"' + value + '"')}));
        }
        # sections 3.1.2 and 3.1.3
        assertEq(<WsAddressingPolicy>{"supported": True, "required": True, "non_anonymous": False},
            policy({"B": Anonymous}));
        assertEq(<WsAddressingPolicy>{"supported": True, "required": True, "anonymous": False},
            policy({"B": NonAnonymous}));
        # normal form, example 3-6
        assertEq(<WsAddressingPolicy>{"supported": True, "required": True, "anonymous": False},
            policy({"B": '<wsp:Policy><wsp:ExactlyOne><wsp:All><wsam:Addressing><wsp:Policy><wsp:ExactlyOne>'
                '<wsp:All><wsam:NonAnonymousResponses/></wsp:All></wsp:ExactlyOne></wsp:Policy></wsam:Addressing>'
                '</wsp:All></wsp:ExactlyOne></wsp:Policy>'}));
        # alternatives: either response kind, or none
        assertEq(RequiredAny, policy({"B": '<wsp:Policy><wsp:ExactlyOne><wsp:All>' + Anonymous + '</wsp:All>'
            '<wsp:All>' + NonAnonymous + '</wsp:All></wsp:ExactlyOne></wsp:Policy>'}));
        assertEq(<WsAddressingPolicy>{"supported": True, "non_anonymous": False},
            policy({"B": '<wsp:Policy><wsp:ExactlyOne><wsp:All/>' + Anonymous + '</wsp:ExactlyOne></wsp:Policy>'}));
        # other assertions do not change the result, including an optional one
        assertEq(RequiredAny, policy({"B": '<wsp:Policy><x:Other wsp:Optional="true"/><x:More><wsp:Policy>'
            '<x:Nested/></wsp:Policy></x:More>' + Required + '</wsp:Policy>'}));
        # references by wsu:Id, xml:id and Name, the wsp:PolicyURIs attribute, and WS-Policy 2004/09
        assertEq(RequiredAny, policy({"DEFS": '<wsp:Policy wsu:Id="A">' + Required + '</wsp:Policy>',
            "B": '<wsp:PolicyReference URI="#A"/>'}));
        assertEq(<WsAddressingPolicy>{"supported": True}, policy({"DEFS": '<wsp:Policy xml:id="O">' + Optional
            + '</wsp:Policy>', "BOP": '<wsp:PolicyReference URI=" #O "/>', "BOP2": '<wsp:PolicyReference URI="#O"/>'}));
        assertEq(RequiredAny, policy({"DEFS": '<wsp:Policy Name="http://example.com/policy/addressing">' + Required
            + '</wsp:Policy>', "P": '<wsp:PolicyReference URI="http://example.com/policy/addressing"/>'}));
        assertEq(<WsAddressingPolicy>{"supported": True, "required": True, "non_anonymous": False},
            policy({"DEFS": '<wsp:Policy wsu:Id="A">' + Anonymous + '</wsp:Policy><wsp:Policy wsu:Id="B"/>',
                "BA": ' wsp:PolicyURIs="#A  #B"'}));
        assertEq(RequiredAny, policy({"B": '<wsp12:Policy><wsam:Addressing><wsp12:Policy/></wsam:Addressing>'
            '</wsp12:Policy>'}));
        assertEq(<WsAddressingPolicy>{"supported": True}, policy({"DEFS": '<wsp12:Policy wsu:Id="O12">'
            '<wsam:Addressing wsp12:Optional="true"/></wsp12:Policy>', "B": '<wsp12:PolicyReference URI="#O12"/>'}));
        # a reference nested in a policy expression, and a reference chain
        assertEq(RequiredAny, policy({"DEFS": '<wsp:Policy wsu:Id="A"><wsp:PolicyReference URI="#B"/></wsp:Policy>'
            '<wsp:Policy wsu:Id="B">' + Required + '</wsp:Policy>',
            "B": '<wsp:Policy><wsp:PolicyReference URI="#A"/></wsp:Policy>'}));
        # the same policy referenced twice is not a cycle
        assertEq(RequiredAny, policy({"DEFS": '<wsp:Policy wsu:Id="A">' + Required + '</wsp:Policy>',
            "B": '<wsp:PolicyReference URI="#A"/><wsp:PolicyReference URI="#A"/>'}));
        # merged attachments: the port requires addressing, the binding restricts responses
        assertEq(<WsAddressingPolicy>{"supported": True, "required": True, "anonymous": False},
            policy({"P": Required, "B": NonAnonymous}));
        # an optional binding policy merged with a required port policy is required
        assertEq(RequiredAny, policy({"P": Required, "B": Optional}));
        # the legacy WSDL binding marker: wsdl:required="true" requires addressing
        assertEq(RequiredAny, policy({"B": '<wsaw:UsingAddressing wsdl:required="true"/>'}));
        assertEq(<WsAddressingPolicy>{"supported": True}, policy({"P": '<wsaw:UsingAddressing/>'}));
        assertEq(<WsAddressingPolicy>{"supported": True}, policy({"B": '<wsaw:UsingAddressing wsdl:required="false"/>'}));
        assertEq(RequiredAny, policy({"B": '<wsp:Policy><wsaw:UsingAddressing/></wsp:Policy>'}));
        # the raw alternatives
        WebService ws = service({"B": Optional, "P": Anonymous});
        assertEq((<WsAddressingAlternative>{}, <WsAddressingAlternative>{"addressing": True}),
            ws.getOperation("getQuote").getBinding("QuotesSoap").getAddressingAlternatives());
        assertEq((<WsAddressingAlternative>{"addressing": True, "anonymous_responses": True},),
            ws.getPortAddressing("QuoteService", "QuotePort").alternatives);
        assertEq(NOTHING, service().getOperation("getQuote").getBinding("QuotesSoap").getAddressingAlternatives());
    }

    policyErrors() {
        # WS-Addressing Metadata section 3.1 and WS-I R1156
        assertThrows("WSDL-ERROR", "cannot be attached to a wsdl:portType;", \load(), {"PT": Required});
        assertThrows("WSDL-ERROR", "cannot be attached to a wsdl:portType;", \load(),
            {"DEFS": '<wsp:Policy wsu:Id="A">' + Required + '</wsp:Policy>', "PTA": ' wsp:PolicyURIs="#A"'});
        assertThrows("WSDL-ERROR", "cannot be attached to a wsdl:portType/wsdl:operation", \load(), {"PTOP": Optional});
        assertThrows("WSDL-ERROR", "cannot be attached to a wsdl:portType message", \load(), {"PTIN": Required});
        assertThrows("WSDL-ERROR", "cannot be attached to a wsdl:binding message", \load(), {"BIN": Required});
        assertThrows("WSDL-ERROR", "cannot be attached to a wsdl:binding message", \load(), {"BF": Required});
        assertThrows("WSDL-ERROR", "cannot be attached to a wsdl:message", \load(), {"M": Optional});
        assertThrows("WSDL-ERROR", "cannot be attached to a wsdl:service", \load(), {"S": Required});
        # other policies may be attached anywhere
        load({"PT": '<wsp:Policy><x:Other/></wsp:Policy>', "BIN": '<wsp:Policy/>', "M": '<wsp:Policy/>',
            "S": '<wsp:Policy><x:Other/></wsp:Policy>'});
        # WS-I R1157: all operations of the binding
        assertThrows("WSDL-ERROR", "R1157", \load(), {"BOP": Required});
        assertThrows("WSDL-ERROR", "R1157", \load(), {"BOP2": Optional});
        load({"BOP": Required, "BOP2": Optional});
        # WS-I R1158, also after merging the port's and the binding's policies
        assertThrows("WSDL-ERROR", "both wsam:AnonymousResponses and wsam:NonAnonymousResponses", \load(),
            {"B": '<wsp:Policy><wsam:Addressing><wsp:Policy><wsam:AnonymousResponses/><wsam:NonAnonymousResponses/>'
                '</wsp:Policy></wsam:Addressing></wsp:Policy>'});
        assertThrows("WSDL-ERROR", "both wsam:AnonymousResponses and wsam:NonAnonymousResponses", \load(),
            {"B": Anonymous, "P": NonAnonymous});
        assertThrows("WSDL-ERROR", "both wsam:AnonymousResponses and wsam:NonAnonymousResponses", \load(),
            {"B": Anonymous, "BOP": NonAnonymous, "BOP2": Required});
        # references
        assertThrows("WSDL-ERROR", "that the WSDL does not define", \load(), {"B": '<wsp:PolicyReference URI="#X"/>'});
        assertThrows("WSDL-ERROR", "that the WSDL does not define", \load(), {"BA": ' wsp:PolicyURIs="#X"'});
        assertThrows("WSDL-ERROR", "that the WSDL does not define", \load(),
            {"B": '<wsp:PolicyReference URI="http://example.com/other#A"/>'});
        assertThrows("WSDL-ERROR", "requires a URI attribute", \load(), {"B": '<wsp:PolicyReference/>'});
        assertThrows("WSDL-ERROR", "is cyclic", \load(), {"DEFS": '<wsp:Policy wsu:Id="A"><wsp:PolicyReference '
            'URI="#B"/></wsp:Policy><wsp:Policy wsu:Id="B"><wsp:PolicyReference URI="#A"/></wsp:Policy>',
            "B": '<wsp:PolicyReference URI="#A"/>'});
        assertThrows("WSDL-ERROR", "is cyclic", \load(),
            {"DEFS": '<wsp:Policy wsu:Id="A"><wsp:PolicyReference URI="#A"/></wsp:Policy>'
                , "P": '<wsp:PolicyReference URI="#A"/>'});
        assertThrows("WSDL-ERROR", "duplicate policy identifier", \load(),
            {"DEFS": '<wsp:Policy wsu:Id="A"/><wsp:Policy xml:id="A"/>'});
        assertThrows("WSDL-ERROR", "duplicate policy name", \load(),
            {"DEFS": '<wsp:Policy Name="urn:p"/><wsp:Policy Name="urn:p"/>'});
        # grammar
        assertThrows("WSDL-ERROR", "unknown WS-Policy element", \load(), {"B": '<wsp:Policy><wsp:Any/></wsp:Policy>'});
        assertThrows("WSDL-ERROR", "invalid wsp:Optional value", \load(),
            {"B": '<wsp:Policy><wsam:Addressing wsp:Optional="yes"/></wsp:Policy>'});
        assertThrows("WSDL-ERROR", "more than one nested policy", \load(),
            {"B": '<wsp:Policy><wsam:Addressing><wsp:Policy/><wsp:Policy/></wsam:Addressing></wsp:Policy>'});
        assertThrows("WSDL-ERROR", "has no alternatives", \load(), {"B": '<wsp:Policy><wsp:ExactlyOne/></wsp:Policy>'});
        assertThrows("PARSE-XML-EXCEPTION", "prefix u", \load(), {"B": '<wsp:Policy><u:Other/></wsp:Policy>'});
    }

    requiredExtensions() {
        # WS-Policy 1.5 Attachment section 3.4 recommends wsdl:required="true" on policy references
        assertEq(RequiredAny, policy({"DEFS": '<wsp:Policy wsu:Id="A">' + Required + '</wsp:Policy>',
            "B": '<wsp:PolicyReference URI="#A" wsdl:required="true"/>',
            "P": '<wsp:Policy wsdl:required="true"/>'}));
        assertEq("http://localhost:8080/quotes", service({"EPR": '<wsa:EndpointReference wsdl:required="true">'
            '<wsa:Address>http://localhost:8080/quotes</wsa:Address></wsa:EndpointReference>'})
            .getPortAddressing("QuoteService", "QuotePort").endpoint_reference.address);
        load({"P": '<wsaw:UsingAddressing wsdl:required="true"/>'});
        # other required extensions are still rejected
        assertThrows("WSDL-ERROR", "unsupported required WSDL extension", \load(),
            {"B": '<x:Other wsdl:required="true"/>'});
        assertThrows("WSDL-ERROR", "unsupported required WSDL extension", \load(),
            {"BOP": '<wsaw:UsingAddressing wsdl:required="true"/>'});
    }

    crossDocument() {
        string imported = '<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"
            xmlns:wsp="http://www.w3.org/ns/ws-policy" xmlns:wsam="http://www.w3.org/2007/05/addressing/metadata"
            xmlns:wsu="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd"
            targetNamespace="urn:policies"><wsp:Policy wsu:Id="Local"><wsam:Addressing><wsp:Policy>'
            '<wsam:NonAnonymousResponses/></wsp:Policy></wsam:Addressing></wsp:Policy>'
            '<wsp:Policy wsu:Id="Imported"><wsp:PolicyReference URI="#Local"/></wsp:Policy></definitions>';
        code options = hash<auto> sub () {
            return {"def_path": "/nonexistent-qore-test/", "try_import": string sub (string name) {
                if (name != "policies.wsdl") {
                    throw "TEST-ERROR", sprintf("unexpected import %Y", name);
                }
                return imported;
            }};
        };
        string root = wsdl({"DEFS": '<import namespace="urn:policies" location="policies.wsdl"/>',
            "B": '<wsp:PolicyReference URI="policies.wsdl#Imported"/>'});
        WebService ws(root, options());
        # the imported policy's own reference resolves in its document
        assertEq(<WsAddressingPolicy>{"supported": True, "required": True, "anonymous": False},
            ws.getAddressingPolicy(ws.getOperation("getQuote"), "QuotesSoap"));
        # a fragment is local to the referring document
        assertThrows("WSDL-ERROR", "that the WSDL does not define", sub () {
            new WebService(wsdl({"DEFS": '<import namespace="urn:policies" location="policies.wsdl"/>',
                "B": '<wsp:PolicyReference URI="#Imported"/>'}), options());
        });
    }

    endpointReference() {
        string epr = '<wsa:EndpointReference><wsa:Address> http://localhost:8080/quotes </wsa:Address>'
            '<wsa:ReferenceParameters><x:CustomerKey xmlns:c="urn:c" c:kind="k">123456789</x:CustomerKey>'
            '<x:Cart><x:Id>A</x:Id><x:Id>B</x:Id></x:Cart></wsa:ReferenceParameters>'
            '<wsa:Metadata><wsam:Other/></wsa:Metadata></wsa:EndpointReference>';
        WebService ws = service({"EPR": epr});
        hash<WsdlPortAddressing> info = ws.getPortAddressing("QuoteService", "QuotePort");
        assertEq("http://localhost:8080/quotes", info.endpoint_reference.address);
        assertEq(NOTHING, info.alternatives);
        assertEq(2, info.endpoint_reference.reference_parameters.size());
        # each parameter keeps its content and its in-scope namespaces
        hash<auto> parameters = foldl $1 + $2, (map parse_xml($1), info.endpoint_reference.reference_parameters);
        hash<auto> key = parameters{"x:CustomerKey"};
        assertEq("123456789", key."^value^");
        assertEq("urn:quotes:xsd", key."^attributes^"."xmlns:x");
        assertEq("urn:c", key."^attributes^"."xmlns:c");
        assertEq("k", key."^attributes^"."c:kind");
        hash<auto> cart = parameters{"x:Cart"};
        assertEq(("A", "B"), cart."x:Id");
        # a port without an endpoint reference
        info = service().getPortAddressing("QuoteService", "QuotePort");
        assertEq(NOTHING, info.endpoint_reference);
        assertEq(NOTHING, info.alternatives);
        assertThrows("WSDL-SERVICE-ERROR", \ws.getPortAddressing(), ("QuoteService", "Other"));

        # section 4.1: the address matches the port's address
        assertThrows("WSDL-ERROR", "must match the port's address", \load(), {"EPR": '<wsa:EndpointReference>'
            '<wsa:Address>http://localhost:9090/other</wsa:Address></wsa:EndpointReference>'});
        assertThrows("WSDL-ERROR", "has no wsa:Address", \load(),
            {"EPR": '<wsa:EndpointReference><wsa:ReferenceParameters/></wsa:EndpointReference>'});
        assertThrows("WSDL-ERROR", "must be an absolute IRI", \load(),
            {"LOC": "quotes", "EPR": '<wsa:EndpointReference><wsa:Address>quotes</wsa:Address></wsa:EndpointReference>'});
        assertThrows("WSDL-ERROR", "more than one wsa:Address", \load(), {"EPR": '<wsa:EndpointReference>'
            '<wsa:Address>http://localhost:8080/quotes</wsa:Address><wsa:Address>http://localhost:8080/quotes'
            '</wsa:Address></wsa:EndpointReference>'});
        assertThrows("WSDL-ERROR", "more than one wsa:EndpointReference", \load(), {"EPR": epr + epr});
        assertThrows("WSDL-ERROR", "must be namespace-qualified", \load(), {"EPR": '<wsa:EndpointReference>'
            '<wsa:Address>http://localhost:8080/quotes</wsa:Address><wsa:ReferenceParameters><Plain xmlns=""/>'
            '</wsa:ReferenceParameters></wsa:EndpointReference>'});
        assertThrows("WSDL-ERROR", "cannot contain child elements", \load(), {"EPR": '<wsa:EndpointReference>'
            '<wsa:Address>http://localhost:8080/quotes<x:Other/></wsa:Address></wsa:EndpointReference>'});

        # a published WSDL keeps the endpoint reference's address equal to the rewritten port address
        string published = ws.getWSDL("https://gateway.example/soap");
        WebService republished(published);
        info = republished.getPortAddressing("QuoteService", "QuotePort");
        assertEq("https://gateway.example/soap/QuoteService", info.endpoint_reference.address);
        assertEq("https://gateway.example/soap/QuoteService", republished.getService("QuoteService").port.QuotePort.address);
        assertEq(2, info.endpoint_reference.reference_parameters.size());
    }

    policyQueries() {
        WebService ws = service({"P": NonAnonymous, "B": Optional});
        WSOperation op = ws.getOperation("getQuote");
        assertEq(<WsAddressingPolicy>{"supported": True, "required": True, "anonymous": False},
            ws.getAddressingPolicy(op, "QuotesSoap", "QuoteService", "QuotePort"));
        assertEq(<WsAddressingPolicy>{"supported": True}, ws.getAddressingPolicy(op));
        assertThrows("WSDL-SERVICE-ERROR", \ws.getAddressingPolicy(), (op, NOTHING, "QuoteService", "Other"));
        assertThrows("WSDL-SERVICE-ERROR", \ws.getAddressingPolicy(), (op, NOTHING, NOTHING, "QuotePort"));
        assertThrows("WSDL-BINDING-ERROR", \ws.getAddressingPolicy(), (op, "Other", "QuoteService", "QuotePort"));
    }

    serialization() {
        WebService ws = service({"IN": ' wsam:Action="urn:in"', "SA": "urn:in", "B": Anonymous,
            "EPR": '<wsa:EndpointReference><wsa:Address>http://localhost:8080/quotes</wsa:Address>'
                '<wsa:ReferenceParameters><x:Key>1</x:Key></wsa:ReferenceParameters></wsa:EndpointReference>'});
        foreach WebService copy in (Serializable::deserialize(ws.serialize()),
                Serializable::deserialize(Serializable::serializeToData(ws))) {
            WSOperation op = copy.getOperation("getQuote");
            assertEq("urn:in", op.getInputAction("QuotesSoap"));
            assertEq(ws.getPortAddressing("QuoteService", "QuotePort"),
                copy.getPortAddressing("QuoteService", "QuotePort"));
            assertEq(ws.getAddressingPolicy(ws.getOperation("getQuote"), NOTHING, "QuoteService", "QuotePort"),
                copy.getAddressingPolicy(op, NOTHING, "QuoteService", "QuotePort"));
        }
        # a standalone operation keeps its actions and its bindings' policy
        WSOperation op = Serializable::deserialize(ws.getOperation("getQuote").serialize());
        assertEq("urn:in", op.getInputAction());
        assertEq("http://example.com/stock/Quotes/getQuoteResponse", op.getOutputAction());
        assertEq("http://example.com/stock/Quotes/getQuote/Fault/Invalid", op.getFaultAction("Invalid"));
        assertEq((<WsAddressingAlternative>{"addressing": True, "anonymous_responses": True},),
            op.getBinding("QuotesSoap").getAddressingAlternatives());

        # an operation built without its port type cannot derive default actions
        hash<auto> declaration = parse_xml('<operation xmlns="http://schemas.xmlsoap.org/wsdl/" name="op" '
            'xmlns:m="http://www.w3.org/2007/05/addressing/metadata"><input message="In" m:Action="urn:op"/>'
            '<output message="Out"/></operation>').operation;
        WSOperation legacy(declaration, new Namespaces({}), {"In": ws.getOperation("getQuote").input,
            "Out": ws.getOperation("getQuote").output});
        assertEq("urn:op", legacy.getInputAction());
        assertThrows("WSDL-OPERATION-ERROR", "saved without its port type", \legacy.getOutputAction());

        # invalid saved members
        foreach auto invalid in (("urn:in",), {"input": 1}, "urn:in") {
            hash<SerializationInfo> data = ws.getOperation("getQuote").serializeToData();
            int changed = 0;
            foreach string index in (keys data._index) {
                if (data._index{index}.hasKey("_class_data")
                        && data._index{index}._class_data.hasKey("WSDL::WSOperation")) {
                    data._index{index}._class_data."WSDL::WSOperation".explicit_actions = invalid;
                    ++changed;
                }
            }
            assertEq(1, changed);
            assertThrows("DESERIALIZATION-ERROR", \Serializable::deserialize(), (data,));
        }
    }

}
