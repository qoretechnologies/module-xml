#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm

%exec-class SoapEncodedReferencesTest

# SOAP 1.1 section 5 reference contexts: independent elements, encoding metadata, graph checks and the encoding
# namespace's type names, decoded through an rpc/encoded binding as Apache Axis 1.4 produces them.
public class SoapEncodedReferencesTest inherits QUnit::Test {
    private {
        const Wsdl = '<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"
            xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns:SOAP-ENC="http://schemas.xmlsoap.org/soap/encoding/" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
            xmlns:tns="urn:enc-refs" xmlns:s="urn:enc-refs:xsd" targetNamespace="urn:enc-refs">
          <types>
            <schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:enc-refs:xsd">
              <import namespace="http://schemas.xmlsoap.org/soap/encoding/"/>
              <complexType name="SOAPStruct"><all>
                <element name="varString" type="string"/><element name="varInt" type="int"/>
                <element name="varFloat" type="float"/></all></complexType>
              <complexType name="ArrayOfint"><complexContent><restriction base="SOAP-ENC:Array">
                <attribute ref="SOAP-ENC:arrayType" wsdl:arrayType="int[]"/></restriction></complexContent></complexType>
            </schema>
          </types>
          <message name="echoStructRequest"><part name="inputStruct" type="s:SOAPStruct"/></message>
          <message name="echoStructResponse"><part name="return" type="s:SOAPStruct"/></message>
          <message name="echoIntRequest"><part name="inputInt" type="xsd:int"/></message>
          <message name="echoIntResponse"><part name="return" type="xsd:int"/></message>
          <message name="echoIntArrayRequest"><part name="inputArray" type="s:ArrayOfint"/></message>
          <message name="echoIntArrayResponse"><part name="return" type="s:ArrayOfint"/></message>
          <message name="echoTwoRequest"><part name="first" type="s:SOAPStruct"/>
            <part name="second" type="s:SOAPStruct"/></message>
          <message name="echoTwoResponse"><part name="return" type="xsd:int"/></message>
          <portType name="Port">
            <operation name="echoStruct"><input message="tns:echoStructRequest"/><output message="tns:echoStructResponse"/></operation>
            <operation name="echoInt"><input message="tns:echoIntRequest"/><output message="tns:echoIntResponse"/></operation>
            <operation name="echoIntArray"><input message="tns:echoIntArrayRequest"/><output message="tns:echoIntArrayResponse"/></operation>
            <operation name="echoTwo"><input message="tns:echoTwoRequest"/><output message="tns:echoTwoResponse"/></operation>
          </portType>
          <binding name="Binding" type="tns:Port">
            <soap:binding style="rpc" transport="http://schemas.xmlsoap.org/soap/http"/>
            <operation name="echoStruct"><soap:operation soapAction=""/>
              <input><soap:body use="encoded" namespace="urn:enc-refs" encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/></input>
              <output><soap:body use="encoded" namespace="urn:enc-refs" encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/></output></operation>
            <operation name="echoInt"><soap:operation soapAction=""/>
              <input><soap:body use="encoded" namespace="urn:enc-refs" encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/></input>
              <output><soap:body use="encoded" namespace="urn:enc-refs" encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/></output></operation>
            <operation name="echoIntArray"><soap:operation soapAction=""/>
              <input><soap:body use="encoded" namespace="urn:enc-refs" encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/></input>
              <output><soap:body use="encoded" namespace="urn:enc-refs" encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/></output></operation>
            <operation name="echoTwo"><soap:operation soapAction=""/>
              <input><soap:body use="encoded" namespace="urn:enc-refs" encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/></input>
              <output><soap:body use="encoded" namespace="urn:enc-refs" encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/></output></operation>
          </binding>
          <service name="Service"><port name="Port" binding="tns:Binding">
            <soap:address location="http://example.invalid/"/></port></service>
        </definitions>';

        const Envelope = '<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/"
            xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xmlns:soapenc="http://schemas.xmlsoap.org/soap/encoding/"><soapenv:Body>%s</soapenv:Body></soapenv:Envelope>';

        const Struct = '<multiRef id="%s" soapenc:root="0" soapenv:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"
            xsi:type="ns3:SOAPStruct" xmlns:ns3="urn:enc-refs:xsd"><varString xsi:type="xsd:string">%s</varString>
            <varFloat xsi:type="xsd:float">1.5</varFloat><varInt xsi:type="xsd:int">%d</varInt></multiRef>';

        list<WebService> services;
    }

    constructor() : QUnit::Test("SOAP encoded references", "1.0") {
        WebService source(Wsdl);
        services = (source, Serializable::deserialize(source.serialize()));
        addTestCase("independent elements arriving as same-named siblings", \siblings());
        addTestCase("SOAP encoding metadata is consumed from independent elements", \metadata());
        addTestCase("dangling, duplicate and cyclic references are rejected before conversion", \graph());
        addTestCase("shared references decode to equal values", \sharing());
        addTestCase("only same-document fragment references are resolved locally", \external());
        addTestCase("the SOAP encoding namespace's type names", \encodingTypes());
        addTestCase("a single type-based part accepts the bare struct that decoding returns", \bareStruct());
        set_return_value(main());
    }

    static string envelope(string body) {
        return sprintf(Envelope, body);
    }

    static string wrapper(string name, string accessors) {
        return sprintf('<ns1:%s soapenv:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/" xmlns:ns1="urn:enc-refs">'
            '%s</ns1:%s>', name, accessors, name);
    }

    siblings() {
        foreach WebService ws in (services) {
            WSOperation op = ws.getOperation("echoTwo");
            # Two independent elements share one element name, so they arrive as a list under one key.
            string xml = envelope(wrapper("echoTwo", '<first href="#id0"/><second href="#id1"/>')
                + sprintf(Struct, "id1", "second", 2) + sprintf(Struct, "id0", "first", 1));
            hash<auto> value = op.deserializeRequest(parse_xml(xml, XPF_PRESERVE_ORDER));
            assertEq({"varString": "first", "varInt": 1, "varFloat": 1.5}, value.first);
            assertEq({"varString": "second", "varInt": 2, "varFloat": 1.5}, value.second);
            # A response wrapper followed by one independent simple value.
            op = ws.getOperation("echoInt");
            xml = envelope(wrapper("echoIntResponse", '<return href="#id0"/>')
                + '<multiRef id="id0" soapenc:root="0" soapenv:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"'
                ' xsi:type="xsd:int">42</multiRef>');
            assertEq(42, op.deserializeResponse(parse_xml(xml, XPF_PRESERVE_ORDER)));
        }
    }

    metadata() {
        foreach WebService ws in (services) {
            WSOperation op = ws.getOperation("echoInt");
            code decode = auto sub (string attributes) {
                string xml = envelope(wrapper("echoIntResponse", '<return href="#v"/>')
                    + sprintf('<value id="v" %s xsi:type="xsd:int">7</value>', attributes));
                return op.deserializeResponse(parse_xml(xml, XPF_PRESERVE_ORDER));
            };
            assertEq(7, decode(''));
            assertEq(7, decode('soapenc:root=" 1 "'));
            # The encodingStyle value is an ordered list, most specific first; SOAP encoding may follow a refinement.
            assertEq(7, decode('soapenv:encodingStyle="urn:example:restricted http://schemas.xmlsoap.org/soap/encoding/"'));
            assertThrows("SOAP-DESERIALIZATION-ERROR", "must be 0 or 1", decode, 'soapenc:root="2"');
            assertThrows("SOAP-DESERIALIZATION-ERROR", "instead of SOAP 1.1 encoding", decode,
                'soapenv:encodingStyle="urn:example:other"');
            assertThrows("SOAP-DESERIALIZATION-ERROR", "instead of SOAP 1.1 encoding", decode, 'soapenv:encodingStyle=""');
            # Other attributes remain instance data and are still rejected by a simple type.
            assertThrows("SOAP-DESERIALIZATION-ERROR", "cannot contain attribute", decode, 'extra="x"');
        }
    }

    graph() {
        foreach WebService ws in (services) {
            WSOperation op = ws.getOperation("echoTwo");
            code decode = auto sub (string body) {
                return op.deserializeRequest(parse_xml(envelope(body), XPF_PRESERVE_ORDER));
            };
            string both = wrapper("echoTwo", '<first href="#a"/><second href="#b"/>');
            assertThrows("INVALID-REFERENCE", "\"b\" does not exist", decode, both + sprintf(Struct, "a", "x", 1));
            assertThrows("SOAP-DESERIALIZATION-ERROR", "duplicate SOAP encoding id \"a\"", decode,
                both + sprintf(Struct, "a", "x", 1) + sprintf(Struct, "a", "y", 2) + sprintf(Struct, "b", "z", 3));
            assertThrows("SOAP-DESERIALIZATION-ERROR", "is not an XML ID", decode,
                wrapper("echoTwo", '<first href="#1a"/><second href="#b"/>') + sprintf(Struct, "1a", "x", 1)
                    + sprintf(Struct, "b", "y", 2));
            # a member of one independent element refers back to the other
            string cycle = both
                + '<multiRef id="a" xsi:type="ns3:SOAPStruct" xmlns:ns3="urn:enc-refs:xsd"><varString href="#b"/>'
                    '<varInt xsi:type="xsd:int">1</varInt><varFloat xsi:type="xsd:float">1</varFloat></multiRef>'
                + '<multiRef id="b" xsi:type="xsd:string"><inner href="#a"/></multiRef>';
            assertThrows("SOAP-DESERIALIZATION-ERROR", "reference cycle", decode, cycle);
            string self_cycle = both + sprintf(Struct, "a", "x", 1)
                + '<multiRef id="b" xsi:type="ns3:SOAPStruct" xmlns:ns3="urn:enc-refs:xsd"><varString href="#b"/>'
                    '<varInt xsi:type="xsd:int">1</varInt><varFloat xsi:type="xsd:float">1</varFloat></multiRef>';
            assertThrows("SOAP-DESERIALIZATION-ERROR", "reference cycle through id \"b\"", decode, self_cycle);
        }
    }

    sharing() {
        foreach WebService ws in (services) {
            WSOperation op = ws.getOperation("echoTwo");
            string xml = envelope(wrapper("echoTwo", '<first href="#s"/><second href="#s"/>') + sprintf(Struct, "s", "shared", 9));
            hash<auto> value = op.deserializeRequest(parse_xml(xml, XPF_PRESERVE_ORDER));
            assertEq({"varString": "shared", "varInt": 9, "varFloat": 1.5}, value.first);
            assertEq(value.first, value.second);
        }
    }

    external() {
        foreach WebService ws in (services) {
            WSOperation op = ws.getOperation("echoInt");
            # A cid: reference is not a local id. A multipart message replaces references to its parts before
            # conversion, so in a single-part message it names a value outside the message.
            string xml = envelope(wrapper("echoInt", '<inputInt href="cid:part@example.invalid"/>'));
            assertThrows("SOAP-DESERIALIZATION-ERROR", "SOAP encoding reference \"cid:part@example.invalid\" is "
                "outside the message; only same-document fragment references are resolved", \op.deserializeRequest(),
                (parse_xml(xml, XPF_PRESERVE_ORDER),));
        }
    }

    encodingTypes() {
        foreach WebService ws in (services) {
            WSOperation op = ws.getOperation("echoStruct");
            # SOAP 1.1 section 5.2.1 names every builtin simple type in the encoding namespace as well
            string xml = envelope(wrapper("echoStruct", '<inputStruct xsi:type="ns3:SOAPStruct" xmlns:ns3="urn:enc-refs:xsd">'
                '<varString xsi:type="soapenc:string">text</varString><varInt xsi:type="soapenc:int">3</varInt>'
                '<varFloat xsi:type="soapenc:float">2.5</varFloat></inputStruct>'));
            assertEq({"varString": "text", "varInt": 3, "varFloat": 2.5}, op.deserializeRequest(parse_xml(xml, XPF_PRESERVE_ORDER)));

            # an array accessor may name the generic SOAP-ENC:Array; members can refer to independent elements
            op = ws.getOperation("echoIntArray");
            xml = envelope(wrapper("echoIntArray", '<inputArray soapenc:arrayType="xsd:int[2]" xsi:type="soapenc:Array">'
                '<inputArray href="#m0"/><inputArray href="#m1"/></inputArray>')
                + '<multiRef id="m1" soapenc:root="0" xsi:type="xsd:int">20</multiRef>'
                + '<multiRef id="m0" soapenc:root="0" xsi:type="soapenc:int">10</multiRef>');
            auto value = op.deserializeRequest(parse_xml(xml, XPF_PRESERVE_ORDER));
            assertEq({"inputArray": (10, 20)}, value);

            # SOAP-ENC:Array cannot replace a declared struct type
            op = ws.getOperation("echoStruct");
            xml = envelope(wrapper("echoStruct", '<inputStruct soapenc:arrayType="xsd:int[1]" xsi:type="soapenc:Array">'
                '<item>1</item></inputStruct>'));
            assertThrows("SOAP-DESERIALIZATION-ERROR", "SOAP-ENC:Array cannot replace declared type \"SOAPStruct\"",
                \op.deserializeRequest(), (parse_xml(xml, XPF_PRESERVE_ORDER),));
        }
    }

    bareStruct() {
        foreach WebService ws in (services) {
            WSOperation op = ws.getOperation("echoStruct");
            string xml = envelope(wrapper("echoStructResponse", '<return href="#id0"/>') + sprintf(Struct, "id0", "round", 4));
            auto value = op.deserializeResponse(parse_xml(xml, XPF_PRESERVE_ORDER));
            assertEq({"varString": "round", "varInt": 4, "varFloat": 1.5}, value);
            # the decoded bare struct re-encodes through the same operation and decodes to the same value
            hash<auto> wire = op.serializeResponse(value);
            assertEq(value, op.deserializeResponse(parse_xml(wire.body, XPF_PRESERVE_ORDER)));
            wire = op.serializeRequest(value);
            assertEq(value, op.deserializeRequest(parse_xml(wire.body, XPF_PRESERVE_ORDER)));
            # an unknown member is still an error rather than silently dropped
            assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), (value + {"unknown": 1},));
            # with two type-based parts a flat struct cannot say which part a field belongs to
            op = ws.getOperation("echoTwo");
            assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), (value,));
        }
    }
}
