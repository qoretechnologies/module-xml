#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class CompositorContextTest

class CompositorContextTest inherits QUnit::Test {
    private {
        const Xsd = "http://www.w3.org/2001/XMLSchema";
        const Ns = "urn:qore:compositor";
    }

    constructor() : QUnit::Test("WSDL compositor declaration namespaces", "1.0") {
        addTestCase("Top-level compositors resolve locally declared prefixes", \topLevel());
        addTestCase("Nested sequence scopes restore sibling prefix bindings", \nestedSequence());
        addTestCase("Nested choices and their sequence alternatives retain scope", \nestedChoice());
        addTestCase("Default namespace declarations and resets apply to child QNames", \defaultNamespace());
        addTestCase("Deferred references retain compositor namespace identity", \deferredReferences());
        addTestCase("Wrong and unbound compositor namespaces reject without corrupting schemas", \invalidScope());
        addTestCase("Provider fields and reconstruction retain resolved types", \consumers());
        addTestCase("Legacy array element declarations inherit their sequence scope", \arrayScope());
        set_return_value(main());
    }

    private string schema(string body) {
        return sprintf('<xs:schema xmlns:xs="%s" xmlns:p="%s" targetNamespace="%s">%s</xs:schema>',
            Xsd, Ns, Ns, body);
    }

    private XsdSchema parse(string body) {
        return new XsdSchema(schema(body), {"async_only": True});
    }

    private XsdComplexType record(XsdSchema s) {
        return cast<XsdComplexType>(s.findType(make_qname(Ns, "Record")));
    }

    private hash<auto> decode(XsdSchema s, hash<auto> value) {
        return record(s).deserializeValue("Record", s.getTypeMap(), NOTHING, value);
    }

    topLevel() {
        foreach string model in ("sequence", "choice", "all") {
            XsdSchema s = parse(sprintf('<xs:complexType name="Record"><xs:%s xmlns:q="%s">
                <xs:element name="flag" type="q:boolean"/></xs:%s></xs:complexType>', model, Xsd, model));
            assertEq("boolean", record(s).elementmap.flag.type.name);
            assertEq({"flag": False}, decode(s, {"flag": "false"}));
            assertEq({"flag": "false"}, record(s).serializeValue(s.nsc, {"flag": False}, True));
            assertEq(Ns, s.nsc.getInputNamespaceUri("p"));
        }
    }

    nestedSequence() {
        XsdSchema s = parse(sprintf('<xs:complexType name="Record"><xs:sequence xmlns:p="%s">
            <xs:sequence xmlns:p="%s"><xs:element name="flag" type="p:boolean"/></xs:sequence>
            <xs:element name="number" type="p:Number"/></xs:sequence></xs:complexType>
            <xs:simpleType name="Number"><xs:restriction base="xs:int"/></xs:simpleType>', Ns, Xsd));
        assertEq("boolean", record(s).elementmap.flag.type.name);
        assertEq("Number", record(s).elementmap.number.type.name);
        assertEq({"flag": False, "number": 0}, decode(s, {"flag": "false", "number": "0"}));
        assertEq(Ns, s.nsc.getInputNamespaceUri("p"));
    }

    nestedChoice() {
        foreach string model in ("sequence", "choice") {
            XsdSchema s = parse(sprintf('<xs:complexType name="Record"><xs:%s xmlns:p="%s">
                <xs:choice xmlns:p="%s"><xs:sequence><xs:element name="flag" type="p:boolean"/>
                <xs:sequence xmlns:p="%s"><xs:element name="count" type="p:Number"/></xs:sequence>
                </xs:sequence><xs:element name="text" type="p:string"/></xs:choice>
                </xs:%s></xs:complexType><xs:simpleType name="Number"><xs:restriction base="xs:int"/>
                </xs:simpleType>', model, Ns, Xsd, Ns, model));
            assertEq({"flag": False, "count": 0}, decode(s, {"flag": "false", "count": "0"}));
            assertEq({"text": ""}, decode(s, {"text": ""}));
        }
    }

    defaultNamespace() {
        XsdSchema s('<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
            <xs:simpleType name="Number"><xs:restriction base="xs:int"/></xs:simpleType></xs:schema>');
        s.addSchemaString(schema(sprintf('<xs:import/><xs:complexType name="Record"><xs:sequence xmlns="%s">
            <xs:element name="flag" type="boolean"/><xs:sequence xmlns=""><xs:element name="number"
            type="Number"/></xs:sequence><xs:element name="text" type="string"/></xs:sequence>
            </xs:complexType>', Xsd)));
        assertEq({"flag": False, "number": 0, "text": ""},
            decode(s, {"flag": "false", "number": "0", "text": ""}));
        assertEq(NOTHING, record(s).elementmap.number.type.ns);
        assertEq(NOTHING, s.nsc.getDefaultNs());
    }

    deferredReferences() {
        XsdSchema s = parse(sprintf('<xs:complexType name="Record"><xs:sequence xmlns:q="%s">
            <xs:element ref="q:global"/><xs:element name="number" type="q:Number"/>
            </xs:sequence></xs:complexType><xs:element name="global" type="xs:boolean"/>
            <xs:simpleType name="Number"><xs:restriction base="xs:int"/></xs:simpleType>', Ns));
        assertEq(Ns, record(s).elementmap.global.ns);
        assertEq("boolean", record(s).elementmap.global.type.name);
        assertEq("Number", record(s).elementmap.number.type.name);
        assertEq({"global": False, "number": 0}, decode(s, {"global": "false", "number": "0"}));
    }

    invalidScope() {
        XsdSchema s = parse('<xs:simpleType name="Number"><xs:restriction base="xs:int"/></xs:simpleType>');
        foreach string model in ("sequence", "choice", "all") {
            foreach string declaration in ('xmlns:p="urn:wrong"', '') {
                string prefix = declaration ? "p" : "missing";
                assertThrows(declaration ? "WSDL-ERROR" : "WSDL-NAMESPACE-ERROR", \s.addSchemaString(),
                    (schema(sprintf('<xs:complexType name="Invalid"><xs:%s %s><xs:element name="number"
                    type="%s:Number"/></xs:%s></xs:complexType>', model, declaration, prefix, model)),));
                assertEq(Ns, s.nsc.getInputNamespaceUri("p"));
                assertEq("Number", s.findType(make_qname(Ns, "Number")).name);
            }
        }
        s.addSchemaString(schema(sprintf('<xs:complexType name="Record"><xs:sequence xmlns:p="%s">
            <xs:element name="flag" type="p:boolean"/></xs:sequence></xs:complexType>', Xsd)));
        assertEq({"flag": False}, decode(s, {"flag": "false"}));
    }

    consumers() {
        XsdSchema original = parse(sprintf('<xs:complexType name="Record"><xs:sequence xmlns:q="%s">
            <xs:element name="flag" type="q:boolean"/><xs:element name="number" type="q:int"/>
            </xs:sequence></xs:complexType>', Xsd));
        XsdSchema restored = Serializable::deserialize(original.serialize());
        foreach XsdSchema s in (original, restored) {
            AbstractDataProviderType provider = record(s).getDataProviderType();
            assertEq(NT_BOOLEAN, provider.getFields().flag.getType().getBaseTypeCode());
            assertEq({"flag": False, "number": 0}, decode(s, {"flag": "false", "number": "0"}));
            assertEq({"flag": "false", "number": 0},
                record(s).serializeValue(s.nsc, {"flag": False, "number": 0}, True));
        }
    }

    arrayScope() {
        XsdSchema s = parse(sprintf('<xs:import namespace="http://schemas.xmlsoap.org/soap/encoding/"/>
            <xs:complexType name="Record"><xs:complexContent>
            <xs:restriction xmlns:soapenc="http://schemas.xmlsoap.org/soap/encoding/" base="soapenc:Array">
            <xs:sequence xmlns:q="%s"><xs:element name="item" type="q:int" maxOccurs="unbounded"/>
            </xs:sequence><xs:attribute ref="soapenc:arrayType" xmlns:w="http://schemas.xmlsoap.org/wsdl/"
            w:arrayType="xs:int[]"/></xs:restriction></xs:complexContent></xs:complexType>', Xsd));
        assertEq("int", record(s).elementmap.item.type.name);
        assertEq(-1, record(s).elementmap.item.maxOccurs);
        assertEq(NOTHING, record(s).getParticle().getChildren()[0].getMaxOccurs());
        assertTrue(record(s).getParticle().getChildren()[0].getElement() === record(s).elementmap.item);
        assertEq({"item": (0, 7)}, decode(s, {"item": ("0", "7")}));
    }
}
