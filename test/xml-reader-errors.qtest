%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires xml
%requires QUnit
%exec-class ReaderErrors

class ReaderErrors inherits QUnit::Test {
    constructor() : Test("XML reader error propagation", "1.0") {
        addTestCase("namespace errors in string and stream readers", \namespaceErrors());
        set_return_value(main());
    }

    private static consumeString(string text) {
        XmlReader reader(text);
        while (reader.read()) {
        }
    }

    private static consumeStream(string text) {
        StringInputStream input(text);
        XmlReader reader(input);
        while (reader.read()) {
        }
    }

    private namespaceErrors() {
        foreach string text in ("<root><u:Other/></root>", "<root u:attribute='value'/>") {
            assertThrows("PARSE-XML-EXCEPTION", "prefix u", \parse_xml(), text);
            assertThrows("PARSE-XML-EXCEPTION", "prefix u", \consumeString(), text);
            assertThrows("PARSE-XML-EXCEPTION", "prefix u", \consumeStream(), text);
        }
        string valid = "<root xmlns:u='urn:test'><u:Other/></root>";
        assertTrue(exists parse_xml(valid).root);
        consumeString(valid);
        consumeStream(valid);
    }
}
