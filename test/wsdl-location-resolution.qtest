#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires ../qlib/WSDL.qm
%requires HttpServer
%exec-class UriTest


class UriTest inherits QUnit::Test {
    constructor() : Test("WSDL URI resolution","1.0") {
        addTestCase("RFC 3986 section 5.4 normal and abnormal references",\examples());
        addTestCase("Query slashes and root/network paths keep URI component identity",\components());
        addTestCase("Directory bases preserve URL components and filesystem compatibility", \directories());
        addTestCase("Malformed references reject without contaminating later resolution", \invalid());
        addTestCase("HTTP root and nested schema retrieval works synchronously and asynchronously", \http());
        set_return_value(main());
    }
    private examples() {
        hash<string,string> examples = {
            "g:h":"g:h", "g":"http://a/b/c/g", "./g":"http://a/b/c/g", "g/":"http://a/b/c/g/",
            "/g":"http://a/g", "//g":"http://g", "?y":"http://a/b/c/d;p?y", "g?y":"http://a/b/c/g?y",
            "#s":"http://a/b/c/d;p?q#s", "g#s":"http://a/b/c/g#s", "g?y#s":"http://a/b/c/g?y#s",
            ";x":"http://a/b/c/;x", "g;x":"http://a/b/c/g;x", "g;x?y#s":"http://a/b/c/g;x?y#s",
            "":"http://a/b/c/d;p?q", ".":"http://a/b/c/", "./":"http://a/b/c/", "..":"http://a/b/",
            "../":"http://a/b/", "../g":"http://a/b/g", "../..":"http://a/", "../../":"http://a/",
            "../../g":"http://a/g", "../../../g":"http://a/g", "../../../../g":"http://a/g",
            "/./g":"http://a/g", "/../g":"http://a/g", "g.":"http://a/b/c/g.", ".g":"http://a/b/c/.g",
            "g..":"http://a/b/c/g..", "..g":"http://a/b/c/..g", "./../g":"http://a/b/g",
            "./g/.":"http://a/b/c/g/", "g/./h":"http://a/b/c/g/h", "g/../h":"http://a/b/c/h",
            "g;x=1/./y":"http://a/b/c/g;x=1/y", "g;x=1/../y":"http://a/b/c/y",
            "g?y/./x":"http://a/b/c/g?y/./x", "g?y/../x":"http://a/b/c/g?y/../x",
            "g#s/./x":"http://a/b/c/g#s/./x", "g#s/../x":"http://a/b/c/g#s/../x", "http:g":"http:g"
        };
        foreach string reference in (keys examples) {
            assertEq(examples{reference},WSDLLib::resolveDocumentLocation(reference,"http://a/b/c/d;p?q"));
        }
    }
    private components() {
        string base = "https://example.invalid/contracts/root.wsdl?path=x/y";
        assertEq("https://example.invalid/contracts/child.wsdl",WSDLLib::resolveDocumentLocation("child.wsdl",base));
        assertEq("https://example.invalid/shared/types.xsd",WSDLLib::resolveDocumentLocation("/shared/types.xsd",base));
        assertEq("https://cdn.example.invalid/shared.xsd",WSDLLib::resolveDocumentLocation("//cdn.example.invalid/shared.xsd",base));
        assertEq("https://example.invalid/contracts/root.wsdl?",WSDLLib::resolveDocumentLocation("?",base));
        assertEq(base+"#",WSDLLib::resolveDocumentLocation("#",base));
        assertEq("https://example.invalid/a//b",WSDLLib::resolveDocumentLocation("/a//b",base));
        assertEq("https://example.invalid/contracts/a%2Fb",WSDLLib::resolveDocumentLocation("a%2Fb",base));
    }

    private directories() {
        foreach string tail in ("?path=x/y", "#fragment/x", "?x/y#z/w", "") {
            assertEq("https://host/contracts", WSDLLib::getLocationBase("https://host/contracts/root.wsdl" + tail));
            assertEq("https://host", WSDLLib::getLocationBase("https://host" + tail));
        }
        assertEq("https://host/shared.xsd", WSDLLib::resolveLocation("/shared.xsd", "https://host/contracts"));
        assertEq("https://cdn/shared.xsd", WSDLLib::resolveLocation("//cdn/shared.xsd", "https://host/contracts"));
        assertEq("https://host/contracts/a.xsd?q=x/../y#z/../w",
            WSDLLib::resolveLocation("a.xsd?q=x/../y#z/../w", "https://host/contracts/"));
        assertEq("https://host/a//b.xsd", WSDLLib::resolveLocation("/a//b.xsd", "https://host"));
        assertEq("https://host/a//b.xsd", WSDLLib::resolveLocation("b.xsd",
            WSDLLib::getLocationBase("https://host/a//root.wsdl")));
        assertEq("https://user:secret@[::1]:8080/a", WSDLLib::getLocationBase("https://user:secret@[::1]:8080/a/b?x/y"));
        assertEq("file:///a/c.xsd", WSDLLib::resolveLocation("../c.xsd", "file:///a/b"));
        assertEq("/a/c.xsd", WSDLLib::resolveLocation("../c.xsd", "/a/b"));
        assertEq("/absolute.xsd", WSDLLib::resolveLocation("/absolute.xsd", "/a/b"));
        assertEq("/a/b/a b.xsd", WSDLLib::resolveLocation("a b.xsd", "/a/b"));
        assertEq("../relative.xsd", WSDLLib::resolveLocation("../relative.xsd"));
        assertEq("/a/b", WSDLLib::getLocationBase("/a/b/c?d#e"));
        assertEq("https://other/x", WSDLLib::resolveLocation("https://other/x", "/a/b"));
        assertEq("https://host/a/%2e%2e/%2F", WSDLLib::resolveDocumentLocation("%2e%2e/%2F", "https://host/a/b"));
        assertEq("https://host?", WSDLLib::resolveDocumentLocation("?", "https://host"));
        assertEq("file:///a/c.xsd", WSDLLib::resolveDocumentLocation("c.xsd", "file:///a/root.wsdl"));
        assertEq("https://host/a/", WSDLLib::resolveDocumentLocation("b/..", "https://host/a/root"));
    }

    private invalid() {
        foreach string bad in ("a b", "a\nb", "a\rb", "a\tb", "a" + chr(0) + "b", "1:relative", "%", "a%2", "%gg", "a?x=%gg", "a#%gg") {
            assertThrows("WSDL-LOCATION-ERROR", \WSDLLib::resolveDocumentLocation(), (bad, "https://host/a"));
        }
        assertThrows("WSDL-LOCATION-ERROR", \WSDLLib::resolveDocumentLocation(), ("child", "/not/a/uri"));
        assertThrows("WSDL-LOCATION-ERROR", \WSDLLib::resolveDocumentLocation(), ("child", "http://bad host/a"));
        foreach string bad in ("https://host/%", "https://host/?x=%gg", "https://host/#%gg") {
            assertThrows("WSDL-LOCATION-ERROR", \WSDLLib::resolveDocumentLocation(), ("child", bad));
        }
        assertEq("https://host/valid", WSDLLib::resolveDocumentLocation("valid", "https://host/a"));
    }

    private http() {
        foreach bool async in (False, True) {
            foreach string reference in ("types/one.xsd?version=x/y", "/contracts/types/one.xsd?version=x/y",
                    "//HOST/contracts/types/one.xsd?version=x/y#part/one") {
                HttpServer server();
                on_exit server.stop();
                Queue requests();
                # The server is fully configured before listener creation; worker state is immutable.
                UriDocumentPeer peer(reference, requests);
                server.setDefaultHandler("documents", peer);
                server.addListener(0);
                string host = sprintf("127.0.0.1:%d", server.getListenerInfo(0).port);
                string root = "http://" + host + "/contracts/root.wsdl?catalog=x/y#root/fragment";
                WebService ws;
                if (async) {
                    WsdlPollOperation op(root, {"timeout": 30000, "connect_timeout": 30000});
                    on_error op.abort();
                    date deadline = now_us() + 30s;
                    while (!op.goalReached()) {
                        *hash<SocketPollInfo> info = op.continuePoll();
                        if (info) {
                            int remaining = (deadline - now_us()).durationMilliseconds();
                            if (remaining <= 0) {
                                throw "TEST-ERROR", "asynchronous document retrieval deadline exceeded";
                            }
                            # Wait for socket readiness, bounded by the single overall deadline.
                            Socket::poll((info,), remaining);
                        }
                    }
                    ws = op.getOutput();
                } else {
                    ws = WSDLLib::getWebServiceFromUrl(root,
                        new HTTPClient({"timeout": 30000, "connect_timeout": 30000}));
                }
                assertEq("/contracts/root.wsdl?catalog=x/y", requests.get(30000));
                assertEq("/contracts/types/one.xsd?version=x/y", requests.get(30000));
                assertEq("/contracts/shared/two.xsd?part=x/y", requests.get(30000));
                assertEq(("Value",), ws.getElementNames("urn:uri"));
                XsdXmlValue value('<Value xmlns="urn:uri">42</Value>');
                assertEq(value, ws.validateXmlValue(value));
                assertThrows("SOAP-SERIALIZATION-ERROR", \ws.validateXmlValue(),
                    (new XsdXmlValue('<Value xmlns="urn:uri">wrong</Value>'),));
                auto saved = ws.serialize();
                server.stop();
                WebService restored = Serializable::deserialize(saved);
                assertEq(("Value",), restored.getElementNames("urn:uri"));
                assertEq(value, restored.validateXmlValue(value));
            }
        }
    }
}

class UriDocumentPeer inherits AbstractHttpRequestHandler {
    private {
        string reference;
        Queue requests;
    }
    constructor(string reference, Queue requests) {
        self.reference = reference;
        self.requests = requests;
    }
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        requests.push(cx.raw_path);
        string source;
        switch (cx.raw_path) {
            case "/contracts/root.wsdl?catalog=x/y":
                source = '<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"><types>'
                    + '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:uri">'
                    + '<xs:include schemaLocation="' + replace(reference, "HOST", hdr.host) + '"/>'
                    + '</xs:schema></types></definitions>';
                break;
            case "/contracts/types/one.xsd?version=x/y":
                source = '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:uri">'
                    + '<xs:include schemaLocation="../shared/two.xsd?part=x/y#part/two"/></xs:schema>';
                break;
            case "/contracts/shared/two.xsd?part=x/y":
                source = '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:uri">'
                    + '<xs:element name="Value" type="xs:int"/></xs:schema>';
                break;
            default:
                return makeResponse({}, 404, "unknown document");
        }
        return makeResponse({"Content-Type": "text/xml"}, 200, source);
    }
}
