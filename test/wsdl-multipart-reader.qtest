#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires ../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "MIME reader fixtures require json";
%else
%exec-class MultipartReaderTest

class MultipartReaderTest inherits QUnit::Test {
    constructor() : Test("SOAP multipart transport reader", "1.0") {
        hash<auto> manifest = parse_json(ReadOnlyFile::readTextFile(get_script_dir()
            + "/wsdl-interop/regressions/wsdl-multipart-reader/cases.json"));
        foreach hash<auto> row in (manifest.cases) {
            addTestCase(row.name, \check(), (row,));
        }
        addTestCase("Opaque HTTP MIME content bypasses attachment parsing", \opaque());
        addTestCase("Legacy transport metadata and body validation", \legacy());
        addTestCase("Shared multipart writer emits a valid related header", \sharedWriter());
        set_return_value(main());
    }

    private check(hash<auto> row) {
        binary wire = parse_base64_string(row.wire);
        hash<auto> message = {"body":wire,"_qore_orig_content_type":row.media};
        if (!row.valid) {
            assertThrows("SOAP-MESSAGE-ERROR", \WSDLLib::parseMultiPartSOAPMessage(), (message,));
            return;
        }
        foreach data source in (wire, binary_to_string(wire, "us-ascii")) {
            message.body = source;
            hash<auto> result = WSDLLib::parseMultiPartSOAPMessage(message);
            assertEq(parse_base64_string(row.root), result.body);
            assertEq(row.parts.size(), result.parts.size());
            foreach string id in (keys row.parts) {
                assertEq(parse_base64_string(row.parts{id}), result.parts{id}.body);
                assertEq("<" + id + ">", trim(result.parts{id}.hdr."content-id"));
            }
            assertEq(row.unidentified ?? 0, result.unidentified_parts.size());
            assertEq(row.mtom ?? False, result.is_mtom);
            assertEq("UTF-8", WSDLLib::getXmlMessageText(result).encoding());
            hash<auto> xml = WSDLLib::parseSOAPMessage(result);
            assertTrue(exists xml."s:Envelope"."s:Body".payload);
        }
    }

    private opaque() {
        hash<auto> msg = {"body":<00ff>, "_qore_multipart":"related", "_qore_orig_content_type":"multipart/related"};
        hash<auto> result = WSDLLib::parseMultiPartSOAPMessage(msg, True);
        assertEq(<00ff>, result.body);
        assertEq("multipart/related", result."content-type");
        assertFalse(exists result.parts);
        assertEq(<00ff>, WSDLLib::parseSOAPMessage(result, True).body);
    }

    private sharedWriter() {
        MultiPartRelatedMessage message("test-boundary");
        message.splicePart("<root/>", "<root@example.test>", "text/xml");
        hash<Mime::MessageInfo> wire = message.getMsgAndHeaders();
        assertEq("text/xml", WSDLLib::getContentTypeParameter(wire.hdr."Content-Type", "type"));
        assertEq("<root@example.test>", WSDLLib::getContentTypeParameter(wire.hdr."Content-Type", "start"));
        assertEq(binary("<root/>"), WSDLLib::parseMultiPartSOAPMessage(
            {"_qore_orig_content_type":wire.hdr."Content-Type", "body":wire.body}).body);
    }

    private legacy() {
        string body = "--b\r\nContent-Type: text/xml\r\nContent-ID: <root>\r\n\r\n<root/>\r\n--b--\r\n";
        hash<auto> msg();
        msg += {"_qore_multipart":"related", "_qore_multipart_boundary":"b", "body":body};
        assertEq(binary("<root/>"), WSDLLib::parseMultiPartSOAPMessage(msg).body);
        msg.body = NOTHING;
        assertThrows("SOAP-MESSAGE-ERROR", \WSDLLib::parseMultiPartSOAPMessage(), (msg,));
        msg.body = 123;
        assertThrows("SOAP-MESSAGE-ERROR", \WSDLLib::parseMultiPartSOAPMessage(), (msg,));
        assertEq({"content-type":"text/plain","header":NOTHING,"body":"hello"},
            WSDLLib::parseMultiPartSOAPMessage({"content-type":"text/plain","body":"hello"}));
    }
}
%endif
