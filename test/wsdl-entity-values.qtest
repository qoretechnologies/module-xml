#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class EntityValuesTest

class EntityValuesTest inherits QUnit::Test {
    const Uri = "urn:qore:entity-values";
    const Definitions = '<xs:simpleType name="Photo"><xs:restriction base="xs:ENTITY">
        <xs:enumeration value="photo"/></xs:restriction></xs:simpleType>
        <xs:simpleType name="EntityText"><xs:union memberTypes="xs:ENTITY xs:string"/></xs:simpleType>
        <xs:simpleType name="TextEntity"><xs:union memberTypes="xs:string xs:ENTITY"/></xs:simpleType>
        <xs:simpleType name="PhotoText"><xs:union memberTypes="t:Photo xs:string"/></xs:simpleType>
        <xs:simpleType name="EntityInt"><xs:union memberTypes="xs:ENTITY xs:int"/></xs:simpleType>
        <xs:simpleType name="Items"><xs:list itemType="xs:ENTITY"/></xs:simpleType>
        <xs:simpleType name="MixedItems"><xs:list itemType="t:EntityInt"/></xs:simpleType>
        <xs:simpleType name="MixedRestricted"><xs:restriction base="t:MixedItems">
        <xs:maxLength value="3"/></xs:restriction></xs:simpleType>
        <xs:simpleType name="ListText"><xs:union memberTypes="t:MixedRestricted xs:string"/></xs:simpleType>
        <xs:simpleType name="Enumerated"><xs:restriction base="t:EntityText">
        <xs:enumeration value="photo"/></xs:restriction></xs:simpleType>';

    constructor() : Test("XSD ENTITY instance values", "1.0") {
        addTestCase("Element boundaries enforce selected ENTITY obligations", \elementValues());
        addTestCase("Union facet failures permit datatype alternatives", \alternatives());
        addTestCase("Attribute and simple-content instance constraints", \attributes());
        addTestCase("Defaults retain declaration QName identity", \defaultNamespaces());
        addTestCase("Omitted and nilled ENTITY values have no entity name", \omissions());
        addTestCase("Retained XML has the same declaration context", \retained());
        addTestCase("Detached datatype equality remains independent of declarations", \datatypes());
        addTestCase("Reentrant conversion and cancellation restore instance captures", \recovery());
        addTestCase("Concurrent instance conversions keep independent captures", \concurrency());
        set_return_value(main());
    }

    private static XsdSchema schema(string datatype, string extra = "") {
        return new XsdSchema('<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
            xmlns:t="' + Uri + '" targetNamespace="' + Uri + '">' + Definitions + extra
            + '<xs:element name="value" type="' + datatype + '"/></xs:schema>', {"async_only": True});
    }

    private rejected(XsdSchema definition, auto native, string lexical) {
        XsdElement element = definition.getElement(Uri, "value");
        assertThrows("SOAP-SERIALIZATION-ERROR", \definition.serializeXmlValue(), (Uri, "value", native));
        assertThrows("SOAP-DESERIALIZATION-ERROR", \element.deserializeValue(),
            (definition.getTypeMap(), NOTHING, lexical, True));
        # Repeat on the same objects after each rejection; scoped captures must restore.
        assertThrows("SOAP-SERIALIZATION-ERROR", \definition.serializeXmlValue(), (Uri, "value", native));
    }

    private elementValues() {
        foreach string datatype in ("xs:ENTITY", "xs:ENTITIES", "t:Photo", "t:EntityText", "t:EntityInt",
                "t:PhotoText", "t:Enumerated", "t:Items", "t:MixedItems", "t:MixedRestricted", "t:ListText") {
            XsdSchema original = schema(datatype);
            foreach XsdSchema definition in (original, Serializable::deserialize(original.serialize())) {
                bool list = datatype == "t:Items" || datatype == "t:MixedItems" || datatype == "t:MixedRestricted";
                rejected(definition, list ? ("photo",) : "photo", "photo");
                if (datatype == "t:MixedItems" || datatype == "t:MixedRestricted" || datatype == "t:ListText") {
                    rejected(definition, (17, "photo", 18), "17 photo 18");
                }
            }
        }
    }

    private alternatives() {
        foreach hash<auto> row in ({"type": "t:TextEntity", "native": "photo", "lexical": "photo"},
                {"type": "t:PhotoText", "native": "other", "lexical": "other"},
                {"type": "t:EntityInt", "native": 17, "lexical": "17"},
                {"type": "t:EntityText", "native": "", "lexical": ""},
                {"type": "t:Items", "native": (), "lexical": ""},
                {"type": "t:MixedRestricted", "native": (17, 18), "lexical": "17 18"},
                {"type": "t:ListText", "native": "17 18 19 20", "lexical": "17 18 19 20"}) {
            XsdSchema original = schema(row.type);
            foreach XsdSchema definition in (original, Serializable::deserialize(original.serialize())) {
                XsdXmlValue xml = definition.serializeXmlValue(Uri, "value", row.native);
                assertEq(row.lexical, parse_xml(xml.getXml()).firstValue()."^value^" ?? "");
                XsdElement element = definition.getElement(Uri, "value");
                auto decoded = element.deserializeValue(definition.getTypeMap(), NOTHING, row.lexical, True);
                assertEq(xml.getXml(), definition.serializeXmlValue(Uri, "value", decoded).getXml());
            }
        }
        XsdSchema recover = schema("t:EntityInt");
        foreach int value in (17, 18, 19) {
            rejected(recover, "photo", "photo");
            assertEq(value, recover.getElement(Uri, "value").deserializeValue(recover.getTypeMap(), NOTHING,
                string(value), True));
        }
    }

    private attributes() {
        foreach bool entity_content in (False, True) {
            string content = entity_content ? "t:EntityText" : "xs:string";
            string attribute = entity_content ? "xs:string" : "t:EntityText";
            foreach bool defaulted in (False, True) {
                XsdSchema definition = schema("t:Record", '<xs:complexType name="Record"><xs:simpleContent>
                    <xs:extension base="' + content + '"><xs:attribute name="choice" type="' + attribute + '" '
                    + (defaulted ? 'default="photo"' : 'use="required"')
                    + '/></xs:extension></xs:simpleContent></xs:complexType>');
                hash<auto!> value = {"^value^": "photo"};
                if (!defaulted) {
                    value."^attributes^" = {"choice": "photo"};
                }
                assertThrows("SOAP-SERIALIZATION-ERROR", \definition.serializeXmlValue(), (Uri, "value", value));
                XsdElement element = definition.getElement(Uri, "value");
                assertThrows("SOAP-DESERIALIZATION-ERROR", \element.deserializeValue(),
                    (definition.getTypeMap(), NOTHING, value, True));
            }
        }
    }

    private defaultNamespaces() {
        foreach string datatype in ("xs:QName", "t:QNameText") {
            XsdSchema original = schema("t:Record", '<xs:simpleType name="QNameText">'
                '<xs:union memberTypes="xs:QName xs:string"/></xs:simpleType>'
                '<xs:complexType name="Record"><xs:attribute xmlns:p="urn:declaration" name="category"'
                ' type="' + datatype + '" default="p:Photo"/></xs:complexType>');
            foreach XsdSchema definition in (original, Serializable::deserialize(original.serialize())) {
                XsdElement element = definition.getElement(Uri, "value");
                foreach hash<auto> attributes in ({}, {"xmlns:p": "urn:instance"}) {
                    hash<auto> value = element.deserializeValue(definition.getTypeMap(), NOTHING,
                        {"^attributes^": attributes}, True);
                    XsdQNameValue category = value."^attributes^".category;
                    assertEq("urn:declaration", category.getNamespaceUri());
                    assertEq("Photo", category.getLocalName());
                }
            }
        }
    }

    private omissions() {
        XsdSchema definition = schema("t:Record", '<xs:complexType name="Record"><xs:sequence>
            <xs:element name="absent" type="xs:ENTITY" minOccurs="0"/>
            <xs:element name="nil" type="xs:ENTITY" nillable="true"/>
            </xs:sequence><xs:attribute name="absent" type="xs:ENTITY"/></xs:complexType>');
        XsdXmlValue xml = definition.serializeXmlValue(Uri, "value", {"nil": NOTHING});
        assertTrue(index(xml.getXml(), 'xsi:nil="true"') >= 0);
        assertFalse(index(xml.getXml(), "absent") >= 0);
    }

    private retained() {
        XsdSchema definition = schema("t:EntityText");
        XsdElement element = definition.getElement(Uri, "value");
        foreach string prefix in ("", '<!DOCTYPE value [<!NOTATION image SYSTEM "image"><!ENTITY photo
                SYSTEM "photo" NDATA image>]>') {
            XsdXmlValue xml(prefix + '<value xmlns="' + Uri + '">photo</value>');
            assertThrows("SOAP-SERIALIZATION-ERROR", \element.validateXmlValue(),
                (xml, definition.nsc, definition.getTypeMap()));
        }
    }

    private recovery() {
        XsdSchema definition = schema("t:EntityInt");
        XsdSimpleType type = definition.findType(make_qname(Uri, "EntityInt"));
        EntityContextProbe probe(definition.nsc, schema("t:EntityText"));
        type.unionTypes = (probe,) + type.unionTypes;
        on_exit type.unionTypes = type.unionTypes[1 ..];
        # The document wrapper observes the actual selection without another callback.
        type.serializeValue(definition.nsc, 17, True);
        int expected_calls = probe.calls;
        probe.calls = 0;
        definition.serializeXmlValue(Uri, "value", 17);
        assertEq(expected_calls, probe.calls);
        rejected(definition, "photo", "photo");
        foreach string error in ("CONTROLLED-ERROR", "THREAD-CANCELLED") {
            probe.error = error;
            assertThrows(error, \definition.serializeXmlValue(), (Uri, "value", 17));
            probe.error = NOTHING;
            assertEq(17, definition.getElement(Uri, "value").deserializeValue(definition.getTypeMap(),
                NOTHING, "17", True));
            rejected(definition, "photo", "photo");
        }
        Program program(PO_MODERN);
        SandboxManager manager();
        on_exit manager.clearInterrupt();
        program.setSandboxManager(manager);
        program.parse("%modern\nsub execute(code<nothing()> work) { work(); }\n",
            get_script_dir() + "/entity-context-interrupt.qr");
        probe.manager = manager;
        code<nothing()> work = sub() {
            definition.serializeXmlValue(Uri, "value", 17);
        };
        *hash<ExceptionInfo> failure;
        try {
            program.callFunction("execute", work);
        } catch (hash<ExceptionInfo> ex) {
            failure = ex;
        }
        manager.clearInterrupt();
        probe.manager = NOTHING;
        assertEq("PROGRAM-INTERRUPTED", failure.err);
        assertEq(17, definition.getElement(Uri, "value").deserializeValue(definition.getTypeMap(),
            NOTHING, "17", True));
        rejected(definition, "photo", "photo");
    }

    private concurrency() {
        XsdSchema definition = schema("t:EntityInt");
        Qore::Thread::Queue ready();
        Qore::Thread::Queue start();
        Qore::Thread::Queue results();
        Qore::Thread::Counter running();
        on_exit {
            for (int i = 0; i < 4; ++i) {
                start.push(True);
            }
            assertEq(0, running.waitForZero(30s));
        }
        for (int i = 0; i < 4; ++i) {
            running.inc();
            background sub(int index) {
                on_exit running.dec();
                ready.push(True);
                try {
                    start.get(30s);
                    XsdSchema local = Serializable::deserialize(definition.serialize());
                    XsdElement element = local.getElement(Uri, "value");
                    for (int j = 0; j < 8; ++j) {
                        *string rejected;
                        try {
                            local.serializeXmlValue(Uri, "value", "photo");
                        } catch (hash<ExceptionInfo> ex) {
                            rejected = ex.err;
                        }
                        @assert(rejected == "SOAP-SERIALIZATION-ERROR");
                        int value = 17 + index;
                        @assert(element.deserializeValue(local.getTypeMap(), NOTHING, string(value), True) === value);
                        local.serializeXmlValue(Uri, "value", value);
                    }
                    results.push(index);
                } catch (hash<ExceptionInfo> ex) {
                    results.push(ex);
                }
            }(i);
        }
        for (int i = 0; i < 4; ++i) {
            ready.get(30s);
        }
        for (int i = 0; i < 4; ++i) {
            start.push(True);
        }
        hash<string, bool> seen();
        for (int i = 0; i < 4; ++i) {
            auto result = results.get(30s);
            assertEq(NT_INT, result.typeCode());
            assertFalse(exists seen{result});
            seen{result} = True;
        }
    }

    private datatypes() {
        XsdSchema definition = schema("t:Enumerated");
        XsdAbstractType type = definition.findType(make_qname(Uri, "Enumerated"));
        assertEq("photo", type.deserializeValue("value", definition.getTypeMap(), NOTHING, "photo"));
        assertEq("photo", type.serializeValue(definition.nsc, "photo", True));
        UnionDataType provider = type.getDataProviderType();
        assertEq("photo", provider.acceptsValue("photo"));
        assertEq("string:photo", provider.valueKey("photo"));
        assertEq(("photo",), type.getAllowedValues());
    }
}

class EntityContextProbe inherits XsdBaseType {
    public {
        int calls = 0;
        *string error;
        *SandboxManager manager;
    }
    private { XsdSchema nested; }
    constructor(Namespaces namespaces, XsdSchema nested) : XsdBaseType("string", namespaces) {
        self.nested = nested;
    }
    private nestedValue() {
        ++calls;
        *string rejected;
        try {
            nested.serializeXmlValue(EntityValuesTest::Uri, "value", "photo");
        } catch (hash<ExceptionInfo> ex) {
            rejected = ex.err;
        }
        @assert(rejected == "SOAP-SERIALIZATION-ERROR");
        if (manager) {
            manager.requestInterrupt();
        }
        if (error) {
            throw error, "controlled conversion interruption";
        }
    }
    auto serializeValue(Namespaces namespaces, auto value, *softbool omitType) {
        nestedValue();
        throw "SOAP-SERIALIZATION-ERROR", "controlled member rejection after nested document conversion";
    }
    auto deserializeValue(string name, hash<string, XsdAbstractType> types, *hash<auto> references, auto value) {
        nestedValue();
        throw "SOAP-DESERIALIZATION-ERROR", "controlled member rejection after nested document conversion";
    }
}
