#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# Copyright (C) 2026 Qore Technologies, s.r.o.

%requires qore >= 2.3
%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires ../qlib/WSDL.qm

%exec-class WsdlUrlMaskingTest

#! The errors of loading a WSDL and of resolving its locations do not contain the password of a URL
class WsdlUrlMaskingTest inherits QUnit::Test {
    private {
        string secret = "wsdl-secret-" + WsdlUrlMaskingTest::randomString(12);
    }

    constructor() : QUnit::Test("WsdlUrlMasking", "1.0", \ARGV) {
        addTestCase("maskUrl()", \maskTest());
        addTestCase("WSDL load errors", \loadErrorTest());
        addTestCase("location errors", \locationErrorTest());
        set_return_value(main());
    }

    #! Returns a random string
    private static string randomString(int len) {
        string rv;
        for (int i = 0; i < len; ++i) {
            rv += chr(ord("a") + rand() % 26);
        }
        return rv;
    }

    maskTest() {
        assertEq("http://user:<masked>@host/x.wsdl", WSDLLib::maskUrl("http://user:" + secret + "@host/x.wsdl"));
        # not a URL that can be parsed
        assertEq("resource://user:<masked>@svc:orders.wsdl",
            WSDLLib::maskUrl("resource://user:" + secret + "@svc:orders.wsdl"));
        # nothing to mask
        map assertEq($1, WSDLLib::maskUrl($1), $1), ("http://host/x.wsdl", "https://user@host/x.wsdl", "orders.wsdl");
    }

    loadErrorTest() {
        # nothing listens on this port
        Socket s();
        s.bind("127.0.0.1:0");
        int port = s.getSocketInfo().port;
        s.close();
        string url = sprintf("http://user:%s@127.0.0.1:%d/orders.wsdl", secret, port);
        hash<ExceptionInfo> ex = getException(\WSDLLib::getHTTP(), (url, "/orders.wsdl"));
        assertEq(-1, ex.desc.find(secret), ex.desc);
        assertRegex(sprintf("^error loading WSDL from \"http://user:<masked>@127.0.0.1:%d", port), ex.desc);

        ex = getException(\WSDLLib::getFTP(), ("ftp://user:" + secret + "@host/", "/"));
        assertEq("WSDL-LIB-ERROR", ex.err);
        assertEq("missing file name in URL \"ftp://user:<masked>@host/\"", ex.desc);
    }

    locationErrorTest() {
        hash<ExceptionInfo> ex = getException(\WSDLLib::resolveDocumentLocation(), ("types.xsd",
            "resource://user:" + secret + "@svc:orders.wsdl"));
        assertEq("WSDL-LOCATION-ERROR", ex.err);
        assertEq(-1, ex.desc.find(secret), ex.desc);
        assertRegex("against document location \"resource://user:<masked>@svc:orders.wsdl\"", ex.desc);
    }

    #! Returns the exception that a call raises
    private hash<ExceptionInfo> getException(code c, list<auto> args) {
        try {
            call_function_args(c, args);
        } catch (hash<ExceptionInfo> ex) {
            return ex;
        }
        throw "TEST-ERROR", "the call did not raise an exception";
    }
}
