#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "SOAP grammar fixtures require json";
%else
%exec-class SoapGrammarTest
class SoapGrammarTest inherits QUnit::Test {
    constructor() : Test("SOAP binding extension grammar", "1.0") {
        hash<auto> manifest = parse_json(ReadOnlyFile::readTextFile(get_script_dir() + "/wsdl-interop/regressions/wsdl-soap-grammar/cases.json"));
        foreach hash<auto> row in (manifest.cases) {
            addTestCase(row.name, \check(), (row,));
        }
        set_return_value(main());
    }
    private static WebService parse(string source) {
        return new WebService(source, {"async_only":True});
    }
    private check(hash<auto> row) {
        if (!row.valid) {
            assertThrows("WSDL-ERROR", \parse(), (row.xml,));
            return;
        }
        WebService original = parse(row.xml);
        foreach WebService ws in (original, Serializable::deserialize(original.serialize()),
                Serializable::deserialize(original.serializeToData())) {
            assertEq(row.xml, ws.getWSDL());
            assertEq(row.name.startsWith("12/"), ws.getBinding("B").isSoap12());
            AbstractDataProviderType provider = ws.getMessage("M").getDataProviderType(True);
            hash<auto> body = {"body":"body value"};
            assertEq(body, provider.acceptsValue(body));
            WSOperation current = ws.getBindingOperation("B", "call");
            foreach WSOperation op in (current, Serializable::deserialize(current.serialize())) {
                assertEq("urn:call", op.getBinding("B").soapAction);
                assertEq("body", op.getBinding("B").input.getHeaders()[0].part);
                assertEq("body", op.getBinding("B").input.getHeaders()[0].getHeaderFaults()[0].part);
                hash<auto> headers = {"M":{"body":"header value"}};
                string request = op.serializeRequest(body, headers).body;
                assertEq({"^body^":body,"^headers^":headers}, op.deserializeRequest(parse_xml(request), "B", True));
                string response = op.serializeResponse({"body":"response value"}).body;
                assertEq("response value", op.deserializeResponse(parse_xml(response), "B", True));
                auto example = provider.getExampleValue();
                assertEq(example.body, op.deserializeResponse(parse_xml(op.serializeResponse(example).body), "B", True));
                string fault = op.serializeFault("Failure", "description", "fault value").body;
                assertEq("fault value", op.deserializeFault(fault, "Failure", "B", True));
                string headerfault = op.serializeHeaderFault(<SoapHeaderFaultInfo>{"message":"M","part":"body",
                    "value":"header failure"}, "description").body;
                assertEq("header failure", op.deserializeHeaderFault(headerfault, "M", "body", "B", True, True));
            }
        }
    }
}
%endif
