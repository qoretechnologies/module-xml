#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class SampleInstancesTest

class SampleInstancesTest inherits QUnit::Test {
    const Uri = "urn:qore:sample-instance";
    constructor() : Test("WSDL generated instance requirements", "1.0") {
        addTestCase("Native element and type-part samples fail before returning invalid ENTITY values", \entities());
        addTestCase("Multipart examples check every element and type part", \multipart());
        addTestCase("Generated records check attributes and simple content", \records());
        addTestCase("Valid samples retain values and explanatory options", \validValues());
        addTestCase("Generated occurrence limits are checked without truncating a required instance", \occurrences());
        addTestCase("QName samples retain declaration identity and namespace ownership", \qnames());
        addTestCase("Concurrent nested sample calls validate each root once", \concurrency());
        addTestCase("Helper subclasses retain nested generation hooks and root validation", \subclassHooks());
        addTestCase("Sample validation preserves callback errors and validates each leaf once", \callbacks());
        addTestCase("Repeated sample groups retain complete pairs and child budgets", \particleGroups());
        addTestCase("Sample choices retain their sequence positions and native aliases", \particleChoices());
        addTestCase("Shared group samples preserve declaration counts", \particleReferences());
        addTestCase("Typed complex parts generate children and attributes", \typedRecords());
        addTestCase("Recursive and repeated complex samples respect finite generation budgets", \finiteSamples());
        addTestCase("Sample limits reject invalid option types", \sampleOptions());
        addTestCase("List-valued sample children retain each occurrence", \particleLists());
        addTestCase("Repeated generation hooks retain values and independent reentrant roots", \reentrantGeneration());
        addTestCase("Output budgets include complete values supplied by overrides", \overrideBudgets());
        addTestCase("Output budgets include embedded XML fragments", \fragmentBudgets());
        set_return_value(main());
    }

    private static WebService service(string datatype, string extra = "", bool typed = False, *string second_type) {
        return new WebService('<w:definitions xmlns:w="http://schemas.xmlsoap.org/wsdl/"
            xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="' + Uri + '" targetNamespace="' + Uri + '">
            <w:types><xs:schema targetNamespace="' + Uri + '">
            <xs:simpleType name="EntityText"><xs:union memberTypes="xs:ENTITY xs:string"/></xs:simpleType>
            <xs:simpleType name="TextEntity"><xs:union memberTypes="xs:string xs:ENTITY"/></xs:simpleType>
            <xs:simpleType name="Items"><xs:list itemType="xs:ENTITY"/></xs:simpleType>' + extra
            + '<xs:element name="value" type="' + datatype + '"/></xs:schema></w:types>
            <w:message name="Request"><w:part name="body" ' + (typed ? 'type="' + datatype : 'element="t:value')
            + '"/>' + (second_type ? '<w:part name="code" type="' + second_type + '"/>' : "")
            + '</w:message></w:definitions>', {"async_only": True});
    }

    private entities() {
        foreach string datatype in ("xs:ENTITY", "xs:ENTITIES", "t:EntityText", "t:Items") {
            foreach bool typed in (False, True) {
                WebService original = service(datatype, "", typed);
                foreach WebService ws in (original, Serializable::deserialize(original.serialize())) {
                    WSMessageHelper helper(ws);
                    XsdElement element = ws.getElement(Uri, "value");
                    assertThrows("XSD-SAMPLE-ERROR", \helper.getMessage(), (element,));
                    *hash<ExceptionInfo> failure;
                    try {
                        helper.getMessage(element);
                    } catch (hash<ExceptionInfo> ex) {
                        failure = ex;
                    }
                    assertTrue(index(failure.desc, "ENTITY") >= 0);
                    assertThrows("XSD-SAMPLE-ERROR", \helper.getMessage(), (ws.messages.Request,));
                    ws.idocmap.value = element;
                    assertThrows("XSD-SAMPLE-ERROR", \helper.getMessage(), ("value",));
                }
            }
        }
        WebService ws = service("t:Items");
        XsdSimpleType items = ws.findType(make_qname(Uri, "Items"));
        assertEq("", items.serializeValue(ws.nsc, (), True));
        assertEq(("photo",), items.getSampleValue(("photo",)));
    }

    private multipart() {
        foreach bool typed in (False, True) {
            WebService valid = service("t:TextEntity", "", typed, "xs:int");
            WSMessageHelper helper(valid);
            assertEq({"body": "abc", "code": 123}, helper.getMessage(valid.messages.Request));
            foreach hash<auto> types in ({"first": "t:TextEntity", "second": "xs:ENTITY"},
                    {"first": "xs:ENTITY", "second": "xs:int"}) {
                WebService invalid = service(types.first, "", typed, types.second);
                WSMessageHelper failure(invalid);
                assertThrows("XSD-SAMPLE-ERROR", \failure.getMessage(), (invalid.messages.Request,));
            }
        }
    }

    private records() {
        foreach string extra in ('<xs:complexType name="Record"><xs:simpleContent>
                <xs:extension base="t:EntityText"><xs:attribute name="label" type="xs:string" use="required"/>
                </xs:extension></xs:simpleContent></xs:complexType>',
                '<xs:complexType name="Record"><xs:attribute name="image" type="xs:ENTITY" default="photo"/>
                </xs:complexType>',
                '<xs:complexType name="Record"><xs:sequence><xs:element name="item" type="xs:ENTITY" maxOccurs="3"/>
                </xs:sequence></xs:complexType>') {
            WebService original = service("t:Record", extra);
            foreach WebService ws in (original, Serializable::deserialize(original.serialize())) {
                WSMessageHelper helper(ws);
                assertThrows("XSD-SAMPLE-ERROR", \helper.getMessage(), (ws.messages.Request,));
                assertThrows("XSD-SAMPLE-ERROR", \helper.getXmlMessage(), (ws.messages.Request,));
            }
        }
    }

    private particleGroups() {
        WebService original = service("t:Record", '<xs:complexType name="Record">'
            '<xs:sequence minOccurs="2" maxOccurs="3"><xs:element name="quantity" type="xs:int"/>'
            '<xs:element name="note" type="xs:string"/></xs:sequence></xs:complexType>');
        foreach WebService ws in (original, Serializable::deserialize(original.serialize())) {
            foreach int budget in (5, 7) {
                WSMessageHelper helper(ws, {"max_elements": budget});
                hash<auto> value = helper.getMessage(ws.messages.Request).value;
                int count = (budget - 1) / 2;
                assertEq(count, value.quantity.size());
                assertEq(count, value.note.size());
                assertEq(123, value.quantity[0]);
                assertEq("abc", value.note[0]);
                XsdComplexType type = ws.findType(make_qname(Uri, "Record"));
                hash<auto> wire = type.serializeValue(ws.nsc.copy(), value, True);
                assertEq(count * 2, wire.size());
                assertEq(("quantity", "note", "quantity^1", "note^1"), (keys wire)[0..3]);
                hash<auto> retained = helper.getXmlMessage(ws.messages.Request).body.getElementData();
                remove retained."^attributes^";
                assertEq(keys wire, keys retained);
            }
            WSMessageHelper limited(ws, {"max_elements": 4});
            assertThrows("XSD-SAMPLE-ERROR", \limited.getMessage(), (ws.messages.Request,));
            WSMessageHelper comments(ws, {"comments": True, "max_items": 2});
            hash<auto> value = comments.getMessage(ws.messages.Request).value;
            assertTrue(index(value.quantity[0]."^comment^", "minOccurs:2") >= 0);
            assertTrue(index(value.quantity[1]."^comment^", "#2") >= 0);
        }
    }

    private particleChoices() {
        WebService ws = service("t:Record", '<xs:complexType name="Record"><xs:sequence>'
            '<xs:choice><xs:sequence><xs:element name="p" type="xs:int"/><xs:element name="a" type="xs:int"/>'
            '</xs:sequence><xs:sequence><xs:element name="q" type="xs:int"/><xs:element name="a" type="xs:int"/>'
            '</xs:sequence></xs:choice><xs:element name="tail" type="xs:int"/></xs:sequence></xs:complexType>');
        hash<auto> value = new WSMessageHelper(ws).getMessage(ws.messages.Request).value;
        assertEq({"p": 123, "a": 123, "tail": 123}, value);
        XsdComplexType type = ws.findType(make_qname(Uri, "Record"));
        assertEq(("p", "a", "tail"), keys type.serializeValue(ws.nsc.copy(), value, True));
        ws = service("t:Record", '<xs:complexType name="Record"><xs:sequence><xs:choice>'
            '<xs:element name="a" type="xs:int" form="qualified"/>'
            '<xs:element name="a" type="xs:int"/></xs:choice><xs:element name="tail" type="xs:int"/>'
            '</xs:sequence></xs:complexType>');
        value = new WSMessageHelper(ws).getMessage(ws.messages.Request).value;
        assertEq({"{" + Uri + "}a": 123, "tail": 123}, value);
        WebService restored = Serializable::deserialize(ws.serialize());
        assertEq(value, new WSMessageHelper(restored).getMessage(restored.messages.Request).value);
    }

    private particleReferences() {
        WebService original = service("t:Record", '<xs:group name="Pair"><xs:sequence>'
            '<xs:element name="a" type="xs:int"/><xs:element name="b" type="xs:int"/></xs:sequence></xs:group>'
            '<xs:complexType name="Optional"><xs:sequence><xs:group ref="t:Pair" minOccurs="0" maxOccurs="unbounded"/>'
            '</xs:sequence></xs:complexType><xs:complexType name="Record"><xs:sequence>'
            '<xs:group ref="t:Pair" minOccurs="2" maxOccurs="2"/><xs:element name="tail" type="xs:int"/>'
            '<xs:group ref="t:Pair"/></xs:sequence></xs:complexType>');
        foreach WebService ws in (original, Serializable::deserialize(original.serialize())) {
            XsdComplexType type = ws.findType(make_qname(Uri, "Record"));
            XsdElement a = type.getParticle().getChildren()[0].getGroupDefinition().getChildren()[0].getElement();
            assertEq(1, a.minOccurs);
            assertEq(1, a.maxOccurs);
            hash<auto> sample = new WSMessageHelper(ws).getMessage(ws.messages.Request).value;
            assertEq({"a": (123, 123, 123), "b": (123, 123, 123), "tail": 123}, sample);
            assertEq(("a", "b", "a^1", "b^1", "tail", "a^2", "b^2"),
                keys type.serializeValue(ws.nsc.copy(), sample, True));
            assertEq(1, a.minOccurs);
            assertEq(1, a.maxOccurs);
        }
    }

    private typedRecords() {
        WebService original = service("t:Record", '<xs:complexType name="Record"><xs:sequence>'
            '<xs:element name="item" type="xs:int" minOccurs="2" maxOccurs="3"/></xs:sequence>'
            '<xs:attribute name="label" type="xs:string" use="required"/></xs:complexType>', True);
        foreach WebService ws in (original, Serializable::deserialize(original.serialize())) {
            hash<auto> sample = new WSMessageHelper(ws).getMessage(ws.messages.Request);
            assertEq({"item": (123, 123, 123), "^attributes^": {"label": "abc"}}, sample);
        }
    }

    private finiteSamples() {
        WebService ws = service("t:Record", '<xs:complexType name="Record"><xs:sequence>'
            '<xs:element name="child" type="t:Record" minOccurs="0"/></xs:sequence></xs:complexType>');
        assertEq({"value": {"child": {}}}, new WSMessageHelper(ws, {"max_elements": 2}).getMessage(ws.messages.Request));
        assertEq({"value": {}}, new WSMessageHelper(ws, {"max_elements": 1}).getMessage(ws.messages.Request));
        ws = service("t:Record", '<xs:complexType name="Record"><xs:sequence>'
            '<xs:element name="child" type="t:Record"/></xs:sequence></xs:complexType>');
        WSMessageHelper recursive(ws);
        assertThrows("XSD-SAMPLE-ERROR", \recursive.getMessage(), (ws.messages.Request,));
        ws = service("t:Record", '<xs:complexType name="Child"><xs:sequence>'
            '<xs:element name="leaf" type="xs:int"/></xs:sequence></xs:complexType>'
            '<xs:complexType name="Record"><xs:sequence><xs:element name="child" type="t:Child"'
            ' minOccurs="2" maxOccurs="3"/></xs:sequence></xs:complexType>');
        hash<auto> sample = new WSMessageHelper(ws, {"max_elements": 7}).getMessage(ws.messages.Request);
        assertEq(({"leaf": 123}, {"leaf": 123}, {"leaf": 123}), sample.value.child);
        WSMessageHelper limited(ws, {"max_elements": 4});
        assertThrows("XSD-SAMPLE-ERROR", \limited.getMessage(), (ws.messages.Request,));
        assertEq(sample, new WSMessageHelper(ws, {"max_elements": 7}).getMessage(ws.messages.Request));
    }

    private sampleOptions() {
        WebService ws = service("xs:string");
        foreach auto value in (0, -1, "3", 1.5, NOTHING) {
            assertThrows("WSDL-HELPER-ERROR", sub() { new WSMessageHelper(ws, {"max_elements": value}); });
            assertThrows("WSDL-HELPER-ERROR", sub() { new WSMessageHelper(ws, {"max_items": value}); });
        }
    }

    private particleLists() {
        WebService original = service("t:Record", '<xs:simpleType name="Numbers"><xs:list itemType="xs:int"/>'
            '</xs:simpleType><xs:complexType name="Record"><xs:sequence minOccurs="2" maxOccurs="2">'
            '<xs:element name="numbers" type="t:Numbers"/></xs:sequence></xs:complexType>');
        foreach WebService ws in (original, Serializable::deserialize(original.serialize())) {
            hash<auto> value = new WSMessageHelper(ws).getMessage(ws.messages.Request).value;
            assertEq({"numbers": ((123,), (123,))}, value);
            XsdComplexType type = ws.findType(make_qname(Uri, "Record"));
            assertEq({"numbers": ("123", "123")}, type.serializeValue(ws.nsc.copy(), value, True));
        }
    }

    private reentrantGeneration() {
        WebService ws = service("t:Record", '<xs:element name="probe" type="xs:string"/>'
            '<xs:complexType name="Record"><xs:sequence><xs:element name="item" type="xs:int"'
            ' minOccurs="3" maxOccurs="3"/></xs:sequence></xs:complexType>');
        ReentrantSampleHelper helper(ws, ws.getElement(Uri, "probe"));
        assertEq({"value": {"item": (1, 2, 3)}}, helper.getMessage(ws.messages.Request));
        assertEq(3, helper.calls);
        assertEq({"value": {"item": (4, 5, 6)}}, helper.getMessage(ws.messages.Request));
        assertEq(6, helper.calls);
    }

    private overrideBudgets() {
        foreach bool repeated in (False, True) {
            string children = repeated ? '<xs:element name="a" type="xs:int" minOccurs="3" maxOccurs="3"/>'
                : '<xs:element name="a" type="xs:int"/><xs:element name="b" type="xs:int"/>'
                    '<xs:element name="c" type="xs:int"/>';
            foreach bool typed in (False, True) {
                WebService ws = service("t:Record", '<xs:complexType name="Child"><xs:sequence>' + children
                    + '</xs:sequence><xs:attribute name="label" type="xs:string"/></xs:complexType>'
                    '<xs:complexType name="Record"><xs:sequence><xs:element name="child" type="t:Child"/>'
                    '</xs:sequence></xs:complexType>', typed);
                hash<auto> supplied();
                supplied.a = repeated ? (1, 2, 3) : 1;
                if (!repeated) {
                    supplied.b = 2;
                    supplied.c = 3;
                }
                supplied."^attributes^" = {"label": "provided"};
                supplied."^comment^" = "provided child";
                foreach int limit in (2, 4) {
                    SuppliedSampleHelper helper(ws, supplied, limit);
                    assertThrows("XSD-SAMPLE-ERROR", \helper.getMessage(), (ws.messages.Request,));
                }
                SuppliedSampleHelper helper(ws, supplied, 5);
                hash<auto> sample = helper.getMessage(ws.messages.Request);
                assertEq(supplied, typed ? sample.child : sample.value.child);
                assertEq(sample, helper.getMessage(ws.messages.Request));
                if (!typed) {
                    XsdXmlValue xml = helper.getXmlMessage(ws.messages.Request).body;
                    XmlReader reader = xml.getReader();
                    int count = 0;
                    while (reader.read()) {
                        count += int(reader.nodeType() == XML_NODE_TYPE_ELEMENT);
                    }
                    assertEq(5, count);
                }
            }
        }
    }

    private fragmentBudgets() {
        WebService ws = service("t:Record", '<xs:complexType name="Record"><xs:sequence>'
            '<xs:element name="child" type="xs:anyType"/></xs:sequence></xs:complexType>');
        XsdComplexType type = ws.findType(make_qname(Uri, "Record"));
        SampleFragmentProbe probe(ws.nsc);
        type.elementmap.child.type = probe;
        foreach bool siblings in (False, True) {
            probe.siblings = siblings;
            foreach int limit in (2, 4) {
                WSMessageHelper helper(ws, {"max_elements": limit});
                assertThrows("XSD-SAMPLE-ERROR", \helper.getMessage(), (ws.messages.Request,));
            }
            WSMessageHelper helper(ws, {"max_elements": 5});
            assertEq({"value": {"child": "abc"}}, helper.getMessage(ws.messages.Request));
            hash<auto> wire = type.serializeValue(ws.nsc.copy(), {"child": "abc"}, True);
            XmlReader reader(make_xml({"value": wire}));
            int count = 0;
            while (reader.read()) {
                count += int(reader.nodeType() == XML_NODE_TYPE_ELEMENT);
            }
            assertEq(5, count);
        }
        # Each fragment is a standalone element. Several sibling fragments use
        # separate ^xml^ keys, as required by the native XML writer.
        probe.invalid = True;
        WSMessageHelper helper(ws, {"max_elements": 5});
        assertThrows("PARSE-XML-EXCEPTION", \helper.getMessage(), (ws.messages.Request,));
        assertThrows("PARSE-XML-EXCEPTION", \make_xml(),
            ({"value": type.serializeValue(ws.nsc.copy(), {"child": "abc"}, True)},));
        probe.invalid = False;
        assertEq({"value": {"child": "abc"}}, helper.getMessage(ws.messages.Request));
    }

    private validValues() {
        WebService ws = service("t:TextEntity");
        XsdElement element = ws.getElement(Uri, "value");
        foreach hash<auto> opts in ({}, {"comments": True}, {"choices": True}) {
            WSMessageHelper helper(ws, opts);
            hash<auto> sample = helper.getMessage(element, opts.comments ? "catalog reference" : NOTHING);
            assertEq("abc", sample.value.typeCode() == NT_HASH ? sample.value."^value^" : sample.value);
            element.serializeValue(ws.nsc.copy(), sample.value, True, "value", "example");
        }
        WSMessageHelper detached(ws);
        assertThrows("MESSAGE-ERROR", \detached.getMessage(), ("unknown message",));
        ws.idocmap.Invoice = element;
        *hash<ExceptionInfo> failure;
        try {
            detached.getMessage("unknown message");
        } catch (hash<ExceptionInfo> ex) {
            failure = ex;
        }
        assertTrue(index(failure.desc, "unknown message") >= 0);
        assertTrue(index(failure.desc, "Invoice") >= 0);
        remove ws;
        assertEq("abc", detached.getMessage(element).value);
        WebService entity = service("xs:ENTITY");
        WSMessageHelper description(entity, {"choices": True});
        assertEq("abc", description.getMessage(entity.messages.Request).value);
        assertThrows("SOAP-SERIALIZATION-ERROR", \entity.getElement(Uri, "value").serializeValue(),
            (entity.nsc, "abc", True, "value", "example"));
    }

    private occurrences() {
        WebService ws = service("t:Record", '<xs:complexType name="Record"><xs:sequence>
            <xs:element name="item" type="xs:int" minOccurs="2" maxOccurs="3"/>
            </xs:sequence></xs:complexType>');
        WSMessageHelper limited(ws, {"max_items": 1});
        assertThrows("XSD-SAMPLE-ERROR", \limited.getMessage(), (ws.messages.Request,));
        foreach int count in (2, 3) {
            hash<auto> sample = new WSMessageHelper(ws, {"max_items": count}).getMessage(ws.messages.Request);
            assertEq(count, sample.value.item.size());
            assertEq(123, sample.value.item[0]);
        }
    }

    private qnames() {
        WebService original = service("t:Category", '<xs:simpleType name="Category"><xs:restriction base="xs:QName">'
            '<xs:enumeration xmlns:p="urn:catalog" value="p:Invoice"/></xs:restriction></xs:simpleType>');
        foreach WebService ws in (original, Serializable::deserialize(original.serialize())) {
            hash<auto> before = ws.nsc.getOutputNamespaceHash(NOTHING);
            WSMessageHelper helper(ws);
            XsdQNameValue value = helper.getMessage(ws.messages.Request).value;
            assertEq("urn:catalog", value.getNamespaceUri());
            assertEq("Invoice", value.getLocalName());
            assertTrue(value === ws.messages.Request.getDataProviderType().acceptsValue({"body": value}).body);
            assertEq(before, ws.nsc.getOutputNamespaceHash(NOTHING));
        }
    }

    private concurrency() {
        WebService ws = service("t:Record", '<xs:complexType name="Record"><xs:sequence>'
            '<xs:element name="item" type="xs:string"/></xs:sequence></xs:complexType>');
        XsdComplexType record = ws.findType(make_qname(Uri, "Record"));
        ConcurrentSampleProbe probe(ws.nsc);
        record.elementmap.item.type = probe;
        BarrierSampleHelper helper(ws);
        Qore::Thread::Queue results();
        Qore::Thread::Counter running();
        on_exit {
            for (int index = 0; index < 4; ++index) {
                helper.proceed.push(True);
            }
            assertEq(0, running.waitForZero(30s));
        }
        for (int index = 0; index < 4; ++index) {
            running.inc();
            background sub(int worker) {
                on_exit running.dec();
                try {
                    @assert(helper.getMessage(ws.messages.Request).value.item == "abc");
                    results.push(worker);
                } catch (hash<ExceptionInfo> ex) {
                    results.push(ex);
                }
            }(index);
        }
        for (int index = 0; index < 4; ++index) {
            helper.ready.get(30s);
        }
        for (int index = 0; index < 4; ++index) {
            helper.proceed.push(True);
        }
        hash<string, bool> seen();
        for (int index = 0; index < 4; ++index) {
            auto result = results.get(30s);
            assertEq(NT_INT, result.typeCode());
            assertFalse(exists seen{result});
            seen{result} = True;
        }
        assertEq(4, probe.calls.size());
        hash<string, bool> threads();
        for (int index = 0; index < 4; ++index) {
            int tid = probe.calls.get(30s);
            assertFalse(exists threads{tid});
            threads{tid} = True;
        }
    }

    private subclassHooks() {
        WebService ws = service("t:Record", '<xs:complexType name="Record"><xs:sequence>'
            '<xs:element name="item" type="xs:int"/></xs:sequence></xs:complexType>');
        CustomSampleHelper helper(ws);
        assertEq("42", helper.getMessage(ws.messages.Request).value.item);
        helper.invalid = True;
        assertThrows("XSD-SAMPLE-ERROR", \helper.getMessage(), (ws.messages.Request,));
        helper.invalid = False;
        assertEq("42", helper.getMessage(ws.messages.Request).value.item);
        assertEq(123, new WSMessageHelper(ws).getMessage(ws.messages.Request).value.item);
        WebService entity = service("t:Record", '<xs:complexType name="Record"><xs:sequence>'
            '<xs:element name="item" type="xs:ENTITY"/></xs:sequence></xs:complexType>');
        CustomSampleHelper interrupted(entity);
        XsdComplexType record = entity.findType(make_qname(Uri, "Record"));
        foreach string error in ("CONTROLLED-ERROR", "THREAD-CANCELLED") {
            interrupted.error = error;
            assertThrows(error, \interrupted.getMessage(), (entity.messages.Request,));
            interrupted.error = NOTHING;
            interrupted.use_default = True;
            assertThrows("XSD-SAMPLE-ERROR", \interrupted.getMessage(), (record.elementmap.item,));
        }
    }

    private callbacks() {
        WebService ws = service("t:Record", '<xs:complexType name="Record"><xs:sequence>
            <xs:element name="item" type="xs:string" maxOccurs="3"/>
            </xs:sequence></xs:complexType>');
        XsdComplexType record = ws.findType(make_qname(Uri, "Record"));
        SampleInstanceProbe probe(ws.nsc);
        record.elementmap.item.type = probe;
        WebService inner = service("t:TextEntity");
        probe.nested = new WSMessageHelper(inner);
        probe.nested_element = inner.getElement(Uri, "value");
        WSMessageHelper helper(ws);
        assertEq(("abc", "abc", "abc"), helper.getMessage(ws.messages.Request).value.item);
        assertEq(3, probe.calls);
        foreach string error in ("CONTROLLED-ERROR", "THREAD-CANCELLED", "SOAP-SERIALIZATION-ERROR") {
            probe.error = error;
            assertThrows(error == "SOAP-SERIALIZATION-ERROR" ? "XSD-SAMPLE-ERROR" : error,
                \helper.getMessage(), (ws.messages.Request,));
            probe.error = NOTHING;
            assertEq(("abc", "abc", "abc"), helper.getMessage(ws.messages.Request).value.item);
        }
        Program program(PO_MODERN);
        SandboxManager manager();
        on_exit manager.clearInterrupt();
        program.setSandboxManager(manager);
        program.parse("%modern\nsub execute(code<nothing()> work) { work(); }\n",
            get_script_dir() + "/sample-instance-interrupt.qr");
        probe.manager = manager;
        code<nothing()> work = sub() { helper.getMessage(ws.messages.Request); };
        *hash<ExceptionInfo> failure;
        try {
            program.callFunction("execute", work);
        } catch (hash<ExceptionInfo> ex) {
            failure = ex;
        }
        manager.clearInterrupt();
        probe.manager = NOTHING;
        assertEq("PROGRAM-INTERRUPTED", failure.err);
        assertEq(("abc", "abc", "abc"), helper.getMessage(ws.messages.Request).value.item);
    }
}

class SampleInstanceProbe inherits XsdBaseType {
    public {
        int calls = 0;
        *string error;
        *WSMessageHelper nested;
        *XsdElement nested_element;
        *SandboxManager manager;
    }
    constructor(Namespaces namespaces) : XsdBaseType("string", namespaces) {
    }
    auto serializeValue(Namespaces namespaces, auto value, *softbool omitType) {
        ++calls;
        if (nested) {
            @assert(nested.getMessage(nested_element).value == "abc");
        }
        if (manager) {
            manager.requestInterrupt();
        }
        if (error) {
            throw error, "controlled sample validation failure";
        }
        return XsdBaseType::serializeValue(namespaces, value, omitType);
    }
}

class CustomSampleHelper inherits WSMessageHelper {
    public {
        bool invalid = False;
        bool use_default = False;
        *string error;
    }
    constructor(WebService ws) : WSMessageHelper(ws) {
    }
    hash<auto> getMessage(XsdElement element, *softlist<auto> comments) {
        if (element.name == "item") {
            if (error) {
                throw error, "controlled nested generation failure";
            }
            if (!use_default) {
                return {"item": invalid ? "!" : "42"};
            }
        }
        return WSMessageHelper::getMessage(element, comments);
    }
}

class BarrierSampleHelper inherits WSMessageHelper {
    public {
        Qore::Thread::Queue ready();
        Qore::Thread::Queue proceed();
    }
    constructor(WebService ws) : WSMessageHelper(ws) {
    }
    hash<auto> getMessage(XsdElement element, *softlist<auto> comments) {
        if (element.name == "item") {
            ready.push(gettid());
            proceed.get(30s);
        }
        return WSMessageHelper::getMessage(element, comments);
    }
}

class ConcurrentSampleProbe inherits XsdBaseType {
    public { Qore::Thread::Queue calls(); }
    constructor(Namespaces namespaces) : XsdBaseType("string", namespaces) {
    }
    auto serializeValue(Namespaces namespaces, auto value, *softbool omitType) {
        calls.push(gettid());
        return XsdBaseType::serializeValue(namespaces, value, omitType);
    }
}

class ReentrantSampleHelper inherits WSMessageHelper {
    public { int calls = 0; }
    private { XsdElement probe; }
    constructor(WebService ws, XsdElement probe) : WSMessageHelper(ws, {"max_elements": 4}) {
        self.probe = probe;
    }
    hash<auto> getMessage(XsdElement element, *softlist<auto> comments) {
        if (element.name == "item") {
            @assert(WSMessageHelper::getMessage(probe).probe == "abc");
            return {"item": ++calls};
        }
        return WSMessageHelper::getMessage(element, comments);
    }
}

class SuppliedSampleHelper inherits WSMessageHelper {
    private { hash<auto> supplied; }
    constructor(WebService ws, hash<auto> supplied, int maximum) : WSMessageHelper(ws, {"max_elements": maximum}) {
        self.supplied = supplied;
    }
    hash<auto> getMessage(XsdElement element, *softlist<auto> comments) {
        return element.name == "child" ? {"child": supplied} : WSMessageHelper::getMessage(element, comments);
    }
}

class SampleFragmentProbe inherits XsdBaseType {
    public { bool siblings = False; bool invalid = False; }
    constructor(Namespaces namespaces) : XsdBaseType("anyType", namespaces) { }
    auto serializeValue(Namespaces namespaces, auto value, *softbool omitType) {
        @assert(value == "abc");
        if (invalid) {
            return {"^xml^": "<inside/><sibling/>"};
        }
        return siblings ? {"^xml^1": "<inside><leaf/></inside>", "^xml^2": "<sibling/>"}
            : {"^xml^": "<inside><leaf/><leaf/></inside>"};
    }
}
