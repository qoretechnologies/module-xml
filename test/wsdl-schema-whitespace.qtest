#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class SchemaWhitespaceTest

class SchemaWhitespaceTest inherits QUnit::Test {
    private {
        const Uri = "urn:qore:schema-whitespace";
    }
    constructor() : Test("Schema declaration character content", "1.0") {
        addTestCase("Whitespace-only declarations preserve empty and constrained types", \declarations());
        addTestCase("Non-XML whitespace and significant declaration text are rejected", \invalid());
        addTestCase("Annotation and documentation content is not declaration text", \annotations());
        addTestCase("Imported and WSDL schemas apply the same character rules", \imports());
        addTestCase("Full enterprise and partner descriptions parse with their original bytes", \descriptions());
        set_return_value(main());
    }
    private string schema(string body) {
        return '<xs:schema xmlns:xs="' + XSD_NS + '" xmlns:t="' + Uri + '" targetNamespace="' + Uri + '">'
            + body + '</xs:schema>';
    }
    private XsdSchema parse(string source) {
        return new XsdSchema(source, {"async_only": True});
    }
    declarations() {
        foreach string whitespace in (" \n\t\r ", "<![CDATA[ \t\n]]>", "&#32;&#9;&#13;&#10;", " <!-- comment --> ") {
            string source = schema('<xs:simpleType name="Text"><xs:restriction base="xs:string">'
                + whitespace + '</xs:restriction></xs:simpleType><xs:complexType name="Empty">'
                + whitespace + '</xs:complexType><xs:complexType name="Sequence"><xs:sequence>'
                + whitespace + '</xs:sequence></xs:complexType><xs:simpleType name="Sized"><xs:restriction base="xs:string">'
                + whitespace + '<xs:length value="3">' + whitespace + '</xs:length>' + whitespace
                + '</xs:restriction></xs:simpleType><xs:complexType name="Extended"><xs:complexContent>'
                + whitespace + '<xs:extension base="t:Empty">' + whitespace + '</xs:extension>' + whitespace
                + '</xs:complexContent></xs:complexType><xs:element name="value" type="t:Sized"/>'
                '<xs:element name="empty" type="t:Empty"/>');
            XmlDoc document('<t:value xmlns:t="' + Uri + '">abc</t:value>');
            document.validateSchema(source);
            XsdSchema original = parse(source);
            foreach XsdSchema s in (original, Serializable::deserialize(original.serialize())) {
                AbstractDataProviderType provider = s.findType("Sized").getDataProviderType();
                assertEq("abc", provider.acceptsValue("abc"));
                assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), ("ab",));
                assertTrue(cast<XsdComplexType>(s.findType("Empty")).isEmpty());
                assertTrue(cast<XsdComplexType>(s.findType("Sequence")).getParticle().matchesElementNames(()));
                assertTrue(cast<XsdComplexType>(s.findType("Extended")).isEmpty());
                XsdXmlValue empty = s.serializeXmlValue(Uri, "empty", {});
                assertEq("{" + Uri + "}empty", empty.getExpandedName());
                new XmlDoc(empty.getXml()).validateSchema(source);
            }
        }
    }
    invalid() {
        foreach string text in ("unexpected", "&#160;", "<![CDATA[unexpected]]>", " \n x \t ") {
            foreach string declaration in (
                '<xs:complexType name="Value">' + text + '</xs:complexType>',
                '<xs:complexType name="Value"><xs:sequence>' + text + '</xs:sequence></xs:complexType>',
                '<xs:element name="value" type="xs:string">' + text + '</xs:element>',
                text) {
                assertThrows("WSDL-ERROR", \parse(), (schema(declaration),));
            }
            assertThrows("XSD-SIMPLETYPE-ERROR", \parse(),
                (schema('<xs:simpleType name="Value"><xs:restriction base="xs:string">' + text
                    + '</xs:restriction></xs:simpleType>'),));
        }
        XsdSchema source = parse(schema('<xs:complexType name="Existing"/>'));
        XsdAbstractType existing = source.findType("Existing");
        assertThrows("WSDL-ERROR", \source.addSchemaString(),
            (schema('<xs:complexType name="Broken">invalid</xs:complexType>'),));
        assertTrue(existing === source.findType("Existing"));
        source.addSchemaString(schema('<xs:complexType name="Valid">' + " \n " + '</xs:complexType>'));
        assertTrue(cast<XsdComplexType>(source.findType("Valid")).isEmpty());
    }
    annotations() {
        string description = "Preserve  inner spacing\nand line breaks.";
        string source = schema('<xs:complexType name="Record"><xs:annotation><xs:documentation>'
            + description + '</xs:documentation></xs:annotation>' + " \n " + '</xs:complexType>'
            '<xs:complexType name="Example"><xs:annotation><xs:appinfo><example xmlns="urn:example">'
            '<xs:complexType>illustrative text</xs:complexType></example></xs:appinfo>'
            '<xs:documentation><xs:element>example text</xs:element></xs:documentation></xs:annotation>'
            '<xs:sequence>' + " \n " + '</xs:sequence></xs:complexType>');
        XsdSchema original = parse(source);
        foreach XsdSchema s in (original, Serializable::deserialize(original.serialize())) {
            assertEq(description, cast<XsdComplexType>(s.findType("Record")).documentation);
            assertTrue(cast<XsdComplexType>(s.findType("Example")).getParticle().matchesElementNames(()));
        }
    }
    imports() {
        string source = schema('<xs:complexType name="Empty">' + " \n " + '</xs:complexType>'
            '<xs:element name="value" type="t:Empty"/>');
        string included = schema('<xs:include schemaLocation="http://example.invalid/empty.xsd"/>');
        foreach XsdSchema s in (new XsdSchema(included, {"async_only": True,
                "xsd_cache": {"http://example.invalid/empty.xsd": source}})) {
            assertTrue(cast<XsdComplexType>(s.findType("Empty")).isEmpty());
            assertTrue(cast<XsdComplexType>(Serializable::deserialize(s.serialize()).findType("Empty")).isEmpty());
        }
        string wsdl = '<w:definitions xmlns:w="http://schemas.xmlsoap.org/wsdl/" xmlns:t="' + Uri
            + '" targetNamespace="' + Uri + '"><w:documentation><xs:element xmlns:xs="' + XSD_NS
            + '">illustrative text</xs:element></w:documentation><w:types>' + included + '</w:types>'
            '<w:message name="Message"><w:part name="body" element="t:value"/></w:message>'
            '</w:definitions>';
        WebService original(wsdl, {"async_only": True, "xsd_cache": {"http://example.invalid/empty.xsd": source}});
        foreach WebService ws in (original, Serializable::deserialize(original.serialize())) {
            assertTrue(cast<XsdComplexType>(ws.findType("Empty")).isEmpty());
            assertEq("value", ws.messages.Message.args.firstValue().element.name);
        }
    }
    descriptions() {
        foreach string name in ("enterprise", "partner") {
            WebService ws = WSDLLib::getWebServiceFromUrl(get_script_dir() + "/" + name + ".wsdl");
            assertTrue(ws.getOperationNames().size() > 20);
            assertTrue(ws.getReport().find("login") >= 0);
        }
    }
}
