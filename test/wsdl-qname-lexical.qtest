#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class QNameLexicalTest

class InterruptQNameProvider inherits XsdQNameDataType {
    public {
        bool interrupt = True;
    }

    auto acceptsValue(auto value) {
        if (interrupt) {
            throw "PROGRAM-INTERRUPTED", "QName conversion interrupted";
        }
        return XsdQNameDataType::acceptsValue(value);
    }
}

class QNameLexicalTest inherits QUnit::Test {
    constructor() : Test("XSD QName lexical grammar", "1.0") {
        addTestCase("Both QName components use XML 1.0 Second Edition NCNames", \grammar());
        addTestCase("Empty and malformed lexical values reject in both directions", \invalid());
        addTestCase("Optional and reconstructed providers retain QName validation", \providers());
        addTestCase("Inherited patterns and deprecated lengths retain lexical semantics", \restrictions());
        addTestCase("Schema facets reject malformed QName enumerations", \declarations());
        addTestCase("Lists and union fallback enforce item grammar", \collections());
        addTestCase("Cancellation propagates and conversion recovers", \cancellation());
        addTestCase("Invalid namespace declarations retain the conversion error category", \namespaceErrors());
        set_return_value(main());
    }

    private static XsdSchema schema(string definitions) {
        return new XsdSchema('<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
            xmlns:t="urn:qname-lexical" targetNamespace="urn:qname-lexical">' + definitions + '</xs:schema>',
            {"async_only": True});
    }

    private static XsdSimpleType type(XsdSchema schema, string name) {
        return cast<XsdSimpleType>(schema.findType(make_qname("urn:qname-lexical", name)));
    }

    private grammar() {
        Namespaces namespaces({});
        XsdBaseType base = namespaces.getBaseType("QName");
        foreach string local in ("Name", "_", "_0", "é", "Αλφα", "中文", "a\u0301", "a-b.c", "a\u00b7b") {
            foreach string text in (local, "xml:" + local) {
                foreach string lexical in (text, " \t" + text + "\r\n") {
                    assertEq(text, base.deserializeValue("value", {}, NOTHING, lexical));
                    assertEq(text, base.serializeValue(namespaces, lexical, True));
                    assertEq(text, base.getDataProviderType().acceptsValue(lexical));
                }
            }
        }
        XsdQNameValue expected("urn:unicode", "é:中文");
        auto input = {"^value^": "é:中文", "^attributes^": {"xmlns:é": "urn:unicode"}};
        assertTrue(base.deserializeValue("value", {}, NOTHING, input).equals(expected));
        assertThrows("SOAP-DESERIALIZATION-ERROR", \base.deserializeValue(), ("value", {}, NOTHING, "é:中文"));
        auto output = base.serializeValue(namespaces, expected, True);
        assertEq("é:中文", output."^value^");
        assertEq("urn:unicode", output."^attributes^"."xmlns:é");
        XsdQNameDataType provider({"é": "urn:unicode"});
        assertTrue(provider.acceptsValue("é:中文").equals(expected));
    }

    private invalid() {
        Namespaces namespaces({});
        XsdBaseType base = namespaces.getBaseType("QName");
        AbstractDataProviderType provider = base.getDataProviderType();
        foreach auto value in ("", " \t\r\n", ":", ":Name", "xml:", "a:b:c", "0name", "0prefix:Name",
                "xml:0name", "a b", "xml :Name", "xml: Name", "a\u00a0b", "\u0301a", "xml:\u0301a",
                "\u0370", "xml:\u0370", "\U00010000", "xml:\U00010000", "a/b", "a\v", "a\u0000", 0,
                (), new Namespaces({})) {
            assertThrows("SOAP-DESERIALIZATION-ERROR", \base.deserializeValue(), ("value", {}, NOTHING, value));
            assertThrows("SOAP-SERIALIZATION-ERROR", \base.serializeValue(), (namespaces, value, True));
            assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (value,));
            assertEq("xml:Name", provider.acceptsValue(" xml:Name "));
        }
        foreach auto value in (NOTHING, {}, {"^value^": ""}) {
            assertThrows("SOAP-DESERIALIZATION-ERROR", \base.deserializeValue(), ("value", {}, NOTHING, value));
            assertThrows("SOAP-SERIALIZATION-ERROR", \base.serializeValue(), (namespaces, value, True));
        }
    }

    private namespaceErrors() {
        Namespaces namespaces({});
        XsdSchema restriction = schema('<xs:simpleType name="Name"><xs:restriction base="xs:QName"/></xs:simpleType>');
        foreach XsdAbstractType candidate in (namespaces.getBaseType("QName"), type(restriction, "Name")) {
            foreach hash<auto> bindings in ({"xmlns:p": ""}, {"xmlns:xml": "urn:wrong"},
                    {"xmlns:xmlns": "urn:wrong"}, {"xmlns": "http://www.w3.org/XML/1998/namespace"},
                    {"xmlns:p": 42}, {"xmlns": 42}) {
                auto value = {"^attributes^": bindings, "^value^": "Local"};
                assertThrows("SOAP-SERIALIZATION-ERROR", \candidate.serializeValue(), (namespaces, value, True));
                assertThrows("SOAP-DESERIALIZATION-ERROR", \candidate.deserializeValue(),
                    ("Name", {}, NOTHING, value));
                assertEq("Local", candidate.deserializeValue("Name", {}, NOTHING, "Local"));
            }
            foreach auto attributes in ("invalid", 42, ("p",)) {
                assertThrows("SOAP-SERIALIZATION-ERROR", \candidate.serializeValue(),
                    (namespaces, {"^attributes^": attributes, "^value^": "Local"}, True));
            }
            auto output = candidate.serializeValue(namespaces, new XsdQNameValue("urn:catalog", "p:Name"), True);
            assertEq("urn:catalog", output."^attributes^"."xmlns:p");
        }
    }

    private providers() {
        AbstractDataProviderType original = new Namespaces({}).getBaseType("QName").getDataProviderType();
        foreach AbstractDataProviderType provider in (original, Serializable::deserialize(original.serialize()),
                original.getOrNothingType().getMandatoryType()) {
            assertEq("xsd:QName", provider.getName());
            assertEq(NT_STRING, provider.getBaseTypeCode());
            assertEq({}, provider.getDirectTypeHash());
            assertEq(NOTHING, provider.getValueType());
            assertThrows("MISSING-VALUE-ERROR", \provider.acceptsValue(), (NOTHING,));
            AbstractDataProviderType optional = Serializable::deserialize(provider.getOrNothingType().serialize());
            assertEq(NOTHING, optional.acceptsValue(NOTHING));
            assertThrows("RUNTIME-TYPE-ERROR", \optional.acceptsValue(), ("",));
            assertEq("Name", optional.acceptsValue(" Name "));
            assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), ({},));
            assertEq(("Name", "xml:lang"), new ListDataType(provider).acceptsValue((" Name ", "xml:lang")));
        }
        hash<SerializationInfo> state = original.serializeToData();
        string index = state._index."0"._class_data."WSDL::XsdQNameDataType".namespaces._index;
        state._index{index}._members.xml = "urn:wrong";
        assertThrows("DESERIALIZATION-ERROR", \Serializable::deserialize(), (state,));
        assertEq("Name", Serializable::deserialize(original.serialize()).acceptsValue("Name"));
    }

    private restrictions() {
        XsdSchema original = schema('<xs:simpleType name="Base"><xs:restriction base="xs:QName">
            <xs:pattern value="[A-Z][a-z]+"/></xs:restriction></xs:simpleType>
            <xs:simpleType name="Value"><xs:restriction base="t:Base"><xs:pattern value="Name"/>
            <xs:length value="0"/></xs:restriction></xs:simpleType>
            <xs:simpleType name="Empty"><xs:restriction base="xs:QName"><xs:pattern value="[0-9]+"/>
            </xs:restriction></xs:simpleType>
            <xs:simpleType name="Long"><xs:restriction base="xs:QName"><xs:minLength value="1000"/>
            </xs:restriction></xs:simpleType>');
        foreach XsdSchema schema in (original, Serializable::deserialize(original.serialize())) {
            XsdSimpleType value = type(schema, "Value");
            foreach AbstractDataProviderType provider in (value.getDataProviderType(),
                    Serializable::deserialize(value.getDataProviderType().serialize())) {
                assertEq("Name", provider.acceptsValue(" \tName\r\n"));
                foreach string text in ("Other", "NAME", "name", "a:b:c") {
                    assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (text,));
                }
            }
            assertEq("Name", value.deserializeValue("value", {}, NOTHING, " Name "));
            assertEq("Name", value.serializeValue(new Namespaces({}), " Name ", True));
            assertEq("Name", value.getSampleValue("invalid:name:here"));
            XsdSimpleType empty = type(schema, "Empty");
            assertThrows("XSD-SAMPLE-ERROR", \empty.getSampleValue(), ("abc",));
            assertEq("abc", type(schema, "Long").getSampleValue("abc"));
        }
    }

    private declarations() {
        foreach string text in ("", ":Name", "a:b:c", "0name", "xml:") {
            assertThrows("XSD-SIMPLETYPE-ERROR", sub() {
                schema('<xs:simpleType name="Value"><xs:restriction base="xs:QName">
                    <xs:enumeration value="' + text + '"/></xs:restriction></xs:simpleType>');
            });
        }
        XsdSchema valid = schema('<xs:simpleType name="Value"><xs:restriction base="xs:QName">
            <xs:enumeration value="Name"/></xs:restriction></xs:simpleType>');
        assertEq("Name", type(valid, "Value").getSampleValue("abc"));
        # Lexical declaration checks must not compare namespace-equivalent aliases as strings.
        XsdSchema aliases = schema('<xs:simpleType name="Base"><xs:restriction base="xs:QName">
            <xs:enumeration xmlns:a="urn:alias" value="a:Name"/></xs:restriction></xs:simpleType>
            <xs:simpleType name="Value"><xs:restriction base="t:Base">
            <xs:enumeration xmlns:b="urn:alias" value="b:Name"/></xs:restriction></xs:simpleType>');
        assertEq("QName", type(aliases, "Base").type.name);
        assertEq("Base", type(aliases, "Value").type.name);
    }

    private collections() {
        XsdSchema original = schema('<xs:simpleType name="Items"><xs:list itemType="xs:QName"/></xs:simpleType>
            <xs:simpleType name="Either"><xs:union memberTypes="xs:QName xs:string"/></xs:simpleType>');
        foreach XsdSchema schema in (original, Serializable::deserialize(original.serialize())) {
            XsdSimpleType items = type(schema, "Items");
            assertEq(("Name", "xml:lang"), items.deserializeValue("value", {}, NOTHING, " Name\txml:lang "));
            assertEq("Name xml:lang", items.serializeValue(new Namespaces({}), ("Name", "xml:lang"), True));
            assertThrows("SOAP-DESERIALIZATION-ERROR", \items.deserializeValue(), ("value", {}, NOTHING, "Name a:b:c"));
            assertThrows("SOAP-SERIALIZATION-ERROR", \items.serializeValue(), (new Namespaces({}), ("Name", "0bad"), True));
            AbstractDataProviderType provider = Serializable::deserialize(items.getDataProviderType().serialize());
            assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (("Name", "0bad"),));
            assertEq(("Name",), provider.acceptsValue(("Name",)));
            XsdSimpleType either = type(schema, "Either");
            assertEq(" a:b:c ", either.deserializeValue("value", {}, NOTHING, " a:b:c "));
            assertEq(" a:b:c ", either.getDataProviderType().acceptsValue(" a:b:c "));
            assertEq("xml:lang", either.deserializeValue("value", {}, NOTHING, " xml:lang "));
        }
    }

    private cancellation() {
        InterruptQNameProvider item();
        ListDataType provider(item);
        assertThrows("PROGRAM-INTERRUPTED", \provider.acceptsValue(), (("Name",),));
        item.interrupt = False;
        assertEq(("Name",), provider.acceptsValue(("Name",)));
        assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (("a:b:c",),));
        assertEq(("xml:lang",), provider.acceptsValue(("xml:lang",)));
    }
}
