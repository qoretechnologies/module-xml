#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires ../qlib/WSDL.qm
%requires xml
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "Identity component fixtures require json";
%else
%exec-class IdentityComponentsTest

class IdentityComponentsTest inherits QUnit::Test {
    constructor() : Test("XSD identity component resolution", "1.0") {
        addTestCase("Compiled paths retain declaration namespaces and ordered fields in saved graphs", \paths());
        addTestCase("Forward keyrefs resolve schema-wide names and preserve references", \references());
        addTestCase("Invalid component relationships reject and additions roll back", \invalid());
        addTestCase("Unused and shared particles retain declarations exactly once", \particles());
        addTestCase("Imports and chameleon includes adopt component names without changing path names", \dependencies());
        addTestCase("Saved metadata rejects malformed components and registry relationships", \metadata());
        addTestCase("Pinned component fixtures agree with native schema compilation", \matrix());
        addTestCase("Interrupted registry publication preserves the previous complete map", \cancellation());
        set_return_value(main());
    }
    private matrix() {
        list<hash<auto>> rows = parse_json(ReadOnlyFile::readTextFile(get_script_dir()
            + "/wsdl-interop/fixtures/identity-components.json"));
        assertEq(30, rows.size());
        foreach hash<auto> row in (rows) {
            if (!row.schema_valid) {
                assertThrows("WSDL-ERROR", \construct(), (row.schema,));
                assertThrows("XSD-SYNTAX-ERROR", \parse_xml_with_schema(), (row.documents[0].xml, row.schema));
                continue;
            }
            XsdSchema original = construct(row.schema);
            foreach XsdSchema schema in (original, Serializable::deserialize(original.serialize())) {
                assertEq(2, schema.nsc.getIdentityConstraintRegistry().getDefinitions().size(), row.name);
            }
            assertEq(parse_xml(row.documents[0].xml), parse_xml_with_schema(row.documents[0].xml, row.schema), row.name);
        }
    }
    private static XsdSchema construct(string source) {
        return new XsdSchema(source, {"async_only": True});
    }
    private static string document(string body, string uri = "") {
        return '<xs:schema xmlns:xs="' + XSD_NS + '" xmlns:t="urn:identity"'
            + (uri ? ' targetNamespace="' + uri + '"' : "") + '>' + body + '</xs:schema>';
    }
    private static string definition(string name = "K", string category = "key", string extra = "",
            string fields = '<xs:field xpath="@id"/>') {
        return '<xs:' + category + ' name="' + name + '" ' + extra + '><xs:selector xpath="row"/>'
            + fields + '</xs:' + category + '>';
    }
    private static string owner(string name, string constraints) {
        return '<xs:element name="' + name + '"><xs:complexType/>' + constraints + '</xs:element>';
    }
    private static XsdSchema parse(string body, string uri = "") {
        return new XsdSchema(document(body, uri), {"async_only": True});
    }
    private paths() {
        string source = document(owner("value", '<xs:unique name=" U " xmlns:p="urn:constraint">'
            '<xs:selector xmlns:p="urn:selector" xmlns="urn:ignored" xpath=" . // child::p:row / . | plain | p:* | * "/>'
            '<xs:field xmlns:p="urn:first" xpath="p:child/@p:id | @xml:lang"/>'
            '<xs:field xmlns:p="urn:second" xpath="child::p:child/attribute::*"/>'
            '<xs:field xpath="."/></xs:unique>'), "urn:identity");
        XsdSchema original(source);
        foreach XsdSchema schema in (original, Serializable::deserialize(original.serialize())) {
            XsdElement element = schema.getElement("urn:identity", "value");
            foreach XsdElement current in (element, Serializable::deserialize(element.serialize())) {
                assertEq(1, current.getIdentityConstraints().size());
                XsdIdentityConstraint definition = current.getIdentityConstraints()[0];
                foreach XsdIdentityConstraint item in (definition, Serializable::deserialize(definition.serialize())) {
                    assertEq("{urn:identity}U", item.getExpandedName());
                    assertEq(XsdIdentityCategory::Unique, item.getCategory());
                    assertNothing(item.getReferencedName());
                    assertEq({"p": "urn:selector"}, item.getInfo().selector.namespaces);
                    list<hash<XsdIdentityPathInfo>> paths = item.getSelectorPaths();
                    assertEq(4, paths.size());
                    assertTrue(paths[0].descendants);
                    assertEq(XsdIdentityAxis::Child, paths[0].steps[0].axis);
                    assertEq("urn:selector", paths[0].steps[0].namespace_uri);
                    assertEq("row", paths[0].steps[0].local_name);
                    assertEq(XsdIdentityAxis::Self, paths[0].steps[1].axis);
                    assertFalse(paths[1].descendants);
                    assertEq("", paths[1].steps[0].namespace_uri);
                    assertEq("plain", paths[1].steps[0].local_name);
                    assertEq("urn:selector", paths[2].steps[0].namespace_uri);
                    assertNothing(paths[2].steps[0].local_name);
                    assertNothing(paths[3].steps[0].namespace_uri);
                    assertNothing(paths[3].steps[0].local_name);
                    list<list<hash<XsdIdentityPathInfo>>> fields = item.getFieldPaths();
                    assertEq(3, fields.size());
                    assertEq(2, fields[0].size());
                    assertEq("urn:first", fields[0][0].steps[0].namespace_uri);
                    assertEq("urn:first", fields[0][0].steps[1].namespace_uri);
                    assertEq(XsdIdentityAxis::Attribute, fields[0][0].steps[1].axis);
                    assertEq("http://www.w3.org/XML/1998/namespace", fields[0][1].steps[0].namespace_uri);
                    assertEq("urn:second", fields[1][0].steps[0].namespace_uri);
                    assertNothing(fields[1][0].steps[1].namespace_uri);
                    assertEq(XsdIdentityAxis::Self, fields[2][0].steps[0].axis);
                    paths[0].steps[0].local_name = "changed";
                    assertEq("row", item.getSelectorPaths()[0].steps[0].local_name);
                }
            }
            Namespaces scope({}, schema.nsc);
            foreach Namespaces current in (scope, Serializable::deserialize(scope.serialize())) {
                assertEq("urn:first", current.getIdentityConstraintRegistry().get("{urn:identity}U")
                    .getFieldPaths()[0][0].steps[0].namespace_uri);
            }
        }
    }
    private references() {
        foreach string uri in ("", "urn:identity") {
            string ref = uri ? "t:K" : "K";
            string body = owner("first", definition("R", "keyref", 'refer=" ' + ref + ' "'))
                + owner("second", definition()) + '<xs:complexType name="Use"><xs:sequence>'
                + '<xs:element ref="' + (uri ? "t:" : "") + 'second"/></xs:sequence></xs:complexType>';
            XsdSchema original = parse(body, uri);
            foreach XsdSchema schema in (original, Serializable::deserialize(original.serialize())) {
                XsdIdentityConstraintRegistry registry = schema.nsc.getIdentityConstraintRegistry();
                foreach XsdIdentityConstraintRegistry current in (registry, Serializable::deserialize(registry.serialize())) {
                    assertEq(2, current.getDefinitions().size());
                    assertEq(sprintf("{%s}K", uri), current.get(sprintf("{%s}R", uri)).getReferencedName());
                    assertEq(XsdIdentityCategory::Key, current.get(sprintf("{%s}K", uri)).getCategory());
                    assertNothing(current.get("{}missing"));
                }
                assertEq(sprintf("{%s}R", uri), schema.getElement(uri, "first").getIdentityConstraints()[0].getExpandedName());
            }
            string instance = uri ? '<first xmlns="' + uri + '"/>' : '<first/>';
            assertEq(parse_xml(instance), parse_xml_with_schema(instance, document(body, uri)),
                "native accepts forward component references");
        }
    }
    private invalid() {
        list<string> invalid = (
            owner("first", definition("R", "keyref", 'refer="missing"')),
            owner("first", definition("R", "keyref", 'refer="R"')),
            owner("first", definition("R", "keyref", 'refer="S"') + definition("S", "keyref", 'refer="R"')),
            owner("first", definition("R", "keyref", 'refer="K"'))
                + owner("second", definition("K", "key", "", '<xs:field xpath="@a"/><xs:field xpath="@b"/>')),
            owner("first", definition()) + owner("second", definition()),
            owner("first", definition() + definition("K", "unique")),
            owner("first", definition() + definition("K", "keyref", 'refer="K"')),
            owner("first", definition("R", "keyref", 'xmlns:p="urn:missing" refer="p:K"'))
        );
        foreach string body in (invalid) {
            assertThrows("WSDL-ERROR", \parse(), (body,));
            assertThrows("XSD-SYNTAX-ERROR", \parse_xml_with_schema(), ("<first/>", document(body)));
        }
        foreach XsdSchema schema in (parse(owner("base", definition())),
                Serializable::deserialize(parse(owner("base", definition())).serialize())) {
            Namespaces retained({}, schema.nsc);
            foreach string body in (invalid) {
                assertThrows("WSDL-ERROR", \schema.addSchemaString(), (document(body),));
                assertEq(1, retained.getIdentityConstraintRegistry().getDefinitions().size());
                assertEq("{}K", retained.getIdentityConstraintRegistry().get("{}K").getExpandedName());
                assertEq("base", schema.getElement("", "base").name);
            }
            schema.addSchemaString(document(owner("new", definition("R", "keyref", 'refer="K"'))));
            assertEq(2, retained.getIdentityConstraintRegistry().getDefinitions().size());
            assertEq("{}K", retained.getIdentityConstraintRegistry().get("{}R").getReferencedName());
        }
    }
    private particles() {
        string body = '<xs:group name="G"><xs:sequence>' + owner("local", definition("Local"))
            + '</xs:sequence></xs:group><xs:complexType name="Unused"><xs:sequence>'
            + '<xs:element name="absent" minOccurs="0" maxOccurs="0"><xs:complexType/>'
            + definition("Absent") + '</xs:element></xs:sequence></xs:complexType>'
            + '<xs:complexType name="Twice"><xs:sequence><xs:group ref="G"/><xs:group ref="G"/>'
            + '</xs:sequence></xs:complexType>' + owner("root", "");
        XsdSchema original = parse(body);
        foreach XsdSchema schema in (original, Serializable::deserialize(original.serialize())) {
            assertEq(2, schema.nsc.getIdentityConstraintRegistry().getDefinitions().size());
            assertEq("{}Local", schema.nsc.getIdentityConstraintRegistry().get("{}Local").getExpandedName());
            assertEq("{}Absent", schema.nsc.getIdentityConstraintRegistry().get("{}Absent").getExpandedName());
        }
        assertEq(parse_xml("<root/>"), parse_xml_with_schema("<root/>", document(body)));
    }
    private dependencies() {
        string common = document(owner("common", definition("R", "keyref", 'refer="K"') + definition()));
        string imported = document(owner("imported", definition()), "urn:imported");
        string parent = document('<xs:import namespace="urn:imported" schemaLocation="imported.xsd"/>'
            '<xs:include schemaLocation="common.xsd"/><xs:include schemaLocation="common.xsd"/>'
            + owner("root", definition("External", "keyref", 'xmlns:p="urn:imported" refer="p:K"')), "urn:identity");
        XsdSchema original(parent, {"async_only": True, "def_path": "https://example.invalid/identity/",
            "xsd_cache": {"https://example.invalid/identity/common.xsd": common,
                "https://example.invalid/identity/imported.xsd": imported}});
        original.addSchemaString(document('<xs:include schemaLocation="common.xsd"/>', "urn:second"));
        foreach XsdSchema schema in (original, Serializable::deserialize(original.serialize())) {
            XsdIdentityConstraintRegistry registry = schema.nsc.getIdentityConstraintRegistry();
            assertEq(6, registry.getDefinitions().size());
            foreach string uri in ("urn:identity", "urn:second") {
                XsdIdentityConstraint item = registry.get(sprintf("{%s}R", uri));
                assertEq(sprintf("{%s}K", uri), item.getReferencedName());
                assertEq("", item.getSelectorPaths()[0].steps[0].namespace_uri);
            }
            assertEq("{urn:imported}K", registry.get("{urn:identity}External").getReferencedName());
        }
    }
    private cancellation() {
        XsdIdentityConstraintRegistry registry = parse(owner("root", definition())).nsc.getIdentityConstraintRegistry();
        hash<string, XsdIdentityConstraint> complete = registry.getDefinitions();
        hash<XsdIdentityConstraintInfo> info = registry.get("{}K").getInfo();
        for (int i = 0; i < 500; ++i) {
            info.local_name = "K" + i;
            complete{"{}" + info.local_name} = new XsdIdentityConstraint(info);
        }
        SandboxManager manager();
        on_exit manager.clearInterrupt();
        Program program(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
        program.setSandboxManager(manager);
        program.parse("%modern\n%requires ../qlib/WSDL.qm\n"
            "sub publish(XsdIdentityConstraintRegistry registry, hash<string, XsdIdentityConstraint> definitions, "
            "SandboxManager manager, bool cancel) {\n"
            "    if (cancel) { manager.requestInterrupt(); }\n"
            "    registry.replace(definitions);\n}\n", get_script_dir() + "/identity-components-interrupt.qr");
        *hash<ExceptionInfo> error;
        try {
            program.callFunction("publish", registry, complete, manager, True);
        } catch (hash<ExceptionInfo> ex) {
            error = ex;
        }
        manager.clearInterrupt();
        assertEq("PROGRAM-INTERRUPTED", error.err);
        assertEq(1, registry.getDefinitions().size());
        program.callFunction("publish", registry, complete, manager, False);
        assertEq(501, registry.getDefinitions().size());
        foreach XsdIdentityConstraintRegistry current in (registry, Serializable::deserialize(registry.serialize())) {
            foreach int index in (0, 250, 499) {
                assertEq("{}K" + index, current.get("{}K" + index).getExpandedName());
            }
        }
    }
    private static hash<SerializationInfo> forged(string class_name, hash<auto> members) {
        hash<SerializationInfo> data = Serializable::serializeToData(members);
        hash<auto> encoded = data._index{data._data._index}._members;
        data._index.forged = <ObjectSerializationInfo>{"_class": class_name,
            "_class_data": {class_name: encoded}};
        data._data = <IndexedObjectSerializationInfo>{"_index": "forged"};
        return data;
    }
    private metadata() {
        XsdIdentityConstraintRegistry original = parse(owner("root", definition()
            + definition("R", "keyref", 'refer="K"'))).nsc.getIdentityConstraintRegistry();
        XsdIdentityConstraint definition = original.get("{}K");
        foreach auto bad in (NOTHING, (), "bad", {"wrong": definition.getInfo()},
                {"{}K": "bad"}, {"{}R": original.get("{}R").getInfo()}) {
            hash<SerializationInfo> data = forged("WSDL::XsdIdentityConstraintRegistry", {"definitions": bad});
            assertThrows("DESERIALIZATION-ERROR", \Serializable::deserialize(), (data,));
            assertEq(2, original.getDefinitions().size());
        }
        foreach hash<auto> patch in ({"local_name": "two names"}, {"category": "other"}, {"fields": ()},
                {"refer_namespace_uri": "", "refer_local_name": "K"}, {"extra": True},
                {"selector": {"expression": "row|", "namespaces": {}}},
                {"selector": {"expression": "p:row", "namespaces": {"p": 3}}},
                {"selector": {"expression": "xml:row", "namespaces": {"xml": "urn:wrong"}}}) {
            hash<auto> changed();
            foreach string key in (keys definition.getInfo()) {
                changed{key} = definition.getInfo(){key};
            }
            changed += patch;
            hash<SerializationInfo> data = forged("WSDL::XsdIdentityConstraint", {"info": changed});
            assertThrows("DESERIALIZATION-ERROR", \Serializable::deserialize(), (data,));
            assertEq("{}K", definition.getExpandedName());
        }
        assertThrows("WSDL-ERROR", \original.replace(), ({"wrong": definition},));
        assertThrows("WSDL-ERROR", \original.replace(), ({"{}R": original.get("{}R")},));
        assertEq(2, original.getDefinitions().size());
    }
}

%endif
