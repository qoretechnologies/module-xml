%requires qore >= 2.3
%modern

%requires QUnit
%requires ../qlib/CdaDataProvider

%exec-class CdaDataProviderTest

class CdaDataProviderTest inherits QUnit::Test {
    private {
        const SchemaPath = get_script_dir() + "/cda-test-schema/cda-test.xsd";

        const CdaXml =
            '<?xml version="1.0"?>'
            '<ClinicalDocument xmlns="urn:hl7-org:v3">'
            '  <templateId root="2.16.840.1.113883.10.20.22.1.2"/>'
            '  <id root="1.2.3.4.5.6" extension="DOC-001" assigningAuthorityName="Qore Test"/>'
            '  <code code="34133-9" codeSystem="2.16.840.1.113883.6.1" codeSystemName="LOINC" displayName="Summary of episode note"/>'
            '  <title>Synthetic CDA Consultation Note</title>'
            '  <effectiveTime value="20260526120000+0000"/>'
            '  <confidentialityCode code="N" codeSystem="2.16.840.1.113883.5.25" displayName="normal"/>'
            '  <languageCode code="en-US"/>'
            '  <setId root="1.2.3.4.5.6" extension="SET-001"/>'
            '  <versionNumber value="1"/>'
            '  <recordTarget>'
            '    <patientRole>'
            '      <id root="1.2.3.4.5.7" extension="PAT-001"/>'
            '      <patient>'
            '        <name><given>Alex</given><family>Example</family></name>'
            '        <administrativeGenderCode code="U"/>'
            '        <birthTime value="19700101"/>'
            '      </patient>'
            '    </patientRole>'
            '  </recordTarget>'
            '  <component>'
            '    <structuredBody>'
            '      <component>'
            '        <section>'
            '          <code code="10164-2" codeSystem="2.16.840.1.113883.6.1" displayName="History of Present Illness"/>'
            '          <title>History</title>'
            '          <text><paragraph>Synthetic history narrative.</paragraph></text>'
            '        </section>'
            '      </component>'
            '      <component>'
            '        <section>'
            '          <code code="11450-4" codeSystem="2.16.840.1.113883.6.1" displayName="Problem List"/>'
            '          <title>Problems</title>'
            '          <text><list><item>Synthetic problem entry</item></list></text>'
            '        </section>'
            '      </component>'
            '    </structuredBody>'
            '  </component>'
            '</ClinicalDocument>';

        const InvalidCdaXml =
            '<?xml version="1.0"?>'
            '<ClinicalDocument xmlns="urn:hl7-org:v3">'
            '  <id root="1.2.3.4.5.6" extension="DOC-002"/>'
            '</ClinicalDocument>';
    }

    constructor() : QUnit::Test("CdaDataProvider test", "1.0") {
        addTestCase("parser extraction", \parserExtractionTest());
        addTestCase("inline schema validation", \inlineSchemaValidationTest());
        addTestCase("data provider actions", \dataProviderActionsTest());
        addTestCase("factory and action catalog", \factoryAndActionCatalogTest());
        addTestCase("negative tests", \negativeTests());
        set_return_value(main());
    }

    parserExtractionTest() {
        hash<CdaDataProvider::CdaParseDocumentResponse> resp =
            CdaDataProvider::CdaDocumentParser::parse(CdaXml, {
                "validate": True,
                "xsd_path": SchemaPath,
            });
        assertEq(True, resp.valid);
        assertEq("Synthetic CDA Consultation Note", resp.metadata.title);
        assertEq("DOC-001", resp.metadata.document_id.extension);
        assertEq("34133-9", resp.metadata.code.code);
        assertEq("en-US", resp.metadata.language_code);
        assertEq("PAT-001", resp.metadata.patient.id.extension);
        assertEq("Alex Example", resp.metadata.patient.name);
        assertEq("19700101", resp.metadata.patient.birth_time);
        assertEq(1, resp.metadata.template_ids.size());
        assertEq(2, resp.sections.size());
        assertEq("History", resp.sections[0].title);
        assertEq("10164-2", resp.sections[0].code.code);
        assertEq("Synthetic history narrative.", resp.sections[0].text);
        assertEq("Problems", resp.sections[1].title);
        assertEq("Synthetic problem entry", resp.sections[1].text);
        assertTrue(exists resp.data.ClinicalDocument);
    }

    inlineSchemaValidationTest() {
        string schema =
            '<?xml version="1.0"?>'
            '<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" '
            '    targetNamespace="urn:hl7-org:v3" elementFormDefault="qualified">'
            '  <xsd:element name="ClinicalDocument">'
            '    <xsd:complexType>'
            '      <xsd:sequence>'
            '        <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="skip"/>'
            '      </xsd:sequence>'
            '      <xsd:anyAttribute processContents="skip"/>'
            '    </xsd:complexType>'
            '  </xsd:element>'
            '</xsd:schema>';
        hash<CdaDataProvider::CdaParseDocumentResponse> resp =
            CdaDataProvider::CdaDocumentParser::parse(CdaXml, {
                "validate": True,
                "xsd": schema,
            });
        assertEq(True, resp.valid);
        assertEq("DOC-001", resp.metadata.document_id.extension);
    }

    dataProviderActionsTest() {
        CdaDataProvider::CdaDataProvider dp({
            "validate": True,
            "xsd_path": SchemaPath,
        });
        assertEq("cda", dp.getName());
        assertTrue(dp.getChildProviderNames().contains("parse-document"));
        assertTrue(dp.getChildProviderNames().contains("validate-document"));

        AbstractDataProvider parse = dp.getChildProviderEx("parse-document");
        hash<auto> parsed = parse.doRequest({"xml": CdaXml});
        assertEq(True, parsed.valid);
        assertEq(2, parsed.sections.size());

        AbstractDataProvider validate = dp.getChildProviderEx("validate-document");
        hash<CdaDataProvider::CdaValidateDocumentResponse> valid =
            cast<hash<CdaDataProvider::CdaValidateDocumentResponse>>(validate.doRequest({"xml": CdaXml}));
        assertEq(True, valid.valid);
        assertEq("Synthetic CDA Consultation Note", valid.metadata.title);
    }

    factoryAndActionCatalogTest() {
        hash<DataProviderFactoryInfo> info = DataProvider::getFactoryEx("cda").getInfo();
        assertEq("cda", info.name);
        assertTrue(info.children_can_support_apis);

        hash<auto> app = DataProviderActionCatalog::getApp(CdaDataProvider::AppName);
        assertEq("CDA Documents", app.display_name);

        hash<DataProviderActionInfo> parse_action = DataProviderActionCatalog::getAppActionEx(
            CdaDataProvider::AppName, "parse-cda-document");
        assertEq("CdaParseDocumentResponse", parse_action.output_type.getName());
        assertTrue(exists parse_action.options.xml);
        assertTrue(exists parse_action.options.validate);
        assertTrue(exists parse_action.options.xsd_path);

        hash<DataProviderActionInfo> validate_action = DataProviderActionCatalog::getAppActionEx(
            CdaDataProvider::AppName, "validate-cda-document");
        assertEq("CdaValidateDocumentResponse", validate_action.output_type.getName());
        assertTrue(exists validate_action.options.xml);
        assertTrue(exists validate_action.options.xsd_path);
        assertFalse(exists validate_action.options.validate);
    }

    negativeTests() {
        assertThrows("CDA-PARSE-ERROR", sub () {
            CdaDataProvider::CdaDocumentParser::parse('<?xml version="1.0"?><NotCda/>');
        });
        assertThrows("CDA-VALIDATION-ERROR", sub () {
            CdaDataProvider::CdaDocumentParser::parse(CdaXml, {"validate": True});
        });
        assertThrows("CDA-VALIDATION-ERROR", sub () {
            CdaDataProvider::CdaDocumentParser::parse(CdaXml, {
                "validate": True,
                "xsd_path": SchemaPath,
                "xsd": ReadOnlyFile::readTextFile(SchemaPath),
            });
        });
        assertThrows("XSD-ERROR", sub () {
            CdaDataProvider::CdaDocumentParser::parse(InvalidCdaXml, {
                "validate": True,
                "xsd_path": SchemaPath,
            });
        });
        assertThrows("CONSTRUCTOR-ERROR", sub () {
            new CdaDataProvider::CdaDataProvider({
                "xsd_path": SchemaPath,
                "xsd": ReadOnlyFile::readTextFile(SchemaPath),
            });
        });
    }
}
