#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "NOTATION tests require the json module";
%else
%exec-class XmlNotationsTest

class XmlNotationsTest inherits QUnit::Test {
    constructor() : Test("Native NOTATION declarations and values", "1.0") {
        addTestCase("Declarations, enumerated types and expanded notation values", \check());
        set_return_value(main());
    }
    private static bool consume(string schema, string xml) {
        XmlReader reader(new StringInputStream(xml), {"xsd": schema});
        int roots = 0;
        while (reader.read()) {
            if (reader.nodeType() == XML_NODE_TYPE_ELEMENT && !reader.depth()) {
                ++roots;
            }
        }
        return roots == 1 && reader.isValid();
    }
    private check() {
        list<hash<auto>> models = parse_json(ReadOnlyFile::readTextFile(
            get_script_dir() + "/wsdl-interop/fixtures/notations.json"));
        int count = 0;
        foreach hash<auto> model in (models) {
            if (model.resources) {
                model.schema = replace(model.schema, "notations-import.xsd",
                    get_script_dir() + "/wsdl-interop/fixtures/notations-import.xsd");
            }
            foreach hash<auto> row in (model.documents) {
                ++count;
                XmlDoc document(row.xml);
                string before = document.toString();
                if (row.expected) {
                    assertTrue(consume(model.schema, row.xml), row.name);
                    assertEq(parse_xml(row.xml), parse_xml_with_schema(row.xml, model.schema), row.name);
                    document.validateSchema(model.schema);
                    document.validateSchema(model.schema);
                } else {
                    assertThrows(model.schema_valid ? "PARSE-XML-EXCEPTION" : "XSD-SYNTAX-ERROR", \consume(), (model.schema, row.xml));
                    assertThrows(model.schema_valid ? "PARSE-XML-EXCEPTION" : "XSD-SYNTAX-ERROR", \parse_xml_with_schema(), (row.xml, model.schema));
                    assertThrows(model.schema_valid ? "XSD-ERROR" : "XSD-SYNTAX-ERROR", \document.validateSchema(), (model.schema,));
                }
                assertEq(before, document.toString(), row.name);
            }
        }
        assertEq(231, count);
    }
}
%endif
