<?xml version="1.0" encoding="UTF-8"?>
<!-- WSDL for testing XSD "pattern" facet validation -->
<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:xs="http://www.w3.org/2001/XMLSchema"
             xmlns:tns="urn:qore:test:xsd-patterns"
             targetNamespace="urn:qore:test:xsd-patterns">
    <types>
        <xs:schema targetNamespace="urn:qore:test:xsd-patterns"
                   xmlns="urn:qore:test:xsd-patterns"
                   elementFormDefault="qualified" attributeFormDefault="unqualified">
            <xs:element name="Req">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="single"  type="singlePatternType" minOccurs="0"/>
                        <xs:element name="multi"   type="multiPatternType"  minOccurs="0"/>
                        <xs:element name="alt"     type="altPatternType"    minOccurs="0"/>
                        <xs:element name="derived" type="derivedPatternType" minOccurs="0"/>
                        <xs:element name="ipv6"    type="ipV6AddressType"   minOccurs="0"/>
                        <xs:element name="plain"   type="xs:string"         minOccurs="0"/>
                        <xs:element name="dialect" type="dialectType"        minOccurs="0"/>
                        <xs:element name="subtract" type="subtractType"      minOccurs="0"/>
                        <xs:element name="bounded" type="boundedStringType"  minOccurs="0"/>
                        <xs:element name="exact"   type="exactLengthType"    minOccurs="0"/>
                        <xs:element name="ranged"  type="rangedIntType"      minOccurs="0"/>
                        <xs:element name="excl"    type="exclusiveIntType"   minOccurs="0"/>
                        <xs:element name="digits"  type="digitsType"         minOccurs="0"/>
                        <xs:element name="padded"  type="paddedType"         minOccurs="0"/>
                        <xs:element name="wsString" type="xs:string"           minOccurs="0"/>
                        <xs:element name="wsNorm"  type="xs:normalizedString"  minOccurs="0"/>
                        <xs:element name="wsToken" type="xs:token"             minOccurs="0"/>
                        <xs:element name="wsExplicit" type="collapsedType"     minOccurs="0"/>
                        <xs:element name="blockLatin" type="blockLatinType"    minOccurs="0"/>
                        <xs:element name="blockGreek" type="blockGreekType"    minOccurs="0"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>

            <xs:simpleType name="singlePatternType">
                <xs:restriction base="xs:string">
                    <xs:pattern value="imsi-[0-9]{6,15}"/>
                </xs:restriction>
            </xs:simpleType>

            <!-- multiple patterns in one restriction: XSD 1.0 part 2 4.3.4.3 combines them with "|" -->
            <xs:simpleType name="multiPatternType">
                <xs:restriction base="xs:string">
                    <xs:pattern value="[0-9]+"/>
                    <xs:pattern value="[a-z]+"/>
                </xs:restriction>
            </xs:simpleType>

            <!-- a pattern with a top-level alternation must be anchored as a whole -->
            <xs:simpleType name="altPatternType">
                <xs:restriction base="xs:string">
                    <xs:pattern value="aaa|bbb"/>
                </xs:restriction>
            </xs:simpleType>

            <!-- patterns declared in different derivation steps are intersected -->
            <xs:simpleType name="derivedBaseType">
                <xs:restriction base="xs:string">
                    <xs:pattern value="[a-z]+"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:simpleType name="derivedPatternType">
                <xs:restriction base="derivedBaseType">
                    <xs:pattern value=".{3}"/>
                </xs:restriction>
            </xs:simpleType>

            <!-- 16 sibling patterns, one per IPv6 textual form; modelled on a vendor-supplied schema -->
            <xs:simpleType name="ipV6AddressType">
                <xs:restriction base="xs:string">
                <xs:pattern value=".*[$][0-9A-Fa-f]{1,4}(:[0-9A-Fa-f]{1,4}){7}([/]((12[0-8]|(1[0-1][0-9])|([1-9][0-9]|[0-9]))))?"/>
                <xs:pattern value=".*[$]:(:[0-9A-Fa-f]{1,4}){1,7}([/]((12[0-8]|(1[0-1][0-9])|([1-9][0-9]|[0-9]))))?"/>
                <xs:pattern value=".*[$]([0-9A-Fa-f]{1,4}:){1,6}(:[0-9A-Fa-f]{1,4}){1}([/]((12[0-8]|(1[0-1][0-9])|([1-9][0-9]|[0-9]))))?"/>
                <xs:pattern value=".*[$]([0-9A-Fa-f]{1,4}:){1,5}(:[0-9A-Fa-f]{1,4}){1,2}([/]((12[0-8]|(1[0-1][0-9])|([1-9][0-9]|[0-9]))))?"/>
                <xs:pattern value=".*[$]([0-9A-Fa-f]{1,4}:){1,4}(:[0-9A-Fa-f]{1,4}){1,3}([/]((12[0-8]|(1[0-1][0-9])|([1-9][0-9]|[0-9]))))?"/>
                <xs:pattern value=".*[$]([0-9A-Fa-f]{1,4}:){1,3}(:[0-9A-Fa-f]{1,4}){1,4}([/]((12[0-8]|(1[0-1][0-9])|([1-9][0-9]|[0-9]))))?"/>
                <xs:pattern value=".*[$]([0-9A-Fa-f]{1,4}:){1,2}(:[0-9A-Fa-f]{1,4}){1,5}([/]((12[0-8]|(1[0-1][0-9])|([1-9][0-9]|[0-9]))))?"/>
                <xs:pattern value=".*[$]([0-9A-Fa-f]{1,4}:){1}(:[0-9A-Fa-f]{1,4}){1,6}([/]((12[0-8]|(1[0-1][0-9])|([1-9][0-9]|[0-9]))))?"/>
                <xs:pattern value=".*[$]([0-9A-Fa-f]{1,4}:){1,7}:([/]((12[0-8]|(1[0-1][0-9])|([1-9][0-9]|[0-9]))))?"/>
                <xs:pattern value=".*[$]([0-9a-fA-F]{1,4}:){6,6}((25[0-5]|(2[0-4][0-9])|(1[0-9][0-9])|[1-9]?[0-9])[.]){3,3}(((25[0-5])|(2[0-4][0-9])|(1[0-9][0-9])|[1-9]?[0-9]))([/]((12[0-8]|(1[0-1][0-9])|([1-9][0-9]|[0-9]))))?"/>
                <xs:pattern value=".*[$]::([0-9a-fA-F]{1,4}:){0,5}((25[0-5]|(2[0-4][0-9])|(1[0-9][0-9])|[1-9]?[0-9])[.]){3,3}(((25[0-5])|(2[0-4][0-9])|(1[0-9][0-9])|[1-9]?[0-9]))([/]((12[0-8]|(1[0-1][0-9])|([1-9][0-9]|[0-9]))))?"/>
                <xs:pattern value=".*[$]([0-9A-Fa-f]{1,4}:){1,4}(:[0-9A-Fa-f]{1,4}){1}:((25[0-5]|(2[0-4][0-9])|(1[0-9][0-9])|[1-9]?[0-9])[.]){3,3}(((25[0-5])|(2[0-4][0-9])|(1[0-9][0-9])|[1-9]?[0-9]))([/]((12[0-8]|(1[0-1][0-9])|([1-9][0-9]|[0-9]))))?"/>
                <xs:pattern value=".*[$]([0-9A-Fa-f]{1,4}:){1,3}(:[0-9A-Fa-f]{1,4}){1,2}:((25[0-5]|(2[0-4][0-9])|(1[0-9][0-9])|[1-9]?[0-9])[.]){3,3}(((25[0-5])|(2[0-4][0-9])|(1[0-9][0-9])|[1-9]?[0-9]))([/]((12[0-8]|(1[0-1][0-9])|([1-9][0-9]|[0-9]))))?"/>
                <xs:pattern value=".*[$]([0-9A-Fa-f]{1,4}:){1,2}(:[0-9A-Fa-f]{1,4}){1,3}:((25[0-5]|(2[0-4][0-9])|(1[0-9][0-9])|[1-9]?[0-9])[.]){3,3}(((25[0-5])|(2[0-4][0-9])|(1[0-9][0-9])|[1-9]?[0-9]))([/]((12[0-8]|(1[0-1][0-9])|([1-9][0-9]|[0-9]))))?"/>
                <xs:pattern value=".*[$]([0-9A-Fa-f]{1,4}:){1}(:[0-9A-Fa-f]{1,4}){1,4}:((25[0-5]|(2[0-4][0-9])|(1[0-9][0-9])|[1-9]?[0-9])[.]){3,3}(((25[0-5])|(2[0-4][0-9])|(1[0-9][0-9])|[1-9]?[0-9]))([/]((12[0-8]|(1[0-1][0-9])|([1-9][0-9]|[0-9]))))?"/>
                <xs:pattern value=".*[$]([0-9a-fA-F]{1,4}:){1,5}:((25[0-5]|(2[0-4][0-9])|(1[0-9][0-9])|[1-9]?[0-9])[.]){3,3}(((25[0-5])|(2[0-4][0-9])|(1[0-9][0-9])|[1-9]?[0-9]))([/]((12[0-8]|(1[0-1][0-9])|([1-9][0-9]|[0-9]))))?"/>
                </xs:restriction>
            </xs:simpleType>

            <!-- "^" and "$" are ordinary characters in the XSD regular expression language -->
            <xs:simpleType name="dialectType">
                <xs:restriction base="xs:string">
                    <xs:pattern value="a^b$c"/>
                </xs:restriction>
            </xs:simpleType>

            <!-- XSD character class subtraction, which PCRE does not support -->
            <xs:simpleType name="subtractType">
                <xs:restriction base="xs:string">
                    <xs:pattern value="[a-z-[aeiou]]{3}"/>
                </xs:restriction>
            </xs:simpleType>

            <xs:simpleType name="boundedStringType">
                <xs:restriction base="xs:string">
                    <xs:minLength value="3"/>
                    <xs:maxLength value="6"/>
                </xs:restriction>
            </xs:simpleType>

            <xs:simpleType name="exactLengthType">
                <xs:restriction base="xs:string">
                    <xs:length value="4"/>
                </xs:restriction>
            </xs:simpleType>

            <xs:simpleType name="rangedIntType">
                <xs:restriction base="xs:integer">
                    <xs:minInclusive value="10"/>
                    <xs:maxInclusive value="20"/>
                </xs:restriction>
            </xs:simpleType>

            <xs:simpleType name="exclusiveIntType">
                <xs:restriction base="xs:integer">
                    <xs:minExclusive value="10"/>
                    <xs:maxExclusive value="20"/>
                </xs:restriction>
            </xs:simpleType>

            <xs:simpleType name="digitsType">
                <xs:restriction base="xs:decimal">
                    <xs:totalDigits value="4"/>
                    <xs:fractionDigits value="2"/>
                </xs:restriction>
            </xs:simpleType>

            <!-- a pattern whose shortest match is too short for the length facets -->
            <xs:simpleType name="paddedType">
                <xs:restriction base="xs:string">
                    <xs:pattern value="[0-9]*"/>
                    <xs:minLength value="6"/>
                </xs:restriction>
            </xs:simpleType>

            <!-- an explicit whiteSpace facet on a type whose base preserves whitespace -->
            <xs:simpleType name="collapsedType">
                <xs:restriction base="xs:string">
                    <xs:whiteSpace value="collapse"/>
                </xs:restriction>
            </xs:simpleType>

            <!-- XSD Unicode block escapes, which PCRE does not support -->
            <xs:simpleType name="blockLatinType">
                <xs:restriction base="xs:string">
                    <xs:pattern value="\p{IsBasicLatin}{3}"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:simpleType name="blockGreekType">
                <xs:restriction base="xs:string">
                    <xs:pattern value="\p{IsGreek}+"/>
                </xs:restriction>
            </xs:simpleType>

            <xs:element name="Resp">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="single" type="singlePatternType" minOccurs="0"/>
                        <xs:element name="multi"  type="multiPatternType"  minOccurs="0"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:schema>
    </types>

    <message name="ReqM"><part name="parameters" element="tns:Req"/></message>
    <message name="RespM"><part name="parameters" element="tns:Resp"/></message>

    <portType name="PatternPort">
        <operation name="Op">
            <input message="tns:ReqM"/>
            <output message="tns:RespM"/>
        </operation>
    </portType>

    <binding name="PatternBinding" type="tns:PatternPort">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <operation name="Op">
            <soap:operation soapAction="Op" style="document"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>
    </binding>

    <service name="PatternService">
        <port name="PatternPort" binding="tns:PatternBinding">
            <soap:address location="http://localhost:8080/xsd-patterns"/>
        </port>
    </service>
</definitions>
