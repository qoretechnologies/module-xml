#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%exec-class XmlParticleAttributionTest

class XmlParticleAttributionTest inherits QUnit::Test {
    constructor() : Test("Native exact counted particle attribution", "1.0") {
        addTestCase("Fixed boundaries select declarations without lookahead", \boundaries());
        addTestCase("Nested flexibility retains exact iteration counts", \flexibility());
        addTestCase("Present components are checked inside empty languages", \components());
        addTestCase("Large finite count thresholds retain adjacent integers", \largeCounts());
        addTestCase("Extensions retain original base occurrence counts", \extensions());
        addTestCase("Abstract names cannot compete with usable declarations", \abstractNames());
        addTestCase("All groups retain required empty-language members", \allEmptyMembers());
        addTestCase("Nullable repetitions preserve all finite upper bounds", \nullableCounts());
        set_return_value(main());
    }

    private string element(string name, string attrs = "") {
        return sprintf('<xs:element name="%s" type="xs:string" %s/>', name, attrs);
    }

    private string schema(string content, string declarations = "") {
        return '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">' + declarations
            + '<xs:complexType name="Record">' + content + '</xs:complexType>'
            + '<xs:element name="r" type="Record"/></xs:schema>';
    }

    private bool constructs(string source, bool stream) {
        if (stream) {
            XmlReader reader(new StringInputStream("<r/>"), {"xsd": source});
            return True;
        }
        try {
            hash<auto> value = parse_xml_with_schema("<r/>", source);
            @assert(value.hasKey("r"));
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "PARSE-XML-EXCEPTION") {
                rethrow;
            }
            # Document validity is independent of successful schema construction.
        }
        return True;
    }

    private check(string content, bool valid, string declarations = "") {
        string source = schema(content, declarations);
        foreach bool stream in (False, True) {
            if (valid) {
                assertTrue(constructs(source, stream), content);
            } else {
                assertThrows("XSD-SYNTAX-ERROR", \constructs(), (source, stream), content);
            }
        }
    }

    private int consume(string source, string document) {
        XmlReader reader(new StringInputStream(document), {"xsd": source});
        int count = 0;
        while (reader.read()) {
            if (reader.nodeType() == XML_NODE_TYPE_ELEMENT && reader.depth() == 1) {
                ++count;
            }
        }
        @assert(reader.isValid());
        return count;
    }

    boundaries() {
        string content = '<xs:sequence>' + element("a", 'minOccurs="2" maxOccurs="2" fixed="first"')
            + element("a", 'fixed="last"') + '</xs:sequence>';
        check(content, True);
        string source = schema(content);
        string document = '<r><a>first</a><a>first</a><a>last</a></r>';
        assertEq({"r": {"a": ("first", "first", "last")}}, parse_xml_with_schema(document, source));
        assertEq(3, consume(source, document));
        foreach string wrong in ('<r><a>first</a><a>last</a></r>',
                '<r><a>first</a><a>first</a><a>last</a><a>last</a></r>',
                '<r><a>first</a><a>last</a><a>first</a></r>') {
            assertThrows("PARSE-XML-EXCEPTION", \parse_xml_with_schema(), (wrong, source));
            assertThrows("PARSE-XML-EXCEPTION", \consume(), (source, wrong));
        }
        check('<xs:sequence>' + element("a", 'minOccurs="2" maxOccurs="3"') + element("a")
            + '</xs:sequence>', False);
    }

    private string counted(string outer, string low = "2", string high = "3") {
        return '<xs:sequence>' + sprintf('<xs:sequence minOccurs="%s" maxOccurs="%s">', outer, outer)
            + element("b", 'minOccurs="0"')
            + element("a", sprintf('minOccurs="%s" maxOccurs="%s"', low, high))
            + '</xs:sequence>' + element("b") + '</xs:sequence>';
    }

    flexibility() {
        check(counted("2"), True);
        check(counted("3"), False);
        check(counted("4"), False);
        string source = schema(counted("2"));
        foreach string content in ("aaaab", "baaaab", "aabaab", "baabaab", "aaabaaaab") {
            # Two groups of 2..3 a values, each optionally preceded by b.
            string document = "<r>";
            for (int index = 0; index < content.size(); ++index) {
                string name = content.substr(index, 1);
                document += "<" + name + ">value</" + name + ">";
            }
            document += "</r>";
            # The schema permits 2..3 a's in each iteration, followed by the final b.
            if (content == "aaabaaaab") {
                assertThrows("PARSE-XML-EXCEPTION", \consume(), (source, document));
            } else {
                assertEq(content.size(), consume(source, document));
                assertTrue(exists parse_xml_with_schema(document, source).r);
            }
        }
        check('<xs:sequence minOccurs="1" maxOccurs="2">'
            + element("a", 'minOccurs="1" maxOccurs="2"') + '</xs:sequence>', True);
    }

    components() {
        check('<xs:sequence><xs:choice/><xs:choice>' + element("a") + element("a")
            + '</xs:choice></xs:sequence>', False);
        check('<xs:sequence/>', False, '<xs:group name="Unused"><xs:choice>' + element("a")
            + element("a") + '</xs:choice></xs:group>');
        check('<xs:sequence><xs:sequence minOccurs="0" maxOccurs="0"><xs:choice>'
            + element("a") + element("a") + '</xs:choice></xs:sequence>' + element("b")
            + '</xs:sequence>', True);
        check('<xs:choice/>', True);
    }

    largeCounts() {
        string low = "1073741823";
        string high = "1073741824";
        check(counted(low, low, high), True);
        check(counted(high, low, high), False);
        foreach string count in ("1073741822", "1073741823", high) {
            check('<xs:sequence>' + element("a", sprintf('minOccurs="%s" maxOccurs="%s"', count, count))
                + element("a") + '</xs:sequence>', True);
        }
    }

    extensions() {
        string high = "1073741824";
        string declarations = '<xs:complexType name="Base">'
            + sprintf('<xs:sequence minOccurs="%s" maxOccurs="%s">', high, high)
            + element("a") + '</xs:sequence></xs:complexType>';
        check('<xs:complexContent><xs:extension base="Base"><xs:sequence>' + element("a")
            + '</xs:sequence></xs:extension></xs:complexContent>', True, declarations);
    }

    abstractNames() {
        string declarations = '<xs:element name="h" type="xs:string" abstract="true"/>'
            + '<xs:element name="m" type="xs:string" substitutionGroup="h"/>';
        string content = '<xs:choice><xs:element ref="h"/>' + element("h") + '</xs:choice>';
        check(content, True, declarations);
        string source = schema(content, declarations);
        foreach string name in ("h", "m") {
            string document = '<r><' + name + '>value</' + name + '></r>';
            assertEq(1, consume(source, document));
            assertEq("value", parse_xml_with_schema(document, source).r{name});
        }
        check('<xs:choice><xs:element ref="h"/><xs:element ref="m"/></xs:choice>', False, declarations);
    }

    private string documentFor(string word) {
        string document = "<r>";
        for (int index = 0; index < word.size(); ++index) {
            string name = word.substr(index, 1);
            document += "<" + name + ">value</" + name + ">";
        }
        return document + "</r>";
    }

    allEmptyMembers() {
        string declarations = '<xs:element name="h" type="xs:string" abstract="true"/>';
        foreach bool optionalGroup in (False, True) {
            foreach bool optionalMember in (False, True) {
                string content = sprintf('<xs:all minOccurs="%d"><xs:element ref="h" minOccurs="%d"/>',
                    optionalGroup ? 0 : 1, optionalMember ? 0 : 1) + element("a") + '</xs:all>';
                check(content, True, declarations);
                string source = schema(content, declarations);
                foreach string word in ("", "a", "h", "ha", "ah", "aa") {
                    string document = documentFor(word);
                    bool valid = (optionalGroup && word == "") || (optionalMember && word == "a");
                    if (valid) {
                        assertEq(word.size(), consume(source, document));
                        assertEq(1, parse_xml_with_schema(document, source).size());
                    } else {
                        assertThrows("PARSE-XML-EXCEPTION", \consume(), (source, document));
                        assertThrows("PARSE-XML-EXCEPTION", \parse_xml_with_schema(), (document, source));
                    }
                }
            }
        }
    }

    nullableCounts() {
        string content = '<xs:sequence minOccurs="0" maxOccurs="2">'
            + '<xs:sequence minOccurs="1" maxOccurs="2">' + element("a", 'minOccurs="0"')
            + '</xs:sequence></xs:sequence>';
        check(content, True);
        string source = schema(content);
        foreach string word in ("", "a", "aa", "aaa", "aaaa") {
            string document = documentFor(word);
            assertEq(word.size(), consume(source, document));
            assertEq(1, parse_xml_with_schema(document, source).size());
        }
        string wrong = documentFor("aaaaa");
        assertThrows("PARSE-XML-EXCEPTION", \consume(), (source, wrong));
        assertThrows("PARSE-XML-EXCEPTION", \parse_xml_with_schema(), (wrong, source));

        # Empty choices inside a repeated choice must not erase either counter.
        source = schema('<xs:choice minOccurs="2" maxOccurs="2">'
            + '<xs:choice maxOccurs="2"><xs:sequence/>' + element("b") + '</xs:choice>'
            + '<xs:choice><xs:sequence/>' + element("a") + '</xs:choice></xs:choice>');
        foreach string word in ("", "aa", "ab", "ba", "abb", "bba", "bbbb") {
            string document = documentFor(word);
            assertEq(word.size(), consume(source, document));
            assertEq(1, parse_xml_with_schema(document, source).size());
        }
        foreach string word in ("aaa", "abbb", "bbba", "bbbbb") {
            string document = documentFor(word);
            assertThrows("PARSE-XML-EXCEPTION", \consume(), (source, document));
            assertThrows("PARSE-XML-EXCEPTION", \parse_xml_with_schema(), (document, source));
        }

        # A nullable term can satisfy a large minimum with empty iterations;
        # input processing must not enumerate those iterations.
        source = schema('<xs:sequence><xs:sequence minOccurs="1073741823" maxOccurs="1073741823">'
            + '<xs:sequence maxOccurs="2">' + element("a", 'minOccurs="0"')
            + '</xs:sequence></xs:sequence>' + element("b") + '</xs:sequence>');
        foreach string word in ("b", "ab", "aab") {
            string document = documentFor(word);
            assertEq(word.size(), consume(source, document));
            assertEq(1, parse_xml_with_schema(document, source).size());
        }
        wrong = documentFor("c");
        assertThrows("PARSE-XML-EXCEPTION", \consume(), (source, wrong));
        assertThrows("PARSE-XML-EXCEPTION", \parse_xml_with_schema(), (wrong, source));
    }
}
