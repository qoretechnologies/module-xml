# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires ../qlib/WSDL.qm
%requires SoapClientIo
%requires HttpServer
%exec-class RequestUrlTest

class RequestUrlPeer inherits AbstractHttpRequestHandler {
    private { string name; Queue received; bool soap; }
    constructor(string name, Queue received, bool soap = False) {
        self.name = name; self.received = received; self.soap = soap;
    }
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        received.push({"origin":name,"path":cx.raw_path,"headers":hdr,"body":body,"method":hdr.method,
            "protocol":cx."header-info".http3 ? "h3" : cx."header-info".http2 ? "h2" : "h1"});
        if (soap) {
            return makeResponse(200, '<s:Envelope xmlns:s="http://www.w3.org/2003/05/soap-envelope">'
                + '<s:Body><t:value xmlns:t="urn:soap-envelope-test">' + name
                + '</t:value></s:Body></s:Envelope>', {"Content-Type":"application/soap+xml"});
        }
        return makeResponse({"Content-Type":"text/xml;charset=UTF-8"}, 200, "<result>"+name+"</result>");
    }
}

class RequestUrlTest inherits QUnit::Test {
    private { string source; }
    constructor() : Test("SoapClientIo request URLs", "1.0") {
        source = ReadOnlyFile::readTextFile(get_script_dir()+"/wsdl-interop/http-request-url-peer/contract.wsdl");
        addTestCase("Operation references resolve against the selected endpoint", \references());
        addTestCase("Cross-origin defaults and explicit call headers", \headers());
        addTestCase("URL replacement precedes endpoint resolution", \replacement());
        addTestCase("POST bodies and endpoint override retain their values", \post());
        addTestCase("Empty input preserves empty and inherited queries", \empty());
        addTestCase("Concurrent operations leave the endpoint unchanged", \concurrent());
        addTestCase("Target user information does not replace configured credentials", \userinfo());
        addTestCase("Fixed SOAP endpoints and response references over HTTP/1, HTTP/2, HTTP/3", \soapEndpoints());
        set_return_value(main());
    }
    private string contract(string base, string location, string verb = "GET", string input = "<h:urlEncoded/>") {
        string xml = replace(source, "http://example.invalid/base/", html_encode(base));
        xml = replace(xml, 'location="/send"', 'location="'+html_encode(location)+'"');
        xml = replace(xml, 'verb="GET"', 'verb="'+verb+'"');
        return replace(xml, "<h:urlEncoded/>", input);
    }
    private static HttpServer server(string name, Queue queue, bool soap = False, bool tls = False) {
        HttpServer result();
        result.setDefaultHandler(name, new RequestUrlPeer(name, queue, soap));
        string certs = get_script_dir() + "/certs/";
        result.addListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "service": 0,
            "cert": tls ? new SSLCertificate(ReadOnlyFile::readTextFile(certs + "localhost-cert.pem")) : NOTHING,
            "key": tls ? new SSLPrivateKey(ReadOnlyFile::readTextFile(certs + "localhost-key.pem")) : NOTHING,
            "enable_h3": tls,
        });
        result.waitForAsyncIo();
        return result;
    }
    private static string endpoint(HttpServer server) {
        return sprintf("http://127.0.0.1:%d", server.getListenerInfo(0).port);
    }
    private references() {
        Queue received();
        HttpServer a=server("A",received); on_exit a.stop();
        HttpServer b=server("B",received); on_exit b.stop();
        string origin=endpoint(a);
        foreach hash<auto> row in (
                {"base":"/base/","ref":"/send","path":"/send?id=hello","origin":"A"},
                {"base":"/base/","ref":"send","path":"/base/send?id=hello","origin":"A"},
                {"base":"/base/file","ref":"send","path":"/base/send?id=hello","origin":"A"},
                {"base":"/base/dir/","ref":"../send","path":"/base/send?id=hello","origin":"A"},
                {"base":"/base/","ref":"./x/../send","path":"/base/send?id=hello","origin":"A"},
                {"base":"/base/file?old=1","ref":"?rev=2","path":"/base/file?rev=2&id=hello","origin":"A"},
                {"base":"/base/file?old=1","ref":"","path":"/base/file?id=hello","origin":"A"},
                {"base":"/base/","ref":"//127.0.0.1:"+b.getListenerInfo(0).port+"/send","path":"/send?id=hello","origin":"B"},
                {"base":"/base/","ref":"/send#help","path":"/send?id=hello","origin":"A"},
                {"base":"/base/","ref":"/send#help?text","path":"/send?id=hello","origin":"A"},
                {"base":"/base/","ref":"/send?fixed=1#help","path":"/send?fixed=1&id=hello","origin":"A"},
                {"base":"/base/","ref":"/%2e/enc%2Fpart","path":"/%2e/enc%2Fpart?id=hello","origin":"A"}) {
            WebService initial(contract(origin+row.base,row.ref));
            foreach WebService ws in (initial, Serializable::deserialize(initial.serialize()),
                    Serializable::deserialize(initial.serializeToData())) {
                SoapClientIo client({"wsdl":ws,"timeout":10000,"http_protocol":"h1"}); on_exit client.close();
                string before=client.getUrl();
                hash<auto> info;
                assertEq({"result":row.origin},client.callOperation("send",{"id":"hello"},NOTHING,\info));
                hash<auto> request=received.get(10000);
                assertEq(row.path,request.path);
                assertEq(row.origin,request.origin);
                assertEq((row.origin=="A" ? origin : endpoint(b))+row.path, info."effective-url");
                assertEq(before,client.getUrl());
                assertEq(origin+row.base,client.getUrl());
            }
        }
    }
    private headers() {
        Queue received();
        HttpServer a=server("A",received); on_exit a.stop();
        HttpServer b=server("B",received); on_exit b.stop();
        foreach bool cross in (False,True) {
            string location="//127.0.0.1:"+(cross ? b : a).getListenerInfo(0).port+"/headers";
            WebService ws(contract(endpoint(a)+"/base/",location));
            hash<auto> defaults={"aUtHoRiZaTiOn":"Bearer base-fixture", "cOoKiE":"base=1", "hOsT":"base.example", "X-Default":"kept"};
            SoapClientIo client({"wsdl":ws,"headers":defaults,"timeout":10000,"http_protocol":"h1"}); on_exit client.close();
            string before=client.getUrl();
            foreach bool explicit_headers in (False,True) {
                hash<auto> opts=explicit_headers ? {"http_header":{"Authorization":"Bearer target-fixture","Cookie":"target=1","Host":"target.example"}} : {};
                auto response=client.callOperation("send",{"id":"value"},opts);
                hash<auto> request=received.get(10000);
                assertEq("kept",request.headers."x-default");
                assertEq(explicit_headers ? "Bearer target-fixture" : cross ? NOTHING : "Bearer base-fixture", request.headers.authorization);
                assertEq(explicit_headers ? "target=1" : cross ? NOTHING : "base=1", request.headers.cookie);
                assertEq(explicit_headers ? "target.example" : cross ? "127.0.0.1:"+b.getListenerInfo(0).port : "base.example", request.headers.host);
                assertEq(before,client.getUrl());
            }
        }
    }
    private replacement() {
        Queue received(); HttpServer a=server("A",received); on_exit a.stop();
        WebService ws(contract(endpoint(a)+"/base/dir/", "../items/(id)?fixed=1", "GET", "<h:urlReplacement/>"));
        SoapClientIo client({"wsdl":ws,"timeout":10000,"http_protocol":"h1"}); on_exit client.close();
        auto response=client.callOperation("send",{"id":"A/B ?#č"});
        assertEq({"result":"A"},response);
        assertEq("/base/items/A%2FB%20%3F%23%C4%8D?fixed=1",received.get(10000).path);
    }
    private post() {
        Queue received(); HttpServer a=server("A",received); on_exit a.stop();
        HttpServer b=server("B",received); on_exit b.stop();
        WebService ws(contract(endpoint(a)+"/wrong/", "send", "POST"));
        SoapClientIo client({"wsdl":ws,"url":endpoint(b)+"/selected/file","timeout":10000,"http_protocol":"h1"}); on_exit client.close();
        assertEq({"result":"B"},client.callOperation("send",{"id":"A & č"}));
        hash<auto> request=received.get(10000);
        assertEq("/selected/send",request.path);
        assertEq("B",request.origin);
        assertEq("id=A%20%26%20%C4%8D",binary_to_string(binary(request.body)));
        assertEq(endpoint(b)+"/selected/file",client.getUrl());
    }
    private empty() {
        Queue received(); HttpServer a=server("A",received); on_exit a.stop();
        foreach hash<string,string> row in (
                {"ref":"","path":"/base/file?old=1"},
                {"ref":"?","path":"/base/file?"},
                {"ref":"?new=2","path":"/base/file?new=2"},
                {"ref":"#top","path":"/base/file?old=1"},
                {"ref":"?new=2#top","path":"/base/file?new=2"}) {
            string xml=replace(contract(endpoint(a)+"/base/file?old=1",row.ref),
                '<w:part name="id" type="x:string"/>',"");
            WebService ws(xml);
            SoapClientIo client({"wsdl":ws,"timeout":10000,"http_protocol":"h1"}); on_exit client.close();
            assertEq({"result":"A"},client.callOperation("send",{}));
            assertEq(row.path,received.get(10000).path);
        }
    }
    private concurrent() {
        Queue received(); HttpServer a=server("A",received); on_exit a.stop();
        HttpServer b=server("B",received); on_exit b.stop();
        string xml=contract(endpoint(a)+"/base/", "send");
        xml=replace(xml,"</w:portType>",'<w:operation name="other"><w:input message="t:Input"/>'
            +'<w:output message="t:Output"/></w:operation></w:portType>');
        xml=replace(xml,"</w:binding>",'<w:operation name="other"><h:operation location="//127.0.0.1:'
            +b.getListenerInfo(0).port+'/other"/><w:input><h:urlEncoded/></w:input>'
            +'<w:output><m:mimeXml part="result"/></w:output></w:operation></w:binding>');
        WebService ws(xml);
        SoapClientIo client({"wsdl":ws,"timeout":10000,"http_protocol":"h1","headers":{"Authorization":"Bearer base-fixture"}}); on_exit client.close();
        string before=client.getUrl();
        Queue ready(); Queue start(); Queue done();
        foreach int worker in (0,1,2,3) {
            background sub(int id) {
                ready.push(id);
                auto token=start.get(10000);
                try {
                    for (int step=0;step<5;++step) {
                        string operation=(id+step)%2 ? "other" : "send";
                        auto result=client.callOperation(operation,{"id":string(id)+"-"+step});
                        @assert(result.result==(operation=="send" ? "A" : "B"));
                    }
                    done.push(id);
                } catch (hash<ExceptionInfo> error) { done.push(error); }
            }(worker);
        }
        for (int worker=0;worker<4;++worker) { auto token=ready.get(10000); }
        for (int worker=0;worker<4;++worker) { start.push(True); }
        list<int> finished();
        for (int worker=0;worker<4;++worker) { push finished,done.get(30000); }
        assertEq((0,1,2,3),sort(finished));
        assertEq(before,client.getUrl());
        hash<string,int> counts();
        for (int step=0;step<20;++step) {
            hash<auto> request=received.get(10000);
            ++counts{request.origin};
            assertEq(request.origin=="A" ? "Bearer base-fixture" : NOTHING,request.headers.authorization);
            assertTrue(request.path.startsWith(request.origin=="A" ? "/base/send?" : "/other?"));
        }
        assertEq({"A":10,"B":10},counts);
    }
    private userinfo() {
        Queue received(); HttpServer a=server("A",received); on_exit a.stop();
        HttpServer b=server("B",received); on_exit b.stop();
        foreach bool cross in (False,True) {
        foreach bool url_credentials in (False,True) {
            string location="//ignored:fixture@127.0.0.1:"+(cross ? b : a).getListenerInfo(0).port+"/target";
            string base=endpoint(a)+"/base/";
            if (url_credentials) { base=replace(base,"http://","http://url-user:url-fixture@"); }
            WebService ws(contract(base,location));
            SoapClientIo client({"wsdl":ws,"timeout":10000,"http_protocol":"h1","username":"base-user","password":"base-fixture"}); on_exit client.close();
            auto result=client.callOperation("send",{"id":"x"});
            hash<auto> request=received.get(10000);
            assertEq(cross ? NOTHING : "Basic "+make_base64_string("base-user:base-fixture"),request.headers.authorization);
            assertEq(cross ? "B" : "A",result.result);
        }
        }
    }
    private soapEndpoints() {
        Queue received();
        HttpServer a=server("A",received,True,True); on_exit a.stop();
        HttpServer b=server("B",received,True,True); on_exit b.stop();
        string origin=replace(endpoint(a),"http:","https:");
        string other=replace(endpoint(b),"http:","https:");
        string source=ReadOnlyFile::readTextFile(get_script_dir()+"/wsdl-interop/soap-envelope-peer/contract.wsdl");
        WebService ws(source);
        foreach string protocol in ("h1","h2","h3") {
            SoapClientIo client({"wsdl":ws,"port":"Port12", "url":origin+"/base/file/?old=%2F#help",
                "http_protocol":protocol,"accept_all_certs":True,"timeout":10000,
                "headers":{"Authorization":"Bearer base-fixture","Cookie":"base=1"}});
            on_exit client.close();
            hash<auto> info;
            assertEq("A",client.callOperation("echo",{"body":"invoice-71"},NOTHING,\info));
            hash<auto> request=received.get(10000);
            assertEq("/base/file/?old=%2F",request.path);
            assertEq("POST",request.method);
            assertEq(protocol,request.protocol);
            assertEq(origin+"/base/file/?old=%2F",info."effective-url");
            foreach hash<auto> row in (
                    {"ref":"/resource","path":"/resource"},
                    {"ref":"../resource","path":"/base/resource"},
                    {"ref":"?rev=2","path":"/base/file/?rev=2"},
                    {"ref":"","path":"/base/file/?old=%2F"},
                    {"ref":"#top","path":"/base/file/?old=%2F"},
                    {"ref":"?","path":"/base/file/?"},
                    {"ref":other+"/resource?x=%2F#top","path":"/resource?x=%2F","cross":True},
                    {"ref":replace(other,"https:","")+"/resource","path":"/resource","cross":True},
                    {"ref":replace(other,"https://","https://ignored:fixture@")+"/resource",
                        "path":"/resource","cross":True}) {
                assertEq(row.cross ? "B" : "A",client.getSoapResponse("echo",row.ref,NOTHING,\info));
                request=received.get(10000);
                assertEq(row.path,request.path);
                assertEq("GET",request.method);
                assertEq(protocol,request.protocol);
                assertFalse(request.body.val());
                assertEq(row.cross ? NOTHING : "Bearer base-fixture",request.headers.authorization);
                assertEq(row.cross ? NOTHING : "base=1",request.headers.cookie);
                assertEq((row.cross ? other : origin)+row.path,info."effective-url");
                assertEq(origin+"/base/file/?old=%2F",client.getUrl());
            }
            assertThrows("WSDL-ERROR", "must be a relative URI", sub () {
                new WebService(contract(origin+"/base/",other+"/send"));
            });
        }
    }
}
