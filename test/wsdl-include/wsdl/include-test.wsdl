<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:xs="http://www.w3.org/2001/XMLSchema"
             xmlns:tns="urn:qore:test:main"
             xmlns:sub="urn:qore:test:sub"
             targetNamespace="urn:qore:test:main">
    <types>
        <xs:schema targetNamespace="urn:qore:test:main"
                   xmlns="urn:qore:test:main"
                   xmlns:sub="urn:qore:test:sub"
                   elementFormDefault="qualified">
            <xs:import namespace="urn:qore:test:sub" schemaLocation="../schemas/include-test.xsd"/>

            <xs:element name="Create">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element ref="sub:createUser"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>

            <xs:element name="CreateResponse">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element ref="sub:userId"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:schema>
    </types>

    <message name="CreateRequest">
        <part name="parameters" element="tns:Create"/>
    </message>
    <message name="CreateResponse">
        <part name="parameters" element="tns:CreateResponse"/>
    </message>

    <portType name="IncludeTestPort">
        <operation name="Create">
            <input message="tns:CreateRequest"/>
            <output message="tns:CreateResponse"/>
        </operation>
    </portType>

    <binding name="IncludeTestBinding" type="tns:IncludeTestPort">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <operation name="Create">
            <soap:operation soapAction="Create" style="document"/>
            <input>
                <soap:body use="literal"/>
            </input>
            <output>
                <soap:body use="literal"/>
            </output>
        </operation>
    </binding>

    <service name="IncludeTestService">
        <port name="IncludeTestPort" binding="tns:IncludeTestBinding">
            <soap:address location="http://localhost:8080/include-test"/>
        </port>
    </service>
</definitions>
