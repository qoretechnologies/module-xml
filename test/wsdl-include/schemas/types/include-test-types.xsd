<?xml version="1.0" encoding="UTF-8"?>
<!-- included by ../include-test.xsd with a location relative to that file -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="urn:qore:test:sub"
           targetNamespace="urn:qore:test:sub"
           elementFormDefault="qualified">
    <!-- restriction on a base type declared later in the same schema -->
    <xs:simpleType name="idType">
        <xs:restriction base="baseStringType"/>
    </xs:simpleType>

    <xs:simpleType name="baseStringType">
        <xs:restriction base="xs:string">
            <xs:maxLength value="32"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- union with more than one anonymous simpleType member definition -->
    <xs:simpleType name="statusType">
        <xs:union>
            <xs:simpleType>
                <xs:restriction base="xs:string">
                    <xs:enumeration value="ERASE"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:simpleType>
                <xs:restriction base="xs:int"/>
            </xs:simpleType>
        </xs:union>
    </xs:simpleType>
</xs:schema>
