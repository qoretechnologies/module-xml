<?xml version="1.0" encoding="UTF-8"?>
<!-- imported by ../wsdl/include-test.wsdl with a location relative to that file -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="urn:qore:test:sub"
           targetNamespace="urn:qore:test:sub"
           elementFormDefault="qualified">
    <xs:include schemaLocation="types/include-test-types.xsd"/>

    <xs:element name="userId" type="idType"/>

    <!-- element declaration with no type information at all: implicitly "xs:anyType" -->
    <xs:element name="extra" nillable="true"/>

    <xs:element name="createUser">
        <xs:complexType>
            <xs:sequence>
                <!-- element references without a namespace prefix -->
                <xs:element ref="userId"/>
                <xs:element name="status" type="statusType"/>
                <xs:element ref="extra" minOccurs="0"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>
