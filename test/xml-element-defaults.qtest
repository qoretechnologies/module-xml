#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "Element default tests require the json module";
%else
%exec-class XmlElementDefaultsTest

class XmlElementDefaultsTest inherits QUnit::Test {
    constructor() : Test("Native element defaults and QName identity", "1.0") {
        addTestCase("Canonical actual-type defaults preserve the input XML", \defaults());
        addTestCase("Declaration namespaces and selected types determine identity", \identity());
        set_return_value(main());
    }
    private static bool consume(string schema, string xml) {
        XmlReader reader(new StringInputStream(xml), {"xsd": schema});
        int roots = 0;
        while (reader.read()) {
            if (reader.nodeType() == XML_NODE_TYPE_ELEMENT && !reader.depth()) {
                ++roots;
            }
        }
        return roots == 1 && reader.isValid();
    }
    private defaults() {
        check(True, 200);
    }
    private identity() {
        check(False, 63);
    }
    private check(bool scalar, int expected_count) {
        list<hash<auto>> models = parse_json(ReadOnlyFile::readTextFile(
            get_script_dir() + "/wsdl-interop/fixtures/element-defaults.json"));
        int count = 0;
        foreach hash<auto> model in (models) {
            if (model.wsdl != scalar) {
                continue;
            }
            foreach hash<auto> row in (model.documents) {
                ++count;
                XmlDoc document(row.xml);
                string before = document.toString();
                if (row.expected) {
                    assertTrue(consume(model.schema, row.xml), row.name);
                    assertEq(parse_xml(row.xml), parse_xml_with_schema(row.xml, model.schema), row.name);
                    document.validateSchema(model.schema);
                    document.validateSchema(model.schema);
                } else {
                    assertThrows("PARSE-XML-EXCEPTION", \consume(), (model.schema, row.xml));
                    assertThrows("PARSE-XML-EXCEPTION", \parse_xml_with_schema(), (row.xml, model.schema));
                    assertThrows("XSD-ERROR", \document.validateSchema(), (model.schema,));
                }
                assertEq(before, document.toString(), row.name);
            }
        }
        assertEq(expected_count, count);
    }
}
%endif
