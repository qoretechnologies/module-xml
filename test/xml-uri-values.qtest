#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%exec-class XmlUriValuesTest

class XmlUriValuesTest inherits QUnit::Test {
    constructor() : Test("XSD URI lexical values", "1.0") {
        addTestCase("Normalization retains URI identity and accepts relative and Unicode references", \valid());
        addTestCase("Invalid syntax and XML characters reject without prefix truncation", \invalid());
        addTestCase("Cancellation propagates and later normalization succeeds", \cancellation());
        set_return_value(main());
    }
    private valid() {
        foreach hash<string, string> row in (
                {"input": "", "expected": ""},
                {"input": " \t\r\n", "expected": ""},
                {"input": "  ../manuals/product\t guide.xml\r\n", "expected": "../manuals/product guide.xml"},
                {"input": "https://example.invalid/café/中文", "expected": "https://example.invalid/café/中文"},
                {"input": "a%2Fb?x=%2525#part", "expected": "a%2Fb?x=%2525#part"},
                {"input": "http://[::1]/", "expected": "http://[::1]/"},
                {"input": "urn:catalog:product", "expected": "urn:catalog:product"},
                {"input": "a b", "expected": "a b"},
                {"input": "../<>\"{}|\\^`'", "expected": "../<>\"{}|\\^`'"}) {
            assertEq(row.expected, normalize_xsd_uri(row.input));
        }
        string latin = "café".toString("ISO-8859-1");
        assertEq("café", normalize_xsd_uri(latin));
        assertEq("café", normalize_xsd_uri("café".toString("UTF-16LE")));
        string long_uri = "../" + "segment/" * 1024 + "end";
        assertEq(long_uri, normalize_xsd_uri(long_uri));
    }
    private invalid() {
        assertThrows("INVALID-ENCODING", \normalize_xsd_uri(), (chr(255),));
        foreach string value in ("http://[bad", "%", "%x1", "%1x", "http://a/%xx", "http://[::1",
                "a\x00tail", "\x01", "a\x0bb", <efbfbf>.toString("UTF-8")) {
            assertThrows("XSD-URI-LEXICAL-ERROR", \normalize_xsd_uri(), (value,));
            assertEq("../valid", normalize_xsd_uri("../valid"));
        }
    }
    private cancellation() {
        SandboxManager manager();
        on_exit manager.clearInterrupt();
        Program program(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
        program.setSandboxManager(manager);
        program.parse("%modern\n%requires xml\n"
            + "string sub uri(SandboxManager manager, bool cancel) {\n"
            + "    if (cancel) { manager.requestInterrupt(); }\n"
            + "    return normalize_xsd_uri(\"../manual\");\n}\n", "uri-test");
        assertThrows("PROGRAM-INTERRUPTED", \program.callFunction(), ("uri", manager, True));
        manager.clearInterrupt();
        assertEq("../manual", program.callFunction("uri", manager, False));
    }
}
