#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%requires ../qlib/SoapClient.qm
%requires ../qlib/SoapHandler.qm
%requires HttpServer
%exec-class QNameConsumersTest

class QNameConsumerCallback {
    public {
        Queue requests();
        Queue responses();
    }

    hash<auto> call(hash<auto> cx, hash<auto> request) {
        requests.push(request);
        return responses.pop(30000);
    }
}

class QNameConsumersTest inherits QUnit::Test {
    constructor() : Test("QName lexical SOAP consumers", "1.0") {
        addTestCase("Actual SOAP bindings validate QName lexical values over HTTP", \httpValues());
        addTestCase("QName identities and scoped union fallback survive real HTTP consumers", \httpScopedValues());
        set_return_value(main());
    }

    private WebService service(string version) {
        return new WebService('<w:definitions xmlns:w="http://schemas.xmlsoap.org/wsdl/"
            xmlns:t="urn:qname-consumers" xmlns:s="http://schemas.xmlsoap.org/wsdl/soap'
            + (version == "12" ? "12" : "") + '/" targetNamespace="urn:qname-consumers"><w:types>
            <xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:qname-consumers">
            <xs:simpleType name="Items"><xs:list itemType="xs:QName"/></xs:simpleType>
            <xs:simpleType name="Either"><xs:union memberTypes="xs:QName xs:string"/></xs:simpleType>
            <xs:simpleType name="Named"><xs:restriction base="xs:QName"><xs:pattern value="[A-Z][a-z]+"/>
            <xs:length value="0"/></xs:restriction></xs:simpleType>
            <xs:complexType name="Record"><xs:sequence>
            <xs:element name="name" type="xs:QName"/><xs:element name="pattern" type="t:Named"/>
            <xs:element name="items" type="t:Items"/><xs:element name="either" type="t:Either"/>
            </xs:sequence><xs:attribute name="tag" type="xs:QName" use="required"/>
            </xs:complexType><xs:element name="Submit" type="t:Record"/><xs:element name="Reply" type="t:Record"/>
            </xs:schema></w:types><w:message name="In"><w:part name="body" element="t:Submit"/></w:message>
            <w:message name="Out"><w:part name="body" element="t:Reply"/></w:message>
            <w:portType name="Port"><w:operation name="submit"><w:input message="t:In"/>
            <w:output message="t:Out"/></w:operation></w:portType><w:binding name="Soap" type="t:Port">
            <s:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
            <w:operation name="submit"><s:operation soapAction="urn:submit"/><w:input><s:body use="literal"/>
            </w:input><w:output><s:body use="literal"/></w:output></w:operation></w:binding>
            <w:service name="Service"><w:port name="Port" binding="t:Soap"><s:address location="http://example.invalid/"/>
            </w:port></w:service></w:definitions>', {"async_only": True});
    }

    private hash<auto> record(bool response) {
        return {"name": response ? " xml:lang " : " 中文 ", "pattern": response ? " Response " : " Request ",
            "items": ("Name", "xml:space"), "either": response ? " a:b:c " : "Name",
            "^attributes^": {"tag": response ? " xml:lang " : " _name "}};
    }

    private check(hash<auto> actual, bool response) {
        assertEq({"name": response ? "xml:lang" : "中文", "pattern": response ? "Response" : "Request",
            "items": ("Name", "xml:space"), "either": response ? " a:b:c " : "Name",
            "^attributes^": {"tag": response ? "xml:lang" : "_name"}}, actual);
    }

    private httpValues() {
        foreach string version in ("11", "12") {
            WebService original = service(version);
            foreach WebService ws in (original, Serializable::deserialize(original.serialize())) {
                HttpServer server();
                on_exit server.stop();
                SoapHandler handler(new PermissiveAuthenticator());
                server.setDefaultHandler("soap", handler);
                QNameConsumerCallback callback();
                handler.addMethod(ws, ws.getBindingOperation("Soap", "submit"), \callback.call(), NOTHING,
                    NOTHING, NOTHING, "Service", NOTHING, NOTHING, "Soap");
                server.addListener(0);
                string url = sprintf("http://127.0.0.1:%d/Service", server.getListenerInfo(0).port);
                SoapClient client({"wsdl": ws, "url": url, "timeout": 30000, "connect_timeout": 30000});
                callback.responses.push(record(True));
                check(client.callOperation("submit", record(False)), True);
                check(callback.requests.pop(30000), False);
                hash<auto> invalid = record(False);
                invalid.name = "a:b:c";
                assertThrows("SOAP-SERIALIZATION-ERROR", \client.callOperation(), ("submit", invalid));
                invalid = record(False);
                invalid."^attributes^" = {"tag": "0name"};
                assertThrows("SOAP-SERIALIZATION-ERROR", \client.callOperation(), ("submit", invalid));
                invalid = record(False);
                invalid.pattern = "invalid";
                assertThrows("SOAP-SERIALIZATION-ERROR", \client.callOperation(), ("submit", invalid));
                callback.responses.push(record(True));
                check(client.callOperation("submit", record(False)), True);
                check(callback.requests.pop(30000), False);
            }
        }
    }

    private hash<auto> scopedRecord(bool response) {
        string suffix = response ? "Response" : "Request";
        list<auto> items();
        push items, new XsdQNameValue("urn:item", "a:Item");
        push items, new XsdQNameValue("", "Local");
        push items, new XsdQNameValue("http://www.w3.org/XML/1998/namespace", "xml:lang");
        return {"name": new XsdQNameValue("urn:" + suffix, "ns:" + suffix), "pattern": suffix,
            "items": items, "either": new XsdScopedLexicalValue("ns:" + suffix, {}),
            "^attributes^": {"tag": new XsdQNameValue("urn:tag", "a:Tag")}};
    }

    private checkScoped(hash<auto> actual, bool response) {
        string suffix = response ? "Response" : "Request";
        assertTrue(actual.name instanceof XsdQNameValue);
        assertEq("urn:" + suffix, actual.name.getNamespaceUri());
        assertEq(suffix, actual.name.getLocalName());
        assertEq(suffix, actual.pattern);
        assertEq(3, actual.items.size());
        assertTrue(actual.items[0].equals(new XsdQNameValue("urn:item", "a:Item")));
        assertEq("Local", actual.items[1]);
        assertEq("xml:lang", actual.items[2]);
        assertTrue(actual.either instanceof XsdScopedLexicalValue);
        assertEq("ns:" + suffix, actual.either.getLexicalValue());
        assertFalse(actual.either.getNamespaceBindings().hasKey("ns"));
        assertTrue(actual."^attributes^".tag.equals(new XsdQNameValue("urn:tag", "alias:Tag")));
    }

    private httpScopedValues() {
        foreach string version in ("11", "12") {
            WebService original = service(version);
            foreach WebService ws in (original, Serializable::deserialize(original.serialize())) {
                HttpServer server();
                on_exit server.stop();
                SoapHandler handler(new PermissiveAuthenticator());
                server.setDefaultHandler("soap", handler);
                QNameConsumerCallback callback();
                handler.addMethod(ws, ws.getBindingOperation("Soap", "submit"), \callback.call(), NOTHING,
                    NOTHING, NOTHING, "Service", NOTHING, NOTHING, "Soap");
                server.addListener(0);
                string url = sprintf("http://127.0.0.1:%d/Service", server.getListenerInfo(0).port);
                SoapClient client({"wsdl": ws, "url": url, "timeout": 30000, "connect_timeout": 30000});
                for (int attempt = 0; attempt < 2; ++attempt) {
                    callback.responses.push(scopedRecord(True));
                    checkScoped(client.callOperation("submit", scopedRecord(False)), True);
                    checkScoped(callback.requests.pop(30000), False);
                    hash<auto> invalid = scopedRecord(False);
                    invalid.name = "unbound:Name";
                    assertThrows("SOAP-SERIALIZATION-ERROR", \client.callOperation(), ("submit", invalid));
                }
            }
        }
    }
}
