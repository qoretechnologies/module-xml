#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%exec-class XmlSchemaCallbackTest

class SchemaCallback inherits AbstractXmlIoInputCallback {
    private {
        bool fail;
        string schema;
    }
    public {
        int calls = 0;
    }

    constructor(bool fail, string schema) {
        self.fail = fail;
        self.schema = schema;
    }

    *InputStream open(string location) {
        ++calls;
        if (fail) {
            throw "SCHEMA-IMPORT-FAILED", "Import failed: " + location;
        }
        return new StringInputStream(schema);
    }
}

class XmlSchemaCallbackTest inherits QUnit::Test {
    const Schema = '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:types">'
        '<xs:import namespace="urn:types" schemaLocation="types.xsd"/>'
        '<xs:element name="value" type="t:Count"/></xs:schema>';
    const Types = '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:types">'
        '<xs:simpleType name="Count"><xs:restriction base="xs:int"/></xs:simpleType></xs:schema>';

    constructor() : QUnit::Test("Schema callback exception ownership", "1.0") {
        addTestCase("Successful imported schema validates the document", \validImport());
        addTestCase("Original import exception survives parser cleanup", \failedImport());
        addTestCase("Invalid imported schema reports a schema error", \invalidSchema());
        addTestCase("Invalid document reports a validation error", \invalidDocument());
        set_return_value(main());
    }

    readDocument(string xml, SchemaCallback provider) {
        XmlReader reader(new StringInputStream(xml), {"xsd": Schema, "xml_input_io": provider});
        while (reader.read()) {
        }
    }

    validImport() {
        SchemaCallback provider(False, Types);
        readDocument("<value>42</value>", provider);
        assertTrue(provider.calls > 0);
    }

    failedImport() {
        SchemaCallback provider(True, Types);
        assertThrows("SCHEMA-IMPORT-FAILED", "Import failed: types.xsd", \readDocument(),
            ("<value>42</value>", provider));
        assertTrue(provider.calls > 0);
        validImport();
    }

    invalidSchema() {
        SchemaCallback provider(False, replace(Types, "xs:int", "xs:missing"));
        assertThrows("XSD-SYNTAX-ERROR", \readDocument(), ("<value>42</value>", provider));
        assertTrue(provider.calls > 0);
        validImport();
    }

    invalidDocument() {
        SchemaCallback provider(False, Types);
        assertThrows("PARSE-XML-EXCEPTION", \readDocument(), ("<value>wrong</value>", provider));
        assertTrue(provider.calls > 0);
        validImport();
    }
}
