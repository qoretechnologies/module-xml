#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%requires ../qlib/SoapClient.qm
%requires ../qlib/SoapHandler.qm
%requires HttpServer
%exec-class NativeTypeValuesTest

class CancelNativeTypeValue inherits XsdBaseType {
    constructor() : XsdBaseType("string", new Namespaces({})) {
    }
    auto deserializeValue(string name, hash<string, XsdAbstractType> types, *hash<auto> refs, auto value) {
        throw "THREAD-CANCELLED", "native conversion cancelled";
    }
}

class NativeTypeValuesTest inherits QUnit::Test {
    private {
        const Ns = "urn:qore:native-type-values";
        const Definitions = '<xs:complexType name="A"><xs:sequence><xs:element name="number" type="xs:int"/>'
            '</xs:sequence></xs:complexType><xs:complexType name="B"><xs:complexContent><xs:extension base="t:A">'
            '<xs:sequence><xs:element name="description" type="xs:string"/></xs:sequence>'
            '</xs:extension></xs:complexContent></xs:complexType>';
        const Data = {"number": 17, "description": "Replacement part"};
        const Content = '<number>17</number><description>Replacement part</description>';
    }
    constructor() : Test("Portable native type values", "1.0") {
        addTestCase("Explicit retention keeps the established default projection", \projection());
        addTestCase("Saved values resolve selected names against reconstructed schemas", \copies());
        addTestCase("Output repeats derivation and selected content checks", \receiverChecks());
        addTestCase("Scalar and list selections keep their native values", \simpleValues());
        addTestCase("Type and data QNames keep independent namespaces", \qnames());
        addTestCase("Repeated fields retain each occurrence's selected type", \occurrences());
        addTestCase("Nilled selected types retain their annotation", \nilValues());
        addTestCase("Portable wrappers reject malformed and ambiguous shapes", \malformed());
        addTestCase("Native type wrappers cannot select attribute or simple-content text types", \scalarContexts());
        addTestCase("Low-level output maps and capture choices restore after errors", \scopes());
        addTestCase("Document parts retain a selected root type in both SOAP bindings", \documentParts());
        addTestCase("RPC type parts retain their selected simple types in both bindings", \rpcParts());
        addTestCase("HTTP clients and handlers explicitly retain portable native types", \httpValues());
        addTestCase("Unqualified selected names survive portable reconstruction", \unqualified());
        addTestCase("Cancellation restores capture state and custom builtins keep their identity", \cancellation());
        addTestCase("Selected root and header types retain their message boundaries", \headers());
        addTestCase("Concurrent consumers keep separate capture and output state", \concurrency());
        set_return_value(main());
    }
    private string source(string definitions = Definitions, string type = "t:A", string controls = "") {
        return '<xs:schema xmlns:xs="' + XSD_NS + '" xmlns:t="' + Ns + '" targetNamespace="' + Ns + '">'
            + definitions + '<xs:element name="value" type="' + type + '" ' + controls + '/></xs:schema>';
    }
    private XsdSchema schema(string definitions = Definitions, string type = "t:A", string controls = "") {
        return new XsdSchema(source(definitions, type, controls), {"async_only":True});
    }
    private WebService service(bool rpc, string version, bool headers = False) {
        string soap = version == "12" ? "http://schemas.xmlsoap.org/wsdl/soap12/" : "http://schemas.xmlsoap.org/wsdl/soap/";
        string part = rpc ? 'type="xs:decimal"' : 'element="t:value"';
        string binding = "Soap" + version;
        return new WebService('<w:definitions xmlns:w="http://schemas.xmlsoap.org/wsdl/" xmlns:s="' + soap
            + '" xmlns:t="' + Ns + '" xmlns:xs="' + XSD_NS + '" targetNamespace="' + Ns + '">'
            + '<w:types>' + source(Definitions + '<xs:simpleType name="I"><xs:restriction base="xs:int"/></xs:simpleType><xs:element name="Context" type="xs:decimal"/>')
            + '</w:types><w:message name="Input"><w:part name="body" ' + part + '/></w:message>'
            + '<w:message name="Output"><w:part name="body" ' + part + '/></w:message>'
            + '<w:message name="HeaderIn"><w:part name="context" element="t:Context"/></w:message>'
            + '<w:message name="HeaderOut"><w:part name="context" element="t:Context"/></w:message>'
            + '<w:portType name="Port"><w:operation name="submit"><w:input message="t:Input"/>'
            + '<w:output message="t:Output"/></w:operation></w:portType>'
            + '<w:binding name="' + binding + '" type="t:Port"><s:binding style="' + (rpc ? "rpc" : "document")
            + '" transport="http://schemas.xmlsoap.org/soap/http"/><w:operation name="submit"><s:operation soapAction="urn:submit"/>'
            + '<w:input><s:body use="literal" namespace="' + Ns + '"/>' + (headers ? '<s:header message="t:HeaderIn" part="context" use="literal"/>' : '') + '</w:input>'
            + '<w:output><s:body use="literal" namespace="' + Ns + '"/>' + (headers ? '<s:header message="t:HeaderOut" part="context" use="literal"/>' : '') + '</w:output></w:operation></w:binding>'
            + '<w:service name="Service"><w:port name="Port" binding="t:' + binding
            + '"><s:address location="http://example.invalid/soap"/></w:port></w:service></w:definitions>', {"async_only":True});
    }
    private string wire(string selected = "t:B", string content = Content, string attributes = "") {
        return '<t:value xmlns:t="' + Ns + '" xmlns:xs="' + XSD_NS + '" xmlns:i="' + XSI_NS + '" i:type="'
            + selected + '" ' + attributes + '>' + content + '</t:value>';
    }
    private auto decode(XsdSchema schema, string xml, *bool preserve) {
        auto expanded = XsdBase::expandElementNamespaces(parse_xml(xml, XPF_PRESERVE_ORDER));
        return schema.getElement(Ns, "value").deserializeValue(schema.getTypeMap(), NOTHING,
            expanded{"{" + Ns + "}value"}, True, preserve);
    }
    private auto saved(auto value) {
        return Serializable::deserialize(Serializable::serialize(value));
    }
    private checkType(hash<auto> value, string namespace_uri, string local, auto expected) {
        assertTrue(value."^type^" instanceof XsdQNameValue);
        assertEq(namespace_uri, value."^type^".getNamespaceUri());
        assertEq(local, value."^type^".getLocalName());
        assertEq(expected, value."^val^");
        assertEq(2, value.size());
    }
    private string emit(XsdSchema schema, auto value) {
        return schema.serializeXmlValue(Ns, "value", value).getXml();
    }
    projection() {
        XsdSchema s = schema();
        assertEq(Data, decode(s, wire(), False));
        auto typed = decode(s, wire(), True);
        checkType(typed, Ns, "B", Data);
        assertEq(Data, decode(s, emit(s, typed), False));
        assertEq(Data, decode(s, wire(), NOTHING));
        assertEq({"number":17}, decode(s, wire("t:A", '<number>17</number>'), True));
        assertThrows("SOAP-SERIALIZATION-ERROR", sub() { emit(s, decode(s, wire(), False)); });
    }
    copies() {
        XsdSchema original = schema();
        auto value = saved(decode(original, wire(), True));
        XsdSchema other = saved(original);
        checkType(decode(other, emit(other, value), True), Ns, "B", Data);
        checkType(decode(original, emit(original, value), True), Ns, "B", Data);
        auto modified = value;
        modified."^val^".description = "Updated part";
        assertEq("Replacement part", value."^val^".description);
        assertEq("Updated part", decode(other, emit(other, modified), True)."^val^".description);
    }
    receiverChecks() {
        XsdSchema original = schema();
        auto value = decode(original, wire(), True);
        string definitions = Definitions;
        definitions =~ s/base="t:A"/base="xs:anyType"/;
        # Keep the old malformed fixture as a schema rejection. The receiver
        # check below requires a valid, independently unrelated base type.
        assertThrows("WSDL-ERROR", \schema(), (definitions,));
        XmlDoc document(wire("t:A", '<number>17</number>'));
        assertThrows("XSD-SYNTAX-ERROR", \document.validateSchema(), (source(definitions),));
        definitions = Definitions + '<xs:complexType name="Unrelated"/>';
        definitions =~ s/base="t:A"/base="t:Unrelated"/;
        document.validateSchema(source(definitions));
        XsdSchema unrelated = schema(definitions);
        assertThrows("SOAP-SERIALIZATION-ERROR", sub() { emit(unrelated, value); });
        definitions = Definitions;
        definitions =~ s/name="description" type="xs:string"/name="description" type="xs:int"/;
        XsdSchema changed = schema(definitions);
        assertThrows("SOAP-SERIALIZATION-ERROR", sub() { emit(changed, value); });
        XsdSchema blocked = schema(Definitions, "t:A", 'block="extension"');
        assertThrows("SOAP-SERIALIZATION-ERROR", sub() { emit(blocked, value); });
        value."^type^" = new XsdQNameValue("urn:unrelated", "B");
        assertThrows("SOAP-SERIALIZATION-ERROR", sub() { emit(original, value); });
    }
    simpleValues() {
        string definitions = '<xs:simpleType name="I"><xs:restriction base="xs:int"><xs:minInclusive value="0"/>'
            '</xs:restriction></xs:simpleType><xs:simpleType name="L"><xs:list itemType="xs:int"/></xs:simpleType>'
            '<xs:simpleType name="U"><xs:union memberTypes="xs:int xs:boolean"/></xs:simpleType>';
        foreach list<auto> row in (("xs:decimal", "t:I", "17", 17, Ns, "I"),
                ("xs:integer", "xs:short", "17", 17, XSD_NS, "short"),
                ("xs:anySimpleType", "t:L", "17 18", (17,18), Ns, "L"),
                ("xs:anyType", "t:U", "true", True, Ns, "U")) {
            XsdSchema s = schema(definitions, row[0]);
            auto value = saved(decode(s, wire(row[1], row[2]), True));
            checkType(value, row[4], row[5], row[3]);
            checkType(decode(s, emit(s, value), True), row[4], row[5], row[3]);
        }
        XsdSchema s = schema(definitions, "xs:decimal");
        auto value = decode(s, wire("t:I", "17"), True);
        value."^val^" = -1;
        assertThrows("SOAP-SERIALIZATION-ERROR", sub() { emit(s, value); });
    }
    qnames() {
        XsdSchema s = schema('<xs:simpleType name="Q"><xs:restriction base="xs:QName"/></xs:simpleType>', "xs:QName");
        auto value = saved(decode(s, wire("t:Q", "data:part", 'xmlns:data="urn:parts"'), True));
        assertEq(Ns, value."^type^".getNamespaceUri());
        assertEq("urn:parts", value."^val^".getNamespaceUri());
        auto restored = decode(s, emit(s, value), True);
        assertTrue(value."^type^".equals(restored."^type^"));
        assertTrue(value."^val^".equals(restored."^val^"));
    }
    occurrences() {
        XsdSchema s = schema(Definitions + '<xs:complexType name="Container"><xs:sequence>'
            '<xs:element name="item" type="t:A" minOccurs="2" maxOccurs="3"/>'
            '</xs:sequence></xs:complexType>', "t:Container");
        string xml = wire("t:Container", '<item i:type="t:B">' + Content + '</item><item><number>18</number></item>');
        auto value = saved(decode(s, xml, True));
        assertEq(2, value.item.size());
        checkType(value.item[0], Ns, "B", Data);
        assertEq({"number":18}, value.item[1]);
        auto restored = decode(s, emit(s, value), True);
        checkType(restored.item[0], Ns, "B", Data);
        assertEq(value.item[1], restored.item[1]);
    }
    nilValues() {
        XsdSchema s = schema(Definitions, "t:A", 'nillable="true"');
        auto value = saved(decode(s, wire("t:B", "", 'i:nil="true"'), True));
        checkType(value, Ns, "B", NOTHING);
        checkType(decode(s, emit(s, value), True), Ns, "B", NOTHING);
    }
    malformed() {
        XsdSchema s = schema();
        auto value = decode(s, wire(), True);
        auto extra = value;
        extra.description = "must not be discarded";
        assertThrows("SOAP-SERIALIZATION-ERROR", sub() { emit(s, extra); });
        auto nested = value;
        nested."^val^" = value;
        assertThrows("SOAP-SERIALIZATION-ERROR", sub() { emit(s, nested); });
        value."^type^" = new XsdQNameValue(Ns, "Missing");
        assertThrows("SOAP-SERIALIZATION-ERROR", sub() { emit(s, value); });
    }
    scalarContexts() {
        XsdSchema s('<xs:schema xmlns:xs="' + XSD_NS + '"><xs:attribute name="quantity" type="xs:decimal"/>'
            '<xs:complexType name="Amount"><xs:simpleContent><xs:extension base="xs:decimal"/>'
            '</xs:simpleContent></xs:complexType></xs:schema>');
        XsdAttribute attribute = s.getAttribute("", "quantity");
        XsdComplexType amount = cast<XsdComplexType>(s.findType("Amount"));
        foreach string local in ("decimal", "int") {
            foreach auto selected in (new XsdQNameValue(XSD_NS, local), s.nsc.getBaseType(local)) {
                auto wrapper = {"^type^":selected,"^val^":17};
                assertThrows("SOAP-SERIALIZATION-ERROR", sub() {
                    attribute.serializeAttributeValue(s.nsc.copy(), wrapper);
                });
                assertThrows("SOAP-SERIALIZATION-ERROR", sub() {
                    amount.serializeValue(s.nsc.copy(), {"^value^":wrapper}, True);
                });
            }
        }
        assertEq("17", attribute.serializeAttributeValue(s.nsc.copy(), 17));
        assertEq("17", amount.serializeValue(s.nsc.copy(), {"^value^":17}, True)."^value^");
    }
    scopes() {
        XsdSchema s = schema();
        XsdElement element = s.getElement(Ns, "value");
        auto value = decode(s, wire(), True);
        auto converted = element.serializeValue(s.nsc.copy(), value, True, "value", "test", s.getTypeMap());
        assertEq("Replacement part", converted.description);
        assertThrows("SOAP-SERIALIZATION-ERROR", sub() { element.serializeValue(s.nsc.copy(), value, True, "value", "test"); });
        auto bad = value;
        bad."^type^" = new XsdQNameValue(Ns, "Missing");
        assertThrows("SOAP-SERIALIZATION-ERROR", sub() { element.serializeValue(s.nsc.copy(), bad, True, "value", "test", s.getTypeMap()); });
        assertThrows("SOAP-SERIALIZATION-ERROR", sub() { element.serializeValue(s.nsc.copy(), value, True, "value", "test"); });
        assertThrows("SOAP-DESERIALIZATION-ERROR", sub() { decode(s, wire("t:B", '<number>bad</number>'), True); });
        assertEq(Data, decode(s, wire(), NOTHING));
        auto declared = {"^type^":new XsdQNameValue(Ns,"A"),"^val^":{"number":17}};
        assertEq(17, element.serializeOccurrence(s.nsc.copy(), declared, True, "value", "test").number);
    }
    documentParts() {
        messageParts(False);
    }
    rpcParts() {
        messageParts(True);
    }
    private messageParts(bool rpc) {
        foreach string version in ("11", "12") {
            WebService ws = service(rpc, version);
            string binding = "Soap" + version;
            string ns = version == "12" ? SOAP_12_ENV : SOAP_11_ENV;
            foreach bool response in (False, True) {
                string operation_name = response ? "submitResponse" : "submit";
                string payload = rpc ? '<t:' + operation_name + ' xmlns:t="' + Ns + '" xmlns:i="' + XSI_NS
                    + '"><body i:type="t:I">17</body></t:' + operation_name + '>' : wire();
                string input = '<s:Envelope xmlns:s="' + ns + '"><s:Body>' + payload + '</s:Body></s:Envelope>';
                WSOperation op = ws.getBindingOperation(binding, "submit");
                auto value = response ? op.deserializeResponse(parse_xml(input, XPF_PRESERVE_ORDER), binding, True)
                    : op.deserializeRequest(parse_xml(input, XPF_PRESERVE_ORDER), binding, True);
                checkType(value, Ns, rpc ? "I" : "B", rpc ? 17 : Data);
                WebService other = saved(ws);
                WSOperation receiver = other.getBindingOperation(binding, "submit");
                value = saved(value);
                string output = (response ? receiver.serializeResponse(value, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, binding)
                    : receiver.serializeRequest(value, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, binding)).body;
                auto restored = response ? receiver.deserializeResponse(parse_xml(output, XPF_PRESERVE_ORDER), binding, True)
                    : receiver.deserializeRequest(parse_xml(output, XPF_PRESERVE_ORDER), binding, True);
                checkType(restored, Ns, rpc ? "I" : "B", rpc ? 17 : Data);
                assertEq(rpc ? 17 : Data, response ? receiver.deserializeResponse(parse_xml(output, XPF_PRESERVE_ORDER), binding)
                    : receiver.deserializeRequest(parse_xml(output, XPF_PRESERVE_ORDER), binding));
            }
        }
    }
    httpValues() {
        foreach string version in ("11", "12") {
            foreach bool rpc in (False, True) {
                foreach bool preserve_handler in (False, True) {
                    WebService ws = service(rpc, version);
                    string binding = "Soap" + version;
                    WSOperation op = ws.getBindingOperation(binding, "submit");
                    HttpServer server();
                    on_exit server.stop();
                    SoapHandler handler(new PermissiveAuthenticator());
                    server.setDefaultHandler("soap", handler);
                    Queue observed();
                    code<auto(hash<auto>, auto)> callback = auto sub(hash<auto> cx, auto value) {
                        observed.push(value);
                        return preserve_handler ? value : {"^type^":new XsdQNameValue(Ns, rpc ? "I" : "B"),"^val^":value};
                    };
                    assertThrows("SOAP-SERVER-ADDMETHOD-PARAMETER-ERROR", sub() {
                        handler.addMethod(ws, op, callback, NOTHING, NOTHING, NOTHING, "Service", NOTHING,
                            NOTHING, binding, NOTHING, True, True);
                    });
                    handler.addMethod(ws, op, callback, NOTHING, NOTHING, NOTHING, "Service", NOTHING,
                        NOTHING, binding, NOTHING, False, preserve_handler);
                    server.addListener(0);
                    string url = sprintf("http://127.0.0.1:%d/Service", server.getListenerInfo(0).port);
                    SoapClient client({"wsdl":saved(ws),"url":url,"timeout":30000,"connect_timeout":30000});
                    auto request = {"^type^":new XsdQNameValue(Ns, rpc ? "I" : "B"),"^val^":rpc ? 17 : Data};
                    assertThrows("SOAP-CLIENT-ERROR", sub() { client.callOperation("submit", request, {"preserve_types":"true"}); });
                    assertThrows("SOAP-CLIENT-ERROR", sub() { client.callOperation("submit", request, {"preserve_types":True,"xml_values":True}); });
                    foreach bool preserve_client in (True, False, True) {
                        auto result = client.callOperation("submit", request, {"preserve_types":preserve_client});
                        auto received = observed.pop(30000);
                        if (preserve_handler) {
                            checkType(received, Ns, rpc ? "I" : "B", rpc ? 17 : Data);
                        } else {
                            assertEq(rpc ? 17 : Data, received);
                        }
                        if (preserve_client) {
                            checkType(result, Ns, rpc ? "I" : "B", rpc ? 17 : Data);
                            request = saved(result);
                        } else {
                            assertEq(rpc ? 17 : Data, result);
                        }
                    }
                }
            }
        }
    }
    unqualified() {
        string definitions = Definitions;
        definitions =~ s/base="t:A"/base="A"/;
        XsdSchema s('<xs:schema xmlns:xs="' + XSD_NS + '">' + definitions
            + '<xs:element name="value" type="A"/></xs:schema>');
        auto input = parse_xml('<value xmlns:i="' + XSI_NS + '" i:type="B">' + Content + '</value>').value;
        auto value = s.getElement("", "value").deserializeValue(s.getTypeMap(), NOTHING, input, True, True);
        checkType(value, "", "B", Data);
        string xml = s.serializeXmlValue("", "value", saved(value)).getXml();
        auto restored = s.getElement("", "value").deserializeValue(s.getTypeMap(), NOTHING, parse_xml(xml).value, True, True);
        checkType(restored, "", "B", Data);
    }
    cancellation() {
        XsdSchema s = schema();
        XsdElement element = s.getElement(Ns, "value");
        XsdAbstractType declared = element.type;
        on_exit element.type = declared;
        element.type = new CancelNativeTypeValue();
        assertThrows("THREAD-CANCELLED", sub() { element.deserializeValue(s.getTypeMap(), NOTHING, "part", True, True); });
        assertThrows("SOAP-SERIALIZATION-ERROR", sub() { emit(s,
            {"^type^":new XsdQNameValue(XSD_NS,"string"),"^val^":"part"}); });
        element.type = declared;
        assertEq(Data, decode(s, wire(), NOTHING));
        auto explicit = {"^type^":s.findType("B"),"^val^":Data,"extra":"must not be ignored"};
        assertThrows("SOAP-SERIALIZATION-ERROR", sub() { emit(s, explicit); });
    }
    headers() {
        foreach string version in ("11", "12") {
            WebService ws = service(False, version, True);
            string binding = "Soap" + version;
            WSOperation op = ws.getBindingOperation(binding, "submit");
            foreach bool response in (False, True) {
                string message = response ? "HeaderOut" : "HeaderIn";
                string ns = version == "12" ? SOAP_12_ENV : SOAP_11_ENV;
                string xml = '<s:Envelope xmlns:s="' + ns + '"><s:Header><t:Context xmlns:t="' + Ns
                    + '" xmlns:i="' + XSI_NS + '" i:type="t:I">17</t:Context></s:Header><s:Body>' + wire()
                    + '</s:Body></s:Envelope>';
                auto value = response ? op.deserializeResponse(parse_xml(xml, XPF_PRESERVE_ORDER), binding, True)
                    : op.deserializeRequest(parse_xml(xml, XPF_PRESERVE_ORDER), binding, True);
                checkType(value.body, Ns, "B", Data);
                checkType(value{message}.context, Ns, "I", 17);
                value = saved(value);
                WebService receiver = saved(ws);
                WSOperation other = receiver.getBindingOperation(binding, "submit");
                string output = (response ? other.serializeResponse(value, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, binding)
                    : other.serializeRequest(value, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, binding)).body;
                auto restored = response ? other.deserializeResponse(parse_xml(output, XPF_PRESERVE_ORDER), binding, True)
                    : other.deserializeRequest(parse_xml(output, XPF_PRESERVE_ORDER), binding, True);
                checkType(restored.body, Ns, "B", Data);
                checkType(restored{message}.context, Ns, "I", 17);
            }
        }
    }
    concurrency() {
        XsdSchema shared = schema();
        auto namespaces = shared.nsc.getOutputNamespaceHash();
        Qore::Thread::Queue ready();
        Qore::Thread::Queue start();
        Qore::Thread::Queue results();
        Qore::Thread::Counter running();
        on_exit {
            start.push(True);
            start.push(True);
            assertEq(0, running.waitForZero(30s));
        }
        foreach bool preserve in (False, True) {
            running.inc();
            background sub(bool preserve) {
                on_exit running.dec();
                try {
                    ready.push(True);
                    start.get(30s);
                    bool valid = True;
                    for (int index = 0; index < 30; ++index) {
                        auto value = decode(shared, wire(), preserve);
                        if (preserve) {
                            value = decode(shared, emit(shared, saved(value)), True)."^val^";
                        }
                        if (value != Data || decode(shared, wire(), NOTHING) != Data) {
                            valid = False;
                            break;
                        }
                    }
                    results.push(valid);
                } catch (hash<ExceptionInfo> error) {
                    results.push(error);
                }
            }(preserve);
        }
        assertTrue(ready.get(30s));
        assertTrue(ready.get(30s));
        start.push(True);
        start.push(True);
        assertEq(True, results.get(30s));
        assertEq(True, results.get(30s));
        assertEq(namespaces, shared.nsc.getOutputNamespaceHash());
    }
}
