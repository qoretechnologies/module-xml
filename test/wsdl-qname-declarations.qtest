#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class QNameDeclarationsTest

class QNameDeclarationsTest inherits QUnit::Test {
    constructor() : Test("XSD QName enumeration declaration scopes", "1.0") {
        addTestCase("Aliases resolve at every declaration level without requiring schema imports", \scopes());
        addTestCase("Unbound and malformed QName enumeration literals reject", \invalid());
        addTestCase("Restrictions compare namespace and local identity exactly", \identity());
        addTestCase("Equal lexical literals retain all of their distinct namespace identities", \duplicates());
        addTestCase("Default namespace resets and implicit xml bindings survive late resolution", \defaults());
        addTestCase("Enumeration literals satisfy inherited patterns independently of own patterns", \patterns());
        addTestCase("Forward and inline base types retain declaration scopes", \late());
        addTestCase("Failed additions restore schema state before and after reconstruction", \rollback());
        addTestCase("Non-QName enumerations retain their own lexical and value rules", \otherTypes());
        addTestCase("Large finite QName enumerations retain every value", \large());
        addTestCase("Chameleon includes preserve no-namespace data values in each adopted namespace", \chameleon());
        addTestCase("Cancellation at the schema boundary propagates and the addition can be retried", \cancellation());
        addTestCase("Concurrent schema copies retain independent enumeration bindings", \concurrency());
        set_return_value(main());
    }

    private static string document(string declarations, string attributes = "") {
        return '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:qname-declarations"
            targetNamespace="urn:qname-declarations" ' + attributes + '>' + declarations + '</xs:schema>';
    }

    private static string restriction(string name, string base, string facets, string attributes = "") {
        return '<xs:simpleType name="' + name + '"><xs:restriction base="' + base + '" ' + attributes + '>'
            + facets + '</xs:restriction></xs:simpleType>';
    }

    private static string enumeration(string value, string attributes = "") {
        return '<xs:enumeration value="' + value + '" ' + attributes + '/>';
    }

    private static XsdSchema schema(string declarations, string attributes = "") {
        return new XsdSchema(document(declarations, attributes), {"async_only": True});
    }

    private accepted(string declarations, string attributes = "", string name = "Value") {
        XsdSchema original = schema(declarations, attributes);
        foreach XsdSchema current in (original, Serializable::deserialize(original.serialize())) {
            assertEq(name, current.findType(make_qname("urn:qname-declarations", name)).name);
        }
    }

    private scopes() {
        string parent = restriction("Base", "xs:QName", enumeration("a:Name", 'xmlns:a="urn:catalog"'));
        string child = restriction("Value", "t:Base", enumeration("b:Name"));
        accepted(parent + child, 'xmlns:b="urn:catalog"');
        child =~ s/name="Value"/name="Value" xmlns:b="urn:catalog"/;
        accepted(parent + child);
        accepted(parent + restriction("Value", "t:Base", enumeration("b:Name"), 'xmlns:b="urn:catalog"'));
        accepted(parent + restriction("Value", "t:Base", enumeration("b:Name", 'xmlns:b="urn:catalog"')));
        accepted(parent + restriction("Value", "t:Base", enumeration("b:Name", 'xmlns:b="urn:catalog"'),
            'xmlns:b="urn:wrong"'), 'xmlns:b="urn:outer"');
        assertThrows("XSD-SIMPLETYPE-ERROR", \schema(), (parent
            + restriction("Value", "t:Base", enumeration("b:Name", 'xmlns:b="urn:wrong"')),));
    }

    private invalid() {
        foreach string value in ("missing:Name", "xmlns:Name", "", "a:b:c", ":Name", "0name", "xml:", "xml:0") {
            assertThrows("XSD-SIMPLETYPE-ERROR", \schema(),
                (restriction("Value", "xs:QName", enumeration(value)),));
        }
        accepted(restriction("Value", "xs:QName", enumeration("xml:lang")));
        accepted(restriction("Value", "xs:QName", enumeration(" Name &#x9;")));
    }

    private identity() {
        foreach list<string> pair in (("urn:One", "urn:one"), ("urn:%41", "urn:A"),
                ("urn:%C3%A9", "urn:e%CC%81"), ("urn:one%7D", "urn:one"), ("urn:a&amp;b", "urn:a&amp;#38;b")) {
            string parent = restriction("Base", "xs:QName", enumeration("a:Name", 'xmlns:a="' + pair[0] + '"'));
            accepted(parent + restriction("Value", "t:Base", enumeration("b:Name", 'xmlns:b="' + pair[0] + '"')));
            assertThrows("XSD-SIMPLETYPE-ERROR", \schema(), (parent
                + restriction("Value", "t:Base", enumeration("b:Name", 'xmlns:b="' + pair[1] + '"')),));
        }
        string parent = restriction("Base", "xs:QName", enumeration("a:Name", 'xmlns:a="urn:one"'));
        foreach string local in ("name", "Other", "NameX") {
            assertThrows("XSD-SIMPLETYPE-ERROR", \schema(), (parent
                + restriction("Value", "t:Base", enumeration("a:" + local, 'xmlns:a="urn:one"')),));
        }
    }

    private duplicates() {
        string parent = restriction("Base", "xs:QName", enumeration("a:Name", 'xmlns:a="urn:one"')
            + enumeration("a:Name", 'xmlns:a="urn:two"'));
        foreach string uri in ("urn:one", "urn:two") {
            accepted(parent + restriction("Value", "t:Base", enumeration("b:Name", 'xmlns:b="' + uri + '"')));
        }
        string valid = enumeration("b:Name", 'xmlns:b="urn:one"');
        string invalid = enumeration("b:Name", 'xmlns:b="urn:three"');
        foreach string facets in (valid + invalid, invalid + valid) {
            assertThrows("XSD-SIMPLETYPE-ERROR", \schema(), (parent + restriction("Value", "t:Base", facets),));
        }
        accepted(parent + restriction("Value", "t:Base", valid + valid));
    }

    private defaults() {
        string parent = restriction("Base", "xs:QName", enumeration("Name", 'xmlns="urn:one"'));
        accepted(parent + restriction("Value", "t:Base", enumeration("p:Name", 'xmlns:p="urn:one"')));
        accepted(parent + restriction("Value", "t:Base", enumeration("Name")), 'xmlns="urn:one"');
        assertThrows("XSD-SIMPLETYPE-ERROR", \schema(), (parent
            + restriction("Value", "t:Base", enumeration("Name", 'xmlns=""')), 'xmlns="urn:one"'));
        parent = restriction("Base", "xs:QName", enumeration("Name"));
        accepted(parent + restriction("Value", "t:Base", enumeration("Name", 'xmlns=""')));
        parent = restriction("Base", "xs:QName", enumeration("xml:lang"));
        accepted(parent + restriction("Value", "t:Base", enumeration("xml:lang")));
        assertThrows("XSD-SIMPLETYPE-ERROR", \schema(), (parent
            + restriction("Value", "t:Base", enumeration("lang")),));
    }

    private patterns() {
        string parent = restriction("Base", "xs:QName", '<xs:pattern value="a:Name"/>');
        accepted(parent + restriction("Value", "t:Base", enumeration("a:Name")), 'xmlns:a="urn:one"');
        assertThrows("XSD-SIMPLETYPE-ERROR", \schema(), (parent
            + restriction("Value", "t:Base", enumeration("b:Name")), 'xmlns:b="urn:one"'));
        accepted(restriction("Base", "xs:QName", enumeration("a:Name"))
            + restriction("Value", "t:Base", enumeration("b:Name") + '<xs:pattern value="a:Name"/>'),
            'xmlns:a="urn:one" xmlns:b="urn:one"');
        parent = restriction("Root", "xs:QName", '<xs:pattern value="[ab]:Name"/>')
            + restriction("Base", "t:Root", '<xs:pattern value="a:Name"/><xs:pattern value="b:Name"/>');
        accepted(parent + restriction("Value", "t:Base", enumeration(" b:Name &#xA;")), 'xmlns:b="urn:one"');
        assertThrows("XSD-SIMPLETYPE-ERROR", \schema(), (parent
            + restriction("Value", "t:Base", enumeration("c:Name")), 'xmlns:c="urn:one"'));
    }

    private late() {
        string child = restriction("Value", "t:Base", enumeration("b:Name", 'xmlns:b="urn:one"'));
        string parent = restriction("Base", "xs:QName", enumeration("a:Name", 'xmlns:a="urn:one"'));
        accepted(child + parent);
        accepted('<xs:simpleType name="Value"><xs:restriction><xs:simpleType><xs:restriction base="xs:QName">'
            + enumeration("a:Name", 'xmlns:a="urn:one"') + '</xs:restriction></xs:simpleType>'
            + enumeration("b:Name", 'xmlns:b="urn:one"') + '</xs:restriction></xs:simpleType>');
        assertThrows("WSDL-ERROR", \schema(), (child,));
    }

    private rollback() {
        XsdSchema original = schema(restriction("Base", "xs:QName", enumeration("a:Name", 'xmlns:a="urn:one"')));
        foreach XsdSchema current in (original, Serializable::deserialize(original.serialize())) {
            string child = restriction("Value", "t:Base", enumeration("b:Name", 'xmlns:b="urn:wrong"'));
            assertThrows("XSD-SIMPLETYPE-ERROR", \current.addSchemaString(), (document(child),));
            child =~ s/urn:wrong/urn:one/;
            current.addSchemaString(document(child));
            assertEq("Value", current.findType(make_qname("urn:qname-declarations", "Value")).name);
            XsdSchema restored = Serializable::deserialize(current.serialize());
            string grandchild = restriction("Grandchild", "t:Value", enumeration("c:Name", 'xmlns:c="urn:other"'));
            assertThrows("XSD-SIMPLETYPE-ERROR", \restored.addSchemaString(), (document(grandchild),));
            grandchild =~ s/urn:other/urn:one/;
            restored.addSchemaString(document(grandchild));
            assertEq("Grandchild", restored.findType(make_qname("urn:qname-declarations", "Grandchild")).name);
        }
    }

    private otherTypes() {
        foreach list<string> item in (("string", "missing:Name"), ("string", "a:b:c"), ("string", ""),
                ("dateTime", "2001-01-01T00:00:00Z"), ("decimal", "+001.00"), ("anyURI", "urn:unbound")) {
            accepted(restriction("Value", "xs:" + item[0], enumeration(item[1])));
        }
    }

    private large() {
        list<string> facets();
        for (int i = 0; i < 1024; ++i) {
            push facets, enumeration("p:Name", 'xmlns:p="urn:item:' + i + '"');
        }
        string parent = restriction("Base", "xs:QName", facets.join(""));
        foreach int i in (0, 511, 1023) {
            accepted(parent + restriction("Value", "t:Base", enumeration("v:Name", 'xmlns:v="urn:item:' + i + '"')));
        }
        assertThrows("XSD-SIMPLETYPE-ERROR", \schema(), (parent
            + restriction("Value", "t:Base", enumeration("v:Name", 'xmlns:v="urn:item:1024"')),));
    }

    private chameleon() {
        string common = '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">'
            + restriction("Base", "xs:QName", enumeration("Name")) + '</xs:schema>';
        string parent = document('<xs:include schemaLocation="common.xsd"/>');
        XsdSchema original(parent, {"async_only": True, "def_path": "https://example.invalid/qnames/",
            "xsd_cache": {"https://example.invalid/qnames/common.xsd": common}});
        parent =~ s/urn:qname-declarations/urn:second/g;
        original.addSchemaString(parent);
        foreach XsdSchema current in (original, Serializable::deserialize(original.serialize())) {
            foreach string uri in ("urn:qname-declarations", "urn:second") {
                string wrong = document(restriction("Value", "t:Base", enumeration("t:Name")));
                wrong = regex_subst(wrong, "urn:qname-declarations", uri, RE_Global);
                assertThrows("XSD-SIMPLETYPE-ERROR", \current.addSchemaString(), (wrong,));
                string valid = regex_subst(wrong, 'value="t:Name"', 'value="Name"');
                current.addSchemaString(valid);
                assertEq("Value", current.findType(make_qname(uri, "Value")).name);
            }
        }
    }

    private cancellation() {
        XsdSchema original = schema(restriction("Base", "xs:QName", enumeration("a:Name", 'xmlns:a="urn:one"')));
        string child = document(restriction("Value", "t:Base", enumeration("b:Name", 'xmlns:b="urn:one"')));
        SandboxManager manager();
        on_exit manager.clearInterrupt();
        Program program(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
        program.setSandboxManager(manager);
        program.parse("%modern\n%requires ../qlib/WSDL.qm\n"
            "sub addQName(XsdSchema schema, string source, SandboxManager manager, bool cancel) {\n"
            "    if (cancel) { manager.requestInterrupt(); }\n"
            "    schema.addSchemaString(source);\n"
            "}\n", get_script_dir() + "/wsdl-qname-declaration-interrupt.qr");
        *hash<ExceptionInfo> error;
        try {
            program.callFunction("addQName", original, child, manager, True);
        } catch (hash<ExceptionInfo> ex) {
            error = ex;
        }
        manager.clearInterrupt();
        assertEq("PROGRAM-INTERRUPTED", error.err);
        program.callFunction("addQName", original, child, manager, False);
        assertEq("Value", original.findType(make_qname("urn:qname-declarations", "Value")).name);
    }

    private concurrency() {
        XsdSchema original = schema("");
        Qore::Thread::Queue ready();
        Qore::Thread::Queue start();
        Qore::Thread::Queue results();
        Qore::Thread::Counter running();
        on_exit {
            for (int i = 0; i < 4; ++i) {
                start.push(True);
            }
            assertEq(0, running.waitForZero(30s));
        }
        for (int i = 0; i < 4; ++i) {
            running.inc();
            background sub(int index) {
                on_exit running.dec();
                try {
                    ready.push(True);
                    start.get(30s);
                    XsdSchema current = Serializable::deserialize(original.serialize());
                    string uri = "urn:thread:" + index;
                    current.addSchemaString(document(restriction("Base", "xs:QName",
                        enumeration("p:Name", 'xmlns:p="' + uri + '"'))));
                    string rejected;
                    try {
                        current.addSchemaString(document(restriction("Value", "t:Base",
                            enumeration("p:Name", 'xmlns:p="urn:wrong"'))));
                    } catch (hash<ExceptionInfo> ex) {
                        rejected = ex.err;
                    }
                    current.addSchemaString(document(restriction("Value", "t:Base",
                        enumeration("p:Name", 'xmlns:p="' + uri + '"'))));
                    results.push((rejected, current.findType(make_qname("urn:qname-declarations", "Value")).name));
                } catch (hash<ExceptionInfo> ex) {
                    results.push({"error": ex});
                }
            }(i);
        }
        for (int i = 0; i < 4; ++i) {
            ready.get(30s);
        }
        for (int i = 0; i < 4; ++i) {
            start.push(True);
        }
        for (int i = 0; i < 4; ++i) {
            assertEq(("XSD-SIMPLETYPE-ERROR", "Value"), results.get(30s));
        }
    }
}
