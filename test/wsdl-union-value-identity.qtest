#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class UnionValueIdentityTest

class UnionValueIdentityTest inherits QUnit::Test {
    constructor() : Test("XSD union primitive values and lexical restrictions", "1.0") {
        addTestCase("Noncanonical integer text retains its primitive value", \integerIdentity());
        addTestCase("Boolean text cannot become a string member", \booleanIdentity());
        addTestCase("Enumeration compares base primitive values", \enumerations());
        addTestCase("Union patterns validate lexical text", \patterns());
        addTestCase("Nested restrictions and list items retain union value identity", \nested());
        addTestCase("Detached union metadata validates fields and follows member reordering", \metadata());
        addTestCase("Detached union enumerations reject invalid base values", \enumerationMetadata());
        addTestCase("Invalid enumeration declarations fail at schema construction", \declarations());
        addTestCase("Field choices compare primitive values and update atomically", \fields());
        addTestCase("Binary union members retain their distinct primitive families", \binaryValues());
        addTestCase("Errors during semantic probes propagate and restore traversal state", \probeErrors());
        addTestCase("Enumeration reporting propagates semantic probe errors", \enumerationErrors());
        set_return_value(main());
    }

    private static XsdSchema schema(string members, string facets = "", string extra = "") {
        return new XsdSchema('<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:union-values"
            targetNamespace="urn:union-values">' + extra + '<xs:simpleType name="Base"><xs:union memberTypes="'
            + members + '"/></xs:simpleType><xs:simpleType name="Value"><xs:restriction base="t:Base">'
            + facets + '</xs:restriction></xs:simpleType></xs:schema>', {"async_only": True});
    }

    private integerIdentity() {
        XsdSchema original = schema("xs:boolean xs:int");
        foreach XsdSchema definition in (original, Serializable::deserialize(original.serialize())) {
            XsdAbstractType type = definition.findType(make_qname("urn:union-values", "Value"));
            foreach string lexical in ("01", "000", "+1", "-0") {
                auto decoded = type.deserializeValue("value", definition.getTypeMap(), NOTHING, lexical);
                assertEq(NT_STRING, decoded.typeCode(), "retain ambiguous integer lexical text " + lexical);
                assertEq(lexical, decoded);
                assertEq(lexical, type.serializeValue(definition.nsc, decoded, True));
                AbstractDataProviderType provider = type.getDataProviderType();
                assertEq(lexical, provider.acceptsValue(lexical));
                assertEq(lexical, Serializable::deserialize(provider.serialize()).acceptsValue(lexical));
                assertEq((lexical,), new ListDataType(provider).acceptsValue((lexical,)));
            }
            assertEq(True, type.deserializeValue("value", definition.getTypeMap(), NOTHING, "1"));
            assertEq(False, type.deserializeValue("value", definition.getTypeMap(), NOTHING, "0"));
            assertEq(12, type.deserializeValue("value", definition.getTypeMap(), NOTHING, "12"));
        }
    }

    private booleanIdentity() {
        XsdSchema original = schema("t:Word xs:boolean", "", '<xs:simpleType name="Word"><xs:restriction
            base="xs:string"><xs:pattern value="true|false"/></xs:restriction></xs:simpleType>');
        foreach XsdSchema definition in (original, Serializable::deserialize(original.serialize())) {
            XsdAbstractType type = definition.findType(make_qname("urn:union-values", "Value"));
            foreach string lexical in ("1", "0") {
                auto decoded = type.deserializeValue("value", definition.getTypeMap(), NOTHING, lexical);
                assertEq(NT_STRING, decoded.typeCode(), "retain boolean text distinct from the string member");
                assertEq(lexical, decoded);
                assertEq(lexical, type.serializeValue(definition.nsc, lexical, True));
                assertEq(lexical, type.getDataProviderType().acceptsValue(lexical));
            }
            assertEq("true", type.deserializeValue("value", definition.getTypeMap(), NOTHING, "true"));
            assertEq("false", type.deserializeValue("value", definition.getTypeMap(), NOTHING, "false"));
        }
    }

    private enumerations() {
        foreach hash<auto> specimen in (
                {"members": "xs:int xs:decimal", "allowed": "01", "valid": ("1", "01", "1.0", "+1.00"),
                    "invalid": ("0", "2", "1.001")},
                {"members": "xs:boolean xs:int", "allowed": "1", "valid": ("true", "1"),
                    "invalid": ("01", "+1", "0", "false", "2")}) {
            XsdSchema original = schema(specimen.members, '<xs:enumeration value="' + specimen.allowed + '"/>');
            foreach XsdSchema definition in (original, Serializable::deserialize(original.serialize())) {
                XsdAbstractType type = definition.findType(make_qname("urn:union-values", "Value"));
                AbstractDataProviderType provider = type.getDataProviderType();
                AbstractDataProviderType restored = Serializable::deserialize(provider.serialize());
                foreach string lexical in (specimen.valid) {
                    auto decoded = type.deserializeValue("value", definition.getTypeMap(), NOTHING, lexical);
                    auto encoded = type.serializeValue(definition.nsc, decoded, True);
                    if (specimen.members == "xs:int xs:decimal") {
                        assertEq(number("1"), number(encoded));
                    } else {
                        assertTrue(encoded == "true" || encoded == "1");
                    }
                    assertEq(provider.acceptsValue(lexical), restored.acceptsValue(lexical));
                }
                foreach string lexical in (specimen.invalid) {
                    assertThrows("SOAP-DESERIALIZATION-ERROR", \type.deserializeValue(),
                        ("value", definition.getTypeMap(), NOTHING, lexical));
                    assertThrows("SOAP-SERIALIZATION-ERROR", \type.serializeValue(), (definition.nsc, lexical, True));
                    assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (lexical,));
                }
            }
        }
    }

    private patterns() {
        XsdSchema original = schema("xs:boolean xs:int", '<xs:pattern value="0"/>');
        foreach XsdSchema definition in (original, Serializable::deserialize(original.serialize())) {
            XsdAbstractType type = definition.findType(make_qname("urn:union-values", "Value"));
            assertEq("0", type.deserializeValue("value", definition.getTypeMap(), NOTHING, "0"));
            assertEq("0", type.serializeValue(definition.nsc, "0", True));
            AbstractDataProviderType provider = type.getDataProviderType();
            assertEq("0", provider.acceptsValue("0"));
            assertEq("0", Serializable::deserialize(provider.serialize()).acceptsValue("0"));
            foreach string lexical in ("false", "true", "1", "00") {
                assertThrows("SOAP-DESERIALIZATION-ERROR", \type.deserializeValue(),
                    ("value", definition.getTypeMap(), NOTHING, lexical));
                assertThrows("SOAP-SERIALIZATION-ERROR", \type.serializeValue(), (definition.nsc, lexical, True));
                assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (lexical,));
            }
        }
    }

    private nested() {
        XsdSchema original = schema("t:Restricted xs:string", "", '<xs:simpleType name="Numbers"><xs:union
            memberTypes="xs:boolean xs:int"/></xs:simpleType><xs:simpleType name="Restricted"><xs:restriction
            base="t:Numbers"><xs:pattern value="[0-9]+"/></xs:restriction></xs:simpleType>
            <xs:simpleType name="Items"><xs:list itemType="t:Numbers"/></xs:simpleType>');
        foreach XsdSchema definition in (original, Serializable::deserialize(original.serialize())) {
            XsdAbstractType type = definition.findType(make_qname("urn:union-values", "Value"));
            assertEq("01", type.deserializeValue("value", definition.getTypeMap(), NOTHING, "01"));
            assertEq("01", type.serializeValue(definition.nsc, "01", True));
            assertEq("01", type.getDataProviderType().acceptsValue("01"));
            XsdAbstractType items = definition.findType(make_qname("urn:union-values", "Items"));
            auto value = items.deserializeValue("items", definition.getTypeMap(), NOTHING, "01 1 12 000");
            assertEq(("01", True, 12, "000"), value);
            assertEq("01 true 12 000", items.serializeValue(definition.nsc, value, True));
            AbstractDataProviderType provider = items.getDataProviderType();
            assertEq(value, provider.acceptsValue(("01", "1", "12", "000")));
            assertEq(value, Serializable::deserialize(provider.serialize()).acceptsValue(("01", "1", "12", "000")));
        }
    }

    private metadata() {
        Namespaces ns({});
        UnionDataType original((ns.getBaseType("boolean"), ns.getBaseType("int")));
        original.types = (original.types[1], original.types[0]);
        foreach UnionDataType provider in (original, Serializable::deserialize(original.serialize())) {
            assertEq(1, provider.acceptsValue("01"));
            assertEq(False, provider.acceptsValue("false"));
        }
        hash<SerializationInfo> saved = original.serializeToData();
        *string atomic_index;
        foreach string index in (keys saved._index) {
            if (saved._index{index}.hasKey("_hash") && saved._index{index}._hash == "WSDL::XsdUnionAtomicInfo") {
                atomic_index = index;
                break;
            }
        }
        assertTrue(exists atomic_index);
        foreach hash<auto> invalid in ({"builtin": "unknown"}, {"white_space": "invalid"},
                {"white_space": "preserve"}, {"preserve_lexical": "yes"}, {"provider": NOTHING}) {
            hash<SerializationInfo> state = saved;
            state._index{atomic_index}._members += invalid;
            assertThrows(invalid.hasKey("preserve_lexical") ? "RUNTIME-TYPE-ERROR" : "DESERIALIZATION-ERROR",
                \Serializable::deserialize(), (state,));
        }
        foreach auto invalid in ("int", (), NULL) {
            hash<SerializationInfo> state = saved;
            state._index."0"._class_data."WSDL::UnionDataType".atomic_members = invalid;
            assertThrows("DESERIALIZATION-ERROR", \Serializable::deserialize(), (state,));
        }
        foreach auto invalid in (("[",), (1,), "0", ()) {
            hash<SerializationInfo> state = saved;
            state._index."0"._class_data."WSDL::UnionDataType".patterns = invalid;
            assertThrows("DESERIALIZATION-ERROR", \Serializable::deserialize(), (state,));
        }
        hash<SerializationInfo> legacy = saved;
        remove legacy._index."0"._class_data."WSDL::UnionDataType".atomic_members;
        assertEq(1, Serializable::deserialize(legacy).acceptsValue("01"));
        original.types = (original.types[0],);
        UnionDataType reduced = Serializable::deserialize(original.serialize());
        assertEq(12, reduced.acceptsValue("12"));
        assertThrows("RUNTIME-TYPE-ERROR", \reduced.acceptsValue(), ("true",));
    }

    private declarations() {
        foreach string value in ("yes", "1.0", "2147483648") {
            assertThrows("XSD-SIMPLETYPE-ERROR", \schema(),
                ("xs:boolean xs:int", '<xs:enumeration value="' + value + '"/>'));
        }
    }

    private enumerationMetadata() {
        XsdSchema definition = schema("xs:boolean xs:int", '<xs:enumeration value="1"/>');
        AbstractDataProviderType original = definition.findType(make_qname("urn:union-values", "Value"))
            .getDataProviderType();
        hash<SerializationInfo> saved = original.serializeToData();
        foreach string invalid in ("yes", "1.0", "2147483648") {
            foreach list<string> values in ((invalid, "1"), ("1", invalid)) {
                hash<SerializationInfo> state = saved;
                state._index."0"._class_data."WSDL::UnionDataType".enumeration = values;
                assertThrows("DESERIALIZATION-ERROR", \Serializable::deserialize(), (state,));
                assertEq(True, Serializable::deserialize(saved).acceptsValue("1"));
            }
        }
    }

    private fields() {
        Namespaces ns({});
        UnionDataType provider((ns.getBaseType("boolean"), ns.getBaseType("int")));
        XsdUnionDataField original({"name": "code", "type": provider, "allowed_values": ("01",)}, provider);
        foreach XsdUnionDataField field in (original, Serializable::deserialize(original.serialize())) {
            assertEq("01", field.acceptsValue("01"));
            assertEq("+1", field.acceptsValue("+1"));
            assertThrows("FIELD-VALUE-ERROR", \field.acceptsValue(), ("1",));
            assertThrows("RUNTIME-TYPE-ERROR", \field.setAllowedValues(), (("12", "bad"),));
            assertEq("01", field.acceptsValue("01"));
            assertThrows("FIELD-VALUE-ERROR", \field.acceptsValue(), ("12",));
            field.setAllowedValues(("1",));
            assertEq(True, field.acceptsValue("true"));
            assertThrows("FIELD-VALUE-ERROR", \field.acceptsValue(), ("01",));
            field.setAllowedValues(("1",), True);
            assertEq("01", field.acceptsValue("01"));
            assertThrows("RUNTIME-TYPE-ERROR", \field.acceptsValue(), ("bad",));
        }
        XsdUnionDataField repeated({"name": "codes", "type": new ListDataType(provider),
            "element_allowed_values": ("01", "true")}, provider);
        XsdUnionDataField restored = Serializable::deserialize(repeated.serialize());
        assertEq(("01", True), restored.acceptsValue(("01", "1")));
        assertThrows("FIELD-VALUE-ERROR", \restored.acceptsValue(), (("01", "2"),));
        XsdUnionDataField defaulted({"name": "flag", "type": provider, "default_value": "false",
            "allowed_values": (False,)}, provider);
        assertEq(False, defaulted.acceptsValue(NOTHING));
    }

    private binaryValues() {
        XsdSchema original = schema("xs:hexBinary xs:base64Binary");
        foreach XsdSchema definition in (original, Serializable::deserialize(original.serialize())) {
            XsdAbstractType type = definition.findType(make_qname("urn:union-values", "Value"));
            AbstractDataProviderType provider = type.getDataProviderType();
            foreach string lexical in ("", "616263", "00ff") {
                binary expected = parse_hex_string(lexical);
                auto decoded = type.deserializeValue("value", definition.getTypeMap(), NOTHING, lexical);
                assertEq(expected, decoded);
                assertEq(lexical, type.serializeValue(definition.nsc, decoded, True));
                assertEq(expected, provider.acceptsValue(lexical));
                assertEq(expected, Serializable::deserialize(provider.serialize()).acceptsValue(lexical));
            }
            assertEq("YWJj", type.deserializeValue("value", definition.getTypeMap(), NOTHING, "YWJj"));
            assertEq("YWJj", type.serializeValue(definition.nsc, "YWJj", True));
            assertEq("YWJj", provider.acceptsValue("YWJj"));
            assertEq("YWJj", Serializable::deserialize(provider.serialize()).acceptsValue("YWJj"));
            assertThrows("SOAP-DESERIALIZATION-ERROR", \type.deserializeValue(),
                ("value", definition.getTypeMap(), NOTHING, "!"));
            assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), ("!",));
        }
    }

    private probeErrors() {
        XsdSchema definition = schema("xs:boolean xs:int");
        XsdSimpleType type = cast<XsdSimpleType>(definition.findType(make_qname("urn:union-values", "Base")));
        UnionProbeFailure controlled(definition.nsc);
        type.unionTypes = (controlled,) + type.unionTypes;
        UnionDataType provider((definition.nsc.getBaseType("boolean"), definition.nsc.getBaseType("int")));
        UnionProviderProbeFailure provider_control;
        provider_control = new UnionProviderProbeFailure();
        provider.types = (provider_control,) + provider.types;
        foreach string error in ("TEST-CANCELLED", "OBJECT-ALREADY-DELETED", "RUNTIME-TYPE-ERROR") {
            controlled.error = error;
            controlled.serialization = False;
            assertThrows(error, \type.deserializeValue(), ("value", definition.getTypeMap(), NOTHING, "1"));
            assertThrows(error, \type.serializeValue(), (definition.nsc, "1", True));
            controlled.serialization = True;
            assertThrows(error, \type.deserializeValue(), ("value", definition.getTypeMap(), NOTHING, "1"));
            controlled.error = NOTHING;
            assertEq(True, type.deserializeValue("value", definition.getTypeMap(), NOTHING, "1"));
            assertEq("true", type.serializeValue(definition.nsc, "1", True));
            # Ordinary provider type rejection selects the next member; other failures escape the probe.
            if (error != "RUNTIME-TYPE-ERROR") {
                provider_control.error = error;
                assertThrows(error, \provider.acceptsValue(), ("1",));
                provider_control.error = NOTHING;
                assertEq(True, provider.acceptsValue("1"));
            }
        }
    }

    private enumerationErrors() {
        XsdSchema definition = schema("xs:boolean xs:int", '<xs:enumeration value="1"/>');
        XsdSimpleType base = cast<XsdSimpleType>(definition.findType(make_qname("urn:union-values", "Base")));
        XsdSimpleType restricted = cast<XsdSimpleType>(definition.findType(make_qname("urn:union-values", "Value")));
        UnionProbeFailure controlled(definition.nsc);
        base.unionTypes = (controlled,) + base.unionTypes;
        foreach string error in ("TEST-CANCELLED", "OBJECT-ALREADY-DELETED", "RUNTIME-TYPE-ERROR") {
            controlled.error = error;
            assertThrows(error, \restricted.getAllowedValues());
            controlled.error = NOTHING;
            assertEq((True,), restricted.getAllowedValues());
        }
    }
}

class UnionProbeFailure inherits XsdBaseType {
    public {
        *string error;
        bool serialization = False;
    }
    constructor(Namespaces namespaces) : XsdBaseType("int", namespaces) {
    }
    auto serializeValue(Namespaces namespaces, auto value, *softbool omitType) {
        if (error && serialization && value.typeCode() == NT_BOOLEAN) {
            throw error, "controlled serialization probe failure";
        }
        throw "SOAP-SERIALIZATION-ERROR", "controlled initial member rejection";
    }
    auto deserializeValue(string en, hash<string, XsdAbstractType> tmap, *hash<auto> mrh, auto value) {
        if (error && !serialization && value === "true") {
            throw error, "controlled deserialization probe failure";
        }
        throw "SOAP-DESERIALIZATION-ERROR", "controlled initial member rejection";
    }
}

class UnionProviderProbeFailure inherits XsdBooleanDataType {
    public {
        *string error;
    }
    auto acceptsValue(auto value) {
        if (error && value === "true") {
            throw error, "controlled provider probe failure";
        }
        throw "RUNTIME-TYPE-ERROR", "controlled initial provider rejection";
    }
}
