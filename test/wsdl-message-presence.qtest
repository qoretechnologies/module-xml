#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm

%exec-class MessagePresenceTest

# A message contains every part and every header that its binding describes (WS-I Basic Profile R2738). A nillable
# element part without a value is serialized as nil, since an absent value and an explicit NOTHING are the same in
# Qore data; a bound header without a value cannot be serialized. Received messages without a bound header are still
# decoded.
public class MessagePresenceTest inherits QUnit::Test {
    private {
        const Wsdl = '<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:soap12="http://schemas.xmlsoap.org/wsdl/soap12/"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:tns="urn:presence" targetNamespace="urn:presence">
  <types>
    <xs:schema targetNamespace="urn:presence" elementFormDefault="qualified">
      <xs:element name="amount" type="xs:decimal" nillable="true"/>
      <xs:element name="quantity" type="xs:int"/>
      <xs:element name="token" type="xs:string"/>
      <xs:element name="result" type="xs:string"/>
    </xs:schema>
  </types>
  <message name="DocRequest"><part name="amount" element="tns:amount"/><part name="quantity" element="tns:quantity"/>
  </message>
  <message name="Token"><part name="token" element="tns:token"/></message>
  <message name="Result"><part name="result" element="tns:result"/></message>
  <message name="Problem"><part name="detail" element="tns:result"/></message>
  <message name="RpcRequest"><part name="amount" element="tns:amount"/></message>
  <portType name="Presence">
    <operation name="submit"><input message="tns:DocRequest"/><output message="tns:Result"/>
      <fault name="Problem" message="tns:Problem"/></operation>
    <operation name="rpcSubmit"><input message="tns:RpcRequest"/><output message="tns:Result"/></operation>
  </portType>
  <binding name="DocBinding" type="tns:Presence">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="submit"><soap:operation soapAction="urn:presence:submit"/>
      <input><soap:body use="literal" parts="amount quantity"/>
        <soap:header message="tns:Token" part="token" use="literal"/></input>
      <output><soap:body use="literal"/><soap:header message="tns:Token" part="token" use="literal"/></output>
      <fault name="Problem"><soap:fault name="Problem" use="literal"/></fault></operation>
    <operation name="rpcSubmit"><soap:operation soapAction="urn:presence:rpcSubmit" style="rpc"/>
      <input><soap:body use="literal" namespace="urn:presence"/></input>
      <output><soap:body use="literal" namespace="urn:presence"/></output></operation>
  </binding>
  <binding name="Doc12Binding" type="tns:Presence">
    <soap12:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="submit"><soap12:operation soapAction="urn:presence:submit"/>
      <input><soap12:body use="literal" parts="amount quantity"/>
        <soap12:header message="tns:Token" part="token" use="literal"/></input>
      <output><soap12:body use="literal"/><soap12:header message="tns:Token" part="token" use="literal"/></output>
      <fault name="Problem"><soap12:fault name="Problem" use="literal"/></fault></operation>
    <operation name="rpcSubmit"><soap12:operation soapAction="urn:presence:rpcSubmit" style="rpc"/>
      <input><soap12:body use="literal" namespace="urn:presence"/></input>
      <output><soap12:body use="literal" namespace="urn:presence"/></output></operation>
  </binding>
  <service name="PresenceService"><port name="PresencePort" binding="tns:DocBinding">
    <soap:address location="http://localhost/presence"/></port></service>
</definitions>';
    }

    constructor() : Test("MessagePresenceTest", "1.0") {
        addTestCase("a nillable part without a value is nil", \nillableParts());
        addTestCase("every bound header must be supplied", \boundHeaders());
        addTestCase("received messages without a bound header are decoded", \receivedHeaders());
        set_return_value(main());
    }

    static string body(hash<auto> msg) {
        return (msg.body =~ x/<soapenv:Body>(.*)<\/soapenv:Body>/s)[0];
    }

    nillableParts() {
        WebService ws(Wsdl);
        WSOperation op = ws.getOperation("submit");
        hash<auto> header = {"token": "t1"};
        string explicit = body(op.serializeRequest({"amount": NOTHING, "quantity": 2}, header));
        assertRegex("<ns:amount xsi:nil=\"true\"/>", explicit);
        # an omitted nillable part is the same as an explicit NOTHING
        assertEq(explicit, body(op.serializeRequest({"quantity": 2}, header)));
        # a value is serialized as usual
        assertRegex("<ns:amount>1.5</ns:amount>", body(op.serializeRequest({"amount": 1.5, "quantity": 2}, header)));
        # a part that is not nillable is still required
        assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), ({"amount": 1.5}, header));
        # the omitted part decodes as no value, like the explicit nil
        assertEq({"amount": NOTHING, "quantity": 2},
            op.deserializeRequest(parse_xml(op.serializeRequest({"quantity": 2}, header).body)) - "Token");

        # the same rule applies to an RPC part
        WSOperation rpc = ws.getOperation("rpcSubmit");
        string rpc_explicit = body(rpc.serializeRequest({"amount": NOTHING}));
        assertRegex("amount xsi:nil=\"true\"", rpc_explicit);
        assertEq(rpc_explicit, body(rpc.serializeRequest({})));
        assertEq(rpc_explicit, body(rpc.serializeRequest(NOTHING)));
    }

    boundHeaders() {
        WebService ws(Wsdl);
        WSOperation op = ws.getOperation("submit");
        hash<auto> request = {"amount": 1.5, "quantity": 2};
        # the header of the request and of the response is required
        assertThrows("SOAP-SERIALIZATION-ERROR", "missing value for SOAP header part \"token\".*R2738",
            \op.serializeRequest(), (request,));
        assertThrows("SOAP-SERIALIZATION-ERROR", "R2738", \op.serializeResponse(), ({"result": "ok"},));
        # supplied as a header argument or with the message values
        foreach auto args in ((request, {"token": "t1"}), (request + {"token": "t1"},)) {
            assertRegex("<soapenv:Header><ns:token>t1</ns:token></soapenv:Header>",
                op.serializeRequest(args[0], args[1]).body);
        }
        assertRegex("<ns:token>t2</ns:token>", op.serializeResponse({"result": "ok"}, {"token": "t2"}).body);
        # a fault is not described by the output binding, so it needs no header
        assertRegex("<soapenv:Fault>", op.serializeFault("Problem", "rejected", {"detail": "no stock"}).body);
        assertRegex("<soapenv:Fault>", op.serializeFault(NOTHING, "rejected", NOTHING).body);

        # the same rule applies to SOAP 1.2 headers (WS-I Basic Profile 2.0)
        WSOperation op12 = ws.getBindingOperation("Doc12Binding", "submit");
        assertThrows("SOAP-SERIALIZATION-ERROR", "R2738", \op12.serializeRequest(),
            (request, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, "Doc12Binding"));
        assertThrows("SOAP-SERIALIZATION-ERROR", "R2738", \op12.serializeResponse(),
            ({"result": "ok"}, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, "Doc12Binding"));
        hash<auto> msg12 = op12.serializeRequest(request, {"token": "t3"}, NOTHING, NOTHING, NOTHING, NOTHING,
            "Doc12Binding");
        assertRegex("application/soap\\+xml", msg12.hdr."Content-Type");
        assertRegex("<ns:token>t3</ns:token>", msg12.body);
    }

    receivedHeaders() {
        WebService ws(Wsdl);
        WSOperation op = ws.getOperation("submit");
        # a peer's message without the bound header is decoded; the header has no value
        string wire = replace(op.serializeRequest({"amount": 1.5, "quantity": 2}, {"token": "t1"}).body,
            "<soapenv:Header><ns:token>t1</ns:token></soapenv:Header>", "");
        assertFalse(wire =~ /Header/);
        hash<auto> decoded = op.deserializeRequest(parse_xml(wire));
        assertEq(1.5, decoded.amount);
        assertEq(2, decoded.quantity);
        # the header value is stored under its message name when present
        assertFalse(decoded.hasKey("Token"));
        assertEq({"token": "t1"}, op.deserializeRequest(parse_xml(op.serializeRequest({"amount": 1.5, "quantity": 2},
            {"token": "t1"}).body)).Token);
    }
}
