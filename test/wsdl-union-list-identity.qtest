#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class UnionListIdentityTest

class UnionListIdentityTest inherits QUnit::Test {
    constructor() : Test("XSD union list values", "1.0") {
        addTestCase("Boolean list spelling retains item primitive types", \booleanList());
        addTestCase("Integer and decimal lists share ordered numeric values", \numericChoices());
        addTestCase("List enumerations distinguish boolean and decimal items", \distinctChoices());
        addTestCase("Empty lists compare equally across item types", \emptyChoices());
        addTestCase("Whole union patterns retain list lexical spelling", \patterns());
        addTestCase("Finite provider choices compare ordered list values", \fields());
        addTestCase("Detached list metadata validates items and follows member reordering", \metadata());
        addTestCase("List semantic probe failures propagate and restore conversion state", \probeErrors());
        addTestCase("Single-item lists remain distinct from atomic values", \singleItems());
        addTestCase("Binary lists preserve primitive families and item boundaries", \binaryLists());
        set_return_value(main());
    }

    private static XsdSchema schema(string members, string facets = "") {
        return new XsdSchema('<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
            xmlns:t="urn:union-lists" targetNamespace="urn:union-lists">
            <xs:simpleType name="Word"><xs:restriction base="xs:string"><xs:pattern
                value="true|false"/></xs:restriction></xs:simpleType>
            <xs:simpleType name="Words"><xs:list itemType="t:Word"/></xs:simpleType>
            <xs:simpleType name="Booleans"><xs:list itemType="xs:boolean"/></xs:simpleType>
            <xs:simpleType name="Integers"><xs:list itemType="xs:integer"/></xs:simpleType>
            <xs:simpleType name="Decimals"><xs:list itemType="xs:decimal"/></xs:simpleType>
            <xs:simpleType name="Hex"><xs:list itemType="xs:hexBinary"/></xs:simpleType>
            <xs:simpleType name="Base64"><xs:list itemType="xs:base64Binary"/></xs:simpleType>
            <xs:simpleType name="Base"><xs:union memberTypes="' + members + '"/></xs:simpleType>
            <xs:simpleType name="Value"><xs:restriction base="t:Base">' + facets
            + '</xs:restriction></xs:simpleType></xs:schema>', {"async_only": True});
    }

    private booleanList() {
        XsdSchema original = schema("t:Words t:Booleans");
        foreach XsdSchema definition in (original, Serializable::deserialize(original.serialize())) {
            XsdAbstractType type = definition.findType(make_qname("urn:union-lists", "Value"));
            auto decoded = type.deserializeValue("value", definition.getTypeMap(), NOTHING, "1 0");
            assertEq(("1", "0"), decoded);
            assertEq("1 0", type.serializeValue(definition.nsc, decoded, True));
            assertEq("1 0", type.serializeValue(definition.nsc, "1 0", True));
            AbstractDataProviderType original_provider = type.getDataProviderType();
            foreach AbstractDataProviderType provider in (original_provider,
                    Serializable::deserialize(original_provider.serialize())) {
                assertTrue(provider.getAcceptTypeHash(True).string);
                foreach auto input in (("1", "0"), "1 0") {
                    assertEq(("1", "0"), provider.acceptsValue(input));
                }
                assertEq(("true", "false"), provider.acceptsValue(("true", "false")));
                assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (("yes", "no"),));
                assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (("1 0",),));
                assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (("",),));
                assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), ((NOTHING,),));
            }
        }
    }

    private numericChoices() {
        XsdSchema original = schema("t:Integers t:Decimals", '<xs:enumeration value="01 +2"/>');
        foreach XsdSchema definition in (original, Serializable::deserialize(original.serialize())) {
            XsdAbstractType type = definition.findType(make_qname("urn:union-lists", "Value"));
            AbstractDataProviderType original_provider = type.getDataProviderType();
            foreach string lexical in ("1 2", "01 +2", "1.0 +2.00", " \t+001\n02 ") {
                auto decoded = type.deserializeValue("value", definition.getTypeMap(), NOTHING, lexical);
                string encoded = type.serializeValue(definition.nsc, decoded, True);
                assertEq((number(1), number(2)), map number($1), encoded.split(" "));
                foreach AbstractDataProviderType provider in (original_provider,
                        Serializable::deserialize(original_provider.serialize())) {
                    auto converted = provider.acceptsValue(lexical);
                    assertEq((number(1), number(2)), map number($1), converted);
                }
            }
            foreach string lexical in ("2 1", "1 3", "1", "1 2 3", "1 bad", "") {
                assertThrows("SOAP-DESERIALIZATION-ERROR", \type.deserializeValue(),
                    ("value", definition.getTypeMap(), NOTHING, lexical));
                assertThrows("SOAP-SERIALIZATION-ERROR", \type.serializeValue(), (definition.nsc, lexical, True));
                assertThrows("RUNTIME-TYPE-ERROR", \original_provider.acceptsValue(), (lexical,));
            }
        }
    }

    private distinctChoices() {
        XsdSchema original = schema("t:Booleans t:Integers", '<xs:enumeration value="1 0"/>');
        foreach XsdSchema definition in (original, Serializable::deserialize(original.serialize())) {
            XsdAbstractType type = definition.findType(make_qname("urn:union-lists", "Value"));
            AbstractDataProviderType provider = Serializable::deserialize(type.getDataProviderType().serialize());
            assertEq((True, False), type.deserializeValue("value", definition.getTypeMap(), NOTHING, "true false"));
            assertEq((True, False), provider.acceptsValue(("true", "false")));
            foreach string lexical in ("01 0", "1 00", "0 1") {
                assertThrows("SOAP-DESERIALIZATION-ERROR", \type.deserializeValue(),
                    ("value", definition.getTypeMap(), NOTHING, lexical));
                assertThrows("SOAP-SERIALIZATION-ERROR", \type.serializeValue(), (definition.nsc, lexical, True));
                assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (lexical.split(" "),));
            }
        }
    }

    private emptyChoices() {
        XsdSchema definition = schema("t:Booleans t:Integers", '<xs:enumeration value=""/>');
        XsdAbstractType type = definition.findType(make_qname("urn:union-lists", "Value"));
        AbstractDataProviderType provider = Serializable::deserialize(type.getDataProviderType().serialize());
        foreach string lexical in ("", " \t\r\n ") {
            assertEq((), type.deserializeValue("value", definition.getTypeMap(), NOTHING, lexical));
            assertEq("", type.serializeValue(definition.nsc, lexical, True));
            assertEq((), provider.acceptsValue(lexical));
        }
        assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (("0",),));
        assertThrows("MISSING-VALUE-ERROR", \provider.acceptsValue(), (NOTHING,));
    }

    private patterns() {
        XsdSchema definition = schema("t:Booleans t:Integers", '<xs:pattern value="1  0"/>');
        XsdAbstractType type = definition.findType(make_qname("urn:union-lists", "Value"));
        AbstractDataProviderType provider = Serializable::deserialize(type.getDataProviderType().serialize());
        foreach string lexical in ("1  0", "1 0", " 1  0 ") {
            assertThrows("SOAP-DESERIALIZATION-ERROR", \type.deserializeValue(),
                ("value", definition.getTypeMap(), NOTHING, lexical));
            assertThrows("SOAP-SERIALIZATION-ERROR", \type.serializeValue(), (definition.nsc, lexical, True));
            assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (lexical,));
        }
        XsdSimpleType simple = cast<XsdSimpleType>(type);
        assertThrows("XSD-SAMPLE-ERROR", \simple.getSampleValue(), ((),));
    }

    private fields() {
        XsdSchema definition = schema("t:Booleans t:Integers");
        UnionDataType provider = definition.findType(make_qname("urn:union-lists", "Value")).getDataProviderType();
        XsdUnionDataField original({"name": "flags", "type": provider,
            "allowed_values": (("01", "00"),)}, provider);
        foreach XsdUnionDataField field in (original, Serializable::deserialize(original.serialize())) {
            assertEq(("01", "00"), field.acceptsValue(("01", "00")));
            assertEq(("+1", "-0"), field.acceptsValue(("+1", "-0")));
            assertThrows("FIELD-VALUE-ERROR", \field.acceptsValue(), (("1", "0"),));
            assertThrows("FIELD-VALUE-ERROR", \field.acceptsValue(), (("00", "01"),));
            assertThrows("RUNTIME-TYPE-ERROR", \field.setAllowedValues(), ((("12",), ("bad",)),));
            assertEq(("01", "00"), field.acceptsValue(("01", "00")));
        }
    }

    private metadata() {
        XsdSchema definition = schema("t:Booleans t:Integers");
        UnionDataType original = definition.findType(make_qname("urn:union-lists", "Base")).getDataProviderType();
        hash<SerializationInfo> saved = original.serializeToData();
        *string item_index;
        *string list_index;
        foreach string index in (keys saved._index) {
            if (saved._index{index}.hasKey("_hash") && saved._index{index}._hash == "WSDL::XsdUnionAtomicInfo") {
                item_index = index;
            }
            if (saved._index{index}.hasKey("_hash") && saved._index{index}._hash == "WSDL::XsdUnionListInfo") {
                list_index = index;
            }
        }
        assertTrue(exists item_index && exists list_index);
        foreach hash<auto> invalid in ({"builtin": "dateTime"}, {"white_space": "preserve"},
                {"preserve_lexical": 1}, {"provider": NOTHING}) {
            hash<SerializationInfo> state = saved;
            state._index{item_index}._members += invalid;
            assertThrows(invalid.hasKey("preserve_lexical") ? "RUNTIME-TYPE-ERROR" : "DESERIALIZATION-ERROR",
                \Serializable::deserialize(), (state,));
            assertEq(("01", "00"), Serializable::deserialize(saved).acceptsValue(("01", "00")));
        }
        hash<SerializationInfo> state = saved;
        state._index{list_index}._members.provider = NOTHING;
        assertThrows("DESERIALIZATION-ERROR", \Serializable::deserialize(), (state,));
        foreach auto invalid in ("list", (), NULL, ("bad", "bad")) {
            state = saved;
            state._index."0"._class_data."WSDL::UnionDataType".list_members = invalid;
            assertThrows("DESERIALIZATION-ERROR", \Serializable::deserialize(), (state,));
        }
        original.types = (original.types[1], original.types[0]);
        foreach UnionDataType provider in (original, Serializable::deserialize(original.serialize())) {
            assertEq(("01", "00"), provider.acceptsValue(("01", "00")));
            assertEq((1, 0), provider.acceptsValue("1 0"));
            assertEq(provider.valueKey("01 00"), provider.valueKey("1 0"));
            assertEq((True, False), provider.acceptsValue("true false"));
        }
        original.types = (original.types[0],);
        UnionDataType reduced = Serializable::deserialize(original.serialize());
        assertEq(("01", "00"), reduced.acceptsValue("01 00"));
        assertThrows("RUNTIME-TYPE-ERROR", \reduced.acceptsValue(), ("true false",));
        state = original.serializeToData();
        remove state._index."0"._class_data."WSDL::UnionDataType".list_members;
        assertEq((12, 2), Serializable::deserialize(state).acceptsValue(("12", "2")));
    }

    private probeErrors() {
        XsdSchema definition = schema("t:Booleans t:Integers");
        XsdSimpleType schema_type = definition.findType(make_qname("urn:union-lists", "Base"));
        UnionListSchemaFailure schema_failure(definition.nsc);
        schema_type.unionTypes = (schema_failure,) + schema_type.unionTypes;
        foreach string error in ("TEST-CANCELLED", "TEST-PROBE-ERROR", "PARSE-HEX-ERROR") {
            schema_failure.error = error;
            assertThrows(error, \schema_type.deserializeValue(),
                ("value", definition.getTypeMap(), NOTHING, "1 0"));
            schema_failure.error = NOTHING;
            assertEq((True, False), schema_type.deserializeValue("value", definition.getTypeMap(), NOTHING, "1 0"));
        }
        UnionDataType provider = definition.findType(make_qname("urn:union-lists", "Value")).getDataProviderType();
        UnionListProviderFailure failure();
        provider.types = (failure,) + provider.types;
        foreach string error in ("TEST-CANCELLED", "TEST-PROBE-ERROR", "PARSE-HEX-ERROR") {
            failure.error = error;
            assertThrows(error, \provider.acceptsValue(), (("1", "0"),));
            failure.error = NOTHING;
            assertEq((True, False), provider.acceptsValue(("1", "0")));
        }
    }

    private singleItems() {
        XsdSchema definition = schema("xs:boolean t:Integers", '<xs:enumeration value="01"/>');
        XsdAbstractType type = definition.findType(make_qname("urn:union-lists", "Value"));
        AbstractDataProviderType provider = Serializable::deserialize(type.getDataProviderType().serialize());
        assertEq(("01",), type.deserializeValue("value", definition.getTypeMap(), NOTHING, "01"));
        assertEq(("+1",), provider.acceptsValue("+1"));
        foreach string input in ("true", "1", "0", "1 1") {
            assertThrows("SOAP-DESERIALIZATION-ERROR", \type.deserializeValue(),
                ("value", definition.getTypeMap(), NOTHING, input));
            assertThrows("SOAP-SERIALIZATION-ERROR", \type.serializeValue(), (definition.nsc, input, True));
            assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (input,));
        }
    }

    private binaryLists() {
        XsdSchema original = schema("t:Hex t:Base64");
        foreach XsdSchema definition in (original, Serializable::deserialize(original.serialize())) {
            XsdAbstractType type = definition.findType(make_qname("urn:union-lists", "Value"));
            AbstractDataProviderType provider = Serializable::deserialize(type.getDataProviderType().serialize());
            auto value = type.deserializeValue("value", definition.getTypeMap(), NOTHING, "QQ== Qg==");
            assertEq(("QQ==", "Qg=="), value);
            assertEq("QQ== Qg==", type.serializeValue(definition.nsc, value, True));
            assertEq(value, provider.acceptsValue(("QQ==", "Qg==")));
            assertEq(value, provider.acceptsValue("QQ== Qg=="));
            assertEq((parse_hex_string("41"), parse_hex_string("42")), provider.acceptsValue(("41", "42")));
            foreach auto invalid in (("",), ("QQ== Qg==",), (parse_hex_string(""),), (NOTHING,)) {
                assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (invalid,));
            }
        }
    }
}

class UnionListSchemaFailure inherits XsdBaseType {
    public {
        *string error;
    }
    constructor(Namespaces namespaces) : XsdBaseType("int", namespaces) {
    }
    auto serializeValue(Namespaces namespaces, auto value, *softbool omitType) {
        if (error && value.typeCode() == NT_LIST && value[0].typeCode() == NT_BOOLEAN) {
            throw error, "controlled list serialization probe failure";
        }
        throw "SOAP-SERIALIZATION-ERROR", "controlled initial list member rejection";
    }
    auto deserializeValue(string en, hash<string, XsdAbstractType> tmap, *hash<auto> mrh, auto value) {
        throw "SOAP-DESERIALIZATION-ERROR", "controlled initial list member rejection";
    }
}

class UnionListProviderFailure inherits XsdBooleanDataType {
    public {
        *string error;
    }
    auto acceptsValue(auto value) {
        if (error && value.typeCode() == NT_LIST && value[0].typeCode() == NT_BOOLEAN) {
            throw error, "controlled provider list probe failure";
        }
        throw "RUNTIME-TYPE-ERROR", "controlled initial list provider rejection";
    }
}
