#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class BuiltinListValuesTest

class BuiltinListValuesTest inherits QUnit::Test {
    constructor() : Test("XSD builtin list and name values", "1.0") {
        addTestCase("Builtin list unions compare collapsed ordered values", \unionValues());
        addTestCase("Builtin lists retain their own enumeration and pattern facets", \ownFacets());
        addTestCase("XML name lexical spaces use the XSD 1.0 character productions", \names());
        addTestCase("Builtin list tokens satisfy their item lexical type", \listTokens());
        addTestCase("Inherited builtin list facets and field choices", \inherited());
        addTestCase("Invalid name and builtin list enumeration declarations", \declarations());
        addTestCase("Detached name metadata rejects contradictory rules", \metadata());
        addTestCase("Builtin list identity remains distinct from atomic text", \identities());
        addTestCase("Builtin and user-defined lists share ordered string item values", \nativeLists());
        set_return_value(main());
    }
    private static XsdSchema schema(string builtin, string facets, bool as_union = False) {
        string base = as_union ? "t:Base" : "xs:" + builtin;
        string declaration = as_union ? '<xs:simpleType name="Base"><xs:union memberTypes="xs:'
            + builtin + ' xs:string"/></xs:simpleType>' : "";
        return new XsdSchema('<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
            xmlns:t="urn:builtin-values" targetNamespace="urn:builtin-values">' + declaration
            + '<xs:simpleType name="Value"><xs:restriction base="' + base + '">' + facets
            + '</xs:restriction></xs:simpleType></xs:schema>', {"async_only": True});
    }
    private static XsdSimpleType valueType(XsdSchema definition) {
        return definition.findType(make_qname("urn:builtin-values", "Value"));
    }
    private unionValues() {
        foreach string builtin in ("NMTOKENS", "IDREFS", "ENTITIES") {
            XsdSchema original = schema(builtin, '<xs:enumeration value="A B"/>', True);
            foreach XsdSchema definition in (original, Serializable::deserialize(original.serialize())) {
                XsdSimpleType type = valueType(definition);
                UnionDataType provider = Serializable::deserialize(type.getDataProviderType().serialize());
                foreach string lexical in ("A B", " A  B ", "A\tB", "A\r\nB") {
                    assertEq("A B", type.deserializeValue("value", definition.getTypeMap(), NOTHING, lexical));
                    assertEq("A B", type.serializeValue(definition.nsc, lexical, True));
                    assertEq("A B", provider.acceptsValue(lexical));
                    assertEq(provider.valueKey("A B"), provider.valueKey(lexical));
                }
                foreach string lexical in ("B A", "A C", "A", "") {
                    assertThrows("SOAP-DESERIALIZATION-ERROR", \type.deserializeValue(),
                        ("value", definition.getTypeMap(), NOTHING, lexical));
                    assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (lexical,));
                }
            }
        }
    }
    private ownFacets() {
        foreach string builtin in ("NMTOKENS", "IDREFS", "ENTITIES") {
            XsdSchema original = schema(builtin, '<xs:enumeration value=" A  B "/><xs:length value="2"/>'
                + '<xs:pattern value="A B"/>');
            foreach XsdSchema definition in (original, Serializable::deserialize(original.serialize())) {
                XsdSimpleType type = valueType(definition);
                AbstractDataProviderType provider = Serializable::deserialize(type.getDataProviderType().serialize());
                assertEq("A B", type.deserializeValue("value", definition.getTypeMap(), NOTHING, " A\t B "));
                assertEq("A B", provider.acceptsValue(" A\t B "));
                assertEq(("A B",), type.getAllowedValues());
                assertEq("A B", type.getSampleValue("default"));
                foreach string invalid in ("B A", "A C", "", "A", "A B C") {
                    assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (invalid,));
                    assertThrows("SOAP-SERIALIZATION-ERROR", \type.serializeValue(), (definition.nsc, invalid, True));
                }
            }
        }
    }
    private names() {
        Namespaces namespaces({});
        foreach string builtin in ("Name", "NCName", "NMTOKEN", "ID", "IDREF", "ENTITY") {
            XsdBaseType type = namespaces.getBaseType(builtin);
            AbstractDataProviderType provider = Serializable::deserialize(type.getDataProviderType().serialize());
            foreach string lexical in ("Alpha", "_a", "Αλφα", "中文", "á", "a·b") {
                assertEq(lexical, type.deserializeValue("value", new hash<string, XsdAbstractType>(), NOTHING, lexical));
                assertEq(lexical, type.serializeValue(namespaces, lexical, True));
                assertEq(lexical, provider.acceptsValue(lexical));
            }
            foreach auto invalid in (("Alpha",), {"value": "Alpha"}, parse_hex_string("4142")) {
                assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (invalid,));
                assertThrows("SOAP-SERIALIZATION-ERROR", \type.serializeValue(), (namespaces, invalid, True));
            }
            foreach string invalid in ("", "a b", "!", "a/b", "a" + chr(0) + "b", "Ͱ", "𐀀") {
                assertThrows("SOAP-DESERIALIZATION-ERROR", \type.deserializeValue(),
                    ("value", new hash<string, XsdAbstractType>(), NOTHING, invalid));
                assertThrows("SOAP-SERIALIZATION-ERROR", \type.serializeValue(), (namespaces, invalid, True));
                assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (invalid,));
            }
            if (builtin == "Name" || builtin == "NMTOKEN") {
                assertEq("a:b", provider.acceptsValue("a:b"));
            } else {
                assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), ("a:b",));
            }
            if (builtin == "NMTOKEN") {
                assertEq("1-name", provider.acceptsValue("1-name"));
                assertEq("́", provider.acceptsValue("́"));
            } else {
                assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), ("1-name",));
                assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), ("́",));
            }
        }
    }
    private listTokens() {
        Namespaces namespaces({});
        foreach string builtin in ("NMTOKENS", "IDREFS", "ENTITIES") {
            XsdBaseType type = namespaces.getBaseType(builtin);
            AbstractDataProviderType provider = Serializable::deserialize(type.getDataProviderType().serialize());
            assertEq("Αλφα 中文", provider.acceptsValue(" Αλφα\t中文 "));
            foreach string invalid in ("", "A !", "A a/b", "A Ͱ", "A 𐀀") {
                assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (invalid,));
                assertThrows("SOAP-DESERIALIZATION-ERROR", \type.deserializeValue(),
                    ("value", new hash<string, XsdAbstractType>(), NOTHING, invalid));
            }
            if (builtin == "NMTOKENS") {
                assertEq("1 a:b", provider.acceptsValue("1 a:b"));
            } else {
                assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), ("1 a:b",));
            }
        }
    }
    private inherited() {
        foreach string builtin in ("NMTOKENS", "IDREFS", "ENTITIES") {
            XsdSchema original = schema(builtin, '<xs:enumeration value=" A  B "/><xs:enumeration value="B A"/>');
            original.addSchemaString('<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
                xmlns:t="urn:builtin-values" targetNamespace="urn:builtin-values">
                <xs:simpleType name="Derived"><xs:restriction base="t:Value"><xs:pattern value="A B"/>
                </xs:restriction></xs:simpleType></xs:schema>');
            foreach XsdSchema definition in (original, Serializable::deserialize(original.serialize())) {
                XsdSimpleType type = definition.findType(make_qname("urn:builtin-values", "Derived"));
                AbstractDataProviderType provider = Serializable::deserialize(type.getDataProviderType().serialize());
                assertEq(("A B",), type.getAllowedValues());
                assertEq("A B", type.getSampleValue("unused"));
                assertEq("A B", provider.acceptsValue(" A\tB "));
                assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), ("B A",));
                AbstractDataProviderType optional = Serializable::deserialize(provider.getOrNothingType().serialize());
                assertNothing(optional.acceptsValue(NOTHING));
                assertEq("A B", optional.acceptsValue(" A\tB "));
                AbstractDataProviderType required = optional.getMandatoryType();
                assertThrows("MISSING-VALUE-ERROR", \required.acceptsValue(), (NOTHING,));
                QoreDataField field({"name": "names", "type": provider, "allowed_values": ("A B",)});
                assertEq("A B", field.acceptsValue("A\tB"));
                assertThrows("RUNTIME-TYPE-ERROR", \field.acceptsValue(), ("B A",));
            }
        }
    }
    private declarations() {
        foreach string builtin in ("NMTOKENS", "IDREFS", "ENTITIES", "Name", "NCName", "NMTOKEN") {
            foreach string invalid in ("", "!", "a/b", "Ͱ", "𐀀") {
                assertThrows("XSD-SIMPLETYPE-ERROR", \schema(),
                    (builtin, '<xs:enumeration value="' + invalid + '"/>'));
                XsdSchema valid = schema(builtin, '<xs:enumeration value="Alpha"/>');
                assertEq("Alpha", valueType(valid).getSampleValue("unused"));
            }
        }
    }
    private metadata() {
        Namespaces namespaces({});
        foreach string builtin in ("NMTOKENS", "IDREFS", "ENTITIES", "Name", "NCName", "NMTOKEN") {
            AbstractDataProviderType provider = namespaces.getBaseType(builtin).getDataProviderType();
            hash<SerializationInfo> original = provider.serializeToData();
            string index = original._index."0"._class_data."WSDL::XsdSizedRestrictionDataType".facets._index;
            foreach hash<auto> changes in ({"name_type": "unknown"}, {"white_space": "preserve"},
                    {"kind": "binary"}, {"name_type": (builtin == "NMTOKENS" || builtin == "IDREFS" || builtin == "ENTITIES") ? "Name" : "NMTOKENS"}) {
                hash<SerializationInfo> invalid = original;
                invalid._index{index}._members += changes;
                assertThrows("DESERIALIZATION-ERROR", \Serializable::deserialize(), (invalid,));
                assertEq("Alpha", Serializable::deserialize(original).acceptsValue(" Alpha "));
            }
        }
    }
    private identities() {
        XsdSchema definition = schema("NMTOKENS", "", True);
        UnionDataType provider = valueType(definition).getDataProviderType();
        assertEq("list:8:string:A", provider.valueKey(" A "));
        assertEq("string:!", provider.valueKey("!"));
        assertEq("list:8:string:A8:string:B", provider.valueKey(" A\tB "));
        XsdUnionDataField field({"name": "names", "type": provider, "allowed_values": (" A B ",)}, provider);
        foreach AbstractDataField current in (field, Serializable::deserialize(field.serialize())) {
            assertEq("A B", current.acceptsValue(" A\tB "));
            assertThrows("FIELD-VALUE-ERROR", \current.acceptsValue(), ("B A",));
        }
        UnionDataType members = provider.types[0];
        members.types = (members.types[1], members.types[0]);
        UnionDataType reordered = Serializable::deserialize(provider.serialize());
        assertEq("string:A B", reordered.valueKey("A B"));
        assertEq(" A\tB ", reordered.acceptsValue(" A\tB "));
    }
    private nativeLists() {
        foreach string builtin in ("NMTOKENS", "IDREFS", "ENTITIES") {
            XsdSchema original = schema(builtin, "");
            original.addSchemaString('<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
                xmlns:t="urn:builtin-values" targetNamespace="urn:builtin-values">
                <xs:simpleType name="Strings"><xs:list itemType="xs:string"/></xs:simpleType>
                <xs:simpleType name="Alternatives"><xs:union memberTypes="t:Value t:Strings"/></xs:simpleType>
                <xs:simpleType name="Selected"><xs:restriction base="t:Alternatives">
                <xs:enumeration value="A B"/></xs:restriction></xs:simpleType></xs:schema>');
            foreach XsdSchema definition in (original, Serializable::deserialize(original.serialize())) {
                XsdAbstractType type = definition.findType(make_qname("urn:builtin-values", "Selected"));
                UnionDataType provider = Serializable::deserialize(type.getDataProviderType().serialize());
                hash<SerializationInfo> corrupt = provider.serializeToData();
                int descriptors = 0;
                foreach string index in (keys corrupt._index) {
                    if (corrupt._index{index}.hasKey("_hash")
                            && corrupt._index{index}._hash == "WSDL::XsdUnionAtomicInfo"
                            && corrupt._index{index}._members.builtin == "string") {
                        corrupt._index{index}._members.builtin = builtin;
                        corrupt._index{index}._members.white_space = "collapse";
                        ++descriptors;
                    }
                }
                assertEq(1, descriptors);
                assertThrows("DESERIALIZATION-ERROR", \Serializable::deserialize(), (corrupt,));
                assertEq(("A", "B"), provider.acceptsValue(("A", "B")));
                assertEq(provider.valueKey(" A\tB "), provider.valueKey(("A", "B")));
                assertEq("A B", type.serializeValue(definition.nsc, ("A", "B"), True));
                assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (("B", "A"),));
                assertThrows("SOAP-SERIALIZATION-ERROR", \type.serializeValue(), (definition.nsc, ("B", "A"), True));
            }
        }
    }
}
