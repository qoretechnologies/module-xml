%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class CalendarFacetsTest

class InterruptCalendarProvider inherits XsdCalendarDataType {
    public {
        bool interrupt = True;
    }

    constructor() : XsdCalendarDataType("date") {
    }

    auto acceptsValue(auto value) {
        if (interrupt) {
            throw "PROGRAM-INTERRUPTED", "calendar provider conversion interrupted";
        }
        return XsdCalendarDataType::acceptsValue(value);
    }
}

class CalendarFacetsTest inherits QUnit::Test {
    constructor() : Test("XSD calendar facets", "1.0") {
        addTestCase("Enumerations compare timezone-normalized values", \enumerations());
        addTestCase("Absent zones form a separate timeline and partial order", \bounds());
        addTestCase("Arbitrary years and BCE transitions compare exactly", \extended());
        addTestCase("Patterns retain spelling across derived restrictions", \patterns());
        addTestCase("Contradictory, fixed and inherited bounds reject", \declarations());
        addTestCase("Provider choices compare calendar values atomically", \fields());
        addTestCase("Fixed attributes retain calendar values and timezone absence", \fixedValues());
        addTestCase("Lists and unions preserve calendar primitive identities", \collections());
        addTestCase("Examples satisfy calendar boundaries or fail explicitly", \examples());
        addTestCase("Inherited enumeration metadata retains the restricted subset", \inheritedChoices());
        addTestCase("Malformed public metadata and reconstructed providers reject", \metadata());
        addTestCase("Provider cancellation propagates and conversion recovers", \cancellation());
        set_return_value(main());
    }

    private static XsdSchema schema(string builtin, string facets, string parent = "", string extra = "") {
        return new XsdSchema('<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:calendar"
            targetNamespace="urn:calendar"><xs:simpleType name="Base"><xs:restriction base="xs:' + builtin + '">'
            + parent + '</xs:restriction></xs:simpleType><xs:simpleType name="Value"><xs:restriction base="t:Base">'
            + facets + '</xs:restriction></xs:simpleType>' + extra + '</xs:schema>', {"async_only": True});
    }

    private check(string builtin, string facets, list<string> valid, list<string> invalid, string parent = "") {
        XsdSchema original = schema(builtin, facets, parent);
        foreach XsdSchema definition in (original, Serializable::deserialize(original.serialize())) {
            XsdAbstractType type = definition.findType(make_qname("urn:calendar", "Value"));
            AbstractDataProviderType provider = type.getDataProviderType();
            foreach AbstractDataProviderType current in (provider, Serializable::deserialize(provider.serialize()),
                    provider.getOrNothingType().getMandatoryType()) {
                assertEq(builtin, cast<XsdCalendarRestrictionDataType>(current).getBuiltinName());
                foreach string value in (valid) {
                    auto decoded = type.deserializeValue("value", {}, NOTHING, value);
                    assertEq(decoded, current.acceptsValue(value));
                    assertEq(decoded, new ListDataType(current).acceptsValue((value,))[0]);
                    assertEq(value, type.serializeValue(new Namespaces({}), value, True));
                    assertEq(decoded, type.deserializeValue("value", {}, NOTHING,
                        type.serializeValue(new Namespaces({}), decoded, True)));
                }
                foreach string value in (invalid) {
                    assertThrows("SOAP-SERIALIZATION-ERROR", \type.serializeValue(), (new Namespaces({}), value, True), value);
                    assertThrows("SOAP-DESERIALIZATION-ERROR", \type.deserializeValue(), ("value", {}, NOTHING, value), value);
                    assertThrows("RUNTIME-TYPE-ERROR", \current.acceptsValue(), (value,), value);
                }
            }
        }
    }

    private enumerations() {
        check("date", '<xs:enumeration value="2002-10-10+13:00"/>',
            ("2002-10-10+13:00", "2002-10-09-11:00"), ("2002-10-10", "2002-10-10Z", "2002-10-09-10:00"));
        check("gMonthDay", '<xs:enumeration value="--01-02+14:00"/>',
            ("--01-02+14:00", "--01-01-10:00"), ("--01-02", "--01-02Z", "--01-01-09:00"));
        check("gDay", '<xs:enumeration value="---02+14:00"/>',
            ("---02+14:00", "---01-10:00"), ("---02", "---02Z", "---01-09:00"));
        hash<string, string> values = {"date": "2000-01-01", "gYear": "2000", "gYearMonth": "2000-01",
            "gMonthDay": "--01-01", "gMonth": "--01", "gDay": "---01"};
        foreach string builtin in (keys values) {
            string local = values{builtin};
            check(builtin, '<xs:enumeration value="' + local + 'Z"/>',
                (local + "Z", local + "+00:00", local + "-00:00"), (local, local + "-01:00", local + "+01:00"));
            check(builtin, '<xs:enumeration value="' + local + '"/>', (local,), (local + "Z", local + "+00:00"));
        }
    }

    private bounds() {
        check("date", '<xs:minInclusive value="2000-01-01Z"/>',
            ("2000-01-01Z", "2000-01-01-01:00", "2000-01-02"),
            ("2000-01-01", "2000-01-01+01:00", "1999-12-31Z"));
        check("date", '<xs:maxInclusive value="2000-01-01Z"/>',
            ("2000-01-01Z", "2000-01-01+01:00", "1999-12-31"),
            ("2000-01-01", "2000-01-01-01:00", "2000-01-02Z"));
        check("date", '<xs:minExclusive value="2000-01-01"/>',
            ("2000-01-02", "2000-01-02Z"), ("2000-01-01", "2000-01-01Z", "2000-01-02+10:00"));
        check("date", '<xs:maxExclusive value="2000-01-02"/>',
            ("2000-01-01", "2000-01-01Z"), ("2000-01-02", "2000-01-02Z", "2000-01-01-10:00"));
        check("gYear", '<xs:minExclusive value="2000Z"/><xs:maxInclusive value="2002Z"/>',
            ("2000-01:00", "2001", "2002Z"), ("2000Z", "2000", "2002-01:00"));
        check("gYearMonth", '<xs:minInclusive value="2000-02Z"/>', ("2000-02Z", "2000-03"),
            ("2000-02", "2000-01Z", "2000-02+01:00"));
        check("gMonth", '<xs:minInclusive value="--02Z"/>', ("--02Z", "--03"),
            ("--02", "--01Z", "--02+01:00"));
        check("gDay", '<xs:minInclusive value="---02Z"/>', ("---02Z", "---03"),
            ("---02", "---01Z", "---02+01:00"));
    }

    private extended() {
        check("date", '<xs:enumeration value="0001-01-01+14:00"/>',
            ("0001-01-01+14:00", "-0001-12-31-10:00"), ("-0001-12-31Z", "0001-01-01Z"));
        check("date", '<xs:enumeration value="-0004-03-01+14:00"/>',
            ("-0004-03-01+14:00", "-0004-02-29-10:00"), ("-0004-02-28-10:00",));
        string magnitude = "1" + strmul("0", 100);
        string preceding = strmul("9", 100);
        check("date", '<xs:enumeration value="' + magnitude + '-01-01+14:00"/>',
            (magnitude + "-01-01+14:00", preceding + "-12-31-10:00"), (magnitude + "-01-01Z",));
        check("date", '<xs:enumeration value="-' + preceding + '-01-01+14:00"/>',
            ("-" + preceding + "-01-01+14:00", "-" + magnitude + "-12-31-10:00"),
            ("-" + preceding + "-01-01Z",));
        check("gYear", '<xs:minExclusive value="-' + magnitude + '"/><xs:maxExclusive value="' + magnitude + '"/>',
            ("-" + preceding, preceding, "-0001", "0001"), ("-" + magnitude, magnitude));
    }

    private patterns() {
        string lexical = "2000-01-01-00:00";
        check("date", '<xs:pattern value="2000-01-01-00:00"/>', (lexical,),
            ("2000-01-01Z", "2000-01-01+00:00"), '<xs:enumeration value="2000-01-01Z"/>');
        XsdSchema definition = schema("date", '<xs:pattern value="2000-01-01-00:00"/>');
        XsdAbstractType type = definition.findType(make_qname("urn:calendar", "Value"));
        assertEq(lexical, type.deserializeValue("value", {}, NOTHING, lexical));
        assertEq(lexical, type.getDataProviderType().acceptsValue(lexical));
        assertEq({"string": True}, type.getDataProviderType().getReturnTypeHash(True));
    }

    private declarations() {
        foreach string builtin in ("date", "gYear", "gYearMonth", "gMonthDay", "gMonth", "gDay") {
            foreach string facets in ('<xs:totalDigits value="2"/>', '<xs:fractionDigits value="0"/>',
                    '<xs:length value="1"/>', '<xs:whiteSpace value="preserve"/>', '<xs:enumeration value="bad"/>',
                    '<xs:minInclusive value="bad"/>') {
                assertThrows("XSD-SIMPLETYPE-ERROR", \schema(), (builtin, facets));
            }
        }
        foreach string facets in ('<xs:minInclusive value="2000-01-02Z"/><xs:maxInclusive value="2000-01-01Z"/>',
                '<xs:minInclusive value="2000-01-01"/><xs:maxInclusive value="2000-01-01Z"/>',
                '<xs:minInclusive value="2000-01-01Z"/><xs:minExclusive value="2000-01-01Z"/>',
                '<xs:minInclusive value="2000-01-01Z"/><xs:maxExclusive value="2000-01-01Z"/>') {
            assertThrows("XSD-SIMPLETYPE-ERROR", \schema(), ("date", facets));
        }
        assertThrows("XSD-SIMPLETYPE-ERROR", \schema(), ("date", '<xs:minInclusive value="1999-12-31Z"/>',
            '<xs:minInclusive value="2000-01-01Z"/>'));
        assertThrows("XSD-SIMPLETYPE-ERROR", \schema(), ("date", '<xs:minInclusive value="2000-01-02Z"/>',
            '<xs:minInclusive value="2000-01-01Z" fixed="true"/>'));
        check("date", '<xs:minInclusive value="2000-01-01-00:00"/>', ("2000-01-01Z",), ("1999-12-31Z",),
            '<xs:minInclusive value="2000-01-01Z" fixed="true"/>');
        check("date", '<xs:minExclusive value="2000-01-01-00:00"/>', ("2000-01-02Z",), ("2000-01-01Z",),
            '<xs:minExclusive value="2000-01-01Z"/>');
    }
    private fields() {
        XsdCalendarDataField original({"name": "delivery", "type": new XsdCalendarDataType("date"),
            "allowed_values": ("2002-10-10+13:00",)}, "date");
        foreach XsdCalendarDataField field in (original, Serializable::deserialize(original.serialize())) {
            assertEq(-39600, field.acceptsValue("2002-10-09-11:00").getUtcOffset());
            assertThrows("FIELD-VALUE-ERROR", \field.acceptsValue(), ("2002-10-10Z",));
            assertThrows("XSD-SIMPLETYPE-ERROR", \field.setAllowedValues(), (("2002-10-10Z", "bad"), False));
            assertEq("2002-10-10+13:00", field.getAllowedValues()[0].value);
            assertThrows("FIELD-VALUE-ERROR", \field.acceptsValue(), ("2002-10-10Z",));
            field.setAllowedValues(("2002-10-10Z",), True);
            assertEq("2002-10-10", field.acceptsValue("2002-10-10"));
        }
        XsdCalendarDataField repeated({"name": "deliveries", "type": new ListDataType(new XsdCalendarDataType("date"))}, "date");
        repeated.setElementAllowedValues(("2002-10-10+13:00",), False);
        assertEq(2, repeated.acceptsValue(("2002-10-10+13:00", "2002-10-09-11:00")).size());
        assertThrows("FIELD-VALUE-ERROR", \repeated.acceptsValue(), (("2002-10-10Z",),));
        assertThrows("XSD-SIMPLETYPE-ERROR", \repeated.setElementAllowedValues(), (("2002-10-10Z", "bad"), False));
        assertThrows("FIELD-VALUE-ERROR", \repeated.acceptsValue(), (("2002-10-10Z",),));
        hash<SerializationInfo> state = original.serializeToData();
        state._index."0"._class_data."WSDL::XsdCalendarDataField".builtin = "string";
        assertThrows("DESERIALIZATION-ERROR", \Serializable::deserialize(), (state,));
    }

    private fixedValues() {
        XsdSchema original = schema("date", "", "", '<xs:complexType name="Record">
            <xs:attribute name="delivery" type="t:Value" fixed="2002-10-10+13:00"/>
            <xs:attribute name="local" type="xs:date" fixed="2002-10-10"/></xs:complexType>');
        foreach XsdSchema definition in (original, Serializable::deserialize(original.serialize())) {
            XsdAbstractType record = definition.findType(make_qname("urn:calendar", "Record"));
            hash<auto> input = {"^attributes^": {"delivery": "2002-10-09-11:00", "local": "2002-10-10"}};
            hash<auto> decoded = record.deserializeValue("value", {}, NOTHING, input);
            assertEq(-39600, decoded."^attributes^".delivery.getUtcOffset());
            assertEq("2002-10-10", decoded."^attributes^".local);
            assertEq(input."^attributes^", record.serializeValue(new Namespaces({}), input, True)."^attributes^");
            AbstractDataProviderType provider = Serializable::deserialize(record.getDataProviderType().serialize());
            assertEq(decoded, provider.acceptsValue(input));
            AbstractDataField field = provider.getFields()."^attributes^".getType().getFields().delivery;
            assertTrue(field instanceof XsdCalendarDataField);
            assertEq(-39600, field.acceptsValue("2002-10-09-11:00").getUtcOffset());
            input."^attributes^".local = "2002-10-10Z";
            assertThrows("SOAP-SERIALIZATION-ERROR", \record.serializeValue(), (new Namespaces({}), input, True));
            assertThrows("SOAP-DESERIALIZATION-ERROR", \record.deserializeValue(), ("value", {}, NOTHING, input));
            assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (input,));
        }
    }

    private collections() {
        XsdSchema original = schema("date", "", "", '<xs:simpleType name="Items"><xs:list itemType="xs:date"/></xs:simpleType>
            <xs:simpleType name="Selected"><xs:restriction base="t:Items">
            <xs:enumeration value="2000-01-01Z 2000-01-02"/></xs:restriction></xs:simpleType>
            <xs:simpleType name="Either"><xs:union memberTypes="xs:date xs:string"/></xs:simpleType>
            <xs:simpleType name="OnlyDate"><xs:restriction base="t:Either"><xs:enumeration value="2000-01-01Z"/>
            </xs:restriction></xs:simpleType>
            <xs:simpleType name="ZText"><xs:restriction base="xs:string"><xs:pattern value=".*Z"/>
            </xs:restriction></xs:simpleType><xs:simpleType name="TextFirst"><xs:union memberTypes="t:ZText xs:date"/></xs:simpleType>
            <xs:simpleType name="OnlyText"><xs:restriction base="t:TextFirst"><xs:enumeration value="2000-01-01Z"/>
            </xs:restriction></xs:simpleType>
            <xs:simpleType name="MixedItems"><xs:list itemType="t:Either"/></xs:simpleType>
            <xs:simpleType name="MixedSelected"><xs:restriction base="t:MixedItems">
            <xs:enumeration value="2000-01-01Z label"/></xs:restriction></xs:simpleType>');
        foreach XsdSchema definition in (original, Serializable::deserialize(original.serialize())) {
            foreach string name in ("Selected", "MixedSelected") {
                string second = name == "Selected" ? "2000-01-02" : "label";
                XsdAbstractType items = definition.findType(make_qname("urn:calendar", name));
                list<auto> result = items.deserializeValue("value", {}, NOTHING, "2000-01-01-00:00 " + second);
                assertEq(NT_DATE, result[0].typeCode());
                assertEq(second, result[1]);
                AbstractDataProviderType provider = Serializable::deserialize(items.getDataProviderType().serialize());
                assertEq(result, provider.acceptsValue(("2000-01-01+00:00", second)));
                assertThrows("SOAP-DESERIALIZATION-ERROR", \items.deserializeValue(),
                    ("value", {}, NOTHING, "2000-01-01 " + second));
                assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (("2000-01-01", second),));
                assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), ((second, "2000-01-01Z"),));
            }
            XsdAbstractType either = definition.findType(make_qname("urn:calendar", "OnlyDate"));
            AbstractDataProviderType provider = Serializable::deserialize(either.getDataProviderType().serialize());
            assertEq(NT_DATE, either.deserializeValue("value", {}, NOTHING, "2000-01-01-00:00").typeCode());
            assertEq(NT_DATE, provider.acceptsValue("2000-01-01+00:00").typeCode());
            assertThrows("SOAP-DESERIALIZATION-ERROR", \either.deserializeValue(), ("value", {}, NOTHING, "2000-01-01"));
            assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), ("bad",));
            either = definition.findType(make_qname("urn:calendar", "OnlyText"));
            provider = Serializable::deserialize(either.getDataProviderType().serialize());
            assertEq("2000-01-01Z", either.deserializeValue("value", {}, NOTHING, "2000-01-01Z"));
            assertEq("2000-01-01Z", provider.acceptsValue("2000-01-01Z"));
            assertThrows("SOAP-DESERIALIZATION-ERROR", \either.deserializeValue(), ("value", {}, NOTHING, "2000-01-01+00:00"));
            assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), ("2000-01-01+00:00",));
        }
    }


    private examples() {
        foreach hash<auto> row in (
                {"base": "date", "low": "2000-01-01Z", "high": "2000-01-01-00:01"},
                {"base": "date", "low": "2000-01-01-14:00", "high": "2000-01-02+09:59"},
                {"base": "date", "low": "2000-02-28", "high": "2000-02-29"},
                {"base": "date", "low": "-0001-12-31", "high": "0001-01-01"},
                {"base": "date", "low": "999999999999999999999999999999-12-31", "high": "1000000000000000000000000000000-01-01"},
                {"base": "gYear", "low": "-0001", "high": "0001"},
                {"base": "gYearMonth", "low": "1999-12", "high": "2000-01"},
                {"base": "gMonthDay", "low": "--02-28", "high": "--02-29"},
                {"base": "gMonth", "low": "--02", "high": "--03"},
                {"base": "gDay", "low": "---01", "high": "---02"}) {
            XsdSchema definition = schema(row.base, '<xs:minExclusive value="' + row.low
                + '"/><xs:maxInclusive value="' + row.high + '"/>');
            XsdSimpleType type = cast<XsdSimpleType>(definition.findType(make_qname("urn:calendar", "Value")));
            assertEq(row.high, type.getSampleValue("bad"));
            definition = schema(row.base, '<xs:minInclusive value="' + row.low
                + '"/><xs:maxExclusive value="' + row.high + '"/>');
            type = cast<XsdSimpleType>(definition.findType(make_qname("urn:calendar", "Value")));
            assertEq(row.low, type.getSampleValue("bad"));
        }
        XsdSchema definition = schema("date", '<xs:minExclusive value="2000-01-01"/><xs:maxExclusive value="2000-01-01"/>');
        XsdSimpleType empty = cast<XsdSimpleType>(definition.findType(make_qname("urn:calendar", "Value")));
        assertThrows("XSD-SAMPLE-ERROR", \empty.getSampleValue(), ("bad",));
        definition = schema("date", '<xs:pattern value="bad"/>');
        empty = cast<XsdSimpleType>(definition.findType(make_qname("urn:calendar", "Value")));
        assertThrows("XSD-SAMPLE-ERROR", \empty.getSampleValue(), ("bad",));
        definition = schema("date", '<xs:pattern value="2000-01-01-00:00"/>');
        XsdSimpleType patterned = cast<XsdSimpleType>(definition.findType(make_qname("urn:calendar", "Value")));
        assertEq("2000-01-01-00:00", patterned.getSampleValue("bad"));
    }

    private inheritedChoices() {
        XsdSchema definition = schema("date", '<xs:minInclusive value="2000-01-02Z"/>',
            '<xs:enumeration value="2000-01-01Z"/><xs:enumeration value="2000-01-02Z"/>');
        XsdSimpleType type = cast<XsdSimpleType>(definition.findType(make_qname("urn:calendar", "Value")));
        list<auto> choices = type.getAllowedValues();
        assertEq(1, choices.size());
        assertEq("2000-01-02", choices[0].format("YYYY-MM-DD"));
        assertEq("2000-01-02Z", type.getSampleValue("bad"));
    }

    private static AbstractDataProviderType fromFacets(hash<XsdCalendarFacetInfo> facets) {
        return new XsdCalendarRestrictionDataType(facets, new XsdCalendarDataType("date"));
    }

    private metadata() {
        hash<XsdCalendarFacetInfo> valid = <XsdCalendarFacetInfo>{"name": "Value", "base_name": "date",
            "bounds": {"minInclusive": "2000-01-01Z"}};
        foreach hash<auto> change in ({"base_name": "string"}, {"bounds": {"minimum": "2000-01-01Z"}},
                {"bounds": {"minInclusive": "0000-01-01"}}, {"enumeration": ("2000-02-30",)},
                {"bounds": {"minInclusive": "2000-01-01Z", "minExclusive": "2000-01-01Z"}},
                {"bounds": {"minInclusive": "2000-01-02Z", "maxInclusive": "2000-01-01Z"}},
                {"bounds": {"minInclusive": "2000-01-01Z", "maxInclusive": "2000-01-01"}},
                {"patterns": ("[",)}) {
            hash<XsdCalendarFacetInfo> invalid = new hash<XsdCalendarFacetInfo>(valid + change);
            assertThrows("XSD-SIMPLETYPE-ERROR", \fromFacets(), (invalid,));
        }
        foreach AbstractDataProviderType wrong in (new XsdCalendarDataType("gYear"), new XsdIeeeDataType("double"),
                new XsdIntegerDataType("int"), new XsdDecimalDataType()) {
            assertThrows("XSD-SIMPLETYPE-ERROR", sub() { new XsdCalendarRestrictionDataType(valid, wrong); });
        }
        hash<XsdNumericFacetInfo> numeric = <XsdNumericFacetInfo>{"name": "Number", "base_name": "float", "bounds": {}};
        assertThrows("XSD-SIMPLETYPE-ERROR", sub() {
            new XsdNumericRestrictionDataType(numeric, new XsdCalendarDataType("date"));
        });
        AbstractDataProviderType original = fromFacets(valid);
        hash<SerializationInfo> state = original.serializeToData();
        string index = state._index."0"._class_data."WSDL::XsdCalendarRestrictionDataType".facets._index;
        state._index{index}._members.base_name = "gYear";
        assertThrows("DESERIALIZATION-ERROR", \Serializable::deserialize(), (state,));
        assertEq(0, Serializable::deserialize(original.serialize()).acceptsValue("2000-01-01Z").getUtcOffset());
        XsdCalendarDataType builtin("date");
        foreach auto invalid in ("gYearMonthBad", 1, NOTHING) {
            state = builtin.serializeToData();
            state._index."0"._class_data."WSDL::XsdCalendarDataType".datatype = invalid;
            assertThrows("DESERIALIZATION-ERROR", \Serializable::deserialize(), (state,));
        }
        state = builtin.serializeToData();
        state._index."0"._class_data."WSDL::XsdCalendarDataType".optional = "yes";
        assertThrows("DESERIALIZATION-ERROR", \Serializable::deserialize(), (state,));
        assertEq("2000-01-01", Serializable::deserialize(builtin.serialize()).acceptsValue("2000-01-01"));
    }

    private cancellation() {
        InterruptCalendarProvider base();
        XsdCalendarRestrictionDataType provider(<XsdCalendarFacetInfo>{"name": "Value", "base_name": "date",
            "bounds": {"minInclusive": "2000-01-01Z"}}, base);
        assertThrows("PROGRAM-INTERRUPTED", \provider.acceptsValue(), ("2000-01-02Z",));
        base.interrupt = False;
        assertEq("2000-01-02", provider.acceptsValue("2000-01-02Z").format("YYYY-MM-DD"));
        assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), ("1999-12-31Z",));
        assertEq("2000-01-03", provider.acceptsValue("2000-01-03Z").format("YYYY-MM-DD"));
    }


}
