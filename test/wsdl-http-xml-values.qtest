#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%requires ../qlib/SoapClient.qm
%requires ../qlib/SoapHandler.qm
%requires HttpServer
%exec-class HttpXmlValuesTest

class HttpXmlValuesTest inherits QUnit::Test {
    const Ns = "urn:http-xml";
    constructor() : Test("HTTP MIME XML schema values", "1.0") {
        addTestCase("Qualified roots, children and QName values survive saved graphs", \values());
        addTestCase("Independent prefixes and defaults decode by expanded identity", \independent());
        addTestCase("Wrong roots, invalid content and missing selected values reject", \invalid());
        addTestCase("Nil and retained XML use the selected element declaration", \nilAndRetained());
        addTestCase("Qualified MIME XML reaches real HTTP clients and handlers", \http());
        set_return_value(main());
    }
    private static string source() {
        return '<w:definitions xmlns:w="http://schemas.xmlsoap.org/wsdl/" xmlns:h="http://schemas.xmlsoap.org/wsdl/http/"'
            + ' xmlns:m="http://schemas.xmlsoap.org/wsdl/mime/" xmlns:t="urn:http-xml" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:http-xml">'
            + '<w:types><xs:schema targetNamespace="urn:http-xml" elementFormDefault="qualified">'
            + '<xs:complexType name="Record"><xs:sequence><xs:element name="count" type="xs:int"/>'
            + '<xs:element name="category" type="xs:QName"/></xs:sequence></xs:complexType>'
            + '<xs:element name="Order" type="t:Record" nillable="true"/>'
            + '<xs:element name="Receipt" type="t:Record" nillable="true"/></xs:schema></w:types>'
            + '<w:message name="Request"><w:part name="order" element="t:Order"/></w:message>'
            + '<w:message name="Response"><w:part name="receipt" element="t:Receipt"/></w:message>'
            + '<w:portType name="P"><w:operation name="send"><w:input message="t:Request"/><w:output message="t:Response"/></w:operation></w:portType>'
            + '<w:binding name="B" type="t:P"><h:binding verb="POST"/><w:operation name="send"><h:operation location="/send"/>'
            + '<w:input><m:mimeXml part="order"/></w:input><w:output><m:mimeXml part="receipt"/></w:output>'
            + '</w:operation></w:binding><w:service name="S"><w:port name="Endpoint" binding="t:B">'
            + '<h:address location="http://example.invalid/xml"/></w:port></w:service></w:definitions>';
    }
    private static list<WSOperation> operations() {
        WebService ws(source());
        return (ws.getOperation("send"), Serializable::deserialize(ws.serialize()).getOperation("send"),
            Serializable::deserialize(ws.getOperation("send").serialize()));
    }
    private static hash<auto> value(int count = 71) {
        return {"count":count, "category":new XsdQNameValue("urn:catalog", "p:Product")};
    }
    private checkValue(auto actual, int count = 71) {
        assertEq(count, actual.count);
        assertTrue(actual.category instanceof XsdQNameValue);
        assertTrue(actual.category.equals(new XsdQNameValue("urn:catalog", "other:Product")));
    }
    private checkWire(string wire, string root) {
        hash<auto> expanded = XsdBase::expandElementNamespaces(parse_xml(wire));
        assertEq(("{" + Ns + "}" + root,), keys expanded);
        hash<auto> content = expanded.firstValue();
        assertTrue(content.hasKey("{" + Ns + "}count"));
        assertTrue(content.hasKey("{" + Ns + "}category"));
    }
    private values() {
        foreach WSOperation op in (operations()) {
            binary before = op.nsc.serialize();
            hash<auto> request = op.serializeRequest({"order":value()});
            hash<auto> response = op.serializeResponse({"receipt":value(72)});
            checkWire(request.body, "Order");
            checkWire(response.body, "Receipt");
            checkValue(op.deserializeRequest(parse_xml(request.body)).order);
            checkValue(op.deserializeResponse(parse_xml(response.body)).receipt, 72);
            hash<auto> encoded = op.serializeRequest({"order":value()}, NOTHING, "ISO-8859-1",
                NOTHING, XGF_ADD_FORMATTING);
            assertTrue(encoded.body.find('encoding="ISO-8859-1"') >= 0);
            assertTrue(encoded.body.find("\n  <") >= 0);
            assertEq("text/xml;charset=ISO-8859-1", encoded.hdr."Content-Type");
            checkValue(op.deserializeRequest(parse_xml(encoded.body)).order);
            assertEq(before, op.nsc.serialize());
        }
    }
    private independent() {
        foreach WSOperation op in (operations()) {
            foreach bool request in (True, False) {
                string root = request ? "Order" : "Receipt";
                foreach string body in (
                        '<alt:' + root + ' xmlns:alt="urn:http-xml" xmlns:c="urn:catalog"><alt:count>71</alt:count><alt:category>c:Product</alt:category></alt:' + root + '>',
                        '<' + root + ' xmlns="urn:http-xml"><count>71</count><t:category xmlns="urn:catalog" xmlns:t="urn:http-xml" xsi:type="xs:QName" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xs="http://www.w3.org/2001/XMLSchema">Product</t:category></' + root + '>') {
                    auto actual = request ? op.deserializeRequest(parse_xml(body)).order
                        : op.deserializeResponse(parse_xml(body)).receipt;
                    checkValue(actual);
                }
            }
        }
    }
    private invalid() {
        foreach WSOperation op in (operations()) {
            foreach string body in ('<Order/>', '<x:Order xmlns:x="urn:wrong"/>',
                    '<t:Wrong xmlns:t="urn:http-xml"/>',
                    '<t:Order xmlns:t="urn:http-xml"><t:count>bad</t:count><t:category>Product</t:category></t:Order>',
                    '<t:Order xmlns:t="urn:http-xml"><t:category>Product</t:category></t:Order>',
                    '<t:Order xmlns:t="urn:http-xml"><count>71</count><t:category>Product</t:category></t:Order>') {
                assertThrows("SOAP-DESERIALIZATION-ERROR", sub() { op.deserializeRequest(parse_xml(body)); });
            }
            hash<auto> valid = parse_xml('<t:Order xmlns:t="urn:http-xml" xmlns:c="urn:catalog"><t:count>71</t:count><t:category>c:Product</t:category></t:Order>');
            hash<auto> extra = valid + {"extra":"value"};
            assertThrows("SOAP-DESERIALIZATION-ERROR", \op.deserializeRequest(), (extra,));
            hash<auto> repeated = valid;
            repeated{valid.firstKey()} = (valid.firstValue(), valid.firstValue());
            assertThrows("SOAP-DESERIALIZATION-ERROR", \op.deserializeRequest(), (repeated,));
            assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), ({},));
            assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(), ({"order":{"count":"bad", "category":"Product"}},));
        }
    }
    private nilAndRetained() {
        foreach WSOperation op in (operations()) {
            string nil_xml = '<t:Order xmlns:t="urn:http-xml" xmlns:i="http://www.w3.org/2001/XMLSchema-instance" i:nil="true"/>';
            assertEq({"order":NOTHING}, op.deserializeRequest(parse_xml(nil_xml)));
            hash<auto> nil_wire = op.serializeRequest({"order":NULL});
            assertEq({"order":NOTHING}, op.deserializeRequest(parse_xml(nil_wire.body)));
            XsdXmlValue retained('<a:Order xmlns:a="urn:http-xml" xmlns:b="urn:catalog"><a:count>0071</a:count><a:category>b:Product</a:category></a:Order>');
            XsdXmlValue with_pi('<a:Order xmlns:a="urn:http-xml" xmlns:b="urn:catalog">'
                + '<?application keep="yes"?><a:count>0071</a:count><a:category>b:Product</a:category></a:Order>');
            hash<auto> pi_wire = op.serializeRequest({"order":with_pi});
            assertTrue(pi_wire.body.find('<?application keep="yes"?>') >= 0);
            checkValue(op.deserializeRequest(parse_xml(pi_wire.body)).order);
            assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(),
                ({"order":new XsdXmlValue(retained.getXml(), {"xml:lang":"cs"})},));
            assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(),
                ({"order":new XsdXmlValue('<!DOCTYPE a:Order>' + retained.getXml())},));
            hash<auto> wire = op.serializeRequest({"order":retained});
            checkWire(wire.body, "Order");
            checkValue(op.deserializeRequest(parse_xml(wire.body)).order);
            assertTrue(wire.body.find("0071") >= 0);
            assertThrows("SOAP-SERIALIZATION-ERROR", \op.serializeRequest(),
                ({"order":new XsdXmlValue('<Order/>')},));
        }
    }
    private http() {
        WebService ws = Serializable::deserialize(new WebService(source()).serialize());
        HttpServer server();
        on_exit server.stop();
        SoapHandler handler(new PermissiveAuthenticator());
        server.setDefaultHandler("xml", handler);
        Queue received();
        code<auto(hash<auto>, auto)> callback = auto sub(hash<auto> cx, auto input) {
            received.push(input);
            return {"receipt":value(72)};
        };
        handler.addMethod(ws, ws.getOperation("send"), callback, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, "B");
        server.addListener(0);
        SoapClient client({"wsdl":ws, "service":"S", "port":"Endpoint",
            "url":sprintf("http://127.0.0.1:%d/", server.getListenerInfo(0).port), "timeout":30000});
        hash<auto> info;
        checkValue(client.callOperation("send", {"order":value()}, NOTHING, \info).receipt, 72);
        checkValue(received.get(30000).order);
        checkWire(info."request-body", "Order");
        checkWire(info."response-body", "Receipt");
    }
}
