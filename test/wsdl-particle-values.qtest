#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class ParticleValuesTest

class ParticleEncodingProbe inherits XsdBaseType {
    constructor(Namespaces nsc) : XsdBaseType("int", nsc) {
    }
    auto serializeValue(Namespaces nsc, auto value, *softbool omitType) {
        if (value == 13) {
            throw "SOAP-SERIALIZATION-ERROR", "probe rejects 13 only on the encode path";
        }
        return XsdBaseType::serializeValue(nsc, value, omitType);
    }
}


class ParticleValuesTest inherits QUnit::Test {
    constructor() : Test("Ordered particle value conversion", "1.0") {
        addTestCase("Optional and repeated sequences validate the complete group", \sequences());
        addTestCase("Nested choices reject mixed and incomplete alternatives", \choices());
        addTestCase("Fixed boundaries use each selected declaration's value constraints", \boundaries());
        addTestCase("Repeated list-valued children retain one list per occurrence", \lists());
        addTestCase("Named group continuations and reconstruction retain ordered values", \references());
        addTestCase("All order and exact large nullable counts decode correctly", \counts());
        addTestCase("Retained XML and provider reconstruction preserve interleaved values", \retained());
        addTestCase("Retained validation scopes preserve encode checks and concurrent native callers", \scopes());
        addTestCase("An optional inner group does not make its enclosing element optional", \wrappers());
        addTestCase("Extension order and namespace identities select the right children", \extension());
        addTestCase("Malformed child names and unknown XML metadata are rejected", \malformed());
        set_return_value(main());
    }
    private XsdSchema schema(string model, string declarations = "") {
        return new XsdSchema('<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:values"
            targetNamespace="urn:values">' + declarations + '<xs:complexType name="Record">' + model
            + '</xs:complexType><xs:element name="record" type="t:Record"/></xs:schema>');
    }
    private string element(string name, string properties = "", string type = "int") {
        return sprintf('<xs:element name="%s" type="xs:%s" %s/>', name, type, properties);
    }
    private auto decode(XsdSchema schema, string content) {
        hash<auto> data = XsdBase::expandElementNamespaces(parse_xml('<t:record xmlns:t="urn:values"'
            ' xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">' + content + '</t:record>', XPF_PRESERVE_ORDER));
        return schema.getElement("urn:values", "record").deserializeValue(schema.getTypeMap(), NOTHING,
            data."{urn:values}record", True);
    }
    private rejected(XsdSchema schema, list<string> contents) {
        foreach string content in (contents) {
            assertThrows("SOAP-DESERIALIZATION-ERROR", \decode(), (schema, content));
        }
    }
    sequences() {
        XsdSchema s = schema('<xs:sequence minOccurs="0" maxOccurs="2">' + element("a") + element("b")
            + '</xs:sequence>');
        assertEq({"a": NOTHING, "b": NOTHING}, decode(s, ""));
        assertEq({"a": 1, "b": 2}, decode(s, '<a>01</a><b>2</b>'));
        assertEq({"a": (1, 3), "b": (2, 4)}, decode(s, '<a>1</a><b>2</b><a>3</a><b>4</b>'));
        rejected(s, ('<a>1</a>', '<b>2</b>', '<b>2</b><a>1</a>', '<a>1</a><a>3</a><b>2</b><b>4</b>',
            '<a>1</a><b>2</b><a>3</a>', '<a>1</a><b>2</b><a>3</a><b>4</b><a>5</a><b>6</b>'));
        assertEq({"a": 1, "b": 2}, decode(s, '<a>1</a><b>2</b>'));
    }
    choices() {
        XsdSchema s = schema('<xs:sequence><xs:choice minOccurs="2" maxOccurs="3"><xs:sequence>'
            + element("a") + element("b") + '</xs:sequence>' + element("c") + '</xs:choice>'
            + element("d") + '</xs:sequence>');
        assertEq({"a": 1, "b": 2, "c": 3, "d": 4}, decode(s, '<c>3</c><a>1</a><b>2</b><d>4</d>'));
        assertEq({"a": (1, 5), "b": (2, 6), "c": 3, "d": 4},
            decode(s, '<a>1</a><b>2</b><c>3</c><a>5</a><b>6</b><d>4</d>'));
        rejected(s, ('<c>3</c><d>4</d>', '<a>1</a><c>3</c><b>2</b><d>4</d>',
            '<a>1</a><b>2</b><c>3</c>', '<d>4</d><c>3</c><c>5</c>'));
        s = schema('<xs:choice><xs:choice><xs:sequence>' + element("a") + element("b")
            + '</xs:sequence>' + element("c") + '</xs:choice></xs:choice>');
        rejected(s, ('<a>1</a><b>2</b><c>3</c>', '<a>1</a>'));
        assertEq({"a": 1, "b": 2}, decode(s, '<a>1</a><b>2</b>'));
    }
    boundaries() {
        XsdSchema s = schema('<xs:sequence>' + element("a", 'minOccurs="2" maxOccurs="2"')
            + element("a", 'nillable="true"') + '</xs:sequence>');
        assertEq({"a": (1, 2, NOTHING)}, decode(s, '<a>1</a><a>2</a><a xsi:nil="true"/>'));
        rejected(s, ('<a xsi:nil="true"/><a>2</a><a>3</a>', '<a>1</a><a xsi:nil="true"/><a>3</a>',
            '<a>1</a><a>2</a>', '<a>1</a><a>bad</a><a>3</a>'));
    }
    lists() {
        XsdSchema s = schema('<xs:sequence minOccurs="2" maxOccurs="2">'
            '<xs:element name="items" type="t:Integers"/>' + element("tag") + '</xs:sequence>',
            '<xs:simpleType name="Integers"><xs:list itemType="xs:int"/></xs:simpleType>');
        assertEq({"items": ((1, 2), ()), "tag": (3, 4)},
            decode(s, '<items>1 2</items><tag>3</tag><items/><tag>4</tag>'));
        rejected(s, ('<items>1 bad</items><tag>3</tag><items/><tag>4</tag>',
            '<items>1 2</items><items/><tag>3</tag><tag>4</tag>'));
    }
    references() {
        XsdSchema original = schema('<xs:sequence><xs:group ref="t:Pair" minOccurs="0" maxOccurs="2"/>'
            + element("c") + '<xs:group ref="t:Pair"/></xs:sequence>',
            '<xs:group name="Pair"><xs:sequence>' + element("a") + element("b") + '</xs:sequence></xs:group>');
        foreach XsdSchema s in (original, Serializable::deserialize(original.serialize())) {
            assertEq({"a": 1, "b": 2, "c": 3}, decode(s, '<c>3</c><a>1</a><b>2</b>'));
            assertEq({"a": (1, 4), "b": (2, 5), "c": 3}, decode(s, '<a>1</a><b>2</b><c>3</c><a>4</a><b>5</b>'));
            rejected(s, ('<c>3</c>', '<a>1</a><b>2</b><c>3</c>', '<a>1</a><c>3</c><a>4</a><b>5</b>'));
        }
    }
    counts() {
        XsdSchema s = schema('<xs:all>' + element("a") + element("b") + '</xs:all>');
        assertEq({"a": 1, "b": 2}, decode(s, '<b>2</b><a>1</a>'));
        rejected(s, ('<a>1</a>', '<a>1</a><b>2</b><a>3</a>'));
        string huge = "1" + strmul("0", 80);
        s = schema(sprintf('<xs:sequence minOccurs="%s" maxOccurs="%s">', huge, huge)
            + element("a", 'minOccurs="0"') + '</xs:sequence>');
        assertEq({"a": NOTHING}, decode(s, ""));
        assertEq({"a": (1, 2, 3)}, decode(s, '<a>1</a><a>2</a><a>3</a>'));
        rejected(s, ('<b>1</b>',));
    }
    retained() {
        XsdSchema original = schema('<xs:choice minOccurs="2" maxOccurs="unbounded">'
            + element("a") + element("b") + '</xs:choice>');
        string xml = '<t:record xmlns:t="urn:values"><a>001</a><b>02</b><a>3</a></t:record>';
        foreach XsdSchema s in (original, Serializable::deserialize(original.serialize())) {
            XsdXmlValue value = s.getXmlValue(xml);
            assertEq(xml, value.getXml());
            assertEq(("{}a", "{}b", "{}a"), map $1.getExpandedName(), value.getChildValues());
            assertEq({"a": (1, 3), "b": 2}, s.getElement("urn:values", "record")
                .validateXmlValue(value, s.nsc, s.getTypeMap()));
            AbstractDataProviderType provider = s.getXmlDataProviderType("urn:values", "record");
            foreach AbstractDataProviderType type in (provider, Serializable::deserialize(provider.serialize())) {
                assertTrue(type.acceptsValue(value) === value);
                assertThrows("SOAP-SERIALIZATION-ERROR", \type.acceptsValue(),
                    (new XsdXmlValue('<t:record xmlns:t="urn:values"><a>1</a></t:record>'),));
                assertThrows("SOAP-SERIALIZATION-ERROR", \type.acceptsValue(),
                    (new XsdXmlValue('<t:record xmlns:t="urn:values"><a>1</a><b>bad</b></t:record>'),));
                assertTrue(type.acceptsValue(value) === value);
            }
        }
    }

    wrappers() {
        XsdSchema s = schema('<xs:sequence><xs:element name="container"><xs:complexType>'
            '<xs:choice minOccurs="0">' + element("a") + element("b")
            + '</xs:choice></xs:complexType></xs:element></xs:sequence>');
        XsdComplexType record = cast<XsdComplexType>(s.findType("Record"));
        assertEq(1, record.elementmap.container.minOccurs);
        # issue #5465: the present container of an emptiable choice decodes as an empty record
        assertEq({"container": {}}, decode(s, '<container/>'));
        rejected(s, ("", '<a>1</a>'));
        XsdXmlValue value = s.serializeXmlValue("urn:values", "record", {"container": {}});
        assertEq(("{}container",), map $1.getExpandedName(), value.getChildValues());
    }
    extension() {
        XsdSchema original = schema('<xs:complexContent><xs:extension base="t:Base"><xs:sequence>'
            + element("a", 'form="qualified"') + '</xs:sequence></xs:extension></xs:complexContent>',
            '<xs:complexType name="Base"><xs:sequence>' + element("a") + '</xs:sequence></xs:complexType>');
        foreach XsdSchema s in (original, Serializable::deserialize(original.serialize())) {
            assertEq({"{}a": 1, "{urn:values}a": 2}, decode(s, '<a>1</a><t:a>2</t:a>'));
            rejected(s, ('<t:a>2</t:a><a>1</a>', '<a>1</a><a>2</a>',
                '<a>1</a><q:a xmlns:q="urn:other">2</q:a>'));
        }
    }
    scopes() {
        XsdSchema s = schema('<xs:sequence>' + element("a") + '</xs:sequence>');
        XsdComplexType record = cast<XsdComplexType>(s.findType("Record"));
        record.elementmap.a.type = new ParticleEncodingProbe(s.nsc);
        XsdElement root = s.getElement("urn:values", "record");
        Qore::Thread::Queue ready();
        Qore::Thread::Queue start();
        Qore::Thread::Queue results();
        Qore::Thread::Counter running();
        on_exit {
            for (int index = 0; index < 4; ++index) {
                start.push(True);
            }
            assertEq(0, running.waitForZero(30s));
        }
        for (int index = 0; index < 4; ++index) {
            int number = index % 2 ? 7 : 13;
            running.inc();
            background sub () {
                on_exit running.dec();
                try {
                    ready.push(True);
                    start.get(30s);
                    string content = sprintf('<a>%d</a>', number);
                    XsdXmlValue value('<t:record xmlns:t="urn:values">' + content + '</t:record>');
                    *hash<ExceptionInfo> error;
                    *hash<auto> converted;
                    try {
                        converted = root.validateXmlValue(value, s.nsc, s.getTypeMap());
                    } catch (hash<ExceptionInfo> ex) {
                        error = ex;
                    }
                    results.push({"number": number, "error": error, "converted": converted,
                        "native": decode(s, '<a>13</a>')});
                } catch (hash<ExceptionInfo> ex) {
                    results.push({"unexpected": ex});
                }
            }();
        }
        for (int index = 0; index < 4; ++index) {
            assertTrue(ready.get(30s));
        }
        for (int index = 0; index < 4; ++index) {
            start.push(True);
        }
        for (int index = 0; index < 4; ++index) {
            hash<auto> result = results.get(30s);
            assertFalse(exists result.unexpected);
            assertEq({"a": 13}, result.native);
            if (result.number == 13) {
                assertEq("SOAP-SERIALIZATION-ERROR", result.error.err);
                assertRegex("probe rejects 13", result.error.desc);
            } else {
                assertFalse(exists result.error);
                assertEq({"a": 7}, result.converted);
            }
        }
    }

    malformed() {
        XsdSchema s = schema('<xs:sequence>' + element("a") + '</xs:sequence>');
        XsdComplexType record = cast<XsdComplexType>(s.findType("Record"));
        foreach hash<auto> invalid in ({"{}1a": "1"}, {"{}a": "1", "^unknown^": "extra"},
                {"{}a": "1", ".unknown": "extra"}, {"{}a": "1", "^commentUnknown^": "extra"},
                {"{}a": ()}) {
            assertThrows("SOAP-DESERIALIZATION-ERROR", \record.deserializeValue(),
                ("record", s.getTypeMap(), NOTHING, invalid));
        }
        assertEq({"a": 1}, decode(s, '<a>1</a>'));
        XsdSchema mixed_schema('<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">'
            '<xs:complexType name="Record" mixed="true"><xs:sequence>' + element("a")
            + '</xs:sequence></xs:complexType></xs:schema>');
        XsdComplexType mixed_record = cast<XsdComplexType>(mixed_schema.findType("Record"));
        foreach string key in ("^valueUnknown^", "^cdataUnknown^") {
            hash<auto> invalid = {"{}a": "1"};
            invalid{key} = "extra";
            assertThrows("SOAP-DESERIALIZATION-ERROR", \mixed_record.deserializeValue(),
                ("record", mixed_schema.getTypeMap(), NOTHING, invalid));
        }
    }

}
