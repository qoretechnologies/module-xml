#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class BooleanFacetTest

class BooleanFacetTest inherits QUnit::Test {
    constructor() : Test("XSD boolean lexical restrictions", "1.0") {
        addTestCase("Patterns retain XML spellings in both directions", \patterns());
        addTestCase("Native booleans use canonical lexical forms", \nativeValues());
        addTestCase("Inherited patterns intersect same-step alternatives", \inheritance());
        addTestCase("Inapplicable boolean facets reject schema declarations", \declarations());
        addTestCase("Detached optional and nested providers retain constraints", \providers());
        addTestCase("Inherited defaults still satisfy restriction patterns", \defaults());
        addTestCase("Reconstruction validates boolean metadata", \metadata());
        addTestCase("Patterned list items retain their spellings", \listItems());
        addTestCase("Fixed attributes compare boolean values", \fixedAttributes());
        addTestCase("Fixed attribute declarations accept equivalent boolean spellings", \fixedDerivation());
        addTestCase("Finite field choice replacements are atomic", \fieldUpdates());
        addTestCase("Examples exhaust all four boolean spellings", \samples());
        addTestCase("Cancellation propagates without changing input", \cancellation());
        set_return_value(main());
    }

    private static XsdSchema schema(string facets, string parent = "", string extra = "") {
        return new XsdSchema('<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:boolean-facets"
            targetNamespace="urn:boolean-facets"><xs:simpleType name="Base"><xs:restriction base="xs:boolean">'
            + parent + '</xs:restriction></xs:simpleType><xs:simpleType name="Value"><xs:restriction base="t:Base">'
            + facets + '</xs:restriction></xs:simpleType>' + extra + '</xs:schema>', {"async_only": True});
    }

    private static XsdSimpleType valueType(XsdSchema definition) {
        return cast<XsdSimpleType>(definition.findType(make_qname("urn:boolean-facets", "Value")));
    }

    private patterns() {
        XsdSchema original = schema('<xs:pattern value="0|1"/>');
        foreach XsdSchema definition in (original, Serializable::deserialize(original.serialize())) {
            XsdSimpleType type = valueType(definition);
            foreach string valid in ("0", "1") {
                assertEq(valid, type.deserializeValue("flag", definition.getTypeMap(), NOTHING, " \t" + valid + "\n"));
                assertEq(valid, type.serializeValue(new Namespaces({}), valid, True));
                assertEq({"^comment^": "flag", "^value^": valid}, type.serializeValue(new Namespaces({}),
                    {"^comment^": "flag", "^value^": valid}, True));
                assertEq(valid, type.deserializeValue("flag", definition.getTypeMap(), NOTHING,
                    {"^value^": " ", "^cdata^": valid, "^value1^": " "}));
            }
            foreach auto invalid in ("true", "false", "01", "yes", "1\u00a0", "", "1 0", {"child": "1"}) {
                assertThrows("SOAP-DESERIALIZATION-ERROR", \type.deserializeValue(),
                    ("flag", definition.getTypeMap(), NOTHING, invalid));
                assertThrows("SOAP-SERIALIZATION-ERROR", \type.serializeValue(), (new Namespaces({}), invalid, True));
            }
        }
    }

    private nativeValues() {
        XsdSchema definition = schema('<xs:pattern value="true|false"/>');
        XsdSimpleType type = valueType(definition);
        foreach auto value in (True, False, 1, 0, 1.0, 0.0, 1n, 0n) {
            string lexical = value == 1 ? "true" : "false";
            assertEq(lexical, type.serializeValue(new Namespaces({}), value, True));
            assertEq(lexical, type.getDataProviderType().acceptsValue(value));
        }
        definition = schema('<xs:pattern value="0|1"/>');
        type = valueType(definition);
        AbstractDataProviderType provider = type.getDataProviderType();
        foreach auto value in (True, False, 1, 0, 2, -1, 0.5, NULL) {
            assertThrows("SOAP-SERIALIZATION-ERROR", \type.serializeValue(), (new Namespaces({}), value, True));
            assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (value,));
        }
        definition = schema("");
        assertEq(False, valueType(definition).deserializeValue("flag", definition.getTypeMap(), NOTHING, "0"));
        assertEq(True, valueType(definition).getDataProviderType().acceptsValue("1"));
    }

    private inheritance() {
        XsdSchema definition = schema('<xs:pattern value="false"/><xs:pattern value="0"/>',
            '<xs:pattern value="0|1"/>');
        XsdSimpleType type = valueType(definition);
        assertEq("0", type.deserializeValue("flag", definition.getTypeMap(), NOTHING, "0"));
        assertEq("0", type.serializeValue(new Namespaces({}), "0", True));
        foreach string invalid in ("false", "1", "true") {
            assertThrows("SOAP-DESERIALIZATION-ERROR", \type.deserializeValue(),
                ("flag", definition.getTypeMap(), NOTHING, invalid));
        }
        definition = schema("", '<xs:pattern value="0|1"/>');
        type = valueType(definition);
        assertEq("1", type.serializeValue(new Namespaces({}), "1", True));
        assertEq("1", type.getDataProviderType().acceptsValue("1"));
    }

    private declarations() {
        foreach string facet in ("enumeration", "minInclusive", "minExclusive", "maxInclusive", "maxExclusive",
                "length", "minLength", "maxLength", "totalDigits", "fractionDigits") {
            string xml = '<xs:' + facet + ' value="1"/>';
            assertThrows("XSD-SIMPLETYPE-ERROR", \schema(), (xml,));
            assertThrows("XSD-SIMPLETYPE-ERROR", \schema(), ("", xml));
        }
        foreach string mode in ("preserve", "replace") {
            assertThrows("XSD-SIMPLETYPE-ERROR", \schema(), ('<xs:whiteSpace value="' + mode + '"/>',));
        }
        XsdSchema definition = schema('<xs:whiteSpace value="collapse" fixed="true"/>');
        assertEq(False, valueType(definition).getDataProviderType().acceptsValue(" \tfalse\n"));
    }

    private static AbstractDataProviderType detached() {
        return valueType(schema('<xs:pattern value="0|1"/>')).getDataProviderType();
    }

    private providers() {
        AbstractDataProviderType original = detached();
        foreach AbstractDataProviderType provider in (original, Serializable::deserialize(original.serialize())) {
            assertEq("0", provider.acceptsValue(" 0 "));
            assertEq(NOTHING, provider.getValueType());
            assertEq(NT_STRING, provider.getBaseTypeCode());
            assertEq({"string": True}, provider.getReturnTypeHash(True));
            assertEq({}, provider.getDirectTypeHash());
            assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), ("false",));
            AbstractDataProviderType optional = Serializable::deserialize(provider.getOrNothingType().serialize());
            assertEq(NOTHING, optional.acceptsValue(NOTHING));
            assertEq("1", optional.acceptsValue("1"));
            AbstractDataProviderType mandatory = optional.getMandatoryType();
            assertThrows("MISSING-VALUE-ERROR", \mandatory.acceptsValue(), (NOTHING,));
            ListDataType list(provider);
            assertEq(("0", "1"), list.acceptsValue(("0", "1")));
            assertThrows("RUNTIME-TYPE-ERROR", \list.acceptsValue(), (("0", "false"),));
        }
    }

    private defaults() {
        DefaultBoolean base();
        XsdBooleanRestrictionDataType valid(<XsdBooleanFacetInfo>{"name": "flag", "patterns": ("\\Afalse\\z",)}, base);
        assertEq("false", valid.acceptsValue(NOTHING));
        XsdBooleanRestrictionDataType invalid(<XsdBooleanFacetInfo>{"name": "flag", "patterns": ("\\A0\\z",)}, base);
        assertThrows("RUNTIME-TYPE-ERROR", \invalid.acceptsValue(), (NOTHING,));
    }

    private metadata() {
        AbstractDataProviderType provider = detached();
        hash<SerializationInfo> original = provider.serializeToData();
        hash<SerializationInfo> state = original;
        string index = state._index."0"._class_data."WSDL::XsdBooleanRestrictionDataType".facets._index;
        state._index{index}._members.patterns = ("[",);
        assertThrows("DESERIALIZATION-ERROR", \Serializable::deserialize(), (state,));
        assertEq("0", Serializable::deserialize(original).acceptsValue("0"));
        foreach AbstractDataProviderType base in (new QoreDataType(StringType), new QoreDataType(IntType), new ListDataType(BoolType)) {
            assertThrows("XSD-SIMPLETYPE-ERROR", \makeProvider(), (base,));
        }
    }

    private static AbstractDataProviderType makeProvider(AbstractDataProviderType base) {
        return new XsdBooleanRestrictionDataType(<XsdBooleanFacetInfo>{"name": "flag"}, base);
    }

    private listItems() {
        XsdSchema definition = schema('<xs:pattern value="0|1"/>', "",
            '<xs:simpleType name="Flags"><xs:list itemType="t:Value"/></xs:simpleType>');
        XsdAbstractType type = definition.findType(make_qname("urn:boolean-facets", "Flags"));
        assertEq(("0", "1"), type.deserializeValue("flags", definition.getTypeMap(), NOTHING, "0\t1"));
        assertEq("0 1", type.serializeValue(new Namespaces({}), ("0", "1"), True));
        AbstractDataProviderType provider = Serializable::deserialize(type.getDataProviderType().serialize());
        assertEq(("0", "1"), provider.acceptsValue(("0", "1")));
        assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), ((False, True),));
    }

    private fixedAttributes() {
        XsdSchema original = schema('<xs:pattern value="false|0"/>', "",
            '<xs:complexType name="Record"><xs:attribute name="flag" type="t:Value" fixed="false"/></xs:complexType>');
        foreach XsdSchema definition in (original, Serializable::deserialize(original.serialize())) {
            XsdComplexType type = cast<XsdComplexType>(definition.findType(make_qname("urn:boolean-facets", "Record")));
            XsdAttribute attr = type.attrs.flag;
            assertEq("0", attr.getValue("0"));
            assertEq("0", attr.serializeAttributeValue(new Namespaces({}), "0"));
            assertEq("false", attr.getDefaultValue());
            AbstractDataProviderType provider = type.getDataProviderType();
            assertEq({"^attributes^": {"flag": "0"}}, provider.acceptsValue({"^attributes^": {"flag": "0"}}));
            assertThrows("SOAP-DESERIALIZATION-ERROR", \attr.getValue(), ("1",));
        }
        XsdSchema definition = schema('<xs:pattern value="false|0|true|1"/>', "",
            '<xs:complexType name="Record"><xs:attribute name="flag" type="t:Value" fixed="false"/></xs:complexType>');
        XsdComplexType type = cast<XsdComplexType>(definition.findType(make_qname("urn:boolean-facets", "Record")));
        assertThrows("SOAP-DESERIALIZATION-ERROR", \type.attrs.flag.getValue(), ("1",));
        assertThrows("SOAP-SERIALIZATION-ERROR", \type.attrs.flag.serializeAttributeValue(), (new Namespaces({}), "true"));
    }

    private fixedDerivation() {
        string extra = '<xs:attribute name="global" type="t:Value" fixed="false"/>
            <xs:complexType name="Record"><xs:attribute ref="t:global" fixed="0"/></xs:complexType>
            <xs:complexType name="Parent"><xs:attribute name="flag" type="t:Value" fixed="false"/></xs:complexType>
            <xs:complexType name="Child"><xs:complexContent><xs:restriction base="t:Parent">
                <xs:attribute name="flag" type="t:Value" fixed="0"/>
            </xs:restriction></xs:complexContent></xs:complexType>';
        XsdSchema original = schema('<xs:pattern value="false|0|true|1"/>', "", extra);
        foreach XsdSchema definition in (original, Serializable::deserialize(original.serialize())) {
            foreach string name in ("Record", "Child") {
                XsdComplexType type = cast<XsdComplexType>(definition.findType(make_qname("urn:boolean-facets", name)));
                XsdAttribute attr = type.attrs.firstValue();
                assertEq("false", attr.getValue("false"));
                assertEq("0", attr.getDefaultValue());
            }
        }
        extra =~ s/fixed="0"/fixed="1"/g;
        assertThrows("WSDL-ERROR", \schema(), ('<xs:pattern value="false|0|true|1"/>', "", extra));
    }

    private fieldUpdates() {
        XsdBooleanDataField field({"name": "flag", "type": detached(), "allowed_values": (False,)});
        assertEq("0", field.acceptsValue("0"));
        assertThrows("FIELD-VALUE-ERROR", \field.acceptsValue(), ("1",));
        field.setAllowedValues((<AllowedValueInfo>{"value": "true", "display_name": "Enabled"},));
        assertEq("1", field.acceptsValue("1"));
        hash<SerializationInfo> before = field.serializeToData();
        assertThrows("XSD-SIMPLETYPE-ERROR", \field.setAllowedValues(), (("0", "no"),));
        assertEq(before, field.serializeToData());
        XsdBooleanDataField restored = Serializable::deserialize(field.serialize());
        assertEq("1", restored.acceptsValue("1"));
        assertThrows("FIELD-VALUE-ERROR", \restored.acceptsValue(), ("0",));
        XsdBooleanDataField repeated({"name": "flags", "type": new ListDataType(detached()),
            "element_allowed_values": (False,)});
        assertEq(("0", "0"), repeated.acceptsValue(("0", "0")));
        before = repeated.serializeToData();
        assertThrows("XSD-SIMPLETYPE-ERROR", \repeated.setElementAllowedValues(), ((True, 2),));
        assertEq(before, repeated.serializeToData());
    }

    private samples() {
        foreach string lexical in ("true", "false", "1", "0") {
            XsdSimpleType type = valueType(schema('<xs:pattern value="' + lexical + '"/>'));
            assertEq(lexical, type.getSampleValue("not-a-boolean"));
        }
        XsdSimpleType type = valueType(schema('<xs:pattern value="1"/>', '<xs:pattern value="0"/>'));
        assertThrows("XSD-SAMPLE-ERROR", \type.getSampleValue(), (True,));
    }

    private cancellation() {
        CancelBoolean base();
        XsdBooleanRestrictionDataType provider(<XsdBooleanFacetInfo>{"name": "flag", "patterns": ("\\A[01]\\z",)}, base);
        string input = " 0 ";
        assertThrows("TEST-CANCELLED", \provider.acceptsValue(), (input,));
        assertEq(" 0 ", input);
        base.cancel = False;
        assertEq("0", provider.acceptsValue(input));
    }
}

class CancelBoolean inherits XsdBooleanDataType {
    public {
        bool cancel = True;
    }
    auto acceptsValue(auto value) {
        if (cancel) {
            throw "TEST-CANCELLED", "controlled boolean conversion cancellation";
        }
        return XsdBooleanDataType::acceptsValue(value);
    }
}

class DefaultBoolean inherits XsdBooleanDataType {
    auto getDefaultValue() {
        return False;
    }
}
