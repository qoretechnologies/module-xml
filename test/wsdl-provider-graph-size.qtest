#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires ../qlib/WSDL.qm
%exec-class ProviderGraphSizeTest
class ProviderGraphSizeTest inherits QUnit::Test {
    constructor() : Test("Ordinary XML provider graph size", "1.0") {
        addTestCase("Shared descendant graphs have bounded soft conversion", \shared());
        addTestCase("Validating wildcard records share soft conversion work", \wildcards());
        set_return_value(main());
    }
    private shared() {
        checkGraph(False);
    }
    private wildcards() {
        checkGraph(True);
    }
    private checkGraph(bool wildcard) {
        foreach int depth in (4, 8, 12) {
            string text = "<xs:schema xmlns:xs='http://www.w3.org/2001/XMLSchema'>"
                "<xs:complexType name='D0'><xs:sequence><xs:element name='value' type='xs:boolean'/>"
                "</xs:sequence></xs:complexType>";
            for (int i = 1; i <= depth; ++i) {
                text += sprintf("<xs:complexType name='D%d'><xs:sequence><xs:element name='left' type='D%d'/>"
                    "<xs:element name='right' type='D%d'/>%s</xs:sequence></xs:complexType>", i, i-1, i-1,
                    wildcard ? "<xs:any namespace='##other' processContents='skip' minOccurs='0'/>" : "");
            }
            text += sprintf("<xs:complexType name='Root'><xs:sequence><xs:element name='payload' type='D%d'/>"
                "<xs:element name='child' type='Root' minOccurs='0'/></xs:sequence></xs:complexType>"
                "<xs:element name='root' type='Root'/></xs:schema>", depth);
            XsdSchema schema(text, {"async_only":True});
            XsdComplexType leaf = cast<XsdComplexType>(schema.getTypeMap(){"{}D0"});
            CountSoftSchema controlled(leaf.nsc);
            leaf.elementmap.value.type = controlled;
            AbstractDataProviderType provider = schema.getElement("", "root").getDataProviderType();
            assertTrue(controlled.provider.calls <= 2, sprintf("shared XML graph at depth %d caused %d leaf conversions",
                depth, controlled.provider.calls));
            assertTrue(provider.getFields().hasKey("payload"));
            assertTrue(provider.getFields().child.getType().isOrNothingType());
        }
    }
}

class CountSoftProvider inherits XsdBooleanDataType {
    public {
        int calls = 0;
    }
    AbstractDataProviderType getSoftType() {
        ++calls;
        return self;
    }
}
class CountSoftSchema inherits XsdBaseType {
    public {
        CountSoftProvider provider();
    }
    constructor(Namespaces ns) : XsdBaseType("boolean", ns) {
    }
    AbstractDataProviderType getDataProviderType() {
        return provider;
    }
}
