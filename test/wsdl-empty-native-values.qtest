#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class EmptyNativeValuesTest

class EmptyNativeValuesTest inherits QUnit::Test {
    const Ns = "urn:empty-native";
    constructor() : Test("Empty native complex values", "1.0") {
        addTestCase("Empty native providers accept records across reconstruction and soft conversion", \providers());
        addTestCase("Element and type parts retain empty records independent of namespace declarations", \parts());
        addTestCase("Missing, nil and empty records retain separate contracts", \absence());
        set_return_value(main());
    }
    private static WebService service(string content = "", bool typed = False, bool nil = False) {
        return new WebService('<w:definitions xmlns:w="http://schemas.xmlsoap.org/wsdl/" xmlns:t="' + Ns
            + '" xmlns:s="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:xs="' + XSD_NS + '" targetNamespace="' + Ns + '">'
            + '<w:types><xs:schema targetNamespace="' + Ns + '"><xs:complexType name="Empty">' + content
            + '</xs:complexType><xs:complexType name="Selected"><xs:complexContent><xs:extension base="t:Empty"/>'
            + '</xs:complexContent></xs:complexType><xs:element name="value" type="t:Empty" nillable="'
            + (nil ? "true" : "false") + '"/></xs:schema></w:types><w:message name="M"><w:part name="part" '
            + (typed ? 'type="t:Empty"' : 'element="t:value"') + '/></w:message><w:portType name="P">'
            + '<w:operation name="send"><w:input message="t:M"/><w:output message="t:M"/></w:operation></w:portType>'
            + '<w:binding name="B" type="t:P"><s:binding style="' + (typed ? "rpc" : "document")
            + '" transport="http://schemas.xmlsoap.org/soap/http"/><w:operation name="send"><s:operation soapAction="send"/>'
            + '<w:input><s:body use="literal" namespace="' + Ns + '"/></w:input>'
            + '<w:output><s:body use="literal" namespace="' + Ns + '"/></w:output></w:operation></w:binding></w:definitions>');
    }
    private providers() {
        foreach string content in ("", "<xs:sequence/>", "<xs:all/>") {
            foreach bool typed in (False, True) {
                WebService original = service(content, typed);
                foreach WebService ws in (original, Serializable::deserialize(original.serialize())) {
                    HashDataType root = ws.getMessage("M").getDataProviderType(True);
                    foreach HashDataType variant in (root, root.getSoftType(), Serializable::deserialize(root.serialize())) {
                        assertEq({"part":{}}, variant.acceptsValue({"part":{}}));
                        assertEq({"part":{}}, variant.acceptsValue(variant.getExampleValue()));
                        hash<auto> value = {"part":{"^type^":new XsdQNameValue(Ns, "Selected"), "^val^":{}}};
                        assertEq({}, variant.acceptsValue(value).part."^val^");
                        foreach auto bad in ("text", 1, {"child":"value"}, {"^attributes^":{"unexpected":"value"}}) {
                            assertThrows("RUNTIME-TYPE-ERROR", \variant.acceptsValue(), ({"part":bad},));
                        }
                    }
                }
            }
        }
    }
    private parts() {
        foreach string content in ("", "<xs:sequence/>") {
            foreach bool typed in (False, True) {
                WebService ws = service(content, typed);
                WSOperation original = ws.getBindingOperation("B", "send");
                foreach WSOperation op in (original, Serializable::deserialize(original.serialize())) {
                    foreach bool response in (False, True) {
                        string wrapper = "send" + (response ? "Response" : "");
                        foreach string declaration in ("", ' xmlns:extra="urn:extra"') {
                            string body = typed ? '<t:' + wrapper + '><part' + declaration + '/></t:' + wrapper + '>'
                                : '<t:value' + declaration + '/>';
                            hash<auto> parsed = parse_xml('<s:Envelope xmlns:s="' + SOAP_11_ENV + '" xmlns:t="' + Ns
                                + '"><s:Body>' + body + '</s:Body></s:Envelope>');
                            assertEq({}, response ? op.deserializeResponse(parsed, "B", True)
                                : op.deserializeRequest(parsed, "B", True));
                        }
                        hash<auto> encoded = response ? op.serializeResponse({"part":{}}, NOTHING, NOTHING, NOTHING,
                            NOTHING, NOTHING, "B") : op.serializeRequest({"part":{}}, NOTHING, NOTHING, NOTHING,
                            NOTHING, NOTHING, "B");
                        assertEq({}, response ? op.deserializeResponse(parse_xml(encoded.body), "B", True)
                            : op.deserializeRequest(parse_xml(encoded.body), "B", True));
                    }
                }
            }
        }
    }
    private absence() {
        WebService ws = service();
        AbstractDataProviderType type = ws.getNativeDataProviderType(Ns, "value");
        assertEq({}, type.acceptsValue({}));
        assertThrows("MISSING-VALUE-ERROR", \type.acceptsValue(), (NOTHING,));
        assertEq(NOTHING, type.getOrNothingType().acceptsValue(NOTHING));
        assertThrows("RUNTIME-TYPE-ERROR", \type.acceptsValue(), (new XsdNilValue({}),));
        WebService nillable = service("", False, True);
        AbstractDataProviderType nil_type = nillable.getNativeDataProviderType(Ns, "value");
        assertTrue(nil_type.acceptsValue(new XsdNilValue({})) instanceof XsdNilValue);
        assertEq({}, nil_type.acceptsValue({}));
        # The ordinary projection remains compatible; explicit native providers expose the record form.
        assertEq(NOTHING, ws.getElement(Ns, "value").getDataProviderType().getExampleValue());
    }
}
