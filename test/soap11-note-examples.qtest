#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "SOAP 1.1 Note example tests require json";
%else
%exec-class Soap11NoteExamplesTest

# The section 5 examples of the SOAP 1.1 W3C Note (wsdl-interop/encoded-corpus/soap11-note.json), embedded verbatim
# in rpc/encoded requests of wsdl-interop/encoded-corpus/soap11-note.wsdl. The Note uses the 1999 XML Schema draft:
# its xsd and xsi prefixes are bound to XML Schema 1.0, and two examples' draft type names are transliterated.
public class Soap11NoteExamplesTest inherits QUnit::Test {
    private {
        const Envelope = '<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" '
            'xmlns:SOAP-ENC="http://schemas.xmlsoap.org/soap/encoding/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" '
            'xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:e="urn:soap11-note:e" '
            'xmlns:m="urn:soap11-note:m" xmlns:n="urn:soap11-note:n" xmlns:xyz="urn:soap11-note:xyz"><soapenv:Body>'
            '<ns:%s xmlns:ns="urn:soap11-note" soapenv:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/">%s'
            '</ns:%s>%s</soapenv:Body></soapenv:Envelope>';
        # the 1999 draft names of examples 25 and 26 and their XML Schema 1.0 equivalents
        const Draft = {"xsd:ur-type": "xsd:anyType", "xsd:uriReference": "xsd:anyURI",
            "SOAP-ENC:uriReference": "SOAP-ENC:anyURI"};

        hash<string, hash<auto>> examples;
        list<WebService> services;
    }

    constructor() : QUnit::Test("SOAP 1.1 Note section 5 examples", "1.0") {
        string dir = get_script_dir() + "/wsdl-interop/encoded-corpus/";
        examples = map {$1.number.toString(): $1}, parse_json(ReadOnlyFile::readTextFile(dir + "soap11-note.json")).examples;
        WebService source(ReadOnlyFile::readTextFile(dir + "soap11-note.wsdl"));
        services = (source, Serializable::deserialize(source.serialize()));
        addTestCase("the corpus holds the section 5 examples and their published errata", \corpus());
        addTestCase("simple values, strings and references (sections 5.2 and 5.4.1)", \simpleValues());
        addTestCase("arrays, including generic, partial and sparse arrays (section 5.4.2)", \arrays());
        addTestCase("compound values and generic compound types (sections 5.4.1 and 5.4.3)", \compounds());
        addTestCase("examples the Note gets wrong or that refer outside the message are rejected", \rejected());
        addTestCase("instance member types, embedded ids and element-named members", \memberTypes());
        addTestCase("generic arrays and encoding-namespace types serialize and decode back", \roundTrip());
        addTestCase("unresolvable part types are WSDL errors", \unresolvedTypes());
        set_return_value(main());
    }

    corpus() {
        assertEq(34, examples.size());
        assertEq(("17", "37"), (select keys examples, !examples{$1}.well_formed));
        assertEq("5.4.2.2 Sparse Arrays", examples."37".section);
        foreach hash<auto> example in (examples.iterator()) {
            assertTrue(example.section =~ /^5(\.|\s)/, example.section);
            if (example.well_formed) {
                # each top-level element is verbatim example text, in document order
                int offset = 0;
                foreach string element in (example.elements) {
                    int found = example.text.find(element, offset);
                    assertTrue(found >= offset, sprintf("example %d element %d", example.number, $#));
                    offset = found + element.length();
                }
                assertEq("", trim(example.text.substr(offset)));
            }
        }
    }

    # Decodes example number's elements with operation: the first count elements from the given index are the
    # accessors, preceded by any accessor of this test's own; the rest are independent elements.
    private auto decode(WebService ws, string operation, string number, int first = 0, int count = 1, *string own,
            bool skip_rest = False) {
        list<string> fragments = examples{number}.elements;
        if (number == "25" || number == "26") {
            fragments = map transliterate($1), fragments;
        }
        string accessors = (own ?? "") + (count ? (foldl $1 + $2, fragments[first..(first + count - 1)]) : "");
        string independent = "";
        if (!skip_rest) {
            for (int i = 0; i < fragments.size(); ++i) {
                if (i < first || i >= first + count) {
                    independent += fragments[i];
                }
            }
        }
        return ws.getOperation(operation).deserializeRequest(parse_xml(sprintf(Envelope, operation, accessors, operation,
            independent), XPF_PRESERVE_ORDER));
    }

    private static string transliterate(string text) {
        foreach hash<auto> entry in (Draft.pairIterator()) {
            text = replace(text, entry.key, entry.value);
        }
        return text;
    }

    # the character content of the first element in example text that starts with the given tag
    private string content(string number, string start, string end) {
        string text = examples{number}.text;
        int i = text.find(start) + start.length();
        return text.substr(i, text.find(end, i) - i);
    }

    simpleValues() {
        foreach WebService ws in (services) {
            # xsd:float values are single precision
            assertEq({"age": 45, "height": 5.900000095367431640625, "displacement": -450, "color": "Blue"},
                decode(ws, "simple", "6", 4, 4, NOTHING, True));
            assertEq(45, decode(ws, "intRef", "7", 0, 0, '<age href="#int1"/>'));
            # section 5.2.1: the greeting accessor carries the string's id itself (section 5.1 rule 8)
            assertEq({"greeting": "Hello", "salutation": "Hello"}, decode(ws, "strings", "8", 0, 2));
            assertEq({"greeting": "Hello", "salutation": "Hello"}, decode(ws, "strings", "9", 0, 2));
            assertEq({"Name": "Henry Ford", "Age": 32, "EyeColor": "Brown"}, decode(ws, "person", "12"));
            assertEq(parse_base64_string("aG93IG5vDyBicm73biBjb3cNCg=="), decode(ws, "picture", "13"));
            # section 5.3: xsi:type selects the polymorphic accessor's type
            assertEq(29.9500007629394531250, decode(ws, "cost", "14"));
            assertEq(29.9500007629394531250, decode(ws, "costTyped", "15"));
        }
    }

    arrays() {
        # built empty and pushed: a list literal keeps its element type
        list<auto> sparse();
        for (int i = 0; i < 4; ++i) {
            push sparse, NOTHING;
        }
        list<auto> matrix();
        for (int i = 0; i < 10; ++i) {
            list<auto> row();
            for (int j = 0; j < 10; ++j) {
                push row, NOTHING;
            }
            push matrix, row;
        }
        matrix[2][2] = "Third row, third col";
        matrix[7][2] = "Eighth row, third col";
        sparse[2] = matrix;
        foreach WebService ws in (services) {
            assertEq({"number": (3, 4)}, decode(ws, "numbers", "23", 1, 1, NOTHING, True));
            assertEq({"int": (3, 4)}, decode(ws, "array", "24"));
            # members typed by xsi:type (25) and by the encoding schema's element names (26); decimal text that a
            # float reproduces decodes as that float, and anyURI collapses whitespace
            string poem = content("25", '<thing xsi:type="xsd:string">', "</thing>");
            assertEq({"thing": (12345, 6.789, poem, "http://www.dartmouth.edu/~milton/reading_room/")},
                decode(ws, "array", "25"));
            assertEq((12345, 6.789, poem, "http://www.dartmouth.edu/~milton/reading_room/"), decode(ws, "array", "26"));
            list<auto> orders = ({"Product": "Apple", "Price": 1.56}, {"Product": "Peach", "Price": 1.48});
            assertEq({"Order": orders}, decode(ws, "array", "27"));
            assertEq({"phoneNumber": ("206-555-1212", "1-888-123-4567")}, decode(ws, "phones", "30"));
            assertEq({"item": (("r1c1", "r1c2", "r1c3"), ("r2c1", "r2c2", "r2c3"))}, decode(ws, "array", "31"));
            assertEq({"name": "John Hancock", "phoneNumbers": {"phoneNumber": ("206-555-1212", "1-888-123-4567")}},
                decode(ws, "person3", "33"));
            # section 5.4.2.1: a partially transmitted array
            assertEq({"item": (NOTHING, NOTHING, "The third element", "The fourth element", NOTHING)},
                decode(ws, "array", "35"));
            # section 5.4.2.2: a sparse array of arrays
            assertEq({"Array": sparse}, decode(ws, "array", "36"));
        }
    }

    compounds() {
        hash<auto> book = {"title": "My Life and Work", "author": {"name": "Henry Ford",
            "address": {"email": "mailto:henryford@hotmail.com", "web": "http://www.henryford.com"}}};
        list<auto> orders = ({"Product": "Apple", "Price": 1.56}, {"Product": "Peach", "Price": 1.48});
        foreach WebService ws in (services) {
            assertEq({"author": "Henry Ford", "preface": "Prefatory text", "intro": "This is a book."},
                decode(ws, "book1", "16"));
            # the same book with multi-reference authors and addresses (18) and single-reference values (19)
            assertEq(book, decode(ws, "book", "18"));
            assertEq(book, decode(ws, "book", "19"));
            # xsi:type selects each author's address type
            assertEq({"title": "My Life and Work",
                "firstauthor": {"name": "Henry Ford", "address": book.author.address},
                "secondauthor": {"name": "Samuel Crowther", "address": {"street": "Martin Luther King Rd",
                    "city": "Raleigh", "state": "North Carolina"}}}, decode(ws, "book2", "20"));
            # section 5.4.3: a generic compound type with repeated accessors
            hash<auto> ship_to = {"Street": "5th Ave", "City": "New York", "State": "NY", "Zip": "10010"};
            assertEq({"CustomerName": "Henry Ford", "ShipTo": ship_to, "PurchaseLineItems": {"Order": orders}},
                decode(ws, "order2", "38"));
            assertEq({"Order": orders}, decode(ws, "items", "39"));
        }
    }

    rejected() {
        foreach WebService ws in (services) {
            # the Note's array-1 declares two members and transmits three
            assertThrows("SOAP-DESERIALIZATION-ERROR", "array \"Array\" transmits more members than its asserted size "
                "\\[2\\]", \decode(), (ws, "array", "28"));
            # arrayType="Order[2]" has no prefix and no default namespace is in scope
            assertThrows("SOAP-DESERIALIZATION-ERROR", "unknown member type {}Order in SOAP-ENC:arrayType of array "
                "\"ArrayOfOrder\"", \decode(), (ws, "order", "34"));
            # values outside the message are not retrieved
            assertThrows("SOAP-DESERIALIZATION-ERROR", "SOAP encoding reference \"http://www.dartmouth.edu/~milton/\" "
                "is outside the message; only same-document fragment references are resolved", \decode(),
                (ws, "book3", "21"));
        }
    }

    private auto request(WebService ws, string operation, string accessors, string independent = "") {
        return ws.getOperation(operation).deserializeRequest(parse_xml(sprintf(Envelope, operation, accessors,
            operation, independent), XPF_PRESERVE_ORDER));
    }

    memberTypes() {
        foreach WebService ws in (services) {
            assertThrows("SOAP-DESERIALIZATION-ERROR", "generic array \"Array\" requires SOAP-ENC:arrayType",
                \request(), (ws, "array", '<SOAP-ENC:Array><item>1</item></SOAP-ENC:Array>'));
            assertThrows("SOAP-DESERIALIZATION-ERROR", "unknown member type {urn:soap11-note:xyz}Missing",
                \request(), (ws, "array", '<SOAP-ENC:Array SOAP-ENC:arrayType="xyz:Missing[1]"><item>1</item>'
                    '</SOAP-ENC:Array>'));
            # an instance member type must be the declared item type or substitutable for it
            assertThrows("SOAP-DESERIALIZATION-ERROR", "explicit type \"int\" cannot replace declared type "
                "\"phoneNumber\" for element \"ArrayOfPhoneNumbers\"", \request(),
                (ws, "phones", '<ArrayOfPhoneNumbers SOAP-ENC:arrayType="xsd:int[1]"><item>1</item></ArrayOfPhoneNumbers>'));
            assertEq({"phoneNumber": ("206-555-1212",)}, request(ws, "phones",
                '<ArrayOfPhoneNumbers SOAP-ENC:arrayType="xyz:phoneNumber[1]"><phoneNumber>206-555-1212</phoneNumber>'
                '</ArrayOfPhoneNumbers>'));
            # xsi:type takes precedence over a member's element name
            assertEq({"int": ("007",)}, request(ws, "array", '<SOAP-ENC:Array SOAP-ENC:arrayType="xsd:anyType[1]">'
                '<SOAP-ENC:int xsi:type="xsd:string">007</SOAP-ENC:int></SOAP-ENC:Array>'));
            assertThrows("SOAP-DESERIALIZATION-ERROR", "value \"x7\" is not in the XML lexical space of type \"int\"",
                \request(), (ws, "array", '<SOAP-ENC:Array SOAP-ENC:arrayType="xsd:anyType[1]"><SOAP-ENC:int>x7'
                    '</SOAP-ENC:int></SOAP-ENC:Array>'));
            # embedded ids share one namespace with independent elements and are checked like them
            assertThrows("SOAP-DESERIALIZATION-ERROR", "duplicate SOAP encoding id \"a\"", \request(),
                (ws, "strings", '<greeting id="a">x</greeting><salutation href="#a"/>', '<multiRef id="a">y</multiRef>'));
            assertThrows("SOAP-DESERIALIZATION-ERROR", "SOAP encoding id \"1a\" is not an XML ID", \request(),
                (ws, "strings", '<greeting id="1a">x</greeting><salutation href="#1a"/>'));
            assertThrows("SOAP-DESERIALIZATION-ERROR", "SOAP encoding reference cycle through id \"b\"", \request(),
                (ws, "book", '<Book id="b"><title>t</title><author href="#b"/></Book>'));
            assertThrows("INVALID-REFERENCE", "multiRef id: \"missing\" does not exist", \request(),
                (ws, "strings", '<greeting id="a">x</greeting><salutation href="#missing"/>'));
        }
    }

    roundTrip() {
        foreach WebService ws in (services) {
            WSOperation array = ws.getOperation("array");
            foreach auto value in ((1, "a", 2.5), {"int": (3, 4)}, ()) {
                hash<auto> message = array.serializeRequest({"Array": value});
                assertRegex('soapenc:arrayType="xsd:anyType\[\]"', message.body);
                assertEq(value.typeCode() == NT_LIST && value ? {"item": value} : value,
                    array.deserializeRequest(parse_xml(message.body, XPF_PRESERVE_ORDER)));
            }
            # a generic array's nested lists are arrays: rectangular nestings keep their rank, others are jagged
            list<auto> jagged();
            push jagged, (1, 2);
            push jagged, (3,);
            push jagged, NOTHING;
            foreach list<auto> row in ((((1, 2, 3), (4, 5, 6)), "xsd:anyType\\[2,3\\]"),
                    ((((1, 2), (3, 4)), ((5, 6), (7, 8))), "xsd:anyType\\[2,2,2\\]"),
                    (jagged, "xsd:anyType\\[\\]\\[\\]")) {
                string wire = array.serializeRequest({"Array": row[0]}).body;
                assertRegex('Array soapenc:arrayType="' + row[1] + '"', wire);
                assertEq({"item": row[0]}, array.deserializeRequest(parse_xml(wire, XPF_PRESERVE_ORDER)));
            }
            assertThrows("SOAP-SERIALIZATION-ERROR", "cannot mix array and non-array members",
                \array.serializeRequest(), ({"Array": (1, (2,))},));
            assertThrows("SOAP-SERIALIZATION-ERROR", "must have one shape",
                \array.serializeRequest(), ({"Array": ((1, 2), ((3,), (4,)), (5,))},));
            # a named restriction writes its own xsi:type, which the declared type accepts
            WSOperation simple = ws.getOperation("simple");
            hash<auto> fields = {"age": 1, "height": 2.5, "displacement": -3, "color": "Blue"};
            string typed = simple.serializeRequest(fields).body;
            assertRegex('<color xsi:type="[a-z0-9]+:Color">Blue</color>', typed);
            assertEq(fields, simple.deserializeRequest(parse_xml(typed, XPF_PRESERVE_ORDER)));
            # declared encoding-namespace types write their XML Schema builtins
            WSOperation strings = ws.getOperation("strings");
            hash<auto> message = strings.serializeRequest({"greeting": "Hello", "salutation": "Hi"});
            assertRegex('<greeting xsi:type="xsd:string">Hello</greeting>', message.body);
            assertEq({"greeting": "Hello", "salutation": "Hi"},
                strings.deserializeRequest(parse_xml(message.body, XPF_PRESERVE_ORDER)));
            message = ws.getOperation("picture").serializeRequest({"picture": binary("abc")});
            assertRegex('<picture xsi:type="xsd:base64Binary">YWJj</picture>', message.body);
            # decoded Note examples re-encode to the same values; a single part's value is passed under its part name
            foreach list<auto> row in (("24", "array", "Array"), ("30", "phones", "ArrayOfPhoneNumbers"),
                    ("31", "array", "Array"), ("35", "array", "Array"), ("36", "array", "Array")) {
                auto value = decode(ws, row[1], row[0]);
                WSOperation op = ws.getOperation(row[1]);
                assertEq(value, op.deserializeRequest(parse_xml(op.serializeRequest({row[2]: value}).body,
                    XPF_PRESERVE_ORDER)), row[0]);
            }
            # Example 27's members are xyz:Order structs selected by the instance SOAP-ENC:arrayType. A native hash
            # has no schema type, so the members' type is retained explicitly with preserve_types.
            string xml = sprintf(Envelope, "array", examples."27".elements[0], "array", "");
            auto preserved = array.deserializeRequest(parse_xml(xml, XPF_PRESERVE_ORDER), NOTHING, True);
            assertEq("{urn:soap11-note:xyz}Order", portable(preserved).Order[0]."^type^");
            string wire = array.serializeRequest({"Array": preserved}).body;
            assertRegex('<soapenc:Order xsi:type="[a-z0-9]+:Order">', wire);
            assertEq(portable(preserved), portable(array.deserializeRequest(parse_xml(wire, XPF_PRESERVE_ORDER),
                NOTHING, True)));
            assertEq(decode(ws, "array", "27"), array.deserializeRequest(parse_xml(wire, XPF_PRESERVE_ORDER)));
        }
    }

    # selected-type wrappers with their QName objects as expanded names, for comparison
    private static auto portable(auto value) {
        switch (value.typeCode()) {
            case NT_LIST:
                return map portable($1), value;
            case NT_HASH: {
                hash<auto> result();
                foreach hash<auto> entry in (value.pairIterator()) {
                    result{entry.key} = entry.value instanceof XsdQNameValue
                        ? sprintf("{%s}%s", entry.value.getNamespaceUri(), entry.value.getLocalName())
                        : portable(entry.value);
                }
                return result;
            }
        }
        return value;
    }

    unresolvedTypes() {
        string text = ReadOnlyFile::readTextFile(get_script_dir() + "/wsdl-interop/encoded-corpus/soap11-note.wsdl");
        assertThrows("WSDL-ERROR", "cannot resolve type \"xyz:Missing\" for part \"Book\" in message \"book3Request\"",
            sub () { new WebService(replace(text, 'type="xyz:Book3"', 'type="xyz:Missing"')); });
        assertThrows("WSDL-ERROR", "cannot resolve type \"SOAP-ENC:Struct\" for part \"cost\"",
            sub () { new WebService(replace(text, '<part name="cost" type="xsd:anyType"/>',
                '<part name="cost" type="SOAP-ENC:Struct"/>')); });
    }
}
%endif
