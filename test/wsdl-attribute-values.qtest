#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class AttributeValuesTest

class AttributeValuesTest inherits QUnit::Test {
    constructor() : QUnit::Test("WSDL attribute value constraints", "1.0") {
        addTestCase("Optional defaults add typed values while explicit values remain authoritative", \defaults());
        addTestCase("Fixed attributes compare typed values and reject mismatches", \fixed());
        addTestCase("Required fixed values still require an explicitly supplied attribute", \requiredFixed());
        addTestCase("References inherit global constraints without changing their declarations", \references());
        addTestCase("Invalid constraint values fail while constructing the schema", \invalidConstraints());
        addTestCase("Constraint values survive schema reconstruction", \reconstruction());
        set_return_value(main());
    }

    private XsdSchema parse(string attributes, string declarations = "") {
        return new XsdSchema('<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:values"
            targetNamespace="urn:values">' + declarations + '<xs:complexType name="Record">' + attributes
            + '</xs:complexType></xs:schema>', {"async_only": True});
    }

    private XsdComplexType type(XsdSchema schema) {
        return cast<XsdComplexType>(schema.findType(make_qname("urn:values", "Record")));
    }

    defaults() {
        XsdSchema s = parse('<xs:attribute name="flag" type="xs:boolean" default="false"/>
            <xs:attribute name="count" type="xs:int" default="7"/><xs:attribute name="text" default=""/>');
        assertEq({"^attributes^": {"flag": False, "count": 7, "text": ""}},
            type(s).deserializeValue("Record", s.getTypeMap(), NOTHING, {}));
        assertEq({"flag": "false", "count": 7, "text": ""},
            type(s).serializeValue(s.nsc, {}, True)."^attributes^");
        assertEq({"^attributes^": {"flag": True, "count": 0, "text": "given"}},
            type(s).deserializeValue("Record", s.getTypeMap(), NOTHING,
                {"^attributes^": {"flag": "true", "count": "0", "text": "given"}}));
    }

    fixed() {
        XsdSchema s = parse('<xs:attribute name="flag" type="xs:boolean" fixed="false"/>
            <xs:attribute name="count" type="xs:int" fixed="1"/>');
        assertEq({"^attributes^": {"flag": False, "count": 1}},
            type(s).deserializeValue("Record", s.getTypeMap(), NOTHING, {"^attributes^": {"flag": "0", "count": "01"}}));
        assertEq({"^attributes^": {"flag": False, "count": 1}},
            type(s).deserializeValue("Record", s.getTypeMap(), NOTHING, {}));
        foreach hash<auto> attributes in ({"flag": "true"}, {"count": "2"}) {
            assertThrows("SOAP-DESERIALIZATION-ERROR", \type(s).deserializeValue(),
                ("Record", s.getTypeMap(), NOTHING, {"^attributes^": attributes}));
            assertThrows("SOAP-SERIALIZATION-ERROR", \type(s).serializeValue(),
                (s.nsc, {"^attributes^": attributes}, True));
        }
    }

    requiredFixed() {
        XsdSchema s = parse('<xs:attribute name="code" type="xs:string" fixed="EUR" use="required"/>');
        assertThrows("SOAP-DESERIALIZATION-ERROR", \type(s).deserializeValue(), ("Record", s.getTypeMap(), NOTHING, {}));
        assertThrows("SOAP-SERIALIZATION-ERROR", \type(s).serializeValue(), (s.nsc, {}, True));
        assertEq({"code": "EUR"}, type(s).serializeValue(s.nsc, {"^attributes^": {"code": "EUR"}}, True)."^attributes^");
    }

    references() {
        string declarations = '<xs:attribute name="flag" type="xs:boolean" default="false"/>
            <xs:attribute name="code" type="xs:string" fixed="EUR"/>';
        XsdSchema s = parse('<xs:attribute ref="t:flag"/><xs:attribute ref="t:code"/>', declarations);
        assertEq(False, type(s).attrs.flag.getDefaultValue());
        assertEq("EUR", type(s).attrs.code.getDefaultValue());
        XsdSchema overridden = parse('<xs:attribute ref="t:flag" default="true"/>', declarations);
        assertEq(True, type(overridden).attrs.flag.getDefaultValue());
        assertEq(False, overridden.getAttribute("urn:values", "flag").getDefaultValue());
        assertThrows("WSDL-ERROR", \parse(), ('<xs:attribute ref="t:code" default="EUR"/>', declarations));
        assertThrows("WSDL-ERROR", \parse(), ('<xs:attribute ref="t:code" fixed="USD"/>', declarations));
    }

    invalidConstraints() {
        foreach string value in ("2", "999") {
            assertThrows("WSDL-ERROR", \parse(), ('<xs:attribute name="code" default="' + value + '">
                <xs:simpleType><xs:restriction base="xs:int"><xs:maxInclusive value="1"/>
                </xs:restriction></xs:simpleType></xs:attribute>',));
        }
    }

    reconstruction() {
        XsdSchema original = parse('<xs:attribute name="flag" type="xs:boolean" default="false"/>
            <xs:attribute name="code" type="xs:string" fixed="EUR"/>');
        XsdSchema s = Serializable::deserialize(original.serialize());
        assertEq({"^attributes^": {"flag": False, "code": "EUR"}},
            type(s).deserializeValue("Record", s.getTypeMap(), NOTHING, {}));
        assertThrows("SOAP-SERIALIZATION-ERROR", \type(s).serializeValue(),
            (s.nsc, {"^attributes^": {"code": "USD"}}, True));
    }
}
