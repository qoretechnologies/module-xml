#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
#
# A name with a NUL character names nothing: an API that selects an operation, binding, message, service, fault,
# part, port, provider child, message or other declared component by name raises its own "unknown" error for one, or
# returns nothing where an unknown name does, instead of raising HASH-KEY-ERROR. A registration with such a name is
# refused before anything is registered.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%requires ../qlib/SoapClient.qm
%requires ../qlib/SoapClientIo
%requires ../qlib/SoapHandler.qm
%requires ../qlib/SoapDataProvider
%requires ../qlib/XmlRpcHandler.qm
%requires ../qlib/WebDavClient.qm
%requires ../qlib/WebDavClientIo
%requires ../qlib/WebDavClientDataProvider
%requires ../qlib/CargoXmlDataProvider
%requires ../qlib/CdaDataProvider
%requires ../qlib/SaxDataProvider
%requires ../qlib/WebContentUtil
%requires HttpServer
%exec-class NulNameTest

class NulNameTest inherits QUnit::Test {
    public {
        const Nul = chr(0);
        const Ns = "http://qoretechnologies.com/simpletest";
    }

    constructor() : Test("Names with a NUL character", "1.0") {
        addTestCase("WSDL component names", \wsdlComponents());
        addTestCase("Operation faults, bindings and parts", \operationNames());
        addTestCase("Schema components and builtin names", \schemaNames());
        addTestCase("Patterns and media-type parameters", \patternNames());
        addTestCase("SOAP client options", \soapClientOptions());
        addTestCase("SOAP handler registration", \soapHandler());
        addTestCase("XML-RPC handler requests and registration", \xmlRpcHandler());
        addTestCase("Data provider children and messages", \providers());
        addTestCase("Element and property names of generated XML", \elementNames());
        addTestCase("robots.txt user agent of the crawler", \robotsUserAgent());
        set_return_value(main());
    }

    # asserts that the call raises the given error, with a description containing the given text
    private checkError(string err, string text, code call, *softlist<auto> args, string label) {
        try {
            call_function_args(call, args);
            fail(sprintf("%s: expected %s", label, err));
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "TEST-EXCEPTION") {
                rethrow;
            }
            assertEq(err, ex.err, label + ": " + ex.desc);
            assertTrue(ex.desc.contains(text), sprintf("%s: %y contains %y", label, ex.desc, text));
        }
    }

    private static WebService simple() {
        return new WebService(ReadOnlyFile::readTextFile(get_script_dir() + "/simple.wsdl"));
    }

    private wsdlComponents() {
        WebService ws = simple();
        assertEq("getCompanyInfo", ws.getOperation("getCompanyInfo").name);
        checkError("WSDL-OPERATION-ERROR", "cannot retrieve operation", \ws.getOperation(), ("getCompanyInfo" + Nul,),
            "operation");
        checkError("WSDL-OPERATION-ERROR", "is not a defined port", \ws.getPortTypeOperation(),
            ("pt1" + Nul, "getCompanyInfo"), "port type");
        checkError("WSDL-OPERATION-ERROR", "is not known in port", \ws.getPortTypeOperation(),
            ("pt1", "getCompanyInfo" + Nul), "port type operation");
        checkError("WSDL-BINDING-ERROR", "is not a known binding", \ws.getBindingOperation(),
            ("b1" + Nul, "getCompanyInfo"), "binding of a binding operation");
        checkError("WSDL-OPERATION-ERROR", "is unknown in port type", \ws.getBindingOperation(),
            ("b1", "getCompanyInfo" + Nul), "binding operation");
        checkError("WSDL-BINDING-ERROR", "is not a known binding", \ws.getBinding(), ("b1" + Nul,), "binding");
        checkError("WSDL-SERVICE-ERROR", "is not a known service", \ws.getService(), ("CompanyInfoService" + Nul,),
            "service");
        checkError("WSDL-MESSAGE-ERROR", "is not a known message", \ws.getMessage(), ("m1" + Nul,), "message");
        checkError("WSDL-SERVICE-ERROR", "unknown service", \ws.getPortAddressing(),
            ("CompanyInfoService", "CompanyInfoPort" + Nul), "port addressing");
        checkError("WSDL-SERVICE-ERROR", "unknown service", \ws.getAddressingPolicy(),
            (ws.getOperation("getCompanyInfo"), NOTHING, "CompanyInfoService" + Nul, "CompanyInfoPort"),
            "addressing policy");
        assertTrue(exists ws.getPortAddressing("CompanyInfoService", "CompanyInfoPort"));

        WSMessageHelper helper(ws);
        checkError("MESSAGE-ERROR", "cannot map message", \helper.getMessage(), ("GetCompanyInfo" + Nul,),
            "sample message");
    }

    private operationNames() {
        WebService ws = simple();
        WSOperation op = ws.getOperation("getCompanyInfo");
        assertTrue(op.hasFault("getCompanyInfoFault"));
        checkError("WSDL-OPERATION-ERROR", "declares no fault", \op.getFaultAction(), ("getCompanyInfoFault" + Nul,),
            "fault action");
        checkError("SOAP-SERIALIZATION-ERROR", "unknown fault", \op.serializeFault(),
            ("getCompanyInfoFault" + Nul, "failed", NOTHING), "serialized fault");
        checkError("WSDL-BINDING-ERROR", "requires a bound single-part message", \op.deserializeFault(),
            ("<x/>", "getCompanyInfoFault" + Nul), "deserialized fault");
        checkError("WSDL-BINDING-ERROR", "is not a known binding", \op.getBinding(), ("b1" + Nul,), "binding");
        checkError("WSDL-BINDING-ERROR", "is not a known binding", \op.serializeRequest(),
            ({"GetCompanyInfo": {"tickerSymbol": "QORE"}}, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, "b1" + Nul),
            "serialized request binding");

        WSMessage message = op.output;
        assertEq("GetCompanyInfoResult", message.checkPart("body"));
        foreach string call in ("checkPart", "getDocumentPartNames") {
            checkError("WSDL-ERROR", "part", \call_object_method(), (message, call, "docs" + Nul), call);
        }
        checkError("WSDL-ERROR", "part", \message.deserializeData(), ("docs" + Nul, {}), "deserialized part data");
        checkError("WSDL-ERROR", "no part", \message.serializeData(), (ws.nsc, "docs" + Nul, {}),
            "serialized part data");
        checkError("WSDL-ERROR", "unknown or repeated RPC part", \message.deserializeRpc(),
            (NOTHING, {}, ("docs" + Nul,)), "RPC part");
        checkError("WSDL-ERROR", "part", \message.matchDocumentParts(), (("docs" + Nul,), ()), "matched part");
        checkError("WSDL-ERROR", "part", \message.deserializeDocument(), (NOTHING, {}, ("docs" + Nul,), True),
            "document part");
        # these return a name for an unknown part, and the same for a name with a NUL character
        assertEq("docs" + Nul, message.getSerializedKey("docs" + Nul));
        assertEq("{}docs" + Nul, message.getExpandedSerializedKey("docs" + Nul));
        code<auto(*softlist<auto>)> document = auto sub (*softlist<auto> parts) {
            auto value = {"docs": "text"};
            return message.serializeDocument(parts, NOTHING, NOTHING, False, \value, False);
        };
        checkError("WSDL-ERROR", "part", document, (("docs" + Nul,),), "serialized document part");
    }

    private schemaNames() {
        XsdSchema s('<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:p" targetNamespace="urn:p">'
            '<xs:simpleType name="T"><xs:restriction base="xs:string"/></xs:simpleType>'
            '<xs:attribute name="a" type="xs:string"/>'
            '<xs:element name="e"><xs:complexType><xs:sequence><xs:element name="c" type="xs:string"/></xs:sequence>'
            '</xs:complexType></xs:element></xs:schema>', {"async_only": True});
        assertTrue(exists s.getElement("urn:p", "e"));
        assertFalse(exists s.getElement("urn:p", "e" + Nul));
        assertFalse(exists s.getElement("urn:p" + Nul, "e"));
        assertEq(("e",), s.getElementNames("urn:p"));
        assertEq((), s.getElementNames("urn:p" + Nul));
        assertTrue(exists s.getAttribute("urn:p", "a"));
        assertFalse(exists s.getAttribute("urn:p", "a" + Nul));
        assertTrue(exists s.findType("{urn:p}T"));
        assertFalse(exists s.findType("{urn:p}T" + Nul));
        assertFalse(exists s.nsc.getIdentityConstraintRegistry().get("{urn:p}u" + Nul));

        # a malformed expanded child name is refused before the particle program remembers anything
        XsdParticle particle = cast<XsdComplexType>(s.getElement("urn:p", "e").type).getParticle();
        # the child is unqualified (elementFormDefault)
        assertTrue(particle.matchesElementNames(("{}c",)));
        checkError("XSD-PARTICLE-ERROR", "invalid expanded child element name", \particle.matchesElementNames(),
            (("{urn:p" + Nul + "}c",),), "particle match");
        checkError("XSD-PARTICLE-ERROR", "invalid expanded child element name", \particle.orderElementNames(),
            (("{urn:p" + Nul + "}c",),), "particle order");

        # builtin names given to provider constructors
        checkError("WSDL-ERROR", "unknown integer builtin", sub () { new XsdIntegerDataType("int" + Nul); }, NOTHING,
            "integer builtin");
        checkError("XSD-SIMPLETYPE-ERROR", "not XML character text", sub () {
            new XsdSizedRestrictionDataType(<XsdSizedFacetInfo>{"name": "x", "kind": "string",
                "white_space": "preserve", "enumeration": ("a" + Nul,)}, AbstractDataProviderType::get(StringType));
        }, NOTHING, "string enumeration");
    }

    private patternNames() {
        checkError("XSD-REGEX-ERROR", "not XML character text", \XsdRegexHelper::toPcre(), ("a\\" + Nul,),
            "escape");
        checkError("XSD-REGEX-ERROR", "not XML character text", sub () { new XsdCompiledPattern("[a-" + Nul + "]"); },
            NOTHING, "class range");
        assertFalse(exists XsdRegexHelper::getSampleValue("a" + Nul));
        assertEq('\x{0000}-\x{007F}', XsdRegexHelper::getBlockRange("IsBasicLatin"));
        assertFalse(exists XsdRegexHelper::getBlockRange("IsBasic" + Nul + "Latin"));
        assertEq("b", WSDLLib::getContentTypeParameter("text/plain;a=b", "a"));
        assertFalse(exists WSDLLib::getContentTypeParameter("text/plain;a=b", "a" + Nul));
    }

    private soapClientOptions() {
        WebService ws = simple();
        checkError("SOAP-CLIENT-ERROR", "has no port", sub () {
            new SoapClient({"wsdl": ws, "port": "CompanyInfoPort" + Nul});
        }, NOTHING, "client port");
        checkError("WSDL-SERVICE-ERROR", "is not a known service", sub () {
            new SoapClient({"wsdl": ws, "service": "CompanyInfoService" + Nul});
        }, NOTHING, "client service");
        checkError("SOAPCLIENT-ERROR", "send content encoding option", sub () {
            new SoapClient({"wsdl": ws, "send_encoding": "gzip" + Nul});
        }, NOTHING, "send encoding");
        checkError("SOAPCLIENT-ERROR", "content encoding option", sub () {
            new SoapClient({"wsdl": ws, "send_encoding": "gzip", "content_encoding": "gzip" + Nul});
        }, NOTHING, "content encoding");
        SoapClient client({"wsdl": ws});
        checkError("WSDL-OPERATION-ERROR", "", \client.callOperation(), ("getCompanyInfo" + Nul, {}),
            "client operation");
        checkError("SOAP-CLIENT-IO-ERROR", "has no port", sub () {
            new SoapClientIo({"wsdl": ws, "port": "CompanyInfoPort" + Nul});
        }, NOTHING, "client I/O port");
    }

    private soapHandler() {
        WebService ws = simple();
        WSOperation op = ws.getOperation("getCompanyInfo");
        code<auto(hash<auto>, auto)> callback = auto sub (hash<auto> cx, auto data) {
            return {"GetCompanyInfoResult": {"result": 1.0}};
        };
        SoapHandler handler(new PermissiveAuthenticator());
        # a refused registration leaves nothing behind, so the same names can be registered afterwards
        checkError("SOAP-SERVER-ADDMETHOD-PARAMETER-ERROR", "cannot contain a NUL character", \handler.addMethod(),
            (ws, op, callback, NOTHING, NOTHING, NOTHING, "orders" + Nul), "path");
        checkError("SOAP-SERVER-ADDMETHOD-PARAMETER-ERROR", "cannot contain a NUL character", \handler.addMethod(),
            (ws, op, callback, NOTHING, NOTHING, NOTHING, "orders", NOTHING, "orders" + Nul), "alternate path");
        checkError("SOAP-SERVER-ADDMETHOD-PARAMETER-ERROR", "cannot contain a NUL character", \handler.addMethod(),
            (ws, op, callback, NOTHING, NOTHING, NOTHING, "orders", NOTHING, NOTHING, NOTHING, "id" + Nul),
            "unique ID");
        handler.addMethod(ws, op, callback, NOTHING, NOTHING, NOTHING, "orders", NOTHING, "orders", NOTHING, "id");
        handler.removeService("id" + Nul);
        handler.removeService("id");
        handler.addMethod(ws, op, callback, NOTHING, NOTHING, NOTHING, "orders", NOTHING, "orders", NOTHING, "id");
    }

    private xmlRpcHandler() {
        XmlRpcHandler handler(new PermissiveAuthenticator(), ({"name": "^echo$", "function": auto sub (auto v) {
            return v;
        }, "text": "echo", "help": "echoes its argument", "logopt": 0},));
        checkError("XML-RPC-ADDMETHOD-ERROR", "cannot contain a NUL character", \handler.addMethod(),
            ("^x$", sub () {}, "x" + Nul, "help", 0, NOTHING), "method text");
        checkError("XML-RPC-CONSTRUCTOR-ERROR", "cannot contain a NUL character", sub () {
            new XmlRpcHandler(new PermissiveAuthenticator(), ({"name": "^x$", "function": sub () {}, "text": "x" + Nul,
                "help": "", "logopt": 0},));
        }, NOTHING, "constructor method text");

        HttpServer server();
        on_exit server.stop();
        server.setDefaultHandler("xmlrpc", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        assertEq(200, status(port, "GET /echo?v=1"));
        assertEq(400, status(port, "GET /ec%00ho?v=1"));
        assertEq(400, status(port, "GET /echo?v%00x=1"));
    }

    # sends the request line as given; HTTPClient would escape its percent signs
    private static int status(int port, string request_line) {
        Socket socket();
        socket.connect(sprintf("127.0.0.1:%d", port), 30s);
        on_exit socket.close();
        socket.send(request_line + " HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n");
        return socket.readHTTPHeader(30s).status_code;
    }

    private providers() {
        CargoXmlDataProvider::CargoXmlDataProvider cargo();
        assertTrue(exists cargo.getChildProvider("parse-message"));
        assertFalse(exists cargo.getChildProvider("parse-message" + Nul));
        hash<string, hash<auto>> requests = {
            "parse-message": {"message_qname": "{no.such}Message" + Nul, "xml": "<x/>", "validate": False},
            "build-message": {"message_qname": "{no.such}Message" + Nul, "data": {}, "validate": False},
        };
        foreach hash<auto> request in (requests.pairIterator()) {
            AbstractDataProvider provider = cargo.getChildProviderEx(request.key);
            checkError("CARGO-XML-MESSAGE-ERROR", "unknown cargo XML message", \provider.doRequest(),
                (request.value,), request.key);
        }
        CdaDataProvider::CdaDataProvider cda({"xsd_path": get_script_dir() + "/cda-test-schema/cda-test.xsd"});
        assertTrue(exists cda.getChildProvider("parse-document"));
        assertFalse(exists cda.getChildProvider("parse-document" + Nul));
        WebDavClientDataProvider::WebDavClientDataProvider webdav(new WebDavClient({"url": "http://127.0.0.1:1/"}));
        assertTrue(exists webdav.getChildProvider("list"));
        assertFalse(exists webdav.getChildProvider("list" + Nul));
        SoapDataProvider::SoapDataProvider soap({"schema": ReadOnlyFile::readTextFile(get_script_dir()
            + "/simple.wsdl")});
        assertTrue(exists soap.getChildProvider("getCompanyInfo"));
        assertFalse(exists soap.getChildProvider("getCompanyInfo" + Nul));
    }

    private elementNames() {
        # make_xml() refuses another character that XML cannot contain in a name the same way
        WebDavClient client({"url": "http://127.0.0.1:1/"});
        checkError("MAKE-XML-ERROR", "U+0000", \client.propfind(), ("/", "1", ("getetag" + Nul,)), "property");
        WebDavClientIo::WebDavClientIo io({"url": "http://127.0.0.1:1/"});
        checkError("MAKE-XML-ERROR", "U+0000", \io.propfind(), ("/", "1", ("getetag" + Nul,)), "I/O property");
        foreach string option in ("root_element_name", "element_name") {
            SaxDataProvider::SaxWriteDataProvider writer({option: "r" + Nul});
            checkError("MAKE-XML-ERROR", "U+0000", \writer.getData(), NOTHING, option);
        }
        SaxDataProvider::SaxWriteDataProvider writer();
        assertRegex("<records", binary_to_string(writer.getData()));
    }

    private robotsUserAgent() {
        string content = "User-agent: mybot\nDisallow: /private/\n\nUser-agent: *\nDisallow: /admin/\n";
        # a crawler name with a NUL character names no group exactly; "mybot" is still a prefix of it
        RobotsTxt prefixed(content, "mybot" + Nul + "x");
        assertFalse(prefixed.isAllowed("/private/x"));
        RobotsTxt other(content, "other" + Nul);
        assertTrue(other.isAllowed("/private/x"));
        assertFalse(other.isAllowed("/admin/x"));
    }
}
