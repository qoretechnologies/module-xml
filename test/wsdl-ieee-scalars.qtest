#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class IeeeScalarsTest

class IeeeScalarsTest inherits QUnit::Test {
    constructor() : Test("WSDL IEEE scalar conversion", "1.0") {
        addTestCase("Complete lexical validation at scalar boundaries", \lexical());
        addTestCase("Native values round directly at the declared precision", \native());
        addTestCase("Provider requiredness, lists and reconstruction", \providers());
        addTestCase("Provider metadata rejects malformed precision and requiredness", \metadata());
        addTestCase("Schema reconstruction, attributes, lists and union alternatives", \schemas());
        addTestCase("Dynamic builtin annotations retain IEEE precision", \dynamic());
        set_return_value(main());
    }

    private same(float expected, auto actual) {
        assertEq(NT_FLOAT, actual.typeCode());
        # Exact round-trip spelling also distinguishes signed zero and compares NaN by schema identity.
        assertEq(expected.toStringRoundTrip(), actual.toStringRoundTrip());
    }

    lexical() {
        Namespaces ns({});
        foreach string builtin in ("float", "double") {
            XsdBaseType type = ns.getBaseType(builtin);
            foreach auto invalid in ("", " \t\r\n", ".", "+", "-", "+.", "-.", "1tail", "1e", "1e+",
                    "1e-", "1e2e3", "1.2.3", "1 2", "1e2.0", "1\x00tail", "1\x00", "\x001", "1,2", "0x1p0",
                    "NaN-tail", "+NaN", "-NaN", "nan", "inf", "+INF", "++1", "--1", "1_0", "١", "１",
                    "\x0b1", "1\x0c", "1\u00a0", True, False, NULL, NOTHING, binary("1"), (1,), {"child": "1"}) {
                assertThrows("SOAP-SERIALIZATION-ERROR", \type.serializeValue(), (ns, invalid, True));
                assertThrows("SOAP-DESERIALIZATION-ERROR", \type.deserializeValue(), ("value", {}, NOTHING, invalid));
            }
            foreach hash<auto> row in (
                    {"text": "1.", "value": 1.0}, {"text": ".5", "value": 0.5},
                    {"text": "+001.25e+2", "value": 125.0}, {"text": " \t-1.25\r\n", "value": -1.25},
                    {"text": "-0e999999999999999999999", "value": -0.0},
                    {"text": "0e-999999999999999999999", "value": 0.0},
                    {"text": "-1e-999999999999999999999", "value": -0.0},
                    {"text": "1e999999999999999999999", "value": @inf@},
                    {"text": "NaN", "value": @nan@}, {"text": "-INF", "value": -@inf@},
                    {"text": "INF", "value": @inf@},
                    {"text": "16777217", "value": builtin == "float" ? 16777216.0 : 16777217.0},
                    {"text": "0.1", "value": builtin == "float" ? 0.10000000149011612 : 0.1},
                    {"text": "3.5e38", "value": builtin == "float" ? @inf@ : 3.5e38}) {
                same(row.value, type.deserializeValue("value", {}, NOTHING, row.text));
                same(row.value, type.deserializeValue("value", {}, NOTHING, convert_encoding(row.text, "UTF-16LE")));
                string output = type.serializeValue(ns, row.text, True);
                assertEq(XsdSimpleType::normalizeWhiteSpace(row.text, "collapse"), output);
                same(row.value, type.deserializeValue("value", {}, NOTHING, output));
                same(row.value, type.deserializeValue("value", {}, NOTHING, type.serializeValue(ns, row.value, True)));
            }
        }
    }

    native() {
        Namespaces ns({});
        XsdBaseType narrow = ns.getBaseType("float");
        foreach hash<auto> row in (
                {"value": 1.000000059604644775390625, "expected": 1.0},
                {"value": number("1.00000005960464477539062500000000001"), "expected": 1.0000001192092896},
                {"value": number("1.00000005960464477539062499999999999"), "expected": 1.0},
                {"value": 4611686293305294848, "expected": 4611686018427387904.0},
                {"value": 4611686293305294849, "expected": 4611686568183201792.0},
                {"value": number("-0"), "expected": -0.0}, {"value": @nan@, "expected": @nan@},
                {"value": number(@inf@), "expected": @inf@}) {
            same(row.expected, narrow.deserializeValue("value", {}, NOTHING, row.value));
            same(row.expected, narrow.deserializeValue("value", {}, NOTHING, narrow.serializeValue(ns, row.value, True)));
            same(row.expected, narrow.getDataProviderType().acceptsValue(row.value));
        }
        XsdBaseType wide = ns.getBaseType("double");
        same(1.0000000000000002, wide.deserializeValue("value", {}, NOTHING,
            "1.00000000000000011102230246251565404236316680908203125001"));
        same(5e-324, wide.deserializeValue("value", {}, NOTHING, "4.9406564584124654e-324"));
        same(1.401298464324817e-45, narrow.deserializeValue("value", {}, NOTHING, "1.401298464324817e-45"));
    }

    providers() {
        Namespaces ns({});
        foreach string builtin in ("float", "double") {
            AbstractDataProviderType original = ns.getBaseType(builtin).getDataProviderType();
            foreach AbstractDataProviderType type in (original, Serializable::deserialize(original.serialize()),
                    original.getOrNothingType().getMandatoryType()) {
                assertEq("xsd:" + builtin, type.getName());
                assertEq(NT_FLOAT, type.getBaseTypeCode());
                assertEq("float", type.getBaseTypeName());
                assertEq(NOTHING, type.getValueType());
                assertEq(NOTHING, type.getElementType());
                assertEq(NOTHING, type.getFields());
                assertEq({}, type.getDirectTypeHash());
                assertEq({"float": True}, type.getReturnTypeHash());
                assertEq({"float": True, "number": True, "int": True, "string": True}, type.getAcceptTypeHash());
                assertTrue(type.isMandatory());
                assertFalse(type.isOrNothingType());
                assertThrows("MISSING-VALUE-ERROR", \type.acceptsValue(), (NOTHING,));
                AbstractDataProviderType optional = Serializable::deserialize(type.getOrNothingType().serialize());
                assertEq("*xsd:" + builtin, optional.getName());
                assertEq({"float": True, "nothing": True}, optional.getReturnTypeHash());
                assertFalse(optional.isMandatory());
                assertTrue(optional.isOrNothingType());
                assertEq(NOTHING, optional.acceptsValue(NOTHING));
                assertTrue(optional.getOrNothingType() === optional);
                assertTrue(type.getMandatoryType() === type);
                ListDataType values("readings", type);
                float expected = builtin == "float" ? 16777216.0 : 16777217.0;
                same(expected, type.acceptsValue("16777217"));
                same(expected, optional.acceptsValue(16777217));
                same(expected, values.acceptsValue(("16777217",))[0]);
                foreach auto invalid in ("1tail", "", True, NULL, binary("1")) {
                    assertThrows("RUNTIME-TYPE-ERROR", \type.acceptsValue(), (invalid,));
                    assertThrows("RUNTIME-TYPE-ERROR", \optional.acceptsValue(), (invalid,));
                    assertThrows("RUNTIME-TYPE-ERROR", \values.acceptsValue(), (("1", invalid),));
                }
                same(-0.0, values.acceptsValue(("-0",))[0]);
                same(@nan@, values.acceptsValue(("NaN",))[0]);
            }
        }
    }

    metadata() {
        assertThrows("WSDL-ERROR", sub() { new XsdIeeeDataType("decimal"); });
        hash<SerializationInfo> original = new XsdIeeeDataType("float").serializeToData();
        foreach auto invalid in ("decimal", "Float", "", NULL, NOTHING, 1) {
            hash<SerializationInfo> state = original;
            state._index."0"._class_data."WSDL::XsdIeeeDataType".datatype = invalid;
            assertThrows("DESERIALIZATION-ERROR", \Serializable::deserialize(), (state,));
        }
        foreach auto invalid in (1, "false", NULL, NOTHING) {
            hash<SerializationInfo> state = original;
            state._index."0"._class_data."WSDL::XsdIeeeDataType".optional = invalid;
            assertThrows("DESERIALIZATION-ERROR", \Serializable::deserialize(), (state,));
        }
        same(16777216.0, cast<XsdIeeeDataType>(Serializable::deserialize(original)).acceptsValue("16777217"));
    }

    schemas() {
        XsdSchema original('<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:ieee" targetNamespace="urn:ieee">
            <xs:complexType name="Reading"><xs:simpleContent><xs:extension base="xs:float">
                <xs:attribute name="precise" type="xs:double" use="required"/>
            </xs:extension></xs:simpleContent></xs:complexType>
            <xs:simpleType name="Readings"><xs:list itemType="xs:float"/></xs:simpleType>
            <xs:simpleType name="Alternative"><xs:union memberTypes="xs:float xs:boolean"/></xs:simpleType>
            </xs:schema>', {"async_only": True});
        foreach XsdSchema schema in (original, Serializable::deserialize(original.serialize())) {
            Namespaces ns({});
            XsdAbstractType reading = schema.findType(make_qname("urn:ieee", "Reading"));
            hash<auto> input = {"^value^": "16777217", "^attributes^": {"precise": "16777217"}};
            hash<auto> output = reading.deserializeValue("value", schema.getTypeMap(), NOTHING, input);
            same(16777216.0, output."^value^");
            same(16777217.0, output."^attributes^".precise);
            foreach hash<auto> invalid in (
                    {"^value^": "1tail", "^attributes^": {"precise": "1"}},
                    {"^value^": "1", "^attributes^": {"precise": "1tail"}}) {
                assertThrows("SOAP-DESERIALIZATION-ERROR", \reading.deserializeValue(),
                    ("value", schema.getTypeMap(), NOTHING, invalid));
                assertThrows("SOAP-SERIALIZATION-ERROR", \reading.serializeValue(), (ns, invalid, True));
            }
            XsdAbstractType readings = schema.findType(make_qname("urn:ieee", "Readings"));
            list<auto> values = readings.deserializeValue("value", schema.getTypeMap(), NOTHING, "16777217 -0 NaN");
            same(16777216.0, values[0]);
            same(-0.0, values[1]);
            same(@nan@, values[2]);
            assertThrows("SOAP-DESERIALIZATION-ERROR", \readings.deserializeValue(),
                ("value", schema.getTypeMap(), NOTHING, "1 2tail"));
            assertThrows("SOAP-SERIALIZATION-ERROR", \readings.serializeValue(), (ns, (1, "2tail"), True));
            XsdAbstractType alternative = schema.findType(make_qname("urn:ieee", "Alternative"));
            same(16777216.0, alternative.deserializeValue("value", schema.getTypeMap(), NOTHING, "16777217"));
            assertEq(True, alternative.deserializeValue("value", schema.getTypeMap(), NOTHING, "true"));
            assertThrows("SOAP-DESERIALIZATION-ERROR", \alternative.deserializeValue(),
                ("value", schema.getTypeMap(), NOTHING, "1tail"));
        }
    }

    dynamic() {
        Namespaces ns({});
        XsdBaseType type = ns.getBaseType("anyType");
        foreach string builtin in ("float", "double") {
            same(builtin == "float" ? 16777216.0 : 16777217.0,
                type.deserializeValue("value", {}, NOTHING,
                    {"^value^": "16777217", "^attributes^": {"xsi:type": "xsd:" + builtin}}));
        }
        hash<auto> encoded = type.serializeValue(ns, 1.25);
        same(1.25, type.deserializeValue("value", {}, NOTHING, encoded));
    }
}
