#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class SoapHttpBindingTest

class SoapHttpBindingTest inherits QUnit::Test {
    constructor() : Test("SOAP HTTP media and method boundaries", "1.0") {
        addTestCase("Normalized XML roots validate media and version identity", \media());
        addTestCase("Transport validation is explicit and version negotiation precedes media identity", \transport());
        set_return_value(main());
    }
    private media() {
        foreach *bool version in (NOTHING,False,True) {
            foreach string type in ("text/xml", "application/xml", "application/soap+xml") {
                if (type == "application/soap+xml" && exists version && !version) { continue; }
                foreach string spelling in (type, type.upr()+";CHARSET=\"UTF-8\"", type+";charset=UTF-8;charset=utf-8") {
                    assertEq(type,WSDLLib::validateSOAPMediaType({"content-type":spelling},version));
                    assertEq(type,WSDLLib::validateSOAPMediaType({"content-type":
                        'application/xop+xml;type="'+replace(spelling,"\"","\\\"")+'"'},version));
                }
            }
            foreach string type in ("text/plain", "application/json", "application/octet-stream", "image/jpeg",
                    "multipart/related", "application/unknown+xml", "text/xml;charset=unknown-qore-test") {
                assertThrows("SOAP-MEDIA-TYPE-ERROR",\WSDLLib::validateSOAPMediaType(),({"content-type":type},version));
                assertThrows("SOAP-MEDIA-TYPE-ERROR",\WSDLLib::validateSOAPMediaType(),({"content-type":
                    'application/xop+xml;type="'+type+'"'},version));
            }
            assertThrows("SOAP-MEDIA-TYPE-ERROR",\WSDLLib::validateSOAPMediaType(),({},version));
            foreach string type in ("", "broken;type", "text/xml trailing", "text/xml;charset", "text/xml;charset=\"UTF-8",
                    'text/xml;charset=""', "text/xml;charset=UTF-8;charset=ISO-8859-1", "application/xop+xml", "application/xop+xml;type=broken",
                    'application/xop+xml;type="text/xml";type="application/soap+xml"') {
                assertThrows("SOAP-MESSAGE-ERROR",\WSDLLib::validateSOAPMediaType(),({"content-type":type},version));
            }
        }
        assertThrows("SOAP-MEDIA-TYPE-ERROR",\WSDLLib::validateSOAPMediaType(),({"content-type":"application/soap+xml"},False));
        assertThrows("SOAP-MEDIA-TYPE-ERROR",\WSDLLib::validateSOAPMediaType(),({"content-type":
            'application/xop+xml;type="application/soap+xml"'},False));
        # Action syntax has its own protocol-stage validation after an envelope exists.
        assertEq("application/soap+xml",WSDLLib::validateSOAPMediaType({"content-type":
            'application/soap+xml;action="urn:first";action="urn:second"'},True));
    }
    private transport() {
        hash<auto> message = {"content-type":"text/plain","body":"invoice"};
        assertEq(message.body,WSDLLib::parseMultiPartSOAPMessage(message,True).body);
        assertEq(message.body,WSDLLib::parseMultiPartSOAPMessage(message).body);
        assertThrows("SOAP-MEDIA-TYPE-ERROR",\WSDLLib::parseMultiPartSOAPMessage(),(message,False,True));
        assertThrows("SOAP-MESSAGE-ERROR",\WSDLLib::parseMultiPartSOAPMessage(),(message,True,True));
        foreach string type in ("multipart/mixed", "multipart/alternative", "multipart/form-data") {
            assertThrows("SOAP-MEDIA-TYPE-ERROR",\WSDLLib::parseMultiPartSOAPMessage(),
                ({"content-type":type+";boundary=root", "body":"--root--"},False,True));
        }
        string fault = '<e:Envelope xmlns:e="'+SOAP_11_ENV+'"><e:Body><e:Fault><faultcode>e:VersionMismatch</faultcode>'
            +'<faultstring>unsupported version</faultstring></e:Fault></e:Body></e:Envelope>';
        hash<auto> parsed = parse_xml(fault, XPF_PRESERVE_ORDER);
        assertThrows("SOAP-VERSION-MISMATCH",\WSDLLib::validateSOAPEnvelope(),(parsed,True));
        assertFalse(WSDLLib::validateSOAPEnvelope(parsed,True,True));
        assertThrows("SOAP-VERSION-MISMATCH",\WSDLLib::validateSOAPEnvelope(),
            (parse_xml(replace(fault,"e:VersionMismatch","e:Server"),XPF_PRESERVE_ORDER),True,True));
        assertEq("text/xml",WSDLLib::validateSOAPMediaType({"content-type":"text/xml"},False));
    }

}
