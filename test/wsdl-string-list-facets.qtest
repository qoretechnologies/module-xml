#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class StringListFacetTest

class StringListFacetTest inherits QUnit::Test {
    constructor() : Test("XSD string and list facets", "1.0") {
        addTestCase("String enumeration uses the base whitespace value space", \enumerations());
        addTestCase("Derived whitespace normalizes before ancestor lexical constraints", \whitespace());
        addTestCase("Unicode character counts and providers enforce string lengths", \characters());
        addTestCase("Length declarations validate exact counts before conversion", \lengthDeclarations());
        addTestCase("Length and whitespace restrictions narrow and preserve fixed values", \derivation());
        addTestCase("List lengths count typed items through reconstructed providers", \lists());
        addTestCase("String examples satisfy complete inherited restrictions", \examples());
        addTestCase("Provider metadata, omission, and nested list validation", \providers());
        addTestCase("Record and attribute fields normalize before checking allowed choices", \fields());
        addTestCase("Binary lengths count octets and QName length facets are always satisfied", \otherLengths());
        addTestCase("Builtin text providers normalize and reject nonscalar values", \builtinProviders());
        addTestCase("Invalid serialized restrictions and failed schema additions preserve valid state", \invalidState());
        set_return_value(main());
    }

    private static string source(string base, string facets, *string parent, bool list_type = False) {
        string declaration = list_type ? '<xs:list itemType="xs:' + base + '"/>'
            : '<xs:restriction base="xs:' + base + '">' + (parent ?? "") + '</xs:restriction>';
        return '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:string-facets"
            targetNamespace="urn:string-facets"><xs:simpleType name="Base">' + declaration
            + '</xs:simpleType><xs:simpleType name="Value"><xs:restriction base="t:Base">' + facets
            + '</xs:restriction></xs:simpleType></xs:schema>';
    }

    private static XsdSchema schema(string base, string facets, *string parent, bool list_type = False) {
        return new XsdSchema(source(base, facets, parent, list_type), {"async_only": True});
    }

    private reject(string base, string facets, *string parent, bool list_type = False) {
        assertThrows("XSD-SIMPLETYPE-ERROR", \schema(), (base, facets, parent, list_type));
    }

    private check(string base, string facets, auto input, auto expected, *string parent, bool list_type = False) {
        XsdSchema original = schema(base, facets, parent, list_type);
        foreach XsdSchema copy in (original, Serializable::deserialize(original.serialize())) {
            XsdAbstractType type = copy.findType(make_qname("urn:string-facets", "Value"));
            auto value = type.deserializeValue("value", copy.getTypeMap(), NOTHING, input);
            assertEq(expected, value);
            assertEq(expected, type.deserializeValue("value", copy.getTypeMap(), NOTHING,
                type.serializeValue(new Namespaces({}), value, True)));
            AbstractDataProviderType provider = Serializable::deserialize(type.getDataProviderType().serialize());
            assertEq(expected, provider.acceptsValue(list_type ? expected : input));
        }
    }

    private invalidValue(string base, string facets, auto value, *string parent, bool list_type = False) {
        XsdSchema definition = schema(base, facets, parent, list_type);
        XsdAbstractType type = definition.findType(make_qname("urn:string-facets", "Value"));
        AbstractDataProviderType provider = type.getDataProviderType();
        assertThrows("SOAP-SERIALIZATION-ERROR", \type.serializeValue(), (new Namespaces({}), value, True));
        assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (value,));
        if (!list_type) {
            assertThrows("SOAP-DESERIALIZATION-ERROR", \type.deserializeValue(),
                ("value", definition.getTypeMap(), NOTHING, value));
        }
    }

    private enumerations() {
        check("token", '<xs:enumeration value=" A&#x9; B "/>', "  A\t B ", "A B");
        check("normalizedString", '<xs:enumeration value="A&#x9;B"/>', "A\nB", "A B");
        check("string", '<xs:enumeration value=""/>', "", "");
        invalidValue("token", '<xs:enumeration value=" A B "/>', "A  C");
        # This step's whitespace does not change the enumeration's base-space value.
        invalidValue("string", '<xs:whiteSpace value="collapse"/><xs:enumeration value=" A B "/>', "A B");
    }

    private whitespace() {
        check("string", '<xs:whiteSpace value="collapse"/>', " A\t  B ", "A B", '<xs:pattern value="A B"/>');
        check("string", '<xs:whiteSpace value="collapse"/>', " A\t  B ", "A B", '<xs:enumeration value="A B"/>');
        check("string", '<xs:whiteSpace value="replace"/>', "A\tB", "A B", '<xs:length value="3"/>');
        invalidValue("string", '<xs:whiteSpace value="collapse"/>', "A\u00a0B", '<xs:pattern value="A B"/>');
        invalidValue("string", '<xs:pattern value="A"/>', "A\n");
    }

    private characters() {
        check("string", '<xs:length value="1"/>', "😀", "😀");
        check("string", '<xs:length value="2"/>', "é", "é");
        invalidValue("string", '<xs:length value="1"/>', "é");
        check("token", '<xs:minLength value="3"/><xs:maxLength value="3"/>', " A  B ", "A B");
        invalidValue("string", '<xs:maxLength value="1"/>', "ab");
        check("string", '<xs:maxLength value="0"/>', "", "");
    }

    private lengthDeclarations() {
        foreach string name in ("length", "minLength", "maxLength") {
            foreach string value in ("", "-1", "1x", "1.0", "1e2", "١") {
                reject("string", '<xs:' + name + ' value="' + value + '"/>');
            }
        }
        reject("string", '<xs:minInclusive value="1"/>');
        reject("boolean", '<xs:length value="1"/>');
        reject("string", '<xs:minLength value="3"/><xs:maxLength value="2"/>');
        check("string", '<xs:maxLength value="9223372036854775808"/>', "abc", "abc");
        reject("string", '<xs:maxLength value="9223372036854775809"/>',
            '<xs:maxLength value="9223372036854775808"/>');
    }

    private derivation() {
        reject("string", '<xs:minLength value="1"/>', '<xs:minLength value="2"/>');
        reject("string", '<xs:maxLength value="3"/>', '<xs:maxLength value="2"/>');
        reject("string", '<xs:length value="2"/>', '<xs:length value="3"/>');
        reject("string", '<xs:length value="3"/><xs:minLength value="2"/>');
        reject("string", '<xs:minLength value="2"/>', '<xs:length value="3"/>');
        check("string", '<xs:length value="3"/>', "abc", "abc", '<xs:minLength value="2"/>');
        check("string", '<xs:length value="3"/><xs:minLength value="2"/>', "abc", "abc",
            '<xs:minLength value="2"/>');
        reject("string", '<xs:maxLength value="2"/>', '<xs:maxLength value="3" fixed="true"/>');
        reject("normalizedString", '<xs:whiteSpace value="preserve"/>');
        reject("token", '<xs:whiteSpace value="replace"/>');
        reject("string", '<xs:whiteSpace value="collapse"/>', '<xs:whiteSpace value="replace" fixed="true"/>');
    }

    private lists() {
        check("integer", '<xs:length value="2"/>', "1\t2", (1, 2), NOTHING, True);
        check("string", '<xs:length value="0"/>', " \t ", (), NOTHING, True);
        invalidValue("integer", '<xs:length value="2"/>', (1,), NOTHING, True);
        invalidValue("integer", '<xs:maxLength value="1"/>', (1, 2), NOTHING, True);
        foreach string base in ("integer", "string") {
            XsdSchema single = schema(base, '<xs:length value="1"/>', NOTHING, True);
            XsdAbstractType type = single.findType(make_qname("urn:string-facets", "Value"));
            assertEq("123", type.serializeValue(new Namespaces({}), base == "integer" ? 123 : "123", True));
            assertThrows("SOAP-SERIALIZATION-ERROR", \type.serializeValue(), (new Namespaces({}), NOTHING, True));
            XsdSchema empty = schema(base, '<xs:length value="0"/>', NOTHING, True);
            assertEq("", empty.findType(make_qname("urn:string-facets", "Value"))
                .serializeValue(new Namespaces({}), NOTHING, True));
            XsdSchema three = schema(base, '<xs:length value="3"/>', NOTHING, True);
            type = three.findType(make_qname("urn:string-facets", "Value"));
            assertThrows("SOAP-SERIALIZATION-ERROR", \type.serializeValue(),
                (new Namespaces({}), base == "integer" ? 123 : "123", True));
        }
        reject("integer", '<xs:whiteSpace value="preserve"/>', NOTHING, True);
        reject("integer", '<xs:minInclusive value="1"/>', NOTHING, True);
        foreach string base in ("NMTOKENS", "IDREFS", "ENTITIES") {
            check(base, '<xs:length value="2"/>', " A\t B ", "A B");
            invalidValue(base, '<xs:length value="2"/>', "A");
            reject(base, '<xs:length value="0"/>');
            reject(base, '<xs:minLength value="0"/>');
            reject(base, '<xs:maxLength value="0"/>');
            invalidValue(base, '', " \t ");
        }
    }

    private examples() {
        XsdSchema definition = schema("token", '<xs:enumeration value=" A B "/>');
        XsdSimpleType type = cast<XsdSimpleType>(definition.findType(make_qname("urn:string-facets", "Value")));
        auto sample = type.getSampleValue("default");
        assertEq("A B", type.deserializeValue("value", definition.getTypeMap(), NOTHING,
            type.serializeValue(new Namespaces({}), sample, True)));
        definition = schema("string", '<xs:pattern value="X"/>', '<xs:enumeration value="Y"/>');
        type = cast<XsdSimpleType>(definition.findType(make_qname("urn:string-facets", "Value")));
        assertThrows("XSD-SAMPLE-ERROR", \type.getSampleValue(), "default");
        definition = schema("string", '<xs:minLength value="9223372036854775808"/>');
        type = cast<XsdSimpleType>(definition.findType(make_qname("urn:string-facets", "Value")));
        assertThrows("XSD-SAMPLE-ERROR", \type.getSampleValue(), "default");
        definition = schema("string", '<xs:maxLength value="9223372036854775808"/>');
        type = cast<XsdSimpleType>(definition.findType(make_qname("urn:string-facets", "Value")));
        assertEq("default", type.getSampleValue("default"));
        definition = schema("string", '<xs:maxLength value="0"/>');
        type = cast<XsdSimpleType>(definition.findType(make_qname("urn:string-facets", "Value")));
        assertEq("", type.getSampleValue("default"));
        foreach string base in ("integer", "string") {
            definition = schema(base, '<xs:length value="2"/>', NOTHING, True);
            type = cast<XsdSimpleType>(definition.findType(make_qname("urn:string-facets", "Value")));
            auto item = base == "integer" ? 123 : "abc";
            assertEq((item, item), type.getSampleValue((item,)));
            definition = schema(base, '<xs:length value="0"/>', NOTHING, True);
            type = cast<XsdSimpleType>(definition.findType(make_qname("urn:string-facets", "Value")));
            assertEq((), type.getSampleValue((item,)));
            definition = schema(base, '<xs:minLength value="9223372036854775808"/>', NOTHING, True);
            type = cast<XsdSimpleType>(definition.findType(make_qname("urn:string-facets", "Value")));
            assertThrows("XSD-SAMPLE-ERROR", \type.getSampleValue(), ((item,),));
        }
    }

    private builtinProviders() {
        Namespaces namespaces({});
        foreach string name in ("string", "normalizedString", "token", "NMTOKENS") {
            string expected = name == "string" ? " A\t B " : name == "normalizedString" ? " A  B " : "A B";
            AbstractDataProviderType original = namespaces.getBaseType(name).getDataProviderType();
            foreach AbstractDataProviderType provider in (original, Serializable::deserialize(original.serialize())) {
                assertEq(expected, provider.acceptsValue(" A\t B "));
                foreach auto invalid in ({"x": 1}, ("A", "B")) {
                    assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (invalid,));
                }
                assertEq(NOTHING, provider.getOrNothingType().acceptsValue(NOTHING));
            }
        }
    }

    private invalidState() {
        AbstractDataProviderType provider = detachedProvider();
        hash<SerializationInfo> original = provider.serializeToData();
        foreach hash<auto> change in ({"kind": "binary"}, {"white_space": "trim"},
                {"min_length": "1tail"}, {"max_length": "-1"}, {"patterns": ("[",)}) {
            hash<SerializationInfo> state = original;
            string index = state._index."0"._class_data."WSDL::XsdSizedRestrictionDataType".facets._index;
            state._index{index}._members += change;
            assertThrows("DESERIALIZATION-ERROR", \Serializable::deserialize(), (state,));
        }
        hash<SerializationInfo> state = original;
        state._index."0"._class_data."WSDL::XsdSizedRestrictionDataType".base = NOTHING;
        assertThrows("DESERIALIZATION-ERROR", \Serializable::deserialize(), (state,));
        assertEq("A B", Serializable::deserialize(original).acceptsValue(" A\t B "));
        XsdSchema definition = schema("string", '<xs:length value="3"/>');
        string invalid = replace(source("string", '<xs:minLength value="2"/><xs:maxLength value="1"/>'),
            "urn:string-facets", "urn:invalid-facets");
        assertThrows("XSD-SIMPLETYPE-ERROR", \definition.addSchemaString(), invalid);
        assertEq("abc", definition.findType(make_qname("urn:string-facets", "Value"))
            .getDataProviderType().acceptsValue("abc"));
    }

    private static AbstractDataProviderType detachedProvider() {
        XsdSchema definition = schema("string", '<xs:whiteSpace value="collapse"/><xs:length value="3"/>',
            '<xs:pattern value="A B"/>');
        return definition.findType(make_qname("urn:string-facets", "Value")).getDataProviderType();
    }

    private static AbstractDataProviderType fromFacets(hash<XsdSizedFacetInfo> facets) {
        return new XsdSizedRestrictionDataType(facets, AbstractDataProviderType::get(SoftStringType));
    }

    private providers() {
        AbstractDataProviderType original = detachedProvider();
        foreach AbstractDataProviderType provider in (original, Serializable::deserialize(original.serialize())) {
            assertEq("A B", provider.acceptsValue(" A\t B "));
            assertEq(NT_STRING, provider.getBaseTypeCode());
            assertEq("string", provider.getBaseTypeName());
            assertEq({}, provider.getDirectTypeHash());
            assertEq(NOTHING, provider.getValueType());
            AbstractDataProviderType optional = Serializable::deserialize(provider.getOrNothingType().serialize());
            assertEq(NOTHING, optional.acceptsValue(NOTHING));
            assertThrows("RUNTIME-TYPE-ERROR", \optional.acceptsValue(), "AB");
            AbstractDataProviderType mandatory = optional.getMandatoryType();
            assertThrows("MISSING-VALUE-ERROR", \mandatory.acceptsValue(), (NOTHING,));
            ListDataType list_type(provider);
            assertEq(("A B", "A B"), list_type.acceptsValue(("A\tB", " A  B ")));
            assertThrows("RUNTIME-TYPE-ERROR", \list_type.acceptsValue(), (("A B", "bad"),));
        }
        hash<XsdSizedFacetInfo> valid = <XsdSizedFacetInfo>{
            "name": "Value", "kind": "string", "white_space": "collapse", "length": 3,
            "enumeration": ("A B",), "patterns": ("^A B$",),
        };
        assertEq("A B", fromFacets(valid).acceptsValue(" A\t B "));
        foreach hash<auto> change in ({"kind": "integer"}, {"white_space": "trim"},
                {"kind": "binary"}, {"kind": "list"}, {"kind": "tokens", "white_space": "preserve"},
                {"length": -1}, {"length": "1.0"}, {"min_length": "-1"}, {"max_length": "2x"},
                {"min_length": 4}, {"max_length": 2}, {"patterns": ("[",)}) {
            hash<XsdSizedFacetInfo> invalid = new hash<XsdSizedFacetInfo>(valid + change);
            assertThrows("XSD-SIMPLETYPE-ERROR", \fromFacets(), invalid);
        }
    }

    private fields() {
        string xml_source = source("token", '<xs:enumeration value=" A B "/><xs:length value="3"/>');
        xml_source =~ s/<\/xs:schema>//;
        xml_source += '<xs:complexType name="Record"><xs:sequence>
            <xs:element name="single" type="t:Value"/><xs:element name="repeated" type="t:Value" maxOccurs="3"/>
            <xs:element name="optional" type="t:Value" minOccurs="0"/></xs:sequence>
            <xs:attribute name="choice" type="t:Value" use="required"/></xs:complexType></xs:schema>';
        XsdSchema definition(xml_source, {"async_only": True});
        AbstractDataProviderType original = definition.findType(make_qname("urn:string-facets", "Record"))
            .getDataProviderType();
        foreach AbstractDataProviderType provider in (original, Serializable::deserialize(original.serialize())) {
            hash<auto> input = {"single": " A\tB", "repeated": ("A  B", " A B "),
                "^attributes^": {"choice": " A\n B "}};
            hash<auto> result = provider.acceptsValue(input);
            assertEq("A B", result.single);
            assertEq(("A B", "A B"), result.repeated);
            assertEq("A B", result."^attributes^".choice);
            assertEq(NOTHING, result.optional);
            foreach hash<auto> change in ({"single": "A C"}, {"repeated": ("A B", "A C")},
                    {"^attributes^": {"choice": "bad"}}) {
                assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (input + change,));
            }
        }
    }

    private otherLengths() {
        check("QName", '<xs:length value="0"/>', "longLocalName", "longLocalName");
        foreach string base in ("hexBinary", "base64Binary") {
            XsdSchema definition = schema(base, '<xs:length value="1"/>');
            XsdAbstractType type = definition.findType(make_qname("urn:string-facets", "Value"));
            string lexical = base == "hexBinary" ? "00" : "AA==";
            binary expected = parse_hex_string("00");
            assertEq(expected, type.deserializeValue("value", definition.getTypeMap(), NOTHING, lexical));
            assertEq(lexical, type.serializeValue(new Namespaces({}), expected, True));
            AbstractDataProviderType provider = Serializable::deserialize(type.getDataProviderType().serialize());
            assertEq(expected, provider.acceptsValue(expected));
            assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), parse_hex_string("0000"));
            assertThrows("SOAP-DESERIALIZATION-ERROR", \type.deserializeValue(),
                ("value", definition.getTypeMap(), NOTHING, base == "hexBinary" ? "0000" : "AAA="));
        }
    }
}
