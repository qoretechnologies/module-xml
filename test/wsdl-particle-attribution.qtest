#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class ParticleAttributionTest

class ParticleAttributionTest inherits QUnit::Test {
    constructor() : Test("Ordered particle declaration attribution", "1.0") {
        addTestCase("Fixed boundaries select distinct declarations of the same name", \boundaries());
        addTestCase("Nested sequences and alternating choices retain their positions", \groups());
        addTestCase("Named groups and reconstructed graphs retain declaration identity", \references());
        addTestCase("Empty content and huge nullable repetitions retain exact acceptance", \empty());
        addTestCase("All and wildcard terms return the admitting declaration", \predicates());
        addTestCase("Large inputs and shared empty graphs stay bounded", \large());
        addTestCase("Malformed names and cancellation permit reuse", \recovery());
        addTestCase("Concurrent calls keep independent attribution state", \concurrency());
        set_return_value(main());
    }

    private XsdParticle model(string content, string declarations = "") {
        XsdSchema schema('<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:particles"
            targetNamespace="urn:particles">' + declarations + '<xs:complexType name="Record">'
            + content + '</xs:complexType></xs:schema>');
        return cast<XsdComplexType>(schema.findType("Record")).getParticle();
    }
    private string element(string name, string counts = "") {
        return sprintf('<xs:element name="%s" type="xs:string" %s/>', name, counts);
    }
    private *list<XsdParticle> attribute(XsdParticle particle, string text) {
        return particle.attributeElementNames(map "{}" + $1, text.splitChars());
    }
    private check(XsdParticle particle, string text, list<XsdParticle> expected) {
        *list<XsdParticle> actual = attribute(particle, text);
        assertTrue(exists actual);
        assertEq(expected.size(), actual.size());
        for (int index = 0; index < expected.size(); ++index) {
            assertTrue(expected[index] === actual[index]);
        }
    }
    boundaries() {
        XsdParticle original = model('<xs:sequence>' + element("a", 'minOccurs="2" maxOccurs="2"')
            + element("a", 'nillable="true"') + '</xs:sequence>');
        foreach XsdParticle p in (original, Serializable::deserialize(original.serialize())) {
            list<XsdParticle> c = p.getChildren();
            check(p, "aaa", (c[0], c[0], c[1]));
            assertFalse(c[0].getElement().nillable);
            assertTrue(c[1].getElement().nillable);
            foreach string invalid in ("", "a", "aa", "aaaa", "aab") {
                assertEq(NOTHING, attribute(p, invalid));
            }
        }
    }
    groups() {
        XsdParticle p = model('<xs:sequence><xs:choice minOccurs="2" maxOccurs="3"><xs:sequence>'
            + element("a") + element("b") + '</xs:sequence>' + element("c") + '</xs:choice>'
            + element("d") + '</xs:sequence>');
        XsdParticle choice = p.getChildren()[0];
        list<XsdParticle> pair = choice.getChildren()[0].getChildren();
        XsdParticle c = choice.getChildren()[1];
        XsdParticle d = p.getChildren()[1];
        check(p, "cabd", (c, pair[0], pair[1], d));
        check(p, "abccd", (pair[0], pair[1], c, c, d));
        check(p, "abcd", (pair[0], pair[1], c, d));
        foreach string invalid in ("", "cd", "acbd", "abd", "abcccd", "cabc") {
            assertEq(NOTHING, attribute(p, invalid));
        }
    }
    references() {
        XsdParticle original = model('<xs:sequence><xs:group ref="t:Pair" maxOccurs="2"/>'
            + element("c") + '<xs:group ref="t:Pair"/></xs:sequence>',
            '<xs:group name="Pair"><xs:sequence>' + element("a") + element("b") + '</xs:sequence></xs:group>');
        foreach XsdParticle p in (original, Serializable::deserialize(original.serialize())) {
            list<XsdParticle> children = p.getChildren();
            assertTrue(children[0].getGroupDefinition() === children[2].getGroupDefinition());
            list<XsdParticle> pair = children[0].getGroupDefinition().getChildren();
            check(p, "ababcab", (pair[0], pair[1], pair[0], pair[1], children[1], pair[0], pair[1]));
            assertEq(NOTHING, attribute(p, "abc"));
        }
    }
    empty() {
        check(model('<xs:sequence/>'), "", ());
        check(model('<xs:choice minOccurs="0"/>'), "", ());
        assertEq(NOTHING, attribute(model('<xs:choice/>'), ""));
        string huge = "1" + strmul("0", 80);
        XsdParticle p = model(sprintf('<xs:sequence minOccurs="%s" maxOccurs="%s">', huge, huge)
            + element("a", 'minOccurs="0"') + '</xs:sequence>');
        check(p, "", ());
        XsdParticle a = p.getChildren()[0];
        check(p, "aaa", (a, a, a));
        assertEq(NOTHING, attribute(p, "b"));
        p = model('<xs:sequence minOccurs="2" maxOccurs="3">'
            + element("a", 'minOccurs="2" maxOccurs="2"') + '</xs:sequence>');
        a = p.getChildren()[0];
        check(p, "aaaaaa", (a, a, a, a, a, a));
        assertEq(NOTHING, attribute(p, "aaaaa"));
    }
    predicates() {
        XsdParticle p = model('<xs:all minOccurs="0">' + element("a") + element("b")
            + element("c", 'minOccurs="0"') + '</xs:all>');
        list<XsdParticle> c = p.getChildren();
        check(p, "bca", (c[1], c[2], c[0]));
        check(p, "", ());
        assertEq(NOTHING, attribute(p, "a"));
        p = model('<xs:sequence>' + element("a") + '<xs:any namespace="##other" maxOccurs="2"'
            ' processContents="lax"/></xs:sequence>');
        list<XsdParticle> matched = p.attributeElementNames(("{}a", "{urn:other}x", "{urn:other}y"));
        assertTrue(matched[0] === p.getChildren()[0]);
        assertTrue(matched[1] === p.getChildren()[1]);
        assertTrue(matched[2] === p.getChildren()[1]);
        assertEq(NOTHING, p.attributeElementNames(("{}a", "{}b")));
    }
    large() {
        XsdParticle p = model('<xs:choice minOccurs="0" maxOccurs="unbounded">'
            + element("a") + element("b") + '</xs:choice>');
        list<XsdParticle> actual = attribute(p, strmul("ab", 5000));
        assertEq(10000, actual.size());
        for (int index = 0; index < actual.size(); ++index) {
            assertTrue(actual[index] === p.getChildren()[index % 2]);
        }
        assertEq(NOTHING, attribute(p, strmul("ab", 5000) + "c"));
        string declarations = '<xs:group name="G0"><xs:sequence/></xs:group>';
        for (int index = 1; index <= 20; ++index) {
            declarations += sprintf('<xs:group name="G%d"><xs:sequence><xs:group ref="t:G%d"/>'
                '<xs:group ref="t:G%d"/></xs:sequence></xs:group>', index, index - 1, index - 1);
        }
        p = model('<xs:sequence><xs:group ref="t:G20"/>' + element("a") + '</xs:sequence>', declarations);
        check(p, "a", (p.getChildren()[1],));
    }
    recovery() {
        XsdParticle p = model('<xs:sequence>' + element("a") + '</xs:sequence>');
        foreach string invalid in ("a", "{}a:b", "{urn:x}", "{}1a") {
            assertThrows("XSD-PARTICLE-ERROR", \p.attributeElementNames(), ((invalid,),));
        }
        SandboxManager manager();
        on_exit manager.clearInterrupt();
        Program program(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
        program.setSandboxManager(manager);
        program.parse("%modern\n%requires ../qlib/WSDL.qm\n"
            "*list<XsdParticle> sub attribute(XsdParticle p, SandboxManager manager, bool cancel) {\n"
            "    if (cancel) { manager.requestInterrupt(); }\n"
            "    return p.attributeElementNames((\"{}a\",));\n"
            "}\n", get_script_dir() + "/particle-attribution-cancellation.qr");
        *hash<ExceptionInfo> error;
        try {
            program.callFunction("attribute", p, manager, True);
        } catch (hash<ExceptionInfo> ex) {
            error = ex;
        }
        manager.clearInterrupt();
        assertEq("PROGRAM-INTERRUPTED", error.err);
        list<XsdParticle> actual = program.callFunction("attribute", p, manager, False);
        assertEq(1, actual.size());
        assertTrue(actual[0] === p.getChildren()[0]);
    }
    concurrency() {
        XsdParticle p = model('<xs:sequence minOccurs="2" maxOccurs="4">'
            + element("a") + element("b") + '</xs:sequence>');
        Qore::Thread::Queue ready();
        Qore::Thread::Queue start();
        Qore::Thread::Queue results();
        Qore::Thread::Counter running();
        on_exit {
            for (int index = 0; index < 4; ++index) {
                start.push(True);
            }
            assertEq(0, running.waitForZero(30s));
        }
        for (int index = 0; index < 4; ++index) {
            running.inc();
            background sub () {
                on_exit running.dec();
                try {
                    ready.push(True);
                    start.get(30s);
                    results.push({"positions": attribute(p, "abab"), "rejected": attribute(p, "aba")});
                } catch (hash<ExceptionInfo> ex) {
                    results.push({"error": ex});
                }
            }();
        }
        for (int index = 0; index < 4; ++index) {
            assertTrue(ready.get(30s));
        }
        for (int index = 0; index < 4; ++index) {
            start.push(True);
        }
        for (int index = 0; index < 4; ++index) {
            hash<auto> result = results.get(30s);
            assertFalse(exists result.error);
            assertEq(NOTHING, result.rejected);
            assertEq(4, result.positions.size());
            for (int at = 0; at < 4; ++at) {
                assertTrue(result.positions[at] === p.getChildren()[at % 2]);
            }
        }
    }
}
