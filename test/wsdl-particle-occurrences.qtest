#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class ParticleOccurrencesTest

class ParticleOccurrencesTest inherits QUnit::Test {
    constructor() : Test("Exact named-element particle cardinality", "1.0") {
        addTestCase("Whole repeated sequences project sums and products", \sequences());
        addTestCase("Choice minima include absent fields and common required fields", \choices());
        addTestCase("Shared definitions retain independent caller ranges", \groups());
        addTestCase("Huge counts remain exact", \huge());
        addTestCase("Empty languages differ from empty named-element projections", \empty());
        addTestCase("All and wildcard projections retain their distinct contracts", \allAndWildcards());
        addTestCase("Expanded names retain separate counts", \namespaces());
        addTestCase("Provider fields use complete particle bounds", \providers());
        addTestCase("Both SOAP bindings expose request and response occurrence metadata", \messages());
        addTestCase("Malformed graphs and cancellation permit recovery", \recovery());
        addTestCase("Concurrent projections keep independent state", \concurrency());
        set_return_value(main());
    }
    private XsdComplexType record(string content, string declarations = "") {
        XsdSchema schema('<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:ranges" '
            'targetNamespace="urn:ranges">' + declarations + '<xs:complexType name="Record">' + content
            + '</xs:complexType></xs:schema>');
        return cast<XsdComplexType>(schema.findType("Record"));
    }
    private XsdParticle model(string content, string declarations = "") {
        return record(content, declarations).getParticle();
    }
    private string element(string name, string properties = "") {
        return '<xs:element name="' + name + '" type="xs:string" ' + properties + '/>';
    }
    private hash<XsdParticleOccurrenceRange> range(string low, *string high) {
        return <XsdParticleOccurrenceRange>{"minimum": low, "maximum": high};
    }
    private check(XsdParticle p, *hash<string, hash<XsdParticleOccurrenceRange>> expected) {
        foreach XsdParticle copy in (p, Serializable::deserialize(p.serialize())) {
            assertEq(expected, copy.getElementOccurrenceRanges());
        }
    }
    sequences() {
        XsdParticle p = model('<xs:sequence minOccurs="2" maxOccurs="4">'
            + element("a", 'minOccurs="2" maxOccurs="3"') + element("b", 'minOccurs="0"')
            + '</xs:sequence>');
        check(p, {"{}a": range("4", "12"), "{}b": range("0", "4")});
        check(model('<xs:sequence>' + element("a") + element("a", 'minOccurs="2" maxOccurs="2"')
            + '</xs:sequence>'), {"{}a": range("3", "3")});
        check(model('<xs:sequence>' + element("a", 'minOccurs="0" maxOccurs="unbounded"')
            + '</xs:sequence>'), {"{}a": range("0", NOTHING)});
    }
    choices() {
        XsdParticle p = model('<xs:choice minOccurs="2" maxOccurs="3"><xs:sequence>' + element("p")
            + element("a", 'minOccurs="2" maxOccurs="3"') + '</xs:sequence><xs:sequence>' + element("q")
            + element("a", 'minOccurs="4" maxOccurs="5"') + '</xs:sequence></xs:choice>');
        check(p, {"{}p": range("0", "3"), "{}q": range("0", "3"), "{}a": range("4", "15")});
        check(model('<xs:choice><xs:sequence/>' + element("a") + '</xs:choice>'),
            {"{}a": range("0", "1")});
        check(model('<xs:choice maxOccurs="unbounded"><xs:sequence>' + element("p") + element("a")
            + '</xs:sequence><xs:sequence>' + element("q") + element("a") + '</xs:sequence></xs:choice>'),
            {"{}p": range("0", NOTHING), "{}q": range("0", NOTHING), "{}a": range("1", NOTHING)});
    }
    groups() {
        XsdParticle p = model('<xs:sequence><xs:group ref="t:Pair"/>' + element("c")
            + '<xs:group ref="t:Pair" minOccurs="3" maxOccurs="3"/></xs:sequence>',
            '<xs:group name="Pair"><xs:sequence>' + element("a") + element("b") + '</xs:sequence></xs:group>');
        check(p, {"{}a": range("4", "4"), "{}b": range("4", "4"), "{}c": range("1", "1")});
        XsdParticle shared = p.getChildren()[0].getGroupDefinition();
        assertTrue(shared === p.getChildren()[2].getGroupDefinition());
        check(shared, {"{}a": range("1", "1"), "{}b": range("1", "1")});
        hash<string, hash<XsdParticleOccurrenceRange>> changed = p.getElementOccurrenceRanges();
        changed."{}a".minimum = "999";
        check(p, {"{}a": range("4", "4"), "{}b": range("4", "4"), "{}c": range("1", "1")});
    }
    huge() {
        check(model('<xs:sequence minOccurs="18446744073709551617" maxOccurs="18446744073709551618">'
            + element("a", 'minOccurs="3" maxOccurs="5"') + '</xs:sequence>'),
            {"{}a": range("55340232221128654851", "92233720368547758090")});
        string groups = '<xs:group name="G0"><xs:sequence>' + element("a") + '</xs:sequence></xs:group>';
        for (int depth = 1; depth <= 70; ++depth) {
            groups += sprintf('<xs:group name="G%d"><xs:sequence><xs:group ref="t:G%d"/>'
                '<xs:group ref="t:G%d"/></xs:sequence></xs:group>', depth, depth - 1, depth - 1);
        }
        check(model('<xs:group ref="t:G70"/>', groups),
            {"{}a": range("1180591620717411303424", "1180591620717411303424")});
    }
    empty() {
        check(model('<xs:sequence/>'), {});
        check(model('<xs:choice/>'), NOTHING);
        check(model('<xs:choice minOccurs="0"/>'), {});
        check(model('<xs:choice minOccurs="0" maxOccurs="unbounded"/>'), {});
        check(model('<xs:sequence maxOccurs="unbounded"/>'), {});
        check(model('<xs:sequence><xs:choice/></xs:sequence>'), NOTHING);
        check(model('<xs:choice><xs:sequence>' + element("a") + '<xs:choice/></xs:sequence>'
            + element("b") + '</xs:choice>'), {"{}b": range("1", "1")});
        check(model('<xs:choice>' + element("a", 'minOccurs="0" maxOccurs="0"')
            + element("b") + '</xs:choice>'), {"{}b": range("1", "1")});
    }
    allAndWildcards() {
        check(model('<xs:all>' + element("a") + element("b", 'minOccurs="0"') + '</xs:all>'),
            {"{}a": range("1", "1"), "{}b": range("0", "1")});
        check(model('<xs:all minOccurs="0">' + element("a") + element("b") + '</xs:all>'),
            {"{}a": range("0", "1"), "{}b": range("0", "1")});
        check(model('<xs:sequence><xs:any minOccurs="0" maxOccurs="unbounded"/></xs:sequence>'), {});
        check(model('<xs:group ref="t:All" minOccurs="0"/>', '<xs:group name="All"><xs:all>'
            + element("a") + element("b", 'minOccurs="0"') + '</xs:all></xs:group>'),
            {"{}a": range("0", "1"), "{}b": range("0", "1")});
    }
    namespaces() {
        check(model('<xs:sequence>' + element("a", 'form="qualified" minOccurs="2" maxOccurs="3"')
            + element("a", 'minOccurs="0" maxOccurs="unbounded"') + '</xs:sequence>'),
            {"{urn:ranges}a": range("2", "3"), "{}a": range("0", NOTHING)});
    }
    providers() {
        XsdComplexType original = record('<xs:choice minOccurs="2" maxOccurs="3"><xs:sequence>'
            + element("p") + element("a") + '</xs:sequence><xs:sequence>' + element("q") + element("a")
            + '</xs:sequence></xs:choice>');
        foreach XsdComplexType type in (original, Serializable::deserialize(original.serialize())) {
            foreach AbstractDataProviderType provider in (type.getDataProviderType(),
                    Serializable::deserialize(type.getDataProviderType().serialize())) {
                hash<string, AbstractDataField> fields = provider.getFields();
                assertTrue(fields.a.isMandatory());
                assertFalse(fields.p.isMandatory());
                assertFalse(fields.q.isMandatory());
                foreach string name in ("a", "p", "q") {
                    assertTrue(fields{name}.getType().isList());
                }
                assertEq(("one", "two"), fields.a.acceptsValue(("one", "two")));
                assertThrows("MISSING-VALUE-ERROR", \fields.a.acceptsValue(), (NOTHING,));
                assertEq(NOTHING, fields.p.acceptsValue(NOTHING));
            }
        }
        original = record('<xs:sequence><xs:sequence minOccurs="0" maxOccurs="2">'
            + element("optional") + '</xs:sequence>' + element("single")
            + element("absent", 'minOccurs="0" maxOccurs="0"') + '</xs:sequence>');
        hash<string, AbstractDataField> fields = original.getDataProviderType().getFields();
        assertEq(("optional", "single"), keys fields);
        assertFalse(fields.optional.isMandatory());
        assertTrue(fields.optional.getType().isList());
        assertTrue(fields.single.isMandatory());
        assertFalse(fields.single.getType().isList());
        original = record('<xs:sequence>' + element("a", 'form="qualified"')
            + element("a", 'minOccurs="0" maxOccurs="2"') + '</xs:sequence>');
        fields = original.getDataProviderType().getFields();
        assertEq(("{urn:ranges}a", "{}a"), keys fields);
        assertTrue(fields."{urn:ranges}a".isMandatory());
        assertFalse(fields."{}a".isMandatory());
        assertTrue(fields."{}a".getType().isList());
        original = record('<xs:group ref="t:Shared"/>', '<xs:group name="Shared"><xs:sequence>'
            + element("value") + '</xs:sequence></xs:group><xs:complexType name="Optional">'
            '<xs:group ref="t:Shared" minOccurs="0" maxOccurs="3"/></xs:complexType>');
        fields = original.getDataProviderType().getFields();
        assertTrue(fields.value.isMandatory());
        assertFalse(fields.value.getType().isList());
        original = record('<xs:sequence minOccurs="2" maxOccurs="3"><xs:element name="status" type="t:Status"/>'
            '</xs:sequence>', '<xs:simpleType name="Status"><xs:restriction base="xs:string">'
            '<xs:enumeration value="Ready"/><xs:enumeration value="Sent"/></xs:restriction></xs:simpleType>');
        foreach XsdComplexType type in (original, Serializable::deserialize(original.serialize())) {
            AbstractDataField status = type.getDataProviderType().getFields().status;
            assertEq(("Ready", "Sent"), map $1.value, status.getElementAllowedValues());
            assertEq(NOTHING, status.getAllowedValues());
            assertEq(("Ready", "Sent"), status.acceptsValue(("Ready", "Sent")));
            assertThrows("RUNTIME-TYPE-ERROR", \status.acceptsValue(), (("Ready", "Unknown"),));
        }
    }
    messages() {
        foreach string version in ("11", "12") {
            string soap = "http://schemas.xmlsoap.org/wsdl/soap" + (version == "12" ? "12" : "") + "/";
            WebService original(sprintf('<w:definitions xmlns:w="http://schemas.xmlsoap.org/wsdl/" xmlns:s="%s"
                xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:ranges" targetNamespace="urn:ranges">
                <w:types><xs:schema targetNamespace="urn:ranges"><xs:element name="Batch"><xs:complexType>
                <xs:choice minOccurs="2" maxOccurs="3"><xs:sequence><xs:element name="p" type="xs:string"/>
                <xs:element name="a" type="xs:string"/></xs:sequence><xs:sequence>
                <xs:element name="q" type="xs:string"/><xs:element name="a" type="xs:string"/></xs:sequence>
                </xs:choice></xs:complexType></xs:element></xs:schema></w:types>
                <w:message name="Request"><w:part name="body" element="t:Batch"/></w:message>
                <w:message name="Response"><w:part name="body" element="t:Batch"/></w:message>
                <w:portType name="Port"><w:operation name="submit"><w:input message="t:Request"/>
                <w:output message="t:Response"/></w:operation></w:portType><w:binding name="Soap" type="t:Port">
                <s:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
                <w:operation name="submit"><s:operation soapAction="urn:submit"/>
                <w:input><s:body use="literal"/></w:input><w:output><s:body use="literal"/></w:output>
                </w:operation></w:binding><w:service name="Service"><w:port name="Port" binding="t:Soap">
                <s:address location="http://example.invalid/"/></w:port></w:service></w:definitions>', soap),
                {"async_only": True});
            foreach WebService ws in (original, Serializable::deserialize(original.serialize())) {
                WSOperation operation = ws.getBindingOperation("Soap", "submit");
                foreach bool response in (False, True) {
                    AbstractDataProviderType provider = (response ? operation.output : operation.input).getDataProviderType();
                    foreach AbstractDataProviderType copy in (provider, Serializable::deserialize(provider.serialize())) {
                        hash<string, AbstractDataField> fields = copy.getFields().body.getType().getFields();
                        assertTrue(fields.a.isMandatory());
                        assertTrue(fields.a.getType().isList());
                        assertFalse(fields.p.isMandatory());
                        assertFalse(fields.q.isMandatory());
                        assertEq(("one", "two"), fields.a.acceptsValue(("one", "two")));
                        assertEq(NOTHING, fields.p.acceptsValue(NOTHING));
                    }
                }
            }
        }
    }
    recovery() {
        XsdParticle original = model('<xs:sequence><xs:sequence>' + element("a")
            + '</xs:sequence></xs:sequence>');
        hash<SerializationInfo> state = original.serializeToData();
        string children = state._index."0"._class_data."WSDL::XsdParticle".children._index;
        string nested = state._index{children}._elements[0]._index;
        string nested_children = state._index{nested}._class_data."WSDL::XsdParticle".children._index;
        state._index{nested_children}._elements = ({"_index": "0"},);
        XsdParticle cyclic = Serializable::deserialize(state);
        assertThrows("WSDL-ERROR", \cyclic.getElementOccurrenceRanges(), ());
        XsdParticle group = model('<xs:group ref="t:Group"/>', '<xs:group name="Group"><xs:sequence>'
            + element("a") + '</xs:sequence></xs:group>');
        state = group.serializeToData();
        remove state._index."0"._class_data."WSDL::XsdParticle".group_definition;
        XsdParticle unresolved = Serializable::deserialize(state);
        assertThrows("WSDL-ERROR", \unresolved.getElementOccurrenceRanges(), ());
        SandboxManager manager();
        on_exit manager.clearInterrupt();
        Program program(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
        program.setSandboxManager(manager);
        program.parse("%modern\n%requires ../qlib/WSDL.qm\n"
            "*hash<string, hash<XsdParticleOccurrenceRange>> sub ranges(XsdParticle p, SandboxManager manager, bool cancel) {\n"
            "    if (cancel) { manager.requestInterrupt(); }\n"
            "    return p.getElementOccurrenceRanges();\n"
            "}\n", get_script_dir() + "/particle-occurrence-cancellation.qr");
        *hash<ExceptionInfo> error;
        try {
            program.callFunction("ranges", original, manager, True);
        } catch (hash<ExceptionInfo> ex) {
            error = ex;
        }
        manager.clearInterrupt();
        assertEq("PROGRAM-INTERRUPTED", error.err);
        assertEq({"{}a": range("1", "1")}, program.callFunction("ranges", original, manager, False));
        check(original, {"{}a": range("1", "1")});
    }
    concurrency() {
        XsdParticle p = model('<xs:sequence minOccurs="2" maxOccurs="4">'
            + element("a") + element("b") + '</xs:sequence>');
        Qore::Thread::Queue ready();
        Qore::Thread::Queue start();
        Qore::Thread::Queue results();
        Qore::Thread::Counter running();
        on_exit {
            for (int index = 0; index < 4; ++index) {
                start.push(True);
            }
            assertEq(0, running.waitForZero(30s));
        }
        for (int index = 0; index < 4; ++index) {
            running.inc();
            background sub () {
                on_exit running.dec();
                try {
                    ready.push(True);
                    start.get(30s);
                    hash<string, hash<XsdParticleOccurrenceRange>> ranges = p.getElementOccurrenceRanges();
                    ranges."{}a".minimum = "999";
                    results.push({"ranges": p.getElementOccurrenceRanges()});
                } catch (hash<ExceptionInfo> ex) {
                    results.push({"error": ex});
                }
            }();
        }
        for (int index = 0; index < 4; ++index) {
            assertTrue(ready.get(30s));
        }
        for (int index = 0; index < 4; ++index) {
            start.push(True);
        }
        for (int index = 0; index < 4; ++index) {
            hash<auto> result = results.get(30s);
            assertFalse(exists result.error);
            assertEq({"{}a": range("2", "4"), "{}b": range("2", "4")}, result.ranges);
        }
    }
}
