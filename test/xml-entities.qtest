#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%requires QUnit
%requires xml
%exec-class XmlEntitiesTest

class XmlEntitiesTest inherits QUnit::Test {
    constructor() : QUnit::Test("Native ENTITY document context", "1.0") {
        addTestCase("Declared entities retain element and attribute text", \declarations());
        addTestCase("Undeclared and parsed entities fail with schema errors", \rejection());
        addTestCase("Facets and ordered unions preserve ENTITY constraints", \facets());
        addTestCase("Built-in lists enforce their inherited minimum length", \minimumLength());
        addTestCase("List length restrictions reject contradictory schema facets", \schemaFacets());
        addTestCase("Defaults and nil use the containing document", \defaults());
        addTestCase("Late schema errors discard partial XML conversion", \lateErrors());
        addTestCase("Cancellation and early close release declaration state", \recovery());
        set_return_value(main());
    }

    private static string schema(string type, string definitions = "") {
        return '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">' + definitions
            + '<xs:element name="value"><xs:complexType><xs:simpleContent><xs:extension base="' + type + '">'
            '<xs:attribute name="category" type="' + type + '" use="required"/>'
            '</xs:extension></xs:simpleContent></xs:complexType></xs:element></xs:schema>';
    }

    private static string document(string value, string declarations = "") {
        string xml = '<value category="' + value + '">' + value + '</value>';
        return declarations ? '<!DOCTYPE value [<!NOTATION image SYSTEM "image/gif">'
            + declarations + ']>' + xml : xml;
    }

    private static string declared() {
        return '<!ENTITY photo SYSTEM "photo.gif" NDATA image>'
            '<!ENTITY other SYSTEM "other.gif" NDATA image>'
            '<!ENTITY é中文 SYSTEM "unicode.gif" NDATA image>';
    }

    private accepted(string xsd, string xml) {
        hash<auto> expected = parse_xml(xml);
        assertEq(expected, parse_xml_with_schema(xml, xsd));
        XmlDoc doc(xml);
        doc.validateSchema(xsd);
        XmlReader reader(new StringInputStream(xml), {"xsd": xsd});
        string text = "";
        bool root_seen = False;
        while (reader.read()) {
            if (reader.nodeType() == XML_NODE_TYPE_ELEMENT) {
                assertEq("value", reader.name());
                assertEq(expected.value."^attributes^".category, reader.getAttribute("category"));
                root_seen = True;
            } else if (reader.nodeType() == XML_NODE_TYPE_TEXT
                    || reader.nodeType() == XML_NODE_TYPE_CDATA) {
                text += reader.value();
            }
        }
        assertTrue(root_seen);
        assertTrue(reader.isValid());
        assertEq(string(expected.value."^value^"), text);
    }

    private static nothing consume(string xsd, string xml) {
        XmlReader reader(new StringInputStream(xml), {"xsd": xsd});
        while (reader.read()) {
        }
    }

    private static nothing validateDoc(string xsd, string xml) {
        XmlDoc doc(xml);
        doc.validateSchema(xsd);
    }

    private rejected(string xsd, string xml) {
        assertThrows("PARSE-XML-EXCEPTION", \parse_xml_with_schema(), (xml, xsd));
        assertThrows("PARSE-XML-EXCEPTION", \consume(), (xsd, xml));
        assertThrows("XSD-ERROR", \validateDoc(), (xsd, xml));
    }

    declarations() {
        foreach string type in ("xs:ENTITY", "xs:ENTITIES") {
            foreach string value in ("photo", "other", "é中文", "  photo  ", "&#9;photo&#10;") {
                accepted(schema(type), document(value, declared()));
            }
        }
        foreach string value in ("photo other", "photo photo", "é中文 photo", "photo&#9;other") {
            accepted(schema("xs:ENTITIES"), document(value, declared()));
        }
        accepted(schema("xs:ENTITY"), document("photo", declared() + '<!ENTITY photo "parsed">'));
        accepted(schema("xs:ENTITY"), document("photo", '<!ENTITY % photo "parameter">' + declared()));
    }

    rejection() {
        foreach string type in ("xs:ENTITY", "xs:ENTITIES") {
            string xsd = schema(type);
            foreach string declaration in ("", '<!ENTITY photo "parsed">',
                    '<!ENTITY photo SYSTEM "parsed.xml">', '<!ENTITY % photo "parameter">',
                    '<!ENTITY photo "parsed">' + declared()) {
                rejected(xsd, document("photo", declaration));
            }
            foreach string text in ("missing", "lt", "", "17", "p:photo", "photo:bad:bad", "photo ") {
                rejected(xsd, document(text, declared()));
            }
            rejected(xsd, '<!DOCTYPE value [<!NOTATION image SYSTEM "image/gif">' + declared() + ']>'
                '<value category="missing">photo</value>');
            rejected(xsd, '<!DOCTYPE value [<!NOTATION image SYSTEM "image/gif">' + declared() + ']>'
                '<value category="photo">missing</value>');
            accepted(xsd, document("photo", declared()));
        }
        rejected(schema("xs:ENTITIES"), document("photo missing", declared()));
    }

    facets() {
        string definitions = '<xs:simpleType name="Choice"><xs:restriction base="xs:ENTITY">'
            '<xs:enumeration value="photo"/></xs:restriction></xs:simpleType>'
            '<xs:simpleType name="Pair"><xs:restriction base="xs:ENTITIES">'
            '<xs:length value="2"/><xs:enumeration value="photo other"/></xs:restriction></xs:simpleType>'
            '<xs:simpleType name="EntityText"><xs:union memberTypes="xs:ENTITY xs:string"/></xs:simpleType>'
            '<xs:simpleType name="TextEntity"><xs:union memberTypes="xs:string xs:ENTITY"/></xs:simpleType>'
            '<xs:simpleType name="EntityInt"><xs:union memberTypes="xs:ENTITY xs:int"/></xs:simpleType>'
            '<xs:simpleType name="Items"><xs:list itemType="EntityInt"/></xs:simpleType>';
        accepted(schema("Choice", definitions), document("photo", declared()));
        rejected(schema("Choice", definitions), document("other", declared()));
        accepted(schema("Pair", definitions), document("photo other", declared()));
        rejected(schema("Pair", definitions), document("other photo", declared()));
        rejected(schema("Pair", definitions), document("photo", declared()));
        rejected(schema("EntityText", definitions), document("photo"));
        accepted(schema("EntityText", definitions), document("p:photo"));
        accepted(schema("EntityText", definitions), document("17"));
        accepted(schema("TextEntity", definitions), document("photo"));
        accepted(schema("EntityInt", definitions), document("17"));
        rejected(schema("EntityInt", definitions), document("photo"));
        accepted(schema("Items", definitions), document("photo 17 other", declared()));
        rejected(schema("Items", definitions), document("photo 17 other"));
        accepted(schema("Items", definitions), document(""));
    }

    minimumLength() {
        foreach string type in ("ENTITIES", "IDREFS", "NMTOKENS") {
            string definitions = '<xs:simpleType name="Derived"><xs:restriction base="xs:' + type
                + '"/></xs:simpleType><xs:simpleType name="Again"><xs:restriction base="Derived"/></xs:simpleType>';
            foreach string actual in ("xs:" + type, "Derived", "Again") {
                foreach string value in ("", " ", "&#9;&#10;") {
                    rejected(schema(actual, definitions), document(value));
                }
            }
        }
        accepted(schema("xs:NMTOKENS"), document("photo other"));
    }

    defaults() {
        string begin = '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">';
        string xsd = begin + '<xs:element name="value" type="xs:ENTITY" default="photo"/></xs:schema>';
        rejected(xsd, '<value/>');
        consume(xsd, '<!DOCTYPE value [<!NOTATION image SYSTEM "image/gif">' + declared() + ']><value/>');
        validateDoc(xsd, '<!DOCTYPE value [<!NOTATION image SYSTEM "image/gif">' + declared() + ']><value/>');
        xsd = begin + '<xs:element name="value" type="xs:ENTITY" nillable="true"/></xs:schema>';
        string xml = '<value xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true"/>';
        consume(xsd, xml);
        validateDoc(xsd, xml);
        assertEq(parse_xml(xml), parse_xml_with_schema(xml, xsd));
    }

    private static nothing constructSchema(string xsd) {
        XmlReader reader(new StringInputStream("<value/>"), {"xsd": xsd});
    }

    schemaFacets() {
        foreach string type in ("ENTITIES", "IDREFS", "NMTOKENS") {
            for (int depth = 0; depth < 3; ++depth) {
                string definitions = "";
                string base = "xs:" + type;
                for (int i = 0; i < depth; ++i) {
                    string next = sprintf("Level%d", i);
                    definitions += '<xs:simpleType name="' + next + '"><xs:restriction base="'
                        + base + '"/></xs:simpleType>';
                    base = next;
                }
                foreach string facet in ("length", "minLength", "maxLength") {
                    string restriction = definitions + '<xs:simpleType name="Reduced"><xs:restriction base="'
                        + base + '"><xs:' + facet + ' value="%d"/></xs:restriction></xs:simpleType>';
                    assertThrows("XSD-SYNTAX-ERROR", \constructSchema(),
                        (schema("Reduced", sprintf(restriction, 0)),));
                    string xsd = schema("Reduced", sprintf(restriction, 1));
                    xsd =~ s/<\/xs:extension>/<xs:attribute name="id" type="xs:ID"\/><\/xs:extension>/;
                    string xml = document("photo", declared());
                    xml =~ s/<value category=/<value id="photo" category=/;
                    assertEq(parse_xml(xml), parse_xml_with_schema(xml, xsd));
                }
            }
        }
    }

    recovery() {
        string xsd = schema("xs:ENTITY");
        string xml = document("photo", declared());
        for (int i = 0; i < 16; ++i) {
            {
                XmlReader reader(new StringInputStream(xml), {"xsd": xsd});
                assertTrue(reader.read());
                assertEq(XML_NODE_TYPE_DOCUMENT_TYPE, reader.nodeType());
            }
            rejected(xsd, document("photo"));
            accepted(xsd, xml);
        }
        SandboxManager manager();
        on_exit {
            manager.clearInterrupt();
        }
        Program program(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
        program.setSandboxManager(manager);
        program.parse("%modern\n%requires xml\n"
            "nothing sub interrupted(SandboxManager manager, string xsd, string xml) {\n"
            "    XmlReader reader(new StringInputStream(xml), {\"xsd\": xsd});\n"
            "    @assert(reader.read());\n"
            "    @assert(reader.nodeType() == XML_NODE_TYPE_DOCUMENT_TYPE);\n"
            "    manager.requestInterrupt();\n"
            "    while (reader.read()) {}\n"
            "}\n", "entity_cancel");
        *hash<ExceptionInfo> error;
        try {
            program.callFunction("interrupted", manager, xsd, xml);
        } catch (hash<ExceptionInfo> ex) {
            error = ex;
        }
        manager.clearInterrupt();
        assertEq("PROGRAM-INTERRUPTED", error.err);
        rejected(xsd, document("photo"));
        accepted(xsd, xml);
    }

    lateErrors() {
        string xsd = '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">'
            '<xs:element name="root"><xs:complexType><xs:sequence>'
            '<xs:element name="image" type="xs:ENTITY" default="photo"/>'
            '</xs:sequence></xs:complexType></xs:element></xs:schema>';
        for (int i = 0; i < 32; ++i) {
            string xml = '<root><image/></root>';
            rejected(xsd, xml);
            foreach bool grouped in (False, True) {
                XmlReader reader(new StringInputStream(xml), {"xsd": xsd});
                *hash<ExceptionInfo> error;
                try {
                    if (reader.read()) {
                        if (grouped) {
                            reader.toQoreData();
                        } else {
                            reader.toQore();
                        }
                    }
                    while (reader.read()) {
                    }
                } catch (hash<ExceptionInfo> ex) {
                    error = ex;
                }
                assertEq("PARSE-XML-EXCEPTION", error.err);
            }
        }
        string valid = '<!DOCTYPE root [<!NOTATION image SYSTEM "image/gif">' + declared()
            + ']><root><image/></root>';
        validateDoc(xsd, valid);
        assertEq(parse_xml(valid), parse_xml_with_schema(valid, xsd));
    }
}
