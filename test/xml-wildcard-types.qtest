#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%exec-class XmlWildcardTypesTest

class XmlWildcardTypesTest inherits QUnit::Test {
    constructor() : Test("Native wildcard instance-type assessment", "1.0") {
        addTestCase("Strict, lax and skip assess declarations and selected types", \instances());
        addTestCase("Rejected instance types leave subsequent validation usable", \recovery());
        addTestCase("Interrupted and concurrent readers permit subsequent reuse", \concurrency());
        set_return_value(main());
    }
    private string schema(string processing, bool qualified) {
        return '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:wild-type"'
            + (qualified ? ' targetNamespace="urn:wild-type"' : '') + '>'
            '<xs:element name="known" type="xs:int"/>'
            '<xs:simpleType name="Restricted"><xs:restriction base="xs:int"><xs:maxInclusive value="9"/>'
            '</xs:restriction></xs:simpleType><xs:complexType name="Record"><xs:sequence>'
            '<xs:element name="code" type="xs:int"/></xs:sequence>'
            '<xs:attribute name="tag" type="xs:string" use="required"/></xs:complexType>'
            '<xs:complexType name="Abstract" abstract="true"/>'
            '<xs:element name="root"><xs:complexType><xs:sequence><xs:any processContents="'
            + processing + '" minOccurs="0" maxOccurs="unbounded"/></xs:sequence></xs:complexType>'
            '</xs:element></xs:schema>';
    }
    private bool consume(string source, string xml) {
        XmlReader reader(new StringInputStream(xml), {"xsd": source});
        int roots = 0;
        while (reader.read()) {
            if (reader.nodeType() == XML_NODE_TYPE_ELEMENT && reader.depth() == 0) {
                ++roots;
            }
        }
        return roots == 1 && reader.isValid();
    }
    private check(string source, string xml, bool valid) {
        XmlDoc document(xml);
        if (valid) {
            assertTrue(consume(source, xml));
            assertEq(parse_xml(xml), parse_xml_with_schema(xml, source));
            document.validateSchema(source);
        } else {
            assertThrows("PARSE-XML-EXCEPTION", \consume(), (source, xml));
            assertThrows("PARSE-XML-EXCEPTION", \parse_xml_with_schema(), (xml, source));
            assertThrows("XSD-ERROR", \document.validateSchema(), (source,));
        }
    }
    private instances() {
        foreach string processing in ("strict", "lax", "skip") {
            foreach bool qualified in (False, True) {
                string source = schema(processing, qualified);
                string prefix = qualified ? "t:" : "";
                foreach hash<auto> item in (
                    {"xml": "", "strict": True, "lax": True},
                    {"xml": "<" + prefix + "known>17</" + prefix + "known>", "strict": True, "lax": True},
                    {"xml": "<" + prefix + "known>bad</" + prefix + "known>", "strict": False, "lax": False},
                    {"xml": "<unknown>text</unknown>", "strict": False, "lax": True},
                    {"xml": '<unknown xsi:type="xs:int">17</unknown>', "strict": True, "lax": True},
                    {"xml": '<unknown xsi:type="xs:int">bad</unknown>', "strict": False, "lax": False},
                    {"xml": '<unknown xsi:type="xs:Missing">17</unknown>', "strict": False, "lax": False},
                    {"xml": '<unknown xsi:type="' + prefix + 'Restricted">5</unknown>', "strict": True, "lax": True},
                    {"xml": '<unknown xsi:type="' + prefix + 'Restricted">99</unknown>', "strict": False, "lax": False},
                    {"xml": '<unknown xsi:type="' + prefix + 'Record" tag="shipment"><code>17</code></unknown>',
                        "strict": True, "lax": True},
                    {"xml": '<unknown xsi:type="' + prefix + 'Record" tag="shipment"><code>bad</code></unknown>',
                        "strict": False, "lax": False},
                    {"xml": '<unknown xsi:type="' + prefix + 'Record"><code>17</code></unknown>',
                        "strict": False, "lax": False},
                    {"xml": '<unknown xsi:type="' + prefix + 'Abstract"/>', "strict": False, "lax": False},
                    {"xml": '<unknown xsi:type="unbound:Type"/>', "strict": False, "lax": False},
                    {"xml": '<unknown xsi:type="xs:QName">t:Stock</unknown>', "strict": True, "lax": True},
                    {"xml": '<unknown xsi:type="xs:QName">unbound:Stock</unknown>', "strict": False, "lax": False},
                    {"xml": '<unknown><' + prefix + 'known>17</' + prefix + 'known></unknown>', "strict": False, "lax": True},
                    {"xml": '<unknown><' + prefix + 'known>bad</' + prefix + 'known></unknown>', "strict": False, "lax": False},
                    {"xml": '<' + prefix + 'known xsi:type="xs:string">17</' + prefix + 'known>', "strict": False, "lax": False}) {
                    string xml = '<' + prefix + 'root xmlns:t="urn:wild-type"'
                        ' xmlns:xs="http://www.w3.org/2001/XMLSchema"'
                        ' xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">' + item.xml + '</' + prefix + 'root>';
                    check(source, xml, processing == "skip" || item{processing});
                }
            }
        }
    }
    private recovery() {
        string source = schema("strict", True);
        string start = '<t:root xmlns:t="urn:wild-type" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">';
        for (int attempt = 0; attempt < 8; ++attempt) {
            check(source, start + '<unknown xsi:type="t:Missing"/></t:root>', False);
            check(source, start + '<unknown xsi:type="t:Record" tag="shipment"><code>17</code></unknown></t:root>', True);
        }
    }
    concurrency() {
        string good = schema("strict", True);
        Program p();
        p.parse("%modern\n%requires xml\n"
            "bool sub validate(string schema, SandboxManager manager, bool cancel) {\n"
            "    if (cancel) { manager.requestInterrupt(); }\n"
            "    XmlReader reader(\"<t:root xmlns:t='urn:wild-type' xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'><unknown xsi:type='t:Record' tag='shipment'><code>17</code></unknown></t:root>\");\n"
            "    reader.schemaValidateString(schema); while (reader.read()) {} return reader.isValid();\n"
            "}\n", get_script_dir() + "/wildcard-type-cancellation.qr");
        SandboxManager manager();
        on_exit manager.clearInterrupt();
        p.setSandboxManager(manager);
        try {
            p.callFunction("validate", good, manager, True);
            fail("expected cancellation");
        } catch (hash<ExceptionInfo> ex) {
            assertTrue(ex.err == "THREAD-CANCELLED" || ex.err == "PROGRAM-INTERRUPTED", ex.err);
        }
        manager.clearInterrupt();
        assertTrue(p.callFunction("validate", good, manager, False));
        Qore::Thread::Queue results();
        Qore::Thread::Counter running();
        on_exit assertEq(0, running.waitForZero(30s));
        for (int worker = 0; worker < 2; ++worker) {
            running.inc();
            background sub() {
                on_exit running.dec();
                try {
                    for (int index = 0; index < 10; ++index) {
                        @assert(consume(good, "<t:root xmlns:t='urn:wild-type' xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'><unknown xsi:type='t:Record' tag='shipment'><code>17</code></unknown></t:root>"));
                    }
                    results.push(True);
                } catch (hash<ExceptionInfo> ex) {
                    results.push(ex);
                }
            }();
        }
        for (int worker = 0; worker < 2; ++worker) {
            assertEq(True, results.get(30s));
        }
    }
}
