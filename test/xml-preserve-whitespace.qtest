#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%exec-class PreserveWhitespaceTest

class PreserveWhitespaceTest inherits QUnit::Test {
    const Flags = XPF_PRESERVE_ORDER | XPF_PRESERVE_WHITESPACE | XPF_ADD_COMMENTS;
    constructor() : Test("Explicit XML whitespace preservation", "1.0") {
        addTestCase("All XML data readers retain whitespace and repeated child positions", \readers());
        addTestCase("Explicit preservation applies across xml:space default resets", \scopes());
        addTestCase("Schema validation retains characters while rejecting invalid content", \schemas());
        addTestCase("Empty, scalar, CDATA and large repeated content retain exact characters", \boundaries());
        addTestCase("Malformed XML and interruption preserve cleanup and reuse", \failures());
        set_return_value(main());
    }
    private readers() {
        string xml = " \n<root> <a/>\t<a/>\n<!--keep-->\r\n</root> \n";
        hash<auto> expected = {"^value^":" ", "a":NOTHING, "^value1^":"\t", "a^1":NOTHING,
            "^value2^":"\n", "^comment^":"keep", "^value3^":"\n"};
        assertEq(expected, parse_xml(xml, Flags).root);
        assertEq(keys expected, keys parse_xml(xml, Flags).root);
        XmlDoc document(xml);
        assertEq(expected, document.toQore(Flags).root);
        XmlReader reader(xml);
        assertEq(expected, reader.toQore(Flags).root);
        reader = new XmlReader(xml);
        while (reader.read() && reader.nodeType() != XML_NODE_TYPE_ELEMENT) {
        }
        assertEq(expected, reader.toQore(Flags));
        assertEq("root", reader.name());
        assertEq(XML_NODE_TYPE_END_ELEMENT, reader.nodeType());
        assertEq({"a":(NOTHING, NOTHING), "^comment^":"keep"},
            parse_xml(xml, XPF_PRESERVE_ORDER | XPF_ADD_COMMENTS).root);
        hash<auto> grouped = parse_xml(xml, XPF_PRESERVE_WHITESPACE).root;
        assertEq((NOTHING, NOTHING), grouped.a);
        assertEq("\t", grouped."^value1^");
        assertEq(expected, parse_xml(make_xml("root", expected), Flags).root);
    }
    private scopes() {
        string xml = '<root xml:space="preserve"> <reset xml:space="default"> <a/> <a/> </reset> </root>';
        hash<auto> result = parse_xml(xml, Flags).root;
        assertEq(" ", result.reset."^value^");
        assertEq(" ", result.reset."^value1^");
        assertEq(" ", result.reset."^value2^");
        assertEq("default", result.reset."^attributes^"."xml:space");
        assertEq({"^attributes^":{"xml:space":"default"}, "a":(NOTHING, NOTHING)},
            parse_xml(xml, XPF_PRESERVE_ORDER).root.reset);
        XmlReader reader(xml);
        assertTrue(reader.read());
        assertTrue(reader.read());
        assertTrue(reader.read());
        hash<auto> subtree = reader.toQore(Flags);
        assertEq(" ", subtree."^value1^");
        assertTrue(subtree.hasKey("a^1"));
    }
    private schemas() {
        foreach string mixed in ("true", "false") {
            string schema = '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">'
                '<xs:element name="root"><xs:complexType mixed="' + mixed + '"><xs:sequence>'
                '<xs:element name="a" type="xs:int" maxOccurs="2"/></xs:sequence>'
                '</xs:complexType></xs:element></xs:schema>';
            string xml = '<root> <a>017</a>&#9;<a>023</a>&#13;</root>';
            hash<auto> expected = {"^value^":" ", "a":"017", "^value1^":"\t", "a^1":"023", "^value2^":"\r"};
            assertEq(expected, parse_xml_with_schema(xml, schema, Flags).root);
            assertThrows("PARSE-XML-EXCEPTION", \parse_xml_with_schema(),
                ("<root> <a>bad</a> </root>", schema, Flags));
            if (mixed == "false") {
                assertThrows("PARSE-XML-EXCEPTION", \parse_xml_with_schema(),
                    ("<root>text<a>1</a></root>", schema, Flags));
            }
        }
    }
    private boundaries() {
        assertNothing(parse_xml("<root/>", Flags).root);
        assertEq(" \t\n", parse_xml("<root> \t\r\n</root>", Flags).root);
        assertEq({"^value^":" ", "a":NOTHING, "^cdata^":"", "^value1^":" "},
            parse_xml("<root> <a/><![CDATA[]]> </root>", Flags).root);
        foreach int size in (1, 32, 1024) {
            string xml = "<root>";
            foreach int index in (0 .. size - 1) {
                xml += sprintf(" <a>%d</a>", index);
            }
            xml += "\t</root>";
            hash<auto> parsed = parse_xml(xml, Flags).root;
            assertEq(size * 2 + 1, parsed.size());
            foreach int index in (0 .. size - 1) {
                assertEq(string(index), parsed{index ? "a^" + index : "a"});
                assertEq(" ", parsed{index ? "^value" + index + "^" : "^value^"});
            }
            assertEq("\t", parsed{"^value" + size + "^"});
        }
    }
    private failures() {
        assertThrows("PARSE-XML-EXCEPTION", \parse_xml(), ("<root> <a/> </wrong>", Flags));
        SandboxManager manager();
        on_exit manager.clearInterrupt();
        Program program(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
        program.setSandboxManager(manager);
        program.parse("%modern\n%requires xml\nauto sub interrupted(SandboxManager manager) {\n"
            "manager.requestInterrupt();\nreturn parse_xml(\"<root> <a/> </root>\", "
            "XPF_PRESERVE_ORDER | XPF_PRESERVE_WHITESPACE);\n}\n", "whitespace_interrupt");
        *hash<ExceptionInfo> error;
        try {
            program.callFunction("interrupted", manager);
        } catch (hash<ExceptionInfo> caught) {
            error = caught;
        }
        manager.clearInterrupt();
        assertEq("PROGRAM-INTERRUPTED", error.err);
        assertEq(" ", parse_xml("<root> <a/> </root>", Flags).root."^value^");
    }
}
