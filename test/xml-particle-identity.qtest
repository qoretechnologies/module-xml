#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%exec-class XmlParticleIdentityTest

class XmlParticleIdentityTest inherits QUnit::Test {
    constructor() : Test("Native schema particle position identity", "1.0") {
        addTestCase("Distinct local and referenced positions reject duplicate choices", \choices());
        addTestCase("Shared groups retain each use's position", \groups());
        addTestCase("All members and namespace wildcards retain positions", \wildcardsAndAll());
        addTestCase("Repeated iterations keep one position and typed values", \repetitions());
        addTestCase("Invalid declarations do not corrupt later schema use", \recovery());
        addTestCase("Interrupted schema parsing permits subsequent reuse", \cancellation());
        set_return_value(main());
    }

    private string schema(string content, string declarations = "") {
        return '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">' + declarations
            + '<xs:element name="r"><xs:complexType>' + content
            + '</xs:complexType></xs:element></xs:schema>';
    }

    private string element(string name = "a", string counts = "") {
        return sprintf('<xs:element name="%s" type="xs:int" %s/>', name, counts);
    }

    private int consume(string source, string document) {
        XmlReader reader(new StringInputStream(document), {"xsd": source});
        int count = 0;
        while (reader.read()) {
            if (reader.nodeType() == XML_NODE_TYPE_ELEMENT && reader.depth() == 1) {
                ++count;
            }
        }
        @assert(reader.isValid());
        return count;
    }

    private invalid(string content, string declarations = "") {
        string source = schema(content, declarations);
        assertThrows("XSD-SYNTAX-ERROR", \parse_xml_with_schema(), ("<r/>", source), content);
        assertThrows("XSD-SYNTAX-ERROR", \consume(), (source, "<r/>"), content);
    }

    choices() {
        invalid('<xs:choice>' + element() + element() + '</xs:choice>');
        invalid('<xs:choice><xs:element ref="a"/><xs:element ref="a"/></xs:choice>', element());
        invalid('<xs:choice><xs:element ref="head"/><xs:element ref="a"/></xs:choice>',
            '<xs:element name="head" type="xs:int"/>'
            '<xs:element name="a" type="xs:int" substitutionGroup="head"/>');
        invalid('<xs:choice><xs:sequence>' + element() + element("b") + '</xs:sequence><xs:sequence>'
            + element() + element("c") + '</xs:sequence></xs:choice>');
    }

    groups() {
        string declarations = '<xs:group name="Fields"><xs:sequence>' + element()
            + '</xs:sequence></xs:group>';
        invalid('<xs:choice><xs:group ref="Fields"/><xs:group ref="Fields"/></xs:choice>', declarations);
        invalid('<xs:sequence><xs:group ref="Fields" minOccurs="0"/><xs:group ref="Fields"/>'
            '</xs:sequence>', declarations);
        string source = schema('<xs:sequence><xs:group ref="Fields"/><xs:group ref="Fields"/>'
            '</xs:sequence>', declarations);
        assertEq({"r": {"a": ("7", "11")}}, parse_xml_with_schema("<r><a>7</a><a>11</a></r>", source));
        assertEq(2, consume(source, "<r><a>7</a><a>11</a></r>"));
        assertThrows("PARSE-XML-EXCEPTION", \consume(), (source, "<r><a>7</a></r>"));
    }

    wildcardsAndAll() {
        invalid('<xs:all>' + element() + element() + '</xs:all>');
        invalid('<xs:all><xs:element ref="a"/><xs:element ref="a"/></xs:all>', element());
        invalid('<xs:choice><xs:any namespace="##local"/><xs:any namespace="##local"/></xs:choice>');
        invalid('<xs:choice><xs:any namespace="urn:a urn:b"/><xs:any namespace="urn:b"/></xs:choice>');
        string source = schema('<xs:choice><xs:any namespace="urn:a" processContents="skip"/>'
            '<xs:any namespace="urn:b" processContents="skip"/></xs:choice>');
        foreach string uri in ("urn:a", "urn:b") {
            string document = sprintf('<r><v xmlns="%s">text</v></r>', uri);
            assertEq(1, consume(source, document));
            assertEq("text", parse_xml_with_schema(document, source).r.v{"^value^"});
        }
    }

    repetitions() {
        foreach string content in (
                '<xs:sequence>' + element("a", 'minOccurs="0" maxOccurs="unbounded"') + '</xs:sequence>',
                '<xs:sequence minOccurs="0" maxOccurs="unbounded">' + element() + '</xs:sequence>',
                '<xs:sequence minOccurs="1" maxOccurs="2">'
                    + element("a", 'minOccurs="1" maxOccurs="2"') + '</xs:sequence>') {
            string source = schema(content);
            for (int count = 1; count <= 4; ++count) {
                string document = "<r>" + strmul("<a>17</a>", count) + "</r>";
                assertEq(count, consume(source, document));
                auto values = parse_xml_with_schema(document, source).r.a;
                assertEq(count == 1 ? "17" : (map "17", (1 .. count)), values);
            }
            assertThrows("PARSE-XML-EXCEPTION", \consume(), (source, "<r><a>bad</a></r>"));
        }
        string source = schema('<xs:sequence minOccurs="2" maxOccurs="unbounded">' + element()
            + '</xs:sequence>');
        for (int count = 2; count <= 6; ++count) {
            string document = "<r>" + strmul("<a>31</a>", count) + "</r>";
            assertEq(count, consume(source, document));
            assertEq((map "31", (1 .. count)), parse_xml_with_schema(document, source).r.a);
        }
        assertThrows("PARSE-XML-EXCEPTION", \consume(), (source, "<r><a>31</a></r>"));
        source = schema('<xs:all>' + element() + element("b") + '</xs:all>');
        assertEq(2, consume(source, "<r><b>11</b><a>7</a></r>"));
        assertEq({"r": {"b": "11", "a": "7"}}, parse_xml_with_schema("<r><b>11</b><a>7</a></r>", source));
    }

    recovery() {
        for (int index = 0; index < 8; ++index) {
            invalid('<xs:choice>' + element() + element() + '</xs:choice>');
            assertEq({"r": {"a": "23"}}, parse_xml_with_schema("<r><a>23</a></r>",
                schema('<xs:sequence>' + element() + '</xs:sequence>')));
        }
    }
    cancellation() {
        string source = schema('<xs:sequence>' + element() + '</xs:sequence>');
        SandboxManager manager();
        on_exit manager.clearInterrupt();
        Program program(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
        program.setSandboxManager(manager);
        program.parse("%modern\n%requires xml\n"
            "hash<auto> sub check(string source, SandboxManager manager, bool cancel) {\n"
            "    if (cancel) { manager.requestInterrupt(); }\n"
            "    return parse_xml_with_schema(\"<r><a>41</a></r>\", source);\n"
            "}\n", get_script_dir() + "/native-particle-cancellation.qr");
        *hash<ExceptionInfo> error;
        try {
            program.callFunction("check", source, manager, True);
        } catch (hash<ExceptionInfo> ex) {
            error = ex;
        }
        manager.clearInterrupt();
        assertEq("PROGRAM-INTERRUPTED", error.err);
        assertEq({"r": {"a": "41"}}, program.callFunction("check", source, manager, False));
    }

}
