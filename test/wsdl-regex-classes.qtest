#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class RegexClassesTest

class RegexClassesTest inherits QUnit::Test {
    constructor() : Test("XSD character classes and grammar", "1.0") {
        addTestCase("Name and block complements inside classes", \complements());
        addTestCase("Unicode digit and word classes", \unicode());
        addTestCase("Class unions, negation and subtraction", \sets());
        addTestCase("Malformed XSD character groups are rejected", \invalidClasses());
        addTestCase("PCRE extensions are not XSD pattern grammar", \invalidGrammar());
        addTestCase("XML wildcard excludes carriage return and newline", \wildcard());
        addTestCase("Generated values satisfy translated classes and invalid patterns yield no sample", \samples());
        addTestCase("Valid group grammar, escaped ranges and hyphen positions", \grammar());
        addTestCase("Deep subtraction assembly and bounded sample repetition", \bounds());
        addTestCase("Generated candidates satisfy intersecting restrictions", \intersection());
        addTestCase("Regex translation and generation propagate cancellation and recover", \cancellation());
        addTestCase("Types without pattern facets retain their supplied examples", \withoutPatterns());
        set_return_value(main());
    }
    private static XsdSchema schema(string pattern) {
        return new XsdSchema('<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
            <xs:simpleType name="Value"><xs:restriction base="xs:string"><xs:pattern value="'
            + pattern + '"/></xs:restriction></xs:simpleType></xs:schema>', {"async_only": True});
    }
    private check(string pattern, list<string> valid, list<string> invalid) {
        XsdSchema original = schema(pattern);
        foreach XsdSchema definition in (original, Serializable::deserialize(original.serialize())) {
            XsdAbstractType type = definition.findType("Value");
            AbstractDataProviderType provider = Serializable::deserialize(type.getDataProviderType().serialize());
            foreach string value in (valid) {
                assertEq(value, type.deserializeValue("value", definition.getTypeMap(), NOTHING, value));
                assertEq(value, type.serializeValue(definition.nsc, value, True));
                assertEq(value, provider.acceptsValue(value));
            }
            foreach string value in (invalid) {
                assertThrows("SOAP-DESERIALIZATION-ERROR", \type.deserializeValue(),
                    ("value", definition.getTypeMap(), NOTHING, value));
                assertThrows("SOAP-SERIALIZATION-ERROR", \type.serializeValue(), (definition.nsc, value, True));
                assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (value,));
            }
        }
    }
    private complements() {
        check('[\I]', ("!", "1", "́", "𐀀"), ("A", "Α", "中", "_", ":", ""));
        check('[\C]', ("!", "𐀀", " "), ("A", "Α", "1", "١", "́", "_", ":", ""));
        check('[\P{IsGreek}]', ("A", "中", "𐀀", "!"), ("Α", "Ͱ", ""));
    }
    private unicode() {
        check('[\D]', ("A", "Α", "!"), ("0", "١", "१", ""));
        check('[\w]', ("Α", "١", "中", "́", "𐀀"), ("!", "_", " ", ""));
        check('[\W]', ("!", "_", " "), ("Α", "١", "中", "́", "𐀀", ""));
    }
    private sets() {
        check('[\i\I]', ("A", "Α", "!", "1", "𐀀"), ("", "AB"));
        check('[^\i\I]', (), ("A", "Α", "!", "1", "𐀀", ""));
        check('[\I-[0-9]]', ("!", "́", "𐀀"), ("A", "Α", "1", ""));
        check('[a-z-[aeiou]]', ("b", "z"), ("a", "e", "A", ""));
        check('[a-z-[a-z-[aeiou]]]', ("a", "e"), ("b", "z", ""));
        check('[^\P{IsGreek}]', ("Α", "Ͱ"), ("A", "中", "!", ""));
    }
    private invalidClasses() {
        foreach string pattern in ("[]", "[]]", "[^]]", "[a-b-c]", "[a-z-[aeiou]", "[a-z-[b]c]",
                "[a[b]]", '[\d-a]', '[a-\d]', "[z-a]") {
            assertThrows("XSD-SIMPLETYPE-ERROR", \schema(), (pattern,));
        }
    }
    private invalidGrammar() {
        foreach string pattern in ("(?:a)", "(?=a)a", "a*?", "a++", "a{,2}", "a{2,1}",
                '\x{41}', '\p{Greek}', '\p{Cs}', '\p{IsGreek_}', '\Qabc\E', '\bword\b', '(a)\1') {
            assertThrows("XSD-SIMPLETYPE-ERROR", \schema(), (pattern,));
        }
    }
    private wildcard() {
        check(".", ("A", "Α", "𐀀", "\t"), ("\r", "\n", "\r\n", "", "AB"));
    }
    private samples() {
        foreach string pattern in ('[\I]', '[\C]', '[\D]', '[\w]', '[\W]', '[\P{IsGreek}]',
                '[a-z-[aeiou]]', '[\i\I]') {
            XsdSchema definition = schema(pattern);
            XsdAbstractType type = definition.findType("Value");
            *string value = XsdRegexHelper::getSampleValue(pattern);
            assertTrue(exists value);
            assertEq(value, type.serializeValue(definition.nsc, value, True));
            assertEq(value, type.getDataProviderType().acceptsValue(value));
        }
        foreach string invalid in ("[]]", "[a-z-[aeiou]", "(?:a)", "a*?", '\p{Greek}') {
            assertNothing(XsdRegexHelper::getSampleValue(invalid));
        }
        assertNothing(XsdRegexHelper::getSampleValue('[^\i\I]'));
    }
    private grammar() {
        check("(a|b){1,2}", ("a", "b", "ab", "ba"), ("", "aaa", "c"));
        check("(a|)", ("a", ""), ("aa", "b"));
        check("()", ("",), ("a",));
        check("a{0001,0002}", ("a", "aa"), ("", "aaa"));
        check("[-a]", ("-", "a"), ("b", ""));
        check("[a-]", ("-", "a"), ("b", ""));
        check("[a--[a]]", ("-",), ("a", "b", ""));
        check('[\--/]', ("-", ".", "/"), ("0", "", "a"));
        check('[\[-\]]', ("[", "\\", "]"), ("a", "^", ""));
        check("[a^]", ("a", "^"), ("b", ""));
        check("^a$", ("^a$",), ("a", "^a", "a$"));
    }
    private bounds() {
        string pattern = "[a]";
        for (int depth = 0; depth < 40; ++depth) {
            pattern = "[a-[" + pattern.substr(1) + "]";
        }
        check(pattern, ("a",), ("b", ""));
        # Conversion uses an explicit stack even beyond the backend's nesting limit.
        for (int depth = 40; depth < 2000; ++depth) {
            pattern = "[a-[" + pattern.substr(1) + "]";
        }
        assertLt(pattern.length() * 10, XsdRegexHelper::toPcre(pattern).length());
        assertNothing(XsdRegexHelper::getSampleValue("a{18446744073709551617}"));
        assertNothing(XsdRegexHelper::getSampleValue("a{9223372036854775807}", 9223372036854775807));
        assertEq("", XsdRegexHelper::getSampleValue("()*", 9223372036854775807));
        assertNothing(XsdRegexHelper::getSampleValue("a{18446744073709551617,0}"));
    }
    private intersection() {
        XsdSchema original('<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
            <xs:simpleType name="Base"><xs:restriction base="xs:string"><xs:pattern value="[\D]"/>
            </xs:restriction></xs:simpleType>
            <xs:simpleType name="Value"><xs:restriction base="Base"><xs:pattern value="[\I]"/>
            </xs:restriction></xs:simpleType></xs:schema>', {"async_only": True});
        foreach XsdSchema definition in (original, Serializable::deserialize(original.serialize())) {
            XsdSimpleType type = cast<XsdSimpleType>(definition.findType("Value"));
            *string sample = type.getPatternSample();
            assertTrue(exists sample);
            assertEq(sample, type.serializeValue(definition.nsc, sample, True));
            assertEq(sample, type.getDataProviderType().acceptsValue(sample));
            assertNothing(type.getPatternSample(2));
        }
    }
    private cancellation() {
        SandboxManager manager();
        on_exit manager.clearInterrupt();
        Program program(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
        program.setSandboxManager(manager);
        program.parse("%modern\n%requires ../qlib/WSDL.qm\n"
            "*string sub runRegex(SandboxManager manager, bool sample, bool cancel) {\n"
            "    if (cancel) { manager.requestInterrupt(); }\n"
            "    return sample ? XsdRegexHelper::getSampleValue(\"[a-z-[aeiou]]\")\n"
            "        : XsdRegexHelper::toPcre(\"[a-z-[aeiou]]\");\n"
            "}\n", get_script_dir() + "/wsdl-regex-interrupt.qr");
        foreach bool sample in (False, True) {
            *hash<ExceptionInfo> error;
            try {
                program.callFunction("runRegex", manager, sample, True);
            } catch (hash<ExceptionInfo> ex) {
                error = ex;
            }
            manager.clearInterrupt();
            assertEq("PROGRAM-INTERRUPTED", error.err);
            string recovered = program.callFunction("runRegex", manager, sample, False);
            assertTrue(sample ? regex(recovered, '\A[b-df-hj-np-tv-z]\z')
                : regex("b", "\\A(?:" + recovered + ")\\z"));
        }
    }
    private withoutPatterns() {
        foreach string base in ("date", "string", "integer") {
            XsdSchema original('<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
                <xs:simpleType name="Base"><xs:restriction base="xs:' + base + '"/></xs:simpleType>
                <xs:simpleType name="Value"><xs:restriction base="Base"/></xs:simpleType></xs:schema>',
                {"async_only": True});
            foreach XsdSchema definition in (original, Serializable::deserialize(original.serialize())) {
                XsdSimpleType type = cast<XsdSimpleType>(definition.findType("Value"));
                assertNothing(type.getPatternSample());
                string value = base == "integer" ? "42" : "2026-09-09";
                assertEq(value, type.getSampleValue(value).toString());
            }
        }
    }
}
