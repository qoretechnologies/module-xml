#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm

%exec-class ProviderExamplesTest

# Every XSD value provider's example is a value the provider accepts, so a message's example can be serialized: for
# each builtin type and for restrictions by every kind of constraining facet, including after the providers are
# saved and restored. The schema validity of the serialized examples is checked independently by
# wsdl-interop/test_provider_examples.py.
public class ProviderExamplesTest inherits QUnit::Test {
    public {
        # builtin types whose values a SOAP message can carry; ENTITY values need a DTD, which SOAP excludes
        const Builtins = ("string", "normalizedString", "token", "language", "Name", "NCName", "NMTOKEN",
            "NMTOKENS", "ID", "IDREF", "IDREFS", "QName", "anyURI", "boolean", "decimal", "integer",
            "nonPositiveInteger", "negativeInteger", "long", "int", "short", "byte", "nonNegativeInteger",
            "unsignedLong", "unsignedInt", "unsignedShort", "unsignedByte", "positiveInteger", "float", "double",
            "duration", "dateTime", "time", "date", "gYearMonth", "gYear", "gMonthDay", "gDay", "gMonth",
            "hexBinary", "base64Binary", "anySimpleType");

        # a restriction by each kind of constraining facet
        const Restrictions = {
            "decimal_min": '<xs:restriction base="xs:decimal"><xs:minInclusive value="1000"/></xs:restriction>',
            "decimal_digits": '<xs:restriction base="xs:decimal"><xs:totalDigits value="3"/>'
                '<xs:fractionDigits value="1"/><xs:minExclusive value="10"/></xs:restriction>',
            "decimal_enum": '<xs:restriction base="xs:decimal"><xs:enumeration value="2.5"/></xs:restriction>',
            "integer_max": '<xs:restriction base="xs:integer"><xs:maxExclusive value="-5"/></xs:restriction>',
            "int_range": '<xs:restriction base="xs:int"><xs:minInclusive value="200"/>'
                '<xs:maxInclusive value="210"/></xs:restriction>',
            "unsigned_long_min": '<xs:restriction base="xs:unsignedLong">'
                '<xs:minInclusive value="18446744073709551600"/></xs:restriction>',
            "float_min": '<xs:restriction base="xs:float"><xs:minExclusive value="1000"/></xs:restriction>',
            "double_pattern": '<xs:restriction base="xs:double"><xs:pattern value="[0-9]\.[0-9]E[0-9]"/>'
                '</xs:restriction>',
            "string_length": '<xs:restriction base="xs:string"><xs:length value="3"/></xs:restriction>',
            "string_min": '<xs:restriction base="xs:string"><xs:minLength value="40"/></xs:restriction>',
            "string_pattern": '<xs:restriction base="xs:string"><xs:pattern value="[A-Z]{3}-[0-9]{4}"/>'
                '</xs:restriction>',
            "string_enum": '<xs:restriction base="xs:string"><xs:enumeration value="RED"/>'
                '<xs:enumeration value="GREEN"/></xs:restriction>',
            "token_max": '<xs:restriction base="xs:token"><xs:maxLength value="2"/></xs:restriction>',
            "language_pattern": '<xs:restriction base="xs:language"><xs:pattern value="[a-z]{2}-[A-Z]{2}"/>'
                '</xs:restriction>',
            "ncname_length": '<xs:restriction base="xs:NCName"><xs:minLength value="12"/></xs:restriction>',
            "date_min": '<xs:restriction base="xs:date"><xs:minInclusive value="2030-01-01"/></xs:restriction>',
            "datetime_max": '<xs:restriction base="xs:dateTime"><xs:maxExclusive value="1990-01-01T00:00:00Z"/>'
                '</xs:restriction>',
            "gyear_enum": '<xs:restriction base="xs:gYear"><xs:enumeration value="1999"/></xs:restriction>',
            "duration_min": '<xs:restriction base="xs:duration"><xs:minInclusive value="P10Y"/></xs:restriction>',
            "hex_length": '<xs:restriction base="xs:hexBinary"><xs:length value="2"/></xs:restriction>',
            "base64_max": '<xs:restriction base="xs:base64Binary"><xs:maxLength value="3"/></xs:restriction>',
            "uri_pattern": '<xs:restriction base="xs:anyURI"><xs:pattern value="urn:x:[a-z]+"/></xs:restriction>',
            "qname_enum": '<xs:restriction base="xs:QName"><xs:enumeration value="t:red"/></xs:restriction>',
            "boolean_pattern": '<xs:restriction base="xs:boolean"><xs:pattern value="0|1"/></xs:restriction>',
            "int_list": '<xs:list itemType="xs:int"/>',
            "int_list_length": '<xs:restriction><xs:simpleType><xs:list itemType="xs:int"/></xs:simpleType>'
                '<xs:length value="3"/></xs:restriction>',
            "date_list_enum": '<xs:restriction><xs:simpleType><xs:list itemType="xs:date"/></xs:simpleType>'
                '<xs:enumeration value="2001-02-03 2004-05-06"/></xs:restriction>',
            "union": '<xs:union memberTypes="xs:int xs:date"/>',
            "union_pattern": '<xs:restriction><xs:simpleType><xs:union memberTypes="xs:int xs:date"/>'
                '</xs:simpleType><xs:pattern value="[0-9]{4}-.*"/></xs:restriction>',
        };
    }

    constructor() : Test("ProviderExamplesTest", "1.0") {
        addTestCase("every field example is accepted by its provider", \fieldExamples());
        addTestCase("the message example serializes and decodes to the same value", \messageExample());
        addTestCase("restored providers keep their examples", \restored());
        addTestCase("an ENTITY field has no value a SOAP message can carry", \entity());
        addTestCase("the reported xs:decimal message example", \decimalMessage());
        set_return_value(main());
    }

    # returns a document/literal WSDL whose message element has one field per builtin type and restriction
    static string wsdl(list<string> builtins = Builtins, hash<string, string> restrictions = Restrictions) {
        string types = (foldl $1 + $2, (map sprintf('<xs:simpleType name="%s">%s</xs:simpleType>', $1.key,
            $1.value), restrictions.pairIterator())) ?? "";
        string fields = (foldl $1 + $2, (map sprintf('<xs:element name="f_%s" type="xs:%s"/>', $1, $1),
            builtins)) ?? "";
        fields += (foldl $1 + $2, (map sprintf('<xs:element name="r_%s" type="t:%s"/>', $1, $1),
            keys restrictions)) ?? "";
        return sprintf('<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"
            xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:xs="http://www.w3.org/2001/XMLSchema"
            xmlns:t="urn:examples" targetNamespace="urn:examples">
          <types><xs:schema targetNamespace="urn:examples" elementFormDefault="qualified">%s
            <xs:element name="record"><xs:complexType><xs:sequence>%s</xs:sequence></xs:complexType></xs:element>
          </xs:schema></types>
          <message name="m"><part name="body" element="t:record"/></message>
          <portType name="P"><operation name="put"><input message="t:m"/><output message="t:m"/></operation>
          </portType>
          <binding name="B" type="t:P"><soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
            <operation name="put"><soap:operation soapAction=""/><input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output></operation></binding>
          <service name="S"><port name="p" binding="t:B"><soap:address location="http://localhost/examples"/></port>
          </service></definitions>', types, fields);
    }

    # QName values are objects; compare their identities
    static auto snapshot(auto value) {
        if (value instanceof XsdQNameValue) {
            return {"namespace_uri": value.getNamespaceUri(), "local_name": value.getLocalName()};
        }
        if (value.typeCode() == NT_HASH) {
            return map {$1.key: snapshot($1.value)}, value.pairIterator();
        }
        if (value.typeCode() == NT_LIST) {
            return map snapshot($1), value;
        }
        return value;
    }

    static hash<string, AbstractDataField> recordFields(WebService ws) {
        return ws.getOperation("put").input.getDataProviderType().getFields().body.getType().getFields();
    }

    fieldExamples() {
        WebService ws(wsdl());
        hash<string, AbstractDataField> fields = recordFields(ws);
        assertEq(Builtins.size() + Restrictions.size(), fields.size());
        foreach hash<auto> field in (fields.pairIterator()) {
            AbstractDataProviderType type = field.value.getType();
            auto example = type.getExampleValue();
            assertTrue(exists example, field.key);
            # the example is in the provider's output form: accepting it again leaves it unchanged
            assertEq(example, type.acceptsValue(example), field.key);
        }
        # ordinary DataProvider examples are kept wherever they are valid; only invalid ones are replaced
        assertEq("example string", fields.f_string.getType().getExampleValue());
        assertEq(100, fields.f_int.getType().getExampleValue());
        assertEq(123.456, fields.f_decimal.getType().getExampleValue());
        # the ID types share one sample, so that references resolve in a message
        assertEq(fields.f_ID.getType().getExampleValue(), fields.f_IDREF.getType().getExampleValue());
        # examples satisfy the facets, not just the base type
        assertEq("RED", fields.r_string_enum.getType().getExampleValue());
        assertEq(3, fields.r_string_length.getType().getExampleValue().length());
        assertEq(3, fields.r_int_list_length.getType().getExampleValue().size());
        assertTrue(fields.r_decimal_min.getType().getExampleValue() >= 1000);
        assertTrue(fields.r_int_range.getType().getExampleValue() >= 200);
        assertRegex("^[A-Z]{3}-[0-9]{4}$", fields.r_string_pattern.getType().getExampleValue());
    }

    messageExample() {
        WebService ws(wsdl());
        WSOperation op = ws.getOperation("put");
        hash<auto> example = op.input.getDataProviderType().getExampleValue();
        assertEq(Builtins.size() + Restrictions.size(), example.body.size());
        hash<auto> request = op.serializeRequest(example, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, "B");
        hash<auto> msg = WSDLLib::parseMultiPartSOAPMessage({"content-type": request.hdr."Content-Type",
            "body": request.body}, False, True);
        hash<auto> decoded = op.deserializeRequest(WSDLLib::parseSOAPMessage(msg, False, True), "B");
        # the decoded part is accepted by the same provider, as a value equal to the example
        AbstractDataProviderType type = op.input.getDataProviderType();
        assertEq(snapshot(type.acceptsValue(example)), snapshot(type.acceptsValue({"body": decoded})));
        # a response built from the output message's example serializes as well
        hash<auto> output = op.output.getDataProviderType().getExampleValue();
        assertRegex(":record", op.serializeResponse(output, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, "B").body);
    }

    restored() {
        WebService ws(wsdl());
        hash<string, AbstractDataField> fields = recordFields(ws);
        foreach hash<auto> field in (fields.pairIterator()) {
            AbstractDataProviderType type = field.value.getType();
            # a detached copy of the provider alone keeps the example of the schema type it was created from
            AbstractDataProviderType copy = Serializable::deserialize(Serializable::serialize(type));
            assertEq(snapshot(type.getExampleValue()), snapshot(copy.getExampleValue()), field.key);
            # an optional copy has the same example, or none where optional providers omit examples
            auto optional = type.getOrNothingType().getExampleValue();
            if (exists optional) {
                assertEq(snapshot(type.getExampleValue()), snapshot(optional), field.key);
            }
        }
        # a saved service as a whole
        WebService copy = Serializable::deserialize(ws.serialize());
        assertEq(snapshot(ws.getOperation("put").input.getDataProviderType().getExampleValue()),
            snapshot(copy.getOperation("put").input.getDataProviderType().getExampleValue()));
    }

    entity() {
        WebService ws(wsdl(("ENTITY",), {}));
        AbstractDataProviderType type = recordFields(ws).f_ENTITY.getType();
        # the lexical example is an NCName ...
        assertEq("abc", type.getExampleValue());
        # ... but no SOAP message can declare the unparsed entity it names
        AbstractDataProviderType message = ws.getOperation("put").input.getDataProviderType();
        assertThrows("RUNTIME-TYPE-ERROR", "requires an unparsed-entity declaration", \message.getExampleValue());
    }

    decimalMessage() {
        # a message with an xs:decimal field has an example (the case reported from a SOAP simulation)
        WebService ws(wsdl(("decimal", "string"), {}));
        hash<auto> example = ws.getOperation("put").output.getDataProviderType().getExampleValue();
        assertEq(123.456, example.body.f_decimal);
        assertEq(example, ws.getOperation("put").output.getDataProviderType().acceptsValue(example));
    }
}
