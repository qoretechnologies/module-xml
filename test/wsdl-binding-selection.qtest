#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires ../qlib/WSDL.qm
%requires ../qlib/SoapClient.qm
%exec-class BindingSelectionTest

class BindingSelectionTest inherits QUnit::Test {
    constructor() : Test("WSDL selected binding operations", "1.0") {
        addTestCase("Selected bindings expose only their concrete operations", \selected());
        addTestCase("Expanded identities select colliding imported bindings after saving", \imported());
        addTestCase("SoapClient rejects omitted operations before producing a request", \client());
        set_return_value(main());
    }

    private static string contract(string uri) {
        return '<w:definitions xmlns:w="http://schemas.xmlsoap.org/wsdl/" xmlns:t="' + uri + '"'
            + ' xmlns:s="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:s12="http://schemas.xmlsoap.org/wsdl/soap12/"'
            + ' targetNamespace="' + uri + '"><w:message name="M"/><w:portType name="P">'
            + '<w:operation name="one"><w:input message="t:M"/></w:operation>'
            + '<w:operation name="two"><w:input message="t:M"/></w:operation>'
            + '<w:operation name="unbound"><w:input message="t:M"/></w:operation></w:portType>'
            + '<w:binding name="First" type="t:P"><s:binding transport="http://schemas.xmlsoap.org/soap/http"/>'
            + '<w:operation name="one"><w:input><s:body use="literal"/></w:input></w:operation></w:binding>'
            + '<w:binding name="Second" type="t:P"><s12:binding transport="http://schemas.xmlsoap.org/soap/http"/>'
            + '<w:operation name="two"><w:input><s12:body use="literal"/></w:input></w:operation></w:binding>'
            + '<w:binding name="Empty" type="t:P"><s:binding transport="http://schemas.xmlsoap.org/soap/http"/></w:binding>'
            + '<w:service name="S"><w:port name="FirstPort" binding="t:First">'
            + '<s:address location="http://example.invalid/soap"/></w:port>'
            + '<w:port name="SecondPort" binding="t:Second">'
            + '<s12:address location="http://example.invalid/soap"/></w:port></w:service></w:definitions>';
    }

    private check(WebService ws, string prefix) {
        WSOperation one = ws.getBindingOperation(prefix + "First", "one");
        WSOperation two = ws.getBindingOperation(prefix + "Second", "two");
        assertEq("one", one.name);
        assertEq("two", two.name);
        assertFalse(one.getBinding(prefix + "First").isSoap12());
        assertTrue(two.getBinding(prefix + "Second").isSoap12());
        foreach list<string> pair in (("First", "two"), ("Second", "one"),
                ("First", "unbound"), ("Empty", "one"), ("Empty", "unbound")) {
            assertThrows("WSDL-BINDING-ERROR", \ws.getBindingOperation(), (prefix + pair[0], pair[1]));
        }
        assertThrows("WSDL-OPERATION-ERROR", \ws.getBindingOperation(), (prefix + "First", "absent"));
        assertThrows("WSDL-BINDING-ERROR", \ws.getBindingOperation(), (prefix + "Absent", "one"));
        # Abstract discovery remains available independently of concrete binding membership.
        assertEq("unbound", ws.getPortTypeOperation(prefix + "P", "unbound").name);
        assertTrue(one === ws.getPortTypeOperation(prefix + "P", "one"));
        assertTrue(ws.getBindingOperation(prefix + "Second", "two") === two);
    }

    private selected() {
        WebService ws(contract("urn:selected"));
        foreach bool saved in (False, True) {
            if (saved) {
                ws = Serializable::deserialize(ws.serialize());
            }
            check(ws, "");
            check(ws, "{urn:selected}");
            assertEq(3, ws.listOperations().size());
            assertEq("unbound", ws.getBindingOperation(NOTHING, "unbound").name);
        }
    }

    private imported() {
        string root = '<w:definitions xmlns:w="http://schemas.xmlsoap.org/wsdl/" targetNamespace="urn:root">'
            + '<w:import namespace="urn:a" location="a.wsdl"/>'
            + '<w:import namespace="urn:b" location="b.wsdl"/></w:definitions>';
        WebService ws(root, {"document_location": "https://example.invalid/root.wsdl", "async_only": True,
            "xsd_cache": {"https://example.invalid/a.wsdl": contract("urn:a"),
                "https://example.invalid/b.wsdl": contract("urn:b")}});
        foreach bool saved in (False, True) {
            if (saved) {
                ws.opts.xsd_cache = {};
                ws = Serializable::deserialize(ws.serialize());
            }
            check(ws, "{urn:a}");
            check(ws, "{urn:b}");
            assertThrows("WSDL-BINDING-ERROR", \ws.getBindingOperation(), ("First", "one"));
            assertThrows("WSDL-BINDING-ERROR", \ws.getBindingOperation(), ("{urn:missing}First", "one"));
            assertEq(6, ws.listOperations().size());
        }
    }

    private client() {
        WebService ws = Serializable::deserialize(new WebService(contract("urn:selected")).serialize());
        foreach bool second in (False, True) {
            SoapClient client({"wsdl": ws, "service": "S", "port": second ? "SecondPort" : "FirstPort"});
            string valid = second ? "two" : "one";
            string invalid = second ? "one" : "two";
            WSOperation op;
            hash<auto> message = client.getMsg(valid, {}, NOTHING, \op);
            assertEq(valid, op.name);
            assertTrue(message.body.contains(second ? SOAP_12_ENV : SOAP_11_ENV));
            assertThrows("WSDL-BINDING-ERROR", \client.callOperation(), (invalid, {}));
            assertThrows("WSDL-BINDING-ERROR", \client.callOperation(), ("unbound", {}));
            message = client.getMsg(valid, {}, NOTHING, \op);
            assertEq(valid, op.name);
            assertTrue(message.body.contains(second ? SOAP_12_ENV : SOAP_11_ENV));
        }
    }
}
