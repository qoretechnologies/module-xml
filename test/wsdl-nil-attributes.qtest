#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class NilAttributeTest

class NilAttributeTest inherits QUnit::Test {
    constructor() : Test("Explicit nil attribute compatibility", "1.0") {
        addTestCase("2.x SOAP nil attribute input", \nilAttributeTest());
        addTestCase("Legacy nil values match native carriers", \carriers());
        addTestCase("Simple output validates attributes before extracting content", \simpleAttributes());
        addTestCase("QName output retains namespace bindings and comments", \qnames());
        addTestCase("Nil aliases respect fixed constraints and leave caller values intact", \constraints());
        addTestCase("Declared nil attributes and selected types retain their identities", \declared());
        set_return_value(main());
    }
    private XsdSchema schema(string declarations) {
        return new XsdSchema('<xs:schema xmlns:xs="' + XSD_NS + '">' + declarations + '</xs:schema>',
            {"async_only": True});
    }
    nilAttributeTest() {
        WebService ws = WSDLLib::getWebServiceFromUrl(get_script_dir() + "/nil-attribute.wsdl");
        WSOperation op = ws.getOperation("Op");
        code<hash<auto>(hash<auto>)> get_body = hash<auto> sub (hash<auto> req) {
            return parse_xml(op.serializeRequest({"Req": req}).body).firstValue()."soapenv:Body"."ns:Req";
        };
        hash<auto> nil = {"^attributes^": {"xsi:nil": "true"}};

        # an optional nillable element is serialized with xsi:nil="true" and with no content, also when the element
        # is nested in other elements
        string xml = op.serializeRequest({"Req": {
            "hotline": {"^attributes^": {"nil": "true"}},
            "incoming-communication-barring": {
                "icb-operator-configuration": {"icb-ruleset": {"^attributes^": {"nil": "true"}}},
            },
        }}).body;
        assertTrue(xml =~ /<ns:hotline xsi:nil="true"\/>/, "nil: serialized as an empty element");
        assertTrue(xml =~ /<ns:icb-ruleset xsi:nil="true"\/>/, "nil: nested, serialized as an empty element");
        # the namespace prefix of the attribute is declared in the message
        assertTrue(xml =~ /xmlns:xsi="http:\/\/www.w3.org\/2001\/XMLSchema-instance"/, "nil: xsi declared");
        hash<auto> body = parse_xml(xml).firstValue()."soapenv:Body"."ns:Req";
        assertEq(("ns:hotline", "ns:incoming-communication-barring", "ns:required-nillable"), keys body,
            "nil: elements serialized in order");
        assertEq(nil, body."ns:hotline", "nil: element");
        assertEq(nil, body."ns:incoming-communication-barring"."ns:icb-operator-configuration"."ns:icb-ruleset",
            "nil: nested element");

        # an optional nillable element with no value is left out of the message; a required one is nilled
        body = get_body({});
        assertEq({"ns:required-nillable": nil}, body, "nil: no value");

        # the attribute can be given with or without the namespace prefix and with any xs:boolean value
        foreach hash<auto> ah in ({"nil": "true"}, {"xsi:nil": "true"}, {"nil": True}, {"nil": "1"}, {"nil": 1},
            {"xsi:nil": " true "}, {"nil": 1.0}, {"nil": 1n}) {
            assertEq(nil, get_body({"hotline": {"^attributes^": ah}})."ns:hotline", sprintf("nil: %Y", ah));
        }
        # members with no value and comments are not content
        assertEq(nil, get_body({"hotline": {"^attributes^": {"nil": "true"},
            "hotline-user-configuration": NOTHING}})."ns:hotline", "nil: member with no value");
        assertTrue(op.serializeRequest({"Req": {"hotline": {"^attributes^": {"nil": "true"}, "^comment^": "x"}}}).body
            =~ /<ns:hotline xsi:nil="true"><!--x--><\/ns:hotline>/, "nil: comment");

        # a false value means that the element is serialized normally
        foreach hash<auto> ah in ({"nil": "false"}, {"xsi:nil": "false"}, {"nil": False}, {"nil": "0"}, {"nil": 0}) {
            assertEq({"ns:hotline-user-configuration": "u"}, get_body({"hotline": {"^attributes^": ah,
                "hotline-user-configuration": "u"}})."ns:hotline", sprintf("not nil: %Y", ah));
        }
        assertTrue(op.serializeRequest({"Req": {"hotline": {"^attributes^": {"nil": "false"}}}}).body
            =~ /<ns:hotline\/>/, "not nil: empty element");

        # an element with xsi:nil="true" still has the attributes declared by its type; the content required by
        # the type is not required
        assertEq({"^attributes^": {"xsi:nil": "true", "id": "x", "count": "2"}},
            get_body({"with-attr": {"^attributes^": {"nil": "true", "id": "x", "count": 2}}})."ns:with-attr",
            "nil: attributes");
        assertThrows("SOAP-SERIALIZATION-ERROR", "without required attribute \"id\"", \op.serializeRequest(),
            {"Req": {"with-attr": {"^attributes^": {"nil": "true"}}}});
        assertThrows("SOAP-SERIALIZATION-ERROR", "unknown attribute \"{}other\"", \op.serializeRequest(),
            {"Req": {"with-attr": {"^attributes^": {"nil": "true", "id": "x", "other": 1}}}});
        assertThrows("SOAP-SERIALIZATION-ERROR", "unknown attribute \"{}other\"", \op.serializeRequest(),
            {"Req": {"hotline": {"^attributes^": {"nil": "true", "other": 1}}}});
        assertThrows("SOAP-SERIALIZATION-ERROR", "cannot contain ordinary attributes", \op.serializeRequest(),
            {"Req": {"simple": {"^attributes^": {"nil": "true", "other": 1}}}});

        # an attribute named "nil" declared by the type itself is not xsi:nil; xsi:nil can still be given
        assertEq({"^attributes^": {"nil": "true"}, "ns:value": "v"},
            get_body({"own-nil": {"^attributes^": {"nil": "true"}, "value": "v"}})."ns:own-nil", "own nil attribute");
        assertEq({"^attributes^": {"xsi:nil": "true", "nil": "abc"}},
            get_body({"own-nil": {"^attributes^": {"xsi:nil": "true", "nil": "abc"}}})."ns:own-nil",
            "own nil attribute with xsi:nil");

        # elements of simple types and elements that can be repeated
        assertEq(nil, get_body({"simple": {"^attributes^": {"nil": "true"}}})."ns:simple", "nil: simple type");
        assertEq((nil, {"ns:hotline-user-configuration": "u"}, nil), get_body({"list": (
            {"^attributes^": {"nil": "true"}},
            {"hotline-user-configuration": "u"},
            {"^attributes^": {"xsi:nil": True}},
        )})."ns:list", "nil: list");
        assertEq(nil, get_body({"list": ({"^attributes^": {"nil": "true"}},)})."ns:list", "nil: single-element list");
        assertEq(nil, get_body({"required-nillable": {"^attributes^": {"nil": "true"}}})."ns:required-nillable",
            "nil: required element");

        # elements with xsi:nil="true" are deserialized as NOTHING
        hash<auto> rt = op.deserializeRequest(parse_xml(xml));
        assertEq(NOTHING, rt.hotline, "nil: deserialized");
        assertTrue(rt."incoming-communication-barring"."icb-operator-configuration".hasKey("icb-ruleset"),
            "nil: nested element deserialized");
        assertEq(NOTHING, rt."incoming-communication-barring"."icb-operator-configuration"."icb-ruleset",
            "nil: nested deserialized");

        # an element with xsi:nil="true" cannot have content
        assertThrows("SOAP-SERIALIZATION-ERROR", "must be empty", \op.serializeRequest(),
            {"Req": {"hotline": {"^attributes^": {"nil": "true"}, "hotline-user-configuration": "u"}}});
        assertThrows("SOAP-SERIALIZATION-ERROR", "must be empty", \op.serializeRequest(),
            {"Req": {"simple": {"^attributes^": {"nil": "true"}, "^value^": "u"}}});
        assertThrows("SOAP-SERIALIZATION-ERROR", "must be empty", \op.serializeRequest(),
            {"Req": {"list": ({"^attributes^": {"nil": "true"}, "hotline-user-configuration": "u"},)}});
        # xsi:nil cannot be used with an element that is not nillable, whatever its value is
        assertThrows("SOAP-SERIALIZATION-ERROR", "does not permit xsi:nil", \op.serializeRequest(),
            {"Req": {"not-nillable": {"^attributes^": {"nil": "true"}}}});
        assertThrows("SOAP-SERIALIZATION-ERROR", "does not permit xsi:nil", \op.serializeRequest(),
            {"Req": {"not-nillable": {"^attributes^": {"xsi:nil": "false"}}}});
        assertThrows("SOAP-SERIALIZATION-ERROR", "does not permit xsi:nil", \op.serializeRequest(),
            {"Req": {"incoming-communication-barring": {"^attributes^": {"nil": "true"}}}});
        # the value must be a valid xs:boolean value
        foreach auto v in ("yes", "TRUE", "", 2, 0.5, NOTHING, {}) {
            assertThrows("SOAP-SERIALIZATION-ERROR", "requires true, false, 1 or 0", \op.serializeRequest(),
                {"Req": {"hotline": {"^attributes^": {"nil": v}}}}, sprintf("invalid: %Y", v));
        }
    }

    private string text(XsdXmlValue xml) {
        auto value = parse_xml(xml.getXml()).value;
        return (value.typeCode() == NT_HASH ? value."^value^" : value) ?? "";
    }
    private carriers() {
        WebService ws = WSDLLib::getWebServiceFromUrl(get_script_dir() + "/nil-attribute.wsdl");
        WSOperation op = ws.getOperation("Op");
        code<hash<auto>(hash<auto>)> body = hash<auto> sub(hash<auto> request) {
            return parse_xml(op.serializeRequest({"Req": request}).body).firstValue()."soapenv:Body"."ns:Req";
        };
        foreach string field in ("hotline", "simple", "list", "required-nillable") {
            assertEq({"^attributes^": {"xsi:nil": "true"}}, body({field: new XsdNilValue()}){"ns:" + field});
        }
        assertEq({"^attributes^": {"id": "x", "count": "2", "xsi:nil": "true"}},
            body({"with-attr": new XsdNilValue({"id": "x", "count": 2})})."ns:with-attr");
        assertEq({"^attributes^": {"nil": "abc", "xsi:nil": "true"}},
            body({"own-nil": new XsdNilValue({"nil": "abc"})})."ns:own-nil");
        assertEq({"^attributes^": {"xsi:nil": "true"}}, body({"incoming-communication-barring": {
            "icb-operator-configuration": {"icb-ruleset": new XsdNilValue()}}})
            ."ns:incoming-communication-barring"."ns:icb-operator-configuration"."ns:icb-ruleset");
        assertEq(({"^attributes^": {"xsi:nil": "true"}}, {"ns:hotline-user-configuration": "u"},
            {"^attributes^": {"xsi:nil": "true"}}), body({"list": (new XsdNilValue(),
            {"hotline-user-configuration": "u"}, new XsdNilValue())})."ns:list");
        foreach hash<auto> request in ({"with-attr": new XsdNilValue()},
                {"with-attr": new XsdNilValue({"id": "x", "other": 1})},
                {"hotline": new XsdNilValue({"other": 1})}, {"simple": new XsdNilValue({"other": 1})},
                {"not-nillable": new XsdNilValue()}, {"incoming-communication-barring": new XsdNilValue()}) {
            assertThrows("SOAP-SERIALIZATION-ERROR", body, (request,));
        }
    }
    private simpleAttributes() {
        string declarations = '<xs:simpleType name="Restricted"><xs:restriction base="xs:string">'
            '<xs:maxLength value="3"/></xs:restriction></xs:simpleType>'
            '<xs:simpleType name="Items"><xs:list itemType="xs:int"/></xs:simpleType>'
            '<xs:simpleType name="Choice"><xs:union memberTypes="xs:int xs:boolean"/></xs:simpleType>';
        foreach hash<auto> entry in ({"type": "xs:string", "value": "u"}, {"type": "xs:int", "value": 5},
                {"type": "Restricted", "value": "u"}, {"type": "Items", "value": (1, 2), "lexical": "1 2"},
                {"type": "Choice", "value": "true"}) {
            XsdSchema model = schema(declarations + '<xs:element name="value" type="' + entry.type
                + '" nillable="true"/>');
            XsdAbstractType type = model.getElement("", "value").type;
            foreach hash<auto> attributes in ({"foo": "bar"}, {"p:foo": "bar"},
                    {"xmlns:p": "urn:other", "p:foo": "bar"}, {"{}foo": "bar"}) {
                foreach hash<auto> input in ({"^attributes^": attributes},
                        {"^attributes^": attributes, "^value^": entry.value}) {
                    assertThrows("SOAP-SERIALIZATION-ERROR", \model.serializeXmlValue(), ("", "value", input));
                    assertThrows("SOAP-SERIALIZATION-ERROR", \type.serializeValue(), (model.nsc.copy(), input, True));
                }
            }
            foreach auto attributes in ("invalid", 42, ("p",)) {
                assertThrows("SOAP-SERIALIZATION-ERROR", \model.serializeXmlValue(),
                    ("", "value", {"^attributes^": attributes, "^value^": entry.value}));
            }
            foreach string key in ("nil", "xsi:nil") {
                foreach auto flag in ("true", "1", True, 1, "\ttrue\r\n") {
                    XsdXmlValue output = model.serializeXmlValue("", "value", {"^attributes^": {key: flag}});
                    assertEq("true", XsdBase::getExpandedAttributes(parse_xml(output.getXml()).value."^attributes^"){
                        "{" + XSI_NS + "}nil"});
                }
                foreach auto flag in ("false", "0", False, 0, "\tfalse\r\n", 0.0, 0n) {
                    XsdXmlValue output = model.serializeXmlValue("", "value",
                        {"^attributes^": {key: flag}, "^value^": entry.value});
                    assertEq(entry.lexical ?? string(entry.value), text(output));
                }
                assertThrows("SOAP-SERIALIZATION-ERROR", \model.serializeXmlValue(),
                    ("", "value", {"^attributes^": {key: True}, "^value^": entry.value}));
            }
            foreach string key in ("xsi:nil", "{" + XSI_NS + "}nil", "i:nil") {
                foreach bool flag in (True, False) {
                    assertThrows("SOAP-SERIALIZATION-ERROR", \type.serializeValue(), (model.nsc.copy(),
                        {"^attributes^": {"xmlns:xsi": XSI_NS, "xmlns:i": XSI_NS, key: flag},
                            "^value^": entry.value}, True));
                }
            }
            XsdXmlValue output = model.serializeXmlValue("", "value",
                {"^attributes^": {}, "^value^": entry.value, "^comment^": "kept"});
            assertTrue(output.getXml() =~ /<!--kept-->/);
            assertEq(entry.lexical ?? string(entry.value), text(output));
            assertThrows("SOAP-SERIALIZATION-ERROR", \model.serializeXmlValue(),
                ("", "value", {"^attributes^": {}, "child": "unexpected"}));
        }
        XsdSchema text = schema('<xs:element name="value" nillable="true"><xs:simpleType><xs:restriction base="xs:string">'
            '<xs:maxLength value="3"/></xs:restriction></xs:simpleType></xs:element>');
        assertEq("", self.text(text.serializeXmlValue("", "value", {"^attributes^": {}})));
        foreach hash<auto> input in ({}, {"^comment^": "empty"}, {"^attributes^": {"nil": False}},
                {"^attributes^": {"xsi:nil": "false"}, "^comment^": "empty"}) {
            assertEq("", self.text(text.serializeXmlValue("", "value", input)));
        }
        assertEq("abc", self.text(text.serializeXmlValue("", "value", {"^attributes^": {}, "^value^": "a",
            "^cdata^": "b", "^value1^": "c"})));
        assertThrows("SOAP-SERIALIZATION-ERROR", \text.serializeXmlValue(),
            ("", "value", {"^attributes^": {}, "^value^": "long"}));
    }
    private qnames() {
        foreach string declaration in ('<xs:element name="value" type="xs:QName"/>',
                '<xs:element name="value"><xs:simpleType><xs:restriction base="xs:QName"/>'
                '</xs:simpleType></xs:element>') {
            XsdSchema model = schema(declaration);
            hash<auto> input = {"^attributes^": {"xmlns:p": "urn:products"}, "^value^": "p:Category",
                "^comment^": "kept"};
            XsdXmlValue output = model.serializeXmlValue("", "value", input);
            assertTrue(output.getXml() =~ /<!--kept-->/);
            auto parsed = parse_xml(output.getXml()).value;
            assertEq("p:Category", parsed."^value^");
            assertEq("urn:products", parsed."^attributes^"."xmlns:p");
            input."^attributes^".foo = "bar";
            assertThrows("SOAP-SERIALIZATION-ERROR", \model.serializeXmlValue(), ("", "value", input));
        }
    }
    private constraints() {
        XsdSchema fixed = schema('<xs:element name="value" type="xs:int" nillable="true" fixed="5"/>');
        foreach string key in ("nil", "xsi:nil") {
            assertThrows("SOAP-SERIALIZATION-ERROR", \fixed.serializeXmlValue(),
                ("", "value", {"^attributes^": {key: True}}));
            assertEq("5", text(fixed.serializeXmlValue("", "value",
                {"^attributes^": {key: False}, "^value^": 5})));
            assertThrows("SOAP-SERIALIZATION-ERROR", \fixed.serializeXmlValue(),
                ("", "value", {"^attributes^": {key: False}, "^value^": 6}));
        }
        assertThrows("SOAP-SERIALIZATION-ERROR", \fixed.serializeXmlValue(), ("", "value", new XsdNilValue()));
        XsdSchema model = schema('<xs:element name="value" nillable="true"><xs:complexType>'
            '<xs:attribute name="tag" type="xs:int" use="required"/>'
            '<xs:attribute name="version" type="xs:int" fixed="1"/>'
            '<xs:anyAttribute namespace="urn:other" processContents="skip"/>'
            '</xs:complexType></xs:element>');
        foreach hash<auto> attrs in ({"tag": 17}, {"tag": "bad"}, {"tag": 17, "version": 2},
                {"tag": 17, "{urn:other}label": "x"}, {"tag": 17, "bad:name": "x"}) {
            hash<auto> input = {"^attributes^": attrs + {"xsi:nil": True}};
            hash<auto> before = input;
            hash<auto> namespaces = model.nsc.getOutputNamespaceHash(NOTHING);
            if (attrs.tag == "bad" || attrs.version == 2 || attrs.hasKey("bad:name")) {
                assertThrows("SOAP-SERIALIZATION-ERROR", \model.serializeXmlValue(), ("", "value", input));
            } else {
                XsdXmlValue output = model.serializeXmlValue("", "value", input);
                hash<auto> wire = XsdBase::getExpandedAttributes(parse_xml(output.getXml()).value."^attributes^");
                assertEq("17", wire{"{}tag"});
                assertEq("1", wire{"{}version"});
                assertEq("true", wire{"{" + XSI_NS + "}nil"});
                if (attrs.hasKey("{urn:other}label")) {
                    assertEq("x", wire{"{urn:other}label"});
                }
            }
            assertEq(before, input);
            assertEq(namespaces, model.nsc.getOutputNamespaceHash(NOTHING));
        }
        foreach auto content in ("", " ", 0, False, {}, ()) {
            assertThrows("SOAP-SERIALIZATION-ERROR", \model.serializeXmlValue(), ("", "value",
                {"^attributes^": {"xsi:nil": True, "tag": 17}, "^value^": content}));
        }
        assertThrows("SOAP-SERIALIZATION-ERROR", \model.serializeXmlValue(), ("", "value",
            {"^attributes^": {"xsi:nil": True, "nil": True, "tag": 17}}));
        foreach AbstractDataProviderType provider in (model.getElement("", "value").getDataProviderType(),
                model.getNativeDataProviderType("", "value")) {
            assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(),
                ({"^attributes^": {"xsi:nil": True, "tag": 17}},));
            assertEq(17, cast<XsdNilValue>(provider.acceptsValue(new XsdNilValue({"tag": 17}))).getAttributes().tag);
        }
    }
    private declared() {
        XsdSchema model = new XsdSchema('<xs:schema xmlns:xs="' + XSD_NS
            + '" xmlns:t="urn:nil" targetNamespace="urn:nil">'
            '<xs:attribute name="nil" type="xs:string"/>'
            '<xs:complexType name="Qualified"><xs:attribute ref="t:nil"/></xs:complexType>'
            '<xs:complexType name="Derived"><xs:complexContent><xs:extension base="t:Qualified"/>'
            '</xs:complexContent></xs:complexType>'
            '<xs:complexType name="Collision"><xs:attribute name="nil" type="xs:string"/>'
            '<xs:attribute ref="t:nil"/></xs:complexType>'
            '<xs:element name="value" type="t:Qualified" nillable="true"/>'
            '<xs:element name="collision" type="t:Collision" nillable="true"/>'
            '<xs:element name="selected" type="xs:anyType" nillable="true"/>'
            '</xs:schema>', {"async_only": True});
        foreach auto input in ({"^attributes^": {"nil": "ordinary"}},
                {"^type^": new XsdQNameValue("urn:nil", "Derived"),
                    "^val^": {"^attributes^": {"nil": "ordinary"}}}) {
            XsdXmlValue output = model.serializeXmlValue("urn:nil", "value", input);
            hash<auto> attributes = XsdBase::getExpandedAttributes(parse_xml(output.getXml()).firstValue()."^attributes^");
            assertEq("ordinary", attributes{"{urn:nil}nil"});
            assertFalse(attributes.hasKey("{" + XSI_NS + "}nil"));
        }
        # Colliding local names are keyed by expanded names, but still prevent the unqualified nil alias.
        assertThrows("SOAP-SERIALIZATION-ERROR", \model.serializeXmlValue(),
            ("urn:nil", "collision", {"^attributes^": {"nil": True}}));
        XsdXmlValue output = model.serializeXmlValue("urn:nil", "collision",
            {"^attributes^": {"xsi:nil": True, "{}nil": "local", "{urn:nil}nil": "qualified"}});
        hash<auto> attributes = XsdBase::getExpandedAttributes(parse_xml(output.getXml()).firstValue()."^attributes^");
        assertEq("local", attributes{"{}nil"});
        assertEq("qualified", attributes{"{urn:nil}nil"});
        assertEq("true", attributes{"{" + XSI_NS + "}nil"});
        output = model.serializeXmlValue("urn:nil", "selected", {"^type^": new XsdQNameValue(XSD_NS, "int"),
            "^val^": {"^attributes^": {"nil": True}}});
        attributes = XsdBase::getExpandedAttributes(parse_xml(output.getXml()).firstValue()."^attributes^");
        assertEq("true", attributes{"{" + XSI_NS + "}nil"});
        assertTrue(attributes{"{" + XSI_NS + "}type"}.endsWith(":int"));
    }
}
