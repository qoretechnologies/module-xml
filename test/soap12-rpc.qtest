#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires HttpServer
%requires ../qlib/WSDL.qm
%requires ../qlib/SoapHandler.qm

%exec-class Soap12RpcTest

# The SOAP 1.2 RPC Representation (SOAP 1.2 Part 2 section 4) and Appendix B name mapping.
public class Soap12RpcTest inherits QUnit::Test {
    private {
        const Contract = '<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"
            xmlns:soap12="http://schemas.xmlsoap.org/wsdl/soap12/" xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns:tns="urn:rpc" targetNamespace="urn:rpc">
          <message name="statsRequest"><part name="x" type="xsd:int"/></message>
          <message name="statsResponse"><part name="count" type="xsd:int"/><part name="value" type="xsd:string"/></message>
          <message name="pairRequest"/>
          <message name="pairResponse"><part name="a" type="xsd:int"/><part name="b" type="xsd:int"/></message>
          <message name="singleRequest"><part name="question" type="xsd:string"/></message>
          <message name="singleResponse"><part name="answer" type="xsd:string"/></message>
          <message name="voidRequest"/>
          <message name="voidResponse"/>
          <message name="adjustRequest"><part name="n" type="xsd:int"/></message>
          <message name="adjustResponse"><part name="n" type="xsd:int"/><part name="note" type="xsd:string"/></message>
          <portType name="P">
            <operation name="stats" parameterOrder="x count"><input message="tns:statsRequest"/>
              <output message="tns:statsResponse"/></operation>
            <operation name="pair"><input message="tns:pairRequest"/><output message="tns:pairResponse"/></operation>
            <operation name="single"><input message="tns:singleRequest"/><output message="tns:singleResponse"/></operation>
            <operation name="void"><input message="tns:voidRequest"/><output message="tns:voidResponse"/></operation>
            <!-- n is an [in/out] parameter: it is a part of both messages -->
            <operation name="adjust" parameterOrder="n"><input message="tns:adjustRequest"/>
              <output message="tns:adjustResponse"/></operation>
          </portType>
          <binding name="B" type="tns:P"><soap12:binding style="rpc" transport="http://schemas.xmlsoap.org/soap/http"/>
            %s
          </binding>
          <service name="S"><port name="P" binding="tns:B"><soap12:address location="http://example.invalid/rpc"/></port></service>
        </definitions>';
        const Operation = '<operation name="%s"><soap12:operation soapAction="urn:rpc#%s"/><input><soap12:body %s/></input>
            <output><soap12:body %s/></output></operation>';
        const Encoded = 'use="encoded" namespace="urn:rpc" encodingStyle="http://www.w3.org/2003/05/soap-encoding"';
        const Literal = 'use="literal" namespace="urn:rpc"';
        const Envelope = '<env:Envelope xmlns:env="http://www.w3.org/2003/05/soap-envelope" '
            'xmlns:rpc="http://www.w3.org/2003/05/soap-rpc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" '
            'xmlns:t="urn:rpc"><env:Body><t:%s env:encodingStyle="http://www.w3.org/2003/05/soap-encoding">%s</t:%s>%s'
            '</env:Body></env:Envelope>';
    }

    constructor() : QUnit::Test("SOAP 1.2 RPC Representation", "1.0") {
        addTestCase("the return value is the output part that parameterOrder omits, or return, or a single part",
            \returnParts());
        addTestCase("non-void responses name their return value in rpc:result", \results());
        addTestCase("rpc:result selects the return value's edge when decoding", \decodeResults());
        addTestCase("with SOAP Encoding the RPC struct is the only Body child", \oneChild());
        addTestCase("RPC faults carry the rpc subcodes", \faults());
        addTestCase("the name of the response struct is not significant", \responseStructName());
        addTestCase("argument count and type mismatches fault with rpc:BadArguments", \argumentMismatches());
        addTestCase("header blocks accompany an RPC invocation and response", \headerBlocks());
        addTestCase("an [in/out] parameter is an edge of both the invocation and the response", \inOutParameters());
        addTestCase("encoded parameters without a node are NOTHING in both directions", \nilParameters());
        addTestCase("Appendix B maps application names to XML names and back", \nameMapping());
        set_return_value(main());
    }

    private static WebService service(string use = Encoded) {
        string operations;
        foreach string name in ("stats", "pair", "single", "void", "adjust") {
            operations += sprintf(Operation, name, name, use, use);
        }
        return new WebService(sprintf(Contract, operations));
    }

    private static string response(string operation, string content, string extra = "") {
        return sprintf(Envelope, operation + "Response", content, operation + "Response", extra);
    }

    private static string request(string operation, string content, string extra = "") {
        return sprintf(Envelope, operation, content, operation, extra);
    }

    returnParts() {
        WebService ws = service();
        assertEq("value", ws.getOperation("stats").getReturnPartName());
        assertEq(NOTHING, ws.getOperation("pair").getReturnPartName());
        assertEq("answer", ws.getOperation("single").getReturnPartName());
        assertEq(NOTHING, ws.getOperation("void").getReturnPartName());
        # parameterOrder naming every output part leaves no return value; an unnamed "return" part is chosen
        WebService listed(replace(replace(sprintf(Contract, ""), 'parameterOrder="x count"',
            'parameterOrder="x count value"'), '<part name="a" type="xsd:int"/>', '<part name="return" type="xsd:int"/>'));
        assertEq(NOTHING, listed.getOperation("stats").getReturnPartName());
        assertEq("return", listed.getOperation("pair").getReturnPartName());
        # the retained order survives serialization
        WebService saved = Serializable::deserialize(ws.serialize());
        assertEq("value", saved.getOperation("stats").getReturnPartName());
    }

    results() {
        WebService ws = service();
        string body = ws.getOperation("stats").serializeResponse({"count": 2, "value": "v"}, NOTHING, NOTHING, NOTHING,
            True).body;
        assertRegex('<[a-z0-9]+:statsResponse[^>]*><rpc:result>value</rpc:result><count', body);
        assertRegex('xmlns:rpc="http://www.w3.org/2003/05/soap-rpc"', body);
        # a void response, and one whose parts are all out parameters, name no return value
        assertNRegex("rpc:result", ws.getOperation("pair").serializeResponse({"a": 1, "b": 2}, NOTHING, NOTHING,
            NOTHING, True).body);
        assertNRegex("rpc:result", ws.getOperation("void").serializeResponse(NOTHING, NOTHING, NOTHING, NOTHING,
            True).body);
        # a return value that is not sent is not named
        assertNRegex("rpc:result", ws.getOperation("stats").serializeResponse({"count": 2}, NOTHING, NOTHING, NOTHING,
            True).body);
        # rpc/literal is not the SOAP data model: no rpc:result
        WebService literal = service(Literal);
        assertNRegex("rpc:result", literal.getOperation("single").serializeResponse({"answer": "a"}, NOTHING,
            NOTHING, NOTHING, True).body);
        assertFalse(cast<SoapBinding>(literal.getOperation("single").getBinding("B")).usesSoap12RpcRepresentation());
        assertTrue(cast<SoapBinding>(ws.getOperation("single").getBinding("B")).usesSoap12RpcRepresentation());
        # round trip
        assertEq({"count": 2, "value": "v"}, ws.getOperation("stats").deserializeResponse(parse_xml(body,
            XPF_PRESERVE_ORDER)));
    }

    decodeResults() {
        WebService ws = service();
        WSOperation single = ws.getOperation("single");
        # the edge rpc:result names is the return value, whatever its name
        assertEq("a", single.deserializeResponse(parse_xml(response("single",
            '<rpc:result>result</rpc:result><result>a</result>'), XPF_PRESERVE_ORDER)));
        assertEq("a", single.deserializeResponse(parse_xml(response("single",
            '<rpc:result>t:ret</rpc:result><t:ret>a</t:ret>'), XPF_PRESERVE_ORDER)));
        # without rpc:result, the part name identifies the value
        assertEq("a", single.deserializeResponse(parse_xml(response("single", '<answer>a</answer>'), XPF_PRESERVE_ORDER)));
        assertThrows("SOAP-DESERIALIZATION-ERROR", "rpc:result names \\{\\}missing, which is not an edge",
            \single.deserializeResponse(), (parse_xml(response("single", '<rpc:result>missing</rpc:result>'
                '<answer>a</answer>'), XPF_PRESERVE_ORDER),));
        assertThrows("SOAP-DESERIALIZATION-ERROR", "more than one rpc:result", \single.deserializeResponse(),
            (parse_xml(response("single", '<rpc:result>answer</rpc:result><rpc:result>answer</rpc:result>'
                '<answer>a</answer>'), XPF_PRESERVE_ORDER),));
        assertThrows("SOAP-DESERIALIZATION-ERROR", "the response also carries the return part",
            \single.deserializeResponse(), (parse_xml(response("single", '<rpc:result>other</rpc:result>'
                '<other>a</other><answer>b</answer>'), XPF_PRESERVE_ORDER),));
        assertThrows("SOAP-DESERIALIZATION-ERROR", "operation \"pair\" returns none",
            \ws.getOperation("pair").deserializeResponse(), (parse_xml(response("pair", '<rpc:result>a</rpc:result>'
                '<a>1</a><b>2</b>'), XPF_PRESERVE_ORDER),));
    }

    oneChild() {
        WebService ws = service();
        assertThrows("SOAP-DESERIALIZATION-ERROR", "only Body child", \ws.getOperation("single").deserializeRequest(),
            (parse_xml(request("single", '<question>q</question>', '<t:extra/>'), XPF_PRESERVE_ORDER),));
        assertThrows("SOAP-DESERIALIZATION-ERROR", "only Body child", \ws.getOperation("single").deserializeResponse(),
            (parse_xml(response("single", '<answer>a</answer>', '<t:extra/>'), XPF_PRESERVE_ORDER),));
        assertEq("q", ws.getOperation("single").deserializeRequest(parse_xml(request("single", '<question>q</question>'),
            XPF_PRESERVE_ORDER)));
    }

    private static *list<string> subcodes(code c) {
        try {
            c();
        } catch (hash<ExceptionInfo> ex) {
            return ex.arg instanceof hash<SoapFaultOptions>
                ? map sprintf("{%s}%s", $1.getNamespaceUri(), $1.getLocalName()), ex.arg.subcodes : ();
        }
    }

    faults() {
        WebService ws = service();
        WSOperation stats = ws.getOperation("stats");
        assertEq(("{http://www.w3.org/2003/05/soap-rpc}BadArguments",), subcodes(sub () {
            stats.deserializeRequest(parse_xml(request("stats", '<x>abc</x>'), XPF_PRESERVE_ORDER));
        }));
        # a more specific encoding subcode is kept
        assertEq(("{http://www.w3.org/2003/05/soap-encoding}MissingID",), subcodes(sub () {
            stats.deserializeRequest(parse_xml(request("stats", '<x xmlns:enc="http://www.w3.org/2003/05/soap-encoding" '
                'enc:ref="none"/>'), XPF_PRESERVE_ORDER));
        }));
        # rpc/literal is not the RPC Representation
        assertEq((), subcodes(sub () {
            service(Literal).getOperation("stats").deserializeRequest(parse_xml(request("stats", '<x>abc</x>'),
                XPF_PRESERVE_ORDER));
        }));
        # handlers answer an unknown procedure with rpc:ProcedureNotPresent when they serve the RPC Representation
        foreach list<auto> row in ((Encoded, ("{http://www.w3.org/2003/05/soap-rpc}ProcedureNotPresent",)), (Literal, ())) {
            WebService definition = service(row[0]);
            SoapHandler handler(new PermissiveAuthenticator());
            handler.addMethod(definition, definition.getOperation("single"), auto sub(hash<auto> cx, auto value) {
                return {"answer": value};
            });
            HttpServer server(); on_exit server.stop();
            server.setDefaultHandler("rpc", handler);
            int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
            HTTPClient client({"url": sprintf("http://127.0.0.1:%d/rpc", port), "error_passthru": True});
            hash<auto> info;
            string reply = client.post("", request("absent", ""), {"Content-Type": "application/soap+xml"}, \info);
            assertEq(400, info."response-headers".status_code);
            hash<SoapFaultInfo> fault = WSDLLib::getSOAPFaultInfo(reply, True);
            assertEq("Sender", fault.code.getLocalName());
            assertEq(row[1], map sprintf("{%s}%s", $1.getNamespaceUri(), $1.getLocalName()), fault.subcodes);
        }
    }

    # SOAP 1.2 Part 2 section 4.2.2: the response struct's name is not significant; section 4.2.1 names the
    # invocation struct after the procedure
    responseStructName() {
        WebService ws = service();
        WSOperation single = ws.getOperation("single");
        WSOperation stats = ws.getOperation("stats");
        foreach string name in ("singleResponse", "reply") {
            string xml = sprintf(Envelope, name, '<rpc:result>answer</rpc:result><answer>a</answer>', name, "");
            assertEq("a", single.deserializeResponse(parse_xml(xml, XPF_PRESERVE_ORDER)), name);
            # in another namespace as well
            xml = replace(replace(xml, '<t:' + name, '<o:' + name + ' xmlns:o="urn:elsewhere"'), '</t:' + name,
                '</o:' + name);
            assertEq("a", single.deserializeResponse(parse_xml(xml, XPF_PRESERVE_ORDER)), name);
        }
        assertEq({"count": 2, "value": "v"}, stats.deserializeResponse(parse_xml(sprintf(Envelope, "result",
            '<rpc:result>value</rpc:result><count>2</count><value>v</value>', "result", ""), XPF_PRESERVE_ORDER)));
        # the invocation struct is named after the procedure
        assertThrows("SOAP-DESERIALIZATION-ERROR", "expected SOAP RPC wrapper", \single.deserializeRequest(),
            (parse_xml(sprintf(Envelope, "reply", '<question>q</question>', "reply", ""), XPF_PRESERVE_ORDER),));
    }

    # SOAP 1.2 Part 2 section 4.4: an invocation whose arguments do not match the procedure in number or type faults
    # with env:Sender and rpc:BadArguments
    argumentMismatches() {
        WebService ws = service();
        WSOperation stats = ws.getOperation("stats");
        list<string> bad = ("{http://www.w3.org/2003/05/soap-rpc}BadArguments",);
        # an argument the procedure does not have
        assertEq(bad, subcodes(sub () {
            stats.deserializeRequest(parse_xml(request("stats", '<x>1</x><y>2</y>'), XPF_PRESERVE_ORDER));
        }));
        # an argument supplied twice
        assertEq(bad, subcodes(sub () {
            stats.deserializeRequest(parse_xml(request("stats", '<x>1</x><x>2</x>'), XPF_PRESERVE_ORDER));
        }));
        # an argument of another type
        assertEq(bad, subcodes(sub () {
            stats.deserializeRequest(parse_xml(request("stats", '<x xmlns:xsd="http://www.w3.org/2001/XMLSchema" '
                'xsi:type="xsd:boolean">true</x>'), XPF_PRESERVE_ORDER));
        }));
        # the matching invocation is accepted
        assertEq(1, stats.deserializeRequest(parse_xml(request("stats", '<x>1</x>'), XPF_PRESERVE_ORDER)));
    }

    # SOAP 1.2 Part 2 section 4.3: additional information travels as header blocks, beside the RPC struct
    headerBlocks() {
        string contract = sprintf(Contract, sprintf(Operation, "single", "single", Encoded, Encoded));
        contract = replace(contract, '<message name="voidRequest"/>', '<message name="voidRequest"/>'
            '<message name="Audit"><part name="token" type="xsd:string"/></message>');
        string header = '<soap12:header message="tns:Audit" part="token" use="encoded" namespace="urn:audit" '
            'encodingStyle="http://www.w3.org/2003/05/soap-encoding"/>';
        contract = replace(contract, '<input><soap12:body', '<input>' + header + '<soap12:body');
        contract = replace(contract, '<output><soap12:body', '<output>' + header + '<soap12:body');
        # the contract binds only "single"; the other operations stay unbound
        WebService ws(contract);
        WSOperation single = ws.getOperation("single");
        assertTrue(cast<SoapBinding>(single.getBinding()).usesSoap12RpcRepresentation());
        foreach bool request in (True, False) {
            hash<auto> wire = request
                ? single.serializeRequest({"question": "q"}, {"Audit": {"token": "t-1"}})
                : single.serializeResponse({"answer": "a"}, {"Audit": {"token": "t-2"}});
            hash<auto> envelope = XsdBase::expandElementNamespaces(parse_xml(wire.body))
                ."{http://www.w3.org/2003/05/soap-envelope}Envelope";
            # the Body holds only the RPC struct, and the header block is in the Header
            assertEq(1, (select keys envelope."{http://www.w3.org/2003/05/soap-envelope}Body", $1 !~ /^\^/).size());
            assertEq(request ? "t-1" : "t-2", envelope."{http://www.w3.org/2003/05/soap-envelope}Header"
                ."{urn:audit}token"."^value^");
            auto value = request ? single.deserializeRequest(parse_xml(wire.body, XPF_PRESERVE_ORDER))
                : single.deserializeResponse(parse_xml(wire.body, XPF_PRESERVE_ORDER));
            assertEq(request ? {"question": "q", "Audit": {"token": "t-1"}} : {"answer": "a", "Audit":
                {"token": "t-2"}}, value);
        }
    }

    # SOAP 1.2 Part 2 sections 4.2.1 and 4.2.2: the invocation has an edge for each [in] and [in/out] parameter, the
    # response one for the return value and each [out] and [in/out] parameter, each labeled with the parameter's name
    inOutParameters() {
        WebService ws = service();
        WSOperation adjust = ws.getOperation("adjust");
        hash<auto> request = parse_xml(adjust.serializeRequest({"n": 1}).body, XPF_PRESERVE_ORDER);
        hash<auto> body = request.firstValue()."env:Body" ?? request.firstValue()."soapenv:Body";
        assertEq(("n",), select keys body.firstValue(), $1 !~ /^\^/);
        assertEq(1, adjust.deserializeRequest(request));
        # "note" is the return value: it is the output part that parameterOrder omits
        string response_xml = adjust.serializeResponse({"n": 2, "note": "done"}).body;
        assertRegex("<rpc:result[^>]*>note</rpc:result>", response_xml);
        assertEq({"n": 2, "note": "done"}, adjust.deserializeResponse(parse_xml(response_xml, XPF_PRESERVE_ORDER)));
        assertEq({"n": 3, "note": "x"}, adjust.deserializeResponse(parse_xml(response("adjust",
            '<rpc:result>note</rpc:result><n>3</n><note>x</note>'), XPF_PRESERVE_ORDER)));
    }

    nilParameters() {
        WebService ws = service();
        WSOperation single = ws.getOperation("single");
        assertEq(NOTHING, single.deserializeRequest(parse_xml(request("single", '<question xsi:nil="true"/>'),
            XPF_PRESERVE_ORDER)));
        assertEq(NOTHING, single.deserializeRequest(parse_xml(request("single", ''), XPF_PRESERVE_ORDER)));
        # an empty string stays a value
        assertEq("", single.deserializeRequest(parse_xml(request("single", '<question/>'), XPF_PRESERVE_ORDER)));
        string body = single.serializeRequest({"question": NOTHING}).body;
        assertRegex('<question xsi:nil="true"/>', body);
        assertEq(NOTHING, single.deserializeRequest(parse_xml(body, XPF_PRESERVE_ORDER)));
        # SOAP 1.1 encoding reads and writes the same way
        WebService note(ReadOnlyFile::readTextFile(get_script_dir() + "/wsdl-interop/encoded-corpus/soap11-note.wsdl"));
        WSOperation cost = note.getOperation("costTyped");
        body = cost.serializeRequest({"cost": NOTHING}).body;
        assertRegex('<cost xsi:nil="true"/>', body);
        assertEq(NOTHING, cost.deserializeRequest(parse_xml(body, XPF_PRESERVE_ORDER)));
    }

    nameMapping() {
        # SOAP 1.2 Part 2 Appendix B.2
        hash<string, string> examples = {
            "Hello world": "Hello_x0020_world", "Hello_xorld": "Hello_x005F_xorld", "Helloworld_": "Helloworld_",
            "x": "x", "xml": "_x0078_ml", "-xml": "_x002D_xml", "x-ml": "x-ml", "Ælfred": "Ælfred",
            "άγνωστος": "άγνωστος", "ᜉᜅᜎᜈ": "_x1709__x1705__x170E__x1708_", "ᏙᏚᎥ": "_x13D9__x13DA__x13A5_",
        };
        foreach hash<auto> example in (examples.pairIterator()) {
            assertEq(example.value, WSDLLib::toXmlName(example.key), example.key);
            assertEq(example.key, WSDLLib::fromXmlName(example.value), example.value);
        }
        # capitalized "xml", characters beyond the Basic Multilingual Plane and a leading digit
        assertEq("_x0058_ML", WSDLLib::toXmlName("XML"));
        assertEq("a_x01F600_", WSDLLib::toXmlName("a😀"));
        assertEq("_x0031_a", WSDLLib::toXmlName("1a"));
        assertEq("", WSDLLib::toXmlName(""));
        # only upper-case four- or six-digit escapes are escapes
        assertEq("_x00e9_", WSDLLib::fromXmlName("_x00e9_"));
        assertEq("_x12_", WSDLLib::fromXmlName("_x12_"));
        assertEq("a_x", WSDLLib::fromXmlName("a_x"));
        foreach string name in ("a b", "_x", "xmlns", "Straße", "a😀b", "中文", "1", "-") {
            assertEq(name, WSDLLib::fromXmlName(WSDLLib::toXmlName(name)), name);
        }
    }
}
