#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%exec-class XmlQNameUnionTest

class XmlQNameUnionTest inherits QUnit::Test {
    constructor() : QUnit::Test("Native QName union validation", "1.0") {
        addTestCase("An unbound QName candidate allows a later string member", \fallback());
        addTestCase("Enumeration preserves the first matching primitive family", \enumeration());
        addTestCase("Nested unions and lists isolate rejected QName candidates", \collections());
        addTestCase("Invalid content and attributes still reject with schema errors", \rejection());
        addTestCase("Cancellation and rejected documents leave later reads usable", \recovery());
        set_return_value(main());
    }

    private static string schema(string definition, string declarations = "") {
        return '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">' + declarations
            + '<xs:simpleType name="Value">' + definition + '</xs:simpleType>'
            '<xs:element name="value"><xs:complexType><xs:simpleContent><xs:extension base="Value">'
            '<xs:attribute name="category" type="Value" use="required"/>'
            '</xs:extension></xs:simpleContent></xs:complexType></xs:element></xs:schema>';
    }

    private static string document(string lexical, string bindings = "") {
        return '<value category="' + lexical + '"' + bindings + '>' + lexical + '</value>';
    }

    private accepted(string xsd, string xml) {
        hash<auto> expected = parse_xml(xml);
        assertEq(expected, parse_xml_with_schema(xml, xsd));
        XmlReader reader(new StringInputStream(xml), {"xsd": xsd});
        assertTrue(reader.read());
        assertEq("value", reader.name());
        assertEq(expected.value."^attributes^".category, reader.getAttribute("category"));
        string text = "";
        while (reader.read()) {
            if (reader.nodeType() == XML_NODE_TYPE_TEXT) {
                text += reader.value();
            }
        }
        assertEq(string(expected.value."^value^"), text);
        assertTrue(reader.isValid());
    }

    private static nothing consume(string xsd, string xml) {
        XmlReader reader(new StringInputStream(xml), {"xsd": xsd});
        while (reader.read()) {
        }
    }

    private rejected(string xsd, string xml) {
        assertThrows("PARSE-XML-EXCEPTION", \parse_xml_with_schema(), (xml, xsd));
        assertThrows("PARSE-XML-EXCEPTION", \consume(), (xsd, xml));
    }

    fallback() {
        foreach string members in ("xs:QName xs:string", "xs:string xs:QName") {
            string xsd = schema('<xs:union memberTypes="' + members + '"/>');
            foreach string text in ("p:Name", "p:Name:Bad", "17", "", "xml:lang", "Name") {
                accepted(xsd, document(text));
                accepted(xsd, document(text, ' xmlns:p="urn:catalog"'));
            }
        }
    }

    enumeration() {
        string base = '<xs:simpleType name="Either"><xs:union memberTypes="xs:QName xs:string"/></xs:simpleType>';
        string strings = schema('<xs:restriction base="Either"><xs:enumeration value="p:Name"/></xs:restriction>', base);
        string qnames = schema('<xs:restriction base="Either"><xs:enumeration xmlns:c="urn:catalog" value="c:Name"/>'
            '</xs:restriction>', base);
        accepted(strings, document("p:Name"));
        rejected(strings, document("p:Name", ' xmlns:p="urn:catalog"'));
        accepted(qnames, document("p:Name", ' xmlns:p="urn:catalog"'));
        accepted(qnames, document("c:Name", ' xmlns:c="urn:catalog"'));
        rejected(qnames, document("p:Name"));
        rejected(qnames, document("p:Name", ' xmlns:p="urn:other"'));
        accepted(strings, document("p:Name"));
    }

    collections() {
        string declarations = '<xs:simpleType name="QNameInt"><xs:union memberTypes="xs:QName xs:int"/></xs:simpleType>'
            '<xs:simpleType name="QNameString"><xs:union memberTypes="xs:QName xs:string"/></xs:simpleType>'
            '<xs:simpleType name="QNames"><xs:list itemType="xs:QName"/></xs:simpleType>';
        foreach string definition in ('<xs:union memberTypes="QNameInt xs:string"/>',
                '<xs:union memberTypes="QNames xs:string"/>', '<xs:list itemType="QNameString"/>') {
            string xsd = schema(definition, declarations);
            foreach string text in ("p:Name", "p:Name 17", "17 p:Name", "", "p:Name q:Other") {
                accepted(xsd, document(text));
            }
        }
        string ints = schema('<xs:list itemType="QNameInt"/>', declarations);
        rejected(ints, document("17 p:Name"));
        accepted(ints, document("17 p:Name", ' xmlns:p="urn:catalog"'));
    }

    rejection() {
        foreach string definition in ('<xs:restriction base="xs:QName"/>', '<xs:union memberTypes="xs:QName xs:int"/>') {
            string xsd = schema(definition);
            foreach string xml in (document("p:Name"), '<value category="xml:lang">p:Name</value>',
                    '<value category="p:Name">xml:lang</value>', document("a:b:c")) {
                rejected(xsd, xml);
                accepted(xsd, document("xml:lang"));
            }
        }
    }

    recovery() {
        string xsd = schema('<xs:union memberTypes="xs:QName xs:string"/>');
        rejected(xsd, '<value>p:Name</value>');
        accepted(xsd, document("p:Name"));
        SandboxManager manager();
        on_exit {
            manager.clearInterrupt();
        }
        Program program(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
        program.setSandboxManager(manager);
        program.parse("%modern\n%requires xml\n"
            "nothing sub interrupted(SandboxManager manager, string xsd, string xml) {\n"
            "    XmlReader reader(new StringInputStream(xml), {\"xsd\": xsd});\n"
            "    manager.requestInterrupt();\n"
            "    while (reader.read()) {}\n"
            "}\n", "qname_union_cancel");
        *hash<ExceptionInfo> error;
        try {
            program.callFunction("interrupted", manager, xsd, document("p:Name"));
        } catch (hash<ExceptionInfo> ex) {
            error = ex;
        }
        manager.clearInterrupt();
        assertEq("PROGRAM-INTERRUPTED", error.err);
        accepted(xsd, document("p:Name"));
    }
}
