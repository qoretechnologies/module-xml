#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires ../../../qlib/WSDL.qm
%requires ../../../qlib/SoapHandler.qm
%requires HttpServer
@assert(ARGV.size() == 4);
string version = ARGV[0];
WebService ws(ReadOnlyFile::readTextFile(get_script_dir() + "/../soap-envelope-peer/contract.wsdl"));
if (ARGV[1] == "saved") { ws = Serializable::deserialize(ws.serialize()); }
if (ARGV[1] == "data") { ws = Serializable::deserialize(ws.serializeToData()); }
bool retained = ARGV[2] == "retained";
Queue headers(); Queue calls();
SoapProcessingNode node(<SoapNodeOptions>{"processors":{"{urn:headers}Track":
    auto sub(hash<auto> cx, hash<SoapNodeHeader> header) { headers.push(header.name); }}});
SoapHandler handler(new PermissiveAuthenticator(), NOTHING, False, NOTHING, node);
handler.addMethod(ws, ws.getBindingOperation("B"+version,"echo"), auto sub(hash<auto> cx, auto value) {
    calls.push(cx.operation.name);
    return {"body":retained ? new XsdXmlValue('<t:value xmlns:t="urn:soap-envelope-test">response</t:value>') : "response"};
}, NOTHING, NOTHING, NOTHING, "service", NOTHING, NOTHING, "B"+version, "echo", retained);
HttpServer server(); on_exit server.stop();
server.setDefaultHandler("http-binding",handler); server.addListener(0);
printf("READY\t%d\n",server.getListenerInfo(0).port);
@assert(trim(stdin.readLine() ?? "") == "STOP");
server.stop();
@assert(calls.size() == int(ARGV[3]));
@assert(headers.size() == calls.size());
