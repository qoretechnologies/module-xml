#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "type substitution integration requires json";
%else
if (ARGV.size() != 1) {
    throw "USAGE", "type-substitution.qr CASES.json";
}
foreach hash<auto> input in (parse_json(ReadOnlyFile::readTextFile(ARGV[0]))) {
    WebService original(input.wsdl, {"async_only": True});
    foreach bool copy in (False, True) {
        WebService ws = copy ? Serializable::deserialize(original.serialize()) : original;
        WSOperation op = ws.getBindingOperation(input.binding, "submit");
        foreach bool response in (False, True) {
            hash<auto> row = {"case": input.name, "copy": copy, "response": response,
                "decode_error": "", "encode_error": "", "retained_error": ""};
            string xml = response ? input.response : input.request;
            try {
                row.native = response ? op.deserializeResponse(parse_xml(xml, XPF_PRESERVE_ORDER), input.binding)
                    : op.deserializeRequest(parse_xml(xml, XPF_PRESERVE_ORDER), input.binding);
            } catch (hash<ExceptionInfo> error) {
                if (error.err == "THREAD-CANCELLED" || error.err == "PROGRAM-INTERRUPTED") {
                    rethrow;
                }
                row.decode_error = error.err;
                row.decode_description = error.desc;
            }
            try {
                XsdAbstractType selected = input.selected.startsWith("xs:")
                    ? ws.nsc.getBaseType(input.selected.substr(3)) : ws.findType(input.selected.substr(2));
                hash<auto> data = {"body": {"item": {"^type^": selected, "^val^": input.value}}};
                row.xml = (response ? op.serializeResponse(data, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING,
                    input.binding) : op.serializeRequest(data, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING,
                    input.binding)).body;
                row.encoded_native = response ? op.deserializeResponse(parse_xml(row.xml, XPF_PRESERVE_ORDER), input.binding)
                    : op.deserializeRequest(parse_xml(row.xml, XPF_PRESERVE_ORDER), input.binding);
            } catch (hash<ExceptionInfo> error) {
                if (error.err == "THREAD-CANCELLED" || error.err == "PROGRAM-INTERRUPTED") {
                    rethrow;
                }
                row.encode_error = error.err;
                row.encode_description = error.desc;
            }
            try {
                hash<SoapXmlMessageInfo> retained = response ? op.deserializeXmlResponse(xml, input.binding)
                    : op.deserializeXmlRequest(xml, input.binding);
                row.retained = (response ? op.serializeResponse(retained.body, NOTHING, NOTHING, NOTHING,
                    NOTHING, NOTHING, input.binding) : op.serializeRequest(retained.body, NOTHING, NOTHING,
                    NOTHING, NOTHING, NOTHING, input.binding)).body;
            } catch (hash<ExceptionInfo> error) {
                if (error.err == "THREAD-CANCELLED" || error.err == "PROGRAM-INTERRUPTED") {
                    rethrow;
                }
                row.retained_error = error.err;
                row.retained_description = error.desc;
            }
            printf("%s\n", make_json(row));
        }
    }
}
%endif
