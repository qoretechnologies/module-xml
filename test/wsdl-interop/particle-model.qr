#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry

%ifdef NoJson
throw "MISSING-MODULE", "the particle model test requires the json module";
%else
hash<auto> sub describeParticle(XsdParticle node) {
    hash<auto> result = {"kind": node.getKind(), "min": node.getMinOccurs(), "max": node.getMaxOccurs(),
        "children": map describeParticle($1), node.getChildren()};
    if (node.getElement()) {
        result.name = node.getElement().getExpandedName();
        result.type = node.getElement().type.name;
    }
    if (node.getGroupReference()) {
        result.ref = node.getGroupReference();
        result.definition = describeParticle(node.getGroupDefinition());
    }
    return result;
}

if (ARGV.size() != 1) {
    throw "USAGE", "particle-model.qr CASES.json";
}
foreach hash<auto> input in (parse_json(ReadOnlyFile::readTextFile(ARGV[0]))) {
    try {
        WebService original(input.wsdl, {"async_only": True});
        foreach bool copy in (False, True) {
            WebService service = copy ? Serializable::deserialize(original.serialize()) : original;
            WSOperation op = service.getBindingOperation(input.binding, "submit");
            foreach string direction in ("request", "response") {
                WSMessage message = direction == "request" ? op.input : op.output;
                XsdElement element = message.args.firstValue().element;
                XsdComplexType type = cast<XsdComplexType>(element.type);
                printf("%s\n", make_json({"name": input.name, "copy": copy, "direction": direction,
                    "root": element.getExpandedName(), "particle": describeParticle(type.getParticle())}));
            }
        }
    } catch (hash<ExceptionInfo> error) {
        if (error.err == "PROGRAM-INTERRUPTED" || error.err == "THREAD-CANCELLED") {
            rethrow;
        }
        printf("%s\n", make_json({"name": input.name, "err": error.err, "desc": error.desc}));
    }
}
%endif
