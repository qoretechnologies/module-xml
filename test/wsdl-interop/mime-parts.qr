#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
# Reads multipart SOAP messages with WSDLLib::parseMultiPartSOAPMessage(), as SOAP clients and handlers do. Reads a
# JSON list of {"id", "content_type", "body" (base64)} cases and writes one JSON result per case: the root part's
# media type and bytes, the identified parts' bytes by Content-ID, the number of unidentified parts, or the rejection.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "MIME message tests require json";
%else
if (ARGV.size() != 1) {
    throw "USAGE", "mime-parts.qr CASES.json";
}
list<hash<auto>> cases = parse_json(ReadOnlyFile::readTextFile(ARGV[0]));
foreach hash<auto> item in (cases) {
    hash<auto> result();
    result.id = item.id;
    try {
        hash<auto> message = WSDLLib::parseMultiPartSOAPMessage({"content-type": item.content_type,
            "body": parse_base64_string(item.body)});
        result.root_type = message."content-type";
        result.root = make_base64_string(binary(message.body));
        hash<string, string> parts();
        foreach hash<auto> part in (message.parts.pairIterator()) {
            parts{part.key} = make_base64_string(binary(part.value.body));
        }
        result.parts = parts;
        result.unidentified = message.unidentified_parts.size();
    } catch (hash<ExceptionInfo> ex) {
        result.error = ex.err;
        result.desc = ex.desc;
    }
    printf("%s\n", make_json(result));
}
%endif
