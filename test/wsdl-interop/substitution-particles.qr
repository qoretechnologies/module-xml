#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "substitution particle integration requires json";
%else
if (ARGV.size() != 1) {
    throw "USAGE", "substitution-particles.qr CASES.json";
}
sub propagate(hash<ExceptionInfo> ex) {
    if (ex.err == "THREAD-CANCELLED" || ex.err == "PROGRAM-INTERRUPTED") {
        throw ex.err, ex.desc, ex.arg;
    }
}
foreach hash<auto> input in (parse_json(ReadOnlyFile::readTextFile(ARGV[0]))) {
    *WebService original;
    string native_error = "";
    try {
        XmlReader reader("<Container/>");
        reader.schemaValidateString(input.schema);
    } catch (hash<ExceptionInfo> ex) {
        propagate(ex);
        native_error = ex.err;
    }
    try {
        original = new WebService(input.wsdl, {"async_only": True});
    } catch (hash<ExceptionInfo> ex) {
        propagate(ex);
        printf("%s\n", make_json({"name": input.name, "error": ex.err, "native_error": native_error}));
        continue;
    }
    hash<auto> construction = {"name": input.name, "error": "", "native_error": native_error};
    try {
        WSMessageHelper helper(original);
        construction.sample = helper.getXmlMessage(original.messages.Input).body.getXml();
    } catch (hash<ExceptionInfo> ex) {
        propagate(ex);
        construction.sample_error = ex.err;
    }
    printf("%s\n", make_json(construction));
    foreach bool copy in (False, True) {
        WebService ws = copy ? Serializable::deserialize(original.serialize()) : original;
        WSOperation operation = ws.getBindingOperation("Soap", "submit");
        XsdParticle particle = cast<XsdComplexType>(ws.getElement(input.uri, "Container").type).getParticle();
        foreach bool response in (False, True) {
            foreach hash<auto> document in (input.documents) {
                list<string> names = map string($1), document.names;
                hash<auto> row = {"name": input.name, "copy": copy, "response": response, "document": document.name,
                    "matches": particle.matchesElementNames(names)};
                XsdXmlValue retained(document.xml);
                try {
                    ws.getXmlDataProviderType(input.uri, "Container").acceptsValue(retained);
                    row.retained = retained.getXml();
                } catch (hash<ExceptionInfo> ex) {
                    propagate(ex);
                    row.retained_error = ex.err;
                }
                try {
                    string envelope = '<e:Envelope xmlns:e="' + input.envelope + '"><e:Body>' + document.xml
                        + '</e:Body></e:Envelope>';
                    auto value = response ? operation.deserializeResponse(parse_xml(envelope, XPF_PRESERVE_ORDER), "Soap")
                        : operation.deserializeRequest(parse_xml(envelope, XPF_PRESERVE_ORDER), "Soap");
                    row.value = value;
                    row.xml = (response ? operation.serializeResponse({"body": value}, NOTHING, NOTHING, NOTHING,
                        NOTHING, NOTHING, "Soap") : operation.serializeRequest({"body": value}, NOTHING, NOTHING,
                        NOTHING, NOTHING, NOTHING, "Soap")).body;
                    row.unwrapped_xml = (response ? operation.serializeResponse(value, NOTHING, NOTHING, NOTHING,
                        NOTHING, NOTHING, "Soap") : operation.serializeRequest(value, NOTHING, NOTHING,
                        NOTHING, NOTHING, NOTHING, "Soap")).body;
                } catch (hash<ExceptionInfo> ex) {
                    propagate(ex);
                    row.error = ex.err;
                    row.description = ex.desc;
                }
                printf("%s\n", make_json(row));
            }
        }
    }
}
%endif
