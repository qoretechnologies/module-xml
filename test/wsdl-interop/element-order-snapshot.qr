#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires ../../qlib/WSDL.qm
%requires xml
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "WSDL metadata snapshots require json";
%else
if (!ARGV) {
    throw "USAGE", "element-order-snapshot.qr WSDL [WSDL ...]";
}
hash<auto> sub typeInfo(AbstractDataProviderType type, reference<hash<string, int>> seen) {
    string id = type.uniqueHash();
    if (seen.hasKey(id)) {
        return {"ref": seen{id}};
    }
    int num = seen.size();
    seen{id} = num;
    hash<auto> result = {"id": num, "name": type.getName()};
    list<hash<auto>> fields();
    foreach AbstractDataField field in (type.getFields().iterator()) {
        push fields, {"name": field.getName(), "mandatory": field.isMandatory(),
            "type": typeInfo(field.getType(), \seen)};
    }
    result.fields = fields;
    *AbstractDataProviderType item = type.getElementType();
    if (item) {
        result.item = typeInfo(item, \seen);
    }
    return result;
}
foreach string file in (ARGV) {
    hash<auto> row();
    row.file = file;
    try {
        WebService ws = WSDLLib::getWebServiceFromUrl(file);
        row.report = ws.getReport(file);
        list<hash<auto>> operations();
        WSMessageHelper helper(ws);
        foreach string name in (ws.getOperationNames()) {
            WSOperation op = ws.getOperation(name);
            foreach bool response in (False, True) {
                *WSMessage message = response ? op.output : op.input;
                if (!message) {
                    continue;
                }
                hash<auto> record = {"operation": name, "response": response};
                try {
                    record.sample = helper.getMessage(message);
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err == "THREAD-CANCELLED" || ex.err == "PROGRAM-INTERRUPTED") {
                        rethrow;
                    }
                    record.sample_error = {"err": ex.err, "desc": ex.desc};
                }
                try {
                    hash<string, int> seen();
                    record.type = typeInfo(message.getDataProviderType(), \seen);
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err == "THREAD-CANCELLED" || ex.err == "PROGRAM-INTERRUPTED") {
                        rethrow;
                    }
                    record.type_error = {"err": ex.err, "desc": ex.desc};
                }
                push operations, record;
            }
        }
        row.operations = operations;
    } catch (hash<ExceptionInfo> ex) {
        if (ex.err == "THREAD-CANCELLED" || ex.err == "PROGRAM-INTERRUPTED") {
            rethrow;
        }
        row.error = {"err": ex.err, "desc": ex.desc};
    }
    printf("%s\n", make_json(row));
}

%endif
