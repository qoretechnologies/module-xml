#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "element consistency integration requires json";
%else
foreach hash<auto> input in (parse_json(ReadOnlyFile::readTextFile(ARGV[0]))) {
    hash<auto> result();
    result.name = input.name;
    result.reader_error = result.dom_error = result.wsdl_error = "";
    try {
        XmlReader reader(new StringInputStream(input.document), {"xsd": input.schema});
        while (reader.read()) {
        }
        @assert(reader.isValid());
        result.reader_valid = True;
    } catch (hash<ExceptionInfo> ex) {
        if (ex.err == "THREAD-CANCELLED" || ex.err == "PROGRAM-INTERRUPTED") {
            throw ex.err, ex.desc, ex.arg;
        }
        result.reader_error = ex.err;
    }
    try {
        @assert(parse_xml(input.document) == parse_xml_with_schema(input.document, input.schema));
        result.dom_value_preserved = True;
    } catch (hash<ExceptionInfo> ex) {
        if (ex.err == "THREAD-CANCELLED" || ex.err == "PROGRAM-INTERRUPTED") {
            throw ex.err, ex.desc, ex.arg;
        }
        result.dom_error = ex.err;
    }
    try {
        XsdSchema schema(input.schema, {"async_only": True});
        XsdXmlValue value(input.document);
        foreach XsdSchema current in (schema, Serializable::deserialize(schema.serialize())) {
            @assert(current.getXmlDataProviderType(input.uri, "root").acceptsValue(value).getXml() == input.document);
        }
        result.retained_copies = 2;
    } catch (hash<ExceptionInfo> ex) {
        if (ex.err == "THREAD-CANCELLED" || ex.err == "PROGRAM-INTERRUPTED") {
            throw ex.err, ex.desc, ex.arg;
        }
        result.wsdl_error = ex.err;
    }
    printf("%s\n", make_json(result));
}
%endif
