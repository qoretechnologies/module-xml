#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
# Serializes and decodes SOAP messages of generated WSDL bindings. Reads a JSON list of cases: {"id", "wsdl", "binding",
# "operation", "input" and "output" (part values as XML lexical text), "incoming" (a list of request envelopes to decode)}.
# Writes one JSON result per case: the request and response envelopes and HTTP content type, the decoded request, and the
# decoding result of each incoming envelope (the decoded values or the rejection).
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "binding message tests require json";
%else
# returns decoded values as XML lexical text for comparison
auto sub lexical(auto value) {
    switch (value.typeCode()) {
        case NT_HASH: return map {$1.key: lexical($1.value)}, value.pairIterator();
        case NT_LIST: return map lexical($1), value;
        case NT_DATE: return value.format("YYYY-MM-DD");
        case NT_BOOLEAN: return value ? "true" : "false";
        case NT_NOTHING: return NOTHING;
    }
    return string(value);
}

hash<auto> sub decode(WSOperation op, string binding, string envelope, string content_type) {
    hash<auto> msg = WSDLLib::parseMultiPartSOAPMessage({"content-type": content_type, "body": envelope}, False, True);
    return {"values": lexical(op.deserializeRequest(WSDLLib::parseSOAPMessage(msg, False, True), binding))};
}

if (ARGV.size() != 1) {
    throw "USAGE", "binding-messages.qr CASES.json";
}
list<hash<auto>> cases = parse_json(ReadOnlyFile::readTextFile(ARGV[0]));
foreach hash<auto> item in (cases) {
    hash<auto> result();
    result.id = item.id;
    try {
        WebService ws(item.wsdl);
        WSOperation op = ws.getBindingOperation(item.binding, item.operation);
        hash<auto> request = op.serializeRequest(item.input, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, item.binding);
        result.request = request.body;
        result.content_type = request.hdr."Content-Type";
        result.soapaction = request.hdr.SOAPAction;
        result.response = op.serializeResponse(item.output, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING,
            item.binding).body;
        result.decoded = decode(op, item.binding, request.body, request.hdr."Content-Type").values;
        list<hash<auto>> incoming();
        foreach string envelope in (item.incoming) {
            try {
                incoming += decode(op, item.binding, envelope, request.hdr."Content-Type");
            } catch (hash<ExceptionInfo> ex) {
                incoming += {"error": ex.err, "desc": ex.desc};
            }
        }
        result.incoming = incoming;
    } catch (hash<ExceptionInfo> ex) {
        result.error = ex.err;
        result.desc = ex.desc;
    }
    printf("%s\n", make_json(result));
}
%endif
