#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires ../../../qlib/WSDL.qm
%requires ../../../qlib/SoapHandler.qm
%requires HttpServer
@assert(ARGV.size() == 5);
string source = ReadOnlyFile::readTextFile(get_script_dir() + "/../soap-envelope-peer/contract.wsdl");
WebService ws(source);
if (ARGV[1] == "saved") { ws = Serializable::deserialize(ws.serialize()); }
if (ARGV[1] == "data") { ws = Serializable::deserialize(ws.serializeToData()); }
Queue called();
SoapHeaderProcessor processor = auto sub(hash<auto> cx, hash<SoapNodeHeader> header) {
    @assert(header.xml.getElementData()."^value^" == "invoice-71");
    return "accepted";
};
hash<SoapNodeOptions> options = <SoapNodeOptions>{"roles":("urn:billing",)};
if (ARGV[2] == "known") { options.processors = {"{urn:tracking}Tracking":processor}; }
SoapProcessingNode node(options);
HttpServer server();
on_exit server.stop();
SoapHandler handler(new PermissiveAuthenticator(), NOTHING, False, NOTHING, node);
server.setDefaultHandler("node", handler);
bool retained = ARGV[3] == "retained";
code<auto(hash<auto>, auto)> callback = auto sub(hash<auto> cx, auto value) {
    @assert((retained ? value.body.body.getElementData()."^value^" : value) == "invoice-71");
    called.push(True);
    return {"body":retained ? value.body.body : value};
};
handler.addMethod(ws, ws.getOperation("echo"), callback, NOTHING, NOTHING, NOTHING,
    "service", NOTHING, NOTHING, "B" + ARGV[0], NOTHING, retained);
server.addListener(0);
printf("READY\t%d\n", server.getListenerInfo(0).port);
@assert(trim(stdin.readLine() ?? "") == "STOP");
server.stop();
@assert(called.size() == int(ARGV[4]));
