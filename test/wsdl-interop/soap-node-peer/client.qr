#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires ../../../qlib/WSDL.qm
%requires ../../../qlib/SoapClient.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "SOAP node HTTP tests require json";
%else
string source = ReadOnlyFile::readTextFile(get_script_dir() + "/../soap-envelope-peer/contract.wsdl");
list<auto> results();
foreach hash<auto> job in (parse_json(stdin.readLine()).jobs) {
    WebService ws(source);
    if (job.state == "saved") { ws = Serializable::deserialize(ws.serialize()); }
    if (job.state == "data") { ws = Serializable::deserialize(ws.serializeToData()); }
    SoapHeaderProcessor processor = auto sub(hash<auto> cx, hash<SoapNodeHeader> header) {
        @assert(header.xml.getElementData()."^value^" == "invoice-71");
        return header.role;
    };
    SoapProcessingNode node(<SoapNodeOptions>{"roles":job.roles,"processors":{"{urn:tracking}Tracking":processor}});
    SoapClient client({"wsdl":ws,"port":"Port12","url":job.url,"soap_node":node,"timeout":10000});
    hash<auto> info;
    auto value = client.callOperation("echo",{"body":"invoice-71"},{"xml_values":job.retained},\info);
    hash<SoapNodeResult> processed = info."soap-processing";
    results += {"value":job.retained ? value.body.body.getElementData()."^value^" : value,
        "role":processed.headers[0].value,"targeted":processed.headers[0].header.targeted,
        "processed":processed.headers[0].processed,"url":info."effective-url"};
}
printf("%s\n",make_json(results));
%endif
