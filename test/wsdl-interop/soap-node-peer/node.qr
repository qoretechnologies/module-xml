#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires ../../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "SOAP node interoperability requires json";
%else
list<auto> results();
foreach hash<auto> job in (parse_json(stdin.readLine()).jobs) {
    hash<string, SoapHeaderProcessor> processors();
    list<string> called();
    foreach string name in (job.known ?? ()) {
        processors{name} = auto sub(hash<auto> cx, hash<SoapNodeHeader> header) {
            @assert(header.xml.getElementData()."^value^" == "invoice-71");
            called += header.name;
            return header.index;
        };
    }
    SoapProcessingNode node(<SoapNodeOptions>{"ultimate_receiver":job.ultimate ?? True,
        "roles":job.roles ?? (),"processors":processors});
    hash<auto> result();
    try {
        hash<SoapNodeResult> processed = node.processMessage(job.xml, {}, job.base);
        result.headers = map ("name":$1.header.name,"role":$1.header.role,"targeted":$1.header.targeted,
            "processed":$1.processed,"forwarded":$1.forwarded,"value":$1.value), processed.headers;
        if (processed.forward_message) { result.forward = processed.forward_message.getXml(); }
    } catch (hash<ExceptionInfo> ex) {
        result.error = ex.err;
        if (ex.err == "SOAP-MUST-UNDERSTAND") {
            result.unknown = map $1.name, ex.arg.headers;
        }
    }
    result.called = called;
    results += result;
}
printf("%s\n", make_json(results));
%endif
