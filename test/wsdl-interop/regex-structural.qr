%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "the structural regex worker requires json";
%else
if (ARGV.size() != 1) {
    throw "USAGE", "regex-structural.qr MANIFEST";
}

list<hash<auto>> jobs = parse_json(ReadOnlyFile::readTextFile(ARGV[0]));
foreach hash<auto> job in (jobs) {
    XsdCompiledPattern original(job.pattern);
    int copy = 0;
    foreach XsdCompiledPattern pattern in (original, Serializable::deserialize(original.serialize())) {
        foreach string value in (job.values) {
            printf("%s\n", make_json({"name": job.name, "copy": copy, "text": value,
                "ok": pattern.matches(value), "source": pattern.getSource()}));
        }
        ++copy;
    }
}
%endif
