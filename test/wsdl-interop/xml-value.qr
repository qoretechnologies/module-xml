#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.

%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm

# One XML document per invocation keeps the probe independent of JSON modules.
XsdXmlValue value(ARGV[0]);
if (ARGV[1] == "restored") {
    value = Serializable::deserialize(value.serialize());
}
hash<auto> content = value.getXmlSerializationData();
content."^attributes^" = {"xmlns": "urn:parent", "xmlns:p": "urn:parent"};
print(make_xml({"collection": content}));
