#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
# Internal worker for survey.py. All imports must be supplied by its local manifest.

%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry

%ifdef NoJson
throw "MISSING-MODULE", "the interoperability survey requires the json module";
%else
if (ARGV.size() != 1) {
    throw "USAGE", "probe.qr MANIFEST.json";
}
hash<auto> manifest = parse_json(ReadOnlyFile::readTextFile(ARGV[0]));
foreach hash<auto> c in (manifest.cases) {
    string stage = "parse";
    try {
        WebService ws(ReadOnlyFile::readTextFile(c.wsdl), {
            "async_only": True,
            "def_path": c.base,
            "xsd_cache": manifest.cache,
        });
        WSOperation op = ws.getOperation("echo" + c.name);
        printf("%s\n", make_json({"case": c.name, "stage": stage, "ok": True}));
        foreach hash<auto> message in (c.messages) {
            hash<auto> row = {"case": c.name, "file": message.file};
            try {
                stage = "deserialize";
                auto value = op.deserializeRequest(parse_xml(ReadOnlyFile::readTextFile(message.path)));
                printf("%s\n", make_json(row + {"stage": stage, "ok": True}));
                stage = "serialize";
                hash<auto> wire = op.serializeRequest(value);
                printf("%s\n", make_json(row + {"stage": stage, "ok": True, "body": wire.body}));
            } catch (hash<ExceptionInfo> e) {
                printf("%s\n", make_json(row + {"stage": stage, "ok": False, "err": e.err, "desc": e.desc}));
            }
        }
    } catch (hash<ExceptionInfo> e) {
        printf("%s\n", make_json({"case": c.name, "stage": stage, "ok": False, "err": e.err, "desc": e.desc}));
    }
}
%endif
