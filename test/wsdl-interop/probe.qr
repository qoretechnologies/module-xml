#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
# Internal worker for survey.py. All imports must be supplied by its local manifest.

%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry

%ifdef NoJson
throw "MISSING-MODULE", "the interoperability survey requires the json module";
%else
if (ARGV.size() != 1) {
    throw "USAGE", "probe.qr MANIFEST.json";
}
hash<auto> manifest = parse_json(ReadOnlyFile::readTextFile(ARGV[0]));
if (exists manifest.preserve_types && manifest.preserve_types.typeCode() != NT_BOOLEAN) {
    throw "INVALID-MANIFEST", "preserve_types must be a boolean";
}
bool preserve_types = manifest.preserve_types ?? False;
foreach hash<auto> c in (manifest.cases) {
    string stage = "parse";
    try {
        if (c.schema_only) {
            XsdSchema schema(ReadOnlyFile::readTextFile(c.wsdl), {
                "async_only": True,
                "def_path": c.base,
                "xsd_cache": manifest.cache,
            });
            printf("%s\n", make_json({"case": c.name, "stage": stage, "ok": True}));
            continue;
        }
        WebService ws(ReadOnlyFile::readTextFile(c.wsdl), {
            "async_only": True,
            "def_path": c.base,
            "xsd_cache": manifest.cache,
        });
        if (c.parse_only) {
            printf("%s\n", make_json({"case": c.name, "stage": stage, "ok": True}));
            continue;
        }
        WSOperation original_op = ws.getBindingOperation(c.binding, c.operation ?? ("echo" + c.name));
        *WebService soap12;
        printf("%s\n", make_json({"case": c.name, "stage": stage, "ok": True}));
        foreach hash<auto> message in (c.messages) {
            hash<auto> row = {"case": c.name, "file": message.file};
            if (exists message.direction) {
                row.direction = message.direction;
            }
            try {
                stage = "deserialize";
                WSOperation op = original_op;
                if (message.soap_version == "12" && c.soap12_binding) {
                    if (!soap12) {
                        soap12 = new WebService(c.soap12_binding.xml, {"async_only":True,
                            "def_path":c.base,"xsd_cache":manifest.cache});
                    }
                    op = soap12.getBindingOperation(c.binding, c.operation ?? ("echo" + c.name));
                }
                hash<auto> parsed = parse_xml(ReadOnlyFile::readTextFile(message.path), XPF_PRESERVE_ORDER | XPF_PRESERVE_WHITESPACE);
                auto value = message.direction == "response"
                    ? op.deserializeResponse(parsed, c.binding, preserve_types)
                    : op.deserializeRequest(parsed, c.binding, preserve_types);
                printf("%s\n", make_json(row + {"stage": stage, "ok": True}));
                stage = "serialize";
                hash<auto> wire = message.direction == "response"
                    ? op.serializeResponse(value, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, c.binding)
                    : op.serializeRequest(value, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, c.binding);
                printf("%s\n", make_json(row + {"stage": stage, "ok": True, "body": wire.body}));
            } catch (hash<ExceptionInfo> e) {
                printf("%s\n", make_json(row + {"stage": stage, "ok": False, "err": e.err, "desc": e.desc}));
            }
        }
    } catch (hash<ExceptionInfo> e) {
        printf("%s\n", make_json({"case": c.name, "stage": stage, "ok": False, "err": e.err, "desc": e.desc}));
    }
}
%endif
