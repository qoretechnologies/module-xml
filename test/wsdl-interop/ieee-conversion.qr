#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%try-module json
%define NoJson
%endtry

%ifdef NoJson
throw "MISSING-MODULE", "the IEEE conversion test requires json";
%else
if (ARGV.size() != 1) {
    throw "USAGE", "ieee-conversion.qr CASES.json";
}
list<hash<auto>> rows = parse_json(ReadOnlyFile::readTextFile(ARGV[0]));
foreach hash<auto> row in (rows) {
    auto value = row.text;
    switch (row.kind) {
        case "int":
            value = int(row.text);
            break;
        case "float":
            value = float(row.text);
            break;
        case "number":
            value = number(row.text);
            break;
    }
    float converted = convert_xsd_float(value, row.wide);
    printf("%s\n", make_json({"id": row.id, "value": converted.toStringRoundTrip()}));
}
%endif
