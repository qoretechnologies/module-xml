#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "the name boundary worker requires json";
%else
if (ARGV.size() != 1) {
    throw "USAGE", "name-value-boundaries.qr MANIFEST";
}
list<hash<auto>> rows = parse_json(ReadOnlyFile::readTextFile(ARGV[0]));
Namespaces namespaces({});
hash<string, XsdBaseType> types();
hash<string, AbstractDataProviderType> providers();
foreach string name in ("Name", "NCName", "QName", "NMTOKEN") {
    types{name} = namespaces.getBaseType(name);
    providers{name} = Serializable::deserialize(types{name}.getDataProviderType().serialize());
}
foreach hash<auto> row in (rows) {
    hash<auto> result = {"name": row.name};
    foreach string operation in ("serialize", "deserialize", "provider") {
        try {
            result{operation} = operation == "serialize" ? types{row.builtin}.serializeValue(namespaces, row.value, True)
                : operation == "deserialize" ? types{row.builtin}.deserializeValue("value",
                    new hash<string, XsdAbstractType>(), NOTHING, row.value)
                : providers{row.builtin}.acceptsValue(row.value);
        } catch (hash<ExceptionInfo> ex) {
            result{operation + "_error"} = ex.err;
        }
    }
    printf("%s\n", make_json(result));
}
%endif
