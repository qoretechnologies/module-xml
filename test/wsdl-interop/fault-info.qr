#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
# Reads SOAP fault messages with WSDLLib::getSOAPFaultInfo(), as SOAP clients do. Reads a JSON list of {"id", "xml"}
# cases and writes one JSON result per case: the fault's expanded codes, reasons, actor, node, role, and whether it
# has a detail and headers, or the rejection.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "SOAP fault message tests require json";
%else
string sub expanded(XsdQNameValue name) {
    return "{" + name.getNamespaceUri() + "}" + name.getLocalName();
}

if (ARGV.size() != 1) {
    throw "USAGE", "fault-info.qr CASES.json";
}
list<hash<auto>> cases = parse_json(ReadOnlyFile::readTextFile(ARGV[0]));
foreach hash<auto> item in (cases) {
    hash<auto> result();
    result.id = item.id;
    try {
        hash<SoapFaultInfo> fault = WSDLLib::getSOAPFaultInfo(item.xml);
        result.soap12 = fault.soap12;
        result.codes = map expanded($1), (fault.code,) + fault.subcodes;
        result.reasons = map ("text": $1.text, "language": $1.language), fault.reasons;
        result.actor = fault.actor;
        result.node = fault.node;
        result.role = fault.role;
        result.detail = exists fault.detail;
        result.headers = fault.headers.size();
    } catch (hash<ExceptionInfo> ex) {
        result.error = ex.err;
        result.desc = ex.desc;
    }
    printf("%s\n", make_json(result));
}
%endif
