#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "wildcard element interoperability tests require json";
%else
foreach hash<auto> model in (parse_json(ReadOnlyFile::readTextFile(ARGV[0]))) {
    XsdSchema schema(model.schema, {"async_only":True});
    foreach hash<auto> document in (model.documents) {
        hash<auto> row();
        row.model = model.name;
        row.document = document.name;
        XsdXmlValue original(document.xml);
        XsdElement root = schema.getElement(original.getNamespaceUri(), original.getLocalName());
        hash<auto> expanded = XsdBase::expandElementNamespaces(parse_xml(document.xml, XPF_PRESERVE_ORDER));
        auto data = expanded{original.getExpandedName()};
        try {
            auto value = root.deserializeValue(schema.getTypeMap(), NOTHING, data, True);
            row.decoded = True;
            row.value = value;
            row.output = schema.serializeXmlValue(original.getNamespaceUri(), original.getLocalName(), value).getXml();
            row.native_output = parse_xml_with_schema(row.output, model.schema) == parse_xml(row.output);
            XmlReader reader(new StringInputStream(row.output), {"xsd":model.schema});
            while (reader.read()) {
            }
            row.reader_output = reader.isValid();
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "THREAD-CANCELLED" || ex.err == "PROGRAM-INTERRUPTED") {
                rethrow;
            }
            row.error = ex.err;
            row.description = ex.desc;
        }
        # Construct an independent XML-data candidate, including inherited bindings
        # on each detached subtree, to test outgoing validation even after decode rejects it.
        hash<auto> candidate = data ?? {};
        *hash<auto> root_attributes = remove candidate."^attributes^";
        foreach string key in (keys candidate) {
            if (candidate{key}.typeCode() == NT_HASH) {
                candidate{key}."^attributes^" = root_attributes + candidate{key}."^attributes^";
            }
        }
        try {
            row.direct_output = schema.serializeXmlValue(original.getNamespaceUri(), original.getLocalName(), candidate).getXml();
            row.encoded = True;
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "THREAD-CANCELLED" || ex.err == "PROGRAM-INTERRUPTED") {
                rethrow;
            }
            row.encode_error = ex.err;
            row.encode_description = ex.desc;
        }
        try {
            AbstractDataProviderType provider = root.type.getDataProviderType();
            row.provider_value = provider.acceptsValue(candidate);
            row.provider = True;
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "THREAD-CANCELLED" || ex.err == "PROGRAM-INTERRUPTED") {
                rethrow;
            }
            row.provider_error = ex.err;
            row.provider_description = ex.desc;
        }
        printf("%s\n", make_json(row));
    }
}
%endif
