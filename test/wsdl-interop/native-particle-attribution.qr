#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%try-module json
%define NoJson
%endtry

%ifdef NoJson
throw "MISSING-MODULE", "native particle attribution tests require the json module";
%else
if (ARGV.size() != 1) {
    throw "USAGE", "native-particle-attribution.qr CASES.json";
}
bool sub constructs(string source, bool stream) {
    string empty = '<t:Submit xmlns:t="urn:qore:attribute-values"/>';
    if (stream) {
        XmlReader reader(new StringInputStream(empty), {"xsd": source});
    } else {
        try {
            hash<auto> value = parse_xml_with_schema(empty, source);
            @assert(value.size() == 1);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "PARSE-XML-EXCEPTION") {
                rethrow;
            }
        }
    }
    return True;
}
foreach hash<auto> input in (parse_json(ReadOnlyFile::readTextFile(ARGV[0]))) {
    foreach bool stream in (False, True) {
        string error = "";
        try {
            bool valid = constructs(input.schema, stream);
            @assert(valid);
        } catch (hash<ExceptionInfo> ex) {
            error = ex.err;
        }
        printf("%s\n", make_json({"case": input.name, "stage": "schema", "stream": stream, "error": error}));
    }
    foreach hash<auto> doc in (input.documents) {
        foreach bool stream in (False, True) {
            string error = "";
            int childCount = 0;
            try {
                if (stream) {
                    XmlReader reader(new StringInputStream(doc.xml), {"xsd": input.schema});
                    while (reader.read()) {
                        if (reader.nodeType() == XML_NODE_TYPE_ELEMENT && reader.depth() == 1) {
                            ++childCount;
                        }
                        if (reader.nodeType() == XML_NODE_TYPE_TEXT) {
                            @assert(reader.value() == "value");
                        }
                    }
                    @assert(reader.isValid());
                } else {
                    hash<auto> value = parse_xml_with_schema(doc.xml, input.schema);
                    @assert(value.size() == 1);
                }
            } catch (hash<ExceptionInfo> ex) {
                error = ex.err;
            }
            printf("%s\n", make_json({"case": input.name, "stage": "document", "word": doc.word,
                "stream": stream, "error": error, "childCount": childCount}));
        }
    }
}
%endif
