#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry

%ifdef NoJson
throw "MISSING-MODULE", "the message identity test requires the json module";
%else
if (ARGV.size() != 1) {
    throw "USAGE", "message-identity.qr DESCRIPTION.wsdl";
}
WebService original(ReadOnlyFile::readTextFile(ARGV[0]), {"async_only": True});
WebService ws = Serializable::deserialize(original.serialize());
WSOperation op = ws.getBindingOperation("Soap", "submit");
foreach string direction in ("request", "response") {
    WSMessage message = direction == "request" ? op.input : op.output;
    foreach string mode in ("values", "example") {
        hash<auto> value = mode == "values" ? {"first": False, "second": 0, "plain": ""}
            : new WSMessageHelper(ws).getMessage(message);
        auto converted = message.getDataProviderType().acceptsValue(value);
        @assert(converted == value);
        hash<auto> wire = direction == "request"
            ? op.serializeRequest(value, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, "Soap")
            : op.serializeResponse(value, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, "Soap");
        auto decoded = direction == "request" ? op.deserializeRequest(parse_xml(wire.body), "Soap")
            : op.deserializeResponse(parse_xml(wire.body), "Soap");
        printf("%s\n", make_json({"direction": direction, "mode": mode, "value": value,
            "decoded": decoded, "body": wire.body}));
    }
}
%endif
