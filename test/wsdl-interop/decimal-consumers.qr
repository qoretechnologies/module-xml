#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry

%ifdef NoJson
throw "MISSING-MODULE", "the decimal consumer test requires json";
%else
if (ARGV.size() != 2) {
    throw "USAGE", "decimal-consumers.qr WSDL BINDING";
}
WebService original(ReadOnlyFile::readTextFile(ARGV[0]), {"async_only": True});
int copy = 0;
foreach WebService ws in (original, Serializable::deserialize(original.serialize())) {
    WSOperation op = ws.getBindingOperation(ARGV[1], "submit");
    foreach bool response in (False, True) {
        WSMessage message = response ? op.output : op.input;
        XsdElement element = message.args.firstValue().element;
        AbstractDataProviderType provider = element.getDataProviderType();
        provider = Serializable::deserialize(provider.serialize());
        int index = 0;
        foreach auto value in (123.45, 0.1, 1e100, 5e-324, 1.7976931348623157e308, 123.45n, 0.1n,
                number("1.00000000000000000001"), number("0.123450000000000000000006"),
                9223372036854775807, "+001.2300", "12345678901234567890.123456789") {
            auto converted = provider.acceptsValue({"^value^": value, "^attributes^": {"amount": value}});
            hash<auto> argument = {element.name: converted};
            hash<auto> wire = response ? op.serializeResponse(argument, NOTHING, NOTHING, NOTHING, NOTHING,
                NOTHING, ARGV[1]) : op.serializeRequest(argument, NOTHING, NOTHING, NOTHING, NOTHING,
                NOTHING, ARGV[1]);
            hash<auto> sample = new WSMessageHelper(ws).getMessage(message);
            hash<auto> example = response ? op.serializeResponse(sample, NOTHING, NOTHING, NOTHING, NOTHING,
                NOTHING, ARGV[1]) : op.serializeRequest(sample, NOTHING, NOTHING, NOTHING, NOTHING,
                NOTHING, ARGV[1]);
            printf("%s\n", make_json({"copy": copy, "index": index,
                "direction": response ? "response" : "request", "value": converted,
                "body": wire.body, "example": example.body}));
            ++index;
        }
    }
    ++copy;
}
%endif
