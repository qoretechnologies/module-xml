#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry

%ifdef NoJson
throw "MISSING-MODULE", "the retained XML consumer test requires json";
%else
if (ARGV.size() != 4) {
    throw "USAGE", "xml-consumers.qr DESCRIPTION.wsdl BINDING REQUEST.xml RESPONSE.xml";
}
WebService original(ReadOnlyFile::readTextFile(ARGV[0]), {"async_only": True});
foreach WebService ws in (original, Serializable::deserialize(original.serialize())) {
    WSOperation op = ws.getBindingOperation(ARGV[1], "submit");
    foreach bool response in (False, True) {
        string xml = ReadOnlyFile::readTextFile(ARGV[response ? 3 : 2]);
        hash<SoapXmlMessageInfo> received = response ? op.deserializeXmlResponse(xml, ARGV[1])
            : op.deserializeXmlRequest(xml, ARGV[1]);
        # Each standalone carrier is reconstructed and checked by its source-backed XML provider.
        foreach string part in (keys received.body) {
            XsdXmlValue value = Serializable::deserialize(received.body{part}.serialize());
            AbstractDataProviderType provider = ws.getXmlDataProviderType(value.getNamespaceUri(), value.getLocalName());
            provider = Serializable::deserialize(provider.serialize());
            received.body{part} = provider.acceptsValue(value);
        }
        WSMessageHelper helper(ws);
        hash<string, XsdXmlValue> examples = helper.getXmlMessage(response ? op.output : op.input);
        hash<auto> emitted = response ? op.serializeResponse(received.body, received.headers, NOTHING, NOTHING,
            NOTHING, NOTHING, ARGV[1]) : op.serializeRequest(received.body, received.headers, NOTHING, NOTHING,
            NOTHING, NOTHING, ARGV[1]);
        hash<auto> example = response ? op.serializeResponse(examples, NOTHING, NOTHING, NOTHING, NOTHING,
            NOTHING, ARGV[1]) : op.serializeRequest(examples, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, ARGV[1]);
        hash<string, string> parts();
        map parts{$1.key} = $1.value.getXml(), received.body.pairIterator();
        hash<string, hash<string, string>> part_contexts();
        hash<string, string> direct();
        foreach string part in (keys received.body) {
            part_contexts{part} = received.body{part}.getXmlContext();
            direct{part} = make_xml({"batch": received.body{part}.getXmlSerializationData()});
        }
        hash<string, hash<string, string>> headers();
        hash<string, hash<string, hash<string, string>>> header_contexts();
        foreach string message_name in (keys received.headers) {
            foreach string part in (keys received.headers{message_name}) {
                headers{message_name}{part} = received.headers{message_name}{part}.getXml();
                header_contexts{message_name}{part} = received.headers{message_name}{part}.getXmlContext();
            }
        }
        printf("%s\n", make_json({"direction": response ? "response" : "request", "body": emitted.body,
            "parts": parts, "headers": headers, "example": example.body, "part_contexts": part_contexts,
            "header_contexts": header_contexts, "direct": direct}));
    }
}
%endif
