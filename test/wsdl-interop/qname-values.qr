#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "the QName value worker requires json";
%else
if (ARGV.size() != 1) {
    throw "USAGE", "qname-values.qr MANIFEST";
}
hash<auto> manifest = parse_json(ReadOnlyFile::readTextFile(ARGV[0]));
list<hash<auto>> rows = manifest.rows;
foreach hash<auto> row in (rows) {
    XsdXmlValue envelope(row.xml);
    XsdXmlValue body = envelope.getChildValues()[0];
    XsdXmlValue payload = body.getChildValues()[0];
    hash<auto> data = payload.getElementData();
    hash<string, string> bindings = XsdBase::getElementNamespaces(data."^attributes^");
    XsdQNameDataType original(bindings);
    hash<auto> result();
    result.name = row.name;
    result.element = payload.getExpandedName();
    foreach string choice in (keys manifest.schemas) {
        try {
            XmlReader reader(new StringInputStream(payload.getXml()), {"xsd": manifest.schemas{choice}});
            while (reader.read()) {
            }
            result{choice + "_native_valid"} = True;
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "PARSE-XML-EXCEPTION") {
                rethrow;
            }
            result{choice + "_native_valid"} = False;
        }
    }
    foreach string source in ("text", "attribute") {
        string lexical = source == "text" ? data."^value^" ?? "" : data."^attributes^".category;
        foreach string operation in ("value", "provider", "reconstructed") {
            string key = source + "_" + operation;
            try {
                XsdQNameValue value;
                string native_type = "object";
                if (operation == "value") {
                    value = XsdQNameValue::fromLexical(lexical, bindings);
                } else {
                    XsdQNameDataType provider = operation == "provider" ? original
                        : Serializable::deserialize(original.serialize());
                    auto converted = provider.acceptsValue(lexical);
                    native_type = converted.type();
                    value = converted instanceof XsdQNameValue ? converted
                        : XsdQNameValue::fromLexical(converted, {});
                }
                XsdQNameValue restored = Serializable::deserialize(value.serialize());
                @assert(restored.equals(value));
                @assert(restored.getLexicalValue() == value.getLexicalValue());
                result{key} = {"uri": value.getNamespaceUri(), "local": value.getLocalName(),
                    "lexical": value.getLexicalValue(), "prefix": value.getPrefix(), "native_type": native_type,
                    "catalog": value.equals(new XsdQNameValue("urn:catalog", "alias:Product")),
                    "local_product": value.equals(new XsdQNameValue("", "Product"))};
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "XSD-QNAME-VALUE-ERROR" && ex.err != "RUNTIME-TYPE-ERROR") {
                    rethrow;
                }
                result{key + "_error"} = ex.err;
            }
        }
    }
    printf("%s\n", make_json(result));
}
%endif
