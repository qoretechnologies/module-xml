#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "type final integration requires json";
%else
if (ARGV.size() != 1) {
    throw "USAGE", "type-final.qr CASES.json";
}
foreach hash<auto> input in (parse_json(ReadOnlyFile::readTextFile(ARGV[0]))) {
    string native_error = "";
    try {
        XmlReader reader("<v/>");
        reader.schemaValidateString(input.schema);
    } catch (hash<ExceptionInfo> error) {
        if (error.err == "THREAD-CANCELLED" || error.err == "PROGRAM-INTERRUPTED") {
            rethrow;
        }
        native_error = error.err;
    }
    try {
        WebService original(input.wsdl, {"async_only": True});
        foreach bool copy in (False, True) {
            WebService ws = copy ? Serializable::deserialize(original.serialize()) : original;
            WSOperation op = ws.getBindingOperation(input.binding, "submit");
            foreach bool response in (False, True) {
                hash<auto> data = {"body": {"item": input.value}};
                string xml = (response ? op.serializeResponse(data, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING,
                    input.binding) : op.serializeRequest(data, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING,
                    input.binding)).body;
                auto decoded = response ? op.deserializeResponse(parse_xml(xml, XPF_PRESERVE_ORDER), input.binding)
                    : op.deserializeRequest(parse_xml(xml, XPF_PRESERVE_ORDER), input.binding);
                printf("%s\n", make_json({"name": input.name, "copy": copy, "response": response,
                    "native_error": native_error, "value": decoded, "xml": xml}));
            }
        }
    } catch (hash<ExceptionInfo> error) {
        if (error.err == "THREAD-CANCELLED" || error.err == "PROGRAM-INTERRUPTED") {
            rethrow;
        }
        printf("%s\n", make_json({"name": input.name, "error": error.err, "description": error.desc,
            "native_error": native_error}));
    }
}
%endif
