#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "native type value integration requires json";
%else
auto sub snapshot(auto value) {
    if (value instanceof XsdQNameValue) {
        return {"namespace_uri":value.getNamespaceUri(),"local_name":value.getLocalName()};
    }
    if (value.typeCode() == NT_HASH) {
        hash<auto> result();
        foreach string key in (keys value) {
            result{key} = snapshot(value{key});
        }
        return result;
    }
    if (value.typeCode() == NT_LIST) {
        return map snapshot($1), value;
    }
    return value;
}
if (ARGV.size() != 1) {
    throw "USAGE", "native-type-values.qr CASES.json";
}
foreach hash<auto> input in (parse_json(ReadOnlyFile::readTextFile(ARGV[0]))) {
    WebService original(input.wsdl, {"async_only":True});
    WSOperation decoder = original.getBindingOperation(input.binding, "submit");
    foreach bool copy in (False, True) {
        WebService receiver = copy ? Serializable::deserialize(original.serialize()) : original;
        WSOperation encoder = receiver.getBindingOperation(input.binding, "submit");
        foreach bool response in (False, True) {
            hash<auto> row = {"case":input.name,"copy":copy,"response":response,
                "decode_error":"","encode_error":"","manual_error":""};
            string xml = response ? input.response : input.request;
            auto native;
            try {
                native = response ? decoder.deserializeResponse(parse_xml(xml, XPF_PRESERVE_ORDER), input.binding, True)
                    : decoder.deserializeRequest(parse_xml(xml, XPF_PRESERVE_ORDER), input.binding, True);
                row.native = snapshot(native);
            } catch (hash<ExceptionInfo> error) {
                if (error.err == "THREAD-CANCELLED" || error.err == "PROGRAM-INTERRUPTED") {
                    rethrow;
                }
                row.decode_error = error.err;
                row.decode_description = error.desc;
            }
            if (!row.decode_error) {
                try {
                    auto restored = Serializable::deserialize(Serializable::serialize(native));
                    row.xml = (response ? encoder.serializeResponse(restored, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, input.binding)
                        : encoder.serializeRequest(restored, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, input.binding)).body;
                    row.restored = snapshot(response ? encoder.deserializeResponse(parse_xml(row.xml, XPF_PRESERVE_ORDER), input.binding, True)
                        : encoder.deserializeRequest(parse_xml(row.xml, XPF_PRESERVE_ORDER), input.binding, True));
                    row.default_native = snapshot(response ? encoder.deserializeResponse(parse_xml(row.xml, XPF_PRESERVE_ORDER), input.binding)
                        : encoder.deserializeRequest(parse_xml(row.xml, XPF_PRESERVE_ORDER), input.binding));
                } catch (hash<ExceptionInfo> error) {
                    if (error.err == "THREAD-CANCELLED" || error.err == "PROGRAM-INTERRUPTED") {
                        rethrow;
                    }
                    row.encode_error = error.err;
                    row.encode_description = error.desc;
                }
            }
            try {
                hash<auto> data = {"body":{"item":{"^type^":new XsdQNameValue(input.selected_uri, input.selected_name),"^val^":input.value}}};
                row.manual = (response ? encoder.serializeResponse(data, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, input.binding)
                    : encoder.serializeRequest(data, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, input.binding)).body;
            } catch (hash<ExceptionInfo> error) {
                if (error.err == "THREAD-CANCELLED" || error.err == "PROGRAM-INTERRUPTED") {
                    rethrow;
                }
                row.manual_error = error.err;
                row.manual_description = error.desc;
            }
            printf("%s\n", make_json(row));
        }
    }
}
%endif
