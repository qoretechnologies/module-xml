#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%requires xml
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "schema resource diagnostics require json";
%else
hash<auto> sub loadFixture(hash<auto> fixture) {
    Program program(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES
        | (fixture.no_network ? PO_NO_NETWORK : 0) | (fixture.no_filesystem ? PO_NO_FILESYSTEM : 0));
    if (fixture.policy) {
        SandboxManager manager();
        manager.setNetworkDefaultPolicy(fixture.allow_network ?? False);
        foreach string address in (fixture.denied_ips) {
            manager.addNetworkDeniedIPRange(address);
        }
        foreach string path in (fixture.allowed_paths) {
            manager.addFilesystemAllowedPath(path, QSEC_READ);
        }
        program.setSandboxManager(manager);
    }
    program.parse("%modern\n%requires xml\n"
        "hash<auto> sub load(string xml, string schema, bool text) {\n"
        "    XmlReader reader(xml);\n"
        "    if (text) { reader.schemaValidateString(schema); } else { reader.schemaValidate(schema); }\n"
        "    hash<auto> result = reader.toQore();\n"
        "    @assert(reader.isValid());\n"
        "    return result;\n"
        "}\n", "schema_resource_load");
    hash<auto> result();
    try {
        result.value = program.callFunction("load", fixture.xml, fixture.schema, fixture.text ?? False);
    } catch (hash<ExceptionInfo> ex) {
        result.error = ex.err;
        result.description = ex.desc;
    }
    return result;
}
auto fixture = parse_json(ReadOnlyFile::readTextFile(ARGV[0]));
if (fixture.typeCode() == NT_LIST) {
    list<auto> results();
    foreach hash<auto> item in (fixture) {
        push results, loadFixture(item);
    }
    printf("%s\n", make_json(results));
} else {
    printf("%s\n", make_json(loadFixture(fixture)));
}
%endif
