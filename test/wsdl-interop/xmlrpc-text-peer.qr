#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires HttpServer
%requires ../../qlib/XmlRpcHandler.qm
%requires ../../qlib/XmlRpcClientIo
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "XML-RPC interoperability tests require json";
%else
class TextPeerHandler inherits XmlRpcHandler {
    constructor() : XmlRpcHandler(new PermissiveAuthenticator(), (
            {"name": "^echo$", "text": "echo", "function": \TextPeerHandler::echo(), "help": "Return exact text"},
            {"name": "^fail$", "text": "fail", "function": \TextPeerHandler::fail(), "help": "Return a text fault"})) {
    }
    static auto echo(auto value) {
        return value;
    }
    static nothing fail(string value) {
        throw "TEXT-PEER-ERROR", value;
    }
}

hash<auto> fixture = parse_json(ReadOnlyFile::readTextFile(ARGV[0]));
if (fixture.action == "serialize") {
    list<auto> results();
    foreach string encoding in (fixture.encodings) {
        foreach int flags in (0, XGF_ADD_FORMATTING, XGF_USE_NUMERIC_REFS,
                XGF_ADD_FORMATTING | XGF_USE_NUMERIC_REFS) {
            foreach auto value in (fixture.values) {
                hash<auto> record = {} + {"value": value};
                string call = make_xmlrpc_call("echo", (record,), flags, encoding);
                string response = make_xmlrpc_response(record, flags, encoding);
                string raw = make_xmlrpc_value(record, flags, encoding);
                @assert(parse_xmlrpc_call(call).params == (record,));
                @assert(parse_xmlrpc_response(response).params == record);
                @assert(parse_xmlrpc_value(raw) == record);
                push results, {"encoding": encoding, "flags": flags, "value": value,
                    "call": make_base64_string(binary(call)), "response": make_base64_string(binary(response))};
            }
            string fault = make_xmlrpc_fault(23, fixture.fault, flags, encoding);
            push results, {"encoding": encoding, "flags": flags, "fault": make_base64_string(binary(fault))};
        }
    }
    printf("%s\n", make_json(results));
} else if (fixture.action == "client") {
    XmlRpcClientIo::XmlRpcClientIo client(fixture.url);
    on_exit client.close();
    list<auto> results();
    foreach auto value in (fixture.values) {
        hash<auto> record = {} + {"value": value};
        hash<auto> response = client.call("echo", record);
        @assert(response.params == record);
        push results, response.params;
    }
    hash<auto> fault = client.call("fail", fixture.fault).fault;
    @assert(fault.faultCode == 23);
    @assert(fault.faultString == fixture.fault);
    printf("%s\n", make_json(results));
} else if (fixture.action == "server") {
    HttpServer server();
    on_exit server.stop();
    TextPeerHandler handler();
    server.setDefaultHandler("xmlrpc-text", handler);
    int port = server.addListener(0).port;
    # Listening is complete before the control request lets the independent peer connect.
    HTTPClient control({"url": fixture.url, "timeout": 30000, "connect_timeout": 30000});
    hash<auto> result = parse_json(control.post("/ready", make_json({"port": port})));
    @assert(result.ok);
    printf("%s\n", make_json(result));
} else {
    throw "XMLRPC-TEXT-TEST-ERROR", "unknown peer action";
}
%endif
