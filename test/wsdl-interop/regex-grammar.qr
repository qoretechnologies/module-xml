%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "the regex grammar worker requires json";
%else
if (ARGV.size() != 1) {
    throw "USAGE", "regex-grammar.qr MANIFEST";
}

foreach hash<auto> row in (parse_json(ReadOnlyFile::readTextFile(ARGV[0]))) {
    try {
        XsdSchema definition(row.schema, {"async_only": True});
        printf("%s\n", make_json({"name": row.name, "schema_ok": True}));
    } catch (hash<ExceptionInfo> ex) {
        printf("%s\n", make_json({"name": row.name, "schema_ok": False, "err": ex.err, "desc": ex.desc}));
    }
}
%endif
