#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires ../../../qlib/WSDL.qm
%requires ../../../qlib/SoapHandler.qm
%requires HttpServer
@assert(ARGV.size() == 5);
bool soap12 = ARGV[0] == "12";
string source = ReadOnlyFile::readTextFile(get_script_dir() + "/../regressions/fault-bindings/literal.wsdl");
source = replace(source, '<w:input><s:body', '<w:input><s:header message="t:H" part="token" use="literal">'
    + '<s:headerfault message="t:Failure" part="problem" use="literal"/></s:header><s:body');
WebService ws(soap12 ? replace(source, SOAP_11_NS, SOAP_12_NS) : source);
if (ARGV[1] == "saved") { ws = Serializable::deserialize(ws.serialize()); }
if (ARGV[1] == "data") { ws = Serializable::deserialize(ws.serializeToData()); }
Queue processed(); Queue called();
SoapHeaderProcessor processor = auto sub(hash<auto> cx, hash<SoapNodeHeader> header) {
    processed.push(header.name);
    string token = header.xml.getElementData()."^value^";
    if (token == "8") { throw "HEADER-PROCESSOR-FAILED", "Session database unavailable"; }
    throw SOAP_HEADER_FAULT, "Session expired", <SoapHeaderFaultInfo>{
        "message":token == "9" ? "Missing" : "Failure","part":"problem","value":71};
};
SoapProcessingNode node(<SoapNodeOptions>{"processors":{"{urn:parts}Token":processor}});
SoapHandler handler(new PermissiveAuthenticator(), NOTHING, False, NOTHING, node);
code<auto(hash<auto>,auto)> callback = auto sub(hash<auto> cx, auto value) {
    string mode = cx.http_header."x-fault-mode"; called.push(mode);
    if (mode == "structured") { throw 71, {"order":7}; }
    if (mode == "control") { throw "CONTROL", "bad\x00after\x01end"; }
    if (mode == "runtime") { throw "APPLICATION-FAILED", "Inventory database unavailable"; }
    if (mode == "declared") { throw "Rejected", "Order rejected", 71; }
    if (mode == "header") {
        throw SOAP_HEADER_FAULT, "Session expired", <SoapHeaderFaultInfo>{"message":"Failure","part":"problem","value":71};
    }
    return {"left":mode == "output" ? "invalid" : 1,"right":2};
};
handler.addMethod(ws, ws.getOperation("exchange"), callback, NOTHING, NOTHING, NOTHING,
    "service", NOTHING, NOTHING, "B", NOTHING, ARGV[2] == "retained");
HttpServer server(); on_exit server.stop();
server.setDefaultHandler("faults", handler); server.addListener(0);
printf("READY\t%d\n", server.getListenerInfo(0).port);
@assert(trim(stdin.readLine() ?? "") == "STOP");
server.stop();
@assert(processed.size() == int(ARGV[3]));
@assert(called.size() == int(ARGV[4]));
