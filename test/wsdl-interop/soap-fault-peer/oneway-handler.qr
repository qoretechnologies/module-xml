#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires ../../../qlib/WSDL.qm
%requires ../../../qlib/SoapHandler.qm
%requires HttpServer
@assert(ARGV.size() == 4);
string source = ReadOnlyFile::readTextFile(get_script_dir() + "/../soap-envelope-peer/contract.wsdl");
source = replace(source,'<w:output message="t:Value"/>','');
source = replace(source,'<w:output><s:body use="literal"/></w:output>','');
source = replace(source,'<w:output><s12:body use="literal"/></w:output>','');
WebService ws(source);
if (ARGV[1] == "saved") { ws = Serializable::deserialize(ws.serialize()); }
if (ARGV[1] == "data") { ws = Serializable::deserialize(ws.serializeToData()); }
bool retained = ARGV[2] == "retained";
Queue received();
SoapHandler handler(new PermissiveAuthenticator());
code<auto(hash<auto>,auto)> callback = auto sub(hash<auto> cx, auto value) {
    string text = retained ? value.body.body.getElementData()."^value^" : value;
    @assert(text == "invoice-71" || text == "error");
    received.push(text);
    if (text == "error") { throw "APPLICATION-FAILED","Queue unavailable"; }
};
handler.addMethod(ws,ws.getOperation("echo"),callback,NOTHING,NOTHING,NOTHING,
    "service",NOTHING,NOTHING,"B"+ARGV[0],NOTHING,retained);
HttpServer server(); on_exit server.stop();
server.setDefaultHandler("oneway",handler); server.addListener(0);
printf("READY\t%d\n",server.getListenerInfo(0).port);
@assert(trim(stdin.readLine() ?? "") == "STOP");
server.stop();
@assert(received.size() == int(ARGV[3]));
