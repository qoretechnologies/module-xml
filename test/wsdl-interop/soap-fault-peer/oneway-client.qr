#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires ../../../qlib/WSDL.qm
%requires ../../../qlib/SoapClient.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "SOAP one-way HTTP tests require json";
%else
hash<auto> input = parse_json(stdin.readLine());
string source = ReadOnlyFile::readTextFile(get_script_dir() + "/../soap-envelope-peer/contract.wsdl");
source = replace(source,'<w:output message="t:Value"/>','');
source = replace(source,'<w:output><s:body use="literal"/></w:output>','');
source = replace(source,'<w:output><s12:body use="literal"/></w:output>','');
list<auto> results();
foreach string state in ("source","saved","data") {
    WebService ws(source);
    if (state == "saved") { ws = Serializable::deserialize(ws.serialize()); }
    if (state == "data") { ws = Serializable::deserialize(ws.serializeToData()); }
    foreach bool retained in (False,True) {
        SoapHeaderProcessor processor = auto sub(hash<auto> cx, hash<SoapNodeHeader> block) {
            @assert(block.xml.getElementData()."^value^" == "invoice-71"); return "acknowledged";
        };
        SoapProcessingNode node(<SoapNodeOptions>{"processors":{"{urn:ack}Received":processor}});
        SoapClient client({"wsdl":ws,"port":"Port"+input.version,"url":input.url,"timeout":10000,"soap_node":node});
        for (int i = 0; i < input.count; ++i) {
            hash<auto> info;
            hash<auto> result();
            try {
                auto value = client.callOperation("echo",{"body":"invoice-71"},{"xml_values":retained},\info);
                result.error = "OK";
                result.value_is_nothing = !exists value;
                if (info."soap-processing".headers[0].processed) {
                    result.ack = info."soap-processing".headers[0].value;
                }
            } catch (hash<ExceptionInfo> ex) {
                result.error = ex.err;
            }
            result.status = info."response-headers".status_code;
            results += result;
        }
    }
}
printf("%s\n",make_json(results));
%endif
