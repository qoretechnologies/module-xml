#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires ../../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "SOAP fault generation interoperability tests require json";
%else
string source = ReadOnlyFile::readTextFile(get_script_dir() + "/../regressions/fault-bindings/literal.wsdl");
source = replace(source, '<w:input><s:body', '<w:input><s:header message="t:H" part="token" use="literal">'
    + '<s:headerfault message="t:Failure" part="problem" use="literal"/></s:header><s:body');
list<auto> result();
foreach bool soap12 in (False, True) {
    foreach string state in ("source", "saved", "data") {
        WebService ws(soap12 ? replace(source, SOAP_11_NS, SOAP_12_NS) : source);
        if (state == "saved") { ws = Serializable::deserialize(ws.serialize()); }
        if (state == "data") { ws = Serializable::deserialize(ws.serializeToData()); }
        WSOperation op = ws.getOperation("exchange");
        foreach string code in (soap12 ? ("VersionMismatch", "MustUnderstand", "DataEncodingUnknown", "Sender", "Receiver")
                : ("Client", "Server")) {
            hash<SoapFaultOptions> options = <SoapFaultOptions>{
                "code":new XsdQNameValue(soap12 ? SOAP_12_ENV : SOAP_11_ENV, code),
                "reasons":(<SoapFaultReason>{"text":"Refusé & <réessayer>","language":"fr"},)};
            if (soap12) {
                options.subcodes = (new XsdQNameValue("urn:order", "soapenv:Rejected"), new XsdQNameValue("", "Missing"));
                options.reasons += <SoapFaultReason>{"text":"拒否","language":"ja"};
                options.node = "../node#71";
                options.role = "urn:receiver";
            } else { options.actor = "https://example.test/actor"; }
            foreach string kind in ("generic", "declared", "header") {
                hash<auto> message = kind == "header"
                    ? op.serializeHeaderFault(<SoapHeaderFaultInfo>{"message":"Failure","part":"problem","value":71},
                        "ignored", NOTHING, "UTF-8", options)
                    : op.serializeFault(kind == "declared" ? "Rejected" : NOTHING, "ignored",
                        kind == "declared" ? 71 : NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, options);
                result += {"version":soap12 ? "12" : "11","state":state,"code":code,"kind":kind,"xml":message.body};
            }
        }
    }
}
printf("%s\n",make_json(result));
%endif
