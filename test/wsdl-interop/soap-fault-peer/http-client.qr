#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires ../../../qlib/WSDL.qm
%requires ../../../qlib/SoapClient.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "SOAP HTTP fault tests require json";
%else
hash<auto> input = parse_json(stdin.readLine());
string source = ReadOnlyFile::readTextFile(get_script_dir() + "/../soap-envelope-peer/contract.wsdl");
list<auto> results();
foreach string state in ("source", "saved", "data") {
    WebService ws(source);
    if (state == "saved") { ws = Serializable::deserialize(ws.serialize()); }
    if (state == "data") { ws = Serializable::deserialize(ws.serializeToData()); }
    foreach bool retained in (False,True) {
        SoapClient client({"wsdl":ws,"port":"Port" + input.version,"url":input.url,"timeout":10000});
        for (int i = 0; i < input.count; ++i) {
            hash<auto> info;
            hash<auto> result();
            try {
                auto value = client.callOperation("echo",{"body":"invoice-71"},{"xml_values":retained},\info);
                result += {"error":"OK","value":retained ? value.body.body.getElementData()."^value^" : value};
            } catch (hash<ExceptionInfo> ex) {
                result.error = ex.err;
                if (ex.err == "SOAP-SERVER-FAULT-RESPONSE") {
                    result.accent = ex.desc.find("refusé") >= 0;
                } else if (ex.err == "HTTP-CLIENT-RECEIVE-ERROR") {
                    result.original_status = ex.arg.status_code;
                }
            }
            result.status = info."response-headers".status_code;
            results += result;
        }
    }
}
printf("%s\n",make_json(results));
%endif
