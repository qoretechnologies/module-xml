#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires ../../../qlib/WSDL.qm
%requires ../../../qlib/SoapClient.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "SOAP fault interoperability tests require json";
%else
hash<auto> input = parse_json(stdin.readLine());
string source = ReadOnlyFile::readTextFile(get_script_dir() + "/../soap-envelope-peer/contract.wsdl");
list<auto> results();
foreach string state in ("source", "saved", "data") {
    WebService ws(source);
    if (state == "saved") { ws = Serializable::deserialize(ws.serialize()); }
    if (state == "data") { ws = Serializable::deserialize(ws.serializeToData()); }
    foreach bool retained in (False, True) {
        SoapClient client({"wsdl":ws,"port":"Port" + (input.version ?? "12"),"url":input.url,"timeout":10000});
        for (int i = 0; i < input.count; ++i) {
            hash<auto> info;
            try {
                client.callOperation("echo", {"body":"invoice-71"}, {"xml_values":retained}, \info);
                results += {"error":"NO-EXCEPTION"};
            } catch (hash<ExceptionInfo> ex) {
                hash<auto> result = {"error":ex.err,"status":info."response-headers".status_code};
                if (input.metadata && ex.err == "SOAP-SERVER-FAULT-RESPONSE") {
                    hash<SoapFaultInfo> fault = WSDLLib::getSOAPFaultInfo(info."response-body");
                    result.codes = map "{" + $1.getNamespaceUri() + "}" + $1.getLocalName(),
                        (fault.code,) + fault.subcodes;
                    result.reasons = map ("text":$1.text,"language":$1.language), fault.reasons;
                    result.actor = fault.actor;
                    result.node = fault.node;
                    result.role = fault.role;
                    result.detail = exists fault.detail;
                    result.headers = fault.headers.size();
                }
                results += result;
            }
        }
    }
}
printf("%s\n",make_json(results));
%endif
