#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry

%ifdef NoJson
throw "MISSING-MODULE", "the element collision consumer test requires the json module";
%else
if (ARGV.size() != 2) {
    throw "USAGE", "element-collision-values.qr DESCRIPTION.wsdl BINDING";
}
WebService original(ReadOnlyFile::readTextFile(ARGV[0]), {"async_only": True});
WebService ws = Serializable::deserialize(original.serialize());
WSOperation op = ws.getBindingOperation(ARGV[1], "submit");
foreach string direction in ("request", "response") {
    WSMessage message = direction == "request" ? op.input : op.output;
    XsdElement elem = message.args.firstValue().element;
    hash<auto> sample = new WSMessageHelper(ws).getMessage(message);
    auto value = sample{elem.name};
    auto converted = elem.getDataProviderType().acceptsValue(value);
    @assert(converted == value);
    hash<auto> wire = direction == "request"
        ? op.serializeRequest(sample, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, ARGV[1])
        : op.serializeResponse(sample, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, ARGV[1]);
    auto decoded = direction == "request" ? op.deserializeRequest(parse_xml(wire.body), ARGV[1])
        : op.deserializeResponse(parse_xml(wire.body), ARGV[1]);
    @assert(decoded == value);
    printf("%s\n", make_json({"direction": direction, "value": value, "body": wire.body}));
}
%endif
