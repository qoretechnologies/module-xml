#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
# Calls every operation of the derived SOAPBuilders round 2 contract at the given URL through the async
# SoapClientIo client with the values of Axis's own TestClient, and verifies each echo. Floats are the
# single-precision values Axis sends (3.7F and so on); a decoded array whose members share one element
# name keeps that name as its key (qorelanguage/qore#2899), and an xsd:decimal whose text a float reproduces
# exactly decodes as that float (XsdDecimalDataType). Prints VERIFIED <n> FAILURES <n>, then one FAIL line
# per failure; exits 1 if any operation failed.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires ../../../qlib/WSDL.qm
%requires ../../../qlib/SoapClientIo
@assert(ARGV.size() == 1);

# Returns True if the values have the same types and values; dates compare as absolute times.
bool sub same(auto a, auto b) {
    if (a.typeCode() != b.typeCode()) {
        return False;
    }
    switch (a.typeCode()) {
        case NT_HASH:
            return keys a == keys b && !(select keys a, !same(a{$1}, b{$1}));
        case NT_LIST:
            return a.size() == b.size() && !(select xrange(a.size()), !same(a[$1], b[$1]));
        case NT_DATE:
            return a == b;
    }
    return a === b;
}

# Apache SOAP Map items are an unordered key/value set; Axis holds them in a java.util.HashMap.
hash<auto> sub map_set(hash<auto> m) {
    return {"item": sort(m.item, int sub (hash<auto> a, hash<auto> b) {
        return sprintf("%y", a.key) <=> sprintf("%y", b.key);
    })};
}

date when = 2026-09-22T09:56:56.663Z;
hash<auto> struct = {"varString": "Hello", "varInt": 5, "varFloat": 103.0};
list<auto> structs = (
    {"varString": "one", "varInt": 1, "varFloat": 1.10000002384185791015625},
    {"varString": "two", "varInt": 2, "varFloat": 2.2000000476837158203125},
    {"varString": "three", "varInt": 3, "varFloat": 3.2999999523162841796875},
);
hash<auto> map1 = {"item": ({"key": 5, "value": "String Value"}, {"key": "String Key", "value": when})};
hash<auto> map2 = {"item": ({"key": "this is the second map", "value": True}, {"key": "test", "value": 411.0})};
hash<auto> nested = {"varString": "AXIS", "varInt": 1, "varFloat": 3.0, "varStruct": struct};
# operation: (request arguments, expected response)
hash<string, list<auto>> calls = {
    "echoString": ({"inputString": "abccdefg"}, "abccdefg"),
    "echoStringArray": ({"inputStringArray": ("abc", "def")}, {"return": ("abc", "def")}),
    "echoInteger": ({"inputInteger": 42}, 42),
    "echoIntegerArray": ({"inputIntegerArray": (42,)}, {"return": (42,)}),
    "echoFloat": ({"inputFloat": 3.7000000476837158203125}, 3.7000000476837158203125),
    "echoFloatArray": ({"inputFloatArray": (3.7000000476837158203125, 7.0)},
        {"return": (3.7000000476837158203125, 7.0)}),
    "echoStruct": ({"inputStruct": struct}, struct),
    "echoStructArray": ({"inputStructArray": structs}, {"return": structs}),
    "echoVoid": ({}, {}),
    "echoBase64": ({"inputBase64": binary("Base64")}, binary("Base64")),
    "echoHexBinary": ({"inputHexBinary": parse_hex_string("3344")}, parse_hex_string("3344")),
    "echoDate": ({"inputDate": when}, when),
    "echoDecimal": ({"inputDecimal": 3.14159n}, 3.14159),
    "echoBoolean": ({"inputBoolean": True}, True),
    "echoMap": ({"input": map1}, map_set(map1)),
    "echoMapArray": ({"input": (map1, map2)}, {"return": (map_set(map1), map_set(map2))}),
    "echoStructAsSimpleTypes": ({"inputStruct": struct},
        {"outputString": "Hello", "outputInteger": 5, "outputFloat": 103.0}),
    "echoSimpleTypesAsStruct": ({"inputString": "Hello", "inputInteger": 5, "inputFloat": 103.0}, struct),
    "echo2DStringArray": ({"input2DStringArray": (("00", "01"), ("10", "11"))},
        {"return": (("00", "01"), ("10", "11"))}),
    "echoNestedStruct": ({"inputStruct": nested}, nested),
    "echoNestedArray": ({"inputStruct": {"varString": "AXIS", "varInt": 1, "varFloat": 3.0,
        "varArray": ("one", "two", "three")}}, {"varString": "AXIS", "varInt": 1, "varFloat": 3.0,
        "varArray": {"varArray": ("one", "two", "three")}}),
    "echoToken": ({"inputToken": "abccdefg"}, "abccdefg"),
    "echoNormalizedString": ({"inputNormalizedString": "abccdefg"}, "abccdefg"),
    "echoUnsignedLong": ({"inputUnsignedLong": 100}, 100),
    "echoUnsignedInt": ({"inputUnsignedInt": 101}, 101),
    "echoUnsignedShort": ({"inputUnsignedShort": 102}, 102),
    "echoUnsignedByte": ({"inputUnsignedByte": 103}, 103),
    "echoNonNegativeInteger": ({"inputNonNegativeInteger": "12345678901234567890"}, "12345678901234567890"),
    "echoPositiveInteger": ({"inputPositiveInteger": "12345678901234567890"}, "12345678901234567890"),
    "echoNonPositiveInteger": ({"inputNonPositiveInteger": "-12345678901234567890"}, "-12345678901234567890"),
    "echoNegativeInteger": ({"inputNegativeInteger": "-12345678901234567890"}, "-12345678901234567890"),
};
WebService ws(ReadOnlyFile::readTextFile(get_script_dir() + "/derived/InteropTest-map.wsdl"));
@assert((sort(keys calls)) == sort(ws.getOperationNames()));
SoapClientIo client({"wsdl": ws, "url": ARGV[0], "timeout": 60000});
list<string> failures();
foreach hash<auto> call in (calls.pairIterator()) {
    try {
        auto value = client.callOperation(call.key, call.value[0]);
        if (call.key == "echoMap") {
            value = map_set(value);
        } else if (call.key == "echoMapArray") {
            value.return = map map_set($1), value.return;
        }
        if (!same(call.value[1], value)) {
            push failures, sprintf("%s: %y", call.key, value);
        }
    } catch (hash<ExceptionInfo> ex) {
        push failures, sprintf("%s: %s: %s", call.key, ex.err, ex.desc);
    }
}
printf("VERIFIED %d FAILURES %d\n", calls.size(), failures.size());
map printf("FAIL %s\n", $1), failures;
exit(failures ? 1 : 0);
