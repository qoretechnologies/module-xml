#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
# Serves the derived SOAPBuilders round 2 contract with the echo semantics of Axis's own
# InteropTestSoapBindingImpl, for Axis's interop client. Prints READY<TAB>port; STOP ends the server.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires ../../../qlib/WSDL.qm
%requires ../../../qlib/SoapHandler.qm
%requires HttpServer
@assert(!ARGV);
WebService ws(ReadOnlyFile::readTextFile(get_script_dir() + "/derived/InteropTest-map.wsdl"));
Queue calls();
SoapHandler handler(new PermissiveAuthenticator());
foreach string name in (ws.getOperationNames()) {
    code<auto(hash<auto>, auto)> echo;
    switch (name) {
        case "echoVoid":
            echo = auto sub(hash<auto> cx, auto value) { @assert(value == {}); };
            break;
        # SOAPStruct in; its three members out as separate parts
        case "echoStructAsSimpleTypes":
            echo = hash<auto> sub(hash<auto> cx, hash<auto> value) {
                return {"outputString": value.varString, "outputInteger": value.varInt, "outputFloat": value.varFloat};
            };
            break;
        # three parts in; one SOAPStruct out
        case "echoSimpleTypesAsStruct":
            echo = hash<auto> sub(hash<auto> cx, hash<auto> value) {
                return {"return": {"varString": value.inputString, "varInt": value.inputInteger,
                    "varFloat": value.inputFloat}};
            };
            break;
        # the single input part is echoed as the single output part, named explicitly
        default:
            echo = hash<auto> sub(hash<auto> cx, auto value) { return {"return": value}; };
            break;
    }
    # preserve_types retains each instance-selected type, such as a Map key sent as soapenc:int, which a
    # native Qore int would otherwise re-encode as xsd:long
    handler.addMethod(ws, ws.getOperation(name), auto sub(hash<auto> cx, auto value) {
        calls.push(cx.operation.name);
        return echo(cx, value);
    }, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, False, True);
}
HttpServer server();
on_exit server.stop();
server.setDefaultHandler("soap", handler);
server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0});
printf("READY\t%d\n", server.getListenerInfo(0).port);
@assert(trim(stdin.readLine() ?? "") == "STOP");
server.stop();
# every operation was dispatched exactly once; all 31 share one SOAP action, so the Body selected each
hash<string, int> seen;
while (calls.size()) {
    ++seen{calls.get()};
}
@assert(sort(keys seen) == sort(ws.getOperationNames()) && !(select seen.values(), $1 != 1));
