#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "schema whitespace tests require json";
%else
if (ARGV.size() != 1) {
    throw "USAGE", "schema-whitespace.qr CASES.json";
}
foreach hash<auto> input in (parse_json(ReadOnlyFile::readTextFile(ARGV[0]))) {
    string native_error = "";
    try {
        XmlReader reader(new StringInputStream("<root/>"), {"xsd": input.schema});
    } catch (hash<ExceptionInfo> ex) {
        if (ex.err == "THREAD-CANCELLED" || ex.err == "PROGRAM-INTERRUPTED") {
            rethrow;
        }
        native_error = ex.err;
    }
    string error = "";
    int copies = 0;
    try {
        XsdSchema source(input.schema, {"async_only": True});
        XsdSchema copy = Serializable::deserialize(source.serialize());
        copies = 1;
    } catch (hash<ExceptionInfo> ex) {
        if (ex.err == "THREAD-CANCELLED" || ex.err == "PROGRAM-INTERRUPTED") {
            rethrow;
        }
        error = ex.err;
    }
    printf("%s\n", make_json({"name": input.name, "native_error": native_error, "error": error, "copies": copies}));
}
%endif
