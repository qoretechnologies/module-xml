#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry

%ifdef NoJson
throw "MISSING-MODULE", "particle value attribution tests require json";
%else
if (ARGV.size() != 1) {
    throw "USAGE", "particle-value-attribution.qr CASES.json";
}
sub collect(XsdParticle node, string path, reference<hash<string, string>> positions) {
    if (node.getKind() == XsdParticleKind::Element) {
        positions{node.uniqueHash()} = path;
    }
    list<XsdParticle> children = node.getChildren();
    for (int index = 0; index < children.size(); ++index) {
        collect(children[index], path + "/" + index.toString(), \positions);
    }
}
foreach hash<auto> input in (parse_json(ReadOnlyFile::readTextFile(ARGV[0]))) {
    *XsdSchema schema;
    try {
        schema = new XsdSchema(input.schema, {"async_only": True});
    } catch (hash<ExceptionInfo> ex) {
        if (ex.err == "THREAD-CANCELLED" || ex.err == "PROGRAM-INTERRUPTED") {
            rethrow;
        }
        printf("%s\n", make_json({"case": input.name, "error": ex.err}));
        continue;
    }
    printf("%s\n", make_json({"case": input.name, "error": ""}));
    XsdParticle original = cast<XsdComplexType>(schema.findType("Record")).getParticle();
    foreach bool copy in (False, True) {
        XsdParticle particle = copy ? Serializable::deserialize(original.serialize()) : original;
        hash<string, string> positions();
        collect(particle.getChildren()[0], "", \positions);
        foreach string word in (input.words) {
            *list<XsdParticle> matched = particle.attributeElementNames(map "{}" + $1, word.splitChars());
            *list<string> paths;
            if (exists matched) {
                paths = ();
                foreach XsdParticle terminal in (matched) {
                    @assert(positions.hasKey(terminal.uniqueHash()));
                    push paths, positions{terminal.uniqueHash()};
                }
            }
            printf("%s\n", make_json({"case": input.name, "copy": copy, "word": word, "positions": paths}));
        }
    }
}
%endif
