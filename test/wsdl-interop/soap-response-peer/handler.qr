#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires ../../../qlib/WSDL.qm
%requires ../../../qlib/SoapHandler.qm
%requires HttpServer
@assert(ARGV.size() == 4);
WebService ws(ReadOnlyFile::readTextFile(get_script_dir() + "/../soap-envelope-peer/contract.wsdl"));
if (ARGV[0] == "saved") { ws = Serializable::deserialize(ws.serialize()); }
if (ARGV[0] == "data") { ws = Serializable::deserialize(ws.serializeToData()); }
bool retained = ARGV[1] == "retained"; bool mount = ARGV[2] == "mount";
Queue calls(); Queue posted(); Queue headers();
SoapProcessingNode node(<SoapNodeOptions>{"processors":{"{urn:headers}Track":
    auto sub(hash<auto> cx, hash<SoapNodeHeader> header) { headers.push(header.name); }}});
SoapHandler handler(new PermissiveAuthenticator(),NOTHING,False,NOTHING,node);
WSOperation operation = ws.getBindingOperation("B12","echo");
code<auto(hash<auto>)> provider = auto sub(hash<auto> cx) {
    @assert(cx.soap_response && !exists cx.soap_action && !cx.http_body);
    @assert(cx.http_header.method == "GET");
    calls.push(cx.raw_path);
    if (cx.raw_path.endsWith("?error")) { throw "RESOURCE-ERROR", "invoice store unavailable"; }
    if (cx.raw_path.endsWith("?remove")) { handler.removeService("resource"); }
    return {"body":retained ? new XsdXmlValue('<t:value xmlns:t="urn:soap-envelope-test">response</t:value>') : "response"};
};
foreach string path in ("/service", "/invoice%2F71", "/café", "/") {
    handler.addSoapResponseResource(path,operation,provider,"B12","resource");
}
handler.addMethod(ws,operation,auto sub(hash<auto> cx, auto value) {
    @assert(!cx.soap_response); posted.push(value); return {"body":"response"};
},NOTHING,NOTHING,NOTHING,"service",NOTHING,NOTHING,"B12","post");
HttpServer server(); on_exit server.stop();
if (mount) { server.setHandler("response","mount",NOTHING,handler,NOTHING,False); }
else { server.setDefaultHandler("response",handler); }
server.addListener(0);
printf("READY\t%d\n",server.getListenerInfo(0).port);
@assert(trim(stdin.readLine() ?? "") == "STOP");
server.stop();
@assert(calls.size() == int(ARGV[3]));
@assert(posted.size() == 1 && headers.size() == 1);
