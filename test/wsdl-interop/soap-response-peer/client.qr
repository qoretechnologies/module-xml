#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires ../../../qlib/WSDL.qm
%requires ../../../qlib/SoapClient.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "SOAP response integration requires json";
%else
hash<auto> job = parse_json(stdin.readLine());
string source = ReadOnlyFile::readTextFile(get_script_dir() + "/../soap-envelope-peer/contract.wsdl");
list<auto> results();
foreach string state in ("source", "saved", "data") {
    WebService ws(source);
    if (state == "saved") { ws = Serializable::deserialize(ws.serialize()); }
    if (state == "data") { ws = Serializable::deserialize(ws.serializeToData()); }
    foreach bool retained in (False,True) {
        Queue processed();
        SoapProcessingNode node(<SoapNodeOptions>{"processors":{"{urn:headers}Track":
            auto sub(hash<auto> cx, hash<SoapNodeHeader> header) { processed.push(header.name); }}});
        SoapClient client({"wsdl":ws,"port":"Port12","url":job.url,"timeout":10000,"soap_node":node,
            "headers":job.headers ?? {}});
        # Both the native and legacy header APIs must retain their defaults across GET requests.
        if (job.entity_defaults) {
            client.addDefaultHeaders({"Content-Type":"text/plain","SOAPAction":"urn:default",
                "Transfer-Encoding":"chunked","Content-Length":"100","Trailer":"Digest"});
            client.headers += {"CONTENT-ENCODING":"gzip","Content-Language":"en"};
        }
        hash<auto> defaults = client.getDefaultHeaders(); hash<auto> legacy = client.headers;
        string initial = client.getURL();
        foreach hash<auto> entry in (job.calls) {
            hash<auto> info; hash<auto> row();
            try {
                auto result = entry.post ? client.callOperation("echo",{"body":"invoice"},{"xml_values":retained},\info)
                    : client.getSoapResponse("echo",entry.path,{"xml_values":retained}+entry.opts,\info);
                row.value = retained ? result.body.body.getElementData()."^value^" : result;
                row.error = "OK";
            } catch (hash<ExceptionInfo> ex) { row.error = ex.err; }
            row.status = info."response-headers".status_code;
            row.headers_processed = processed.size();
            row.request_body = exists info."request-body";
            @assert(client.getURL() == initial && client.getDefaultHeaders() == defaults && client.headers == legacy);
            while (processed.size()) { processed.get(1000); }
            results += row;
        }
    }
}
printf("%s\n",make_json(results));
%endif
