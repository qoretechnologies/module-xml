#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry

%ifdef NoJson
throw "MISSING-MODULE", "the sized facet consumer test requires json";
%else
if (ARGV.size() != 1) {
    throw "USAGE", "sized-facet-consumers.qr MANIFEST";
}
foreach hash<auto> item in (parse_json(ReadOnlyFile::readTextFile(ARGV[0]))) {
    WebService original(ReadOnlyFile::readTextFile(item.wsdl), {"async_only": True});
    int copy = 0;
    foreach WebService ws in (original, Serializable::deserialize(original.serialize())) {
        WSOperation op = ws.getBindingOperation(item.binding, "submit");
        foreach bool response in (False, True) {
            WSMessage message = response ? op.output : op.input;
            XsdElement element = message.args.firstValue().element;
            AbstractDataProviderType provider = Serializable::deserialize(element.getDataProviderType().serialize());
            int index = 0;
            foreach hash<auto> variant in (item.values) {
                auto value = variant.native == "hex" ? parse_hex_string(variant.value) : variant.value;
                if (item.model == "record") {
                    value = {"^value^": value, "^attributes^": {"choice": value}};
                } else if (item.model == "repeated") {
                    list<auto> occurrences();
                    for (int i = 0; i < variant.count; ++i) {
                        push occurrences, value;
                    }
                    value = {"item": occurrences};
                }
                hash<auto> row = {"name": item.name, "copy": copy,
                    "direction": response ? "response" : "request", "index": index};
                try {
                    auto converted = provider.acceptsValue(value);
                    hash<auto> argument = {element.name: converted};
                    hash<auto> wire = response ? op.serializeResponse(argument, NOTHING, NOTHING, NOTHING, NOTHING,
                        NOTHING, item.binding) : op.serializeRequest(argument, NOTHING, NOTHING, NOTHING, NOTHING,
                        NOTHING, item.binding);
                    row.body = wire.body;
                } catch (hash<ExceptionInfo> ex) {
                    row.err = ex.err;
                    row.desc = ex.desc;
                }
                printf("%s\n", make_json(row));
                ++index;
            }
            hash<auto> row = {"name": item.name, "copy": copy,
                "direction": response ? "response" : "request", "index": "example"};
            try {
                hash<auto> sample = new WSMessageHelper(ws).getMessage(message);
                hash<auto> example = response ? op.serializeResponse(sample, NOTHING, NOTHING, NOTHING, NOTHING,
                    NOTHING, item.binding) : op.serializeRequest(sample, NOTHING, NOTHING, NOTHING, NOTHING,
                    NOTHING, item.binding);
                row.body = example.body;
            } catch (hash<ExceptionInfo> ex) {
                row.err = ex.err;
                row.desc = ex.desc;
            }
            printf("%s\n", make_json(row));
        }
        ++copy;
    }
}
%endif
