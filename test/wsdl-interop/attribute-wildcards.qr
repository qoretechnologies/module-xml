#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry

%ifdef NoJson
throw "MISSING-MODULE", "the attribute wildcard consumer test requires json";
%else
if (ARGV.size() != 3) {
    throw "USAGE", "attribute-wildcards.qr DESCRIPTION.wsdl BINDING SIMPLE";
}
WebService original(ReadOnlyFile::readTextFile(ARGV[0]), {"async_only": True});
WebService ws = Serializable::deserialize(original.serialize());
WSOperation op = ws.getBindingOperation(ARGV[1], "submit");
foreach string direction in ("request", "response") {
    WSMessage message = direction == "request" ? op.input : op.output;
    XsdElement element = message.args.firstValue().element;
    foreach string kind in ("native", "example") {
        hash<auto> value();
        if (kind == "native") {
            value."^attributes^" = {"flag": False};
        } else {
            value = new WSMessageHelper(ws).getMessage(message){element.name};
        }
        if (kind == "native" && ARGV[2] == "true") {
            value."^value^" = 0;
        }
        value = element.getDataProviderType().acceptsValue(value);
        @assert(value."^attributes^".flag.typeCode() == NT_BOOLEAN);
        if (ARGV[2] == "true") {
            @assert(value."^value^".typeCode() == NT_INT);
        }
        hash<auto> input_value = {element.name: value};
        hash<auto> wire = direction == "request"
            ? op.serializeRequest(input_value, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, ARGV[1])
            : op.serializeResponse(input_value, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, ARGV[1]);
        printf("%s\n", make_json({"direction": direction, "kind": kind, "value": value, "body": wire.body}));
    }
}
%endif
