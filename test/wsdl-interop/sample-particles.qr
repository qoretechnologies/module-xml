#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "particle example integration requires json";
%else
if (ARGV.size() != 1) {
    throw "USAGE", "sample-particles.qr CASES.json";
}
foreach hash<auto> input in (parse_json(ReadOnlyFile::readTextFile(ARGV[0]))) {
    WebService original(input.wsdl, {"async_only": True});
    foreach bool copy in (False, True) {
        WebService ws = copy ? Serializable::deserialize(original.serialize()) : original;
        WSOperation op = ws.getBindingOperation(input.binding, "submit");
        foreach bool response in (False, True) {
            foreach hash<auto> options in (input.options) {
                WSMessage message = response ? op.output : op.input;
                WSMessageHelper helper(ws, options);
                hash<auto> row = {"case": input.name, "copy": copy, "response": response,
                    "options": options, "error": ""};
                try {
                    auto sample = helper.getMessage(message);
                    row.xml = (response ? op.serializeResponse(sample, NOTHING, NOTHING, NOTHING,
                        NOTHING, NOTHING, input.binding) : op.serializeRequest(sample, NOTHING, NOTHING,
                        NOTHING, NOTHING, NOTHING, input.binding)).body;
                    row.native = response ? op.deserializeResponse(parse_xml(row.xml, XPF_PRESERVE_ORDER), input.binding)
                        : op.deserializeRequest(parse_xml(row.xml, XPF_PRESERVE_ORDER), input.binding);
                    hash<string, XsdXmlValue> retained = helper.getXmlMessage(message);
                    row.retained = retained.body.getXml();
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err == "THREAD-CANCELLED" || ex.err == "PROGRAM-INTERRUPTED") {
                        rethrow;
                    }
                    row.error = ex.err;
                }
                printf("%s\n", make_json(row));
            }
        }
    }
}
%endif
