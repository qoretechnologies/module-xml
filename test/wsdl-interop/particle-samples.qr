#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "particle sample tests require json";
%else
if (ARGV.size() != 1) {
    throw "USAGE", "particle-samples.qr CASES.json";
}
foreach hash<auto> input in (parse_json(ReadOnlyFile::readTextFile(ARGV[0]))) {
    *XsdSchema original;
    try {
        original = new XsdSchema(input.schema, {"async_only": True});
    } catch (hash<ExceptionInfo> ex) {
        if (ex.err == "THREAD-CANCELLED" || ex.err == "PROGRAM-INTERRUPTED") {
            rethrow;
        }
        printf("%s\n", make_json({"case": input.name, "error": ex.err}));
        continue;
    }
    printf("%s\n", make_json({"case": input.name, "error": ""}));
    foreach bool copy in (False, True) {
        XsdSchema schema = copy ? Serializable::deserialize(original.serialize()) : original;
        XsdParticle model = cast<XsdComplexType>(schema.findType("Record")).getParticle();
        foreach hash<auto> budget in (input.budgets) {
            *list<string> names;
            string error = "";
            try {
                names = model.getSampleElementNames(budget.repetitions, budget.children);
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err == "THREAD-CANCELLED" || ex.err == "PROGRAM-INTERRUPTED") {
                    rethrow;
                }
                error = ex.err;
            }
            printf("%s\n", make_json({"case": input.name, "copy": copy, "budget": budget,
                "names": names, "error": error}));
        }
    }
}
%endif
