#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
# Serializes the example values of a WSDL operation's input and output messages as SOAP messages. Reads the WSDL
# path, binding and operation from the command line and writes JSON: the request and response bodies, or the error.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "provider example serialization requires json";
%else
if (ARGV.size() != 3) {
    throw "USAGE", "provider-examples.qr WSDL BINDING OPERATION";
}
hash<auto> result;
try {
    WebService ws(ReadOnlyFile::readTextFile(ARGV[0]));
    WSOperation op = ws.getBindingOperation(ARGV[1], ARGV[2]);
    # the examples of the data provider types of both messages
    auto request = op.input.getDataProviderType().getExampleValue();
    auto response = op.output.getDataProviderType().getExampleValue();
    result.request = op.serializeRequest(request, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, ARGV[1]).body;
    result.response = op.serializeResponse(response, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, ARGV[1]).body;
} catch (hash<ExceptionInfo> ex) {
    result.error = sprintf("%s: %s", ex.err, ex.desc);
}
printf("%s\n", make_json(result));
%endif
