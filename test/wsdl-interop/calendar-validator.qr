#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%requires xml
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "the native calendar validator diagnostic requires json";
%else
if (ARGV.size() != 1) {
    throw "USAGE", "calendar-validator.qr calendar-validator-defects.json";
}
hash<auto> fixture = parse_json(ReadOnlyFile::readTextFile(ARGV[0]));
int index = 0;
foreach hash<auto> group in (fixture.cases) {
    string schema = '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"><xs:element name="value">'
        '<xs:simpleType><xs:restriction base="xs:' + group.builtin + '">' + group.facets
        + '</xs:restriction></xs:simpleType></xs:element></xs:schema>';
    foreach hash<auto> value in (group.values) {
        hash<auto> result();
        result.id = index++;
        result.valid = True;
        try {
            XmlReader reader(new StringInputStream(make_xml({"value": value.text})), {"xsd": schema});
            while (reader.read()) {
            }
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "PARSE-XML-EXCEPTION") {
                rethrow;
            }
            result.valid = False;
            result.diagnostic = ex.desc;
        }
        printf("%s\n", make_json(result));
    }
}
%endif
