#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "particle ordering tests require json";
%else
if (ARGV.size() != 1) {
    throw "USAGE", "particle-ordering.qr CASES.json";
}
foreach hash<auto> input in (parse_json(ReadOnlyFile::readTextFile(ARGV[0]))) {
    *XsdSchema original;
    try {
        original = new XsdSchema(input.schema, {"async_only": True});
    } catch (hash<ExceptionInfo> ex) {
        if (ex.err == "THREAD-CANCELLED" || ex.err == "PROGRAM-INTERRUPTED") {
            rethrow;
        }
        printf("%s\n", make_json({"case": input.name, "error": ex.err}));
        continue;
    }
    printf("%s\n", make_json({"case": input.name, "error": ""}));
    foreach bool copy in (False, True) {
        XsdSchema schema = copy ? Serializable::deserialize(original.serialize()) : original;
        XsdComplexType type = cast<XsdComplexType>(schema.findType("Record"));
        foreach list<string> names in (input.probes) {
            *list<string> ordered = type.getParticle().orderElementNames(names);
            hash<auto> value();
            hash<string, int> counts();
            foreach string identity in (names) {
                string local = substr(identity, 2);
                if (!counts{local}) {
                    value{local} = new list<auto>();
                }
                push value{local}, sprintf("%s-%d", local, ++counts{local});
            }
            *string xml;
            string error = "";
            try {
                xml = make_xml({"record": type.serializeValue(schema.nsc.copy(), value, True)});
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err == "THREAD-CANCELLED" || ex.err == "PROGRAM-INTERRUPTED") {
                    rethrow;
                }
                error = ex.err;
            }
            printf("%s\n", make_json({"case": input.name, "copy": copy, "names": names,
                "ordered": ordered, "xml": xml, "error": error}));
        }
    }
}
%endif
