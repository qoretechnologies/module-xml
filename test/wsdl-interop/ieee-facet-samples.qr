#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry

%ifdef NoJson
throw "MISSING-MODULE", "the IEEE sample test requires json";
%else
if (ARGV.size() != 1) {
    throw "USAGE", "ieee-facet-samples.qr CASES.json";
}
list<hash<auto>> rows = parse_json(ReadOnlyFile::readTextFile(ARGV[0]));
foreach hash<auto> row in (rows) {
    string constraints = '<xs:' + row.facet + ' value="' + row.endpoint + '"/>';
    if (exists row.opposite) {
        constraints += '<xs:' + row.opposite + ' value="' + row.next + '"/>';
    }
    XsdSchema original('<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:ieee-samples"
        targetNamespace="urn:ieee-samples"><xs:simpleType name="Value"><xs:restriction base="xs:' + row.builtin + '">'
        + constraints + '</xs:restriction></xs:simpleType></xs:schema>', {"async_only": True});
    list<hash<auto>> results();
    foreach XsdSchema schema in (original, Serializable::deserialize(original.serialize())) {
        XsdSimpleType type = cast<XsdSimpleType>(schema.findType(make_qname("urn:ieee-samples", "Value")));
        try {
            auto sample = type.getSampleValue(@nan@);
            string encoded = type.serializeValue(new Namespaces({}), sample, True);
            AbstractDataProviderType provider = Serializable::deserialize(type.getDataProviderType().serialize());
            push results, {"value": type.deserializeValue("value", {}, NOTHING, encoded).toStringRoundTrip(),
                "provider": provider.acceptsValue(sample).toStringRoundTrip()};
        } catch (hash<ExceptionInfo> ex) {
            push results, {"err": ex.err, "desc": ex.desc};
        }
    }
    printf("%s\n", make_json({"id": row.id, "results": results}));
}
%endif
