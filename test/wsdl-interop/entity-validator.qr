#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%requires xml
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "ENTITY validation tests require json";
%else
if (ARGV.size() != 1) {
    throw "USAGE", "entity-validator.qr fixtures.json";
}
hash<auto> fixture = parse_json(ReadOnlyFile::readTextFile(ARGV[0]));
foreach string name in (keys fixture.schemas) {
    hash<auto> result();
    result.name = name;
    result.stage = "schema";
    result.valid = True;
    try {
        XmlReader reader(new StringInputStream("<value/>"), {"xsd": fixture.schemas{name}});
    } catch (hash<ExceptionInfo> ex) {
        if (ex.err != "XSD-SYNTAX-ERROR") {
            rethrow;
        }
        result.valid = False;
        result.error = ex.err;
    }
    printf("%s\n", make_json(result));
}
foreach hash<auto> row in (fixture.rows) {
    hash<auto> result();
    result.name = row.name;
    foreach string method in ("parse", "doc", "reader", "cursor", "grouped", "attached-text", "attached-file") {
        result{method} = True;
        try {
            if (method == "doc") {
                XmlDoc doc(row.xml);
                doc.validateSchema(row.schema);
            } else if (method == "parse") {
                result.preserved = parse_xml(row.xml) == parse_xml_with_schema(row.xml, row.schema);
            } else {
                XmlReader reader(new StringInputStream(row.xml),
                    method == "attached-text" || method == "attached-file" ? NOTHING : {"xsd": row.schema});
                if (method == "attached-text") {
                    reader.schemaValidateString(row.schema);
                } else if (method == "attached-file") {
                    reader.schemaValidate(ARGV[0] + ".schemas/" + row.group + ".xsd");
                }
                if (method == "reader") {
                    string text = "";
                    while (reader.read()) {
                        if (reader.nodeType() == XML_NODE_TYPE_TEXT || reader.nodeType() == XML_NODE_TYPE_CDATA
                                || reader.nodeType() == XML_NODE_TYPE_WHITESPACE
                                || reader.nodeType() == XML_NODE_TYPE_SIGNIFICANT_WHITESPACE) {
                            text += reader.value();
                        } else if (reader.nodeType() == XML_NODE_TYPE_ELEMENT) {
                            result.element = reader.name();
                            result.attribute = reader.getAttribute("category");
                        }
                    }
                    result.text = text;
                } else {
                    bool root_seen = False;
                    while (reader.read()) {
                        if (reader.nodeType() == XML_NODE_TYPE_ELEMENT) {
                            root_seen = True;
                            break;
                        }
                    }
                    @assert(root_seen);
                    result{method + "_value"} = method == "grouped" ? reader.toQoreData() : reader.toQore();
                    @assert(!reader.read());
                }
                result{method} = reader.isValid();
            }
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != (method == "doc" ? "XSD-ERROR" : "PARSE-XML-EXCEPTION")) {
                rethrow;
            }
            result{method} = False;
            result{method + "_error"} = ex.err;
        }
    }
    printf("%s\n", make_json(result));
}
%endif
