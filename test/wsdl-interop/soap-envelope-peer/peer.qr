#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires ../../../qlib/WSDL.qm
%requires ../../../qlib/SoapClient.qm
%requires ../../../qlib/SoapHandler.qm
%requires HttpServer
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "SOAP envelope integration requires json";
%else
@assert(ARGV.size() >= 1);
string source = ReadOnlyFile::readTextFile(get_script_dir() + "/contract.wsdl");
if (ARGV[0] == "server") {
    @assert(ARGV.size() == 4);
    WebService ws(source);
    if (ARGV[2] == "saved") { ws = Serializable::deserialize(ws.serialize()); }
    if (ARGV[2] == "data") { ws = Serializable::deserialize(ws.serializeToData()); }
    HttpServer server();
    on_exit server.stop();
    SoapHandler handler(new PermissiveAuthenticator());
    server.setDefaultHandler("envelope", handler);
    Queue received();
    code<auto(hash<auto>, auto)> callback = auto sub(hash<auto> cx, auto value) {
        received.push(value);
        return {"body":value};
    };
    handler.addMethod(ws, ws.getOperation("echo"), callback, NOTHING, NOTHING, NOTHING,
        "service", NOTHING, NOTHING, "B" + ARGV[1]);
    server.addListener(0);
    printf("READY\t%d\n", server.getListenerInfo(0).port);
    @assert(trim(stdin.readLine() ?? "") == "STOP");
    server.stop();
    @assert(received.size() == int(ARGV[3]));
    while (received.size()) { @assert(received.get(1000) == "invoice-71"); }
} else if (ARGV[0] == "faults") {
    WebService ws(source);
    list<string> result();
    foreach string binding in ("B11", "B12") {
        result += ws.getOperation("echo").serializeFault(NOTHING, "Invoice not found", NOTHING,
            NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, binding).body;
    }
    printf("%s\n", make_json(result));
} else {
    @assert(ARGV[0] == "client");
    list<auto> results();
    *SoapClient client;
    string selected;
    foreach hash<auto> job in (parse_json(stdin.readLine()).jobs) {
        string identity = job.state + ":" + job.version + ":" + string(job.retained);
        if (identity != selected) {
            WebService ws(source);
            if (job.state == "saved") { ws = Serializable::deserialize(ws.serialize()); }
            if (job.state == "data") { ws = Serializable::deserialize(ws.serializeToData()); }
            client = new SoapClient({"wsdl":ws,"port":"Port" + job.version,"url":job.url,
                "timeout":10000,"connect_timeout":10000});
            selected = identity;
        }
        hash<auto> result();
        try {
            auto value = client.callOperation("echo", {"body":"invoice-71"}, {"xml_values":job.retained});
            result.value = job.retained ? value.body.body.getElementData()."^value^" : value;
        } catch (hash<ExceptionInfo> ex) {
            result.error = ex.err;
        }
        results += result;
    }
    printf("%s\n", make_json(results));
}
%endif
