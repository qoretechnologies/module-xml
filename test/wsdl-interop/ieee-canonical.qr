#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "canonical IEEE tests require json";
%else
if (ARGV.size() != 1) {
    throw "USAGE", "ieee-canonical.qr CASES.json";
}
foreach hash<auto> row in (parse_json(ReadOnlyFile::readTextFile(ARGV[0]))) {
    *string canonical;
    *string error;
    try {
        canonical = canonical_xsd_float(row.text, row.wide);
    } catch (hash<ExceptionInfo> ex) {
        error = ex.err;
    }
    printf("%s\n", make_json({"id":row.id, "canonical":canonical, "error":error}));
}
%endif
