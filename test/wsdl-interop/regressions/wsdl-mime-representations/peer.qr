#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires ../../../../qlib/WSDL.qm
%requires ../../../../qlib/SoapClient.qm
%requires ../../../../qlib/SoapHandler.qm
%requires HttpServer
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "MIME peer tests require json";
%else
@assert(ARGV.size() >= 3);
hash<auto> config=parse_json(ReadOnlyFile::readTextFile(ARGV[1]));
WebService ws(config.xml,{"async_only":True});
if (ARGV[2]=="saved") {
    ws=Serializable::deserialize(ws.serialize());
}
bool opaque=config.selector.startsWith("content:");
hash<auto> expected=opaque ? {"payload":{"^value^":"é < &", "^attributes^":{"^content-type^":config.media}}}
    : {"payload":"é < &"};
if (ARGV[0]=="client") {
    @assert(ARGV.size()==4);
    SoapClient client({"wsdl":ws,"url":ARGV[3],"timeout":10000,"connect_timeout":5000});
    auto result=client.callOperation("call",expected,{"http_header":{"Content-Type":config.media},
        "request_mime_format":config.selector,"response_mime_format":config.selector});
    @assert(result==expected,sprintf("unexpected response %Y",result));
    printf("PASS\n");
} else {
    @assert(ARGV[0]=="server");
    HttpServer server();
    on_exit server.stop();
    SoapHandler handler(new PermissiveAuthenticator());
    server.setDefaultHandler("mime",handler);
    Queue received();
    code<auto(hash<auto>,auto)> callback=auto sub(hash<auto> cx,auto args) {
        @assert(args==expected,sprintf("unexpected input %Y",args));
        received.push(True);
        return expected;
    };
    handler.addMethod(ws,ws.getOperation("call"),callback,NOTHING,NOTHING,NOTHING,NOTHING,NOTHING,NOTHING,"B",NOTHING,
        False,False,config.overlap ? config.selector : NOTHING,config.selector);
    server.addListener(0);
    printf("READY\t%d\n",server.getListenerInfo(0).port);
    @assert(trim(stdin.readLine())=="STOP");
    @assert(received.get(1000)==True);
}
%endif
