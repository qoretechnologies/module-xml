<w:definitions xmlns:w="http://schemas.xmlsoap.org/wsdl/" xmlns:t="urn:ops" xmlns:s="http://schemas.xmlsoap.org/wsdl/soap/" targetNamespace="urn:ops">
  <w:message name="M"/>
  <w:portType name="P">
    <w:operation name="lookup">
      <w:input name="ById" message="t:M"/>
    </w:operation>
    <w:operation name="lookup">
      <w:input name="ByName" message="t:M"/>
    </w:operation>
  </w:portType>
  <w:binding name="B" type="t:P">
    <s:binding transport="http://schemas.xmlsoap.org/soap/http"/>
    <w:operation name="lookup">
      <w:input>
        <s:body use="literal"/>
      </w:input>
    </w:operation>
  </w:binding>
</w:definitions>
