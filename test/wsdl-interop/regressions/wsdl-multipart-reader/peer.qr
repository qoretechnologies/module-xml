#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires ../../../../qlib/WSDL.qm
%requires ../../../../qlib/SoapClient.qm
%requires ../../../../qlib/SoapHandler.qm
%requires HttpServer

@assert(ARGV.size() >= 2);
string source = '<w:definitions xmlns:w="http://schemas.xmlsoap.org/wsdl/" xmlns:s="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:x="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:reader" targetNamespace="urn:reader">'
    + '<w:types><x:schema><x:element name="payload" type="x:string"/></x:schema></w:types>'
    + '<w:message name="In"><w:part name="payload" element="payload"/></w:message><w:message name="Out"><w:part name="payload" element="payload"/></w:message>'
    + '<w:portType name="P"><w:operation name="call"><w:input message="t:In"/><w:output message="t:Out"/></w:operation></w:portType>'
    + '<w:binding name="B" type="t:P"><s:binding transport="http://schemas.xmlsoap.org/soap/http" style="document"/><w:operation name="call"><s:operation soapAction="urn:call"/>'
    + '<w:input><s:body use="literal"/></w:input><w:output><s:body use="literal"/></w:output></w:operation></w:binding>'
    + '<w:service name="S"><w:port name="Endpoint" binding="t:B"><s:address location="http://example.invalid/service"/></w:port></w:service></w:definitions>';
WebService ws(source, {"async_only":True});
if (ARGV[1].startsWith("saved")) {
    ws = Serializable::deserialize(ws.serializeToData());
}
bool retained = ARGV[1].endsWith("xml");
if (ARGV[0].startsWith("client")) {
    @assert(ARGV.size() == 3);
    SoapClient client({"wsdl":ws, "url":ARGV[2], "timeout":10000, "connect_timeout":5000});
    if (ARGV[0] == "client-negative") {
        bool rejected = False;
        try {
            client.callOperation("call", {"payload":"hello"});
        } catch (hash<ExceptionInfo> error) {
            @assert(error.err == "SOAP-MESSAGE-ERROR", sprintf("unexpected error %Y", error));
            rejected = True;
        }
        @assert(rejected);
        printf("PASS\n");
        exit();
    }
    auto result = client.callOperation("call", {"payload":"hello"}, {"xml_values":retained});
    if (retained) {
        @assert(result.body.payload.getXml().contains("hello"));
    } else {
        @assert(result == "hello");
    }
    printf("PASS\n");
} else {
    @assert(ARGV[0] == "server");
    HttpServer server();
    on_exit server.stop();
    SoapHandler handler(new PermissiveAuthenticator());
    server.setDefaultHandler("multipart", handler);
    Queue received();
    code<auto(hash<auto>, auto)> callback = auto sub(hash<auto> cx, auto args) {
        if (retained) {
            @assert(args.body.payload.getXml().contains("hello"));
        } else {
            @assert(args == "hello", sprintf("unexpected input %Y", args));
        }
        received.push(True);
        return {"payload":"hello"};
    };
    handler.addMethod(ws, ws.getOperation("call"), callback, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING,
        NOTHING, NOTHING, retained);
    server.addListener(0);
    printf("READY\t%d\n", server.getListenerInfo(0).port);
    @assert(trim(stdin.readLine()) == "STOP");
    @assert(received.get(1000) == True);
    @assert(received.empty());
}
