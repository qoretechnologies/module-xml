<definitions xmlns="http://schemas.xmlsoap.org/wsdl/" xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:t="urn:qore:measurement" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:soap12="http://schemas.xmlsoap.org/wsdl/soap12/" targetNamespace="urn:qore:measurement">
  <types><xs:schema targetNamespace="urn:qore:measurement">
    <xs:complexType name="Base"><xs:simpleContent><xs:extension base="xs:int">
      <xs:attribute name="unit" type="xs:string" use="required"/>
      <xs:attribute name="note" type="xs:string"/>
    </xs:extension></xs:simpleContent></xs:complexType>
    <xs:complexType name="Extended"><xs:simpleContent>
      <xs:extension xmlns:b="urn:qore:measurement" base="b:Base">
        <xs:attribute name="flag" type="xs:boolean"/>
      </xs:extension>
    </xs:simpleContent></xs:complexType>
    <xs:complexType name="Limited"><xs:simpleContent><xs:restriction base="t:Extended">
      <xs:minInclusive value="1"/><xs:maxInclusive value="3"/>
      <xs:attribute name="note" use="prohibited"/>
    </xs:restriction></xs:simpleContent></xs:complexType>
    <xs:element name="SubmitMeasurement" type="t:Limited"/>
    <xs:element name="MeasurementReply" type="t:Limited"/>
  </xs:schema></types>
  <message name="Request"><part name="measurement" element="t:SubmitMeasurement"/></message>
  <message name="Response"><part name="measurement" element="t:MeasurementReply"/></message>
  <portType name="MeasurementPortType"><operation name="submit">
    <input message="t:Request"/><output message="t:Response"/>
  </operation></portType>
  <binding name="Soap11" type="t:MeasurementPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="submit"><soap:operation soapAction="urn:qore:measurement:submit"/>
      <input><soap:body use="literal"/></input><output><soap:body use="literal"/></output>
    </operation>
  </binding>
  <binding name="Soap12" type="t:MeasurementPortType">
    <soap12:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="submit"><soap12:operation soapAction="urn:qore:measurement:submit"/>
      <input><soap12:body use="literal"/></input><output><soap12:body use="literal"/></output>
    </operation>
  </binding>
  <service name="MeasurementService">
    <port name="Soap11Port" binding="t:Soap11"><soap:address location="http://localhost/measurements"/></port>
    <port name="Soap12Port" binding="t:Soap12"><soap12:address location="http://localhost/measurements"/></port>
  </service>
</definitions>
