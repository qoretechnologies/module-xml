#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry

%ifdef NoJson
throw "MISSING-MODULE", "the WSDL IEEE scalar test requires json";
%else
if (ARGV.size() != 1) {
    throw "USAGE", "ieee-scalars.qr CASES.json";
}
list<hash<auto>> rows = parse_json(ReadOnlyFile::readTextFile(ARGV[0]));
Namespaces ns({});
hash<string, XsdBaseType> types = {"float": ns.getBaseType("float"), "double": ns.getBaseType("double")};
hash<string, AbstractDataProviderType> providers = map {$1: types{$1}.getDataProviderType()}, keys types;
hash<string, AbstractDataProviderType> copies = map {$1: Serializable::deserialize(providers{$1}.serialize())}, keys types;
foreach hash<auto> row in (rows) {
    auto value = row.text;
    switch (row.kind) {
        case "int": value = int(row.text); break;
        case "float": value = float(row.text); break;
        case "number": value = number(row.text); break;
    }
    string builtin = row.wide ? "double" : "float";
    XsdBaseType type = types{builtin};
    string encoded = type.serializeValue(ns, value, True);
    printf("%s\n", make_json({"id": row.id, "values": (
        type.deserializeValue("value", {}, NOTHING, value).toStringRoundTrip(),
        type.deserializeValue("value", {}, NOTHING, encoded).toStringRoundTrip(),
        providers{builtin}.acceptsValue(value).toStringRoundTrip(),
        copies{builtin}.acceptsValue(value).toStringRoundTrip()), "encoded": encoded}));
}
%endif
