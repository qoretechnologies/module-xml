#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry

%ifdef NoJson
throw "MISSING-MODULE", "particle attribution tests require the json module";
%else
if (ARGV.size() != 1) {
    throw "USAGE", "particle-ambiguity.qr CASES.json";
}
foreach hash<auto> input in (parse_json(ReadOnlyFile::readTextFile(ARGV[0]))) {
    *WebService original;
    try {
        original = new WebService(input.wsdl, {"async_only": True});
    } catch (hash<ExceptionInfo> ex) {
        if (ex.err == "PROGRAM-INTERRUPTED" || ex.err == "THREAD-CANCELLED") {
            rethrow;
        }
        printf("%s\n", make_json({"case": input.name, "stage": "construction", "ok": False, "err": ex.err}));
        continue;
    }
    printf("%s\n", make_json({"case": input.name, "stage": "construction", "ok": True}));
    foreach bool copy in (False, True) {
        WebService service = copy ? Serializable::deserialize(original.serialize()) : original;
        WSOperation operation = service.getBindingOperation(input.binding, "submit");
        foreach string direction in ("request", "response") {
            WSMessage message = direction == "request" ? operation.input : operation.output;
            XsdElement element = message.args.firstValue().element;
            XsdParticle particle = cast<XsdComplexType>(element.type).getParticle();
            particle.validateDeterminism();
            printf("%s\n", make_json({"case": input.name, "stage": "bound-part", "copy": copy,
                "direction": direction, "root": element.getExpandedName(), "ok": True}));
        }
    }
}
%endif
