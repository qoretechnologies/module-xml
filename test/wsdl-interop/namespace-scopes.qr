#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
# Resolves the element and attribute names of generated XML documents as SOAP decoding does: parse_xml() with
# preserved order, then XsdBase::expandElementNamespaces(), or that method alone for parsed XML data. Reads a JSON list
# of {"id", "xml"} or {"id", "data"} cases and writes one
# JSON result per case: the expanded element names in document order, each with its expanded attribute names, or
# the rejection.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "namespace scope generation requires json";
%else
# appends the elements of expanded content in document order
sub walk(auto content, reference<list<hash<auto>>> found) {
    if (content.typeCode() != NT_HASH) {
        return;
    }
    foreach string key in (keys content) {
        if (key =~ /^[\^.]/) {
            continue;
        }
        string identity = key;
        # an occurrence suffix separates non-adjacent repetitions of a name
        identity =~ s/\^[0-9]+$//;
        list<auto> occurrences = content{key}.typeCode() == NT_LIST ? content{key} : (content{key},);
        foreach auto child in (occurrences) {
            *hash<auto> attributes = child.typeCode() == NT_HASH ? child."^attributes^" : NOTHING;
            list<string> names = (keys XsdBase::getExpandedAttributes(attributes)) ?? ();
            push found, {"name": identity, "attributes": sort(names)};
            walk(child, \found);
        }
    }
}

if (ARGV.size() != 1) {
    throw "USAGE", "namespace-scopes.qr CASES.json";
}
list<hash<auto>> cases = parse_json(ReadOnlyFile::readTextFile(ARGV[0]));
foreach hash<auto> item in (cases) {
    hash<auto> result();
    result.id = item.id;
    try {
        # parsed XML data can also be supplied directly, as by callers and XML generator data
        hash<auto> expanded = XsdBase::expandElementNamespaces(exists item.data ? item.data
            : parse_xml(item.xml, XPF_PRESERVE_ORDER | XPF_PRESERVE_WHITESPACE));
        list<hash<auto>> found();
        walk(expanded, \found);
        result.elements = found;
    } catch (hash<ExceptionInfo> ex) {
        result.error = ex.err;
        result.desc = ex.desc;
    }
    printf("%s\n", make_json(result));
}
%endif
