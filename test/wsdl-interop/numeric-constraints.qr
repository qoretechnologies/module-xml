#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "Numeric constraint interoperability requires the json module";
%else
WebService sub service(string schema, string version) {
    string soap = "http://schemas.xmlsoap.org/wsdl/soap" + (version == "12" ? "12" : "") + "/";
    return new WebService('<w:definitions xmlns:w="http://schemas.xmlsoap.org/wsdl/" xmlns:s="' + soap
        + '" xmlns:t="urn:qore:numeric-constraints" targetNamespace="urn:qore:numeric-constraints">'
        '<w:types>' + schema + '</w:types>'
        '<w:message name="Input"><w:part name="body" element="value"/></w:message>'
        '<w:message name="Output"><w:part name="body" element="value"/></w:message>'
        '<w:portType name="Port"><w:operation name="submit"><w:input message="t:Input"/>'
        '<w:output message="t:Output"/></w:operation></w:portType>'
        '<w:binding name="Soap" type="t:Port"><s:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>'
        '<w:operation name="submit"><s:operation soapAction="urn:submit"/><w:input><s:body use="literal"/></w:input>'
        '<w:output><s:body use="literal"/></w:output></w:operation></w:binding>'
        '<w:service name="Service"><w:port name="Port" binding="t:Soap">'
        '<s:address location="http://example.invalid/Service"/></w:port></w:service></w:definitions>',
        {"async_only":True});
}
auto sub saved(auto value) {
    return Serializable::deserialize(Serializable::serialize(value));
}
auto sub decode(XsdSchema schema, string xml) {
    auto wire = XsdBase::expandElementNamespaces(parse_xml(xml, XPF_PRESERVE_ORDER));
    return schema.getElement("", "value").deserializeValue(schema.getTypeMap(), NOTHING,
        wire."{}value", True, True);
}
if (ARGV.size() != 1) {
    throw "USAGE", "numeric-constraints.qr FIXTURES.json";
}
foreach hash<auto> model in (parse_json(ReadOnlyFile::readTextFile(ARGV[0]))) {
    *XsdSchema schema;
    *hash<ExceptionInfo> failure;
    try {
        schema = new XsdSchema(model.schema, {"async_only":True});
    } catch (hash<ExceptionInfo> ex) {
        failure = ex;
    }
    printf("%s\n", make_json({"name":model.name,"stage":"schema-construction","error":failure.err}));
    foreach string version in ("11", "12") {
        *WebService ws;
        remove failure;
        try {
            ws = service(model.schema, version);
        } catch (hash<ExceptionInfo> ex) {
            failure = ex;
        }
        printf("%s\n", make_json({"name":model.name,"stage":"soap" + version + "-construction","error":failure.err}));
        if (!ws || !schema) {
            continue;
        }
        foreach bool reconstructed in (False, True) {
            WebService current = reconstructed ? saved(ws) : ws;
            WSOperation operation = current.getBindingOperation("Soap", "submit");
            auto value = decode(schema, model.xml);
            foreach bool response in (False, True) {
                AbstractDataProviderType provider = saved((response ? operation.output : operation.input)
                    .getDataProviderType(True));
                auto prepared = provider.acceptsValue({"body":value});
                hash<auto> wire = response ? operation.serializeResponse(prepared, NOTHING, NOTHING,
                    NOTHING, NOTHING, NOTHING, "Soap") : operation.serializeRequest(prepared, NOTHING,
                    NOTHING, NOTHING, NOTHING, NOTHING, "Soap");
                printf("%s\n", make_json({"name":model.name,"stage":"soap" + version
                    + (response ? "-response" : "-request") + (reconstructed ? "-saved" : "-source"),
                    "xml":wire.body}));
            }
        }
    }
}
%endif
