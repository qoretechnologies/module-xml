#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires ../../../qlib/WSDL.qm
%requires ../../../qlib/SoapHandler.qm
%requires HttpServer
@assert(ARGV.size() == 4);
bool soap12 = ARGV[0] == "12";
string source = ReadOnlyFile::readTextFile(get_script_dir() + "/contract.wsdl");
WebService ws(soap12 ? replace(source,SOAP_11_NS,SOAP_12_NS) : source);
if (ARGV[1] == "saved") { ws = Serializable::deserialize(ws.serialize()); }
if (ARGV[1] == "data") { ws = Serializable::deserialize(ws.serializeToData()); }
bool retained = ARGV[2] == "retained";
Queue received();
SoapHandler handler(new PermissiveAuthenticator());
foreach string name in ("first","second","scalar") {
    handler.addMethod(ws,ws.getBindingOperation("B",name),auto sub(hash<auto> cx, auto value) {
        received.push(cx.operation.name);
        if (cx.soap_action) { @assert(cx.soap_action == "urn:"+cx.operation.name); }
        return {"body":retained ? new XsdXmlValue('<t:value xmlns:t="urn:empty-route">'
            +cx.operation.name+'</t:value>') : cx.operation.name};
    },NOTHING,NOTHING,NOTHING,"service",NOTHING,NOTHING,"B",name,retained);
}
HttpServer server(); on_exit server.stop();
server.setDefaultHandler("actions",handler); server.addListener(0);
printf("READY\t%d\n",server.getListenerInfo(0).port);
@assert(trim(stdin.readLine() ?? "") == "STOP");
server.stop();
@assert(received.size() == int(ARGV[3]));
