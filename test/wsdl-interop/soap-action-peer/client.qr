#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires ../../../qlib/WSDL.qm
%requires ../../../qlib/SoapClient.qm
@assert(ARGV.size() == 2);
bool soap12 = ARGV[0] == "12";
string source = ReadOnlyFile::readTextFile(get_script_dir() + "/contract.wsdl");
if (soap12) { source = replace(source,SOAP_11_NS,SOAP_12_NS); }
foreach string state in ("source","saved","data") {
    WebService ws(source);
    if (state == "saved") { ws = Serializable::deserialize(ws.serialize()); }
    if (state == "data") { ws = Serializable::deserialize(ws.serializeToData()); }
    foreach bool retained in (False,True) {
        SoapClient client({"wsdl":ws,"binding":"B","url":ARGV[1],"timeout":10000});
        foreach *string action in (NOTHING,"urn:override","","HTTP://Example.org/a%2fb") {
            hash<auto> options();
            options.xml_values = retained;
            if (exists action) { options.soapaction = action; }
            auto value = client.callOperation("first",{},options);
            @assert((retained ? value.body.body.getElementData()."^value^" : value) == "external");
        }
    }
}
printf("DONE\n");
