<!-- Operations sharing one SOAP action: the Body element identifies alpha, beta and empty; gamma and void
     repeat the element or the empty Body of another operation with the same action. delta and idle repeat
     the beta element and the empty Body under their own actions. -->
<w:definitions xmlns:w="http://schemas.xmlsoap.org/wsdl/" xmlns:s="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:shared-action" targetNamespace="urn:shared-action">
  <w:types>
    <xs:schema targetNamespace="urn:shared-action">
      <xs:element name="alpha" type="xs:string"/>
      <xs:element name="beta" type="xs:string"/>
      <xs:element name="value" type="xs:string"/>
    </xs:schema>
  </w:types>
  <w:message name="Empty"/>
  <w:message name="Alpha">
    <w:part name="body" element="t:alpha"/>
  </w:message>
  <w:message name="Beta">
    <w:part name="body" element="t:beta"/>
  </w:message>
  <w:message name="Value">
    <w:part name="body" element="t:value"/>
  </w:message>
  <w:portType name="P">
    <w:operation name="alpha">
      <w:input message="t:Alpha"/>
      <w:output message="t:Value"/>
    </w:operation>
    <w:operation name="beta">
      <w:input message="t:Beta"/>
      <w:output message="t:Value"/>
    </w:operation>
    <w:operation name="empty">
      <w:input message="t:Empty"/>
      <w:output message="t:Value"/>
    </w:operation>
    <w:operation name="delta">
      <w:input message="t:Beta"/>
      <w:output message="t:Value"/>
    </w:operation>
    <w:operation name="gamma">
      <w:input message="t:Alpha"/>
      <w:output message="t:Value"/>
    </w:operation>
    <w:operation name="void">
      <w:input message="t:Empty"/>
      <w:output message="t:Value"/>
    </w:operation>
    <w:operation name="idle">
      <w:input message="t:Empty"/>
      <w:output message="t:Value"/>
    </w:operation>
  </w:portType>
  <w:binding name="B" type="t:P">
    <s:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <w:operation name="alpha">
      <s:operation soapAction="urn:shared"/>
      <w:input><s:body use="literal"/></w:input>
      <w:output><s:body use="literal"/></w:output>
    </w:operation>
    <w:operation name="beta">
      <s:operation soapAction="urn:shared"/>
      <w:input><s:body use="literal"/></w:input>
      <w:output><s:body use="literal"/></w:output>
    </w:operation>
    <w:operation name="empty">
      <s:operation soapAction="urn:shared"/>
      <w:input><s:body use="literal"/></w:input>
      <w:output><s:body use="literal"/></w:output>
    </w:operation>
    <w:operation name="delta">
      <s:operation soapAction="urn:delta"/>
      <w:input><s:body use="literal"/></w:input>
      <w:output><s:body use="literal"/></w:output>
    </w:operation>
    <w:operation name="gamma">
      <s:operation soapAction="urn:shared"/>
      <w:input><s:body use="literal"/></w:input>
      <w:output><s:body use="literal"/></w:output>
    </w:operation>
    <w:operation name="void">
      <s:operation soapAction="urn:shared"/>
      <w:input><s:body use="literal"/></w:input>
      <w:output><s:body use="literal"/></w:output>
    </w:operation>
    <w:operation name="idle">
      <s:operation soapAction="urn:idle"/>
      <w:input><s:body use="literal"/></w:input>
      <w:output><s:body use="literal"/></w:output>
    </w:operation>
  </w:binding>
  <w:service name="S">
    <w:port name="P" binding="t:B">
      <s:address location="http://example.invalid/shared"/>
    </w:port>
  </w:service>
</w:definitions>
