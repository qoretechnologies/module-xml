     One route serving the same operations in SOAP 1.1 and SOAP 1.2 bindings. -->
<definitions name="Versions" targetNamespace="urn:versions"
    xmlns="http://schemas.xmlsoap.org/wsdl/" xmlns:tns="urn:versions"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:soap12="http://schemas.xmlsoap.org/wsdl/soap12/">
  <types>
    <xsd:schema targetNamespace="urn:versions" elementFormDefault="qualified">
      <xsd:element name="echo" type="xsd:string"/>
      <xsd:element name="ping" type="xsd:string"/>
      <xsd:element name="reply" type="xsd:string"/>
    </xsd:schema>
  </types>
  <message name="echoIn"><part name="body" element="tns:echo"/></message>
  <message name="pingIn"><part name="body" element="tns:ping"/></message>
  <message name="idleIn"/>
  <message name="replyOut"><part name="body" element="tns:reply"/></message>
  <message name="singleIn"><part name="question" type="xsd:string"/></message>
  <message name="singleOut"><part name="answer" type="xsd:string"/></message>
  <portType name="Doc">
    <operation name="echo"><input message="tns:echoIn"/><output message="tns:replyOut"/></operation>
    <operation name="ping"><input message="tns:pingIn"/><output message="tns:replyOut"/></operation>
    <operation name="idle"><input message="tns:idleIn"/><output message="tns:replyOut"/></operation>
  </portType>
  <portType name="Rpc">
    <operation name="single"><input message="tns:singleIn"/><output message="tns:singleOut"/></operation>
  </portType>
  <binding name="D11" type="tns:Doc">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="echo">
      <soap:operation soapAction="urn:versions:echo"/>
      <input><soap:body use="literal"/></input><output><soap:body use="literal"/></output>
    </operation>
    <operation name="ping">
      <soap:operation soapAction=""/>
      <input><soap:body use="literal"/></input><output><soap:body use="literal"/></output>
    </operation>
    <operation name="idle">
      <soap:operation soapAction=""/>
      <input><soap:body use="literal"/></input><output><soap:body use="literal"/></output>
    </operation>
  </binding>
  <binding name="D12" type="tns:Doc">
    <soap12:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="echo">
      <soap12:operation soapAction="urn:versions:echo"/>
      <input><soap12:body use="literal"/></input><output><soap12:body use="literal"/></output>
    </operation>
    <operation name="ping">
      <soap12:operation/>
      <input><soap12:body use="literal"/></input><output><soap12:body use="literal"/></output>
    </operation>
    <operation name="idle">
      <soap12:operation/>
      <input><soap12:body use="literal"/></input><output><soap12:body use="literal"/></output>
    </operation>
  </binding>
  <binding name="R11" type="tns:Rpc">
    <soap:binding style="rpc" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="single">
      <soap:operation soapAction="urn:versions:single"/>
      <input><soap:body use="encoded" namespace="urn:versions"
        encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/></input>
      <output><soap:body use="encoded" namespace="urn:versions"
        encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/></output>
    </operation>
  </binding>
  <binding name="R12" type="tns:Rpc">
    <soap12:binding style="rpc" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="single">
      <soap12:operation soapAction="urn:versions:single"/>
      <input><soap12:body use="encoded" namespace="urn:versions"
        encodingStyle="http://www.w3.org/2003/05/soap-encoding"/></input>
      <output><soap12:body use="encoded" namespace="urn:versions"
        encodingStyle="http://www.w3.org/2003/05/soap-encoding"/></output>
    </operation>
  </binding>
  <service name="S">
    <port name="D11" binding="tns:D11"><soap:address location="http://localhost/v"/></port>
    <port name="D12" binding="tns:D12"><soap12:address location="http://localhost/v"/></port>
    <port name="R11" binding="tns:R11"><soap:address location="http://localhost/v"/></port>
    <port name="R12" binding="tns:R12"><soap12:address location="http://localhost/v"/></port>
  </service>
</definitions>
