#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry

%ifdef NoJson
throw "MISSING-MODULE", "particle matching tests require the json module";
%else
if (ARGV.size() != 1) {
    throw "USAGE", "particle-matching.qr CASES.json";
}
foreach hash<auto> input in (parse_json(ReadOnlyFile::readTextFile(ARGV[0]))) {
    WebService original(input.wsdl, {"async_only": True});
    foreach bool copy in (False, True) {
        WebService service = copy ? Serializable::deserialize(original.serialize()) : original;
        WSOperation operation = service.getBindingOperation(input.binding, "submit");
        foreach string direction in ("request", "response") {
            WSMessage message = direction == "request" ? operation.input : operation.output;
            XsdElement element = message.args.firstValue().element;
            XsdComplexType type = cast<XsdComplexType>(element.type);
            XsdParticle particle = type.getParticle();
            foreach string document in (keys input.documents) {
                list<string> names = input.documents{document};
                printf("%s\n", make_json({"case": input.name, "copy": copy, "direction": direction,
                    "root": element.getExpandedName(), "document": document,
                    "ok": particle.matchesElementNames(names)}));
            }
        }
    }
}
%endif
