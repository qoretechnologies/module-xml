#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "ordered particle value integration requires json";
%else
if (ARGV.size() != 1) {
    throw "USAGE", "particle-values.qr CASES.json";
}
foreach hash<auto> input in (parse_json(ReadOnlyFile::readTextFile(ARGV[0]))) {
    WebService original(input.wsdl, {"async_only": True});
    foreach bool copy in (False, True) {
        WebService ws = copy ? Serializable::deserialize(original.serialize()) : original;
        WSOperation op = ws.getBindingOperation(input.binding, "submit");
        foreach hash<auto> message in (input.messages) {
            hash<auto> row = {"case": input.name, "copy": copy, "message": message.name,
                "decode_error": "", "encode_error": "", "native_attempted": False, "native_error": ""};
            try {
                hash<auto> parsed = parse_xml(message.envelope, XPF_PRESERVE_ORDER);
                row.native = message.response ? op.deserializeResponse(parsed, input.binding)
                    : op.deserializeRequest(parsed, input.binding);
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err == "THREAD-CANCELLED" || ex.err == "PROGRAM-INTERRUPTED") {
                    rethrow;
                }
                row.decode_error = ex.err;
            }
            if (!row.decode_error) {
                row.native_attempted = True;
                try {
                    row.native_xml = (message.response ? op.serializeResponse(row.native, NOTHING, NOTHING, NOTHING,
                        NOTHING, NOTHING, input.binding) : op.serializeRequest(row.native, NOTHING, NOTHING, NOTHING,
                        NOTHING, NOTHING, input.binding)).body;
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err == "THREAD-CANCELLED" || ex.err == "PROGRAM-INTERRUPTED") {
                        rethrow;
                    }
                    row.native_error = ex.err;
                }
            }
            try {
                XsdXmlValue value(message.payload);
                hash<auto> argument = {"body": value};
                row.xml = (message.response ? op.serializeResponse(argument, NOTHING, NOTHING, NOTHING,
                    NOTHING, NOTHING, input.binding) : op.serializeRequest(argument, NOTHING, NOTHING, NOTHING,
                    NOTHING, NOTHING, input.binding)).body;
                hash<SoapXmlMessageInfo> retained = message.response ? op.deserializeXmlResponse(row.xml, input.binding)
                    : op.deserializeXmlRequest(row.xml, input.binding);
                row.retained = retained.body.body.getXml();
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err == "THREAD-CANCELLED" || ex.err == "PROGRAM-INTERRUPTED") {
                    rethrow;
                }
                row.encode_error = ex.err;
            }
            printf("%s\n", make_json(row));
        }
    }
}
%endif
