#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "NOTATION interoperability tests require json";
%else
foreach hash<auto> model in (parse_json(ReadOnlyFile::readTextFile(ARGV[0]))) {
    if (model.resources) {
        model.schema = replace(model.schema, "notations-import.xsd", get_script_dir() + "/fixtures/notations-import.xsd");
    }
    foreach hash<auto> document in (model.documents) {
        hash<auto> row();
        row.name = document.name;
        try {
            auto value = parse_xml_with_schema(document.xml, model.schema);
            row.dom = True;
            row.dom_preserved = value == parse_xml(document.xml);
        } catch (hash<ExceptionInfo> ex) {
            row.dom = False;
            row.dom_error = ex.err;
        }
        try {
            XmlReader reader(new StringInputStream(document.xml), {"xsd":model.schema});
            while (reader.read()) {
            }
            row.reader = reader.isValid();
        } catch (hash<ExceptionInfo> ex) {
            row.reader = False;
            row.reader_error = ex.err;
        }
        try {
            XmlDoc doc(document.xml);
            doc.validateSchema(model.schema);
            row.document = True;
            row.document_preserved = parse_xml(doc.toString()) == parse_xml(document.xml);
        } catch (hash<ExceptionInfo> ex) {
            row.document = False;
            row.document_error = ex.err;
        }
        printf("%s\n", make_json(row));
    }
}
%endif
