#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "generic value interoperability tests require json";
%else
foreach hash<auto> model in (parse_json(ReadOnlyFile::readTextFile(ARGV[0]))) {
    XsdSchema schema(model.schema, {"async_only":True});
    foreach hash<auto> document in (model.documents) {
        hash<auto> row();
        row.name = document.name;
        XsdXmlValue original(document.xml);
        XsdElement root = schema.getElement(original.getNamespaceUri(), original.getLocalName());
        auto data = XsdBase::expandElementNamespaces(parse_xml(document.xml, XPF_PRESERVE_ORDER)){original.getExpandedName()};
        try {
            auto value = root.deserializeValue(schema.getTypeMap(), NOTHING, data, True, True);
            row.decoded = True;
            row.output = schema.serializeXmlValue(original.getNamespaceUri(), original.getLocalName(), value).getXml();
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "THREAD-CANCELLED" || ex.err == "PROGRAM-INTERRUPTED") {
                rethrow;
            }
            row.error = ex.err;
            row.description = ex.desc;
        }
        try {
            row.direct_output = schema.serializeXmlValue(original.getNamespaceUri(), original.getLocalName(), data ?? "").getXml();
            row.encoded = True;
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "THREAD-CANCELLED" || ex.err == "PROGRAM-INTERRUPTED") {
                rethrow;
            }
            row.encode_error = ex.err;
            row.encode_description = ex.desc;
        }
        try {
            auto checked = root.type.getDataProviderType().acceptsValue(data ?? "");
            row.provider = True;
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "THREAD-CANCELLED" || ex.err == "PROGRAM-INTERRUPTED") {
                rethrow;
            }
            row.provider_error = ex.err;
            row.provider_description = ex.desc;
        }
        try {
            XsdXmlValue checked = schema.validateXmlValue(original);
            row.retained = checked.getXml() == document.xml;
            XsdXmlValue exported = Serializable::deserialize(Serializable::serialize(checked));
            row.retained_output = exported.getXml();
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "THREAD-CANCELLED" || ex.err == "PROGRAM-INTERRUPTED") {
                rethrow;
            }
            row.retained_error = ex.err;
        }
        foreach string path in ("output", "direct_output", "retained_output") {
            if (!row.hasKey(path)) {
                continue;
            }
            try {
                row{path + "_dom"} = parse_xml_with_schema(row{path}, model.schema) == parse_xml(row{path});
                XmlReader reader(new StringInputStream(row{path}), {"xsd":model.schema});
                while (reader.read()) {
                }
                row{path + "_reader"} = reader.isValid();
            } catch (hash<ExceptionInfo> ex) {
                row{path + "_error"} = ex.err;
            }
        }
        printf("%s\n", make_json(row));
    }
}
%endif
