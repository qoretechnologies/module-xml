#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "the calendar boundary worker requires json";
%else
if (ARGV.size() != 1) {
    throw "USAGE", "calendar-value-boundaries.qr MANIFEST";
}
list<hash<auto>> rows = parse_json(ReadOnlyFile::readTextFile(ARGV[0]));
Namespaces namespaces({});
foreach hash<auto> row in (rows) {
    XsdBaseType type = namespaces.getBaseType(row.builtin);
    AbstractDataProviderType provider = Serializable::deserialize(type.getDataProviderType().serialize());
    hash<auto> result();
    result.id = row.id;
    foreach string operation in ("serialize", "deserialize", "provider") {
        try {
            auto converted = operation == "serialize" ? type.serializeValue(namespaces, row.value, True)
                : operation == "deserialize" ? type.deserializeValue("value",
                    new hash<string, XsdAbstractType>(), NOTHING, row.value)
                : provider.acceptsValue(row.value);
            result{operation} = type.serializeValue(namespaces, converted, True);
        } catch (hash<ExceptionInfo> ex) {
            result{operation + "_error"} = ex.err;
        }
    }
    if (exists row.bound) {
        foreach string constraint in ("minInclusive", "minExclusive", "maxInclusive", "maxExclusive", "enumeration") {
            hash<XsdCalendarFacetInfo> facets = <XsdCalendarFacetInfo>{"name": "Boundary", "base_name": row.builtin};
            if (constraint == "enumeration") {
                facets.enumeration = (row.bound,);
            } else {
                facets.bounds{constraint} = row.bound;
            }
            AbstractDataProviderType restricted = Serializable::deserialize(
                new XsdCalendarRestrictionDataType(facets, provider).serialize());
            try {
                auto checked = restricted.acceptsValue(row.value);
                result{constraint} = True;
            } catch (hash<ExceptionInfo> ex) {
                result{constraint + "_error"} = ex.err;
            }
        }
    }
    printf("%s\n", make_json(result));
}
%endif
