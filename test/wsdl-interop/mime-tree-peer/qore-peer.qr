#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires ../../../qlib/WSDL.qm
%requires ../../../qlib/SoapClient.qm
%requires ../../../qlib/SoapHandler.qm
%requires HttpServer
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "MIME tree peer tests require json";
%else
hash<WsdlMimeEntityInfo> sub example() {
    return <WsdlMimeEntityInfo>{"format":"multipart:0","root":1,"parts":(
        <WsdlMimeEntityInfo>{"format":"multipart:0","root":0,"content_id":"inner@peer","parts":(
            <WsdlMimeEntityInfo>{"format":"xml:first","value":"A & č","content_id":"xml@peer"},)},
        <WsdlMimeEntityInfo>{"format":"content:second","value":<00ff0d0a>,"content_id":"binary@peer"})};
}
hash<WsdlMimeSelectionInfo> sub choices() {
    return <WsdlMimeSelectionInfo>{"parts":(<WsdlMimeSelectionInfo>{"parts":(
        <WsdlMimeSelectionInfo>{"format":"xml:first"},)},)};
}
hash<auto> sub normalized(hash<WsdlMimeEntityInfo> node) {
    hash<auto> result();
    result.format=node.format;
    if (exists node.content_id) { result.content_id=node.content_id; }
    if (exists node.parts) {
        result.root=node.root;
        result.parts=map normalized($1), node.parts;
    } else if (node.value.typeCode()==NT_BINARY) { result.hex=node.value.toHex(); }
    else { result.value=node.value; }
    return result;
}
@assert(ARGV.size()>=3);
WebService ws(ReadOnlyFile::readTextFile(ARGV[1]));
if (ARGV[2]=="saved") { ws=Serializable::deserialize(ws.serialize()); }
WSOperation op=ws.getOperation("call");
if (ARGV[0]=="encode") {
    list<auto> results();
    foreach bool request in (True,False) {
        hash<auto> wire=request ? op.serializeRequest({"^mime^":example()}) : op.serializeResponse({"^mime^":example()});
        push results,{"headers":wire.hdr,"body":make_base64_string(binary(wire.body))};
    }
    printf("%s\n",make_json(results));
} else if (ARGV[0]=="decode") {
    hash<auto> wire=parse_json(ReadOnlyFile::readTextFile(ARGV[3]));
    hash<auto> raw={"body":parse_base64_string(wire.body),"content-type":wire.headers."Content-Type"};
    list<auto> results();
    foreach WSOperation current in (op,Serializable::deserialize(op.serialize())) {
        push results,normalized(current.deserializeRequest(raw,NOTHING,False,choices())."^mime^");
        push results,normalized(current.deserializeResponse(raw,NOTHING,False,choices())."^mime^");
    }
    printf("%s\n",make_json(results));
} else if (ARGV[0]=="decode-errors") {
    hash<auto> data=parse_json(ReadOnlyFile::readTextFile(ARGV[3]));
    hash<auto> valid={"body":parse_base64_string(data.valid.body),"content-type":data.valid.headers."Content-Type"};
    int count=0;
    foreach hash<auto> row in (data.cases) {
        hash<auto> raw={"body":parse_base64_string(row.wire.body),"content-type":row.wire.headers."Content-Type"};
        foreach bool request in (True,False) {
            *string failure;
            try {
                auto result=request ? op.deserializeRequest(raw,NOTHING,False,choices())
                    : op.deserializeResponse(raw,NOTHING,False,choices());
            } catch (hash<ExceptionInfo> error) { failure=error.err; }
            @assert(failure==row.error,sprintf("%s: expected %s, got %Y",row.name,row.error,failure));
            auto result=request ? op.deserializeRequest(valid,NOTHING,False,choices())
                : op.deserializeResponse(valid,NOTHING,False,choices());
            @assert(normalized(result."^mime^")==normalized(example()));
            ++count;
        }
    }
    printf("%d\n",count);
} else if (ARGV[0]=="client") {
    SoapClient client({"wsdl":ws,"url":ARGV[3],"timeout":30000,"connect_timeout":10000});
    auto value=client.callOperation("call",{"^mime^":example()},{"response_mime_format":choices()});
    @assert(normalized(value."^mime^")==normalized(example()));
    printf("PASS\n");
} else if (ARGV[0]=="server") {
    HttpServer server();on_exit server.stop();
    SoapHandler handler(new PermissiveAuthenticator());server.setDefaultHandler("mime-tree",handler);
    Queue received();
    code<auto(hash<auto>,auto)> callback=auto sub(hash<auto> cx,auto args) {
        @assert(normalized(args."^mime^")==normalized(example()));
        received.push(True);return {"^mime^":example()};
    };
    handler.addMethod(ws,op,callback,NOTHING,NOTHING,NOTHING,NOTHING,NOTHING,NOTHING,"B",NOTHING,False,False,choices());
    server.addListener(0);printf("READY\t%d\n",server.getListenerInfo(0).port);
    @assert(trim(stdin.readLine())=="STOP");
    @assert(received.get(1000));
} else { throw "MIME-TREE-PEER-ERROR","unknown mode"; }
%endif
