#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "wildcard attribute integration requires json";
%else
auto sub snapshot(auto value) {
    if (value instanceof XsdQNameValue) {
        return {"qname_uri":value.getNamespaceUri(), "qname_local":value.getLocalName()};
    }
    if (value instanceof XsdScopedLexicalValue) {
        return {"lexical":value.getLexicalValue(), "bindings":value.getNamespaceBindings()};
    }
    if (value.typeCode() == NT_HASH) {
        hash<auto> result();
        foreach string key in (keys value) {
            result{key} = snapshot(value{key});
        }
        return result;
    }
    if (value.typeCode() == NT_LIST) {
        return map snapshot($1), value;
    }
    return value;
}
if (ARGV.size() != 1) {
    throw "USAGE", "wildcard-attributes.qr MANIFEST.json";
}
foreach hash<auto> input in (parse_json(ReadOnlyFile::readTextFile(ARGV[0]))) {
    WebService original(input.wsdl, {"async_only":True, "xsd_cache":input.resources});
    foreach bool copy in (False, True) {
        WebService ws = copy ? Serializable::deserialize(original.serialize()) : original;
        WSOperation op = ws.getBindingOperation("Soap", "submit");
        foreach bool response in (False, True) {
            WSMessage message = response ? op.output : op.input;
            AbstractDataProviderType provider = Serializable::deserialize(message.getDataProviderType(True).serialize());
            foreach hash<auto> document in (input.documents) {
                hash<auto> row = {"name":input.name, "copy":copy, "response":response, "document":document.name};
                string envelope = '<e:Envelope xmlns:e="' + input.envelope + '"><e:Body>' + document.xml
                    + '</e:Body></e:Envelope>';
                try {
                    auto value = response ? op.deserializeResponse(parse_xml(envelope, XPF_PRESERVE_ORDER), "Soap", True)
                        : op.deserializeRequest(parse_xml(envelope, XPF_PRESERVE_ORDER), "Soap", True);
                    row.native = snapshot(value);
                    value = provider.acceptsValue({"body":Serializable::deserialize(Serializable::serialize(value))}).body;
                    row.provider = snapshot(value);
                    row.xml = (response ? op.serializeResponse({"body":value}, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, "Soap")
                        : op.serializeRequest({"body":value}, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, "Soap")).body;
                    row.standalone = ws.serializeXmlValue(input.uri, "Container", value).getXml();
                    hash<SoapXmlMessageInfo> retained = response ? op.deserializeXmlResponse(envelope, "Soap")
                        : op.deserializeXmlRequest(envelope, "Soap");
                    row.retained = retained.body.body.getXml();
                } catch (hash<ExceptionInfo> error) {
                    if (error.err == "PROGRAM-INTERRUPTED" || error.err == "THREAD-CANCELLED") {
                        throw error.err, error.desc, error.arg;
                    }
                    row.error = error.err;
                    row.description = error.desc;
                }
                printf("%s\n", make_json(row));
            }
        }
    }
}
%endif
