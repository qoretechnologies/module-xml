#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry

%ifdef NoJson
throw "MISSING-MODULE", "the reference-permission consumer test requires json";
%else
if (ARGV.size() != 3) {
    throw "USAGE", "reference-permissions.qr DESCRIPTION.wsdl BINDING FOREIGN.xsd";
}
WebService original(ReadOnlyFile::readTextFile(ARGV[0]), {"async_only": True,
    "xsd_cache": {"https://example.invalid/reference-permissions/foreign.xsd": ReadOnlyFile::readTextFile(ARGV[2])}});
WebService ws = Serializable::deserialize(original.serialize());
WSOperation op = ws.getBindingOperation(ARGV[1], "submit");
foreach string direction in ("request", "response") {
    WSMessage message = direction == "request" ? op.input : op.output;
    XsdElement elem = message.args.firstValue().element;
    foreach string kind in ("native", "example") {
        auto value = kind == "native" ? {"child": 0, "^attributes^": {"A": False}}
            : new WSMessageHelper(ws).getMessage(message){elem.name};
        value = elem.getDataProviderType().acceptsValue(value);
        hash<auto> input_value = {elem.name: value};
        hash<auto> wire = direction == "request"
            ? op.serializeRequest(input_value, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, ARGV[1])
            : op.serializeResponse(input_value, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, ARGV[1]);
        printf("%s\n", make_json({"direction": direction, "kind": kind, "value": value, "body": wire.body}));
    }
}
%endif
