#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "particle corpus integration requires json";
%else
if (ARGV.size() != 1) {
    throw "USAGE", "particle-corpus.qr CASES.json";
}
foreach hash<auto> input in (parse_json(ReadOnlyFile::readTextFile(ARGV[0]))) {
    WebService original(input.wsdl, {"async_only": True});
    foreach bool copy in (False, True) {
        WebService ws = copy ? Serializable::deserialize(original.serialize()) : original;
        WSOperation op = ws.getBindingOperation(input.binding, input.operation);
        foreach hash<auto> message in (input.messages) {
            foreach bool response in (False, True) {
                hash<auto> row = {"case": input.name, "file": message.file, "copy": copy,
                    "response": response, "native_error": "", "retained_error": ""};
                try {
                    hash<auto> parsed = parse_xml(message.envelope, XPF_PRESERVE_ORDER);
                    auto value = response ? op.deserializeResponse(parsed, input.binding)
                        : op.deserializeRequest(parsed, input.binding);
                    row.native_xml = (response ? op.serializeResponse(value, NOTHING, NOTHING, NOTHING,
                        NOTHING, NOTHING, input.binding) : op.serializeRequest(value, NOTHING, NOTHING,
                        NOTHING, NOTHING, NOTHING, input.binding)).body;
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err == "THREAD-CANCELLED" || ex.err == "PROGRAM-INTERRUPTED") {
                        rethrow;
                    }
                    row.native_error = ex.err;
                }
                try {
                    hash<SoapXmlMessageInfo> retained = response
                        ? op.deserializeXmlResponse(message.envelope, input.binding)
                        : op.deserializeXmlRequest(message.envelope, input.binding);
                    row.parts = keys retained.body;
                    @assert(row.parts.size() == 1);
                    row.retained = retained.body{row.parts[0]}.getXml();
                    row.retained_xml = (response ? op.serializeResponse(retained.body, NOTHING, NOTHING, NOTHING,
                        NOTHING, NOTHING, input.binding) : op.serializeRequest(retained.body, NOTHING, NOTHING,
                        NOTHING, NOTHING, NOTHING, input.binding)).body;
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err == "THREAD-CANCELLED" || ex.err == "PROGRAM-INTERRUPTED") {
                        rethrow;
                    }
                    row.retained_error = ex.err;
                }
                printf("%s\n", make_json(row));
            }
        }
    }
}
%endif
