#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%try-module json
%define NoJson
%endtry

%ifdef NoJson
throw "MISSING-MODULE", "the native particle count test requires the json module";
%else
if (ARGV.size() != 1) {
    throw "USAGE", "particle-counts.qr CASES.json";
}
foreach hash<auto> input in (parse_json(ReadOnlyFile::readTextFile(ARGV[0]))) {
    foreach string api in ("reader", "data") {
        foreach string name in (keys input.documents) {
            hash<auto> row = {"schema": input.name, "api": api, "document": name, "ok": False};
            try {
                if (api == "reader") {
                    XmlReader reader(new StringInputStream(input.documents{name}), {"xsd": input.schema});
                    while (reader.read()) {
                    }
                    @assert(reader.isValid());
                } else {
                    hash<auto> parsed = parse_xml_with_schema(input.documents{name}, input.schema);
                    @assert(parsed.hasKey("r"));
                }
                row.ok = True;
            } catch (hash<ExceptionInfo> error) {
                if (error.err == "PROGRAM-INTERRUPTED" || error.err == "THREAD-CANCELLED") {
                    rethrow;
                }
                row.ok = False;
                row.err = error.err;
                row.desc = error.desc;
            }
            printf("%s\n", make_json(row));
        }
    }
}
%endif
