#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry

%ifdef NoJson
throw "MISSING-MODULE", "the integer consumer test requires json";
%else
if (ARGV.size() != 1) {
    throw "USAGE", "integer-consumers.qr MANIFEST.json";
}
list<hash<auto>> cases = parse_json(ReadOnlyFile::readTextFile(ARGV[0]));
foreach hash<auto> spec in (cases) {
    WebService original(ReadOnlyFile::readTextFile(spec.wsdl), {"async_only": True});
    int copy = 0;
    foreach WebService ws in (original, Serializable::deserialize(original.serialize())) {
        WSOperation op = ws.getBindingOperation(spec.binding, "submit");
        foreach bool response in (False, True) {
            WSMessage message = response ? op.output : op.input;
            XsdElement element = message.args.firstValue().element;
            AbstractDataProviderType provider = element.getDataProviderType();
            provider = Serializable::deserialize(provider.serialize());
            auto converted = provider.acceptsValue({"^value^": spec.value, "^attributes^": {"count": spec.value}});
            hash<auto> argument = {element.name: converted};
            hash<auto> wire = response ? op.serializeResponse(argument, NOTHING, NOTHING, NOTHING, NOTHING,
                NOTHING, spec.binding) : op.serializeRequest(argument, NOTHING, NOTHING, NOTHING, NOTHING,
                NOTHING, spec.binding);
            hash<auto> sample = new WSMessageHelper(ws).getMessage(message);
            hash<auto> example = response ? op.serializeResponse(sample, NOTHING, NOTHING, NOTHING, NOTHING,
                NOTHING, spec.binding) : op.serializeRequest(sample, NOTHING, NOTHING, NOTHING, NOTHING,
                NOTHING, spec.binding);
            printf("%s\n", make_json({"datatype": spec.datatype, "version": spec.version, "copy": copy,
                "direction": response ? "response" : "request", "value": converted,
                "body": wire.body, "example": example.body}));
        }
        ++copy;
    }
}
%endif
