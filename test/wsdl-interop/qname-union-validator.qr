#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%requires xml
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "the QName union validation diagnostic requires json";
%else
if (ARGV.size() != 1) {
    throw "USAGE", "qname-union-validator.qr fixtures.json";
}
hash<auto> fixture = parse_json(ReadOnlyFile::readTextFile(ARGV[0]));
foreach hash<auto> row in (fixture.rows) {
    hash<auto> result();
    result.name = row.name;
    foreach string method in ("parse", "reader") {
        result{method} = True;
        try {
            if (method == "parse") {
                result.preserved = parse_xml(row.xml) == parse_xml_with_schema(row.xml, row.schema);
            } else {
                XmlReader reader(new StringInputStream(row.xml), {"xsd": row.schema});
                string text = "";
                while (reader.read()) {
                    if (reader.nodeType() == XML_NODE_TYPE_TEXT) {
                        text += reader.value();
                    } else if (reader.nodeType() == XML_NODE_TYPE_ELEMENT) {
                        result.element = reader.name();
                        result.attribute = reader.getAttribute("category");
                    }
                }
                result.text = text;
                result.reader = reader.isValid();
            }
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "PARSE-XML-EXCEPTION") {
                rethrow;
            }
            result{method} = False;
            result{method + "_error"} = ex.err;
        }
    }
    printf("%s\n", make_json(result));
}
%endif
