#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "element substitution integration requires json";
%else
if (ARGV.size() != 1) {
    throw "USAGE", "element-substitution-groups.qr CASES.json";
}
foreach hash<auto> input in (parse_json(ReadOnlyFile::readTextFile(ARGV[0]))) {
    XsdSchema original(input.schema, {"async_only": True});
    foreach bool copy in (False, True) {
        XsdSchema schema = copy ? Serializable::deserialize(original.serialize()) : original;
        XsdElement head = schema.getElement(input.uri, input.head);
        printf("%s\n", make_json({"name": input.name, "copy": copy,
            "members": sort(keys head.getSubstitutionGroup())}));
    }
    foreach hash<auto> document in (input.documents) {
        string error = "";
        try {
            XmlReader reader(document.xml);
            reader.schemaValidateString(input.schema);
            while (reader.read()) {
            }
            if (!reader.isValid()) {
                error = "XSD-VALIDATION-ERROR";
            }
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "THREAD-CANCELLED" || ex.err == "PROGRAM-INTERRUPTED") {
                rethrow;
            }
            error = ex.err;
        }
        printf("%s\n", make_json({"name": input.name, "document": document.name, "error": error}));
    }
}
%endif
