#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "mixed content interoperability tests require json";
%else
foreach hash<auto> model in (parse_json(ReadOnlyFile::readTextFile(ARGV[0]))) {
    XsdSchema schema(model.schema, {"async_only": True});
    XsdSchema restored = Serializable::deserialize(schema.serialize());
    hash<string, WebService> services();
    foreach string binding in (keys model.bindings) {
        services{binding} = Serializable::deserialize(new WebService(model.bindings{binding},
            {"async_only": True}).serialize());
    }
    foreach hash<auto> document in (model.documents) {
        hash<auto> row = {} + {"name": document.name};
        XsdXmlValue original(document.xml);
        XsdElement root = schema.getElement(original.getNamespaceUri(), original.getLocalName());
        auto data = XsdBase::expandElementNamespaces(original.getXmlDataView()){original.getExpandedName()};
        hash<string, string> outputs();
        try {
            auto value = root.deserializeValue(schema.getTypeMap(), NOTHING, data, True, True);
            row.decoded = True;
            auto retained = Serializable::deserialize(Serializable::serialize(value));
            outputs.native = restored.serializeXmlValue(original.getNamespaceUri(), original.getLocalName(), retained).getXml();
            AbstractDataProviderType native = restored.getNativeDataProviderType(original.getNamespaceUri(), original.getLocalName());
            foreach AbstractDataProviderType provider in (native, native.getSoftType(),
                    Serializable::deserialize(native.serialize())) {
                auto checked = provider.acceptsValue(retained);
                outputs{"provider" + outputs.size()} = restored.serializeXmlValue(original.getNamespaceUri(),
                    original.getLocalName(), checked).getXml();
            }
            if (!model.selected) {
                AbstractDataProviderType ordinary = restored.getElement(original.getNamespaceUri(),
                    original.getLocalName()).getDataProviderType();
                foreach AbstractDataProviderType provider in (ordinary, ordinary.getSoftType(),
                        Serializable::deserialize(ordinary.serialize())) {
                    auto checked = provider.acceptsValue(retained);
                    outputs{"ordinary" + outputs.size()} = restored.serializeXmlValue(original.getNamespaceUri(),
                        original.getLocalName(), checked).getXml();
                }
            }
        } catch (hash<ExceptionInfo> error) {
            if (error.err == "THREAD-CANCELLED" || error.err == "PROGRAM-INTERRUPTED") {
                rethrow;
            }
            row.error = error.err;
            row.description = error.desc;
        }
        try {
            outputs.retained = restored.validateXmlValue(original).getXml();
            row.retained = True;
        } catch (hash<ExceptionInfo> error) {
            if (error.err == "THREAD-CANCELLED" || error.err == "PROGRAM-INTERRUPTED") {
                rethrow;
            }
            row.retained_error = error.err;
        }
        row.outputs = outputs;
        list<hash<auto>> messages();
        foreach hash<auto> message in (document.messages) {
            hash<auto> result = {} + {"binding": message.binding, "direction": message.direction};
            bool response = message.direction == "response";
            WSOperation operation = services{message.binding}.getBindingOperation(message.binding, "submit");
            try {
                auto parsed = parse_xml(message.xml, XPF_PRESERVE_ORDER | XPF_ADD_COMMENTS);
                auto value = response ? operation.deserializeResponse(parsed, message.binding, True)
                    : operation.deserializeRequest(parsed, message.binding, True);
                result.decoded = True;
                AbstractDataProviderType provider = Serializable::deserialize((response ? operation.output
                    : operation.input).getDataProviderType(True).serialize());
                auto retained = provider.acceptsValue({"body": Serializable::deserialize(Serializable::serialize(value))});
                result.output = (response
                    ? operation.serializeResponse(retained, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, message.binding)
                    : operation.serializeRequest(retained, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, message.binding)).body;
            } catch (hash<ExceptionInfo> error) {
                if (error.err == "THREAD-CANCELLED" || error.err == "PROGRAM-INTERRUPTED") {
                    rethrow;
                }
                result.error = error.err;
                result.description = error.desc;
            }
            push messages, result;
        }
        row.messages = messages;
        printf("%s\n", make_json(row));
    }
}
%endif
