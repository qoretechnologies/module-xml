#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires ../../../qlib/WSDL.qm
%requires ../../../qlib/SoapHandler.qm
%requires HttpServer
@assert(ARGV.size() == 5);
string source = ReadOnlyFile::readTextFile(get_script_dir() + "/../soap-envelope-peer/contract.wsdl");
bool one_way = ARGV[4] == "one-way";
if (one_way) {
    source = replace(source, '<w:output message="t:Value"/>', '');
    source = replace(source, '<w:output><s:body use="literal"/></w:output>', '');
    source = replace(source, '<w:output><s12:body use="literal"/></w:output>', '');
}
WebService ws(source);
if (ARGV[1] == "saved") { ws = Serializable::deserialize(ws.serialize()); }
if (ARGV[1] == "data") { ws = Serializable::deserialize(ws.serializeToData()); }
bool retained = ARGV[2] == "retained";
Queue headers(); Queue calls();
SoapProcessingNode node(<SoapNodeOptions>{"processors": {"{urn:headers}Track":
    auto sub(hash<auto> cx, hash<SoapNodeHeader> header) { headers.push(header.name); }}});
SoapHandler handler(new PermissiveAuthenticator(), NOTHING, False, NOTHING, node);
handler.addMethod(ws, ws.getBindingOperation("B" + ARGV[0], "echo"), auto sub(hash<auto> cx, auto value) {
    @assert((retained ? value.body.body.getElementData()."^value^" : value) == "response");
    calls.push(cx.operation.name);
    if (!one_way) {
        return {"body": retained ? new XsdXmlValue('<t:value xmlns:t="urn:soap-envelope-test">response</t:value>') : "response"};
    }
}, NOTHING, NOTHING, NOTHING, "service", NOTHING, NOTHING, "B" + ARGV[0], "echo", retained);
HttpServer server(); on_exit server.stop();
server.setDefaultHandler("transport", handler); server.addListener(0);
printf("READY\t%d\n", server.getListenerInfo(0).port);
@assert(trim(stdin.readLine() ?? "") == "STOP");
server.stop();
@assert(calls.size() == int(ARGV[3]));
@assert(headers.size() == calls.size());
