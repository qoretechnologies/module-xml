#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires ../../qlib/WSDL.qm
%requires xml
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "notation declaration checks require json";
%else
foreach hash<auto> model in (parse_json(ReadOnlyFile::readTextFile(ARGV[0]))) {
    hash<auto> result();
    result.name = model.name;
    try {
        hash<auto> parsed = parse_xml_with_schema(model.xml, model.schema);
        result.native = True;
    } catch (hash<ExceptionInfo> ex) {
        result.native = False;
        result.native_error = ex.err;
    }
    try {
        XsdSchema original(model.schema, {"async_only": True});
        list<auto> metadata();
        foreach XsdSchema current in (original, Serializable::deserialize(original.serialize())) {
            Namespaces retained({}, current.nsc);
            Namespaces saved = Serializable::deserialize(retained.serialize());
            foreach Namespaces namespaces in (current.nsc, retained, saved) {
                metadata += namespaces.getNotation(model.key);
            }
        }
        result.wsdl = True;
        result.metadata = metadata;
    } catch (hash<ExceptionInfo> ex) {
        result.wsdl = False;
        result.wsdl_error = ex.err;
    }
    printf("%s\n", make_json(result));
}
%endif
