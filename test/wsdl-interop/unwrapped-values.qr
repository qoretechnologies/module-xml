#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry

%ifdef NoJson
throw "MISSING-MODULE", "the unwrapped value consumer test requires json";
%else
if (ARGV.size() != 3) {
    throw "USAGE", "unwrapped-values.qr DESCRIPTION.wsdl BINDING MODEL";
}
WebService original(ReadOnlyFile::readTextFile(ARGV[0]), {"async_only": True});
WebService ws = Serializable::deserialize(original.serialize());
WSOperation op = ws.getBindingOperation(ARGV[1], "submit");
foreach string direction in ("request", "response") {
    hash<auto> value();
    if (ARGV[2] == "wildcard" || ARGV[2] == "header") {
        value = {"{urn:first}item": "0", "{urn:second}item": "false", "{}empty": ""};
    } else {
        value.flag = False;
        if (ARGV[2] == "sequence") {
            value.count = 0;
        }
    }
    foreach string mode in ("bare", "wrapped", "message") {
        hash<auto> input_value();
        if (mode == "wrapped") {
            input_value.body = value;
        } else {
            input_value += value;
        }
        if (ARGV[2] == "header") {
            input_value.context = "account1";
        }
        if (mode == "message") {
            input_value = {direction == "request" ? "Request" : "Response": input_value};
        }
        hash<auto> wire = direction == "request"
            ? op.serializeRequest(input_value, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, ARGV[1])
            : op.serializeResponse(input_value, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, ARGV[1]);
        printf("%s\n", make_json({"direction": direction, "mode": mode, "body": wire.body}));
    }
}
%endif
