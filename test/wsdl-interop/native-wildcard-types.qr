#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "native wildcard instance-type tests require json";
%else
if (ARGV.size() != 1) {
    throw "USAGE", "native-wildcard-types.qr MANIFEST.json";
}
foreach hash<auto> model in (parse_json(ReadOnlyFile::readTextFile(ARGV[0]))) {
    if (exists model.valid) {
        hash<auto> row();
        row.model = model.name;
        try {
            XmlReader reader("<probe/>");
            reader.schemaValidateString(model.schema);
            row.schema = True;
        } catch (hash<ExceptionInfo> error) {
            if (error.err == "PROGRAM-INTERRUPTED" || error.err == "THREAD-CANCELLED") {
                throw error.err, error.desc, error.arg;
            }
            row.schema = False;
            row.error = error.err;
            row.description = error.desc;
        }
        printf("%s\n", make_json(row));
        continue;
    }
    foreach hash<auto> document in (model.documents) {
        hash<auto> row();
        row.model = model.name;
        row.document = document.name;
        foreach string path in ("dom", "reader") {
            try {
                if (path == "dom") {
                    auto value = parse_xml_with_schema(document.xml, model.schema);
                    row{path} = value == parse_xml(document.xml);
                } else {
                    XmlReader reader(new StringInputStream(document.xml), {"xsd":model.schema});
                    int roots = 0;
                    while (reader.read()) {
                        if (reader.nodeType() == XML_NODE_TYPE_ELEMENT && reader.depth() == 0) {
                            ++roots;
                        }
                    }
                    row{path} = roots == 1 && reader.isValid();
                }
            } catch (hash<ExceptionInfo> error) {
                if (error.err == "PROGRAM-INTERRUPTED" || error.err == "THREAD-CANCELLED") {
                    throw error.err, error.desc, error.arg;
                }
                row{path} = False;
                row{path + "_error"} = error.err;
                row{path + "_description"} = error.desc;
            }
        }
        printf("%s\n", make_json(row));
    }
}
%endif
