#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%requires ../../qlib/WSDL.qm
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "ID interoperability requires the json module";
%else
auto sub native(auto value) {
    if (value.typeCode() == NT_HASH) {
        if (value."@class" == "QName") {
            return new XsdQNameValue(value.uri, (value.prefix ? value.prefix + ":" : "") + value.name);
        }
        if (value."@class" == "Scoped") {
            hash<string, string> bindings = value.namespaces;
            return new XsdScopedLexicalValue(value.text, bindings);
        }
        hash<auto> result();
        foreach string key in (keys value) {
            result{key} = native(value{key});
        }
        return result;
    }
    return value.typeCode() == NT_LIST ? (map native($1), value) : value;
}
WebService sub service(string schema, string version) {
    string soap = "http://schemas.xmlsoap.org/wsdl/soap" + (version == "12" ? "12" : "") + "/";
    return new WebService('<w:definitions xmlns:w="http://schemas.xmlsoap.org/wsdl/" xmlns:s="' + soap
        + '" xmlns:t="urn:qore:id-bindings" targetNamespace="urn:qore:id-bindings">'
        '<w:types>' + schema + '</w:types>'
        '<w:message name="Input"><w:part name="body" element="value"/></w:message>'
        '<w:message name="Output"><w:part name="body" element="value"/></w:message>'
        '<w:portType name="Port"><w:operation name="submit"><w:input message="t:Input"/>'
        '<w:output message="t:Output"/></w:operation></w:portType>'
        '<w:binding name="Soap" type="t:Port"><s:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>'
        '<w:operation name="submit"><s:operation soapAction="submit"/><w:input><s:body use="literal"/></w:input>'
        '<w:output><s:body use="literal"/></w:output></w:operation></w:binding>'
        '<w:service name="Service"><w:port name="Port" binding="t:Soap">'
        '<s:address location="http://example.invalid/Service"/></w:port></w:service></w:definitions>',
        {"async_only":True});
}
if (ARGV.size() != 1) {
    throw "USAGE", "id-bindings.qr MANIFEST.json";
}
hash<auto> manifest = parse_json(ReadOnlyFile::readTextFile(ARGV[0]));
list<hash<auto>> rows();
foreach hash<auto> model in (manifest.models) {
    XsdSchema schema(model.schema, {"async_only":True});
    foreach hash<auto> document in (model.documents) {
        hash<auto> row();
        row.name = document.name;
        row.stage = "schema";
        try {
            row.xml = schema.serializeXmlValue("", "value", native(manifest.values{document.name})).getXml();
        } catch (hash<ExceptionInfo> error) {
            row.error = {"err":error.err, "desc":error.desc};
        }
        push rows, row;
    }
    foreach string version in ("11", "12") {
        WebService ws = service(model.schema, version);
        WSOperation operation = ws.getBindingOperation("Soap", "submit");
        foreach hash<auto> document in (model.documents) {
            foreach bool response in (False, True) {
                hash<auto> row();
                row.name = document.name;
                row.stage = "soap" + version + (response ? "-response" : "-request");
                try {
                    hash<auto> value = {"body":native(manifest.values{document.name})};
                    row.xml = (response ? operation.serializeResponse(value, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, "Soap")
                        : operation.serializeRequest(value, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, "Soap")).body;
                } catch (hash<ExceptionInfo> error) {
                    row.error = {"err":error.err, "desc":error.desc};
                }
                push rows, row;
            }
        }
    }
}
printf("%s\n", make_json(rows));
%endif
