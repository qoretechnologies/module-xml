#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%prepend-module-path "${SCRIPT_DIR}/../../qlib"
%requires xml
%try-module json
%define NoJson
%endtry

%ifdef NoJson
throw "MISSING-MODULE", "native occurrence diagnostics require the json module";
%else
if (ARGV.size() != 1) {
    throw "USAGE", "native-particle-ranges.qr CASES.json";
}
foreach hash<auto> input in (parse_json(ReadOnlyFile::readTextFile(ARGV[0]))) {
    foreach bool stream in (False, True) {
        hash<auto> row = {"case": input.name, "stream": stream, "schema_ok": True};
        try {
            if (stream) {
                XmlReader reader(new StringInputStream('<t:Submit xmlns:t="urn:qore:attribute-values"/>'),
                    {"xsd": input.schema});
            } else {
                hash<auto> value = parse_xml_with_schema('<t:Submit xmlns:t="urn:qore:attribute-values"/>', input.schema);
                @assert(value.size() == 1);
            }
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "PARSE-XML-EXCEPTION") {
                row.schema_ok = False;
                row.error = ex.err;
                row.description = ex.desc;
            }
        }
        printf("%s\n", make_json(row));
    }
}
%endif
