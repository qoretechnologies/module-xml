#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires ../../../qlib/WSDL.qm
%requires ../../../qlib/SoapClient.qm
%requires ../../../qlib/SoapDataProvider
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "HTTP request URL integration requires json";
%else
list<auto> results();
foreach hash<auto> job in (parse_json(stdin.readLine()).jobs) {
    WebService ws(job.xml, job.wsdl_options);
    if (job.state == "saved") { ws=Serializable::deserialize(ws.serialize()); }
    if (job.state == "data") { ws=Serializable::deserialize(ws.serializeToData()); }
    SoapClient client({"wsdl":ws,"timeout":10000,"connect_timeout":10000}+job.options);
    hash<auto> before=client.getHttpConfig();
    hash<auto> defaults=client.getDefaultHeaders();
    list<auto> calls();
    foreach hash<auto> call in (job.calls) {
        hash<auto> info;
        hash<auto> result();
        auto value=exists call.binary ? {"id":parse_base64_string(call.binary)} : call.value;
        try {
            if (call.provider) {
                SoapRequestDataProvider provider(ws,client,ws.getOperation("send"));
                result.value=provider.doRequest(value,call.options);
            } else {
                result.value=client.callOperation("send",value,call.options,\info);
            }
        } catch (hash<ExceptionInfo> error) { result.error=error.err; }
        result.info=info{"effective-url","redirects","request-uri"};
        push calls,result;
    }
    push results,{"calls":calls,"unchanged":before==client.getHttpConfig(),
        "headers_unchanged":defaults==client.getDefaultHeaders(),"url":client.getInfo().url};
}
printf("%s\n",make_json(results));
%endif
