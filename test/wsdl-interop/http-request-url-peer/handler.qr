#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires ../../../qlib/WSDL.qm
%requires ../../../qlib/SoapHandler.qm
%requires HttpServer
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "HTTP request URL integration requires json";
%else
hash<auto> job = parse_json(ARGV[0]);
HttpServer server(); on_exit server.stop();
SoapHandler handler(new PermissiveAuthenticator());
server.setDefaultHandler("request-url", handler);
Queue received();
foreach string xml in (job.contracts) {
    WebService ws(xml);
    if (job.state == "saved") { ws = Serializable::deserialize(ws.serialize()); }
    if (job.state == "data") { ws = Serializable::deserialize(ws.serializeToData()); }
    code<auto(hash<auto>, auto)> callback = auto sub(hash<auto> cx, auto value) {
        received.push(value);
        return {"result":"received"};
    };
    handler.addMethod(ws, ws.getOperation("send"), callback, NOTHING, NOTHING, NOTHING,
        NOTHING, NOTHING, NOTHING, "B");
}
server.addListener(0);
printf("READY\t%d\n", server.getListenerInfo(0).port);
@assert(trim(stdin.readLine() ?? "") == "STOP");
server.stop();
@assert(received.size() == job.expected.size());
foreach hash<auto> value in (job.expected) { @assert(received.get(1000) == value); }
%endif
