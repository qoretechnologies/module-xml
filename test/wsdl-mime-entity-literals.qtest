#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires ../qlib/WSDL.qm
%exec-class MimeEntityLiteralTest
class MimeEntityLiteralTest inherits QUnit::Test {
    constructor() : Test("Native MIME entity literal conversion", "1.0") {
        addTestCase("Plain nested entity values serialize", \entities());
        addTestCase("Plain nested selection values convert", \selections());
        set_return_value(main());
    }
    private static auto value() {
        return {"^mime^":{"format":"multipart:0","parts":(
            {"format":"multipart:0","parts":({"format":"xml:first","value":"A & č"},)},
            {"format":"content:second","value":<00ff0d0a>})}};
    }
    private static auto selection() { return {"parts":({"format":"xml:first"},)}; }
    private entities() {
        WebService ws(ReadOnlyFile::readTextFile(get_script_dir()+"/wsdl-interop/mime-tree-peer/nested.wsdl"));
        WSOperation op=ws.getOperation("call");
        hash<auto> wire=op.serializeRequest(value());
        assertTrue(wire.body.size()>0);
        assertTrue(wire.hdr."Content-Type".startsWith("multipart/related;"));
        hash<WsdlMimeSelectionInfo> choices=<WsdlMimeSelectionInfo>{"parts":(<WsdlMimeSelectionInfo>{"parts":(
            <WsdlMimeSelectionInfo>{"format":"xml:first"},)},)};
        auto decoded=op.deserializeRequest({"body":wire.body,"content-type":wire.hdr."Content-Type"},NOTHING,False,choices)."^mime^";
        assertEq("A & č",decoded.parts[0].parts[0].value);
        assertEq(<00ff0d0a>,decoded.parts[1].value);
    }
    private selections() {
        hash<WsdlMimeSelectionInfo> result=new hash<WsdlMimeSelectionInfo>(selection());
        assertEq("xml:first",result.parts[0].format);
    }
}
