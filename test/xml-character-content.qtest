#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%exec-class XmlCharacterContentTest

class XmlCharacterContentTest inherits QUnit::Test {
    const Xsi = ' xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"';
    constructor() : Test("Native schema character-content assessment", "1.0") {
        addTestCase("Empty CDATA does not give nilled elements character children", \nilled());
        addTestCase("CDATA whitespace follows empty and element-only content rules", \content());
        addTestCase("Empty character events preserve default and fixed value assessment", \constraints());
        addTestCase("Repeated failures preserve subsequent DOM and reader validation", \recovery());
        set_return_value(main());
    }
    private string schema(string element) {
        return '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">' + element + '</xs:schema>';
    }
    private bool consume(string source, string xml) {
        XmlReader reader(new StringInputStream(xml), {"xsd":source});
        int roots = 0;
        while (reader.read()) {
            if (reader.nodeType() == XML_NODE_TYPE_ELEMENT && reader.depth() == 0) {
                ++roots;
            }
        }
        return roots == 1 && reader.isValid();
    }
    private check(string source, string xml, bool valid) {
        XmlDoc document(xml);
        if (valid) {
            assertTrue(consume(source, xml));
            assertEq(parse_xml(xml), parse_xml_with_schema(xml, source));
            document.validateSchema(source);
        } else {
            assertThrows("PARSE-XML-EXCEPTION", \consume(), (source, xml));
            assertThrows("PARSE-XML-EXCEPTION", \parse_xml_with_schema(), (xml, source));
            assertThrows("XSD-ERROR", \document.validateSchema(), (source,));
        }
    }
    private nilled() {
        foreach string datatype in ("anyType", "anySimpleType", "int") {
            string source = schema('<xs:element name="root" type="xs:' + datatype + '" nillable="true"/>');
            foreach string nil in ("true", "1", " true ") {
                foreach string text in ("", "<![CDATA[]]>", "<!--comment-->",
                        "<![CDATA[]]><!--comment--><![CDATA[]]>") {
                    check(source, '<root' + Xsi + ' xsi:nil="' + nil + '">' + text + '</root>', True);
                }
                foreach string text in (" ", "<![CDATA[ ]]>", "17", "<![CDATA[17]]>", "<child/>") {
                    check(source, '<root' + Xsi + ' xsi:nil="' + nil + '">' + text + '</root>', False);
                }
            }
        }
        string source = schema('<xs:element name="root" nillable="true"><xs:complexType>'
            '<xs:sequence><xs:element name="child"/></xs:sequence>'
            '<xs:attribute name="tag" use="required"/></xs:complexType></xs:element>');
        check(source, '<root' + Xsi + ' xsi:nil="1" tag="shipment"><![CDATA[]]></root>', True);
        check(source, '<root' + Xsi + ' xsi:nil="1"><![CDATA[]]></root>', False);
    }
    private content() {
        foreach bool element_content in (False, True) {
            string source = schema('<xs:element name="root"><xs:complexType>' + (element_content
                ? '<xs:sequence><xs:element name="child" minOccurs="0"/></xs:sequence>' : '')
                + '</xs:complexType></xs:element>');
            foreach string text in ("", "<![CDATA[]]>", "<!--comment-->", "<![CDATA[]]><!--comment--><![CDATA[]]>") {
                check(source, '<root>' + text + '</root>', True);
            }
            foreach string text in (" ", "\t\n", "<![CDATA[ ]]>", "<![CDATA[\t\n]]>",
                    "<![CDATA[]]> <![CDATA[\n]]>") {
                check(source, '<root>' + text + '</root>', element_content);
            }
            foreach string text in ("text", "<![CDATA[text]]>", "<![CDATA[ ]]>") {
                check(source, '<root>' + text + '</root>', False);
            }
            check(source, "<root><![CDATA[ ]]><child/><![CDATA[\t]]></root>", element_content);
        }
    }
    private constraints() {
        foreach string datatype in ("anyType", "anySimpleType", "int") {
            foreach string kind in ("default", "fixed") {
                string source = schema('<xs:element name="root" type="xs:' + datatype
                    + '" nillable="true" ' + kind + '="17"/>');
                foreach string text in ("", "<![CDATA[]]>", "<!--comment-->",
                        "<![CDATA[]]><!--comment--><![CDATA[]]>", "17", "<![CDATA[17]]>", "1<![CDATA[7]]>") {
                    check(source, '<root>' + text + '</root>', True);
                    check(source, '<root' + Xsi + ' xsi:nil="false">' + text + '</root>', True);
                }
                check(source, '<root>18</root>', kind == "default");
                check(source, '<root><![CDATA[18]]></root>', kind == "default");
                check(source, '<root' + Xsi + ' xsi:nil="true"><![CDATA[]]></root>', kind == "default");
            }
        }
    }
    private recovery() {
        string source = schema('<xs:element name="root" type="xs:int" nillable="true"/>');
        for (int index = 0; index < 8; ++index) {
            check(source, '<root' + Xsi + ' xsi:nil="true"><![CDATA[ ]]></root>', False);
            check(source, '<root' + Xsi + ' xsi:nil="true"><![CDATA[]]></root>', True);
            check(source, '<root>1<![CDATA[7]]></root>', True);
        }
    }
}
