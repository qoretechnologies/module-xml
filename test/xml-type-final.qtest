#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%exec-class XmlTypeFinalTest

class XmlTypeFinalTest inherits QUnit::Test {
    constructor() : Test("Native XSD anonymous type final defaults", "1.0") {
        addTestCase("Anonymous restriction, list, and union defaults apply to both readers", \defaults());
        addTestCase("Failed final constraints leave a reader's prior schema intact", \replacement());
        addTestCase("Schema defaults do not change builtin types or later documents", \builtinScope());
        set_return_value(main());
    }
    private string source(string method, string control) {
        return '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" finalDefault="' + control + '">'
            + '<xs:simpleType name="T" final=""><xs:' + method + '><xs:simpleType>'
            + '<xs:restriction base="xs:int"/></xs:simpleType></xs:' + method + '></xs:simpleType>'
            + '<xs:element name="v" type="T"/></xs:schema>';
    }
    private bool consume(string source, string document) {
        XmlReader reader(new StringInputStream(document), {"xsd": source});
        while (reader.read()) {
        }
        return reader.isValid();
    }
    defaults() {
        foreach string method in ("restriction", "list", "union") {
            foreach string control in ("restriction", "list", "union", "#all", "", "extension",
                    "&#9;restriction&#10;list&#13;union ") {
                string schema = source(method, control);
                if (control == method || control == "#all" || control.startsWith("&#9;")) {
                    assertThrows("XSD-SYNTAX-ERROR", \consume(), (schema, "<v>17</v>"));
                    assertThrows("XSD-SYNTAX-ERROR", \parse_xml_with_schema(), ("<v>17</v>", schema));
                } else {
                    string content = method == "list" ? "17 18" : "17";
                    string document = "<v>" + content + "</v>";
                    assertTrue(consume(schema, document));
                    assertEq(content, parse_xml_with_schema(document, schema).v);
                    assertThrows("PARSE-XML-EXCEPTION", \consume(), (schema, "<v>bad</v>"));
                    assertThrows("PARSE-XML-EXCEPTION", \parse_xml_with_schema(), ("<v>bad</v>", schema));
                }
            }
        }
    }
    replacement() {
        foreach string method in ("restriction", "list", "union") {
            XmlReader reader("<v>17</v>");
            reader.schemaValidateString(source(method, ""));
            assertThrows("XSD-SYNTAX-ERROR", \reader.schemaValidateString(), (source(method, method),));
            while (reader.read()) {
            }
            assertTrue(reader.isValid());
        }
    }
    builtinScope() {
        string schema = '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" finalDefault="#all">'
            + '<xs:element name="v"><xs:simpleType><xs:restriction base="xs:int"/></xs:simpleType></xs:element></xs:schema>';
        assertTrue(consume(schema, "<v>17</v>"));
        assertEq("17", parse_xml_with_schema("<v>17</v>", schema).v);
        foreach string method in ("restriction", "list", "union") {
            assertTrue(consume(source(method, ""), "<v>17</v>"));
        }
    }
}
