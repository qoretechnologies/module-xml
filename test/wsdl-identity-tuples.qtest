#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires ../qlib/WSDL.qm
%requires xml
%try-module json
%define NoJson
%endtry
%ifdef NoJson
throw "MISSING-MODULE", "Identity tuple fixtures require json";
%else
%exec-class IdentityTupleTest
class IdentityTupleTest inherits QUnit::Test {
    constructor() : Test("Scoped WSDL identity tuples", "1.0") {
        foreach hash<auto> model in (parse_json(ReadOnlyFile::readTextFile(get_script_dir()+"/wsdl-interop/fixtures/identity-tuples.json"))) {
            addTestCase(model.name, \matrix(), (model,));
        }
        set_return_value(main());
    }
    private auto decode(XsdSchema schema, string xml, bool native) {
        return schema.getElement("", "root").deserializeValue(schema.getTypeMap(), NOTHING,
            XsdBase::expandElementNamespaces(parse_xml(xml, XPF_PRESERVE_ORDER)){"{}root"}, True, native);
    }
    private matrix(hash<auto> model) {
        XsdSchema original(model.schema, {"async_only":True});
        bool native_valid = model.native_valid;
        if (native_valid) {
            assertEq(parse_xml(model.xml), parse_xml_with_schema(model.xml, model.schema), model.name);
        } else {
            assertThrows("PARSE-XML-EXCEPTION", \parse_xml_with_schema(), (model.xml, model.schema), model.name);
        }
        foreach XsdSchema schema in (original, Serializable::deserialize(original.serialize())) {
            foreach bool native in (False, True) {
                if (!model.valid) {
                    assertThrows("SOAP-DESERIALIZATION-ERROR", \decode(), (schema, model.xml, native), model.name);
                    assertThrows("SOAP-SERIALIZATION-ERROR", \schema.validateXmlValue(),
                        (new XsdXmlValue(model.xml),), model.name);
                    if (model.invalid_type) {
                        continue;
                    }
                    XsdSchema unconstrained(model.unconstrained_schema, {"async_only":True});
                    auto value = decode(unconstrained, model.xml, True);
                    if (model.inferred_native_valid) {
                        # Native decoding now retains the original untyped XML.
                        # Explicitly constructed scalar values create a different,
                        # inferred document; they are not a round-trip of this input.
                        assertThrows("SOAP-SERIALIZATION-ERROR", \schema.serializeXmlValue(),
                            ("", "root", value), model.name);
                        value = {"a":value.a."^value^", "b":value.b."^value^"};
                        XsdXmlValue wire = schema.serializeXmlValue("", "root", value);
                        assertEq(parse_xml(wire.getXml()), parse_xml_with_schema(wire.getXml(), model.schema));
                        auto typed = decode(schema, wire.getXml(), True);
                        foreach string field in ("a", "b") {
                            assertEq(XSD_NS, typed{field}."^type^".getNamespaceUri());
                            assertEq("string", typed{field}."^type^".getLocalName());
                            assertEq(value{field}, typed{field}."^val^");
                        }
                        AbstractDataProviderType provider = schema.getElement("", "root").getDataProviderType();
                        foreach AbstractDataProviderType current in (provider,
                                Serializable::deserialize(provider.serialize())) {
                            assertEq(value, current.acceptsValue(value));
                        }
                        continue;
                    }
                    assertThrows("SOAP-SERIALIZATION-ERROR", \schema.serializeXmlValue(),
                        ("", "root", value), model.name);
                    AbstractDataProviderType provider = schema.getElement("", "root").getDataProviderType();
                    foreach AbstractDataProviderType current in (provider,
                            Serializable::deserialize(provider.serialize())) {
                        assertThrows("RUNTIME-TYPE-ERROR", \current.acceptsValue(), (value,), model.name);
                    }
                } else {
                    auto value = decode(schema, model.xml, native);
                    if (!native && model.legacy_serialization_error) {
                        # Approved legacy projection; this is an expected rejection, not a lossless round-trip.
                        assertEq(model.legacy_projection, value, model.name);
                        assertEq(NT_INT, value.a.typeCode());
                        assertEq(NT_STRING, value.b.typeCode());
                        assertThrows(model.legacy_serialization_error, \schema.serializeXmlValue(),
                            ("", "root", value), model.name);
                        AbstractDataProviderType provider = schema.getElement("", "root").getDataProviderType();
                        foreach AbstractDataProviderType current in (provider,
                                Serializable::deserialize(provider.serialize()), provider.getSoftType(),
                                Serializable::deserialize(provider.getSoftType().serialize())) {
                            assertThrows("RUNTIME-TYPE-ERROR", \current.acceptsValue(), (value,), model.name);
                        }
                        continue;
                    }
                    XsdXmlValue wire = schema.serializeXmlValue("", "root", value);
                    if (native_valid) {
                        assertEq(parse_xml_with_schema(wire.getXml(), model.schema), parse_xml(wire.getXml()), model.name);
                    } else {
                        assertThrows("PARSE-XML-EXCEPTION", \parse_xml_with_schema(),
                            (wire.getXml(), model.schema), model.name);
                    }
                    AbstractDataProviderType provider = schema.getElement("", "root").getDataProviderType();
                    foreach AbstractDataProviderType current in (provider,
                            Serializable::deserialize(provider.serialize())) {
                        auto accepted = current.acceptsValue(exists value || current.isOrNothingType() ? value : {});
                        assertEq(XsdBase::expandElementNamespaces(parse_xml(schema.serializeXmlValue("", "root", accepted).getXml())),
                            XsdBase::expandElementNamespaces(parse_xml(wire.getXml())), model.name);
                    }
                }
            }
        }
    }
}
%endif
