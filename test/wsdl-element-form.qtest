#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class ElementFormTest

class ElementFormTest inherits QUnit::Test {
    private {
        const Xsd = "http://www.w3.org/2001/XMLSchema";
        const Ns = "urn:qore:element-form";
    }

    constructor() : QUnit::Test("WSDL element form and reference identity", "1.0") {
        addTestCase("Local forms override each schema default", \localForms());
        addTestCase("Global references retain qualified identity", \globalReference());
        addTestCase("No-namespace references do not fall back to the target namespace", \noNamespaceReference());
        addTestCase("Reference contexts restore local prefix shadowing", \localReference());
        addTestCase("Invalid forms and contradictory references reject", \invalidForms());
        set_return_value(main());
    }

    private string schema(string contents, string form = "unqualified") {
        return sprintf('<xs:schema xmlns:xs="%s" xmlns:t="%s" targetNamespace="%s" elementFormDefault="%s">%s
            </xs:schema>', Xsd, Ns, Ns, form, contents);
    }

    private XsdSchema parse(string xml) {
        return new XsdSchema(xml, {"async_only": True});
    }

    private XsdComplexType type(XsdSchema s) {
        return cast<XsdComplexType>(s.findType(make_qname(Ns, "Record")));
    }

    localForms() {
        foreach string form in ("qualified", "unqualified") {
            XsdSchema s = parse(schema('<xs:complexType name="Record"><xs:sequence>
                <xs:element name="plain" type="xs:string" form="unqualified"/>
                <xs:element name="qualified" type="xs:string" form="qualified"/>
                <xs:element name="inherited" type="xs:string"/>
                </xs:sequence></xs:complexType>', form));
            string prefix = s.nsc.getOutputNamespacePrefix(Ns);
            hash<auto> wire = type(s).serializeValue(s.nsc,
                {"plain": "first", "qualified": "second", "inherited": "third"}, True);
            assertEq("first", wire.plain);
            assertEq("second", wire{prefix + ":qualified"});
            assertEq("third", wire{(form == "qualified" ? prefix + ":" : "") + "inherited"});
            assertFalse(type(s).elementmap.plain.usedocns);
            assertTrue(type(s).elementmap.qualified.usedocns);
            XsdSchema restored = Serializable::deserialize(s.serialize());
            assertEq(wire, type(restored).serializeValue(restored.nsc,
                {"plain": "first", "qualified": "second", "inherited": "third"}, True));
        }
    }

    globalReference() {
        XsdSchema s = parse(schema('<xs:element name="global" type="xs:string"/>
            <xs:complexType name="Record"><xs:sequence><xs:element ref="t:global"/></xs:sequence></xs:complexType>'));
        hash<auto> wire = type(s).serializeValue(s.nsc, {"global": "value"}, True);
        assertEq("value", wire{s.nsc.getOutputNamespacePrefix(Ns) + ":global"});
        assertTrue(type(s).elementmap.global.usedocns);
    }

    noNamespaceReference() {
        XsdSchema s(sprintf('<xs:schema xmlns:xs="%s"><xs:element name="value" type="xs:int"/></xs:schema>', Xsd));
        s.addSchemaString(schema('<xs:import/><xs:element name="value" type="xs:string"/>
            <xs:complexType name="Record"><xs:sequence><xs:element ref="value"/></xs:sequence></xs:complexType>'));
        assertEq("", type(s).elementmap.value.ns);
        assertEq("int", type(s).elementmap.value.type.name);
        assertEq(42, type(s).serializeValue(s.nsc, {"value": 42}, True).value);
        assertThrows("WSDL-ERROR", \parse(), (schema('<xs:element name="value" type="xs:string"/>
            <xs:complexType name="Record"><xs:sequence><xs:element ref="value"/></xs:sequence></xs:complexType>'),));
    }

    localReference() {
        XsdSchema s(sprintf('<xs:schema xmlns:xs="%s" targetNamespace="urn:other">
            <xs:element name="value" type="xs:int"/></xs:schema>', Xsd));
        s.addSchemaString(schema('<xs:import namespace="urn:other"/><xs:element name="value" type="xs:string"/>
            <xs:complexType name="Record"><xs:sequence><xs:element xmlns:t="urn:other" ref="t:value"/>
            </xs:sequence></xs:complexType>'));
        assertEq("int", type(s).elementmap.value.type.name);
        assertEq("urn:other", type(s).elementmap.value.ns);
        assertEq(Ns, s.nsc.getInputNamespaceUri("t"));
    }

    invalidForms() {
        foreach string element in ('<xs:element name="value" form="invalid"/>',
                '<xs:element ref="t:value" form="qualified"/>',
                '<xs:element ref="t:value" name="value"/>',
                '<xs:element ref="t:value" type="xs:string"/>') {
            assertThrows("WSDL-ERROR", \parse(), (schema('<xs:element name="value" type="xs:string"/>
                <xs:complexType name="Record"><xs:sequence>' + element + '</xs:sequence></xs:complexType>'),));
        }
        assertThrows("WSDL-ERROR", \parse(), (schema('', "invalid"),));
        assertThrows("WSDL-NAMESPACE-ERROR", \parse(), (schema('<xs:complexType name="Record"><xs:sequence>
            <xs:element ref="missing:value"/></xs:sequence></xs:complexType>'),));
    }
}
