#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires xml
%requires QUnit
%requires HttpServer
%requires HttpServerUtil
%requires ../qlib/XmlRpcHandler.qm

%exec-class XmlRpcHandlerCredentialsTest

#! The log message callback of a restricted Program that a trusted XML-RPC handler calls gets the request context
#! without the credentials of the request (qore#7303)

#! a hang guard only, never a timing assertion
const HangGuard = 20s;

class XmlRpcHandlerCredentialsTest inherits QUnit::Test {
    public {
        #! the tenant's code: records what of the request it saw
        const TenantSource = "%modern
bool sub holds_object(auto v) {
    if (v.typeCode() == NT_OBJECT || v.callp()) {
        return True;
    }
    switch (v.typeCode()) {
        case NT_HASH: foreach string k in (keys v) { if (holds_object(v{k})) { return True; } } break;
        case NT_LIST: foreach auto e in (v) { if (holds_object(e)) { return True; } } break;
    }
    return False;
}

code sub get_log(Queue q) {
    return *string sub (hash<auto> cx, hash<auto> method, reference<auto> params) {
        q.push({
            \"auth\": exists cx.auth,
            \"authorization\": exists cx.\"header-info\".\"headers-raw\".Authorization
                || exists cx.\"header-info\".\"headers-raw\".authorization,
            \"objects\": (select keys cx, holds_object(cx{$1})),
            \"method_objects\": (select keys method, holds_object(method{$1})),
            \"cmark\": cx.cmark,
            \"function\": exists cx.function,
            \"text\": method.text,
            \"peer\": exists cx.\"peer-info\".address_desc,
        });
    };
}
";
    }

    constructor() : Test("XmlRpcHandlerCredentialsTest", "1.0", \ARGV) {
        addTestCase("a restricted log message callback", \restrictedTest());
        addTestCase("a trusted log message callback", \trustedTest());
        set_return_value(main());
    }

    #! returns the tenant's Program with the given sandbox
    private Program getTenant(*SandboxManager sm) {
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        if (sm) {
            p.setSandboxManager(sm);
        }
        p.parse(TenantSource, "tenant");
        return p;
    }

    #! calls a method with credentials; returns what the log message callback saw
    private hash<auto> call(Program p) {
        Queue q();
        XmlRpcHandler handler(new PermissiveAuthenticator(), (), p.callFunction("get_log", q));
        handler.addMethod("^probe\$", string sub () { return "ok"; }, "probe", "probe", 0, "mark");
        HttpServer server(<HttpServerOptionInfo>{});
        on_exit server.stop();
        server.setDefaultHandler("xmlrpc", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        HTTPClient client({"url": sprintf("http://127.0.0.1:%d", port), "error_passthru": True,
            "timeout": HangGuard, "connect_timeout": HangGuard});
        hash<auto> info;
        client.post("RPC2", make_xmlrpc_call("probe"), {"Content-Type": "text/xml",
            "Authorization": "Bearer secret", "Cookie": "session=secret"}, \info);
        assertEq(200, info."response-headers".status_code, "the request is served");
        hash<auto> rv = q.get(HangGuard);
        assertEq(0, q.size(), "no other call");
        assertEq("probe", rv.text, "the method");
        assertEq("mark", rv.cmark, "the context marker");
        assertTrue(rv.peer, "the peer's address");
        return rv;
    }

    restrictedTest() {
        hash<auto> r = call(getTenant(new SandboxManager()));
        assertFalse(r.auth, "cx.auth");
        assertFalse(r.authorization, "Authorization");
        assertEq((), r.objects, "no object or code in the context");
        assertEq((), r.method_objects, "no object or code in the method");
        assertFalse(r.function, "no code of the method");
    }

    trustedTest() {
        hash<auto> r = call(getTenant());
        assertTrue(r.auth, "cx.auth");
        assertTrue(r.function, "the method's function");
        assertTrue(inlist("function", r.method_objects), "the method's function in the method");
    }
}
