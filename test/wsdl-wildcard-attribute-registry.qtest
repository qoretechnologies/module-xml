#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%requires ../qlib/WSDL.qm
%exec-class WildcardAttributeRegistryTest

class WildcardAttributeRegistryTest inherits QUnit::Test {
    constructor() : Test("Wildcard attribute declaration ownership", "1.0") {
        addTestCase("Live providers see completed additions and saved providers retain their snapshot", \additions());
        addTestCase("Malformed serialized registries reject before lookup", \malformed());
        set_return_value(main());
    }
    private auto saved(auto value) {
        return Serializable::deserialize(Serializable::serialize(value));
    }
    private AbstractDataProviderType completed() {
        XsdSchema schema('<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:records">'
            '<xs:element name="record"><xs:complexType><xs:anyAttribute processContents="strict"/>'
            '</xs:complexType></xs:element></xs:schema>');
        AbstractDataProviderType live = schema.getElement("urn:records", "record").type.getDataProviderType();
        AbstractDataProviderType before = saved(live);
        auto value = {"^attributes^":{"{urn:partner}flag":False}};
        assertThrows("RUNTIME-TYPE-ERROR", \live.acceptsValue(), (value,));
        string added = '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:partner">'
            '<xs:attribute name="flag" type="xs:boolean"/></xs:schema>';
        schema.addSchemaString(added);
        assertEq(False, live.acceptsValue(value)."^attributes^"."{urn:partner}flag");
        assertThrows("RUNTIME-TYPE-ERROR", \before.acceptsValue(), (value,));
        AbstractDataProviderType after = saved(live);
        assertEq(False, after.acceptsValue(value)."^attributes^"."{urn:partner}flag");
        string invalid = '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:f="urn:failed"'
            ' targetNamespace="urn:failed"><xs:attribute name="leaked" type="xs:int"/>'
            '<xs:element name="invalid" type="f:Missing"/></xs:schema>';
        assertThrows("WSDL-ERROR", \schema.addSchemaString(), (invalid,));
        assertThrows("RUNTIME-TYPE-ERROR", \live.acceptsValue(), ({"^attributes^":{"{urn:failed}leaked":17}},));
        assertEq(False, live.acceptsValue(value)."^attributes^"."{urn:partner}flag");
        return live;
    }
    private additions() {
        AbstractDataProviderType provider = completed();
        foreach AbstractDataProviderType detached in (provider, saved(provider), saved(provider.getSoftType())) {
            assertEq(True, detached.acceptsValue({"^attributes^":{"{urn:partner}flag":True}})
                ."^attributes^"."{urn:partner}flag");
            assertThrows("RUNTIME-TYPE-ERROR", \detached.acceptsValue(), ({"^attributes^":{"{urn:failed}leaked":17}},));
        }
    }
    private malformed() {
        XsdGlobalAttributeRegistry registry();
        foreach auto invalid in (NOTHING, "attributes", 23) {
            hash<SerializationInfo> state = registry.serializeToData();
            state._index."0"._class_data."WSDL::XsdGlobalAttributeRegistry".attributes = invalid;
            assertThrows("DESERIALIZATION-ERROR", \Serializable::deserialize(), (state,));
        }
        assertEq(NOTHING, saved(registry).get("{urn:partner}missing"));
    }
}
