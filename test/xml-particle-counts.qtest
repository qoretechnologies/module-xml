#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires xml
%exec-class XmlParticleCountsTest

class XmlParticleCountsTest inherits QUnit::Test {
    constructor() : Test("Native XSD occurrence lexical rules", "1.0") {
        addTestCase("Signed counts and whitespace preserve whole-particle validation", \validCounts());
        addTestCase("All compositor count restrictions remain enforced", \allCounts());
        addTestCase("Invalid occurrence spellings and ranges reject before document validation", \invalidCounts());
        addTestCase("Long zero spellings remain exact and cancellation permits reuse", \longCounts());
        set_return_value(main());
    }

    private string schema(string kind, string minimum, string maximum) {
        string attrs = sprintf('minOccurs="%s" maxOccurs="%s"', minimum, maximum);
        string declarations;
        string particle;
        if (kind == "element") {
            particle = sprintf('<xs:sequence><xs:element name="v" type="xs:string" %s/></xs:sequence>', attrs);
        } else if (kind == "group") {
            declarations = '<xs:group name="Fields"><xs:sequence><xs:element name="v" type="xs:string"/>
                </xs:sequence></xs:group>';
            particle = sprintf('<xs:group ref="Fields" %s/>', attrs);
        } else {
            particle = sprintf('<xs:%s %s><xs:element name="v" type="xs:string"/></xs:%s>', kind, attrs, kind);
        }
        return '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">' + declarations
            + '<xs:element name="r"><xs:complexType>' + particle
            + '</xs:complexType></xs:element></xs:schema>';
    }

    private int consume(string source, string document) {
        XmlReader reader(new StringInputStream(document), {"xsd": source});
        int count = 0;
        while (reader.read()) {
            if (reader.nodeType() == XML_NODE_TYPE_ELEMENT && reader.localName() == "v") {
                ++count;
            }
        }
        @assert(reader.isValid());
        return count;
    }

    private check(string source, int minimum, int maximum) {
        for (int count = 0; count <= 4; ++count) {
            string document = "<r>" + strmul("<v>text</v>", count) + "</r>";
            if (count < minimum || (maximum >= 0 && count > maximum)) {
                assertThrows("PARSE-XML-EXCEPTION", \consume(), (source, document));
                assertThrows("PARSE-XML-EXCEPTION", \parse_xml_with_schema(), (document, source));
            } else {
                assertEq(count, consume(source, document));
                hash<auto> value = parse_xml_with_schema(document, source);
                auto children = value.r.v;
                assertEq(count, !exists children ? 0 : (children.typeCode() == NT_LIST ? children.size() : 1));
            }
        }
    }

    validCounts() {
        foreach string kind in ("sequence", "choice", "element", "group") {
            foreach list<auto> row in (
                ("+0", "+1", 0, 1), ("-000", "  unbounded  ", 0, -1), (" +001 ", " +002 ", 1, 2),
                ("-0", "-0", 0, 0), (" +002 ", " 0003 ", 2, 3), ("0", "\t unbounded\r\n", 0, -1)) {
                check(schema(kind, row[0], row[1]), row[2], row[3]);
            }
        }
    }

    allCounts() {
        foreach list<auto> row in (("-000", "+001", 0, 1), (" +1 ", " 1 ", 1, 1)) {
            check(schema("all", row[0], row[1]), row[2], row[3]);
        }
        foreach list<string> row in (("0", " unbounded "), ("0", "+2"), ("2", "1"), ("0", "-0")) {
            assertThrows("XSD-SYNTAX-ERROR", \consume(), (schema("all", row[0], row[1]), "<r/>"));
        }
    }

    invalidCounts() {
        foreach string kind in ("sequence", "choice", "element", "group") {
            foreach string property in ("minimum", "maximum") {
                foreach string value in ("", " ", "+", "-", "+ 1", "1.0", "0x1", "1e0", "1 0",
                        "-1", "-0001", "--0", "+-0", "unbounded extra", "Unbounded", "\u00a00",
                        "-9999999999999999999999999999999999999999999999999999") {
                    string source = schema(kind, property == "minimum" ? value : "0",
                        property == "maximum" ? value : "unbounded");
                    assertThrows("XSD-SYNTAX-ERROR", \consume(), (source, "<r/>"));
                    assertThrows("XSD-SYNTAX-ERROR", \parse_xml_with_schema(), ("<r/>", source));
                }
            }
            assertThrows("XSD-SYNTAX-ERROR", \consume(), (schema(kind, "unbounded", "unbounded"), "<r/>"));
            assertThrows("XSD-SYNTAX-ERROR", \consume(), (schema(kind, "+2", "+1"), "<r/>"));
            check(schema(kind, "+0", "+1"), 0, 1);
        }
    }

    longCounts() {
        string zeros = strmul("0", 10000);
        check(schema("sequence", "-" + zeros, "+" + zeros + "2"), 0, 2);
        assertThrows("XSD-SYNTAX-ERROR", \consume(), (schema("sequence", "-" + zeros + "1", "1"), "<r/>"));
        SandboxManager manager();
        on_exit manager.clearInterrupt();
        Program program(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
        program.setSandboxManager(manager);
        program.parse("%modern\n%requires xml\n"
            "hash<auto> sub validate(string source, SandboxManager manager, bool cancel) {\n"
            "    if (cancel) { manager.requestInterrupt(); }\n"
            "    return parse_xml_with_schema(\"<r/>\", source);\n"
            "}\n", "particle-count-cancellation");
        *hash<ExceptionInfo> error;
        try {
            program.callFunction("validate", schema("sequence", "-0", " unbounded "), manager, True);
        } catch (hash<ExceptionInfo> ex) {
            error = ex;
        }
        manager.clearInterrupt();
        assertEq("PROGRAM-INTERRUPTED", error.err);
        assertEq({"r": NOTHING}, program.callFunction("validate", schema("sequence", "-0", " unbounded "), manager, False));
    }
}
