#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%enable-all-warnings

%requires ../qlib/XmlRpcConnection.qm
%requires QUnit
%requires HttpServer

%exec-class XmlRpcClientTest

class PingHandler inherits HttpServer::AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        int code = (cx.path =~ /ping-fail/ || (exists hdr.path && hdr.path =~ /ping-fail/)
            || (exists cx.url && cx.url.path && cx.url.path =~ /ping-fail/)) ? 500 : 200;
        return <HttpResponseInfo>{
            "code": code,
            "body": "pong",
        };
    }
}

class PingServer inherits HttpServer {
    private {
        int port;
    }

    constructor() : HttpServer() {
        setHandler("ping", "ping", NOTHING, new PingHandler(), NOTHING, True);
        port = addListener(0).port;
    }

    int getPort() {
        return port;
    }
}

class XmlRpcClientTest inherits QUnit::Test {
    private {
        PingServer srv;
    }

    constructor() : Test("XmlRpcClient test", "1.0") {
        addTestCase("XML-RPC client test", \testXmlRpcClient());
        addTestCase("XML-RPC connection test", \testXmlRpcConnection());
        addTestCase("XML-RPC polling ping", \testXmlRpcPollingPing());

        # Return for compatibility with test harness that checks return value.
        set_return_value(main());
    }

    testXmlRpcClient() {
        XmlRpcClient client(("url": "http://localhost:80"), True);

        assertEq(True, client instanceof XmlRpcClient);
    }

    testXmlRpcConnection() {
        string url = "xmlrpcs://localhost:8099/";
        XmlRpcConnection conn("test", "test", url);
        XmlRpcClient client = conn.get(False);
        string yurl = url;
        yurl =~ s/^xmlrpc/http/;
        assertEq(yurl, client.getURL());

        # test default path
        url = "xmlrpcs://localhost:8099";
        conn = new XmlRpcConnection("test", "test", url);
        client = conn.get(False);
        yurl = url;
        yurl =~ s/^xmlrpc/http/;
        assertEq(yurl + "/RPC2", client.getURL());

        # issue #3696: test connection serialization
        XmlRpcConnection conn2 = Serializable::deserialize(conn.serialize());
        assertEq(conn.url, conn2.url);
    }

    testXmlRpcPollingPing() {
        srv = new PingServer();
        on_exit srv.stop();

        string base = sprintf("http://localhost:%d", srv.getPort());
        string conn_url = base;
        conn_url =~ s/^http/xmlrpc/;

        XmlRpcConnection conn("test", "test", conn_url, {}, {
            "ping_method": "GET",
            "ping_path": "/ping",
        });
        runPoll(conn.startPollConnect(NOTHING));

        XmlRpcConnection conn_fail("test", "test", conn_url, {}, {
            "ping_method": "GET",
            "ping_path": "/ping-fail",
        });
        assertThrows("XMLRPC-PING-ERROR", \runPoll(), conn_fail.startPollConnect(NOTHING));
    }

    private runPoll(AbstractPollOperation op, int timeout_ms = 5000) {
        date start = now_us();
        while (!op.goalReached()) {
            *hash<SocketPollInfo> info = op.continuePoll();
            if (info) {
                list<hash<SocketPollInfo>> poll_list();
                poll_list += info;
                Socket::poll(poll_list, 100);
            }
            if ((now_us() - start).durationMilliseconds() > timeout_ms) {
                throw "TEST-ERROR", "poll operation timed out";
            }
        }
    }
}
