#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires ../qlib/WSDL.qm
%requires xml
%exec-class UriLanguageContentTest

class UriLanguageContentTest inherits QUnit::Test {
    constructor() : Test("URI/language simple content and collection constraints", "1.0") {
        addTestCase("Simple content and attribute fields apply builtin lexical validation", \content());
        addTestCase("List and union defaults retain selected text identities", \defaults());
        set_return_value(main());
    }
    private static auto saved(auto value) {
        return Serializable::deserialize(Serializable::serialize(value));
    }
    private static auto decode(XsdSchema model, string xml, bool retain) {
        auto wire = XsdBase::expandElementNamespaces(parse_xml(xml, XPF_PRESERVE_ORDER));
        return model.getElement("", "value").deserializeValue(model.getTypeMap(), NOTHING, wire."{}value", True, retain);
    }
    private static auto actual(auto value) {
        if (value.typeCode() == NT_HASH && value.hasKey("^val^")) {
            value = value."^val^";
        }
        return value instanceof XsdDefaultValue ? value.getValue() : value;
    }
    private content() {
        foreach hash<string, string> row in ({"type": "anyURI", "valid": "a%2Fb", "bad": "http://[bad"},
                {"type": "language", "valid": "en-US", "bad": "bad_lang"}) {
            string source = '<xs:schema xmlns:xs="' + XSD_NS + '"><xs:complexType name="T"><xs:simpleContent>'
                '<xs:extension base="xs:' + row.type + '"><xs:attribute name="label" type="xs:' + row.type
                + '" use="required"/></xs:extension></xs:simpleContent></xs:complexType>'
                '<xs:element name="value" type="T"/></xs:schema>';
            XsdSchema original(source, {"async_only": True});
            foreach XsdSchema model in (original, saved(original)) {
                string xml = '<value label=" ' + row.valid + ' "> ' + row.valid + ' </value>';
                foreach bool retain in (False, True) {
                    auto decoded = decode(model, xml, retain);
                    assertEq(row.valid, actual(decoded)."^value^");
                    assertEq(row.valid, actual(decoded)."^attributes^".label);
                    XsdXmlValue output = model.serializeXmlValue("", "value", decoded);
                    assertEq(parse_xml(output.getXml()), parse_xml_with_schema(output.getXml(), source));
                    foreach string invalid in ('<value label="' + row.valid + '">' + row.bad + '</value>',
                            '<value label="' + row.bad + '">' + row.valid + '</value>') {
                        assertThrows("SOAP-DESERIALIZATION-ERROR", \decode(), (model, invalid, retain));
                        assertThrows("PARSE-XML-EXCEPTION", \parse_xml_with_schema(), (invalid, source));
                    }
                }
                AbstractDataProviderType original_provider = model.getElement("", "value").getDataProviderType();
                foreach AbstractDataProviderType provider in (original_provider, saved(original_provider)) {
                    foreach hash<auto> invalid in ({"^value^": row.bad, "^attributes^": {"label": row.valid}},
                            {"^value^": row.valid, "^attributes^": {"label": row.bad}}) {
                        assertThrows("RUNTIME-TYPE-ERROR", \provider.acceptsValue(), (invalid,));
                        assertThrows("SOAP-SERIALIZATION-ERROR", \model.serializeXmlValue(), ("", "value", invalid));
                    }
                }
            }
        }
    }
    private defaults() {
        foreach hash<auto> row in (
                {"definition": '<xs:list itemType="xs:anyURI"/>', "lexical": "a%2Fb a/b", "expected": ("a%2Fb", "a/b")},
                {"definition": '<xs:list itemType="xs:language"/>', "lexical": "en-US EN-US", "expected": ("en-US", "EN-US")},
                {"definition": '<xs:union memberTypes="xs:language xs:boolean"/>', "lexical": "1", "expected": "true", "declared_identity": "boolean:1"},
                {"definition": '<xs:union memberTypes="xs:anyURI xs:boolean"/>', "lexical": "1", "expected": "1"}) {
            foreach string constraint in ("default", "fixed") {
                string source = '<xs:schema xmlns:xs="' + XSD_NS + '"><xs:simpleType name="T">'
                    + row.definition + '</xs:simpleType><xs:element name="value" type="T" ' + constraint
                    + '="' + row.lexical + '"/></xs:schema>';
                XsdSchema original(source, {"async_only": True});
                foreach XsdSchema model in (original, saved(original)) {
                    if (row.declared_identity) {
                        # Approved canonical-actual-type rule: declaration 1 is boolean,
                        # but canonical true selects the earlier language member for the empty instance.
                        UnionDataType union_type = cast<UnionDataType>(model.getElement("", "value").type.getDataProviderType());
                        assertEq(row.declared_identity, union_type.valueKey(model.getElement("", "value").getValueConstraint().value));
                        assertEq("string:true", union_type.valueKey(row.expected));
                    }
                    auto value = decode(model, "<value/>", True);
                    assertEq(row.expected, actual(value));
                    AbstractDataProviderType provider = saved(model.getNativeDataProviderType("", "value"));
                    auto accepted = provider.acceptsValue(value);
                    assertEq(row.expected, actual(accepted));
                    XsdXmlValue output = model.serializeXmlValue("", "value", accepted);
                    assertEq(parse_xml(output.getXml()), parse_xml_with_schema(output.getXml(), source));
                    assertEq(row.expected, actual(decode(model, output.getXml(), True)));
                }
            }
        }
    }
}
