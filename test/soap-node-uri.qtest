#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires xml
%requires QUnit
%requires ../qlib/WSDL.qm
%exec-class SoapNodeUriTest

class SoapNodeUriTest inherits QUnit::Test {
    constructor() : Test("SOAP strict role URI syntax", "1.0") {
        addTestCase("Node configuration rejects invalid RFC 3986 role identifiers", \configuration());
        addTestCase("SOAP role and actor attributes reject invalid RFC 3986 references", \messages());
        addTestCase("Valid opaque, hierarchical and relative URI references retain their identities", \valid());
        set_return_value(main());
    }
    private static list<string> invalidUris() {
        return ("urn:bad{value", "urn:bad|value", "http://[bad", "http://host:invalid/", "urn:bad\\value",
            "urn:é", "https://example.org/é", "https://example.org/a%xy", "urn:two words");
    }
    private configuration() {
        foreach string uri in (invalidUris()) {
            assertThrows("SOAP-NODE-ERROR", sub() {
                new SoapProcessingNode(<SoapNodeOptions>{"roles":(uri,)});
            });
        }
    }
    private messages() {
        SoapProcessingNode node();
        foreach bool soap12 in (False, True) {
            foreach string uri in (invalidUris()) {
                hash<auto> attributes = {"xmlns:e":soap12 ? SOAP_12_ENV : SOAP_11_ENV,
                    "xmlns:t":"urn:tracking", "e:" + (soap12 ? "role" : "actor"):uri};
                string xml = make_xml({"e:Envelope":{"^attributes^":attributes,
                    "e:Header":{"t:Tracking":{"^attributes^":attributes,"^value^":"invoice-71"}}, "e:Body":NOTHING}});
                assertThrows("SOAP-DESERIALIZATION-ERROR", \node.processMessage(), (xml,));
            }
        }
    }
    private valid() {
        foreach string uri in ("urn:tracking:billing", "mailto:billing@example.org",
                "https://example.org/a%7Cb?q=one%20two#reference", "http://[::1]:8080/billing",
                "http://[v1.a:b]/billing", "https://example.org/path?", "https://example.org/path#",
                "https://example.org/%C3%A9/billing", "urn:%c3%a9") {
            SoapProcessingNode node(<SoapNodeOptions>{"roles":(uri,)});
            foreach bool soap12 in (False,True) {
                hash<auto> attributes = {"xmlns:e":soap12 ? SOAP_12_ENV : SOAP_11_ENV,
                    "xmlns:t":"urn:tracking", "e:" + (soap12 ? "role" : "actor"):uri};
                string xml = make_xml({"e:Envelope":{"^attributes^":attributes,
                    "e:Header":{"t:Tracking":{"^attributes^":attributes,"^value^":"invoice-71"}}, "e:Body":NOTHING}});
                hash<SoapNodeResult> result = node.processMessage(xml);
                assertTrue(result.headers[0].header.targeted);
                assertEq(uri,result.headers[0].header.role);
            }
        }
        foreach string reference in ("", "../billing", "?role=billing", "#billing") {
            string expected = reference == "" ? "https://example.org/path/message"
                : reference == "../billing" ? "https://example.org/billing"
                : reference == "?role=billing" ? "https://example.org/path/message?role=billing"
                : "https://example.org/path/message#billing";
            SoapProcessingNode node(<SoapNodeOptions>{"roles":(expected,)});
            string xml = '<e:Envelope xmlns:e="' + SOAP_12_ENV + '"><e:Header><t:Tracking xmlns:t="urn:tracking"'
                + ' e:role="' + reference + '"/></e:Header><e:Body/></e:Envelope>';
            hash<SoapNodeResult> result = node.processMessage(xml,{},"https://example.org/path/message");
            assertTrue(result.headers[0].header.targeted);
            assertEq(expected,result.headers[0].header.role);
        }
        # XML Base may be an IRI even though role values themselves must use URI syntax.
        foreach bool soap12 in (False, True) {
            string expected = "https://example.org/%C3%A9/billing";
            SoapProcessingNode node(<SoapNodeOptions>{"roles":(expected,)});
            string xml = '<e:Envelope xmlns:e="' + (soap12 ? SOAP_12_ENV : SOAP_11_ENV)
                + '" xml:base="https://example.org/é/"><e:Header><t:Tracking xmlns:t="urn:tracking"'
                + ' e:' + (soap12 ? "role" : "actor") + '="billing"/></e:Header><e:Body/></e:Envelope>';
            hash<SoapNodeResult> result = node.processMessage(xml);
            assertTrue(result.headers[0].header.targeted);
            assertEq(expected, result.headers[0].header.role);
        }
    }

}
