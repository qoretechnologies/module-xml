#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires ../qlib/WSDL.qm
%exec-class ScopedLexicalValueTest

class ScopedLexicalValueTest inherits QUnit::Test {
    constructor() : Test("Scoped lexical value integrity", "1.0") {
        addTestCase("Text, bindings and missing prefixes survive independent copies", \copies());
        addTestCase("Malformed text and namespace bindings fail construction", \invalid());
        addTestCase("Reconstruction revalidates authoritative text and bindings", \metadata());
        set_return_value(main());
    }

    private copies() {
        hash<string, string> bindings = {"p": "urn:catalog", "": ""};
        XsdScopedLexicalValue original(" \tmissing:Legacy\n", bindings);
        bindings.p = "urn:changed";
        foreach XsdScopedLexicalValue value in (original, Serializable::deserialize(original.serialize())) {
            assertEq(" \tmissing:Legacy\n", value.getLexicalValue());
            hash<string, string> copy = value.getNamespaceBindings();
            assertEq("urn:catalog", copy.p);
            assertEq("", copy{""});
            assertEq("http://www.w3.org/XML/1998/namespace", copy.xml);
            assertFalse(copy.hasKey("missing"));
            copy.missing = "urn:new";
            copy.p = "urn:changed";
            assertFalse(value.getNamespaceBindings().hasKey("missing"));
            assertEq("urn:catalog", value.getNamespaceBindings().p);
            assertEq("Name", new XsdQNameDataType().acceptsValue("Name"));
        }
        foreach string text in ("", " a b ", "invalid:qname:spelling", "\t\n\r", "商品") {
            XsdScopedLexicalValue value(text, {});
            assertEq(text, Serializable::deserialize(value.serialize()).getLexicalValue());
        }
    }

    private static XsdScopedLexicalValue create(string text, hash<string, string> bindings) {
        return new XsdScopedLexicalValue(text, bindings);
    }

    private invalid() {
        foreach string text in ("\0", "\x01", "\x0b", "\x0c", "\x1f") {
            assertThrows("XSD-SCOPED-VALUE-ERROR", \create(), (text, {}));
        }
        foreach hash<string, string> bindings in ({"bad:prefix": "urn:test"}, {"p": ""},
                {"xmlns": "urn:test"}, {"xml": "urn:test"}, {"p": "http://www.w3.org/XML/1998/namespace"},
                {"": "http://www.w3.org/2000/xmlns/"}, {"unused": "urn:bad\0"}) {
            assertThrows("XSD-SCOPED-VALUE-ERROR", \create(), ("Name", bindings));
        }
        assertEq("Name", new XsdScopedLexicalValue("Name", {}).getLexicalValue());
    }

    private metadata() {
        XsdScopedLexicalValue original("p:Name", {"p": "urn:catalog"});
        foreach hash<auto> invalid in ({"lexical": NOTHING}, {"lexical": 42}, {"lexical": "bad\0"},
                {"namespaces": NOTHING}, {"namespaces": ("p",)}, {"namespaces": {"p": 42}},
                {"namespaces": {"p": ""}}, {"namespaces": {"xml": "urn:wrong"}}) {
            hash<SerializationInfo> state = original.serializeToData();
            state._index."0"._class_data."WSDL::XsdScopedLexicalValue" += invalid;
            assertThrows("DESERIALIZATION-ERROR", \Serializable::deserialize(), (state,));
            assertEq("urn:catalog", original.getNamespaceBindings().p);
        }
        XsdScopedLexicalValue restored = Serializable::deserialize(original.serialize());
        assertEq("p:Name", restored.getLexicalValue());
        assertEq("urn:catalog", restored.getNamespaceBindings().p);
    }
}
