/** @page xmlcookbook Cookbook

    @tableofcontents

    Each example is a complete script; save it to a file and run it with \c qore.

    @section xmlcookbookserialize Converting Between Data and XML

    Attributes, repeated elements and text are represented with the conventions described in
    @ref xmlserialization "XML Serialization and Deserialization":

    @code{.py}
%modern
%requires xml

hash<auto> order = {
    "order": {
        "^attributes^": {"id": "71", "currency": "EUR"},
        "item": (
            {"sku": "A-100", "quantity": 2},
            {"sku": "B-200", "quantity": 1},
        ),
        "note": "deliver after 5 pm",
    },
};
string xml = make_xml(order, XGF_ADD_FORMATTING);
printf("%s", xml);

hash<auto> parsed = parse_xml(xml);
printf("order %s has %d items\n", parsed.order."^attributes^".id, parsed.order.item.size());
    @endcode

    @section xmlcookbookvalidate Validating Documents

    @subsection xmlcookbookvalidateparse Validating While Parsing

    @ref Qore::Xml::parse_xml_with_schema() "parse_xml_with_schema()" validates the document and returns its data; an
    invalid document raises an exception:

    @code{.py}
%modern
%requires xml

const Xsd = '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="quantity">
    <xs:simpleType><xs:restriction base="xs:int"><xs:minInclusive value="1"/></xs:restriction></xs:simpleType>
  </xs:element>
</xs:schema>';

printf("%y\n", parse_xml_with_schema("<quantity>5</quantity>", Xsd).quantity);
try {
    printf("%y\n", parse_xml_with_schema("<quantity>0</quantity>", Xsd));
} catch (hash<ExceptionInfo> ex) {
    printf("rejected: %s\n", ex.err);
}
    @endcode

    @subsection xmlcookbookvalidatestream Validating a Stream

    @ref Qore::Xml::XmlReader "XmlReader" validates each node as it is read, without building a DOM tree:

    @code{.py}
%modern
%requires xml

XmlReader reader("<readings><value>1.5</value><value>2.25</value></readings>");
reader.schemaValidateString('<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="readings"><xs:complexType><xs:sequence>
    <xs:element name="value" type="xs:decimal" maxOccurs="unbounded"/>
  </xs:sequence></xs:complexType></xs:element>
</xs:schema>');
int values;
while (reader.read()) {
    if (reader.nodeType() == XML_NODE_TYPE_ELEMENT && reader.name() == "value") {
        ++values;
    }
}
printf("%d valid values\n", values);
    @endcode

    @subsection xmlcookbookvalidateimports Serving Imported Schemas From Memory

    An @ref Qore::Xml::AbstractXmlIoInputCallback "AbstractXmlIoInputCallback" object resolves the schemas that a
    schema imports, here from memory; no filesystem or network access is needed:

    @code{.py}
%modern
%requires xml

class SchemaStore inherits AbstractXmlIoInputCallback {
    private {
        hash<string, string> schemas;
    }

    constructor(hash<string, string> schemas) {
        self.schemas = schemas;
    }

    *InputStream open(string url) {
        *string schema = schemas{url};
        return exists schema ? new BinaryInputStream(binary(schema)) : NOTHING;
    }
}

SchemaStore store({
    "types.xsd": '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:types">
  <xs:simpleType name="Sku"><xs:restriction base="xs:string"><xs:pattern value="[A-Z]-[0-9]{3}"/>
  </xs:restriction></xs:simpleType>
</xs:schema>',
});

const Xsd = '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:types">
  <xs:import namespace="urn:types" schemaLocation="types.xsd"/>
  <xs:element name="sku" type="t:Sku"/>
</xs:schema>';

XmlReader reader(new StringInputStream("<sku>A-100</sku>"), {"xsd": Xsd, "xml_input_io": store});
while (reader.read()) {
}
printf("valid\n");
    @endcode

    @section xmlcookbookxpath Querying With XPath

    @code{.py}
%modern
%requires xml

XmlDoc doc('<orders><order id="1" total="10.50"/><order id="2" total="99.95"/></orders>');
foreach XmlNode node in (doc.evalXPath("//order[@total > 50]")) {
    printf("order %s\n", node.getProp("id"));
}
    @endcode

    @section xmlcookbooksax Iterating Over Large Documents

    See also @ref xmlstreaming.

    @ref Qore::Xml::SaxIterator "SaxIterator" returns each matching element as data without parsing the whole
    document into memory; @ref Qore::Xml::FileSaxIterator "FileSaxIterator" reads a file in the same way:

    @code{.py}
%modern
%requires xml

string xml = "<export><record><id>1</id></record><record><id>2</id></record></export>";
SaxIterator records(xml, "record");
map printf("record %d: %y\n", $#, $1), records;
    @endcode

    @section xmlcookbookxmlrpc Creating and Parsing XML-RPC Calls

    @code{.py}
%modern
%requires xml

string call = make_xmlrpc_call("orders.get", 71);
hash<auto> request = parse_xmlrpc_call(call);
printf("%s(%y)\n", request.methodName, request.params);
    @endcode

    See the @ref xmlrpcclientiointro "XmlRpcClientIo" and
    @ref xmlrpchandlerintro "XmlRpcHandler" modules for XML-RPC clients and servers.

    @section xmlcookbooksoap Serving and Calling a SOAP Service

    This example serves the operation of a SOAP 1.2 service described by a WSDL document with
    @ref soaphandlerintro "SoapHandler", and calls it with
    @ref soapclientintro "SoapClient"; see @ref xmlsoapguide "SOAP and WSDL Web Services":

    @code{.py}
%modern
%requires HttpServer
%requires Logger
%requires SoapHandler
%requires SoapClient

# a service with one SOAP 1.2 document/literal operation
const Wsdl = '<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap12="http://schemas.xmlsoap.org/wsdl/soap12/" xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:tns="urn:orders" targetNamespace="urn:orders">
  <types>
    <xs:schema targetNamespace="urn:orders" elementFormDefault="qualified">
      <xs:element name="getOrder"><xs:complexType><xs:sequence>
        <xs:element name="id" type="xs:int"/></xs:sequence></xs:complexType></xs:element>
      <xs:element name="order"><xs:complexType><xs:sequence>
        <xs:element name="id" type="xs:int"/><xs:element name="total" type="xs:decimal"/>
      </xs:sequence></xs:complexType></xs:element>
    </xs:schema>
  </types>
  <message name="getOrderRequest"><part name="body" element="tns:getOrder"/></message>
  <message name="getOrderResponse"><part name="body" element="tns:order"/></message>
  <portType name="Orders"><operation name="getOrder">
    <input message="tns:getOrderRequest"/><output message="tns:getOrderResponse"/></operation></portType>
  <binding name="OrdersSoap12" type="tns:Orders">
    <soap12:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="getOrder"><soap12:operation soapAction="urn:orders:getOrder"/>
      <input><soap12:body use="literal"/></input><output><soap12:body use="literal"/></output></operation>
  </binding>
  <service name="OrderService"><port name="OrdersPort" binding="tns:OrdersSoap12">
    <soap12:address location="http://localhost/orders"/></port></service>
</definitions>';

WebService ws(Wsdl);

# serve the operation
SoapHandler soap(new PermissiveAuthenticator());
soap.addMethod(ws, ws.getOperation("getOrder"), hash<auto> sub (hash<auto> cx, hash<auto> request) {
    return {"id": request.id, "total": 99.95n};
});
HttpServer server(<HttpServerOptionInfo>{"logger": new Logger("orders", LoggerLevel::getLevelInfo())});
server.setHandler("soap", "orders", NOTHING, soap);
int port = server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
on_exit server.stop();

# call it
SoapClient client({"wsdl": ws, "url": sprintf("http://localhost:%d/orders", port)});
hash<auto> order = client.callOperation("getOrder", {"id": 71});
printf("order %d: %y\n", order.id, order.total);
    @endcode

    @section xmlcookbooksoapmessage Building SOAP Messages Without a Transport

    The @ref wsdlintro "WSDL" module serializes and parses the messages of a service without
    sending them, for example to queue them or to use another transport:

    @code{.py}
%modern
%requires WSDL

const Wsdl = '<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap12="http://schemas.xmlsoap.org/wsdl/soap12/" xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:tns="urn:orders" targetNamespace="urn:orders">
  <types>
    <xs:schema targetNamespace="urn:orders" elementFormDefault="qualified">
      <xs:element name="getOrder"><xs:complexType><xs:sequence>
        <xs:element name="id" type="xs:int"/></xs:sequence></xs:complexType></xs:element>
      <xs:element name="order"><xs:complexType><xs:sequence>
        <xs:element name="id" type="xs:int"/><xs:element name="total" type="xs:decimal"/>
      </xs:sequence></xs:complexType></xs:element>
    </xs:schema>
  </types>
  <message name="getOrderRequest"><part name="body" element="tns:getOrder"/></message>
  <message name="getOrderResponse"><part name="body" element="tns:order"/></message>
  <portType name="Orders"><operation name="getOrder">
    <input message="tns:getOrderRequest"/><output message="tns:getOrderResponse"/></operation></portType>
  <binding name="OrdersSoap12" type="tns:Orders">
    <soap12:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="getOrder"><soap12:operation soapAction="urn:orders:getOrder"/>
      <input><soap12:body use="literal"/></input><output><soap12:body use="literal"/></output></operation>
  </binding>
  <service name="OrderService"><port name="OrdersPort" binding="tns:OrdersSoap12">
    <soap12:address location="http://localhost/orders"/></port></service>
</definitions>';

WebService ws(Wsdl);
WSOperation op = ws.getOperation("getOrder");
# the HTTP message of a request, without sending it
hash<auto> msg = op.serializeRequest({"id": 71});
printf("Content-Type: %s\n%s\n", msg.hdr."Content-Type", msg.body);
    @endcode

    @section xmlcookbookwebdav Serving and Accessing WebDAV Resources

    This example serves a directory with @ref webdavhandlerintro "WebDavHandler" and
    accesses it with @ref webdavclientiointro "WebDavClientIo"; see @ref xmlwebdavguide
    "WebDAV Servers and Clients":

    @code{.py}
%modern
%requires FsUtil
%requires HttpServer
%requires Logger
%requires WebDavHandler
%requires WebDavClientIo

# serve a temporary directory over WebDAV
TmpDir root();
FsWebDavHandler handler(root.path);
HttpServer server(<HttpServerOptionInfo>{"logger": new Logger("webdav", LoggerLevel::getLevelInfo())});
server.setHandler("webdav", "/", NOTHING, handler);
server.setDefaultHandler("webdav", handler);
# WebDAV methods beyond the standard HTTP methods
map server.addHttpMethod($1), handler.getHttpMethods();
int port = server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
on_exit server.stop();

WebDavClientIo dav({"url": sprintf("http://localhost:%d", port)});
on_exit dav.close();
dav.mkcol("/reports");
dav.put("/reports/2026-09.csv", "region,total\nnorth,1200\n", "text/csv");
dav.copyResource("/reports/2026-09.csv", "/reports/latest.csv");
foreach hash<auto> resource in (dav.list("/reports")) {
    printf("%s\n", resource.href);
}
printf("%s", dav.get("/reports/latest.csv"));

# an exclusive write lock; other clients cannot change the resource until it is unlocked
hash<auto> lock = dav.lock("/reports/latest.csv");
dav.unlock("/reports/latest.csv", lock.token);
    @endcode
*/
