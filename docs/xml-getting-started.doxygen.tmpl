/** @page xmlgettingstarted Getting Started

    @tableofcontents

    @section xmlgettingstartedrequire Loading the Module

    The xml module is a binary module; load it with \c %%requires. Its user modules are loaded by name in the same
    way, and load the xml module themselves:

    @code{.py}
%modern
%requires xml

printf("libxml2 XSD validation available: %y\n", Option::HAVE_PARSEXMLWITHSCHEMA);
    @endcode

    @section xmlgettingstartedconvert Converting Data and XML

    @ref Qore::Xml::make_xml() "make_xml()" serializes a hash with one top-level key to an XML document, and @ref
    Qore::Xml::parse_xml() "parse_xml()" converts XML to data:

    @code{.py}
%modern
%requires xml

string xml = make_xml({"invoice": {"number": "2026-0071", "total": 99.95}});
hash<auto> invoice = parse_xml(xml).invoice;
printf("%s: %s\n", invoice.number, invoice.total);
    @endcode

    Parsed element values are strings; attributes, repeated elements, mixed content and the options that preserve
    element order and whitespace are described in @ref xmlserialization.

    @section xmlgettingstartedvalidate Validating and Querying

    @code{.py}
%modern
%requires xml

XmlDoc doc('<invoice><line amount="10"/><line amount="20"/></invoice>');
doc.validateSchema('<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="invoice"><xs:complexType><xs:sequence>
    <xs:element name="line" maxOccurs="unbounded"><xs:complexType>
      <xs:attribute name="amount" type="xs:decimal" use="required"/>
    </xs:complexType></xs:element>
  </xs:sequence></xs:complexType></xs:element>
</xs:schema>');
printf("%d lines\n", doc.evalXPath("//line").size());
    @endcode

