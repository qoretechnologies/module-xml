set -eu
unset QORE_MODULE_DIR QORE_MODULE_DIR_ONLY QORE_INCLUDE_DIR LD_LIBRARY_PATH LD_PRELOAD
cd "$AUTOPKGTEST_TMP"
cat > xml-smoke.q <<'EOF'
%modern
%requires xml
%requires WSDL
%requires WebDavHandler
hash<auto> record = {"invoice": {"reference": "PO-2026-42", "customer": "Žluťoučký"}};
string document = make_xml(data: record);
if (parse_xml(xml: document) != record) {
    throw "PACKAGE-TEST-ERROR", "Named-argument XML round trip failed";
}
XmlDoc parsed(document);
if (!parsed.toString()) {
    throw "PACKAGE-TEST-ERROR", "XmlDoc serialization failed";
}
EOF
/usr/bin/qcc -o xml-smoke xml-smoke.q
./xml-smoke
